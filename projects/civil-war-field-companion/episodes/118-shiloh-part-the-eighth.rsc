11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode returns to Stuart’s isolated brigade",{"className":"moment","children":[["$","$L19",null,{"seconds":434,"label":"7:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode returns to Stuart’s isolated brigade"}],["$","p",null,{"children":"One Illinois and two Ohio regiments guarded the far United States left near the Tennessee River."}]]}]]}],["$","div","Chalmers and Jackson reached Stuart",{"className":"moment","children":[["$","$L19",null,{"seconds":515,"label":"8:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Chalmers and Jackson reached Stuart"}],["$","p",null,{"children":"At about 11 a.m., nine Confederate regiments and two batteries deployed against Stuart’s three regiments behind Locust Grove Run."}]]}]]}],["$","div","The 71st Ohio broke",{"className":"moment","children":[["$","$L19",null,{"seconds":576,"label":"9:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 71st Ohio broke"}],["$","p",null,{"children":"Colonel Rodney Mason fled, part of the regiment followed, and the unit disintegrated after its second-in-command was mortally wounded."}]]}]]}],["$","div","Stuart rebuilt a shorter line",{"className":"moment","children":[["$","$L19",null,{"seconds":605,"label":"10:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart rebuilt a shorter line"}],["$","p",null,{"children":"The 55th Illinois rallied about 200 yards back and joined the 54th Ohio and part of the 71st Ohio, leaving about 800 men with a ravine behind them."}]]}]]}],["$","div","The Confederate attack slowed",{"className":"moment","children":[["$","$L19",null,{"seconds":671,"label":"11:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate attack slowed"}],["$","p",null,{"children":"Chalmers’s men needed ammunition, soldiers left the ranks for captured camps, and Stuart’s reduced line continued firing."}]]}]]}],["$","div","MacArthur drew off part of Jackson’s brigade",{"className":"moment","children":[["$","$L19",null,{"seconds":735,"label":"12:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"MacArthur drew off part of Jackson’s brigade"}],["$","p",null,{"children":"Three Illinois regiments held about a quarter mile west of Stuart. The 9th Illinois lost 361 killed and wounded, 62 percent of its strength."}]]}]]}],["$","div","The entire United States line is identified",{"className":"moment","children":[["$","$L19",null,{"seconds":871,"label":"14:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"The entire United States line is identified"}],["$","p",null,{"children":"From east to west it ran through Stuart, MacArthur, Hurlbut, Prentiss, W. H. L. Wallace, then the retreating McClernand and Sherman."}]]}]]}],["$","div","The Confederate center was nearly empty",{"className":"moment","children":[["$","$L19",null,{"seconds":937,"label":"15:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate center was nearly empty"}],["$","p",null,{"children":"At about 11 a.m., eight brigades faced the United States right and two attacked Stuart, while only one faced Hurlbut, Prentiss, and Wallace."}]]}]]}],["$","div","Bragg and Polk improvised a new command arrangement",{"className":"moment","children":[["$","$L19",null,{"seconds":984,"label":"16:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg and Polk improvised a new command arrangement"}],["$","p",null,{"children":"With corps intermingled, Bragg took the right, Polk the center, and Hardee the left. Johnston was acting locally near the front."}]]}]]}],["$","div","Shaver made first contact at the Hornet’s Nest",{"className":"moment","children":[["$","$L19",null,{"seconds":1098,"label":"18:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shaver made first contact at the Hornet’s Nest"}],["$","p",null,{"children":"At about 10:30 a.m., his Arkansas brigade entered Duncan Field and withdrew after Tuttle’s Iowans opened fire."}]]}]]}],["$","div","Stevens’s brigade made the first organized assault",{"className":"moment","children":["$L1a","$L1b"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Tennessee"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Visited the center and ordered Prentiss to hold his position"}]]}],["$","div","2nd Division",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division"}],["$","span",null,{"children":"W. H. L. Wallace"}],["$","small",null,{"children":"Tuttle and Sweeney along the farm lane; MacArthur detached toward the river"}]]}],["$","div","Remnant of the 6th Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Remnant of the 6th Division"}],["$","span",null,{"children":"Benjamin M. Prentiss"}],["$","small",null,{"children":"Held between Wallace and Hurlbut under Grant’s order"}]]}],["$","div","4th Division",{"className":"command-entry","children":[["$","strong",null,{"children":"4th Division"}],["$","span",null,{"children":"Stephen A. Hurlbut"}],["$","small",null,{"children":"Two brigades from the farm lane through the peach orchard"}]]}],["$","div","Detached brigade, Wallace’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Detached brigade, Wallace’s division"}],["$","span",null,{"children":"John McArthur"}],["$","small",null,{"children":"Three Illinois regiments between Hurlbut and Stuart"}]]}],["$","div","Detached brigade, Sherman’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Detached brigade, Sherman’s division"}],["$","span",null,{"children":"David Stuart"}],["$","small",null,{"children":"54th and 71st Ohio, 55th Illinois near Locust Grove Run"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Ad hoc right-wing command",{"className":"command-entry","children":[["$","strong",null,{"children":"Ad hoc right-wing command"}],["$","span",null,{"children":"Braxton Bragg"}],["$","small",null,{"children":"Directed later attacks against the Hornet’s Nest, including Gibson’s brigade"}]]}],["$","div","Ad hoc center command",{"className":"command-entry","children":[["$","strong",null,{"children":"Ad hoc center command"}],["$","span",null,{"children":"Leonidas Polk"}],["$","small",null,{"children":"Tried to restore control after the corps became intermingled"}]]}],["$","div","Ad hoc left-wing command",{"className":"command-entry","children":[["$","strong",null,{"children":"Ad hoc left-wing command"}],["$","span",null,{"children":"William J. Hardee"}],["$","small",null,{"children":"Assigned the western battlefield under the improvised arrangement"}]]}],["$","div","Brigades on the Confederate right",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigades on the Confederate right"}],["$","span",null,{"children":"James R. Chalmers / John K. Jackson"}],["$","small",null,{"children":"Nine regiments attacking Stuart and MacArthur"}]]}],["$","div","First organized Hornet’s Nest assault",{"className":"command-entry","children":[["$","strong",null,{"children":"First organized Hornet’s Nest assault"}],["$","span",null,{"children":"Benjamin F. Cheatham / William H. Stephens"}],["$","small",null,{"children":"One Kentucky and two Tennessee regiments, about 1,000 men"}]]}],["$","div","Combined 11:30 a.m. assault",{"className":"command-entry","children":[["$","strong",null,{"children":"Combined 11:30 a.m. assault"}],["$","span",null,{"children":"Thomas C. Hindman / Alexander P. Stewart"}],["$","small",null,{"children":"About 3,700 men from parts of four brigades"}]]}],["$","div",