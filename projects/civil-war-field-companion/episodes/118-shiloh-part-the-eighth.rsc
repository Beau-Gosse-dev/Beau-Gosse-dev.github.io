1c:["$","div","The Iowans fired at thirty yards",{"className":"moment","children":[["$","$L19",null,{"seconds":1290,"label":"21:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Iowans fired at thirty yards"}],["$","p",null,{"children":"The 12th and 14th Iowa delivered two close volleys, then William Shaw led a short counterattack before returning to the farm lane."}]]}]]}]
1d:["$","div","Cheatham’s brigade withdrew with heavy losses",{"className":"moment","children":[["$","$L19",null,{"seconds":1344,"label":"22:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cheatham’s brigade withdrew with heavy losses"}],["$","p",null,{"children":"All twelve members of the 6th Tennessee color guard fell; the regiment lost fourteen officers and 226 enlisted men."}]]}]]}]
1e:["$","div","Grant ordered the line held",{"className":"moment","children":[["$","$L19",null,{"seconds":1382,"label":"23:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant ordered the line held"}],["$","p",null,{"children":"Around 11 a.m., he visited Hurlbut, Prentiss, and Wallace. Prentiss understood the order to hold at all hazards literally."}]]}]]}]
1f:["$","div","Hindman assembled the largest assault",{"className":"moment","children":[["$","$L19",null,{"seconds":1425,"label":"23:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hindman assembled the largest assault"}],["$","p",null,{"children":"About 3,700 men from parts of four brigades advanced around 11:30 with artillery support."}]]}]]}]
20:["$","div","Hindman’s attack lost command and momentum",{"className":"moment","children":[["$","$L19",null,{"seconds":1524,"label":"25:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hindman’s attack lost command and momentum"}],["$","p",null,{"children":"Hindman was disabled when his horse was hit, Shaver had no horse, Wood was already injured, and the attacking formations withdrew after moving about 80 yards."}]]}]]}]
21:["$","div","Two organized attacks had failed by noon",{"className":"moment","children":[["$","$L19",null,{"seconds":1583,"label":"26:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two organized attacks had failed by noon"}],["$","p",null,{"children":"The United States center had not yet faced the kind of combined pressure that broke Sherman and McClernand."}]]}]]}]
22:["$","div","Bragg sent Gibson’s brigade forward",{"className":"moment","children":[["$","$L19",null,{"seconds":1647,"label":"27:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg sent Gibson’s brigade forward"}],["$","p",null,{"children":"One Arkansas and three Louisiana regiments advanced across Davis Wheat Field shortly after noon."}]]}]]}]
23:["$","div","United States infantry fired from the thicket",{"className":"moment","children":[["$","$L19",null,{"seconds":1684,"label":"28:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States infantry fired from the thicket"}],["$","p",null,{"children":"The defenders waited until Gibson’s men were only yards away, then delivered a point-blank volley from concealed positions."}]]}]]}]
24:["$","div","A bayonet charge failed in the brush",{"className":"moment","children":[["$","$L19",null,{"seconds":1761,"label":"29:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"A bayonet charge failed in the brush"}],["$","p",null,{"children":"The 19th Louisiana entered the thicket but could not move through it and withdrew under fire."}]]}]]}]
