"}],["$","p",null,{"children":"Led three or four unsuccessful attacks through Davis Wheat Field and dense brush"}]]}]]}],["$","article","Benjamin F. Cheatham",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"BF"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Benjamin F. Cheatham"}],["$","p",null,{"children":"Led Stephens’s brigade after Stephens was injured and was slightly wounded in the failed assault"}]]}]]}]]}]
