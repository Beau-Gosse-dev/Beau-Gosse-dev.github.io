1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",118," · ","April 6, 1862, about 10:30 a.m.–2 p.m."," · ","Locust Grove Run, the peach orchard, Duncan Field, Davis Wheat Field, and the farm lane later called the Sunken Road at Shiloh, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Eighth)"}],["$","span",null,{"className":"result-label","children":"Stuart’s isolated brigade held near the river for about two hours despite being outnumbered, while MacArthur’s brigade absorbed part of Jackson’s attack. The Wallace–Prentiss–Hurlbut line used woods, thickets, and the farm lane to stop several separate Confederate assaults. Shaver withdrew after first contact at Duncan Field; Cheatham’s attack failed at about 11 a.m.; Hindman’s larger attack lost coordination before noon; and Gibson’s brigade made repeated unsuccessful attacks until it was exhausted by about 2 p.m. The position later called the Hornet’s Nest held because the Confederate center remained thin and the attacks arrived separately"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6006205334.mp3?updated=1695140645","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Stuart’s initial opposition",{"children":[["$","span",null,{"children":"Stuart’s initial opposition"}],["$","strong",null,{"children":"Three United States regiments against nine Confederate regiments"}],"$undefined"]}],["$","div","Stuart’s remaining force",{"children":[["$","span",null,{"children":"Stuart’s remaining force"}],["$","strong",null,{"children":"About 800 after the first withdrawal"}],"$undefined"]}],["$","div","9th Illinois casualties",{"children":[["$","span",null,{"children":"9th Illinois casualties"}],["$","strong",null,{"children":"361 killed or wounded; 62 percent of the regiment"}],"$undefined"]}],["$","div","Confederate distribution at 11 a.m.",{"children":[["$","span",null,{"children":"Confederate distribution at 11 a.m."}],["$","strong",null,{"children":"Eight brigades west, two east, one in the center, four in reserve or moving"}],"$undefined"]}],["$","div","Cheatham–Stevens force",{"children":[["$","span",null,{"children":"Cheatham–Stevens force"}],["$","strong",null,{"children":"About 1,000 men"}],"$undefined"]}],["$","div","Hindman’s assault",{"children":[["$","span",null,{"children":"Hindman’s assault"}],["$","strong",null,{"children":"About 3,700 men from parts of four brigades"}],"$undefined"]}],["$","div","Hindman’s advance",{"children":[["$","span",null,{"children":"Hindman’s advance"}],["$","strong",null,{"children":"About 80 yards into Duncan Field before retreating"}],"$undefined"]}],["$","div","Gibson’s attacks",{"children":[["$","span",null,{"children":"Gibson’s attacks"}],["$","strong",null,{"children":"Three or four assaults; brigade exhausted by about 2 p.m."}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],"$Le","$Lf"]}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16"]}]]}]
