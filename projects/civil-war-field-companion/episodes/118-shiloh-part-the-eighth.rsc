d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",118," · ","April 6, 1862, about 10:30 a.m.–2 p.m."," · ","Locust Grove Run, the peach orchard, Duncan Field, Davis Wheat Field, and the farm lane later called the Sunken Road at Shiloh, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Eighth)"}],["$","span",null,{"className":"result-label","children":"Stuart’s isolated brigade held near the river for about two hours despite being outnumbered, while MacArthur’s brigade absorbed part of Jackson’s attack. The Wallace–Prentiss–Hurlbut line used woods, thickets, and the farm lane to stop several separate Confederate assaults. Shaver withdrew after first contact at Duncan Field; Cheatham’s attack failed at about 11 a.m.; Hindman’s larger attack lost coordination before noon; and Gibson’s brigade made repeated unsuccessful attacks until it was exhausted by about 2 p.m. The position later called the Hornet’s Nest held because the Confederate center remained thin and the attacks arrived separately"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 6, 1862, about 10:30 a.m.–2 p.m."}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Locust Grove Run, the peach orchard, Duncan Field, Davis Wheat Field, and the farm lane later called the Sunken Road at Shiloh, Tennessee"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Stuart’s isolated brigade held near the river for about two hours despite being outnumbered, while MacArthur’s brigade absorbed part of Jackson’s attack. The Wallace–Prentiss–Hurlbut line used woods, thickets, and the farm lane to stop several separate Confederate assaults. Shaver withdrew after first contact at Duncan Field; Cheatham’s attack failed at about 11 a.m.; Hindman’s larger attack lost coordination before noon; and Gibson’s brigade made repeated unsuccessful attacks until it was exhausted by about 2 p.m. The position later called the Hornet’s Nest held because the Confederate center remained thin and the attacks arrived separately"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{