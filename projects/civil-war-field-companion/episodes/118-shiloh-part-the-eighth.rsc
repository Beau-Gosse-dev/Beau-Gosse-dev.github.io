11:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.libsyn.com/118-shiloh-part-the-eighth",{"href":"https://civilwarpodcast.libsyn.com/118-shiloh-part-the-eighth","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 118"]}],["$","a","https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm",{"href":"https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of Shiloh"]}],["$","a","https://www.nps.gov/shil/planyourvisit/maps.htm",{"href":"https://www.nps.gov/shil/planyourvisit/maps.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Shiloh maps"]}],["$","a","https://www.nps.gov/shil/learn/historyculture/monument-detail.htm?id=H",{"href":"https://www.nps.gov/shil/learn/historyculture/monument-detail.htm?id=H","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Wallace’s 2nd Division"]}],["$","a","https://www.loc.gov/item/85690890/",{"href":"https://www.loc.gov/item/85690890/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Shiloh battlefield map"]}],["$","a","https://www.loc.gov/pictures/item/2017646904/",{"href":"https://www.loc.gov/pictures/item/2017646904/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Shiloh battlefield photograph"]}]]}]
