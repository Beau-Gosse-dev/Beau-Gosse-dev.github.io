15:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/10/09/civil-war-podcast-episode-167/",{"href":"https://civilwarpodcast.org/2016/10/09/civil-war-podcast-episode-167/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 167 page"]}],["$","a","https://www.nps.gov/rich/learn/historyculture/mhbull.htm",{"href":"https://www.nps.gov/rich/learn/historyculture/mhbull.htm","target":"_blank","rel":"noreferrer","children":[" · ","Richmond National Battlefield Park: The Battle of Malvern Hill"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va021",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va021","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service battle summary: Malvern Hill"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://www.loc.gov/item/va2114/",{"href":"https://www.loc.gov/item/va2114/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress Historic American Landscapes Survey: Battle of Malvern Hill"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00034/",{"href":"https://www.loc.gov/item/gvhs01.vhs00034/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: revised plan of the Battle of Malvern Hill by Robert Knox Sneden"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00096/",{"href":"https://www.loc.gov/item/gvhs01.vhs00096/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: map of the night march from Malvern Hill to Harrison’s Landing"]}],["$","a","https://www.loc.gov/item/2004660457/",{"href":"https://www.loc.gov/item/2004660457/","target":"_blank","rel":"noreferrer","children":[" · ","Primary visual source: Alfred R. Waud’s Malvern Hill drawing, July 1, 1862"]}],["$","a","https://www.loc.gov/item/90709064/",{"href":"https://www.loc.gov/item/90709064/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Currier and Ives Battle of Malvern Hill lithograph"]}],["$","a","https://www.loc.gov/item/2007677208/",{"href":"https://www.loc.gov/item/2007677208/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: John B. Magruder portrait"]}],["$","a","https://www.loc.gov/item/2018666388/",{"href":"https://www.loc.gov/item/2018666388/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Adelbert Ames portrait"]}],["$","a","https://www.loc.gov/item/2004660424/",{"href":"https://www.loc.gov/item/2004660424/","target":"_blank","rel":"noreferrer","children":[" · ","Primary visual source: Alfred R. Waud’s Harrison’s Landing line drawing"]}]]}]
