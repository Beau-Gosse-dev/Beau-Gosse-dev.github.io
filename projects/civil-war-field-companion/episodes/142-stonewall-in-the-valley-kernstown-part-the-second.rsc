d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",142," · ","March 22–23, 1862"," · ","Winchester and Kernstown, Virginia; the Valley Turnpike, Pritchard’s Hill, Barton’s Woods, Middle Road, and Sandy Ridge in the lower Shenandoah Valley"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: KERNSTOWN (Part the Second)"}],["$","span",null,{"className":"result-label","children":"This episode covers only the opening of the First Battle of Kernstown. Nathan Kimball concentrated a much larger United States force around Pritchard’s Hill, checked Turner Ashby’s morning probes, and kept the field command despite suggestions from the wounded James Shields in Winchester. Jackson arrived near noon, attacked on the basis of Ashby’s false estimate, and shifted infantry and artillery west toward Sandy Ridge without fully explaining his plan to his brigade commanders. The episode ends when Sandie Pendleton reports the scale of the United States force and Jackson acknowledges the danger. The later Union counterattack, Confederate retreat, and United States tactical victory are outside this installment"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"March 22–23, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Winchester and Kernstown, Virginia; the Valley Turnpike, Pritchard’s Hill, Barton’s Woods, Middle Road, and Sandy Ridge in the lower Shenandoah Valley"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"This episode covers only the opening of the First Battle of Kernstown. Nathan Kimball concentrated a much larger United States force around Pritchard’s Hill, checked Turner Ashby’s morning probes, and kept the field command despite suggestions from the wounded James Shields in Winchester. Jackson arrived near noon, attacked on the basis of Ashby’s false estimate, and shifted infantry and artillery west toward Sandy Ridge without fully explaining his plan to his brigade commanders. The episode ends when Sandie Pendleton reports the scale of the United States force and Jackson acknowledges the danger. The later Union counterattack, Confederate retreat, and United States tactical victory are outside this installment"}]]}]]}],false,"$Lf","$undefined"]}],"$L10","$L11",false,false,"$L12",false,"$L13","$L14","$L15","$L16"]}]]}]
