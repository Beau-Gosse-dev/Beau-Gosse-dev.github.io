f:["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Forces",{"children":[["$","th",null,{"scope":"row","children":"Forces"}],["$","td",null,{"children":["Roughly 3,500 Confederates against roughly 8,000–8,500 United States troops",["$","small",null,{"style":{"display":"block"},"children":"Totals vary with the definition of present versus engaged. The episode estimates that straggling left Jackson about 3,000 men on arrival. Jackson’s official report lists 3,087 infantry present that evening, 2,742 engaged, 27 guns with 18 engaged, and 290 cavalry. Shields reported that the United States force did not exceed 7,000, while the NPS order of battle rounds the division to about 8,500."}]]}]]}],["$","tr","Shields wounded",{"children":[["$","th",null,{"scope":"row","children":"Shields wounded"}],["$","td",null,{"children":["Shell fragment fractured his left arm on March 22",["$","small",null,{"style":{"display":"block"},"children":"James Shields was taken to Winchester. He continued receiving reports and sending discretionary suggestions, but Colonel Nathan Kimball exercised field command on March 23. Shields survived the wound."}]]}]]}],["$","tr","Fulkerson’s exposed advance",{"children":[["$","th",null,{"scope":"row","children":"Fulkerson’s exposed advance"}],["$","td",null,{"children":["About 600 men of the 37th and 23rd Virginia crossed open ground",["$","small",null,{"style":{"display":"block"},"children":"Instead of passing safely around the United States position, the column moved toward a grove at the western base of Pritchard’s Hill. Fire from the hill, Battery L of the 1st Ohio, and the appearance of the 84th Pennsylvania caused Fulkerson to turn left toward Sandy Ridge."}]]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/02/14/civil-war-podcast-episode-142/",{"href":"https://civilwarpodcast.org/2016/02/14/civil-war-podcast-episode-142/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 142 page"]}],["$","a","https://www.nps.gov/articles/000/first-battle-of-kernstown.htm",{"href":"https://www.nps.gov/articles/000/first-battle-of-kernstown.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: First Battle of Kernstown"]}],["$","a","https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm",{"href":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Jackson’s 1862 Shenandoah Valley Campaign"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://ehistory.osu.edu/books/official-records/015",{"href":"https://ehistory.osu.edu/books/official-records/015","target":"_blank","rel":"noreferrer","children":[" · ","Primary source collection: Official Records, Series I, Volume XII, Part I"]}],["$","a","https://ehistory.osu.edu/books/official-records/015/0342",{"href":"https://ehistory.osu.edu/books/official-records/015/0342","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Shields’s report and United States strength, Official Records page 342"]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}]]}]
