1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",142," · ","March 22–23, 1862"," · ","Winchester and Kernstown, Virginia; the Valley Turnpike, Pritchard’s Hill, Barton’s Woods, Middle Road, and Sandy Ridge in the lower Shenandoah Valley"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: KERNSTOWN (Part the Second)"}],["$","span",null,{"className":"result-label","children":"This episode covers only the opening of the First Battle of Kernstown. Nathan Kimball concentrated a much larger United States force around Pritchard’s Hill, checked Turner Ashby’s morning probes, and kept the field command despite suggestions from the wounded James Shields in Winchester. Jackson arrived near noon, attacked on the basis of Ashby’s false estimate, and shifted infantry and artillery west toward Sandy Ridge without fully explaining his plan to his brigade commanders. The episode ends when Sandie Pendleton reports the scale of the United States force and Jackson acknowledges the danger. The later Union counterattack, Confederate retreat, and United States tactical victory are outside this installment"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1765322856.mp3?updated=1695307405","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The March 22 skirmish and the opening phase of First Kernstown on March 23"}],["$","small",null,{"children":"The narrative stops before Erastus Tyler’s main attack on Sandy Ridge, Richard Garnett’s retreat, and the end of the battle. Those events belong to episode 143."}]]}],["$","div","Overall battle result",{"children":[["$","span",null,{"children":"Overall battle result"}],["$","strong",null,{"children":"United States tactical victory; later events not covered here"}],["$","small",null,{"children":"The National Park Service also describes a Confederate strategic benefit: the battle helped persuade Washington to keep or redirect troops toward the Valley rather than McClellan’s movement against Richmond. That consequence cannot be inferred from the incomplete action heard in this episode alone."}]]}],["$","div","Immediate cause",{"children":[["$","span",null,{"children":"Immediate cause"}],["$","strong",null,{"children":"Jackson attacked on false intelligence"}],["$","small",null,{"children":"Turner Ashby reported only four United States infantry regiments and a battery or two near Winchester. In fact, Shields’s division remained in the area. Ashby then encountered evidence of the larger force on March 23 but did not send Jackson a corrective report before the main column arrived."}]]}],["$","div","Forces",{"children":["$Le","$Lf","$L10"]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],"$L23","$undefined","$L24",false,"$L25",false,"$L26","$L27","$L28"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","span",null,{"children":"Forces"}]
f:["$","strong",null,{"children":"Roughly 3,500 Confederates against roughly 8,000–8,500 United States troops"}]
10:["$","small",null,{"children":"Totals vary with the definition of present versus engaged. The episode estimates that straggling left Jackson about 3,000 men on arrival. Jackson’s official report lists 3,087 infantry present that evening, 2,742 engaged, 27 guns with 18 engaged, and 290 cavalry. Shields reported that the United States force did not exceed 7,000, while the NPS order of battle rounds the division to about 8,500."}]
11:["$","div","Shields wounded",{"children":[["$","span",null,{"children":"Shields wounded"}],["$","strong",null,{"children":"Shell fragment fractured his left arm on March 22"}],["$","small",null,{"children":"James Shields was taken to Winchester. He continued receiving reports and sending discretionary suggestions, but Colonel Nathan Kimball exercised field command on March 23. Shields survived the wound."}]]}]
12:["$","div","United States field commander",{"children":[["$","span",null,{"children":"United States field commander"}],["$","strong",null,{"children":"Col. Nathan Kimball"}],["$","small",null,{"children":"Kimball commanded the First Brigade of Shields’s division. He declined repeated suggestions to advance prematurely because he suspected that additional Confederate forces were approaching."}]]}]
13:["$","div","First shot",{"children":[["$","span",null,{"children":"First shot"}],["$","strong",null,{"children":"About 9 a.m., March 23"}],["$","small",null,{"children":"One of Ashby’s guns opened the battle after an 8th Ohio reconnaissance identified Confederate cavalry, infantry, and artillery south of Kernstown."}]]}]
14:["$","div","Key United States position",{"children":[["$","span",null,{"children":"Key United States position"}],["$","strong",null,{"children":"Pritchard’s Hill"}],["$","small",null,{"children":"The hill stood west of the Valley Turnpike and commanded the approaches south of Winchester. Kimball placed ten rifled guns there, supported first by the 67th Ohio and 5th Ohio and later by additional infantry."}]]}]
15:["$","div","Morning Confederate force",{"children":[["$","span",null,{"children":"Morning Confederate force"}],["$","strong",null,{"children":"Ashby’s cavalry, artillery, and four companies of the 2nd Virginia"}],["$","small",null,{"children":"The infantry detachment was led by Capt. John Q. A. Nadenbousch. Ashby tried both sides of the Valley Turnpike but was pushed back southeast of Kernstown by about 11 a.m."}]]}]
16:["$","div","Jackson’s arrival",{"children":[["$","span",null,{"children":"Jackson’s arrival"}],["$","strong",null,{"children":"Near noon, about two miles south of Kernstown"}],["$","small",null,{"children":"The episode estimates that most of the infantry had marched more than 20 miles on March 22 and at least 12 additional miles on March 23. Jackson allowed the arriving brigades to rest before reconnoitering."}]]}]
17:["$","div","Decision to fight on Sunday",{"children":[["$","span",null,{"children":"Decision to fight on Sunday"}],["$","strong",null,{"children":"Jackson decided that delay was more dangerous than an immediate attack"}],["$","small",null,{"children":"The episode quotes Jackson’s later letter to his wife explaining his religious misgivings. The transcript’s word “circumcised” is a speech-recognition error; published transcriptions render the phrase as “circumstanced as on that day.”"}]]}]
18:["$","div","Jackson’s plan",{"children":[["$","span",null,{"children":"Jackson’s plan"}],["$","strong",null,{"children":"Move west, seize Sandy Ridge, turn the United States right, and reach the Valley Turnpike"}],["$","small",null,{"children":"The transcript briefly renders the feature as “Sandy Bridge,” but the battlefield feature is Sandy Ridge. The route was intended to avoid a direct assault on the guns at Pritchard’s Hill."}]]}]
19:["$","div","Barton’s Woods",{"children":[["$","span",null,{"children":"Barton’s Woods"}],["$","strong",null,{"children":"Covered approach used by Fulkerson and the Stonewall Brigade"}],["$","small",null,{"children":"Fulkerson’s 23rd and 37th Virginia reached the northern edge of the woods about 2 p.m. The Stonewall Brigade followed, except for the 5th Virginia, which Jackson retained near the turnpike."}]]}]
1a:["$","div","Artillery reorganization",{"children":[["$","span",null,{"children":"Artillery reorganization"}],["$","strong",null,{"children":"Jackson detached brigade batteries into a reserve under his direct orders"}],["$","small",null,{"children":"Burks was directed to support the guns while the 48th Virginia guarded the wagon and ammunition trains. Later in the episode, eleven Confederate guns unlimbered on the exposed eastern slope of Sandy Ridge."}]]}]
1b:["$","div","Command-information failure",{"children":[["$","span",null,{"children":"Command-information failure"}],["$","strong",null,{"children":"The brigade commanders received movements without Jackson’s overall plan"}],["$","small",null,{"children":"Garnett later complained that he lacked the information needed to act intelligently. Fulkerson, Garnett, and nearby regimental commanders repeatedly made decisions without knowing which friendly units were moving toward Sandy Ridge."}]]}]
1c:["$","div","Fulkerson’s exposed advance",{"children":[["$","span",null,{"children":"Fulkerson’s exposed advance"}],["$","strong",null,{"children":"About 600 men of the 37th and 23rd Virginia crossed open ground"}],["$","small",null,{"children":"Instead of passing safely around the United States position, the column moved toward a grove at the western base of Pritchard’s Hill. Fire from the hill, Battery L of the 1st Ohio, and the appearance of the 84th Pennsylvania caused Fulkerson to turn left toward Sandy Ridge."}]]}]
1d:["$","div","Stonewall Brigade deployment",{"children":[["$","span",null,{"children":"Stonewall Brigade deployment"}],["$","strong",null,{"children":"The 33rd Virginia initially advanced without most of the brigade"}],["$","small",null,{"children":"Garnett and Colonel Arthur C. Cummings followed Fulkerson with about 275 men. The order had not reached the 2nd, 4th, and 27th Virginia, which remained in Barton’s Woods until Jackson sent Sandie Pendleton to move them."}]]}]
1e:["$","div","Ashby’s diversion",{"children":[["$","span",null,{"children":"Ashby’s diversion"}],["$","strong",null,{"children":"About 150 cavalrymen attacked east of the turnpike around 2:30 p.m."}],["$","small",null,{"children":"Ashby overran an 8th Ohio skirmish company before being repulsed with one man killed and six wounded. The demonstration helped keep the equivalent of five United States regiments east of the turnpike."}]]}]
1f:["$","div","Artillery disadvantage",{"children":[["$","span",null,{"children":"Artillery disadvantage"}],["$","strong",null,{"children":"United States rifled guns held higher ground and greater effective range"}],["$","small",null,{"children":"The episode places the Pritchard’s Hill guns about one mile away and roughly 100 feet above the exposed Confederate batteries. Jackson told Sergeant Clement Fishburne to reduce fire from his short-ranged 12-pounder howitzer."}]]}]
20:["$","div","“We are in for it”",{"children":[["$","span",null,{"children":"“We are in for it”"}],["$","strong",null,{"children":"Attributed to Jackson after Pendleton estimated at least 10,000 opponents"}],["$","small",null,{"children":"The episode presents the exchange as a remembered command anecdote. It captures Jackson’s late recognition that the initial intelligence was wrong, but the exact wording should not be treated as a contemporaneous transcript."}]]}]
21:["$","div","Important leader deaths in this installment",{"children":[["$","span",null,{"children":"Important leader deaths in this installment"}],["$","strong",null,{"children":"None"}],["$","small",null,{"children":"Shields was seriously wounded but survived. The episode mentions one Confederate cavalryman killed during Ashby’s diversion, but no important commander was killed or mortally wounded in the action covered here."}]]}]
22:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“We Are in for It!”: The First Battle of Kernstown, March 23, 1862 by Gary L. Ecelbarger"}],["$","small",null,{"children":"The automated transcript misspells Ecelbarger’s surname. The book was published by White Mane in 1997."}]]}]
23:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
24:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Morning: Kimball secures Pritchard’s Hill",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep142-kernstown-morning.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Morning: Kimball secures Pritchard’s Hill at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep142-kernstown-morning.svg","alt":"Schematic morning map of First Kernstown showing Pritchard’s Hill, Valley Turnpike, United States guns, the 8th Ohio reconnaissance, and Ashby’s Confederate probes","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Morning: Kimball secures Pritchard’s Hill"}],["$","span",null,{"children":"After an 8th Ohio reconnaissance found Ashby south of Kernstown, a Confederate gun opened fire about 9 a.m. Kimball placed ten rifled guns and supporting infantry on Pritchard’s Hill. Ashby’s movement east of the turnpike met the 14th Indiana and other United States troops, and by about 11 a.m. his force had been pushed southeast. The stream course, routes, positions, and arrows are schematic; the map does not claim exact unit frontages."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep142-kernstown-morning.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/articles/000/first-battle-of-kernstown.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Early afternoon: Jackson shifts toward Sandy Ridge",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep142-kernstown-afternoon.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Early afternoon: Jackson shifts toward Sandy Ridge at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep142-kernstown-afternoon.svg","alt":"Schematic early-afternoon map of First Kernstown showing Barton’s Woods, Sandy Ridge, Pritchard’s Hill, Confederate brigade movements, artillery positions, and Ashby’s diversion","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Early afternoon: Jackson shifts toward Sandy Ridge"}],["$","span",null,{"children":"Fulkerson moved through Barton’s Woods and into the meadow, then turned left under fire toward Sandy Ridge. Garnett followed with the 33rd Virginia before Jackson sent the rest of the brigade and artillery west. Eleven Confederate guns formed on the exposed eastern slope while Ashby demonstrated east of the Valley Turnpike. This is a phase diagram based on the episode, NPS narrative, and period maps; distances, routes, and unit locations are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep142-kernstown-afternoon.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/articles/000/first-battle-of-kernstown.htm","target":"_blank","rel":"noreferrer","children":["Map source ","$L29"]}]]}],"$undefined"]}]]}]]}]]}]
25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","V Corps, Army of the Potomac-Maj. Gen. Nathaniel P. Banks",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps, Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Retained overall responsibility for the Valley force but left Winchester for Washington after receiving reassuring reports on March 23"}]]}],["$","div","Second Division, V Corps-Brig. Gen. James Shields",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Division, V Corps"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"Wounded on March 22; received battlefield reports in Winchester and sent discretionary suggestions while Kimball commanded in the field"}]]}],["$","div","First Brigade and acting field commander-Col. Nathan Kimball",{"className":"command-entry","children":[["$","strong",null,{"children":"First Brigade and acting field commander"}],["$","span",null,{"children":"Col. Nathan Kimball"}],["$","small",null,{"children":"14th Indiana, 8th Ohio, 67th Ohio, and 84th Pennsylvania; concentrated the defense at Pritchard’s Hill and controlled the division on the battlefield"}]]}],["$","div","Second Brigade, Shields’s division-Col. Jeremiah C. Sullivan",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Brigade, Shields’s division"}],["$","span",null,{"children":"Col. Jeremiah C. Sullivan"}],["$","small",null,{"children":"5th Ohio, 13th Indiana, 62nd Ohio, and 39th Illinois; the 39th Illinois is listed by NPS as unengaged"}]]}],["$","div","Third Brigade, Shields’s division-Col. Erastus B. Tyler",{"className":"command-entry","children":[["$","strong",null,{"children":"Third Brigade, Shields’s division"}],["$","span",null,{"children":"Col. Erastus B. Tyler"}],["$","small",null,{"children":"7th Ohio, 7th Indiana, 1st Virginia (later West Virginia), 29th Ohio, and 110th Pennsylvania; his main attack occurs after this episode ends"}]]}],["$","div","Division artillery-Lt. Col. Philip Daum",{"className":"command-entry","children":[["$","strong",null,{"children":"Division artillery"}],["$","span",null,{"children":"Lt. Col. Philip Daum"}],["$","small",null,{"children":"United States and Ohio batteries, including ten rifled pieces concentrated on Pritchard’s Hill during the opening phase"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Department of Northern Virginia-Gen. Joseph E. Johnston",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Northern Virginia"}],["$","span",null,{"children":"Gen. Joseph E. Johnston"}],["$","small",null,{"children":"Ordered Jackson to keep United States troops in the Valley and away from the main movement against Richmond"}]]}],["$","div","Valley District-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":["$L2a","$L2b","$L2c"]}],"$L2d","$L2e","$L2f","$L30"]]}]]}],"$L31"]]]}]
26:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep142-nathan-kimball.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep142-nathan-kimball.jpg","alt":"Wartime photographic portrait of United States officer Nathan Kimball in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Nathan Kimball commanded Shields’s division in the field after Shields was wounded. He used Pritchard’s Hill as the anchor of a cautious defense and correctly anticipated that Ashby’s morning force was not acting alone."}]]}],["$","figure","/images/ep142-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep142-stonewall-jackson.jpg","alt":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson reached Kernstown believing he faced a small rear guard. By the episode’s end, he had committed his command and learned that a much larger United States force blocked the route to Winchester."}]]}],["$","figure","/images/ep142-kernstown-sneden.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep142-kernstown-sneden.jpg","alt":"Robert Knox Sneden’s color plan of the Battle of Kernstown with roads, terrain, and troop positions","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Robert Knox Sneden’s wartime-era plan presents the battle’s roads, terrain, and colored troop positions. It is a historical interpretation produced between 1862 and 1865, not a surveyed map or a reliable guide to exact strength and frontage. Its troop-count annotation is substantially higher than the official reports and modern estimates."}]]}],["$","figure","/images/ep142-kernstown-morning.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep142-kernstown-morning.svg","alt":"Schematic morning map of the First Battle of Kernstown around Pritchard’s Hill and the Valley Turnpike","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Kimball’s concentration on Pritchard’s Hill stopped Ashby’s morning probes and gave the United States artillery observation over the approaches from the south."}]]}],["$","figure","/images/ep142-kernstown-afternoon.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep142-kernstown-afternoon.svg","alt":"Schematic early-afternoon map of Confederate movements from Barton’s Woods toward Sandy Ridge","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson tried to avoid a direct attack on Pritchard’s Hill by moving west, but incomplete orders and the exposed approach broke the movement into disconnected parts."}]]}]]}]]}]
