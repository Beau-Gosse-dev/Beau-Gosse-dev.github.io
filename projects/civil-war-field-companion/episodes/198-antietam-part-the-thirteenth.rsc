1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",198," · ","September 17, 1862"," · ","The Antietam battlefield at the Sunken Road and Piper farm east of Sharpsburg, then south along Antietam Creek from the Lower Bridge to the ridges and farms between the bridge and Sharpsburg, Maryland"]}],["$","h1",null,{"children":"ANTIETAM (Part the Thirteenth)"}],["$","span",null,{"className":"result-label","children":"At the Confederate center, improvised counterattacks and a concentrated artillery line stopped Richardson’s advance after the Sunken Road breakthrough. Richardson intended to renew the attack but was mortally wounded; McClellan sent Winfield Scott Hancock to hold the captured ground instead. At about 1:00 p.m., the 51st Pennsylvania and 51st New York captured the Lower Bridge. The Ninth Corps then required about two hours to cross, resupply, and reorganize. Its advance began about 3:00 p.m. and pushed D. R. Jones’s outnumbered defenders toward Sharpsburg. The episode ends at about 3:30 p.m., when Lee identified A. P. Hill’s column approaching from Harpers Ferry; Hill’s counterattack occurs in the next episode"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2049215990.mp3?updated=1695499599","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"About 12:30 to 3:30 p.m. at the center and Federal left"}],["$","small",null,{"children":"The episode follows the end of the Sunken Road breakthrough, the capture of the Lower Bridge, the two-hour Ninth Corps deployment, and the opening advance toward Sharpsburg."}]]}],["$","div","Confederate center after the breakthrough",{"children":[["$","span",null,{"children":"Confederate center after the breakthrough"}],["$","strong",null,{"children":"Fragmented infantry supported by a concentrated gun line"}],["$","small",null,{"children":"The Sunken Road position had collapsed, but Confederate officers rallied mixed groups around the Piper farm while artillery assembled behind them."}]]}],["$","div","D. H. Hill’s first counterattack",{"children":[["$","span",null,{"children":"D. H. Hill’s first counterattack"}],["$","strong",null,{"children":"A mixed force advanced through the Piper cornfield"}],["$","small",null,{"children":"The attack reached close range of the 5th New Hampshire in the Sunken Road before the 81st Pennsylvania helped repel it."}]]}],["$","div","Edward Cross’s “war paint” order",{"children":[["$","span",null,{"children":"Edward Cross’s “war paint” order"}],["$","strong",null,{"children":"5th New Hampshire soldiers blackened their faces with powder"}],["$","small",null,{"children":"Cross used the gesture and a shouted war cry to steady his veterans as Hill’s counterattack approached."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30"]}],"$L31","$undefined","$L32","$L33","$L34","$L35","$L36","$L37","$L38"]}]]}]
3b:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Hill’s second counterattack",{"children":[["$","span",null,{"children":"Hill’s second counterattack"}],["$","strong",null,{"children":"Hill personally led about 200 men in the episode"}],["$","small",null,{"children":"Hill reported that the small command met heavy fire and dispersed. The attacks delayed Richardson’s advance but did not retake the Sunken Road."}]]}]
f:["$","div","Miller’s battery",{"children":[["$","span",null,{"children":"Miller’s battery"}],["$","strong",null,{"children":"Double canister fired from the Piper orchard"}],["$","small",null,{"children":"Capt. M. B. Miller’s Washington Artillery battery fired at the approaching Federals while Longstreet’s staff helped serve depleted gun crews."}]]}]
10:["$","div","Confederate center strength",{"children":[["$","span",null,{"children":"Confederate center strength"}],["$","strong",null,{"children":"Hardly 2,000 infantry in the episode’s estimate"}],["$","small",null,{"children":"The surviving infantry consisted largely of fragments from commands that had already suffered heavy casualties and straggling."}]]}]
11:["$","div","Confederate artillery concentration",{"children":[["$","span",null,{"children":"Confederate artillery concentration"}],["$","strong",null,{"children":"About 20 cannon in the episode"}],["$","small",null,{"children":"Federal guns east of Antietam Creek engaged the Confederate batteries but did not silence them before Richardson’s advance stopped."}]]}]
12:["$","div","Why Richardson paused",{"children":[["$","span",null,{"children":"Why Richardson paused"}],["$","strong",null,{"children":"Exhaustion, low ammunition, and Confederate artillery fire"}],["$","small",null,{"children":"Richardson withdrew his forward troops to defensible ground so they could reorganize and refill cartridge boxes before another advance."}]]}]
13:["$","div","Richardson’s intention",{"children":[["$","span",null,{"children":"Richardson’s intention"}],["$","strong",null,{"children":"Resume the offensive with fresh infantry and rifled artillery"}],["$","small",null,{"children":"His division had broken the Confederate infantry line but lacked the artillery support needed to suppress the guns beyond the Piper farm."}]]}]
14:["$","div","Final bridge assault",{"children":[["$","span",null,{"children":"Final bridge assault"}],["$","strong",null,{"children":"51st Pennsylvania and 51st New York"}],["$","small",null,{"children":"The two regiments of Edward Ferrero’s brigade advanced downhill after earlier Ninth Corps attacks had failed. NPS interpretation gives their combined strength as about 650 men."}]]}]
15:["$","div","Ferrero’s whiskey promise",{"children":[["$","span",null,{"children":"Ferrero’s whiskey promise"}],["$","strong",null,{"children":"The daily ration would be restored if the bridge was taken"}],["$","small",null,{"children":"The episode recounts Corporal Lewis Patterson of the 51st Pennsylvania asking Ferrero whether the regiment would receive its whiskey after capturing the bridge."}]]}]
16:["$","div","Approach to the bridge",{"children":[["$","span",null,{"children":"Approach to the bridge"}],["$","strong",null,{"children":"A direct rush followed by a firefight from cover"}],["$","small",null,{"children":"The Pennsylvanians used a stone wall near the creek. The New Yorkers moved left toward a post-and-rail fence before both regiments charged again."}]]}]
17:["$","div","George Whitman",{"children":[["$","span",null,{"children":"George Whitman"}],["$","strong",null,{"children":"Lieutenant in the 51st New York and Walt Whitman’s brother"}],["$","small",null,{"children":"His account describes the sustained Federal fire across the creek before the final rush."}]]}]
18:["$","div","Confederate bridge defenders",{"children":[["$","span",null,{"children":"Confederate bridge defenders"}],["$","strong",null,{"children":"Robert Toombs’s Georgians were nearly out of ammunition"}],["$","small",null,{"children":"They had held the crossing for about three hours. Sources differ on whether their withdrawal was prearranged, but the two Federal regiments secured the west bank."}]]}]
19:["$","div","Lower Bridge captured",{"children":[["$","span",null,{"children":"Lower Bridge captured"}],["$","strong",null,{"children":"About 1:00 p.m."}],["$","small",null,{"children":"The crossing subsequently became known as Burnside Bridge. The NPS timeline places Ferrero’s successful attack at 1:00 p.m."}]]}]
1a:["$","div","Israel B. Richardson",{"children":[["$","span",null,{"children":"Israel B. Richardson"}],["$","strong",null,{"children":"Mortally wounded at about 1:00 p.m."}],["$","small",null,{"children":"A Confederate shell fragment struck him while he was directing artillery. He was taken to the Pry House and died from complications on November 3, 1862."}]]}]
1b:["$","div","Hancock replaces Richardson",{"children":[["$","span",null,{"children":"Hancock replaces Richardson"}],["$","strong",null,{"children":"Ordered to hold the position north of the Sunken Road"}],["$","small",null,{"children":"McClellan personally assigned Winfield Scott Hancock to the division. Hancock’s official report records instructions to hold rather than make an unsupported attack."}]]}]
1c:["$","div","Available Federal formations",{"children":[["$","span",null,{"children":"Available Federal formations"}],["$","strong",null,{"children":"VI Corps had arrived; most of V Corps had not fought"}],["$","small",null,{"children":"The episode argues that Smith’s and Slocum’s divisions and much of Porter’s corps gave McClellan enough fresh strength to renew the center attack. McClellan retained these troops for other contingencies."}]]}]
1d:["$","div","McClellan’s 1:25 p.m. message",{"children":[["$","span",null,{"children":"McClellan’s 1:25 p.m. message"}],["$","strong",null,{"children":"He told Halleck that he believed the odds were against him"}],["$","small",null,{"children":"The episode uses the draft and revision of this message to show that McClellan still feared a major Confederate counterattack despite the break in Lee’s center."}]]}]
1e:["$","div","Interpretive dispute at midday",{"children":[["$","span",null,{"children":"Interpretive dispute at midday"}],["$","strong",null,{"children":"The episode presents the halt as a missed opportunity"}],["$","small",null,{"children":"That conclusion is an interpretation rather than a directly measurable fact. McClellan’s report emphasized losses, disorganization, and risk to the Federal center; Hancock reported that his weakened division lacked reserves and artillery for an unsupported attack."}]]}]
1f:["$","div","Burnside’s bridgehead report",{"children":[["$","span",null,{"children":"Burnside’s bridgehead report"}],["$","strong",null,{"children":"Ninth Corps was across and could hold the west bank"}],["$","small",null,{"children":"McClellan responded by directing Burnside to continue toward Sharpsburg so the Confederate right could not reinforce other sectors."}]]}]
20:["$","div","Thomas Key’s mission",{"children":[["$","span",null,{"children":"Thomas Key’s mission"}],["$","strong",null,{"children":"Carry positive orders to continue the Ninth Corps advance"}],["$","small",null,{"children":"McClellan authorized his aide to relieve Burnside if Key was not satisfied that the instructions would be obeyed. Burnside promised to move forward and remained in command."}]]}]
21:["$","div","Delay after the bridge fell",{"children":[["$","span",null,{"children":"Delay after the bridge fell"}],["$","strong",null,{"children":"About two hours"}],["$","small",null,{"children":"Sturgis’s division needed ammunition, Willcox’s division had to pass through a bridge bottleneck, and Rodman’s column had to form after crossing at Snavely’s Ford."}]]}]
22:["$","div","Northern-field loss estimate",{"children":[["$","span",null,{"children":"Northern-field loss estimate"}],["$","strong",null,{"children":"About 18,500 casualties in the episode"}],["$","small",null,{"children":"The estimate covers the roughly mile-square area between the East and West Woods, Miller cornfield, and Sunken Road. It is not the casualty total for the full battle."}]]}]
23:["$","div","Franklin’s proposal",{"children":[["$","span",null,{"children":"Franklin’s proposal"}],["$","strong",null,{"children":"Attack the Confederate left in the West Woods"}],["$","small",null,{"children":"William B. Franklin and division commanders William F. Smith and Henry W. Slocum supported another attack. Edwin V. Sumner opposed it because he feared there would be no organized force to meet a counterattack if Franklin failed."}]]}]
24:["$","div","McClellan visits the northern front",{"children":[["$","span",null,{"children":"McClellan visits the northern front"}],["$","strong",null,{"children":"About 2:00 p.m."}],["$","small",null,{"children":"After hearing Sumner and Franklin, McClellan accepted Sumner’s recommendation and did not renew the attack on that part of the field."}]]}]
25:["$","div","Ninth Corps attacking strength",{"children":[["$","span",null,{"children":"Ninth Corps attacking strength"}],["$","strong",null,{"children":"About 8,500 in the episode; about 8,000 in NPS interpretation"}],["$","small",null,{"children":"Three divisions advanced while Sturgis’s exhausted division remained in reserve near the bridge."}]]}]
26:["$","div","Confederate right",{"children":[["$","span",null,{"children":"Confederate right"}],["$","strong",null,{"children":"About 2,800 under D. R. Jones in the episode"}],["$","small",null,{"children":"NPS interpretation uses more than 2,000 infantry and more than forty cannon. Lee had repeatedly taken units from this sector to reinforce the left and center."}]]}]
27:["$","div","Ninth Corps plan",{"children":[["$","span",null,{"children":"Ninth Corps plan"}],["$","strong",null,{"children":"Two parallel thrusts across a front about three-quarters of a mile wide"}],["$","small",null,{"children":"Willcox advanced on the right toward Sharpsburg along the bridge road. Rodman moved on the left, then turned right toward the Harpers Ferry Road and the Confederate line of retreat."}]]}]
28:["$","div","Support formations",{"children":[["$","span",null,{"children":"Support formations"}],["$","strong",null,{"children":"Crook behind Willcox; Scammon behind Rodman"}],["$","small",null,{"children":"The two brigades of the Kanawha Division supported the two attacking wings while Sturgis remained the corps reserve."}]]}]
29:["$","div","Terrain on Willcox’s front",{"children":[["$","span",null,{"children":"Terrain on Willcox’s front"}],["$","strong",null,{"children":"Ridges, ravines, fields, orchards, fences, and farm buildings"}],["$","small",null,{"children":"The broken ground prevented a uniform advance and turned the movement into multiple local fights under Confederate artillery fire."}]]}]
2a:["$","div","Middle Bridge support",{"children":[["$","span",null,{"children":"Middle Bridge support"}],["$","strong",null,{"children":"Federal regulars and Pleasonton’s cavalry held a connecting sector"}],["$","small",null,{"children":"Pleasonton requested additional V Corps infantry after observing Confederate weakness. The regular infantry was retained near the Middle Bridge batteries instead."}]]}]
2b:["$","div","Rodman’s front",{"children":[["$","span",null,{"children":"Rodman’s front"}],["$","strong",null,{"children":"Open rising ground toward the Harpers Ferry Road"}],["$","small",null,{"children":"D. R. Jones placed roughly a dozen guns on the ridge in the episode’s account, giving them a clear field of fire over Fairchild’s advance."}]]}]
2c:["$","div","Fairchild’s brigade",{"children":[["$","span",null,{"children":"Fairchild’s brigade"}],["$","strong",null,{"children":"New Yorkers charged Kemper and Drayton"}],["$","small",null,{"children":"The episode places about 700 Federals against about 590 Confederates behind a rail fence and stone wall. The opposing lines opened fire at about fifty yards."}]]}]
2d:["$","div","Confederate right gives way",{"children":[["$","span",null,{"children":"Confederate right gives way"}],["$","strong",null,{"children":"Kemper and Drayton were driven toward Sharpsburg"}],["$","small",null,{"children":"Federal infantry reached the outskirts while retreating Confederate troops and artillery crowded the town’s streets."}]]}]
2e:["$","div","A. P. Hill arrives in view",{"children":[["$","span",null,{"children":"A. P. Hill arrives in view"}],["$","strong",null,{"children":"Lee identified the column at about 3:30 p.m. in the episode"}],["$","small",null,{"children":"Hill’s Light Division had marched from Harpers Ferry. The episode stops before those troops strike the Ninth Corps left, which NPS interpretation places at about 4:00 p.m."}]]}]
2f:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Crossroads of Freedom: Antietam” by James M. McPherson"}],["$","small",null,{"children":"The episode recommends the book for connecting the battle’s military events with its political, diplomatic, and emancipation consequences."}]]}]
30:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Snavely’s Ford, Edward Ferrero, Pleasonton, M. B. Miller, James V. Murfin, Pry House, and Crossroads of Freedom: Antietam"}],["$","small",null,{"children":"The automated transcript produces forms including “Snaley’s forward,” “Ferraro,” “Pleasanton,” “James Murphy,” and “Crossroads of Freedom and Tatum.” This guide uses the historical names and title."}]]}]
31:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
32:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Two critical sectors at midday",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep198-afternoon-overview.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Two critical sectors at midday at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep198-afternoon-overview.svg","alt":"Schematic map showing Richardson stopped near the Piper farm while the Ninth Corps captures the Lower Bridge and prepares to advance toward Sharpsburg.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Two critical sectors at midday"}],["$","span",null,{"children":"Richardson’s advance beyond the Sunken Road stopped under concentrated Confederate artillery fire while the Ninth Corps captured the Lower Bridge farther south. After the bridge fell at about 1:00 p.m., the Ninth Corps crossed, resupplied, and reorganized for two hours before moving toward Sharpsburg. Positions and routes are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep198-afternoon-overview.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield, Hancock’s and Cox’s Official Reports, Antietam Battlefield Board atlas, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$32:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Ninth Corps advances toward Sharpsburg",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep198-ninth-corps-advance.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Ninth Corps advances toward Sharpsburg at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep198-ninth-corps-advance.svg","alt":"Schematic tactical map of Willcox and Rodman advancing west from Antietam Creek against Kemper and Drayton south of Sharpsburg, with A. P. Hill approaching from the south.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Ninth Corps advances toward Sharpsburg"}],["$","span",null,{"children":"Willcox moved directly toward Sharpsburg on the Federal right while Rodman advanced on the left and began turning north. Crook and Scammon followed as supports, and Sturgis remained in reserve near the bridge. Fairchild’s New Yorkers broke through Kemper and Drayton near the Harpers Ferry Road. A. P. Hill’s approach is shown only as an arriving column because his counterattack falls outside this episode. Positions and routes are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep198-ninth-corps-advance.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$32:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield Final Attack Trail, Cox’s and D. R. Jones’s Official Reports, Antietam Battlefield Board atlas, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L39"]}]]}],"$undefined"]}]]}],"$L3a"]}]]}]
33:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The broken Confederate center is recapped",{"className":"moment","children":[["$","$L3b",null,{"seconds":73,"label":"1:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"The broken Confederate center is recapped"}],["$","p",null,{"children":"Federal troops have crossed the Sunken Road and entered the Piper cornfield while Richardson presses the advantage."}]]}]]}],["$","div","Hill organizes a counterattack",{"className":"moment","children":[["$","$L3b",null,{"seconds":131,"label":"2:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hill organizes a counterattack"}],["$","p",null,{"children":"D. H. Hill and his officers rally a mixed Confederate force on the Piper farm and send it toward the road."}]]}]]}],["$","div","The 5th New Hampshire waits in the road",{"className":"moment","children":[["$","$L3b",null,{"seconds":158,"label":"2:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 5th New Hampshire waits in the road"}],["$","p",null,{"children":"Cross’s veterans use the captured Sunken Road as cover while Confederates approach through the cornfield."}]]}]]}],["$","div","Cross orders “war paint”",{"className":"moment","children":[["$","$L3b",null,{"seconds":185,"label":"3:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cross orders “war paint”"}],["$","p",null,{"children":"The New Hampshire soldiers smear black powder on their faces and answer the rebel yell with their own shouted war cry."}]]}]]}],["$","div","A Confederate color bearer reaches close range",{"className":"moment","children":[["$","$L3b",null,{"seconds":215,"label":"3:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"A Confederate color bearer reaches close range"}],["$","p",null,{"children":"The counterattack comes within about fifteen yards of the road before Federal fire drops the flag bearer."}]]}]]}],["$","div","The 81st Pennsylvania reinforces the defense",{"className":"moment","children":[["$","$L3b",null,{"seconds":238,"label":"3:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 81st Pennsylvania reinforces the defense"}],["$","p",null,{"children":"Its arrival helps the 5th New Hampshire repel the Confederate attack."}]]}]]}],["$","div","Hill leads another charge",{"className":"moment","children":[["$","$L3b",null,{"seconds":245,"label":"4:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hill leads another charge"}],["$","p",null,{"children":"Hill takes a musket and personally advances with about 200 men, but the small force is broken and dispersed."}]]}]]}],["$","div","Miller’s battery opens with canister",{"className":"moment","children":[["$","$L3b",null,{"seconds":276,"label":"4:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Miller’s battery opens with canister"}],["$","p",null,{"children":"The Washington Artillery battery in the Piper orchard uses double canister as Federal infantry approaches."}]]}]]}],["$","div","Longstreet’s staff helps serve the guns",{"className":"moment","children":[["$","$L3b",null,{"seconds":308,"label":"5:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet’s staff helps serve the guns"}],["$","p",null,{"children":"With gun crews depleted by casualties, staff officers take positions at the artillery pieces."}]]}]]}],["$","div","The Confederate infantry center is reduced",{"className":"moment","children":[["$","$L3b",null,{"seconds":331,"label":"5:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate infantry center is reduced"}],["$","p",null,{"children":"The episode estimates that fewer than 2,000 disorganized infantry remain in the center."}]]}]]}],["$","div","Twenty cannon support the center",{"className":"moment","children":[["$","$L3b",null,{"seconds":353,"label":"5:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Twenty cannon support the center"}],["$","p",null,{"children":"The assembled Confederate gun line compensates for the shattered infantry formations in front of it."}]]}]]}],["$","div","Richardson’s forward movement stops",{"className":"moment","children":[["$","$L3b",null,{"seconds":391,"label":"6:31"}],["$","div",null,{"children":["$L3c","$L3d"]}]]}],"$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51","$L52","$L53","$L54","$L55","$L56","$L57","$L58","$L59","$L5a","$L5b","$L5c","$L5d","$L5e","$L5f","$L60","$L61","$L62","$L63","$L64","$L65","$L66","$L67","$L68","$L69","$L6a","$L6b","$L6c","$L6d","$L6e","$L6f","$L70","$L71"]}]]}]
34:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Stopped the center attack, sent Hancock to hold Richardson’s position, declined Franklin’s northern attack, and ordered Burnside to move toward Sharpsburg"}]]}],["$","div","Senior commander on the Federal right; II and XII Corps oversight-Maj. Gen. Edwin V. Sumner",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior commander on the Federal right; II and XII Corps oversight"}],["$","span",null,{"children":"Maj. Gen. Edwin V. Sumner"}],["$","small",null,{"children":"Opposed Franklin’s proposed attack after the losses and disorganization north of the Sunken Road"}]]}],["$","div","1st Division, II Corps-Maj. Gen. Israel B. Richardson / Brig. Gen. Winfield S. Hancock",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, II Corps"}],["$","span",null,{"children":"Maj. Gen. Israel B. Richardson / Brig. Gen. Winfield S. Hancock"}],["$","small",null,{"children":"Richardson prepared to renew the center attack but was mortally wounded; Hancock replaced him with orders to hold the captured ground"}]]}],["$","div","VI Corps-Maj. Gen. William B. Franklin",{"className":"command-entry","children":[["$","strong",null,{"children":"VI Corps"}],["$","span",null,{"children":"Maj. Gen. William B. Franklin"}],["$","small",null,{"children":"Proposed an attack into the West Woods with the divisions of William F. Smith and Henry W. Slocum; Sumner and McClellan rejected it"}]]}],["$","div","Ninth Corps and Army of the Potomac left wing-Maj. Gen. Ambrose E. Burnside",{"className":"command-entry","children":[["$","strong",null,{"children":"Ninth Corps and Army of the Potomac left wing"}],["$","span",null,{"children":"Maj. Gen. Ambrose E. Burnside"}],["$","small",null,{"children":"Directed the bridge operation and received McClellan’s order to continue the advance toward Sharpsburg"}]]}],["$","div","Immediate command of the Ninth Corps-Brig. Gen. Jacob D. Cox",{"className":"command-entry","children":[["$","strong",null,{"children":"Immediate command of the Ninth Corps"}],["$","span",null,{"children":"Brig. Gen. Jacob D. Cox"}],["$","small",null,{"children":"Organized the successful bridge assault and the 3:00 p.m. advance while Burnside exercised higher command"}]]}],["$","div","2nd Division, Ninth Corps-Brig. Gen. Samuel D. Sturgis",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, Ninth Corps"}],["$","span",null,{"children":"Brig. Gen. Samuel D. Sturgis"}],["$","small",null,{"children":"Sent Ferrero’s brigade against the bridge; his exhausted division resupplied and remained in reserve for the opening advance"}]]}],["$","div","2nd Brigade, Sturgis’s division-Brig. Gen. Edward Ferrero",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade, Sturgis’s division"}],["$","span",null,{"children":"Brig. Gen. Edward Ferrero"}],["$","small",null,{"children":"Sent Col. John F. Hartranft’s 51st Pennsylvania and Col. Robert B. Potter’s 51st New York to capture the bridge"}]]}],["$","div","1st Division, Ninth Corps-Brig. Gen. Orlando B. Willcox",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, Ninth Corps"}],["$","span",null,{"children":"Brig. Gen. Orlando B. Willcox"}],["$","small",null,{"children":"Advanced on the right toward Sharpsburg with the brigades of Benjamin C. Christ and Thomas Welsh"}]]}],"$L72","$L73","$L74"]]}],"$L75"]}],"$L76","$L77"]}]
35:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Maj. Gen. Israel B. Richardson",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. Israel B. Richardson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of 1st Division, II Corps","."]}]," ","Mortally wounded by a Confederate shell fragment while directing artillery after the Sunken Road breakthrough. He was taken to the Pry House, developed an infection and pneumonia, and died on November 3, 1862."]}]]}]]}]]}]
36:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep198-afternoon-overview.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep198-afternoon-overview.svg","alt":"Schematic map of the Sunken Road and Lower Bridge sectors around midday at Antietam.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The attack beyond the Sunken Road stopped while the Ninth Corps secured the Lower Bridge and prepared to advance."}]]}],["$","figure","/images/ep198-ninth-corps-advance.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep198-ninth-corps-advance.svg","alt":"Schematic map of the Ninth Corps opening advance from Burnside Bridge toward Sharpsburg.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Willcox advanced on the right, Rodman on the left, and Fairchild broke part of D. R. Jones’s line before A. P. Hill arrived."}]]}],["$","figure","/images/ep198-israel-richardson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep198-israel-richardson.jpg","alt":"Portrait of United States major general Israel B. Richardson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Richardson intended to renew the center attack but was mortally wounded while directing artillery after the Sunken Road breakthrough."}]]}],["$","figure","/images/ep198-burnside-bridge.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep198-burnside-bridge.jpg","alt":"Alexander Gardner’s southeastern view of Burnside Bridge in September 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The twin 51st regiments captured the Lower Bridge at about 1:00 p.m., opening the route for the rest of the Ninth Corps."}]]}]]}]]}]
