ts","children":[["$","div","Virginia departed Gosport",{"children":[["$","span",null,{"children":"Virginia departed Gosport"}],["$","strong",null,{"children":"About 11 a.m., March 8, 1862"}],"$undefined"]}],["$","div","Opening shot",{"children":[["$","span",null,{"children":"Opening shot"}],["$","strong",null,{"children":"About 1:20 p.m. from the armed tug USS Zouave"}],"$undefined"]}],["$","div","Virginia opened fire",{"children":[["$","span",null,{"children":"Virginia opened fire"}],["$","strong",null,{"children":"About 2 p.m."}],"$undefined"]}],["$","div","Cumberland rammed",{"children":[["$","span",null,{"children":"Cumberland rammed"}],["$","strong",null,{"children":"About 3 p.m."}],"$undefined"]}],["$","div","Congress surrendered",{"children":[["$","span",null,{"children":"Congress surrendered"}],["$","strong",null,{"children":"About 4:30 p.m."}],"$undefined"]}],["$","div","Virginia withdrew",{"children":[["$","span",null,{"children":"Virginia withdrew"}],["$","strong",null,{"children":"About 6:30 p.m."}],"$undefined"]}],["$","div","United States ships destroyed",{"children":[["$","span",null,{"children":"United States ships destroyed"}],["$","strong",null,{"children":"USS Cumberland and USS Congress"}],"$undefined"]}],["$","div","United States sailors killed",{"children":[["$","span",null,{"children":"United States sailors killed"}],["$","strong",null,{"children":"More than 250, according to the episode"}],"$undefined"]}],["$","div","Virginia casualties stated in the episode",{"children":[["$","span",null,{"children":"Virginia casualties stated in the episode"}],["$","strong",null,{"children":"2 killed; several wounded, including Franklin Buchanan"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$"