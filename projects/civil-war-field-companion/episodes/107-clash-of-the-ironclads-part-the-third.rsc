e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Hampton Roads today"}],["$","span",null,{"children":"The action occurred where the James and Elizabeth rivers enter Hampton Roads. Virginia came from Gosport Navy Yard on the Elizabeth River. Cumberland and Congress were off Newport News Point; the other large United States warships were nearer Fort Monroe."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
