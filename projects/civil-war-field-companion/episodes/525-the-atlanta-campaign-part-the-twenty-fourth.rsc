12:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L1a",null,{"guide":{"date":"June 27, 1864","place":"Kennesaw Mountain and Olley’s Creek, Georgia","result":"Sherman ended the frontal attacks and chose to build on Schofield’s advance around the Confederate left","facts":[{"label":"U.S. casualties","value":"About 3,000 killed, wounded, or missing"},{"label":"Confederate casualties","value":"About 700"},{"label":"Main attacks","value":"McPherson’s and Thomas’s fronts"},{"label":"Only U.S. gain","value":"Cox crossed Olley’s Creek on the Confederate left"},{"label":"Decision by nightfall","value":"Prepare a new flanking movement"}],"maps":[{"title":"Kennesaw Mountain battlefield","caption":"The 1864 drawing shows Pigeon Hill, Little and Big Kennesaw, Confederate artillery on the heights, and the U.S. position to the north.","source":"https://www.loc.gov/item/2004660525/","image":"/images/kennesaw-battlefield-drawing.jpg","alt":"1864 drawing of the Kennesaw Mountain battlefield and Confederate artillery positions"},{"title":"Troop movements on June 27","caption":"The National Park Service map shows U.S. attacks in blue and the Confederate line in red. Thomas’s main attack struck Cheatham Hill while McPherson attacked near Pigeon Hill and Schofield moved on the far left.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm","image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map of troop movements at Kennesaw Mountain on June 27, 1864"},{"title":"Battlefield and southern flanking route","caption":"The campaign map shows the Confederate works at Kennesaw and the roads and streams south toward Olley’s Creek, Nickajack Creek, and the Chattahoochee.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-4.jpg","alt":"U.S. Army campaign map showing Kennesaw Mountain and the route around the Confederate left"},{"title":"Kennesaw Mountain and the Sandtown Road area today","caption":"The frontal attacks failed north of Schofield, while Jacob Cox moved south beyond Olley’s Creek and threatened the end of Johnston’s line.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.78%2C33.77%2C-84.43%2C34.08&layer=mapnik&marker=33.956%2C-84.604"}],"moments":[{"time":"1:19","audioTime":79,"title":"Sherman reported the failed attacks","detail":"At 8 p.m., Sherman told Henry Halleck that the assaults by McPherson and Thomas had reached but not carried the Confederate works."},{"time":"2:05","audioTime":125,"title":"Initial casualty estimates were too low","detail":"Sherman first reported about 2,500 U.S. casualties. The total was about 3,000, compared with roughly 700 Confederate casualties."},{"time":"2:38","audioTime":158,"title":"Confederate fortifications determined the result","detail":"U.S. troops inflicted limited losses because the defenders remained behind strong breastworks."},{"time":"3:01","audioTime":181,"title":"Sherman considered two difficult alternatives","detail":"Another assault would cost more men, while moving around the Confederate line required leaving the railroad supply route."},{"time":"3:29","audioTime":209,"title":"Field telegraph connected the U.S. command","detail":"From Signal Hill, Sherman exchanged reports with Thomas, McPherson, Schofield, and other officers across the battlefield."},{"time":"4:22","audioTime":262,"title":"Thomas reported every attacking brigade stopped","detail":"At about 11 a.m., Thomas said his troops were exhausted and that Charles Harker and Daniel McCook had been severely wounded."},{"time":"5:03","audioTime":303,"title":"Sherman asked Thomas to reassess","detail":"Sherman wanted another attack only if Thomas believed it could succeed, partly to support McPherson and divert attention from Schofield."},{"time":"6:01","audioTime":361,"title":"Thomas rejected another direct assault","detail":"Jefferson C. Davis and Oliver O. Howard reported that the works and abatis were too strong. Thomas recommended saps and artillery instead."},{"time":"7:53","audioTime":473,"title":"Thomas warned that more assaults could destroy the army","detail":"He told Sherman that the works could be taken only with immense losses, if at all, and that the army had gained no material advantage."},{"time":"8:46","audioTime":526,"title":"Sherman accepted Thomas’s judgment","detail":"Sherman did not order another attack and deferred to the commanders who had examined the front."},{"time":"10:39","audioTime":639,"title":"Schofield reported progress on the southern flank","detail":"Jacob Cox crossed Olley’s Creek, drove back Confederate cavalry, and moved along the Sandtown Road toward Nickajack Creek."},{"time":"12:52","audioTime":772,"title":"Cox moved beyond Hood’s left","detail":"Schofield stopped the division before it became isolated, but its position already threatened the Confederate flank."},{"time":"13:51","audioTime":831,"title":"Sherman called Cox’s movement the day’s only advantage","detail":"He ordered Schofield to hold the ground and Thomas to secure the positions gained by the assaulting troops."},{"time":"14:41","audioTime":881,"title":"Sherman compared losses and considered the next move","detail":"He regretted the loss of Harker and McCook but argued that assaults were sometimes necessary. He then focused on the opening created south of Kennesaw."},{"time":"17:50","audioTime":1070,"title":"Sherman proposed leaving the railroad","detail":"That evening he asked Thomas about shifting around the Confederate left and directed him to begin preparations."},{"time":"18:51","audioTime":1131,"title":"The strategy changed from assault to maneuver","detail":"Sherman decided to reinforce Schofield, move around Johnston’s left, and force the Confederates either to withdraw or fight outside their works."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed the attacks and decided to resume maneuver"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Jefferson C. Davis and Oliver O. Howard reported against another assault"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Attacked north of Thomas and remained pinned near the works"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"Jacob D. Cox advanced beyond Olley’s Creek"},{"commander":"Jacob D. Cox","command":"3rd Division, XXIII Corps","subordinates":"Advanced on the Sandtown Road"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Held the Kennesaw defenses"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Held the left threatened by Cox"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Defended the central sector attacked by Thomas"},{"commander":"William W. Loring","command":"Loring’s Corps","subordinates":"Defended the Kennesaw heights"}]}],"people":[{"name":"George H. Thomas","role":"Stopped further frontal attacks after reports from the division and corps commanders","side":"United States"},{"name":"Jacob D. Cox","role":"Led the only substantial U.S. advance of the day beyond Olley’s Creek","side":"United States"},{"name":"Charles G. Harker","role":"Brigade commander mortally wounded during the IV Corps assault","side":"United States"},{"name":"Daniel McCook Jr.","role":"Brigade commander mortally wounded during the XIV Corps assault","side":"United States"},{"name":"Jefferson C. Davis","role":"XIV Corps division commander who reported that another assault was unlikely to succeed","side":"United States"},{"name":"Oliver O. Howard","role":"IV Corps commander who reported strong Confederate works and abatis","side":"United States"}],"losses":[{"name":"Charles G. Harker","side":"United States","role":"Brigade commander, IV Corps","outcome":"Mortally wounded in the June 27 assault and died the same day"},{"name":"Daniel McCook Jr.","side":"United States","role":"Brigade commander, XIV Corps","outcome":"Mortally wounded in the June 27 assault; died July 17, 1864"}],"gallery":[{"image":"/images/kennesaw-battlefield-drawing.jpg","alt":"Theodore R. Davis drawing of Confederate artillery positions at Kennesaw Mountain","caption":"Confederate artillery and fortifications across the Kennesaw heights.","source":"https://www.loc.gov/item/2004660525/"},{"image":"/images/atlanta-fortifications.jpg","alt":"Confederate earthwork fortifications photographed near Atlanta","caption":"Earth-and-timber defenses near Atlanta illustrate the strength of field fortifications during the campaign.","source":"https://www.loc.gov/item/2018670937/"}],"sources":[{"label":"Official Episode 525 page","url":"https://civilwarpodcast.org/2026/04/19/civil-war-podcast-episode-525/"},{"label":"National Park Service battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ga015"},{"label":"National Park Service Union order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/union-order-of-battle.htm"},{"label":"Library of Congress Kennesaw battlefield drawing","url":"https://www.loc.gov/item/2004660525/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"}]}}]}]
