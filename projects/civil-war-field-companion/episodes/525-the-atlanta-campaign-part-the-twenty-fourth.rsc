1a:["$","div",null,{"children":[["$","h3",null,{"children":"Schofield reported progress on the southern flank"}],["$","p",null,{"children":"Jacob Cox crossed Olley’s Creek, drove back Confederate cavalry, and moved along the Sandtown Road toward Nickajack Creek."}]]}]
1b:["$","div","Cox moved beyond Hood’s left",{"className":"moment","children":[["$","$L18",null,{"seconds":772,"label":"12:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cox moved beyond Hood’s left"}],["$","p",null,{"children":"Schofield stopped the division before it became isolated, but its position already threatened the Confederate flank."}]]}]]}]
1c:["$","div","Sherman called Cox’s movement the day’s only advantage",{"className":"moment","children":[["$","$L18",null,{"seconds":831,"label":"13:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman called Cox’s movement the day’s only advantage"}],["$","p",null,{"children":"He ordered Schofield to hold the ground and Thomas to secure the positions gained by the assaulting troops."}]]}]]}]
1d:["$","div","Sherman compared losses and considered the next move",{"className":"moment","children":[["$","$L18",null,{"seconds":881,"label":"14:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman compared losses and considered the next move"}],["$","p",null,{"children":"He regretted the loss of Harker and McCook but argued that assaults were sometimes necessary. He then focused on the opening created south of Kennesaw."}]]}]]}]
1e:["$","div","Sherman proposed leaving the railroad",{"className":"moment","children":[["$","$L18",null,{"seconds":1070,"label":"17:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman proposed leaving the railroad"}],["$","p",null,{"children":"That evening he asked Thomas about shifting around the Confederate left and directed him to begin preparations."}]]}]]}]
1f:["$","div","The strategy changed from assault to maneuver",{"className":"moment","children":[["$","$L18",null,{"seconds":1131,"label":"18:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The strategy changed from assault to maneuver"}],["$","p",null,{"children":"Sherman decided to reinforce Schofield, move around Johnston’s left, and force the Confederates either to withdraw or fight outside their works."}]]}]]}]
