12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Sherman reported the failed attacks",{"className":"moment","children":[["$","$L18",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman reported the failed attacks"}],["$","p",null,{"children":"At 8 p.m., Sherman told Henry Halleck that the assaults by McPherson and Thomas had reached but not carried the Confederate works."}]]}]]}],["$","div","Initial casualty estimates were too low",{"className":"moment","children":[["$","$L18",null,{"seconds":125,"label":"2:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Initial casualty estimates were too low"}],["$","p",null,{"children":"Sherman first reported about 2,500 U.S. casualties. The total was about 3,000, compared with roughly 700 Confederate casualties."}]]}]]}],["$","div","Confederate fortifications determined the result",{"className":"moment","children":[["$","$L18",null,{"seconds":158,"label":"2:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate fortifications determined the result"}],["$","p",null,{"children":"U.S. troops inflicted limited losses because the defenders remained behind strong breastworks."}]]}]]}],["$","div","Sherman considered two difficult alternatives",{"className":"moment","children":[["$","$L18",null,{"seconds":181,"label":"3:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman considered two difficult alternatives"}],["$","p",null,{"children":"Another assault would cost more men, while moving around the Confederate line required leaving the railroad supply route."}]]}]]}],["$","div","Field telegraph connected the U.S. command",{"className":"moment","children":[["$","$L18",null,{"seconds":209,"label":"3:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Field telegraph connected the U.S. command"}],["$","p",null,{"children":"From Signal Hill, Sherman exchanged reports with Thomas, McPherson, Schofield, and other officers across the battlefield."}]]}]]}],["$","div","Thomas reported every attacking brigade stopped",{"className":"moment","children":[["$","$L18",null,{"seconds":262,"label":"4:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas reported every attacking brigade stopped"}],["$","p",null,{"children":"At about 11 a.m., Thomas said his troops were exhausted and that Charles Harker and Daniel McCook had been severely wounded."}]]}]]}],["$","div","Sherman asked Thomas to reassess",{"className":"moment","children":[["$","$L18",null,{"seconds":303,"label":"5:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman asked Thomas to reassess"}],["$","p",null,{"children":"Sherman wanted another attack only if Thomas believed it could succeed, partly to support McPherson and divert attention from Schofield."}]]}]]}],["$","div","Thomas rejected another direct assault",{"className":"moment","children":[["$","$L18",null,{"seconds":361,"label":"6:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas rejected another direct assault"}],["$","p",null,{"children":"Jefferson C. Davis and Oliver O. Howard reported that the works and abatis were too strong. Thomas recommended saps and artillery instead."}]]}]]}],["$","div","Thomas warned that more assaults could destroy the army",{"className":"moment","children":[["$","$L18",null,{"seconds":473,"label":"7:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas warned that more assaults could destroy the army"}],["$","p",null,{"children":"He told Sherman that the works could be taken only with immense losses, if at all, and that the army had gained no material advantage."}]]}]]}],["$","div","Sherman accepted Thomas’s judgment",{"className":"moment","children":[["$","$L18",null,{"seconds":526,"label":"8:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman accepted Thomas’s judgment"}],["$","p",null,{"children":"Sherman did not order another attack and deferred to the commanders who had examined the front."}]]}]]}],["$","div","Schofield reported progress on the southern flank",{"className":"moment","children":["$L19","$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f"]}]]}]
