1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",138," · ","January 21, 1824–April 21, 1861"," · ","Clarksburg and Jackson’s Mill in western Virginia; West Point and Fort Hamilton, New York; Veracruz and Mexico City, Mexico; Fort Meade, Florida; and Lexington and Richmond, Virginia"]}],["$","h1",null,{"children":"STONEWALL JACKSON (Part the First)"}],["$","span",null,{"className":"result-label","children":"This biographical episode follows Thomas J. Jackson from childhood through West Point, the Mexican War, peacetime U.S. Army service, and ten years at Virginia Military Institute. It ends when Jackson takes the VMI cadet corps from Lexington toward Richmond on April 21, 1861. No Civil War battle is narrated. The experiences emphasized in the episode—academic persistence, aggressive service under fire, rigid adherence to duty, conflict with superiors, religious discipline, and demanding physical standards—later shaped his Confederate command style"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9955875055.mp3?updated=1695220146","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Jackson’s life before active Civil War field command"}],["$","small",null,{"children":"The opening discusses his later reputation and the 1862 Valley Campaign, but the chronological biography stops on April 21, 1861."}]]}],["$","div","Birth",{"children":[["$","span",null,{"children":"Birth"}],["$","strong",null,{"children":"January 21, 1824, Clarksburg, Virginia"}],["$","small",null,{"children":"Clarksburg became part of West Virginia in 1863. Jackson’s father died when he was two and his mother when he was seven; relatives, especially his uncle Cummins Jackson, raised him."}]]}],["$","div","West Point",{"children":[["$","span",null,{"children":"West Point"}],["$","strong",null,{"children":"Cadet, July 1, 1842–July 1, 1846; graduated 17th of 59"}],["$","small",null,{"children":"Jackson entered with weak formal preparation and improved his standing through sustained study."}]]}],["$","div","U.S. Army branch",{"children":[["$","span",null,{"children":"U.S. Army branch"}],["$","strong",null,{"children":"1st U.S. Artillery"}],["$","small",null,{"children":"He graduated as a brevet second lieutenant and served in Winfield Scott’s campaign in Mexico."}]]}],["$","div","Mexican War service",{"children":[["$","span",null,{"children":"Mexican War service"}],["$","strong",null,{"children":"Veracruz, Cerro Gordo, La Hoya, Ocalaca, Contreras, Churubusco, Molino del Rey, Chapultepec, and Mexico City"}],["$","small",null,{"children":"This is the engagement list in Cullum’s register. The episode names the principal actions but omits several smaller or intermediate engagements."}]]}],["$","div","Mexican War promotions",{"children":["$Le","$Lf","$L10"]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b"]}],"$L1c","$L1d","$L1e","$L1f",false,"$L20","$L21","$L22"]}]]}]
23:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","span",null,{"children":"Mexican War promotions"}]
f:["$","strong",null,{"children":"Second lieutenant on August 20, 1847; brevet captain on August 20; brevet major on September 13"}]
10:["$","small",null,{"children":"Cullum’s register dates the captain’s brevet to gallantry at Contreras and Churubusco and the major’s brevet to Chapultepec. The episode incorrectly connects promotion to first lieutenant with the siege of Veracruz."}]
11:["$","div","Peacetime stations",{"children":[["$","span",null,{"children":"Peacetime stations"}],["$","strong",null,{"children":"Fort Columbus, Fort Hamilton, and Fort Meade"}],["$","small",null,{"children":"The official register places Jackson at Fort Columbus in 1848, Fort Hamilton in 1849–1851, and in Florida operations against Seminoles in 1851."}]]}]
12:["$","div","Fort Meade dispute",{"children":[["$","span",null,{"children":"Fort Meade dispute"}],["$","strong",null,{"children":"A command conflict with Maj. William H. French"}],["$","small",null,{"children":"The episode traces the dispute from control of a construction worker through competing accusations. Department commander David E. Twiggs transferred French; Jackson remained but soon left for VMI."}]]}]
13:["$","div","Army resignation chronology",{"children":[["$","span",null,{"children":"Army resignation chronology"}],["$","strong",null,{"children":"VMI service began in 1851; resignation was formally recorded February 29, 1852"}],["$","small",null,{"children":"The episode says Jackson resigned in August 1851 and then joined VMI. Cullum’s register records the later formal resignation date, so his VMI appointment and separation from the Army overlapped administratively."}]]}]
14:["$","div","VMI position",{"children":[["$","span",null,{"children":"VMI position"}],["$","strong",null,{"children":"Professor of Natural and Experimental Philosophy and instructor of artillery, 1851–1861"}],["$","small",null,{"children":"Francis H. Smith was VMI superintendent. D. H. Hill, then teaching at nearby Washington College, helped secure Jackson’s appointment."}]]}]
15:["$","div","First marriage",{"children":[["$","span",null,{"children":"First marriage"}],["$","strong",null,{"children":"Elinor “Ellie” Junkin, married August 4, 1853"}],["$","small",null,{"children":"Ellie and the couple’s stillborn son died from complications of childbirth on October 22, 1854."}]]}]
16:["$","div","Second marriage",{"children":[["$","span",null,{"children":"Second marriage"}],["$","strong",null,{"children":"Mary Anna Morrison, married July 16, 1857"}],["$","small",null,{"children":"The episode covers their courtship and structured household routine. Their first daughter, Mary Graham Jackson, died in infancy in 1858, a fact not mentioned in the episode."}]]}]
17:["$","div","Religion, education, and slavery",{"children":[["$","span",null,{"children":"Religion, education, and slavery"}],["$","strong",null,{"children":"Jackson helped operate a Sabbath school for free and enslaved Black people while enslaving people in his own household"}],["$","small",null,{"children":"VMI’s Jackson House Museum identifies seven individuals whom Jackson enslaved during his Lexington years: Albert, Amy, Hetty, Cyrus, George, Ann, and Emma. This context is necessary alongside the episode’s account of his religious teaching."}]]}]
18:["$","div","The lemon story",{"children":[["$","span",null,{"children":"The lemon story"}],["$","strong",null,{"children":"A disputed element of Jackson’s postwar image"}],["$","small",null,{"children":"The episode treats habitual lemon-eating as a postwar legend associated with Henry Kyd Douglas. The evidence does not justify turning either the habit or its complete invention into a firm biographical fact."}]]}]
19:["$","div","Departure for Richmond",{"children":[["$","span",null,{"children":"Departure for Richmond"}],["$","strong",null,{"children":"April 21, 1861"}],["$","small",null,{"children":"The episode gives 1:00 p.m. as the departure time. A VMI publication says Jackson ordered the corps forward at 12:30 p.m.; the date and purpose are not in dispute, but the exact time is."}]]}]
1a:["$","div","Combat and senior-leader losses",{"children":[["$","span",null,{"children":"Combat and senior-leader losses"}],["$","strong",null,{"children":"None within the chronological episode narrative"}],["$","small",null,{"children":"Mexican War actions are summarized retrospectively, but the episode does not identify a senior leader killed or mortally wounded in those passages."}]]}]
1b:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"Mighty Stonewall by Frank E. Vandiver"}],["$","small",null,{"children":"The hosts also refer listeners to James I. Robertson Jr.’s longer Stonewall Jackson: The Man, the Soldier, the Legend, recommended in episode 57."}]]}]
1c:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
1d:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Jackson’s prewar path",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep138-jackson-life-route.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Jackson’s prewar path at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep138-jackson-life-route.svg","alt":"Schematic map of Jackson’s movement from Clarksburg to West Point, Fort Hamilton, Fort Meade, Lexington, and Richmond","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jackson’s prewar path"}],["$","span",null,{"children":"The route places the principal locations in Jackson’s life from his birth in western Virginia through West Point, New York garrison duty, Fort Meade, VMI, and the cadet corps movement toward Richmond. It shows chronology and regional relationships; the lines are not reconstructed travel routes."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep138-jackson-life-route.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/35-3-1.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Jackson in Winfield Scott’s Mexico City campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep138-mexico-campaign.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Jackson in Winfield Scott’s Mexico City campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep138-mexico-campaign.svg","alt":"Operational map of the 1847 United States advance from Veracruz through Cerro Gordo to Mexico City and Jackson’s engagements","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jackson in Winfield Scott’s Mexico City campaign"}],["$","span",null,{"children":"Scott’s army landed at Veracruz and advanced inland through Cerro Gordo to Mexico City. Jackson served with the artillery through the siege and the later battles, receiving brevet rank for Contreras and Churubusco and for Chapultepec. Locations and the inland line of advance are schematic."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep138-mexico-campaign.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/73-3.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
1e:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The podcast turns toward the Shenandoah Valley",{"className":"moment","children":[["$","$L23",null,{"seconds":220,"label":"3:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"The podcast turns toward the Shenandoah Valley"}],["$","p",null,{"children":"The hosts pause the Peninsula Campaign and explain that Jackson’s biography will precede their account of his 1862 Valley Campaign."}]]}]]}],["$","div","Confederate fortunes form the strategic context",{"className":"moment","children":[["$","$L23",null,{"seconds":300,"label":"5:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate fortunes form the strategic context"}],["$","p",null,{"children":"The episode places Jackson’s later Valley victories against United States successes from New Orleans and Nashville to Forts Henry and Donelson, Shiloh, Pea Ridge, and the advance on Richmond."}]]}]]}],["$","div","Five Valley victories are named",{"className":"moment","children":[["$","$L23",null,{"seconds":360,"label":"6:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Five Valley victories are named"}],["$","p",null,{"children":"McDowell, Front Royal, First Winchester, Cross Keys, and Port Republic are summarized as the victories that produced Jackson’s wartime fame. Their battle narratives belong to later episodes."}]]}]]}],["$","div","Jackson’s names and reputation",{"className":"moment","children":[["$","$L23",null,{"seconds":432,"label":"7:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s names and reputation"}],["$","p",null,{"children":"The episode distinguishes the later public name “Stonewall,” the soldiers’ “Old Jack” and “Old Blue Light,” and the VMI cadets’ derisive “Tom Fool.”"}]]}]]}],["$","div","A demanding marching standard",{"className":"moment","children":[["$","$L23",null,{"seconds":496,"label":"8:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"A demanding marching standard"}],["$","p",null,{"children":"The hosts describe Jackson’s later field routine of fifty minutes marching, ten minutes resting, and long days in which he expected troops to cover exceptional distances before fighting."}]]}]]}],["$","div","The Lexington Sabbath school",{"className":"moment","children":[["$","$L23",null,{"seconds":573,"label":"9:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Lexington Sabbath school"}],["$","p",null,{"children":"Jackson’s religious instruction of Black people is introduced. The fuller record includes free and enslaved students and seven people Jackson enslaved during his Lexington years."}]]}]]}],["$","div","Childhood in western Virginia",{"className":"moment","children":[["$","$L23",null,{"seconds":689,"label":"11:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Childhood in western Virginia"}],["$","p",null,{"children":"Jackson was born at Clarksburg in 1824, lost both parents while young, and lived with several relatives, chiefly his uncle Cummins Jackson."}]]}]]}],["$","div","Health concerns shape daily habits",{"className":"moment","children":[["$","$L23",null,{"seconds":756,"label":"12:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Health concerns shape daily habits"}],["$","p",null,{"children":"The episode connects Jackson’s recurrent digestive complaints to rigid posture, restricted food, exercise, and other self-directed treatments. Retrospective diagnosis is not possible from these accounts."}]]}]]}],["$","div","The lemon tradition is challenged",{"className":"moment","children":[["$","$L23",null,{"seconds":865,"label":"14:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The lemon tradition is challenged"}],["$","p",null,{"children":"The hosts reject the familiar image of Jackson constantly eating lemons as postwar mythmaking. Surviving anecdotes do not establish either a constant habit or complete invention with certainty."}]]}]]}],["$","div","Jackson explains the raised arm",{"className":"moment","children":["$L24","$L25"]}],"$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37"]}]]}]
1f:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States Army, 1846–1852",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States Army, 1846–1852"}],[["$","div","Commander, army operating from Veracruz to Mexico City",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, army operating from Veracruz to Mexico City"}],["$","span",null,{"children":"Maj. Gen. Winfield Scott"}],["$","small",null,{"children":"Directed the campaign in which Jackson served with the 1st U.S. Artillery"}]]}],["$","div","Commander of a light battery during the Mexico City campaign",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander of a light battery during the Mexico City campaign"}],["$","span",null,{"children":"Capt. John B. Magruder"}],["$","small",null,{"children":"Jackson volunteered for Magruder’s battery after Cerro Gordo and served in later actions on the approaches to Mexico City"}]]}],["$","div","1st U.S. Artillery officer",{"className":"command-entry","children":[["$","strong",null,{"children":"1st U.S. Artillery officer"}],["$","span",null,{"children":"Bvt. Maj. Thomas J. Jackson"}],["$","small",null,{"children":"Began as a junior artillery officer and ended the Mexican War holding the brevet rank of major; his permanent rank was second lieutenant"}]]}],["$","div","Post commander, Fort Meade",{"className":"command-entry","children":[["$","strong",null,{"children":"Post commander, Fort Meade"}],["$","span",null,{"children":"Maj. William H. French"}],["$","small",null,{"children":"Jackson served as company quartermaster and commissary officer but disputed the scope of French’s command authority"}]]}],["$","div","Senior Florida and departmental commanders",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior Florida and departmental commanders"}],["$","span",null,{"children":"Brig. Gen. Thomas Childs and Maj. Gen. David E. Twiggs"}],["$","small",null,{"children":"Childs rejected Jackson’s claim of administrative independence; Twiggs later transferred French after the dispute escalated"}]]}]]]}],["$","section","Virginia Military Institute and Virginia forces, 1851–1861",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Virginia Military Institute and Virginia forces, 1851–1861"}],[["$","div","Superintendent, Virginia Military Institute",{"className":"command-entry","children":[["$","strong",null,{"children":"Superintendent, Virginia Military Institute"}],["$","span",null,{"children":"Francis H. Smith"}],["$","small",null,{"children":"Supervised the institution where Jackson held the chair of Natural and Experimental Philosophy and taught artillery"}]]}],["$","div","VMI professor and commander of the cadet corps movement",{"className":"command-entry","children":[["$","strong",null,{"children":"VMI professor and commander of the cadet corps movement"}],["$","span",null,{"children":"Maj. Thomas J. Jackson"}],["$","small",null,{"children":"Led the cadets from Lexington toward Richmond on April 21, 1861, for duty training Virginia recruits"}]]}],["$","div","Cadet formation assigned to Richmond",{"className":"command-entry","children":[["$","strong",null,{"children":"Cadet formation assigned to Richmond"}],["$","span",null,{"children":"VMI Corps of Cadets"}],["$","small",null,{"children":"Served as drill instructors for the expanding Virginia forces after secession"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Thomas J. Jackson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep138-thomas-jackson.jpg","alt":"Portrait of Thomas J. Jackson","width":420,"height":520,"loading":"lazy"}],"$L38"]}],"$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40"]}]]}]
20:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep138-thomas-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep138-thomas-jackson.jpg","alt":"Civil War-era photographic portrait of Thomas J. Stonewall Jackson facing left","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This photograph records Jackson after he became a Confederate general. The episode concerns the earlier experiences that shaped the officer and professor shown here."}]]}],["$","figure","/images/ep138-chapultepec.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep138-chapultepec.jpg","alt":"Hand-colored 1847 or 1848 lithograph depicting the United States attack on Chapultepec","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A contemporary popular print of the September 13, 1847 attack on Chapultepec. It is an artistic representation, not an exact tactical record. Jackson received the brevet rank of major for his conduct in this battle."}]]}],["$","figure","/images/ep138-vmi-cadet.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep138-vmi-cadet.jpg","alt":"Hand-colored ambrotype of an unidentified Virginia Military Institute cadet around 1860","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"An unidentified VMI cadet photographed about 1860. Jackson taught artillery and Natural and Experimental Philosophy at VMI, then led the cadet corps toward Richmond in April 1861."}]]}],["$","figure","/images/ep138-jackson-life-route.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep138-jackson-life-route.svg","alt":"Schematic map of Jackson’s prewar movement through Virginia, New York, and Florida","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s prewar career moved him from western Virginia to West Point, the U.S. Army, Florida, and finally a decade in Lexington before the Civil War."}]]}],["$","figure","/images/ep138-mexico-campaign.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep138-mexico-campaign.svg","alt":"Schematic map of Winfield Scott’s 1847 advance from Veracruz to Mexico City","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson served in the artillery along Scott’s route from Veracruz to Mexico City and earned brevet promotions for his conduct in the later battles."}]]}]]}]]}]
