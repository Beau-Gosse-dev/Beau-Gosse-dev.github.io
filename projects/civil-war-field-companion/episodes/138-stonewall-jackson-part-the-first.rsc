ry Anna Jackson’s Memoirs of Stonewall Jackson"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://vmi.contentdm.oclc.org/digital/collection/p15821coll4",{"children":["$","a",null,{"href":"https://vmi.contentdm.oclc.org/digital/collection/p15821coll4","target":"_blank","rel":"noreferrer","children":["Primary sources: VMI Archives Stonewall Jackson Papers"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://arvasarchive.org/catalog/vilxv_repositories_3_resources_591_c01",{"children":["$","a",null,{"href":"https://arvasarchive.org/catalog/vilxv_repositories_3_resources_591_c01","target":"_blank","rel":"noreferrer","children":["VMI Archives: Stonewall Jackson papers finding aid"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://digitalcollections.vmi.edu/digital/api/collection/p15821coll8/id/21002/download",{"children":["$","a",null,{"href":"https://digitalcollections.vmi.edu/digital/api/collection/p15821coll8/id/21002/download","target":"_blank","rel":"noreferrer","children":["Virginia Military Institute: April 21 cadet corps departure account"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://history.army.mil/portals/143/Images/Publications/catalog/35-3-1.pdf",{"children":["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/35-3-1.pdf","target":"_blank","rel":"noreferrer","children":["U.S. Army Center of Military History: Thomas J. Jackson biography"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://history.army.mil/portals/143/Images/Publications/catalog/73-3.pdf",{"children":["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/73-3.pdf","target":"_blank","rel":"noreferrer","children":["U.S. Army Center of Military History: The Occupation of Mexico"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Mexican-War-Campaigns/",{"children":["$","a",null,{"href":"https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Mexican-War-Campaigns/","target":"_blank","rel":"noreferrer","children":["U.S. Army Center of Military History: Mexican War campaign summaries"," ","$L41"]}]}],"$L42","$L43","$L44","$L45","$L46"]}]]}]
22:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
24:["$","$L23",null,{"seconds":932,"label":"15:32"}]
25:["$","div",null,{"children":[["$","h3",null,{"children":"Jackson explains the raised arm"}],["$","p",null,{"children":"Soldiers later read religious meaning into the gesture, but the episode says Jackson believed lifting his left arm corrected an imbalance in blood and weight."}]]}]
26:["$","div","Illness at Fort Hamilton deepens his faith",{"className":"moment","children":[["$","$L23",null,{"seconds":996,"label":"16:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Illness at Fort Hamilton deepens his faith"}],["$","p",null,{"children":"The episode describes a severe illness during New York garrison duty and uses a letter to Jackson’s sister to mark a more personal, providential religious conviction."}]]}]]}]
27:["$","div","Sabbath observance and war",{"className":"moment","children":[["$","$L23",null,{"seconds":1079,"label":"17:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sabbath observance and war"}],["$","p",null,{"children":"Jackson refused ordinary Sunday tasks such as letter writing but accepted combat on Sunday when military circumstances required it."}]]}]]}]
28:["$","div","Jackson enters West Point",{"className":"moment","children":[["$","$L23",null,{"seconds":1180,"label":"19:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson enters West Point"}],["$","p",null,{"children":"He arrived in 1842 with limited formal preparation, steadily improved his class standing, and graduated seventeenth of fifty-nine in 1846."}]]}]]}]
29:["$","div","The Mexican War begins his active service",{"className":"moment","children":[["$","$L23",null,{"seconds":1245,"label":"20:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Mexican War begins his active service"}],["$","p",null,{"children":"Commissioned in the 1st U.S. Artillery, Jackson reached Texas after Zachary Taylor’s Monterrey campaign and sought an opportunity for combat."}]]}]]}]
2a:["$","div","Artillery service at Veracruz",{"className":"moment","children":[["$","$L23",null,{"seconds":1286,"label":"21:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Artillery service at Veracruz"}],["$","p",null,{"children":"Jackson served during the March 1847 siege. Contrary to the episode’s wording, the official register dates his permanent promotion to second lieutenant and brevet captain to August 20, after Contreras and Churubusco."}]]}]]}]
2b:["$","div","Jackson volunteers to serve with Magruder",{"className":"moment","children":[["$","$L23",null,{"seconds":1303,"label":"21:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson volunteers to serve with Magruder"}],["$","p",null,{"children":"After Cerro Gordo, he joined John B. Magruder’s captured light battery because he expected that command to see additional fighting."}]]}]]}]
2c:["$","div","Combat on the approaches to Mexico City",{"className":"moment","children":[["$","$L23",null,{"seconds":1341,"label":"22:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Combat on the approaches to Mexico City"}],["$","p",null,{"children":"The episode follows Jackson through Churubusco, Chapultepec, and the San Cosme gate. His brevet major dated September 13 recognized conduct at Chapultepec."}]]}]]}]
2d:["$","div","Jackson is ordered to Florida",{"className":"moment","children":[["$","$L23",null,{"seconds":1418,"label":"23:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson is ordered to Florida"}],["$","p",null,{"children":"He was ordered to Florida in October 1850 and served at Fort Meade under Maj. William H. French during 1851 operations connected to Seminole resistance."}]]}]]}]
2e:["$","div","The dispute with French reaches headquarters",{"className":"moment","children":[["$","$L23",null,{"seconds":1492,"label":"24:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"The dispute with French reaches headquarters"}],["$","p",null,{"children":"Jackson complained that French had infringed his authority over construction work. Brig. Gen. Thomas Childs rejected Jackson’s broad claim of independence from the post commander."}]]}]]}]
2f:["$","div","A personal investigation escalates the conflict",{"className":"moment","children":[["$","$L23",null,{"seconds":1578,"label":"26:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"A personal investigation escalates the conflict"}],["$","p",null,{"children":"Jackson questioned enlisted men about an allegation concerning French and a household servant. French arrested him and both officers prepared accusations."}]]}]]}]
30:["$","div","The Fort Meade dispute is resolved administratively",{"className":"moment","children":[["$","$L23",null,{"seconds":1702,"label":"28:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Fort Meade dispute is resolved administratively"}],["$","p",null,{"children":"After the dispute reached senior headquarters, Maj. Gen. David E. Twiggs transferred French. Jackson remained temporarily, then accepted the VMI position."}]]}]]}]
31:["$","div","Jackson joins the VMI faculty",{"className":"moment","children":[["$","$L23",null,{"seconds":1740,"label":"29:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson joins the VMI faculty"}],["$","p",null,{"children":"D. H. Hill helped arrange Jackson’s appointment in Lexington. Jackson taught Natural and Experimental Philosophy and artillery from 1851 to 1861."}]]}]]}]
32:["$","div","The conflict with cadet James A. Walker",{"className":"moment","children":[["$","$L23",null,{"seconds":1815,"label":"30:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The conflict with cadet James A. Walker"}],["$","p",null,{"children":"Jackson reported Walker for classroom insubordination. Walker was expelled and challenged Jackson to a duel, but no duel occurred; both men later served in the Confederate army."}]]}]]}]
33:["$","div","Marriage to Elinor Junkin ends in tragedy",{"className":"moment","children":[["$","$L23",null,{"seconds":1910,"label":"31:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Marriage to Elinor Junkin ends in tragedy"}],["$","p",null,{"children":"Jackson married Ellie in August 1853. She and their stillborn son died from complications of childbirth in October 1854."}]]}]]}]
34:["$","div","Jackson courts Mary Anna Morrison",{"className":"moment","children":[["$","$L23",null,{"seconds":1972,"label":"32:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson courts Mary Anna Morrison"}],["$","p",null,{"children":"After traveling in Europe, Jackson renewed contact with D. H. Hill’s sister-in-law Anna Morrison. They married in July 1857."}]]}]]}]
35:["$","div","The Jackson household follows a fixed routine",{"className":"moment","children":[["$","$L23",null,{"seconds":2049,"label":"34:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Jackson household follows a fixed routine"}],["$","p",null,{"children":"Anna’s memoir describes prayer, exercise, teaching, study, meals, gardening, and evening preparation on a strict schedule. Enslaved household members were required to attend morning prayers."}]]}]]}]
36:["$","div","Jackson leaves Lexington for Richmond",{"className":"moment","children":[["$","$L23",null,{"seconds":2140,"label":"35:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson leaves Lexington for Richmond"}],["$","p",null,{"children":"On April 21, 1861, Jackson took the VMI cadet corps toward Richmond to train Virginia recruits. The episode says the column departed at 1 p.m.; a VMI account gives 12:30 p.m."}]]}]]}]
37:["$","div","Book recommendation",{"className":"moment","children":[["$","$L23",null,{"seconds":2190,"label":"36:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Book recommendation"}],["$","p",null,{"children":"The hosts recommend Mighty Stonewall by Frank E. Vandiver and identify James I. Robertson Jr.’s larger biography as the more comprehensive alternative."}]]}]]}]
38:["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas J. Jackson"}],["$","p",null,{"children":"West Point graduate, U.S. artillery officer, VMI professor, enslaver, and future Confederate commander whose prewar life is the episode’s subject"}]]}]
39:["$","article","Winfield Scott",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WS"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Winfield Scott"}],["$","p",null,{"children":"Commanded the United States army that landed at Veracruz and captured Mexico City in the campaign where Jackson established his combat reputation"}]]}]]}]
3a:["$","article","John B. Magruder",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"John B. Magruder"}],["$","p",null,{"children":"Then a U.S. artillery captain, later a Confederate general; Jackson sought duty in his Mexican War battery because he expected further combat"}]]}]]}]
3b:["$","article","Daniel Harvey Hill",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"DH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Daniel Harvey Hill"}],["$","p",null,{"children":"Mexican War comrade and Washington College professor who promoted Jackson for the VMI appointment; later a Confederate general"}]]}]]}]
3c:["$","article","William H. French",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"William H. French"}],["$","p",null,{"children":"Senior U.S. Army officer at Fort Meade whose dispute with Jackson exposed Jackson’s rigid and combative view of subordinate authority"}]]}]]}]
3d:["$","article","Thomas Childs",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"TC"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Thomas Childs"}],["$","p",null,{"children":"Senior U.S. Army officer in Florida who ruled that Jackson remained subject to the post commander and criticized the officers’ personal hostility"}]]}]]}]
3e:["$","article","David E. Twiggs",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"DE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"David E. Twiggs"}],["$","p",null,{"children":"U.S. departmental commander who transferred French after the Fort Meade dispute; Twiggs later entered Confederate service"}]]}]]}]
3f:["$","article","Francis H. Smith",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"FH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Francis H. Smith"}],["$","p",null,{"children":"VMI superintendent who brought Jackson onto the faculty and led the institution during Jackson’s decade in Lexington"}]]}]]}]
40:["$","article","James A. Walker",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"James A. Walker"}],["$","p",null,{"children":"VMI cadet expelled after a classroom dispute with Jackson; he later commanded the Stonewall Brigade and served as a Confederate brigadier general"}]]}]]}]
