14:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L1b",null,{"guide":{"date":"February–March 1864","place":"Mississippi, Chattanooga, Rocky Face Ridge, Dalton, and Richmond","result":"The February reconnaissance showed that Dalton was difficult to attack from the north but vulnerable through gaps south of the town; at the same time, changes in both high commands shaped the coming campaign","facts":[{"label":"U.S. force sent toward Dalton","value":"About 25,000 men"},{"label":"Army of Tennessee troops ordered west","value":"About 16,000 men"},{"label":"Rocky Face reconnaissance","value":"February 24–26, 1864"},{"label":"10th Michigan losses","value":"About 60 men"},{"label":"Snake Creek Gap distance from Dalton","value":"About 12 miles south"}],"maps":[{"title":"Chattanooga, Dalton, and the southern gaps","caption":"The campaign map shows the railroad route through Chattanooga and Dalton, Rocky Face Ridge, Dug Gap, Snake Creek Gap, and Resaca.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of Chattanooga, Dalton, Rocky Face Ridge, and Resaca"},{"title":"Rocky Face Ridge and Snake Creek Gap today","caption":"The February reconnaissance approached Dalton from Chattanooga. U.S. troops found the northern defenses strong and identified routes around the southern end of Rocky Face Ridge.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-85.30%2C34.55%2C-84.75%2C35.10&layer=mapnik&marker=34.769%2C-84.971"},{"title":"The railroad behind Dalton","caption":"The Western and Atlantic Railroad ran south from Dalton through Resaca to Atlanta. A force moving through Snake Creek Gap could threaten Johnston’s supply and retreat route.","source":"https://www.loc.gov/resource/g3921p.rr006140/","image":"/images/western-atlantic-birds-eye-map.jpg","alt":"Birds-eye map of the Western and Atlantic Railroad between Chattanooga and Atlanta"}],"moments":[{"time":"1:26","audioTime":86,"title":"Sherman marched toward Meridian","detail":"The Meridian raid moved east from Vicksburg and forced Leonidas Polk to determine whether Sherman was heading for Mobile or Meridian."},{"time":"3:42","audioTime":222,"title":"Polk evacuated military stores from Meridian","detail":"Confederate workers removed useful supplies shortly before U.S. troops entered the town."},{"time":"4:27","audioTime":267,"title":"Davis ordered three divisions to Mississippi","detail":"Jefferson Davis directed Johnston to send Cheatham’s, Cleburne’s, and Walker’s divisions from Hardee’s Corps to reinforce Polk."},{"time":"5:45","audioTime":345,"title":"Grant’s Dalton demonstration was delayed","detail":"A false report that Longstreet threatened Knoxville caused Grant to divert 14,000 men before ordering a reconnaissance toward Dalton."},{"time":"7:13","audioTime":433,"title":"Palmer led 25,000 men toward Dalton","detail":"Because George Thomas was ill, John M. Palmer started the reconnaissance from the Chattanooga area on February 22."},{"time":"7:53","audioTime":473,"title":"The Meridian raid had already ended","detail":"Sherman was returning to Vicksburg before the Dalton movement could stop Confederate reinforcements."},{"time":"9:31","audioTime":571,"title":"U.S. troops tested Rocky Face Ridge","detail":"From February 24 through 26, the force skirmished with Confederate troops occupying the ridge west of Dalton."},{"time":"9:55","audioTime":595,"title":"The northern approach proved very strong","detail":"The 10th Michigan lost about 60 men while probing the defenses near Buzzard Roost Gap."},{"time":"10:21","audioTime":621,"title":"The 39th Indiana entered Dug Gap","detail":"Thomas Harrison’s mounted infantry drove off a Confederate company and repulsed a cavalry attack at the pass south of Dalton."},{"time":"10:48","audioTime":648,"title":"Harrison identified the railroad vulnerability","detail":"He reported that a larger force could move east through the gap and cut the Western and Atlantic Railroad south of Dalton."},{"time":"11:07","audioTime":667,"title":"Cleburne’s troops retook Dug Gap","detail":"A recalled Confederate brigade attacked on February 26 after Johnston overstated the size of the U.S. movement."},{"time":"11:27","audioTime":687,"title":"Thomas studied a deeper turning route","detail":"The reconnaissance led Thomas to focus on Snake Creek Gap, which opened toward Resaca and the railroad about 12 miles south of Dalton."},{"time":"13:42","audioTime":822,"title":"Bragg became Davis’s military adviser","detail":"Jefferson Davis assigned Braxton Bragg to help direct Confederate military operations from Richmond."},{"time":"16:02","audioTime":962,"title":"Congress restored the rank of lieutenant general","detail":"Lincoln signed the measure on February 29, clearing the way for Grant to become general-in-chief of the U.S. armies."},{"time":"17:20","audioTime":1040,"title":"Johnston sought a third infantry corps","detail":"He wanted a three-corps organization and recommended W. H. C. Whiting, then Mansfield Lovell, for the new command."},{"time":"19:05","audioTime":1145,"title":"Richmond rejected Johnston’s reorganization","detail":"The War Department said the army was too small for a third infantry corps, while Davis distrusted both officers Johnston proposed."},{"time":"19:38","audioTime":1178,"title":"Hood received an existing corps","detail":"John B. Hood arrived at Dalton in late February and replaced Thomas C. Hindman as corps commander."},{"time":"20:38","audioTime":1238,"title":"Johnston improved the army’s condition","detail":"He restored morale and supply but did not resolve the senior officers’ political and personal divisions."},{"time":"21:18","audioTime":1278,"title":"Johnston relied on Hood instead of Hardee","detail":"Hood became Johnston’s favored subordinate while privately criticizing him in correspondence with Richmond."},{"time":"22:50","audioTime":1370,"title":"The command conflict continued in private","detail":"Hood and Wheeler sent critical reports to Richmond, increasing distrust between Johnston and Davis before the campaign."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"Ulysses S. Grant","command":"Military Division of the Mississippi","subordinates":"Ordered the Dalton reconnaissance and was selected for promotion to general-in-chief"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Supervised the reconnaissance and retained the information about Snake Creek Gap"},{"commander":"John M. Palmer","command":"XIV Corps","subordinates":"Led about 25,000 men from Chattanooga toward Dalton"},{"commander":"Thomas J. Harrison","command":"39th Indiana Mounted Infantry","subordinates":"Reconnoitered Dug Gap and reported the route toward the railroad"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Jefferson Davis","command":"Confederate president","subordinates":"Directed strategic transfers and appointed Bragg as military adviser"},{"commander":"Braxton Bragg","command":"Military adviser in Richmond","subordinates":"Advised Davis on operations and personnel"},{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Hardee’s Corps, Hood’s Corps, and Wheeler’s Cavalry Corps"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Cheatham, Cleburne, Walker, and Bate before detachments and reorganization"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Replaced Thomas C. Hindman; Hindman returned to division command"},{"commander":"Joseph Wheeler","command":"Cavalry Corps","subordinates":"Reported separately to Johnston and maintained political ties to Bragg"},{"commander":"Leonidas Polk","command":"Department of Alabama, Mississippi, and East Louisiana","subordinates":"Requested reinforcements during Sherman’s Meridian raid"}]}],"people":[{"name":"George H. Thomas","role":"Used the reconnaissance to identify Snake Creek Gap as a route around Dalton","side":"United States"},{"name":"John M. Palmer","role":"Led the 25,000-man reconnaissance toward Rocky Face Ridge","side":"United States"},{"name":"Thomas J. Harrison","role":"Led the 39th Indiana into Dug Gap and reported the railroad could be reached from there","side":"United States"},{"personId":"ulysses-s-grant","role":"Ordered the movement and was elevated to command all U.S. armies"},{"name":"Joseph E. Johnston","role":"Defended Dalton, proposed a third corps, and favored Hood over Hardee","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"Leonidas Polk","role":"Protected Meridian’s supplies and sought reinforcements against Sherman","side":"Confederacy","image":"/images/leonidas-polk.jpg","source":"https://www.loc.gov/pictures/item/2018666546/"},{"name":"Braxton Bragg","role":"Returned to influence as Jefferson Davis’s military adviser in Richmond","side":"Confederacy","image":"/images/braxton-bragg.jpg","source":"https://www.loc.gov/pictures/item/2018670276/"},{"name":"John B. Hood","role":"Took command of a corps while corresponding privately with allies in Richmond","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"}],"losses":[],"gallery":[{"image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of northwest Georgia","caption":"The February reconnaissance found that the Dalton defenses could be turned through gaps south of Rocky Face Ridge.","source":"https://www.loc.gov/item/2008628278/"},{"image":"/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","caption":"Grant ordered the reconnaissance and was selected to become general-in-chief.","source":"https://www.loc.gov/item/2018666428/"},{"image":"/images/leonidas-polk.jpg","alt":"Portrait of Leonidas Polk in clerical clothing","caption":"Polk commanded Confederate forces in Mississippi, Alabama, and East Louisiana during the Meridian raid.","source":"https://www.loc.gov/pictures/item/2018666546/"},{"image":"/images/braxton-bragg.jpg","alt":"Portrait of Braxton Bragg","caption":"Bragg’s appointment in Richmond gave him influence over the Army of Tennessee and its officers.","source":"https://www.loc.gov/pictures/item/2018670276/"}],"sources":[{"label":"Official Episode 505 page","url":"https://civilwarpodcast.org/2025/09/14/civil-war-podcast-episode-505/"},{"label":"National Park Service Rocky Face Ridge summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=GA007"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"Library of Congress Ulysses S. Grant portrait","url":"https://www.loc.gov/item/2018666428/"},{"label":"Library of Congress Leonidas Polk portrait","url":"https://www.loc.gov/pictures/item/2018666546/"},{"label":"Library of Congress Braxton Bragg portrait","url":"https://www.loc.gov/pictures/item/2018670276/"}]}}]}]
