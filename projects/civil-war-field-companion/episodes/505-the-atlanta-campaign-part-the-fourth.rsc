12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Sherman marched toward Meridian",{"className":"moment","children":[["$","$L17",null,{"seconds":86,"label":"1:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman marched toward Meridian"}],["$","p",null,{"children":"The Meridian raid moved east from Vicksburg and forced Leonidas Polk to determine whether Sherman was heading for Mobile or Meridian."}]]}]]}],["$","div","Polk evacuated military stores from Meridian",{"className":"moment","children":[["$","$L17",null,{"seconds":222,"label":"3:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Polk evacuated military stores from Meridian"}],["$","p",null,{"children":"Confederate workers removed useful supplies shortly before U.S. troops entered the town."}]]}]]}],["$","div","Davis ordered three divisions to Mississippi",{"className":"moment","children":[["$","$L17",null,{"seconds":267,"label":"4:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis ordered three divisions to Mississippi"}],["$","p",null,{"children":"Jefferson Davis directed Johnston to send Cheatham’s, Cleburne’s, and Walker’s divisions from Hardee’s Corps to reinforce Polk."}]]}]]}],["$","div","Grant’s Dalton demonstration was delayed",{"className":"moment","children":[["$","$L17",null,{"seconds":345,"label":"5:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant’s Dalton demonstration was delayed"}],["$","p",null,{"children":"A false report that Longstreet threatened Knoxville caused Grant to divert 14,000 men before ordering a reconnaissance toward Dalton."}]]}]]}],["$","div","Palmer led 25,000 men toward Dalton",{"className":"moment","children":[["$","$L17",null,{"seconds":433,"label":"7:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Palmer led 25,000 men toward Dalton"}