18:["$","div","Thomas studied a deeper turning route",{"className":"moment","children":[["$","$L17",null,{"seconds":687,"label":"11:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas studied a deeper turning route"}],["$","p",null,{"children":"The reconnaissance led Thomas to focus on Snake Creek Gap, which opened toward Resaca and the railroad about 12 miles south of Dalton."}]]}]]}]
19:["$","div","Bragg became Davis’s military adviser",{"className":"moment","children":[["$","$L17",null,{"seconds":822,"label":"13:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg became Davis’s military adviser"}],["$","p",null,{"children":"Jefferson Davis assigned Braxton Bragg to help direct Confederate military operations from Richmond."}]]}]]}]
1a:["$","div","Congress restored the rank of lieutenant general",{"className":"moment","children":[["$","$L17",null,{"seconds":962,"label":"16:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Congress restored the rank of lieutenant general"}],["$","p",null,{"children":"Lincoln signed the measure on February 29, clearing the way for Grant to become general-in-chief of the U.S. armies."}]]}]]}]
1b:["$","div","Johnston sought a third infantry corps",{"className":"moment","children":[["$","$L17",null,{"seconds":1040,"label":"17:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston sought a third infantry corps"}],["$","p",null,{"children":"He wanted a three-corps organization and recommended W. H. C. Whiting, then Mansfield Lovell, for the new command."}]]}]]}]
1c:["$","div","Richmond rejected Johnston’s reorganization",{"className":"moment","children":[["$","$L17",null,{"seconds":1145,"label":"19:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richmond rejected Johnston’s reorganization"}],["$","p",null,{"children":"The War Department said the army was too small for a third infantry corps, while Davis distrusted both officers Johnston proposed."}]]}]]}]
1d:["$","div","Hood received an existing corps",{"className":"moment","children":[["$","$L17",null,{"seconds":1178,"label":"19:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood received an existing corps"}],["$","p",null,{"children":"John B. Hood arrived at Dalton in late February and replaced Thomas C. Hindman as corps commander."}]]}]]}]
1e:["$","div","Johnston improved the army’s condition",{"className":"moment","children":[["$","$L17",null,{"seconds":1238,"label":"20:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston improved the army’s condition"}],["$","p",null,{"children":"He restored morale and supply but did not resolve the senior officers’ political and personal divisions."}]]}]]}]
1f:["$","div","Johnston relied on Hood instead of Hardee",{"className":"moment","children":[["$","$L17",null,{"seconds":1278,"label":"21:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston relied on Hood instead of Hardee"}],["$","p",null,{"children":"Hood became Johnston’s favored subordinate while privately criticizing him in correspondence with Richmond."}]]}]]}]
20:["$","div","The command conflict continued in private",{"className":"moment","children":[["$","$L17",null,{"seconds":1370,"label":"22:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"The command conflict continued in private"}],["$","p",null,{"children":"Hood and Wheeler sent critical reports to Richmond, increasing distrust between Johnston and Davis before the campaign."}]]}]]}]
