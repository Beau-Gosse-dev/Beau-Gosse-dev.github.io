10:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep147-hotchkiss-shenandoah-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep147-hotchkiss-shenandoah-map.jpg","alt":"Jedediah Hotchkiss’s large 1862 manuscript map of the Shenandoah Valley from Winchester to Staunton.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley"}],["$","span",null,{"children":"Hotchkiss’s manuscript map records the Valley’s roads, rivers, gaps, ridges, settlements, and landowners from Winchester to Staunton. It is a primary cartographic source and shows the geography that shaped the operation, but it is not a dated troop-position or battle-phase map."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep147-hotchkiss-shenandoah-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99446754/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
