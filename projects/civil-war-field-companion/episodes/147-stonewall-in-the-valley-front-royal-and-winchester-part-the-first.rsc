1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",147," · ","May 11–22, 1862"," · ","Shenandoah Valley and Luray Valley, Virginia: Franklin and Staunton to Mount Solon, Harrisonburg, New Market, Mount Jackson, Strasburg, Front Royal, and Swift Run Gap"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: FRONT ROYAL & WINCHESTER (Part the First)"}],["$","span",null,{"className":"result-label","children":"Operational prelude; no battle is fought in this episode. Shields left the Shenandoah Valley to reinforce Irvin McDowell, reducing Nathaniel Banks to a divided command at Strasburg and Front Royal. After conflicting orders nearly pulled Richard Ewell east toward Richmond, Ewell and Jackson agreed on May 18 to concentrate against Banks. Both Confederate commands marched on May 19 and were united in the Luray Valley by May 22, setting up the Battle of Front Royal on May 23"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6731350963.mp3?updated=1695307521","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"From the aftermath of McDowell through the Confederate concentration on May 22"}],["$","small",null,{"children":"The fighting at Front Royal on May 23 and Winchester on May 25 belongs to the following installments. This guide does not count casualties from those battles."}]]}],["$","div","Operational result",{"children":[["$","span",null,{"children":"Operational result"}],["$","strong",null,{"children":"Jackson and Ewell united against an isolated Banks"}],["$","small",null,{"children":"The concentration began a ten-day sequence of marches and battles that carried Jackson’s command toward the Potomac."}]]}],["$","div","Jackson after McDowell",{"children":[["$","span",null,{"children":"Jackson after McDowell"}],["$","strong",null,{"children":"Back at the western edge of the Shenandoah Valley by May 17"}],["$","small",null,{"children":"After pursuing Frémont toward Franklin, Jackson retraced his route and incorporated six regiments from Edward “Allegheny” Johnson’s command into the Valley force."}]]}],["$","div","Shields detached",{"children":[["$","span",null,{"children":"Shields detached"}],["$","strong",null,{"children":"Ordered east to reinforce Irvin McDowell near Fredericksburg"}],["$","small",null,{"children":"The episode says Shields’s division left the Valley on May 15. Movement occurred in stages, and authoritative summaries use dates between May 12 and May 15 for the departure."}]]}],["$","div","Banks’s field force",{"children":[["$","span",null,{"children":"Banks’s field force"}],["$","strong",null,{"children":"About 4,500 infantry under Alpheus Williams plus about 1,500 cavalry"}],["$","small",null,{"children":"These are the episode’s figures after Shields departed. Strength totals vary by date and by whether detachments, artillery, and troops at Front Royal and Buckton Station are counted separately."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],"$L23","$undefined","$L24",false,"$L25",false,"$L26","$L27","$L28"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Williams’s division",{"children":[["$","span",null,{"children":"Williams’s division"}],["$","strong",null,{"children":"Two brigades and eight infantry regiments"}],["$","small",null,{"children":"The episode identifies regiments from Maryland, New York, Connecticut, Pennsylvania, Massachusetts, Wisconsin, and Indiana. A third brigade had been transferred to McDowell at the end of March."}]]}]
f:["$","div","Combat experience",{"children":[["$","span",null,{"children":"Combat experience"}],["$","strong",null,{"children":"Long-serving but essentially untested in a pitched battle"}],["$","small",null,{"children":"The hosts say the troops had drilled, marched, and skirmished, but that no company had yet fired in a battle. This is the episode’s characterization of Banks’s remaining command."}]]}]
10:["$","div","Banks’s problem",{"children":[["$","span",null,{"children":"Banks’s problem"}],["$","strong",null,{"children":"Defend Strasburg and Front Royal at the same time"}],["$","small",null,{"children":"Banks warned Washington on May 22 that both points were accessible to the enemy. Most of his force remained near Strasburg."}]]}]
11:["$","div","Distance between posts",{"children":[["$","span",null,{"children":"Distance between posts"}],["$","strong",null,{"children":"About 12 miles from Strasburg to Front Royal"}],["$","small",null,{"children":"The Manassas Gap Railroad and a country road connected the two positions, but Massanutten Mountain divided the larger operational area."}]]}]
12:["$","div","Front Royal garrison",{"children":[["$","span",null,{"children":"Front Royal garrison"}],["$","strong",null,{"children":"About 900 infantry and two guns, with no cavalry"}],["$","small",null,{"children":"This is the episode’s May 22 estimate. National Park Service accounts generally round the garrison to roughly 1,000–1,100 men."}]]}]
13:["$","div","Strasburg’s importance",{"children":[["$","span",null,{"children":"Strasburg’s importance"}],["$","strong",null,{"children":"Valley Turnpike, railroad connection, and route north to Winchester"}],["$","small",null,{"children":"The improved turnpike connected Staunton, Harrisonburg, New Market, Strasburg, and Winchester and remained usable when ordinary roads became muddy."}]]}]
14:["$","div","Front Royal’s importance",{"children":[["$","span",null,{"children":"Front Royal’s importance"}],["$","strong",null,{"children":"Northern entrance to the Luray Valley and a link toward eastern Virginia"}],["$","small",null,{"children":"A Confederate advance there could threaten Banks’s railroad communication and place troops between Banks and McDowell."}]]}]
15:["$","div","Massanutten Mountain",{"children":[["$","span",null,{"children":"Massanutten Mountain"}],["$","strong",null,{"children":"A long barrier separating the main Shenandoah Valley from the Luray Valley"}],["$","small",null,{"children":"For a large military column, New Market Gap was the practical crossing in this sector. That geography made Jackson’s location and route difficult for Banks to read."}]]}]
16:["$","div","Banks’s correct judgment",{"children":[["$","span",null,{"children":"Banks’s correct judgment"}],["$","strong",null,{"children":"Jackson intended to attack"}],["$","small",null,{"children":"By May 22 Banks no longer shared his April confidence. He warned the War Department that an offensive was likely and sought reinforcements."}]]}]
17:["$","div","Banks’s intelligence error",{"children":[["$","span",null,{"children":"Banks’s intelligence error"}],["$","strong",null,{"children":"He expected Jackson west of Massanutten and placed Ewell near Swift Run Gap"}],["$","small",null,{"children":"On May 22 the Confederate forces were already much closer together in the Luray Valley than Banks believed."}]]}]
18:["$","div","Stanton’s response",{"children":[["$","span",null,{"children":"Stanton’s response"}],["$","strong",null,{"children":"No immediate reinforcement"}],["$","small",null,{"children":"The episode reports that Secretary of War Edwin Stanton dismissed the danger Jackson posed even after Banks sent an aide to Washington."}]]}]
19:["$","div","Ewell’s assignment",{"children":[["$","span",null,{"children":"Ewell’s assignment"}],["$","strong",null,{"children":"Watch Banks from Swift Run Gap and discourage a Federal withdrawal"}],["$","small",null,{"children":"Jackson’s repeated instructions gave Ewell little information about the Valley force’s location or full design."}]]}]
1a:["$","div","Conflicting Confederate authority",{"children":[["$","span",null,{"children":"Conflicting Confederate authority"}],["$","strong",null,{"children":"Jackson, Joseph E. Johnston, and Robert E. Lee sent overlapping guidance"}],["$","small",null,{"children":"Ewell’s division belonged to Johnston’s army but operated inside Jackson’s Valley District. Lee, as Jefferson Davis’s military adviser, shaped strategy without holding direct field command."}]]}]
1b:["$","div","Ewell’s dilemma",{"children":[["$","span",null,{"children":"Ewell’s dilemma"}],["$","strong",null,{"children":"Remain with Jackson or follow Johnston’s conditional order east"}],["$","small",null,{"children":"Ewell understood Johnston’s instructions to require a move toward Richmond if Banks joined McDowell. Reports that Shields was already moving east made the order especially difficult to interpret."}]]}]
1c:["$","div","May 18 meeting",{"children":[["$","span",null,{"children":"May 18 meeting"}],["$","strong",null,{"children":"Jackson and Ewell conferred at Mount Solon"}],["$","small",null,{"children":"Ewell rode roughly 30 miles through the night and met Jackson at daybreak in a mill. They agreed that attacking Banks offered the best immediate opportunity."}]]}]
1d:["$","div","Written command decision",{"children":[["$","span",null,{"children":"Written command decision"}],["$","strong",null,{"children":"Ewell remained part of Jackson’s command while inside the Valley District"}],["$","small",null,{"children":"Jackson’s surviving May 18 letter directed Ewell to camp between New Market and Mount Jackson on May 21 unless a superior issued a later order."}]]}]
1e:["$","div","Letter-arrangement uncertainty",{"children":[["$","span",null,{"children":"Letter-arrangement uncertainty"}],["$","strong",null,{"children":"The official text survives; the private staging does not"}],["$","small",null,{"children":"The episode says the generals constructed and falsely addressed their May 18 exchange to protect Ewell from a charge of disobedience. The Official Records confirm the letter’s wording and date but do not independently establish every detail of that private arrangement."}]]}]
1f:["$","div","Original May 18 plan",{"children":[["$","span",null,{"children":"Original May 18 plan"}],["$","strong",null,{"children":"Concentrate near New Market, then move north on the Valley Turnpike against Strasburg"}],["$","small",null,{"children":"This was the plan described at the end of the episode. The later decision to turn through New Market Gap and strike Front Royal is outside the narrated scope."}]]}]
20:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Ewell, Staunton, Strasburg, Massanutten, Luray, and Irvin McDowell"}],["$","small",null,{"children":"The automated transcript repeatedly renders these as “Yule,” “Stanton,” “Strasbourg,” “Massa Nutton,” “LeRae,” and “Urban McDowell.” Names and places are normalized here."}]]}]
21:["$","div","Leader losses",{"children":[["$","span",null,{"children":"Leader losses"}],["$","strong",null,{"children":"None within this episode’s pre-battle scope"}],["$","small",null,{"children":"No important leader is killed or mortally wounded during the events narrated in this installment."}]]}]
22:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“Stonewall Jackson’s 1862 Valley Campaign: War Comes to the Homefront” by Jonathan A. Noyalas"}],"$undefined"]}]
23:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
24:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","May 22: separated Federal forces and concentrated Confederates",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep147-valley-geography-may22.svg","target":"_blank","rel":"noreferrer","aria-label":"Open May 22: separated Federal forces and concentrated Confederates at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep147-valley-geography-may22.svg","alt":"Schematic strategic map of May 22, 1862, showing Banks at Strasburg and Front Royal, Jackson and Ewell concentrated in the Luray Valley, Shields moving toward Fredericksburg, and Frémont west of the Shenandoah Valley.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"May 22: separated Federal forces and concentrated Confederates"}],["$","span",null,{"children":"Banks held Strasburg and Front Royal while Shields moved east toward McDowell, Frémont remained beyond the Alleghenies, and Jackson and Ewell concentrated in the Luray Valley. Banks expected the principal Confederate approach west of Massanutten and believed Ewell was still near Swift Run Gap. This strategic map is schematic: positions, distances, road traces, and force footprints are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep147-valley-geography-may22.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/Portals/143/Images/Publications/ArmyHistoryMag/pdf/19901999/AH47newOCR.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","May 18 plan: concentrate, then strike Banks at Strasburg",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep147-may18-strasburg-plan.svg","target":"_blank","rel":"noreferrer","aria-label":"Open May 18 plan: concentrate, then strike Banks at Strasburg at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep147-may18-strasburg-plan.svg","alt":"Schematic operational map of Jackson and Ewell concentrating between New Market and Mount Jackson and planning to advance north against Banks at Strasburg.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"May 18 plan: concentrate, then strike Banks at Strasburg"}],["$","span",null,{"children":"Jackson planned to march north from Mount Solon while Ewell left Swift Run Gap and moved toward the New Market–Mount Jackson area. Once united, they would continue north on the Valley Turnpike against Banks at Strasburg. This is a schematic operational plan, not a battle map, and it depicts the intention described in this episode rather than the route ultimately used against Front Royal."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep147-may18-strasburg-plan.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://ehistory.osu.edu/books/official-records/018/0897","target":"_blank","rel":"noreferrer","children":["Map source ","$L29"]}]]}],"$undefined"]}]]}],"$L2a"]}]]}]
25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","National strategic direction-President Abraham Lincoln / Secretary Edwin M. Stanton",{"className":"command-entry","children":[["$","strong",null,{"children":"National strategic direction"}],["$","span",null,{"children":"President Abraham Lincoln / Secretary Edwin M. Stanton"}],["$","small",null,{"children":"Directed Shields east toward McDowell while retaining Banks in the Valley; Stanton rejected Banks’s May 22 appeal for immediate reinforcement"}]]}],["$","div","Department of the Rappahannock-Maj. Gen. Irvin McDowell",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Rappahannock"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Concentrating near Fredericksburg for a projected advance toward Richmond and designated to receive Shields’s division"}]]}],["$","div","Department of the Shenandoah-Maj. Gen. Nathaniel P. Banks",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Shenandoah"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Held the Strasburg–Front Royal line with a reduced force and warned Washington that Jackson intended to attack"}]]}],["$","div","Infantry division under Banks-Brig. Gen. Alpheus S. Williams",{"className":"command-entry","children":[["$","strong",null,{"children":"Infantry division under Banks"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Two brigades and eight infantry regiments, approximately 4,500 men in the episode’s accounting"}]]}],["$","div","Detached division formerly under Banks-Brig. Gen. James Shields",{"className":"command-entry","children":[["$","strong",null,{"children":"Detached division formerly under Banks"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"Moving east from the Valley to reinforce McDowell near Fredericksburg"}]]}],["$","div","Mountain Department-Maj. Gen. John C. Frémont",{"className":"command-entry","children":[["$","strong",null,{"children":"Mountain Department"}],["$","span",null,{"children":"Maj. Gen. John C. Frémont"}],["$","small",null,{"children":"Remained beyond the Alleghenies after Jackson’s McDowell operation, separated from Banks"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Senior field command defending Richmond-Gen. Joseph E. Johnston",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior field command defending Richmond"}],["$","span",null,{"children":"Gen. Joseph E. Johnston"}],["$","small",null,{"children":"Ewell’s division belonged to Johnston’s army; his conditional instructions conflicted with Jackson’s immediate Valley plan"}]]}],["$","div","Military adviser to President Jefferson Davis-Gen. Robert E. Lee",{"className":"command-entry","children":["$L2b","$L2c","$L2d"]}],"$L2e","$L2f","$L30","$L31","$L32","$L33"]]}]]}],"$L34"]]]}]
26:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep147-hotchkiss-shenandoah-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep147-hotchkiss-shenandoah-map.jpg","alt":"Jedediah Hotchkiss’s large 1862 manuscript map of the Shenandoah Valley.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hotchkiss’s primary-source map shows the roads, gaps, rivers, ridges, and settlements that made divided command at Strasburg and Front Royal so difficult."}]]}],["$","figure","/images/ep147-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep147-stonewall-jackson.jpg","alt":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson returned from the western mountains and used his authority inside the Valley District to keep Ewell’s division in the operation against Banks."}]]}],["$","figure","/images/ep147-richard-ewell.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep147-richard-ewell.jpg","alt":"Wartime photographic portrait of Confederate general Richard S. Ewell in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Ewell endured conflicting directions from Jackson, Johnston, and Lee before the May 18 meeting resolved his immediate command relationship."}]]}],["$","figure","/images/ep147-nathaniel-banks.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep147-nathaniel-banks.jpg","alt":"Civil War-era photographic portrait of United States general Nathaniel P. Banks in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Bank