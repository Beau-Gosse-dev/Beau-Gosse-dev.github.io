12:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L21","/images/ep147-hotchkiss-shenandoah-map.jpg",{"image":"/images/ep147-hotchkiss-shenandoah-map.jpg","alt":"Jedediah Hotchkiss’s large 1862 manuscript map of the Shenandoah Valley.","caption":"Hotchkiss’s primary-source map shows the roads, gaps, rivers, ridges, and settlements that made divided command at Strasburg and Front Royal so difficult.","name":"Jedediah Hotchkiss’s large 1862 manuscript map of the Shenandoah Valley.","source":"https://www.loc.gov/item/99446754/","credit":"$undefined"}],["$","$L21","/images/ep147-stonewall-jackson.jpg",{"image":"/images/ep147-stonewall-jackson.jpg","alt":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform.","caption":"Jackson returned from the western mountains and used his authority inside the Valley District to keep Ewell’s division in the operation against Banks.","name":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform.","source":"https://www.loc.gov/item/2018670324/","credit":"$undefined"}],["$","$L21","/images/ep147-richard-ewell.jpg",{"image":"/images/ep147-richard-ewell.jpg","alt":"Wartime photographic portrait of Confederate general Richard S. Ewell in uniform.","caption":"Ewell endured conflicting directions from Jackson, Johnston, and Lee before the May 18 meeting resolved his immediate command relationship.","name":"Wartime photographic portrait of Confederate general Richard S. Ewell in uniform.","source":"https://www.loc.gov/pictures/item/2018670286/","credit":"$undefined"}],["$","$L21","/images/ep147-nathaniel-banks.jpg",{"image":"/images/ep147-nathaniel-banks.jpg","alt":"Civil War-era photographic portrait of United States general Nathaniel P. Banks in uniform.","caption":"Banks correctly feared an attack by May 22 but expected Jackson west of Massanutten and believed Ewell remained near Swift Run Gap.","name":"Civil War-era photographic portrait of United States general Nathaniel P. Banks in uniform.","source":"https://www.loc.gov/pictures/item/98506703/","credit":"$undefined"}]]}]]}]
