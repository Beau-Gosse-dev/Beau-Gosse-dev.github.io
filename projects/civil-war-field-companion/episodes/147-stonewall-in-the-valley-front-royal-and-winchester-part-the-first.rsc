d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",147," · ","May 11–22, 1862"," · ","Shenandoah Valley and Luray Valley, Virginia: Franklin and Staunton to Mount Solon, Harrisonburg, New Market, Mount Jackson, Strasburg, Front Royal, and Swift Run Gap"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: FRONT ROYAL & WINCHESTER (Part the First)"}],["$","span",null,{"className":"result-label","children":"Operational prelude; no battle is fought in this episode. Shields left the Shenandoah Valley to reinforce Irvin McDowell, reducing Nathaniel Banks to a divided command at Strasburg and Front Royal. After conflicting orders nearly pulled Richard Ewell east toward Richmond, Ewell and Jackson agreed on May 18 to concentrate against Banks. Both Confederate commands marched on May 19 and were united in the Luray Valley by May 22, setting up the Battle of Front Royal on May 23"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"May 11–22, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Shenandoah Valley and Luray Valley, Virginia: Franklin and Staunton to Mount Solon, Harrisonburg, New Market, Mount Jackson, Strasburg, Front Royal, and Swift Run Gap"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Operational prelude; no battle is fought in this episode. Shields left the Shenandoah Valley to reinforce Irvin McDowell, reducing Nathaniel Banks to a divided command at Strasburg and Front Royal. After conflicting orders nearly pulled Richard Ewell east toward Richmond, Ewell and Jackson agreed on May 18 to concentrate against Banks. Both Confederate commands marched on May 19 and were united in the Luray Valley by May 22, setting up the Battle of Front Royal on May 23"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"May 11–22, 1862","place":"Shenandoah Valley and Luray Valley, Virginia: Franklin and Staunton to Mount Solon, Harrisonburg, New Market, Mount Jackson, Strasburg, Front Royal, and Swift Run Gap","result":"Operational prelude; no battle is fought in this episode. Shields left the Shenandoah Valley to reinforce Irvin McDowell, reducing Nathaniel Banks to a divided command at Strasburg and Front Royal. After conflicting orders nearly pulled Richard Ewell east toward Richmond, Ewell and Jackson agreed on May 18 to concentrate against Banks. Both Confederate commands marched on May 19 and were united in the Luray Valley by May 22, setting up the Battle of Front Royal on May 23","facts":[{"label":"Episode scope","value":"From the aftermath of McDowell through the Confederate concentration on May 22","note":"The fighting at Front Royal on May 23 and Winchester on May 25 belongs to the following installments. This guide does not count casualties from those battles."},{"label":"Operational result","value":"Jackson and Ewell united against an isolated Banks","note":"The concentration began a ten-day sequence of marches and battles that carried Jackson’s command toward the Potomac."},{"label":"Jackson after McDowell","value":"Back at the western edge of the Shenandoah Valley by May 17","note":"After pursuing Frémont toward Franklin, Jackson retraced his route and incorporated six regiments from Edward “Allegheny” Johnson’s command into the Valley force."},{"label":"Shields detached","value":"Ordered east to reinforce Irvin McDowell near Fredericksburg","note":"The episode says Shields’s division left the Valley on May 15. Movement occurred in stages, and authoritative summaries use dates between May 12 and May 15 for the departure."},{"label":"Banks’s field force","value":"About 4,500 infantry under Alpheus Williams plus about 1,500 cavalry","note":"These are the episode’s figures after Shields departed. Strength totals vary by date and by whether detachments, artillery, and troops at Front Royal and Buckton Station are counted separately."},{"label":"Williams’s division","value":"Two brigades and eight infantry regiments","note":"The episode identifies regiments from Maryland, New York, Connecticut, Pennsylvania, Massachusetts, Wisconsin, and Indiana. A third brigade had been transferred to McDowell at the end of March."},{"label":"Combat experience","value":"Long-serving but essentially untested in a pitched battle","note":"The hosts say the troops had drilled, marched, and skirmished, but that no company had yet fired in a battle. This is the episode’s characterization of Banks’s remaining command."},{"label":"Banks’s problem","value":"Defend Strasburg and Front Royal at the same time","note":"Banks warned Washington on May 22 that both points were accessible to the enemy. Most of his force remained near Strasburg."},{"label":"Distance between posts","value":"About 12 miles from Strasburg to Front Royal","note":"The Manassas Gap Railroad and a country road connected the two positions, but Massanutten Mountain divided the larger operational area."},{"label":"Front Royal garrison","value":"About 900 infantry and two guns, with no cavalry","note":"This is the episode’s May 22 estimate. National Park Service accounts generally round the garrison to roughly 1,000–1,100 men."},{"label":"Strasburg’s importance","value":"Valley Turnpike, railroad connection, and route north to Winchester","note":"The improved turnpike connected Staunton, Harrisonburg, New Market, Strasburg, and Winchester and remained usable when ordinary roads became muddy."},{"label":"Front Royal’s importance","value":"Northern entrance to the Luray Valley and a link toward eastern Virginia","note":"A Confederate advance there could threaten Banks’s railroad communication and place troops between Banks and McDowell."},{"label":"Massanutten Mountain","value":"A long barrier separating the main Shenandoah Valley from the Luray Valley","note":"For a large military column, New Market Gap was the practical crossing in this sector. That geography made Jackson’s location and route difficult for Banks to read."},{"label":"Banks’s correct judgment","value":"Jackson intended to attack","note":"By May 22 Banks no longer shared his April confidence. He warned the War Department that an offensive was likely and sought reinforcements."},{"label":"Banks’s intelligence error","value":"He expected Jackson west of Massanutten and placed Ewell near Swift Run Gap","note":"On May 22 the Confederate forces were already much closer together in the Luray Valley than Banks believed."},{"label":"Stanton’s response","value":"No immediate reinforcement","note":"The episode reports that Secretary of War Edwin Stanton dismissed the danger Jackson posed even after Banks sent an aide to Washington."},{"label":"Ewell’s assignment","value":"Watch Banks from Swift Run Gap and discourage a Federal withdrawal","note":"Jackson’s repeated instructions gave Ewell little information about the Valley force’s location or full design."},{"label":"Conflicting Confederate authority","value":"Jackson, Joseph E. Johnston, and Robert E. Lee sent overlapping guidance","note":"Ewell’s division belonged to Johnston’s army but operated inside Jackson’s Valley District. Lee, as Jefferson Davis’s military adviser, shaped strategy without holding direct field command."},{"label":"Ewell’s dilemma","value":"Remain with Jackson or follow Johnston’s conditional order east","note":"Ewell understood Johnston’s instructions to require a move toward Richmond if Banks joined McDowell. Reports that Shields was already moving east made the order especially difficult to interpret."},{"label":"May 18 meeting","value":"Jackson and Ewell conferred at Mount Solon","note":"Ewell rode roughly 30 miles through the night and met Jackson at daybreak in a mill. They agreed that attacking Banks offered the best immediate opportunity."},{"label":"Written command decision","value":"Ewell remained part of Jackson’s command while inside the Valley District","note":"Jackson’s surviving May 18 letter directed Ewell to camp between New Market and Mount Jackson on May 21 unless a superior issued a later order."},{"label":"Letter-arrangement uncertainty","value":"The official text survives; the private staging does not","note":"The episode says the generals constructed and falsely addressed their May 18 exchange to protect Ewell from a charge of disobedience. The Official Records confirm the letter’s wording and date but do not independently establish every detail of that private arrangement."},{"label":"Original May 18 plan","value":"Concentrate near New Market, then move north on the Valley Turnpike against Strasburg","note":"This was the plan described at the end of the episode. The later decision to turn through New Market Gap and strike Front Royal is outside the narrated scope."},{"label":"Transcript normalizations","value":"Ewell, Staunton, Strasburg, Massanutten, Luray, and Irvin McDowell","note":"The automated transcript repeatedly renders these as “Yule,” “Stanton,” “Strasbourg,” “Massa Nutton,” “LeRae,” and “Urban McDowell.” Names and places are normalized here."},{"label":"Leader losses","value":"None within this episode’s pre-battle scope","note":"No important leader is killed or mortally wounded during the events narrated in this installment."},{"label":"Book recommendation","value":"“Stonewall Jackson’s 1862 Valley Campaign: War Comes to the Homefront” by Jonathan A. Noyalas"}],"maps":[{"title":"May 22: separated Federal forces and concentrated Confederates","caption":"Banks held Strasburg and Front Royal while Shields moved east toward McDowell, Frémont remained beyond the Alleghenies, and Jackson and Ewell concentrated in the Luray Valley. Banks expected the principal Confederate approach west of Massanutten and believed Ewell was still near Swift Run Gap. This strategic map is schematic: positions, distances, road traces, and force footprints are approximate.","source":"https://history.army.mil/Portals/143/Images/Publications/ArmyHistoryMag/pdf/19901999/AH47newOCR.pdf","image":"/images/ep147-valley-geography-may22.svg","alt":"Schematic strategic map of May 22, 1862, showing Banks at Strasburg and Front Royal, Jackson and Ewell concentrated in the Luray Valley, Shields moving toward Fredericksburg, and Frémont west of the Shenandoah Valley."},{"title":"May 18 plan: concentrate, then strike Banks at Strasburg","caption":"Jackson planned to march north from Mount Solon while Ewell left Swift Run Gap and moved toward the New Market–Mount Jackson area. Once united, they would continue north on the Valley Turnpike against Banks at Strasburg. This is a schematic operational plan, not a battle map, and it depicts the intention described in this episode rather than the route ultimately used against Front Royal.","source":"https://ehistory.osu.edu/books/official-records/018/0897","image":"/images/ep147-may18-strasburg-plan.svg","alt":"Schematic operational map of Jackson and Ewell concentrating between New Market and Mount Jackson and planning to advance north against Banks at Strasburg."},{"title":"Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley","caption":"Hotchkiss’s manuscript map records the Valley’s roads, rivers, gaps, ridges, settlements, and landowners from Winchester to Staunton. It is a primary cartographic source and shows the geography that shaped the operation, but it is not a dated troop-position or battle-phase map.","source":"https://www.loc.gov/item/99446754/","image":"/images/ep147-hotchkiss-shenandoah-map.jpg","alt":"Jedediah Hotchkiss’s large 1862 manuscript map of the Shenandoah Valley from Winchester to Staunton."}],"moments":[{"time":"1:10","audioTime":70,"title":"The Valley Campaign resumes","detail":"The hosts return to the spring 1862 crisis, when McClellan’s army was approaching Richmond and Confederate leaders wanted Jackson to keep United States troops occupied in the Shenandoah Valley."},{"time":"1:42","audioTime":102,"title":"Jackson’s strategic purpose is restated","detail":"His operations were intended to prevent the Federal forces opposite him from reinforcing the advance on Richmond."},{"time":"2:05","audioTime":125,"title":"Kernstown’s mixed result","detail":"The March 23 battle was a tactical defeat, but the alarm it created altered Federal deployments and kept additional troops away from McClellan."},{"time":"2:32","audioTime":152,"title":"Ewell enters the Valley equation","detail":"Robert E. Lee arranged for Richard S. Ewell’s approximately 8,500-man division east of the Blue Ridge to support Jackson."},{"time":"3:05","audioTime":185,"title":"Ewell replaces Jackson near Swift Run Gap","detail":"Ewell moved into the Elk Run Valley position near Conrad’s Store to watch Banks while Jackson went to Staunton and joined Edward Johnson."},{"time":"3:34","audioTime":214,"title":"Jackson attacks the western threat first","detail":"Jackson combined with Johnson to prevent Banks and Frémont from joining. Their operation produced the Battle of McDowell on May 8."},{"time":"4:18","audioTime":258,"title":"McDowell becomes a strategic success","detail":"Although Jackson suffered the heavier tactical loss, the battle and pursuit pushed Frémont away from the Valley and removed the immediate western threat."},{"time":"4:34","audioTime":274,"title":"Jackson returns from the mountains","detail":"By May 17 the Valley force was back near the western edge of the Shenandoah. Six regiments from Edward Johnson’s force were absorbed into Jackson’s command."},{"time":"5:07","audioTime":307,"title":"Banks’s April confidence is recalled","detail":"Banks had told Washington on April 30 that the Valley mission was finished because he believed Jackson had left or was leaving for Richmond."},{"time":"5:47","audioTime":347,"title":"Washington redistributes Banks’s army","detail":"Lincoln and Stanton directed James Shields’s division east to reinforce Irvin McDowell for the planned movement from Fredericksburg toward Richmond."},{"time":"6:24","audioTime":384,"title":"Shields leaves the Valley","detail":"The episode dates the division’s departure to May 15. Banks retained Williams’s roughly 4,500-man division and about 1,500 cavalry."},{"time":"6:38","audioTime":398,"title":"Banks’s remaining infantry lacks battle experience","detail":"The men had served for months and had drilled, marched, and skirmished, but the episode describes the command as untested in a pitched battle."},{"time":"6:58","audioTime":418,"title":"Banks expects an attack by May 22","detail":"Now at Strasburg and aware that Jackson had returned from McDowell, Banks warned Washington that Jackson probably intended to strike him."},{"time":"7:51","audioTime":471,"title":"Williams’s reduced division is described","detail":"The division had two brigades and eight infantry regiments after its third brigade was sent east at the end of March."},{"time":"8:18","audioTime":498,"title":"Banks must defend two points","detail":"His May 22 message identified Strasburg and Front Royal as positions that were both exposed to Confederate attack."},{"time":"8:27","audioTime":507,"title":"Strasburg and Front Royal are linked","detail":"The villages lay about 12 miles apart and were connected by the Manassas Gap Railroad and a country road."},{"time":"8:51","audioTime":531,"title":"Massanutten divides the theater","detail":"The long mountain separated the main Shenandoah Valley on the west from the narrower Luray Valley on the east, with New Market Gap providing the practical military crossing."},{"time":"9:34","audioTime":574,"title":"Roads make both posts important","detail":"The Valley Turnpike ran through Strasburg, while another improved north–south route served Front Royal and the Luray Valley."},{"time":"10:20","audioTime":620,"title":"The Valley Turnpike forms Banks’s main corridor","detail":"The road connected Staunton, Harrisonburg, New Market, Strasburg, and Winchester and supported rapid movement through the main Valley."},{"time":"10:46","audioTime":646,"title":"Front Royal receives a small garrison","detail":"Banks placed about 900 infantry and two guns at Front Royal but no cavalry, while keeping most of his available force near Strasburg."},{"time":"11:04","audioTime":664,"title":"Banks asks Washington for help","detail":"He tried to create urgency with his May 22 dispatch and sent his adjutant to make the case for reinforcements in person."},{"time":"11:18","audioTime":678,"title":"Stanton discounts the danger","detail":"The Secretary of War rejected the urgency of Banks’s request and did not consider Jackson a serious immediate threat."},{"time":"11:45","audioTime":705,"title":"Banks misreads the Confederate locations","detail":"He expected Jackson to move north on the Valley Turnpike and believed Ewell remained nearly 60 miles from Front Royal at Swift Run Gap."},{"time":"12:02","audioTime":722,"title":"Jackson and Ewell are already much closer","detail":"By May 22 the two Confederate commands had united in the Luray Valley, inside the geography Banks thought separated them."},{"time":"13:21","audioTime":801,"title":"The narrative returns to Ewell","detail":"Ewell had occupied Jackson’s old camps near Swift Run Gap since the end of April and was frustrated by Jackson’s secrecy and repeated orders to remain in place."},{"time":"14:12","audioTime":852,"title":"Jackson leaves Ewell without the full plan","detail":"Ewell understood that he must watch Banks and discourage a Federal departure, but he did not know whom Jackson had gone to attack."},{"time":"14:49","audioTime":889,"title":"Ewell questions Jackson’s judgment","detail":"In an exchange with Colonel James A. Walker, Ewell vented his fear that an unexplained order to remain might expose the division to destruction."},{"time":"15:03","audioTime":903,"title":"Walker’s history with Jackson is recalled","detail":"The hosts note that Walker had been dismissed from Virginia Military Institute after a dispute with Professor Thomas J. Jackson and a challenge to duel."},{"time":"16:03","audioTime":963,"title":"Munford brings news of Shields","detail":"On the night of May 11, cavalry officer Thomas Munford told Ewell that Shields’s division was leaving the Valley to reinforce McDowell."},{"time":"16:23","audioTime":983,"title":"Ewell studies the map in frustration","detail":"Munford later described Ewell springing from bed and kneeling over a map as he tried to determine Jackson’s location and the opportunity presented by Shields’s movement."},{"time":"17:36","audioTime":1056,"title":"Ewell records two miserable weeks","detail":"In a May 13 letter to a niece, Ewell described headaches, indigestion, and deep frustration with the confused direction he was receiving."},{"time":"18:09","audioTime":1089,"title":"Twenty-seven messages deepen the confusion","detail":"By May 16, according to the episode, Ewell had received 27 messages from Jackson, Lee, and Johnston rather than a single coherent set of instructions."},{"time":"18:20","audioTime":1100,"title":"Jackson orders Ewell to follow Banks","detail":"Jackson’s May 13 direction required Ewell to pursue if Banks withdrew down the Valley toward Strasburg and the railroad."},{"time":"18:38","audioTime":1118,"title":"Johnston’s order points east","detail":"Ewell also understood Johnston to require his division to leave the Valley and reinforce Richmond if Banks moved east to join McDowell."},{"time":"19:14","audioTime":1154,"title":"Ewell rides to Mount Solon","detail":"Unable to resolve the contradiction by message, Ewell rode about 30 miles through the night to Jackson’s headquarters."},{"time":"19:29","audioTime":1169,"title":"The generals meet on May 18","detail":"At daybreak they conferred in a mill and agreed that the divided Federal forces created an opportunity to attack Banks."},{"time":"20:04","audioTime":1204,"title":"Ewell says Johnston’s order still binds him","detail":"Despite sharing Jackson’s objective, Ewell initially concluded that he had to follow Shields east and leave the Valley."},{"time":"20:24","audioTime":1224,"title":"Lee’s May 16 message supports an attack","detail":"Lee urged action that would prevent Banks from reinforcing either McDowell or McClellan and advised Jackson to move quickly if he attacked."},{"time":"21:35","audioTime":1295,"title":"Jackson has appealed to Johnston","detail":"Jackson had written the previous evening for revised orders, but a reply might take three days because Johnston used couriers rather than the telegraph."},{"time":"21:53","audioTime":1313,"title":"Ewell agrees to remain temporarily","detail":"He would stay and fight under Jackson until Johnston answered, provided Jackson accepted responsibility for the decision."},{"time":"22:05","audioTime":1325,"title":"The command decision is put in writing","detail":"The episode says the generals constructed an exchange designed to document Ewell’s dilemma and protect him from later charges of disobedience."},{"time":"22:36","audioTime":1356,"title":"Jackson’s May 18 order is read","detail":"Jackson stated that Ewell belonged to his command while in the Valley District and directed him to camp between New Market and Mount Jackson on May 21 unless later superior orders intervened."},{"time":"23:38","audioTime":1418,"title":"Jackson outlines the Strasburg plan","detail":"The two commands would concentrate between New Market and Mount Jackson, then move north on the Valley Turnpike and attack Banks at Strasburg."},{"time":"24:33","audioTime":1473,"title":"Both Confederate commands begin marching","detail":"Jackson put the Valley force on the road at 5 a.m. on May 19, while Ewell’s division left Swift Run Gap at daybreak."},{"time":"24:44","audioTime":1484,"title":"The episode stops before the fighting","detail":"The concentration began the ten days of movement and combat that would carry Jackson toward the Potomac. No leader death or mortal wound occurs within this installment."}],"command":[{"side":"United States","color":"#315f8c","branches":[{"commander":"President Abraham Lincoln / Secretary Edwin M. Stanton","command":"National strategic direction","subordinates":"Directed Shields east toward McDowell while retaining Banks in the Valley; Stanton rejected Banks’s May 22 appeal for immediate reinforcement"},{"commander":"Maj. Gen. Irvin McDowell","command":"Department of the Rappahannock","subordinates":"Concentrating near Fredericksburg for a projected advance toward Richmond and designated to receive Shields’s division"},{"commander":"Maj. Gen. Nathaniel P. Banks","command":"Department of the Shenandoah","subordinates":"Held the Strasburg–Front Royal line with a reduced force and warned Washington that Jackson intended to attack"},{"commander":"Brig. Gen. Alpheus S. Williams","command":"Infantry division under Banks","subordinates":"Two brigades and eight infantry regiments, approximately 4,500 men in the episode’s accounting"},{"commander":"Brig. Gen. James Shields","command":"Detached division formerly under Banks","subordinates":"Moving east from the Valley to reinforce McDowell near Fredericksburg"},{"commander":"Maj. Gen. John C. Frémont","command":"Mountain Department","subordinates":"Remained beyond the Alleghenies after Jackson’s McDowell operation, separated from Banks"}]},{"side":"Confederacy","color":"#9a3d32","branches":[{"commander":"Gen. Joseph E. Johnston","command":"Senior field command defending Richmond","subordinates":"Ewell’s division belonged to Johnston’s army; his conditional instructions conflicted with Jackson’s immediate Valley plan"},{"commander":"Gen. Robert E. Lee","command":"Military adviser to President Jefferson Davis","subordinates":"Encouraged quick action against Banks to keep Federal troops from joining McDowell or McClellan, but did not yet command a field army"},{"commander":"Maj. Gen. Thomas J. “Stonewall” Jackson","command":"Valley District and Valley force","subordinates":"Returned from the McDowell operation, incorporated Edward Johnson’s regiments, retained Ewell in the Valley, and planned the concentration against Banks"},{"commander":"Maj. Gen. Richard S. Ewell","command":"Third Division, Army of the Peninsula","subordinates":"About 8,500 men in the episode; watched Banks from Swift Run Gap before agreeing on May 18 to operate under Jackson"},{"commander":"Brig. Gen. Richard Taylor","command":"Louisiana Brigade in Ewell’s division","subordinates":"One of Ewell’s brigadiers; his later recollection supplies the episode’s description of Ewell’s habits and nervous energy"},{"commander":"Col. Turner Ashby","command":"7th Virginia Cavalry and attached mounted forces","subordinates":"Jackson’s cavalry chief; the episode mentions his role in the campaign but does not narrate the May 23 cavalry operation"},{"commander":"Capt. Thomas T. Munford","command":"Cavalry officer serving Ewell","subordinates":"Brought Ewell intelligence that Shields was leaving the Valley and later recorded the headquarters scene around the map"},{"commander":"Col. James A. Walker","command":"13th Virginia Infantry in Ewell’s division","subordinates":"Regimental commander with whom Ewell vented his frustration over Jackson’s secrecy"}]}],"people":[{"name":"Thomas J. “Stonewall” Jackson","role":"Valley District commander who returned from the McDowell operation, retained Ewell in the Valley, and planned the concentration against Banks","side":"Confederacy","image":"/images/ep147-stonewall-jackson.jpg","source":"https://www.loc.gov/item/2018670324/"},{"name":"Richard S. Ewell","role":"Division commander caught between Jackson’s and Johnston’s instructions; he rode to Mount Solon, accepted Jackson’s authority, and marched from Swift Run Gap","side":"Confederacy","image":"/images/ep147-richard-ewell.jpg","source":"https://www.loc.gov/pictures/item/2018670286/"},{"name":"Nathaniel P. Banks","role":"Department commander whose reduced force had to defend Strasburg and Front Royal; he anticipated an attack but misread the Confederate locations","side":"United States","image":"/images/ep147-nathaniel-banks.jpg","source":"https://www.loc.gov/pictures/item/98506703/"},{"name":"Alpheus S. Williams","role":"Commander of Banks’s remaining infantry division, reduced to two brigades after Federal troops were transferred east","side":"United States"},{"name":"James Shields","role":"Division commander ordered out of the Shenandoah Valley to reinforce Irvin McDowell near Fredericksburg","side":"United States"},{"name":"Irvin McDowell","role":"Department commander assembling troops near Fredericksburg for the planned advance toward Richmond","side":"United States"},{"name":"Edwin M. Stanton","role":"Secretary of War who helped direct Federal troop movements and rejected the urgency of Banks’s May 22 request for reinforcement","side":"United States"},{"name":"Abraham Lincoln","role":"President overseeing the departments around Washington and the redistribution of Shields’s division toward McDowell","side":"United States"},{"name":"John C. Frémont","role":"Mountain Department commander whose force remained beyond the Alleghenies after McDowell and was separated from Banks","side":"United States"},{"name":"Joseph E. Johnston","role":"Senior Confederate field commander whose conditional instructions to Ewell conflicted with Jackson’s plan to attack Banks","side":"Confederacy"},{"name":"Robert E. Lee","role":"Military adviser who urged quick action against Banks to prevent Federal reinforcement of McDowell or McClellan","side":"Confederacy"},{"name":"Edward “Allegheny” Johnson","role":"Commander whose six regiments were incorporated into Jackson’s Valley force after the McDowell operation","side":"Confederacy"},{"name":"Richard Taylor","role":"Louisiana brigade commander in Ewell’s division whose recollection describes Ewell’s habits and nervous energy","side":"Confederacy"},{"name":"Thomas T. Munford","role":"Cavalry officer who brought Ewell news of Shields’s departure and later described Ewell studying the map in frustration","side":"Confederacy"},{"name":"James A. Walker","role":"13th Virginia Infantry commander and former VMI cadet who tried to reassure Ewell about Jackson’s judgment","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/ep147-hotchkiss-shenandoah-map.jpg","alt":"Jedediah Hotchkiss’s large 1862 manuscript map of the Shenandoah Valley.","caption":"Hotchkiss’s primary-source map shows the roads, gaps, rivers, ridges, and settlements that made divided command at Strasburg and Front Royal so difficult.","source":"https://www.loc.gov/item/99446754/"},{"image":"/images/ep147-stonewall-jackson.jpg","alt":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform.","caption":"Jackson returned from the western mountains and used his authority inside the Valley District to keep Ewell’s division in the operation against Banks.","source":"https://www.loc.gov/item/2018670324/"},{"image":"/images/ep147-richard-ewell.jpg","alt":"Wartime photographic portrait of Confederate general Richard S. Ewell in uniform.","caption":"Ewell endured conflicting directions from Jackson, Johnston, and Lee before the May 18 meeting resolved his immediate command relationship.","source":"https://www.loc.gov/pictures/item/2018670286/"},{"image":"/images/ep147-nathaniel-banks.jpg","alt":"Civil War-era photographic portrait of United States general Nathaniel P. Banks in uniform.","caption":"Banks correctly feared an attack by May 22 but expected Jackson west of Massanutten and believed Ewell remained near Swift Run Gap.","source":"https://www.loc.gov/pictures/item/98506703/"},{"image":"/images/ep147-valley-geography-may22.svg","alt":"Schematic map of Federal and Confederate positions around the Shenandoah and Luray Valleys on May 22, 1862.","caption":"The strategic schematic shows why Banks had a two-post problem while Jackson and Ewell could concentrate against the separated Federal forces.","source":"https://history.army.mil/Portals/143/Images/Publications/ArmyHistoryMag/pdf/19901999/AH47newOCR.pdf"},{"image":"/images/ep147-may18-strasburg-plan.svg","alt":"Schematic map of Jackson and Ewell’s May 18 plan to concentrate and advance on Strasburg.","caption":"The plan described at the end of this episode called for concentration near New Market and Mount Jackson followed by a northward movement against Strasburg; it was later revised.","source":"https://ehistory.osu.edu/books/official-records/018/0897"}],"sources":[{"label":"Official Civil War Podcast episode 147 page","url":"https://civilwarpodcast.org/2016/03/27/civil-war-podcast-episode-147/"},{"label":"National Park Service: Battle of Front Royal","url":"https://www.nps.gov/articles/000/battle-of-front-royal.htm"},{"label":"National Park Service: Jackson’s 1862 Shenandoah Valley Campaign","url":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm"},{"label":"U.S. Army Center of Military History: “Action and Reaction: The Spring 1862 Shenandoah Valley Campaign Revisited,” Robert S. Rush","url":"https://history.army.mil/Portals/143/Images/Publications/ArmyHistoryMag/pdf/19901999/AH47newOCR.pdf"},{"label":"U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862","url":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf"},{"label":"Primary source collection: Official Records, Series I, Volume XII, Part III","url":"https://ehistory.osu.edu/books/official-records/018"},{"label":"Primary correspondence: Jackson to Ewell, May 18, 1862, Official Records page 897","url":"https://ehistory.osu.edu/books/official-records/018/0897"},{"label":"Library of Congress: Jedediah Hotchkiss, 1862 map of the Shenandoah Valley","url":"https://www.loc.gov/item/99446754/"},{"label":"Library of Congress: Thomas J. “Stonewall” Jackson portrait","url":"https://www.loc.gov/item/2018670324/"},{"label":"Library of Congress: Richard S. Ewell portrait","url":"https://www.loc.gov/pictures/item/2018670286/"},{"label":"Library of Congress: Nathaniel P. Banks portrait","url":"https://www.loc.gov/pictures/item/98506703/"},{"label":"Official podcast book-recommendations list","url":"https://civilwarpodcast.org/book-recommendations/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
