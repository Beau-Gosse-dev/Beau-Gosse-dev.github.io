1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",123," · ","April 6, 1862, about 5 p.m. through the night of April 6–7"," · ","Grant’s final line above Pittsburg Landing, Dill Branch, the Tennessee River, and the captured United States camps at Shiloh, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Thirteenth)"}],["$","span",null,{"className":"result-label","children":"Chalmers’s and Jackson’s brigades attacked the United States left at about 6 p.m. Artillery on Grant’s ridge, supporting infantry, the gunboats Tyler and Lexington, and the flooded Dill Branch stopped the two-brigade attack. Other Confederate commanders were assembling a larger assault when P.G.T. Beauregard ordered the army to break contact near sundown and return to the captured camps. Beauregard incorrectly believed Grant’s army could be finished the next morning and that Buell remained distant. The 36th Indiana had already crossed at Pittsburg Landing, more Army of the Ohio troops arrived during the night, and Lew Wallace’s division approached from the north. Confederate units remained dispersed and poorly reorganized. Grant rejected retreat and ordered an attack at daylight"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6316031095.mp3?updated=1695211662","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Final attack began",{"children":[["$","span",null,{"children":"Final attack began"}],["$","strong",null,{"children":"About 6 p.m., roughly 20 minutes before sunset"}],"$undefined"]}],["$","div","Confederate attacking force",{"children":[["$","span",null,{"children":"Confederate attacking force"}],["$","strong",null,{"children":"Chalmers’s and Jackson’s brigades without a coordinated supporting assault"}],"$undefined"]}],["$","div","First Buell regiment",{"children":[["$","span",null,{"children":"First Buell regiment"}],["$","strong",null,{"children":"36th Indiana, ferried across after reaching the east bank about 5 p.m."}],"$undefined"]}],["$","div","Men below the bluff",{"children":[["$","span",null,{"children":"Men below the bluff"}],["$","strong",null,{"children":"Podcast estimate: 10,000 to 15,000 stragglers and disorganized soldiers"}],"$undefined"]}],["$","div","Attack stopped",{"children":[["$","span",null,{"children":"Attack stopped"}],["$","strong",null,{"children":"Artillery, infantry, naval fire, and difficult ground at Dill Branch"}],"$undefined"]}],["$","div","Beauregard’s order",{"children":[["$","span",null,{"children":"Beauregard’s order"}],["$","strong",null,{"children":"Break contact near sundown and bivouac in the captured camps"}],"$undefined"]}],["$","div","Night gunboat fire",{"children":[["$","span",null,{"children":"Night gunboat fire"}],["$","strong",null,{"children":"One shell from each gunboat about every 15 minutes"}],"$undefined"]}],["$","div","Grant’s decision",{"children":[["$","span",null,{"children":"Grant’s decision"}],["$","strong",null,{"children":"Remain west of the Tennessee River and counterattack at daylight"}],"$undefined"]}]]}],"$Le","$Lf","$L10","$L11",false,"$L12","$L13","$L14"]}]]}]
