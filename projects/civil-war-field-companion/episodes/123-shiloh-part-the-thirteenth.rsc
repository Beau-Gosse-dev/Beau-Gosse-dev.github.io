d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",123," · ","April 6, 1862, about 5 p.m. through the night of April 6–7"," · ","Grant’s final line above Pittsburg Landing, Dill Branch, the Tennessee River, and the captured United States camps at Shiloh, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Thirteenth)"}],["$","span",null,{"className":"result-label","children":"Chalmers’s and Jackson’s brigades attacked the United States left at about 6 p.m. Artillery on Grant’s ridge, supporting infantry, the gunboats Tyler and Lexington, and the flooded Dill Branch stopped the two-brigade attack. Other Confederate commanders were assembling a larger assault when P.G.T. Beauregard ordered the army to break contact near sundown and return to the captured camps. Beauregard incorrectly believed Grant’s army could be finished the next morning and that Buell remained distant. The 36th Indiana had already crossed at Pittsburg Landing, more Army of the Ohio troops arrived during the night, and Lew Wallace’s division approached from the north. Confederate units remained dispersed and poorly reorganized. Grant rejected retreat and ordered an attack at daylight"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 6, 1862, about 5 p.m. through the night of April 6–7"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Grant’s final line above Pittsburg Landing, Dill Branch, the Tennessee River, and the captured United States camps at Shiloh, Tennessee"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Chalmers’s and Jackson’s brigades attacked the United States left at about 6 p.m. Artillery on Grant’s ridge, supporting infantry, the gunboats Tyler and Lexington, and the flooded Dill Branch stopped the two-brigade attack. Other Confederate commanders were assembling a larger assault when P.G.T. Beauregard ordered the army to break contact near sundown and return to the captured camps. Beauregard incorrectly believed Grant’s army could be finished the next morning and that Buell remained distant. The 36th Indiana had already crossed at Pittsburg Landing, more Army of the Ohio troops arrived during the night, and Lew Wallace’s division approached from the north. Confederate units remained dispersed and poorly reorganized. Grant rejected retreat and ordered an attack at daylight"}]]}]]}],false,"$Lf","$undefined"]}],"$L10","$L11","$L12",false,"$L13",false,"$L14","$L15","$L16","$L17"]}]]}]
