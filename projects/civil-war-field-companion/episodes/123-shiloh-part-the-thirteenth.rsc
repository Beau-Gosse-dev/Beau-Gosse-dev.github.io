:"/projects/civil-war-field-companion/images/shiloh-nightfall-reinforcements.svg","alt":"Map of the final attack, the overnight positions, and United States reinforcement routes","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Nightfall and incoming reinforcements"}],["$","span",null,{"children":"Chalmers and Jackson attacked across Dill Branch as Nelson’s lead regiment crossed the river. Beauregard then stopped the Confederate advance; Lew Wallace and additional Army of the Ohio troops arrived after dark."}],["$","span",null,{"className":"map-actions","children":["$L15","$L16"]}],"$undefined"]}]]}],"$L17","$L18"]}]]}]
10:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Chalmers and Jackson began the final attack",{"className":"moment","children":[["$","$L19",null,{"seconds":39,"label":"0:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Chalmers and Jackson began the final attack"}],["$","p",null,{"children":"At about 6 p.m., the two brigades advanced toward the United States left with sunset about twenty minutes away."}]]}]]}],["$","div","Grant’s line opened fire",{"className":"moment","children":[["$","$L19",null,{"seconds":67,"label":"1:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant’s line opened fire"}],["$","p",null,{"children":"Webster’s artillery, supporting infantry, and the two timberclads fired into the Confederate advance."}]]}]]}],["$","div","Buell’s first regiment arrived",{"className":"moment","children":[["$","$L19",null,{"seconds":148,"label":"2:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell’s first regiment arrived"}],["$","p",null,{"children":"Colonel Jacob Ammen’s 36th Indiana crossed the Tennessee River with division commander William Nelson after reaching the east bank at about 5 p.m."}]]}]]}],["$","div","The regiment pushed through the landing area",{"className":"moment","children":[["$","$L19",null,{"seconds":193,"label":"3:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"The regiment pushed through the landing area"}],["$","p",null,{"children":"Thousands of disorganized soldiers crowded below the bluff. Nelson cleared space so the regiment could land and move uphill."}]]}]]}],["$","div","Lew Wallace heard the final-line guns",{"className":"moment","children":[["$","$L19",null,{"seconds":414,"label":"6:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lew Wallace heard the final-line guns"}],["$","p",null,{"children":"His 3rd Division was about half an hour away when officers recognized the siege guns and timberclads firing near Pittsburg Landing."}]]}]]}],["$","div","The two-brigade attack failed",{"className":"moment","children":[["$","$L19",null,{"seconds":459,"label":"7:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The two-brigade attack failed"}],["$","p",null,{"children":"Chalmers and Jackson crossed the most difficult ground on the front and received concentrated fire without enough support. Both brigades withdrew."}]]}]]}],["$","div","Other Confederate commanders prepared a larger attack",{"className":"moment","children":[["$","$L19",null,{"seconds":499,"label":"8:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Other Confederate commanders prepared a larger attack"}],["$","p",null,{"children":"Bragg, Polk, and Withers were moving additional troops forward when units began receiving an order to stop."}]]}]]}],["$","div","Beauregard ordered the army to break contact",{"className":"moment","children":[["$","$L19",null,{"seconds":602,"label":"10:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Beauregard ordered the army to break contact"}],["$","p",null,{"children":"Near sundown, he directed units to withdraw to a line near the captured United States camps."}]]}]]}],["$","div","The order rested on incorrect information",{"className":"moment","children":[["$","$L19",null,{"seconds":630,"label":"10:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"The order rested on incorrect information"}],["$","p",null,{"children":"Beauregard believed Grant was defeated, Buell was still a day or two away, and gunboat fire was causing more damage than it actually was."}]]}]]}],["$","div","A successful additional assault was uncertain",{"className":"moment","children":[["$","$L19",null,{"seconds":783,"label":"13:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"A successful additional assault was uncertain"}],["$","p",null,{"children":"The podcast concludes that darkness, Confederate exhaustion and disorganization, and the strength of Grant’s position made a breakthrough unlikely."}]]}]]}],["$","div","Cold rain began after the fighting stopped",{"className":"moment","children":["$L1a","$L1b"]}],"$L1c","$L1d","$L1e","$L1f","$L20"]}]]}]
11:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Tennessee"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Held the final ridge and ordered a counterattack for daylight"}]]}],["$","div","Chief of staff and artillery coordinator",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief of staff and artillery coordinator"}],["$","span",null,{"children":"Joseph D. Webster"}],["$","small",null,{"children":"Directed the massed guns that stopped the final Confederate advance"}]]}],["$","div","Army of the Ohio",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Ohio"}],["$","span",null,{"children":"Don Carlos Buell"}],["$","small",null,{"children":"Reinforcements arriving from the east bank of the Tennessee River"}]]}],["$","div","4th Division / 10th Brigade, Army of the Ohio",{"className":"command-entry","children":[["$","strong",null,{"children":"4th Division / 10th Brigade, Army of the Ohio"}],["$","span",null,{"children":"William Nelson / Jacob Ammen"}],["$","small",null,{"children":"36th Indiana was the first regiment ferried to the battlefield"}]]}],["$","div","3rd Division, Army of the Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division, Army of the Tennessee"}],["$","span",null,{"children":"Lew Wallace"}],["$","small",null,{"children":"Approached the United States right from Crump’s Landing after dark"}]]}],["$","div","USS Tyler / USS Lexington",{"className":"command-entry","children":[["$","strong",null,{"children":"USS Tyler / USS Lexington"}],["$","span",null,{"children":"William Gwin / James W. Shirk"}],["$","small",null,{"children":"Fired on the final attack and shelled Confederate positions through the night"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of the Mississippi",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Mississippi"}],["$","span",null,{"children":"P.G.T. Beauregard"}],["$","small",null,{"children":"Ordered the attack stopped and attempted an overnight reorganization"}]]}],["$","div","Late-afternoon field direction",{"className":"command-entry","children":[["$","strong",null,{"children":"Late-afternoon field direction"}],["$","span",null,{"children":"Braxton Bragg / Leonidas Polk / Jones M. Withers"}],["$","small",null,{"children":"Were assembling additional troops when Beauregard’s halt order arrived"}]]}],["$","div","Brigades on the Confederate right",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigades on the Confederate right"}],["$","span",null,{"children":"James R. Chalmers / John K. Jackson"}],["$","small",null,{"children":"Made the unsupported assault across Dill Branch at about 6 p.m."}]]}],["$","div","Cavalry",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry"}],["$","span",null,{"children":"Nathan Bedford Forrest"}],["$","small",null,{"children":"Observed the overnight United States reinforcement movement and tried to report it"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Ulysses S. Grant",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children"