f:["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Men below the bluff",{"children":[["$","th",null,{"scope":"row","children":"Men below the bluff"}],["$","td",null,{"children":["Podcast estimate: 10,000 to 15,000 stragglers and disorganized soldiers","$undefined"]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.libsyn.com/123-shiloh-part-the-thirteenth",{"href":"https://civilwarpodcast.libsyn.com/123-shiloh-part-the-thirteenth","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 123"]}],["$","a","https://www.nps.gov/places/shiloh-auto-tour-introduction-grant-s-last-line-stop-1.htm",{"href":"https://www.nps.gov/places/shiloh-auto-tour-introduction-grant-s-last-line-stop-1.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Grant’s Last Line"]}],["$","a","https://www.nps.gov/places/grant-s-left-flank-tour-stop-21.htm",{"href":"https://www.nps.gov/places/grant-s-left-flank-tour-stop-21.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Grant’s Left Flank"]}],["$","a","https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm",{"href":"https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of Shiloh"]}],["$","a","https://www.nps.gov/people/lew-wallace.htm",{"href":"https://www.nps.gov/people/lew-wallace.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Lew Wallace"]}],["$","a","https://www.loc.gov/item/85690890/",{"href":"https://www.loc.gov/item/85690890/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Shiloh battlefield map"]}],["$","a","https://www.loc.gov/pictures/item/2004660985/",{"href":"https://www.loc.gov/pictures/item/2004660985/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Pittsburg Landing photograph"]}]]}]]}]
