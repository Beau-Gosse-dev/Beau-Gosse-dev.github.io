1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",149," · ","May 23–25, 1862"," · ","Northern Shenandoah Valley, Virginia: Strasburg, Cedarville, Middletown, Newtown (present-day Stephens City), Kernstown, and Winchester"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: A DAY OF MISSED OPPORTUNITIES"}],["$","span",null,{"className":"result-label","children":"Confederate forces pierced Nathaniel Banks’s retreating column at Middletown and captured men, horses, wagons, and stores, but Thomas J. “Stonewall” Jackson failed to destroy Banks’s main force. Delayed intelligence, divided columns, a two-hour turn south against a small rear guard, looting, darkness, and exhausted troops allowed most of Banks’s command to reach Winchester. Jackson and Richard Ewell closed on the town overnight, setting up the First Battle of Winchester on May 25"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8404469756.mp3?updated=1695307566","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Friday night, May 23, through about 3 a.m. on May 25"}],["$","small",null,{"children":"The fighting at Front Royal is summarized as background. The First Battle of Winchester begins after this episode ends."}]]}],["$","div","Operational result",{"children":[["$","span",null,{"children":"Operational result"}],["$","strong",null,{"children":"Banks reached Winchester; Jackson failed to destroy the retreating force"}],["$","small",null,{"children":"Jackson cut into the Federal column and captured materiel, but his delays left Banks time to concentrate for another fight."}]]}],["$","div","The operational triangle",{"children":[["$","span",null,{"children":"The operational triangle"}],["$","strong",null,{"children":"Winchester–Strasburg–Front Royal"}],["$","small",null,{"children":"Winchester formed the northern apex. Strasburg and Front Royal formed the western and eastern base points."}]]}],["$","div","Western side",{"children":[["$","span",null,{"children":"Western side"}],["$","strong",null,{"children":"About 18 miles on the macadamized Valley Turnpike"}],["$","small",null,{"children":"This was Banks’s direct retreat route from Strasburg through Middletown and Newtown to Winchester."}]]}],["$","div","Eastern side",{"children":[["$","span",null,{"children":"Eastern side"}],["$","strong",null,{"children":"About 19 miles on the Front Royal–Winchester Turnpike"}],["$","small",null,{"children":"Ewell advanced on this road toward Winchester while Jackson moved across the triangle."}]]}],["$","div","Southern base",{"children":[["$","span",null,{"children":"Southern base"}],["$","strong",null,{"children":"About 13 miles from Front Royal to Strasburg"}],["$","small",null,{"children":"A winding dirt road and the Manassas Gap Railroad connected the two towns."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}],"$L28","$undefined","$L29",false,"$L2a",false,"$L2b","$L2c","$L2d"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Jackson’s cross-route",{"children":[["$","span",null,{"children":"Jackson’s cross-route"}],["$","strong",null,{"children":"Chapel Road from Cedarville to Middletown"}],["$","small",null,{"children":"The diagonal road let Jackson move from the Front Royal side of the triangle to the Valley Turnpike about five miles north of Strasburg."}]]}]
f:["$","div","Banks’s alternatives",{"children":[["$","span",null,{"children":"Banks’s alternatives"}],["$","strong",null,{"children":"Remain, retreat west, move north to Winchester, or escape east through Front Royal"}],["$","small",null,{"children":"Jackson considered a northward retreat most likely but kept forces near Front Royal until he had firmer intelligence."}]]}]
10:["$","div","Federal wagon train",{"children":[["$","span",null,{"children":"Federal wagon train"}],["$","strong",null,{"children":"More than 500 wagons in the episode’s account"}],["$","small",null,{"children":"Strasburg had become a supply depot, so Banks had far more transportation than a force of his size ordinarily used."}]]}]
11:["$","div","Evacuation begins",{"children":[["$","span",null,{"children":"Evacuation begins"}],["$","strong",null,{"children":"Supply wagons started north about 10 p.m. on May 23"}],["$","small",null,{"children":"Regimental trains followed around midnight. Only about half the wagons had cleared Strasburg by daybreak."}]]}]
12:["$","div","Column length",{"children":[["$","span",null,{"children":"Column length"}],["$","strong",null,{"children":"About 15 miles by mid-morning on May 24"}],["$","small",null,{"children":"The episode says the leading vehicles were near Winchester while the rear of the train still extended down the Valley Turnpike."}]]}]
13:["$","div","Sick and wounded",{"children":[["$","span",null,{"children":"Sick and wounded"}],["$","strong",null,{"children":"78 in 20 ambulances and about 450 moving on foot"}],["$","small",null,{"children":"These are the episode’s figures for the people Banks had to remove from Strasburg."}]]}]
14:["$","div","Civilians in the retreat",{"children":[["$","span",null,{"children":"Civilians in the retreat"}],["$","strong",null,{"children":"Hundreds of Black drivers and refugees accompanied the column"}],["$","small",null,{"children":"Many were escaping enslavement and had reason to fear capture by Confederate troops. The transcript uses the period term “contraband.”"}]]}]
15:["$","div","Federal infantry departs",{"children":[["$","span",null,{"children":"Federal infantry departs"}],["$","strong",null,{"children":"About 9:15 a.m. on May 24"}],["$","small",null,{"children":"Banks’s soldiers followed the trains and civilians north from Strasburg."}]]}]
16:["$","div","Steuart at Newtown",{"children":[["$","span",null,{"children":"Steuart at Newtown"}],["$","strong",null,{"children":"Federal wagons discovered about 10 a.m."}],["$","small",null,{"children":"George H. Steuart’s mounted detachment attacked the hospital section of the train and reported the retreat to Jackson."}]]}]
17:["$","div","First missed opportunity",{"children":[["$","span",null,{"children":"First missed opportunity"}],["$","strong",null,{"children":"Steuart did not burn the abandoned wagons"}],["$","small",null,{"children":"Burning vehicles across the turnpike could have blocked the road. Federal cavalry and infantry soon drove the small Confederate detachment away."}]]}]
18:["$","div","Jackson receives confirmation",{"children":[["$","span",null,{"children":"Jackson receives confirmation"}],["$","strong",null,{"children":"About 11 a.m."}],["$","small",null,{"children":"Steuart’s courier reported that the Valley Turnpike at Newtown was filled with wagons moving toward Winchester."}]]}]
19:["$","div","Chapel Road delay",{"children":[["$","span",null,{"children":"Chapel Road delay"}],["$","strong",null,{"children":"About two hours"}],["$","small",null,{"children":"Federal cavalry from Maine and Vermont conducted a delaying action as Jackson’s vanguard moved west toward Middletown."}]]}]
1a:["$","div","Middletown breakthrough",{"children":[["$","span",null,{"children":"Middletown breakthrough"}],["$","strong",null,{"children":"Confederates reached and pierced the Federal column during the afternoon"}],["$","small",null,{"children":"Taylor’s infantry and the batteries of Robert Chew and William Poague struck cavalry and wagons on the Valley Turnpike."}]]}]
1b:["$","div","Federal cavalry loss detail",{"children":[["$","span",null,{"children":"Federal cavalry loss detail"}],["$","strong",null,{"children":"The episode reports heavy losses in three companies of the 1st Maine Cavalry"}],["$","small",null,{"children":"It gives 42 men and 61 horses for Company E, 33 men and 47 horses for Company M, and 44 men and 55 horses for Company A. The episode does not separate killed, wounded, captured, and missing within each “men lost” figure."}]]}]
1c:["$","div","Jackson’s information problem",{"children":[["$","span",null,{"children":"Jackson’s information problem"}],["$","strong",null,{"children":"He did not know where he had cut Banks’s column"}],["$","small",null,{"children":"At about 4 p.m. Jackson could see wagons and a rear guard but could not tell how much infantry had already passed north."}]]}]
1d:["$","div","Second missed opportunity",{"children":[["$","span",null,{"children":"Second missed opportunity"}],["$","strong",null,{"children":"Jackson turned south against a small isolated rear guard"}],["$","small",null,{"children":"The episode estimates the force south of Middletown at five guns, 50 artillerymen, 75 infantry, and scattered cavalry companies."}]]}]
1e:["$","div","Time lost at Middletown",{"children":[["$","span",null,{"children":"Time lost at Middletown"}],["$","strong",null,{"children":"Approximately two hours"}],["$","small",null,{"children":"Jackson resumed the northward pursuit at about 5:45 p.m., after most of Banks’s main body had gained additional distance."}]]}]
1f:["$","div","Ewell’s long halt",{"children":[["$","span",null,{"children":"Ewell’s long halt"}],["$","strong",null,{"children":"Roughly ten hours near Double Tollgate"}],["$","small",null,{"children":"Jackson kept Ewell on the eastern road while information and orders crossed the triangle by courier."}]]}]
20:["$","div","Orders to Ewell",{"children":[["$","span",null,{"children":"Orders to Ewell"}],["$","strong",null,{"children":"Advance, halt and detach Elzey, then advance again"}],["$","small",null,{"children":"The episode says there is no evidence that the first courier arrived. The second reached Ewell about 5:15 p.m.; the third arrived after Ewell had already decided to move."}]]}]
21:["$","div","Federal night rear guard",{"children":[["$","span",null,{"children":"Federal night rear guard"}],["$","strong",null,{"children":"2nd Massachusetts, 27th Indiana, and 28th New York"}],["$","small",null,{"children":"These regiments repeatedly used fields, fences, and stone walls to delay Jackson south of Winchester."}]]}]
22:["$","div","Ewell near Winchester",{"children":[["$","span",null,{"children":"Ewell near Winchester"}],["$","strong",null,{"children":"Reached the southeastern outskirts about 10 p.m."}],["$","small",null,{"children":"The 21st North Carolina met Federal pickets. The opposing lines exchanged fire until around midnight."}]]}]
23:["$","div","Jackson near Kernstown",{"children":[["$","span",null,{"children":"Jackson near Kernstown"}],["$","strong",null,{"children":"Advance halted about 3 a.m. on May 25"}],["$","small",null,{"children":"Samuel Fulkerson warned that exhaustion would leave no formed army for the morning. Jackson granted about two hours of rest."}]]}]
24:["$","div","Casualty uncertainty",{"children":[["$","span",null,{"children":"Casualty uncertainty"}],["$","strong",null,{"children":"No reliable May 24 total is isolated in the sources used here"}],["$","small",null,{"children":"National Park Service totals combine Front Royal, Middletown, and First Winchester on May 23–25: 2,028 United States casualties and 397 Confederate casualties. They should not be presented as losses for this episode alone."}]]}]
25:["$","div","Leader losses",{"children":[["$","span",null,{"children":"Leader losses"}],["$","strong",null,{"children":"No important leader was killed or mortally wounded in the narrated action"}],["$","small",null,{"children":"Private Daniel Derrickson of the 66th Ohio was killed during Steuart’s attack at Newtown, but he was not a commander and is therefore not listed in the leader-loss field."}]]}]
26:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Ewell, Steuart, Elzey, Fulkerson, Poague, Dabney, and Strasburg"}],["$","small",null,{"children":"The automated transcript renders these names in forms including “Yule,” “Stewart,” “Elsie,” “Folkerson,” “Pope,” “Dapney,” and “Strasbourg.”"}]]}]
27:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“Jackson’s Valley Campaign: November 1861–June 1862” by David G. Martin"}],"$undefined"]}]
28:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
29:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","May 24 operational triangle and the race to Winchester",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep149-operational-triangle.svg","target":"_blank","rel":"noreferrer","aria-label":"Open May 24 operational triangle and the race to Winchester at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-operational-triangle.svg","alt":"Schematic operational map of the Winchester, Strasburg, and Front Royal triangle showing Banks retreating north, Jackson crossing to Middletown, Steuart scouting Newtown, and Ewell advancing on the eastern road.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"May 24 operational triangle and the race to Winchester"}],["$","span",null,{"children":"Banks moved north from Strasburg on the Valley Turnpike. Steuart crossed to Newtown, Jackson moved from Cedarville to Middletown on Chapel Road, and Ewell advanced on the eastern turnpike. The diagram explains the choices and delays; positions, road curves, distances, unit footprints, and arrow timing are approximate. This map is schematic."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep149-operational-triangle.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service and Official Records; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Middletown: breakthrough, wrong turn, and renewed pursuit",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep149-middletown-tactics.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Middletown: breakthrough, wrong turn, and renewed pursuit at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-middletown-tactics.svg","alt":"Schematic tactical map of the May 24 action at Middletown showing the Confederate breakthrough, the southward turn against the Federal rear guard, and the late northward pursuit.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Middletown: breakthrough, wrong turn, and renewed pursuit"}],["$","span",null,{"children":"Taylor’s infantry and Chew’s and Poague’s guns struck the Valley Turnpike north of Middletown. Jackson then turned south toward a small rear guard before reversing course at about 5:45 p.m. and pursuing Banks north. This tactical diagram is schematic; the exact placement of small units, stone walls, guns, wagons, and phase boundaries is approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep149-middletown-tactics.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service and Jackson’s official report; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Department of the Shenandoah-Maj. Gen. Nathaniel P. Banks",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Shenandoah"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Ordered the evacuation of Strasburg, moved the trains and main force toward Winchester, and directed rear-guard resistance"}]]}],["$","div","Infantry division under Banks-Brig. Gen. Alpheus S. Williams",{"className":"command-entry","children":[["$","strong",null,{"children":"Infantry division under Banks"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Accompanied the main column north and reached Winchester with Banks; division included brigades led by George H. Gordon and Dudley Donnelly"}]]}],["$","div","Cavalry and rear guard-Brig. Gen. John P. Hatch",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry and rear guard"}],["$","span",null,{"children":"Brig. Gen. John P. Hatch"}],["$","small",null,{"children":"Coordinated mounted resistance at Middletown, including elements of the 1st Maine, 1st Vermont, 5th New York, and other cavalry"}]]}],["$","div","Night rear guard south of Winchester-Col. George H. Gordon",{"className":"command-entry","children":[["$","strong",null,{"children":"Night rear guard south of Winchester"}],["$","span",null,{"children":"Col. George H. Gordon"}],["$","small",null,{"children":"2nd Massachusetts and 28th New York with artillery; joined the 27th Indiana and delayed Jackson until about 2 a.m."}]]}],["$","div","27th Indiana Infantry-Col. Silas Colgrove",{"className":"command-entry","children":[["$","strong",null,{"children":"27th Indiana Infantry"}],["$","span",null,{"children":"Col. Silas Colgrove"}],["$","small",null,{"children":"Deployed across the Valley Turnpike south of Newtown before falling back into Gordon’s night rear guard"}]]}],["$","div","Zouaves d’Afrique, Banks’s headquarters guard-Col. Charles H. T. Collis",{"className":"command-entry","children":[["$","strong",null,{"children":"Zouaves d’Afrique, Banks’s headquarters guard"}],["$","span",null,{"children":"Col. Charles H. T. Collis"}],["$","small",null,{"children":"Covered the last trains south of Middletown and withdrew toward Strasburg after becoming separated from Banks’s main body"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Valley District and combined Valley force-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District and combined Valley force"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Directed the two-pronged pursuit, crossed Chapel Road to Middletown, turned south against the rear guard, then resumed the advance toward Winchester"}]]}],"$L2e","$L2f","$L30","$L31","$L32","$L33","$L34"]]}]]}],"$L35"]]]}]
2b:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep149-ashbys-charge-middletown.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-ashbys-charge-middletown.jpg","alt":"Early twentieth-century illustration of Confederate cavalry and artillery attacking at Middletown.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"“Ashby’s Charge at Middletown,” published in the 1907 History of the Laurel Brigade, is a later artistic interpretation rather than a contemporary photograph. It depicts the cavalry and artillery violence on the Valley Turnpike."}]]}],["$","figure","/images/ep149-operational-triangle.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-operational-triangle.svg","alt":"Schematic operational map of Banks’s retreat and the Confederate convergence on Winchester.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The road network created Jackson’s opportunity and his dilemma: he needed to intercept Banks without uncovering the route east through Front Royal."}]]}],["$","figure","/images/ep149-middletown-tactics.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-middletown-tactics.svg","alt":"Schematic tactical map of the Confederate strike and delay at Middletown.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson pierced the retreating column but then turned south against its small rear guard. The delay allowed the main body to continue north."}]]}],["$","figure","/images/ep149-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-stonewall-jackson.jpg","alt":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s plan put troops on both roads to Winchester, but slow intelligence and repeated changes of direction prevented a decisive interception on May 24."}]]}],["$","figure","/images/ep149-nathaniel-banks.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-nathaniel-banks.jpg","alt":"Civil War-era photographic portrait of United States general Nathaniel P. Banks in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Banks saved his main body and most of the enormous Strasburg train long enough to make a stand at Winchester the next morning."}]]}],["$","figure","/images/ep149-richard-ewell.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-richard-ewell.jpg","alt":"Wartime photographic portrait of Confederate general Richard S. Ewell in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Ewell waited on the eastern road for most of the day as Jackson’s courier orders changed, then advanced to the edge of Winchester at night."}]]}],["$","figure","/images/ep149-george-steuart.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-george-steuart.jpg","alt":"Photographic portrait of Confederate brigadier general George H. Steuart in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Steuart found the Federal train at Newtown but did not convert the surprise into a lasting roadblock. He is not J. E. B. Stuart; his surname is spelled Steuart."}]]}]]}]]}]
