2e:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
30:["$","$L2f",null,{"seconds":477,"label":"7:57"}]
31:["$","div",null,{"children":[["$","h3",null,{"children":"Banks’s night decision is reconstructed"}],["$","p",null,{"children":"The episode describes Banks sorting incomplete and conflicting reports after the Front Royal disaster and preparing to withdraw from Strasburg."}]]}]
32:["$","div","The trains start north",{"className":"moment","children":[["$","$L2f",null,{"seconds":529,"label":"8:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"The trains start north"}],["$","p",null,{"children":"Supply wagons began leaving about 10 p.m. on May 23. Regiments south of Strasburg packed their trains and drew closer to town."}]]}]]}]
33:["$","div","Front Royal’s loss is confirmed",{"className":"moment","children":[["$","$L2f",null,{"seconds":544,"label":"9:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Front Royal’s loss is confirmed"}],["$","p",null,{"children":"Reliable confirmation reached Banks’s headquarters around midnight, when regimental trains were also beginning to roll out."}]]}]]}]
34:["$","div","Half the wagons remain at daybreak",{"className":"moment","children":[["$","$L2f",null,{"seconds":558,"label":"9:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Half the wagons remain at daybreak"}],["$","p",null,{"children":"The vehicles already on the road extended for about seven miles, but only roughly half the train had cleared Strasburg."}]]}]]}]
35:["$","div","The depot burdens Banks with 500 wagons",{"className":"moment","children":[["$","$L2f",null,{"seconds":568,"label":"9:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The depot burdens Banks with 500 wagons"}],["$","p",null,{"children":"Strasburg’s accumulated stores made the train unusually large for Banks’s field force."}]]}]]}]
36:["$","div","The sick and wounded join the movement",{"className":"moment","children":[["$","$L2f",null,{"seconds":584,"label":"9:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The sick and wounded join the movement"}],["$","p",null,{"children":"Twenty ambulances carried 78 men while about 450 more sick and wounded attempted to keep pace on foot."}]]}]]}]
37:["$","div","Black civilians flee with the army",{"className":"moment","children":[["$","$L2f",null,{"seconds":601,"label":"10:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Black civilians flee with the army"}],["$","p",null,{"children":"Drivers and families escaping enslavement crowded the retreat among wagons, ambulances, horses, and cattle."}]]}]]}]
38:["$","div","The wagon column reaches 15 miles",{"className":"moment","children":[["$","$L2f",null,{"seconds":645,"label":"10:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The wagon column reaches 15 miles"}],["$","p",null,{"children":"By mid-morning its head approached Winchester while vehicles still stretched far back along the Valley Turnpike."}]]}]]}]
39:["$","div","Banks’s infantry leaves Strasburg",{"className":"moment","children":[["$","$L2f",null,{"seconds":658,"label":"10:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks’s infantry leaves Strasburg"}],["$","p",null,{"children":"The soldiers began marching north at about 9:15 a.m., behind the trains and refugees."}]]}]]}]
3a:["$","div","Steuart reports from Newtown",{"className":"moment","children":[["$","$L2f",null,{"seconds":677,"label":"11:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Steuart reports from Newtown"}],["$","p",null,{"children":"His courier told Jackson that the mounted detachment had reached Newtown around 10 a.m. and attacked the Federal train."}]]}]]}]
3b:["$","div","The first opportunity is missed",{"className":"moment","children":[["$","$L2f",null,{"seconds":700,"label":"11:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first opportunity is missed"}],["$","p",null,{"children":"Steuart’s men captured helpless patients and attendants instead of immediately blocking the road by burning abandoned wagons."}]]}]]}]
3c:["$","div","Daniel Derrickson is mortally shot",{"className":"moment","children":[["$","$L2f",null,{"seconds":829,"label":"13:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Daniel Derrickson is mortally shot"}],["$","p",null,{"children":"The episode identifies the 46-year-old private of the 66th Ohio as the only man shot during the brief hospital-train attack. He died after writing his name and regiment for his family."}]]}]]}]
3d:["$","div","Teamsters abandon wagons",{"className":"moment","children":[["$","$L2f",null,{"seconds":912,"label":"15:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Teamsters abandon wagons"}],["$","p",null,{"children":"The attack caused panic, especially among Black drivers who feared capture and re-enslavement."}]]}]]}]
3e:["$","div","Federal troops drive Steuart away",{"className":"moment","children":[["$","$L2f",null,{"seconds":932,"label":"15:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal troops drive Steuart away"}],["$","p",null,{"children":"Cavalry and double-timing infantry reached Newtown before the road was blocked and forced Steuart’s remaining men into the woods before noon."}]]}]]}]
3f:["$","div","Jackson splits the Confederate force",{"className":"moment","children":[["$","$L2f",null,{"seconds":1014,"label":"16:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson splits the Confederate force"}],["$","p",null,{"children":"Ewell remained on the eastern road with Trimble and Elzey while Jackson took Taylor’s brigade across Chapel Road toward Middletown."}]]}]]}]
40:["$","div","Federal cavalry slows the Chapel Road advance",{"className":"moment","children":[["$","$L2f",null,{"seconds":1055,"label":"17:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal cavalry slows the Chapel Road advance"}],["$","p",null,{"children":"Maine and Vermont troopers delayed Hotchkiss, Ashby, and the Confederate vanguard for about two hours."}]]}]]}]
41:["$","div","John Hatch brings up the rear guard",{"className":"moment","children":[["$","$L2f",null,{"seconds":1111,"label":"18:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"John Hatch brings up the rear guard"}],["$","p",null,{"children":"Banks’s cavalry commander reached Middletown after the trains, infantry, Banks, and Williams had already passed north."}]]}]]}]
42:["$","div","The Confederate vanguard reaches the turnpike",{"className":"moment","children":[["$","$L2f",null,{"seconds":1127,"label":"18:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate vanguard reaches the turnpike"}],["$","p",null,{"children":"Hotchkiss and Ashby brought forward about 100 men of the 8th Louisiana, Chew’s battery, and two of Poague’s rifled guns."}]]}]]}]
43:["$","div","The 1st Maine charges",{"className":"moment","children":[["$","$L2f",null,{"seconds":1156,"label":"19:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 1st Maine charges"}],["$","p",null,{"children":"Hatch ordered Federal cavalry down the pike. Louisiana infantry behind a stone wall and Confederate artillery opened at short range and inflicted heavy losses."}]]}]]}]
44:["$","div","Confederate guns rake the wagon train",{"className":"moment","children":[["$","$L2f",null,{"seconds":1240,"label":"20:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate guns rake the wagon train"}],["$","p",null,{"children":"Surviving horsemen encountered the rear of the baggage train while Chew and Poague fired along a bend in the crowded road."}]]}]]}]
45:["$","div","Jackson cannot locate the Federal infantry",{"className":"moment","children":[["$","$L2f",null,{"seconds":1291,"label":"21:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson cannot locate the Federal infantry"}],["$","p",null,{"children":"At about 4 p.m. he did not know what portion of Banks’s column had passed north or whether he had cut its head, middle, or tail."}]]}]]}]
46:["$","div","The first order tells Ewell to advance",{"className":"moment","children":[["$","$L2f",null,{"seconds":1331,"label":"22:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first order tells Ewell to advance"}],["$","p",null,{"children":"Jackson directed Ewell to move promptly toward Winchester, but the episode says there is no evidence that this courier reached him."}]]}]]}]
47:["$","div","Jackson turns south and reverses Ewell’s order",{"className":"moment","children":[["$","$L2f",null,{"seconds":1359,"label":"22:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson turns south and reverses Ewell’s order"}],["$","p",null,{"children":"Firing south of Middletown led Jackson to send Taylor toward Strasburg and order Ewell to halt and send Elzey’s brigade back."}]]}]]}]
48:["$","div","A small rear guard absorbs Jackson’s attention",{"className":"moment","children":[["$","$L2f",null,{"seconds":1394,"label":"23:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"A small rear guard absorbs Jackson’s attention"}],["$","p",null,{"children":"The episode identifies the force south of town as only five guns, about 50 artillerymen, 75 infantry, and scattered cavalry companies."}]]}]]}]
49:["$","div","Ewell waits near Double Tollgate",{"className":"moment","children":[["$","$L2f",null,{"seconds":1494,"label":"24:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell waits near Double Tollgate"}],["$","p",null,{"children":"He had halted for about nine hours roughly nine miles from Winchester and had received no useful update from Jackson."}]]}]]}]
4a:["$","div","The second order reaches Ewell",{"className":"moment","children":[["$","$L2f",null,{"seconds":1521,"label":"25:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The second order reaches Ewell"}],["$","p",null,{"children":"At about 5:15 p.m. Ewell received the instruction to remain in place and send Elzey to Middletown, reducing his available force to about 2,000 men in the episode’s accounting."}]]}]]}]
4b:["$","div","Jackson resumes the northward pursuit",{"className":"moment","children":[["$","$L2f",null,{"seconds":1585,"label":"26:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson resumes the northward pursuit"}],["$","p",null,{"children":"At about 5:45 p.m. he turned back toward Winchester and sent a third message directing Ewell to advance with his entire force."}]]}]]}]
4c:["$","div","Ewell advances before the courier arrives",{"className":"moment","children":[["$","$L2f",null,{"seconds":1638,"label":"27:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell advances before the courier arrives"}],["$","p",null,{"children":"His patience exhausted, Ewell moved without fresh orders. Jackson’s confirming message reached him about 15 minutes later."}]]}]]}]
4d:["$","div","Ewell reaches Winchester’s outskirts",{"className":"moment","children":[["$","$L2f",null,{"seconds":1669,"label":"27:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell reaches Winchester’s outskirts"}],["$","p",null,{"children":"Around 10 p.m. the 21st North Carolina met Federal pickets southeast of town. Firing continued until about midnight."}]]}]]}]
4e:["$","div","Banks forms a night rear guard",{"className":"moment","children":[["$","$L2f",null,{"seconds":1762,"label":"29:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks forms a night rear guard"}],["$","p",null,{"children":"Near Winchester he sent George H. Gordon back with the 2nd Massachusetts, 28th New York, and artillery. Silas Colgrove’s 27th Indiana was already resisting farther south."}]]}]]}]
4f:["$","div","Friendly fire strikes the 27th Indiana",{"className":"moment","children":[["$","$L2f",null,{"seconds":1805,"label":"30:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Friendly fire strikes the 27th Indiana"}],["$","p",null,{"children":"The 2nd Massachusetts mistakenly fired toward the Indiana regiment before the rear-guard line was sorted out."}]]}]]}]
50:["$","div","A volley disrupts the Confederate advance",{"className":"moment","children":[["$","$L2f",null,{"seconds":1836,"label":"30:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"A volley disrupts the Confederate advance"}],["$","p",null,{"children":"Fire from the 2nd Massachusetts sent Ashby’s cavalry back through Poague’s guns and into Jackson’s and Winder’s staffs, causing confusion in the 33rd Virginia."}]]}]]}]
51:["$","div","Gordon reaches Winchester",{"className":"moment","children":[["$","$L2f",null,{"seconds":1881,"label":"31:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gordon reaches Winchester"}],["$","p",null,{"children":"After a stubborn withdrawal from wall to wall and fence to fence, the Federal rear guard entered the town around 2 a.m."}]]}]]}]
52:["$","div","Jackson reaches north of Kernstown",{"className":"moment","children":[["$","$L2f",null,{"seconds":1950,"label":"32:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson reaches north of Kernstown"}],["$","p",null,{"children":"At about 3 a.m., after the night pursuit, the Confederate infantry was collapsing from exhaustion."}]]}]]}]
53:["$","div","Fulkerson forces a halt",{"className":"moment","children":[["$","$L2f",null,{"seconds":1997,"label":"33:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fulkerson forces a halt"}],["$","p",null,{"children":"He warned Jackson that further marching would leave only a skirmish line by dawn. Jackson allowed the men about two hours of sleep."}]]}]]}]
54:["$","div","Banks wins the race to Winchester",{"className":"moment","children":[["$","$L2f",null,{"seconds":2005,"label":"33:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks wins the race to Winchester"}],["$","p",null,{"children":"Jackson’s use of Ewell and his southward turn at Middletown cost the time needed to destroy Banks during the retreat."}]]}]]}]
55:["$","div","The First Battle of Winchester is set",{"className":"moment","children":[["$","$L2f",null,{"seconds":2054,"label":"34:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The First Battle of Winchester is set"}],["$","p",null,{"children":"Banks prepared inside Winchester while Jackson rested southwest of town and Ewell lay southeast of it."}]]}]]}]
56:["$","div","The book recommendation",{"className":"moment","children":[["$","$L2f",null,{"seconds":2069,"label":"34:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The book recommendation"}],["$","p",null,{"children":"The hosts recommend David G. Martin’s “Jackson’s Valley Campaign: November 1861–June 1862.”"}]]}]]}]
57:["$","span",null,{"children":"Brig. Gen. George H. “Maryland” Steuart"}]
58:["$","small",null,{"children":"2nd and 6th Virginia Cavalry; scouted and attacked the Federal train at Newtown and reported the retreat to Jackson"}]
59:["$","div","Cavalry chief and advance guard",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry chief and advance guard"}],["$","span",null,{"children":"Col. Turner Ashby"}],["$","small",null,{"children":"Screened Jackson’s movement, led the Chapel Road vanguard with Hotchkiss, and accompanied the pursuit on the Valley Turnpike"}]]}]
5a:["$","div","Stonewall Brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Brig. Gen. Charles S. Winder"}],["$","small",null,{"children":"Led the late northward pursuit from Middletown and pressed the exhausted infantry toward Kernstown"}]]}]
5b:["$","div","Second and Third Brigades",{"className":"command-entry","children":[["$","strong",null,{"children":"Second and Third Brigades"}],["$","span",null,{"children":"Col. John A. Campbell / Col. Samuel V. Fulkerson"}],["$","small",null,{"children":"Followed Taylor across the triangle; Fulkerson persuaded Jackson to halt the exhausted column near Kernstown"}]]}]
5c:["$","div","Confederate artillery at Middletown",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate artillery at Middletown"}],["$","span",null,{"children":"Capt. Robert P. Chew / Capt. William T. Poague"}],["$","small",null,{"children":"Chew’s horse artillery and two rifled guns from Poague’s Rockbridge Artillery fired into cavalry and wagons on the turnpike"}]]}]
5d:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
5e:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Thomas J. “Stonewall” Jackson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-stonewall-jackson.jpg","alt":"Portrait of Thomas J. “Stonewall” Jackson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Overall Confederate commander whose divided pursuit pierced Banks’s column but failed to destroy the main Federal force before it reached Winchester"}]]}]]}],["$","article","Nathaniel P. Banks",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-nathaniel-banks.jpg","alt":"Portrait of Nathaniel P. Banks","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Nathaniel P. Banks"}],["$","p",null,{"children":"United States department commander who evacuated Strasburg, protected an unusually large train, and concentrated his main body at Winchester"}]]}]]}],["$","article","Richard S. Ewell",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-richard-ewell.jpg","alt":"Portrait of Richard S. Ewell","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Richard S. Ewell"}],["$","p",null,{"children":"Confederate division commander held on the eastern road for most of May 24 before advancing toward Winchester late in the day"}]]}]]}],["$","article","George H. “Maryland” Steuart",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep149-g