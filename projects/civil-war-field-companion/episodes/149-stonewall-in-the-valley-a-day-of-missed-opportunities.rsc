r, including combined May 23–25 losses"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://texashistory.unt.edu/ark:/67531/metapth154618/",{"children":["$","a",null,{"href":"https://texashistory.unt.edu/ark:/67531/metapth154618/","target":"_blank","rel":"noreferrer","children":["Primary source collection: Official Records, Series I, Volume XII, Part I"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://texashistory.unt.edu/ark:/67531/metapth154618/m1/710/",{"children":["$","a",null,{"href":"https://texashistory.unt.edu/ark:/67531/metapth154618/m1/710/","target":"_blank","rel":"noreferrer","children":["Primary report: Jackson’s organization and opening operations, Official Records page 701"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://texashistory.unt.edu/ark:/67531/metapth154618/m1/712/",{"children":["$","a",null,{"href":"https://texashistory.unt.edu/ark:/67531/metapth154618/m1/712/","target":"_blank","rel":"noreferrer","children":["Primary report: Jackson on the May 24 plan and Middletown breakthrough, Official Records page 703"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://texashistory.unt.edu/ark:/67531/metapth154618/m1/713/",{"children":["$","a",null,{"href":"https://texashistory.unt.ed