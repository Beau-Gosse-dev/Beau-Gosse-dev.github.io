1b:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Johnston withdraws from Centreville and Manassas",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep129-northern-virginia-withdrawal.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Johnston withdraws from Centreville and Manassas at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep129-northern-virginia-withdrawal.svg","alt":"Schematic map of the Confederate withdrawal from Centreville and Manassas to the Rappahannock and the United States advance from Washington","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Johnston withdraws from Centreville and Manassas"}],["$","span",null,{"children":"This operational schematic shows Johnston’s March 7–9 withdrawal toward the Rappahannock, the congested railroad route toward Gordonsville, Jackson’s separate position near Winchester, and the United States advance from Washington on March 10. Positions are approximate and the map is not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep129-northern-virginia-withdrawal.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo72995/pdf/GOVPUB-D114-PURL-gpo72995.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1b:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The plan changes from Urbanna to Fort Monroe",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep129-urbanna-to-peninsula.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The plan changes from Urbanna to Fort Monroe at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep129-urbanna-to-peninsula.svg","alt":"Schematic map comparing the abandoned Urbanna route with the adopted route to Fort Monroe and up the Virginia Peninsula","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The plan changes from Urbanna to Fort Monroe"}],["$","span",null,{"children":"Johnston’s new position near the Rappahannock could oppose a landing at Urbanna, eliminating the maneuver’s intended advantage. McClellan retained the waterborne concept but shifted the base to Fort Monroe and planned to advance up the Peninsula between the York and James Rivers. The schematic is not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep129-urbanna-to-peninsula.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1b:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.presidency.ucsb.edu/documents/executive-order-454","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1b:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
1c:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Lincoln’s order forces McClellan to disclose his plan",{"className":"moment","children":[["$","$L21",null,{"seconds":69,"label":"1:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln’s order forces McClellan to disclose his plan"}],["$","p",null,{"children":"The episode resumes with the dispute between Lincoln’s proposed movement against Johnston at Manassas and McClellan’s plan to move by water to Urbanna and approach Richmond from the east."}]]}]]}],["$","div","Pressure for an eastern offensive increases",{"className":"moment","children":[["$","$L21",null,{"seconds":223,"label":"3:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pressure for an eastern offensive increases"}],["$","p",null,{"children":"Northern newspapers, Congress, and the Joint Committee on the Conduct of the War demanded action while Burnside, Thomas, and Grant won victories elsewhere."}]]}]]}],["$","div","Stanton publicly calls for aggressive action",{"className":"moment","children":[["$","$L21",null,{"seconds":287,"label":"4:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stanton publicly calls for aggressive action"}],["$","p",null,{"children":"Secretary of War Edwin M. Stanton sent the New-York Tribune a February 19 statement calling for bold pursuit of the enemy. His early cooperation with McClellan had already given way to opposition."}]]}]]}],["$","div","The Joint Committee questions McClellan",{"className":"moment","children":[["$","$L21",null,{"seconds":448,"label":"7:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Joint Committee questions McClellan"}],["$","p",null,{"children":"After McClellan recovered from typhoid fever, the congressional committee examined him for six hours. Its members distrusted his caution, Democratic politics, and limited-war approach."}]]}]]}],["$","div","Willie Lincoln dies",{"className":"moment","children":[["$","$L21",null,{"seconds":700,"label":"11:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Willie Lincoln dies"}],["$","p",null,{"children":"The president’s eleven-year-old son died on February 20. McClellan sent Lincoln a letter of condolence and said that he was completing the military measures they had discussed."}]]}]]}],["$","div","McClellan plans two preliminary operations",{"className":"moment","children":[["$","$L21",null,{"seconds":756,"label":"12:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan plans two preliminary operations"}],["$","p",null,{"children":"Before the Urbanna movement, McClellan intended to clear the Confederate batteries on the lower Potomac and restore the Baltimore and Ohio Railroad crossing at Harpers Ferry."}]]}]]}],["$","div","The Harpers Ferry crossing begins",{"className":"moment","children":[["$","$L21",null,{"seconds":843,"label":"14:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Harpers Ferry crossing begins"}],["$","p",null,{"children":"McClellan supervised the operation on February 26. A pontoon bridge carried the leading troops across, but a stronger bridge was required for the main force, artillery, and baggage."}]]}]]}],["$","div","The canal boats do not fit the lock",{"className":"moment","children":[["$","$L21",null,{"seconds":901,"label":"15:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"The canal boats do not fit the lock"}],["$","p",null,{"children":"Boats intended to support the heavier bridge could not pass through the lift lock into the Potomac. McClellan canceled the planned advance on Winchester and the simultaneous lower-Potomac crossing."}]]}]]}],["$","div","Lincoln reacts to the failure",{"className":"moment","children":[["$","$L21",null,{"seconds":966,"label":"16:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln reacts to the failure"}],["$","p",null,{"children":"Lincoln summoned McClellan’s chief of staff, Randolph B. Marcy, and demanded to know why the lock had not been measured before the boats and resources were assembled."}]]}]]}],"$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33"]}]]}]
1d:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","President and constitutional commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and constitutional commander in chief"}],["$","span",null,{"children":"Abraham Lincoln"}],["$","small",null,{"children":"Approved the waterborne operation with conditions, created the Army of the Potomac’s corps, and ended McClellan’s authority over the other military departments"}]]}],["$","div","Secretary of War",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of War"}],["$","span",null,{"children":"Edwin M. Stanton"}],["$","small",null,{"children":"Directed War Department administration, pressed for action, and became the reporting authority for the separate military departments after March 11"}]]}],["$","div","General-in-chief through March 11; commander, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief through March 11; commander, Army of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Directed the Harpers Ferry operation, pursued Johnston after the evacuation, replaced the Urbanna plan with the Fort Monroe operation, and retained field command after losing the general-in-chief post"}]]}],["$","div","Chief of staff, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief of staff, Army of the Potomac"}],["$","span",null,{"children":"Randolph B. Marcy"}],["$","small",null,{"children":"McClellan’s chief of staff and father-in-law; reported Lincoln’s angry reaction to the Harpers Ferry bridge failure"}]]}],["$","div","I Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps, Army of the Potomac"}],["$","span",null,{"children":"Irvin McDowell"}],["$","small",null,{"children":"One of the four corps commanders appointed by Lincoln on March 8; had voted against the Urbanna plan"}]]}],["$","div","II Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps, Army of the Potomac"}],["$","span",null,{"children":"Edwin V. Sumner"}],["$","small",null,{"children":"One of the four corps commanders appointed by Lincoln on March 8; had voted against the Urbanna plan"}]]}],["$","div","III Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of the Potomac"}],["$","span",null,{"children":"Samuel P. Heintzelman"}],["$","small",null,{"children":"One of the four corps commanders appointed by Lincoln on March 8; had voted against the Urbanna plan"}]]}],["$","div","IV Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"IV Corps, Army of the Potomac"}],["$","span",null,{"children":"Erasmus D. Keyes"}],["$","small",null,{"children":"One of the four corps commanders appointed by Lincoln on March 8"}]]}],["$","div","Division commander, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander, Army of the Potomac"}],["$","span",null,{"children":"Joseph Hooker"}],["$","small",null,{"children":"Assigned about 4,000 troops for the proposed crossing against Confederate batteries on the lower Potomac"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","President and commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander in chief"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Approved the principle of withdrawing from the Centreville–Manassas line but was not told when Johnston began the movement"}]]}],"$L34","$L35","$L36","$L37","$L38"]]}]]}],"$L39","$L3a"]}]
1e:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep129-quaker-guns-centreville.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep129-quaker-guns-centreville.jpg","alt":"Former Confederate fortification on the heights at Centreville with wooden Quaker guns in March 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"George N. Barnard and James F. Gibson photographed the abandoned Centreville fortifications and their wooden Quaker guns after the United States advance."}]]}],["$","figure","/images/ep129-confederate-winter-quarters-manassas.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep129-confederate-winter-quarters-manassas.jpg","alt":"Confederate winter quarters at Manassas photographed after the evacuation","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Timothy O’Sullivan photographed the remains of Confederate winter quarters at Manassas in 1862. Johnston’s army had accumulated extensive camps, baggage, and stores during the winter."}]]}],["$","figure","/images/ep129-monitor-virginia.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep129-monitor-virginia.jpg","alt":"Lithograph showing USS Monitor and CSS Virginia fighting at close range in Hampton Roads","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A lithograph after W. F. Halsall depicts Monitor and Virginia on March 9. The Confederate ironclad’s continued presence affected the naval guarantees required for McClellan’s Peninsula movement."}]]}],["$","figure","/images/ep129-joseph-johnston.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep129-joseph-johnston.jpg","alt":"Portrait of Confederate General Joseph E. Johnston in civilian clothing","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Johnston concluded that the Centreville–Manassas position could not be held against McClellan’s larger army once the roads improved and withdrew before a United States attack."}]]}],["$","figure","/images/ep129-george-mcclellan-1861.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep129-george-mcclellan-1861.jpg","alt":"Major General George B. McClellan standing in uniform in 1861","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"McClellan retained command of the Army of the Potomac after March 11 and adapted his amphibious concept to use Fort Monroe as the new base."}]]}]]}]]}]
