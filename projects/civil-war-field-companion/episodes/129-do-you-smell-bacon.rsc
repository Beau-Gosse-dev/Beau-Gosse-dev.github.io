1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",129," · ","February 19–March 17, 1862"," · ","Washington, D.C.; Harpers Ferry, Virginia; the Confederate positions at Centreville and Manassas; the Orange and Alexandria Railroad corridor to Gordonsville and the Rappahannock River; Hampton Roads; Alexandria; and the Virginia Peninsula"]}],["$","h1",null,{"children":"\"DO YOU SMELL BACON?\""}],["$","span",null,{"className":"result-label","children":"Joseph E. Johnston withdrew the principal Confederate field army in northern Virginia from Centreville and Manassas to the Rappahannock before McClellan attacked. The withdrawal nullified McClellan’s proposed Urbanna landing because Johnston could now oppose that route. After a short United States advance into the abandoned works, McClellan substituted an amphibious movement to Fort Monroe and the Virginia Peninsula. Lincoln approved that operation subject to the security of Washington and reorganized the Army of the Potomac into corps. McClellan ceased to be general-in-chief on March 11 but retained command of the Army of the Potomac, whose first divisions embarked from Alexandria on March 17"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6581168641.mp3?updated=1695211793","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Harpers Ferry force",{"children":[["$","span",null,{"children":"Harpers Ferry force"}],["$","strong",null,{"children":"About 23,000 United States troops"}],["$","small",null,{"children":"A pontoon bridge carried the advance troops across the Potomac; the heavier bridge intended for artillery and baggage could not be built as planned."}]]}],["$","div","Canal-boat error",{"children":[["$","span",null,{"children":"Canal-boat error"}],["$","strong",null,{"children":"Boats roughly 4–6 inches too wide for the lift lock"}],["$","small",null,{"children":"McClellan’s own later account gave a range of four to six inches. The episode rounds the mismatch to six inches."}]]}],["$","div","Lower Potomac force",{"children":[["$","span",null,{"children":"Lower Potomac force"}],["$","strong",null,{"children":"About 4,000 troops under Joseph Hooker"}],["$","small",null,{"children":"The proposed crossing against the Confederate river batteries was canceled when McClellan also canceled the march from Harpers Ferry toward Winchester."}]]}],["$","div","Johnston’s field force",{"children":[["$","span",null,{"children":"Johnston’s field force"}],["$","strong",null,{"children":"About 42,000 troops east of the Blue Ridge"}],["$","small",null,{"children":"This is the figure stated in the episode for the force ordered back toward the Rappahannock on March 7."}]]}],["$","div","Jackson’s command",{"children":[["$","span",null,{"children":"Jackson’s command"}],["$","strong",null,{"children":"About 5,400 troops near Winchester"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19"]}],"$L1a","$L1b","$L1c","$L1d",false,"$L1e","$L1f","$L20"]}]]}]
21:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"Jackson’s Valley force was excluded from Johnston’s withdrawal order."}]
f:["$","div","Supply accumulation",{"children":[["$","span",null,{"children":"Supply accumulation"}],["$","strong",null,{"children":"More than 2 million pounds of bacon and salted meat"}],["$","small",null,{"children":"Johnston later wrote that the Confederate commissary had accumulated excessive stores around Manassas and the nearby meat-curing establishment."}]]}]
10:["$","div","Rail movement",{"children":[["$","span",null,{"children":"Rail movement"}],["$","strong",null,{"children":"As long as 36 hours for about 60 miles"}],["$","small",null,{"children":"The episode describes severe congestion on the single-track Orange and Alexandria Railroad between Manassas and Gordonsville."}]]}]
11:["$","div","Evacuation order",{"children":[["$","span",null,{"children":"Evacuation order"}],["$","strong",null,{"children":"March 7, 1862"}],["$","small",null,{"children":"The last Confederate infantry left the Centreville–Manassas works by the evening of March 9."}]]}]
12:["$","div","Destroyed stores",{"children":[["$","span",null,{"children":"Destroyed stores"}],["$","strong",null,{"children":"Rail equipment, buildings, and commissary supplies burned"}],["$","small",null,{"children":"The episode states that one million pounds of meat were burned; that exact quantity was not independently established for this guide. The specific story that the smell of bacon first alerted United States scouts is presented as an allegation, not a confirmed fact."}]]}]
13:["$","div","Urbanna plan vote",{"children":[["$","span",null,{"children":"Urbanna plan vote"}],["$","strong",null,{"children":"8 division commanders in favor, 4 opposed"}],["$","small",null,{"children":"McClellan called the vote on March 8 after Lincoln reported political accusations that the movement would leave Washington exposed."}]]}]
14:["$","div","Army reorganization",{"children":[["$","span",null,{"children":"Army reorganization"}],["$","strong",null,{"children":"12 divisions organized into 4 army corps"}],["$","small",null,{"children":"President’s General War Order No. 2 assigned McDowell, Sumner, Heintzelman, and Keyes as corps commanders on March 8."}]]}]
15:["$","div","Hampton Roads",{"children":[["$","span",null,{"children":"Hampton Roads"}],["$","strong",null,{"children":"CSS Virginia attacked March 8; USS Monitor fought her March 9"}],["$","small",null,{"children":"The Confederate ironclad’s continued existence affected planning for an army movement through the Chesapeake and operations near the Peninsula."}]]}]
16:["$","div","Command change",{"children":[["$","span",null,{"children":"Command change"}],["$","strong",null,{"children":"McClellan relieved as general-in-chief on March 11"}],["$","small",null,{"children":"He remained commander of the Army of the Potomac. Department commanders thereafter reported directly to the secretary of war."}]]}]
17:["$","div","Peninsula movement",{"children":[["$","span",null,{"children":"Peninsula movement"}],["$","strong",null,{"children":"First division embarked March 17, 1862"}],["$","small",null,{"children":"Hamilton’s division sailed from Alexandria to Fort Monroe, beginning the Army of the Potomac’s transfer."}]]}]
18:["$","div","Combat losses in this episode",{"children":[["$","span",null,{"children":"Combat losses in this episode"}],["$","strong",null,{"children":"None in the land operations described"}],["$","small",null,{"children":"The episode discusses planning, a failed bridging operation, evacuation, and maneuver. It references the separate Battle of Hampton Roads but does not recount its casualties."}]]}]
19:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"Echoes of Glory: Illustrated Atlas of the Civil War by the editors of Time-Life Books"}],"$undefined"]}]
