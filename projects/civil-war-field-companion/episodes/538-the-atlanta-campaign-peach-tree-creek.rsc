19:["$","p",null,{"children":"The fighting diminished around 7 p.m. and had stopped by about 8 p.m. The Confederate army withdrew from the attacks without breaking the Army of the Cumberland."}]
1a:["$","div","Losses were concentrated in heavily engaged units",{"className":"moment","children":[["$","$L18",null,{"seconds":1364,"label":"22:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Losses were concentrated in heavily engaged units"}],["$","p",null,{"children":"The episode gives totals of about 1,900 U.S. and 2,500 Confederate casualties. Featherston's brigade lost about 615 men, and the 31st Mississippi reported 164 casualties among 215 men engaged."}]]}]]}]
