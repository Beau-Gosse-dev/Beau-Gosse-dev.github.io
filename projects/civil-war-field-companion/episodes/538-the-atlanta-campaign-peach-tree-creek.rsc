12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Bate and Walker failed to turn the U.S. left",{"className":"moment","children":[["$","$L18",null,{"seconds":240,"label":"4:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bate and Walker failed to turn the U.S. left"}],["$","p",null,{"children":"The episode begins by reviewing the earlier attacks. Bate's division missed the U.S. line, and Walker's division was stopped by John Newton's prepared position."}]]}]]}],["$","div","Maney's division stopped short of the U.S. center",{"className":"moment","children":[["$","$L18",null,{"seconds":316,"label":"5:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Maney's division stopped short of the U.S. center"}],["$","p",null,{"children":"George Maney's four Tennessee brigades advanced into thick woods, halted, and sent skirmishers forward. They did not make the major attack that Hood's plan required."}]]}]]}],["$","div","Featherston and Scott advanced toward Tanyard Creek",{"className":"moment","children":[["$","$L18",null,{"seconds":447,"label":"7:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Featherston and Scott advanced toward Tanyard Creek"}],["$","p",null,{"children":"Two brigades from William Loring's division moved through woods and broken ground, crossed an open field divided by Tanyard Creek, and attacked William Ward's XX Corps division."}]]}]]}],["$","div","Ward's brigade commanders moved to the ridge",{"className":"moment","children":[["$","$L18",null,{"seconds":632,"label":"10:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ward's brigade commanders moved to the ridge"}],["$","p",null,{"children":"John Coburn and Benjamin Harrison recognized that Ward had left the high ground ahead unoccupied. When the Confederate attack began, Harrison advanced his brigade and Coburn and James Wood also moved their brigades forward."}]]}]]}],["$","div","The U.S. center stopped the Confederate attack",{"className":"moment","children":[["$","$L18",null,{"seconds":690,"label":"11:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. center stopped the Confederate attack"}],["$","p",null,{"children":"Harrison, Coburn, and Wood closed the gap between Newton and Geary. Their brigades took the ridge and forced Featherston's and Scott's troops back toward the woods."}]]}]]}],["$","div","Walthall's brigades attacked the U.S. right",{"className":"moment","children":[["$","$L18",null,{"seconds":865,"label":"14:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Walthall's brigades attacked the U.S. right"}],["$","p",null,{"children":"Daniel Reynolds's and Edward O'Neal's brigades attacked parts of Alpheus Williams's and John Geary's divisions near Howell Mill Road. The defenders had warning because the battle had already moved across the line from east to west."}]]}]]}],["$","div","The 27th Indiana reinforced Knipe",{"className":"moment","children":[["$","$L18",null,{"seconds":951,"label":"15:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 27th Indiana reinforced Knipe"}],["$","p",null,{"children":"Joseph Knipe called for support after Reynolds threatened his right flank. The 27th Indiana moved across an open field and fired from the edge of a gully, helping hold the line."}]]}]]}],["$","div","Geary and Williams held the U.S. right",{"className":"moment","children":[["$","$L18",null,{"seconds":1206,"label":"20:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Geary and Williams held the U.S. right"}],["$","p",null,{"children":"The Confederate brigades failed to break either division. Geary's and Williams's commands suffered much of the U.S. loss but retained their positions."}]]}]]}],["$","div","Firing ended after about three hours",{"className":"moment","children":[["$","$L18",null,{"seconds":1284,"label":"21:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Firing ended after about three hours"}],"$L19"]}]]}],"$L1a"]}]]}]
