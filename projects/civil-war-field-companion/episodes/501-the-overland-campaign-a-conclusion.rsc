f:["$","figure","The campaign corridor today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-78.10%2C36.90%2C-76.65%2C38.55&layer=mapnik&marker=37.5407%2C-77.4360","title":"The campaign corridor today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The campaign corridor today"}],["$","span",null,{"children":"The fighting moved southeast from the Rapidan crossings through Spotsylvania and Cold Harbor. Grant then moved around Richmond, crossed the James, and attacked Petersburg from the east."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
