12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The U.S. assault began on June 27",{"className":"moment","children":[["$","$L18",null,{"seconds":77,"label":"1:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. assault began on June 27"}],["$","p",null,{"children":"Federal artillery opened on the Kennesaw line. Samuel G. French’s Confederate division held Little Kennesaw and Pigeon Hill."}]]}]]}],["$","div","McPherson assigned XV Corps the main northern attack",{"className":"moment","children":[["$","$L18",null,{"seconds":150,"label":"2:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson assigned XV Corps the main northern attack"}],["$","p",null,{"children":"Skirmishers pressed Big Kennesaw while John A. Logan’s corps attacked Little Kennesaw and Pigeon Hill."}]]}]]}],["$","div","Morgan L. Smith selected three brigades",{"className":"moment","children":[["$","$L18",null,{"seconds":178,"label":"2:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Morgan L. Smith selected three brigades"}],["$","p",null,{"children":"Charles C. Walcutt attacked on the left, Giles A. Smith in the center, and Joseph A. J. Lightburn south of Burnt Hickory Road."}]]}]]}],["$","div","The assault force numbered more than 5,500",{"className":"moment","children":[["$","$L18",null,{"seconds":266,"label":"4:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"The assault force numbered more than 5,500"}],["$","p",null,{"children":"The three brigades had marched several miles during the night to reach their starting positions."}]]}]]}],["$","div","Most soldiers learned the plan at 7 a.m.",{"className":"moment","children":[["$","$L18",null,{"seconds":354,"label":"5:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Most soldiers learned the plan at 7 a.m."}],["$","p",null,{"children":"Officers received their final instructions one hour before the assault. Giles Smith described his brigade’s assignment as a forlorn hope."}]]}]]}],["$","div","Walcutt attacked between the two heights",{"className":"moment","children":[["$","$L18",null,{"seconds":559,"label":"9:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Walcutt attacked between the two heights"}],["$","p",null,{"children":"The 46th Ohio led as skirmishers, followed by the 103rd Illinois and 6th Iowa, with three regiments behind them."}]]}]]}],["$","div","Confederate lines created a crossfire",{"className":"moment","children":[["$","$L18",null,{"seconds":601,"label":"10:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate lines created a crossfire"}],["$","p",null,{"children":"William W. Berry’s and Francis M. Cockrell’s brigades bent toward each other between Little Kennesaw and Pigeon Hill."}]]}]]}],["$","div","The 46th Ohio captured about 120 skirmishers",{"className":"moment","children":[["$","$L18",null,{"seconds":648,"label":"10:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 46th Ohio captured about 120 skirmishers"}],["$","p",null,{"children":"The regiment overran a Mississippi skirmish line and continued onto the southern slope of Little Kennesaw."}]]}]]}],["$","div","Dense vegetation broke up Walcutt’s formation",{"className":"moment","children":[["$","$L18",null,{"seconds":680,"label":"11:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Dense vegetation broke up Walcutt’s formation"}],["$","p",null,{"children":"The leading regiments pushed through tangled timber and undergrowth before Confederate fire stopped them on the slope."}]]}]]}],["$","div","Parts of the brigade came close to the works",{"className":"moment","children":[["$","$L18",null,{"seconds":718,"label":"11:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Parts of the brigade came close to the works"}],["$","p",null,{"ch