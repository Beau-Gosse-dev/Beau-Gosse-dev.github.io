11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Thomas identified Snake Creek Gap",{"className":"moment","children":[["$","$L16",null,{"seconds":139,"label":"2:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas identified Snake Creek Gap"}],["$","p",null,{"children":"A U.S. reconnaissance from Chattanooga found a possible route to turn the Dalton defenses and reach the Confederate railroad."}]]}]]}],["$","div","Grant placed Sherman in theater command",{"className":"moment","children":[["$","$L16",null,{"seconds":245,"label":"4:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant placed Sherman in theater command"}],["$","p",null,{"children":"Sherman took command of the Military Division of the Mississippi in March 1864 with Grant’s full confidence."}]]}]]}],["$","div","Sherman made supply the central planning problem",{"className":"moment","children":[["$","$L16",null,{"seconds":311,"label":"5:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman made supply the central planning problem"}],["$","p",null,{"children":"He used his prior experience as a supply officer to prepare the armies before the campaign began."}]]}]]}],["$","div","Four months of supplies were accumulated",{"className":"moment","children":[["$","$L16",null,{"seconds":357,"label":"5:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Four months of supplies were accumulated"}],["$","p",null,{"children":"In seven weeks, U.S. depots at Nashville and Chattanooga received enough material for the spring and summer."}]]}]]}],["$","div","The system supported 100,000 men and 35,000 animals",{"className":"moment","children":[["$","$L16",null,{"seconds":378,"label":"6:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The system supported 100,000 men and 35,000 animals"}],["$","