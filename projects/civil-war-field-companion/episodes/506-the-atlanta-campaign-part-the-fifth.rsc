17:["$","div",null,{"children":[["$","h3",null,{"children":"Sherman reserved railroad capacity for the army"}],["$","p",null,{"children":"He closed the lines south of Nashville to civilian traffic and stopped using military transport to supply nearby civilians."}]]}]
18:["$","div","Federal authorities seized arriving equipment",{"className":"moment","children":[["$","$L16",null,{"seconds":721,"label":"12:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal authorities seized arriving equipment"}],["$","p",null,{"children":"McCallum retained locomotives and freight cars reaching Nashville to increase daily traffic toward Chattanooga."}]]}]]}]
19:["$","div","Repair material and crews waited on special trains",{"className":"moment","children":[["$","$L16",null,{"seconds":744,"label":"12:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Repair material and crews waited on special trains"}],["$","p",null,{"children":"Rails, ties, bridge material, and construction teams were staged to respond quickly to damage."}]]}]]}]
1a:["$","div","U.S. troops guarded the railroad",{"className":"moment","children":[["$","$L16",null,{"seconds":778,"label":"12:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops guarded the railroad"}],["$","p",null,{"children":"An infantry division, other detachments, blockhouses, and 100-day regiments protected tracks and important bridges."}]]}]]}]
1b:["$","div","Repairs kept pace with the advance",{"className":"moment","children":[["$","$L16",null,{"seconds":819,"label":"13:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Repairs kept pace with the advance"}],["$","p",null,{"children":"Trains often reached newly occupied areas only one or two days after U.S. troops and construction crews."}]]}]]}]
1c:["$","div","The railroad also constrained Sherman",{"className":"moment","children":[["$","$L16",null,{"seconds":884,"label":"14:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The railroad also constrained Sherman"}],["$","p",null,{"children":"It was his only dependable supply line south of Chattanooga, so the armies could not move far from it for long."}]]}]]}]
1d:["$","div","Reduced wagon trains limited off-railroad operations",{"className":"moment","children":[["$","$L16",null,{"seconds":920,"label":"15:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Reduced wagon trains limited off-railroad operations"}],["$","p",null,{"children":"Sherman cut wagon numbers to increase marching speed but reduced the supplies the armies could carry away from the track."}]]}]]}]
1e:["$","div","North Georgia could not feed the armies",{"className":"moment","children":[["$","$L16",null,{"seconds":977,"label":"16:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"North Georgia could not feed the armies"}],["$","p",null,{"children":"Previous consumption, crop failures, sparse population, and Confederate removals left little food or forage available."}]]}]]}]
1f:["$","div","Johnston faced a smaller supply requirement",{"className":"moment","children":[["$","$L16",null,{"seconds":1114,"label":"18:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston faced a smaller supply requirement"}],["$","p",null,{"children":"About 45,000 men camped close to Dalton could draw directly from the Western and Atlantic."}]]}]]}]
20:["$","div","Confederate animals wintered farther south",{"className":"moment","children":[["$","$L16",null,{"seconds":1181,"label":"19:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate animals wintered farther south"}],["$","p",null,{"children":"About two-thirds of the cavalry mounts and half of the artillery horses moved toward forage along the Coosa and Etowah Rivers."}]]}]]}]
21:["$","div","River and rail links fed Dalton",{"className":"moment","children":[["$","$L16",null,{"seconds":1222,"label":"20:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"River and rail links fed Dalton"}],["$","p",null,{"children":"Steamboats carried Alabama supplies to Rome, while railroads connected Atlanta with agricultural and industrial regions farther south."}]]}]]}]
22:["$","div","Johnston forced improvements on the railroad",{"className":"moment","children":[["$","$L16",null,{"seconds":1286,"label":"21:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston forced improvements on the railroad"}],["$","p",null,{"children":"He warned Richmond and Governor Joseph E. Brown that shortages might compel him to abandon Dalton."}]]}]]}]
23:["$","div","The Confederate supply crisis eased",{"className":"moment","children":[["$","$L16",null,{"seconds":1348,"label":"22:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate supply crisis eased"}],["$","p",null,{"children":"By late January, additional locomotives, cars, and operational changes met the army’s daily requirements and allowed stockpiling."}]]}]]}]
