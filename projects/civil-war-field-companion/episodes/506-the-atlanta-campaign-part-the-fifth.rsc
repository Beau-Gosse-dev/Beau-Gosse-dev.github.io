13:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L1a",null,{"guide":{"date":"Winter 1863–spring 1864","place":"Nashville, Chattanooga, Dalton, and the Western and Atlantic Railroad","result":"Both armies established adequate railroad supply systems, but Sherman’s dependence on a single-track line limited how far his armies could operate away from it","facts":[{"label":"U.S. force to supply","value":"About 100,000 men"},{"label":"U.S. animals to supply","value":"About 35,000 horses and mules"},{"label":"Track rebuilt Nashville–Decatur","value":"102 miles"},{"label":"Bridges rebuilt","value":"182"},{"label":"Johnston’s force at Dalton","value":"About 45,000 men"}],"maps":[{"title":"Western and Atlantic Railroad from Chattanooga to Atlanta","caption":"This bird’s-eye map follows the single railroad that first supplied Johnston and then supplied Sherman as the U.S. armies advanced south.","source":"https://www.loc.gov/resource/g3921p.rr006140/","image":"/images/western-atlantic-birds-eye-map.jpg","alt":"Birds-eye map of the Western and Atlantic Railroad between Chattanooga and Atlanta"},{"title":"The Nashville–Chattanooga supply network today","caption":"Two railroad routes connected Nashville to Stevenson and Chattanooga. South of Chattanooga, the Western and Atlantic continued through Dalton and Resaca to Atlanta.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-88.0%2C33.5%2C-83.5%2C36.5&layer=mapnik&marker=35.045%2C-85.309"},{"title":"Western and Atlantic facilities at Atlanta","caption":"The state-owned railroad connected Atlanta with Johnston’s army at Dalton and later carried U.S. supplies south from Chattanooga.","source":"https://www.loc.gov/item/2005681131/","image":"/images/atlanta-railroad-depot.jpg","alt":"Western and Atlantic Railroad buildings and tracks at Atlanta in 1864"}],"moments":[{"time":"2:19","audioTime":139,"title":"Thomas identified Snake Creek Gap","detail":"A U.S. reconnaissance from Chattanooga found a possible route to turn the Dalton defenses and reach the Confederate railroad."},{"time":"4:05","audioTime":245,"title":"Grant placed Sherman in theater command","detail":"Sherman took command of the Military Division of the Mississippi in March 1864 with Grant’s full confidence."},{"time":"5:11","audioTime":311,"title":"Sherman made supply the central planning problem","detail":"He used his prior experience as a supply officer to prepare the armies before the campaign began."},{"time":"5:57","audioTime":357,"title":"Four months of supplies were accumulated","detail":"In seven weeks, U.S. depots at Nashville and Chattanooga received enough material for the spring and summer."},{"time":"6:18","audioTime":378,"title":"The system supported 100,000 men and 35,000 animals","detail":"Food, forage, clothing, shoes, medicine, ammunition, and other stores had to move from Nashville to the front."},{"time":"7:32","audioTime":452,"title":"Railroads replaced river transport south of Chattanooga","detail":"The Tennessee, Cumberland, Ohio, and Mississippi Rivers had supported earlier campaigns, but the advance into Georgia required rail supply."},{"time":"8:16","audioTime":496,"title":"Two routes connected Nashville and Chattanooga","detail":"One ran through Decatur and the other directly to Stevenson; both used the same final 30-mile segment through Bridgeport."},{"time":"9:40","audioTime":580,"title":"The Western and Atlantic served both armies","detail":"The Georgia-owned line ran from Chattanooga through northwest Georgia to Atlanta and carried supplies in opposite directions."},{"time":"10:19","audioTime":619,"title":"U.S. troops rebuilt the feeder railroads","detail":"Grenville Dodge supervised repair of 102 miles of track and 182 bridges between Nashville and Decatur."},{"time":"10:52","audioTime":652,"title":"Daniel McCallum directed military railroads","detail":"Adna Anderson managed transportation, while William W. Wright directed construction and repair."},{"time":"11:30","audioTime":690,"title":"Sherman reserved railroad capacity for the army","detail":"He closed the lines south of Nashville to civilian traffic and stopped using military transport to supply nearby civilians."},{"time":"12:01","audioTime":721,"title":"Federal authorities seized arriving equipment","detail":"McCallum retained locomotives and freight cars reaching Nashville to increase daily traffic toward Chattanooga."},{"time":"12:24","audioTime":744,"title":"Repair material and crews waited on special trains","detail":"Rails, ties, bridge material, and construction teams were staged to respond quickly to damage."},{"time":"12:58","audioTime":778,"title":"U.S. troops guarded the railroad","detail":"An infantry division, other detachments, blockhouses, and 100-day regiments protected tracks and important bridges."},{"time":"13:39","audioTime":819,"title":"Repairs kept pace with the advance","detail":"Trains often reached newly occupied areas only one or two days after U.S. troops and construction crews."},{"time":"14:44","audioTime":884,"title":"The railroad also constrained Sherman","detail":"It was his only dependable supply line south of Chattanooga, so the armies could not move far from it for long."},{"time":"15:20","audioTime":920,"title":"Reduced wagon trains limited off-railroad operations","detail":"Sherman cut wagon numbers to increase marching speed but reduced the supplies the armies could carry away from the track."},{"time":"16:17","audioTime":977,"title":"North Georgia could not feed the armies","detail":"Previous consumption, crop failures, sparse population, and Confederate removals left little food or forage available."},{"time":"18:34","audioTime":1114,"title":"Johnston faced a smaller supply requirement","detail":"About 45,000 men camped close to Dalton could draw directly from the Western and Atlantic."},{"time":"19:41","audioTime":1181,"title":"Confederate animals wintered farther south","detail":"About two-thirds of the cavalry mounts and half of the artillery horses moved toward forage along the Coosa and Etowah Rivers."},{"time":"20:22","audioTime":1222,"title":"River and rail links fed Dalton","detail":"Steamboats carried Alabama supplies to Rome, while railroads connected Atlanta with agricultural and industrial regions farther south."},{"time":"21:26","audioTime":1286,"title":"Johnston forced improvements on the railroad","detail":"He warned Richmond and Governor Joseph E. Brown that shortages might compel him to abandon Dalton."},{"time":"22:28","audioTime":1348,"title":"The Confederate supply crisis eased","detail":"By late January, additional locomotives, cars, and operational changes met the army’s daily requirements and allowed stockpiling."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Set supply priorities and restricted civilian railroad use"},{"commander":"Daniel C. McCallum","command":"Military railroads","subordinates":"Supervised the theater railroad system"},{"commander":"Adna Anderson","command":"Department of Transportation","subordinates":"Managed daily railroad operation"},{"commander":"William W. Wright","command":"Department of Construction","subordinates":"Directed repair of tracks, bridges, and roadbeds"},{"commander":"Grenville M. Dodge","command":"XVI Corps engineer and commander","subordinates":"Supervised major repairs before McCallum’s appointment"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Demanded adequate rail delivery from Atlanta to Dalton"},{"commander":"Joseph E. Brown","command":"Governor of Georgia","subordinates":"State administration of the Western and Atlantic Railroad"},{"commander":"Confederate War Department","command":"National logistics authority","subordinates":"Transferred cars and locomotives to the line"}]}],"people":[{"name":"William T. Sherman","role":"Prepared the U.S. supply system and tied his operations to the railroad","side":"United States"},{"name":"Daniel C. McCallum","role":"Directed military railroad operations in Sherman’s theater","side":"United States"},{"name":"Adna Anderson","role":"Managed the daily movement of trains supplying the armies","side":"United States"},{"name":"William W. Wright","role":"Directed railroad construction and rapid repairs","side":"United States"},{"name":"Joseph E. Johnston","role":"Improved delivery to Dalton and reduced local forage demands","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"Joseph E. Brown","role":"Changed operations of Georgia’s state-owned railroad after Johnston’s warning","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/western-atlantic-birds-eye-map.jpg","alt":"Birds-eye map of the Western and Atlantic Railroad","caption":"The single line from Chattanooga to Atlanta shaped the route and pace of the campaign.","source":"https://www.loc.gov/resource/g3921p.rr006140/"},{"image":"/images/atlanta-railroad-depot.jpg","alt":"Western and Atlantic Railroad buildings at Atlanta","caption":"Atlanta was the southern supply hub for the railroad before U.S. forces captured the line north of the city.","source":"https://www.loc.gov/item/2005681131/"},{"image":"/images/joseph-e-johnston.jpg","alt":"Portrait of Joseph E. Johnston","caption":"Johnston’s January warning produced more rolling stock and better deliveries to Dalton.","source":"https://www.loc.gov/item/2018666539/"}],"sources":[{"label":"Official Episode 506 page","url":"https://civilwarpodcast.org/2025/10/05/civil-war-podcast-episode-506/"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"U.S. Army logistics anthology","url":"https://history.army.mil/portals/143/Images/Publications/catalog/68-1.pdf"},{"label":"Library of Congress Western and Atlantic bird’s-eye map","url":"https://www.loc.gov/resource/g3921p.rr006140/"},{"label":"Library of Congress Western and Atlantic depot photograph","url":"https://www.loc.gov/item/2005681131/"}]}}]}]
