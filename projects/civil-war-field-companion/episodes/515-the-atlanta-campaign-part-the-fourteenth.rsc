13:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L1b",null,{"guide":{"date":"June 8–22, 1864","place":"Acworth, Kennesaw Mountain, and Kolb’s Farm, Georgia","result":"Johnston occupied the Kennesaw line; Polk was killed; Hood’s attack at Kolb’s Farm failed","facts":[{"label":"U.S. reinforcements","value":"About 9,000 men from the XVII Corps arrived June 8"},{"label":"Rail bridge restored","value":"Etowah River bridge completed June 11"},{"label":"Polk killed","value":"June 14 at Pine Mountain"},{"label":"Final Kennesaw line occupied","value":"Night of June 18–19"},{"label":"Kolb’s Farm losses","value":"About 1,000 Confederate and 300 U.S."}],"maps":[{"title":"Kennesaw lines and Kolb’s Farm","caption":"The National Park Service map shows Pine Mountain, Lost Mountain, the Kennesaw heights, the June 27 positions, and Hood’s earlier attack at Kolb’s Farm.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm","image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map of the Kennesaw Mountain campaign area"},{"title":"Confederate artillery positions","caption":"A wartime drawing of Pigeon Hill, Little Kennesaw, and Big Kennesaw after the army occupied the final line.","source":"https://www.loc.gov/item/2004660525/","image":"/images/kennesaw-battlefield-drawing.jpg","alt":"1864 drawing of Confederate artillery positions across Kennesaw Mountain"},{"title":"The wider campaign route","caption":"The campaign map shows Acworth, Marietta, the Western and Atlantic Railroad, and the Chattahoochee River approaches.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of the Atlanta campaign across northwestern Georgia"},{"title":"Kennesaw Mountain and Kolb’s Farm today","caption":"The Kennesaw heights stand northwest of Marietta; Kolb’s Farm lies southwest along Powder Springs Road.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.72%2C33.86%2C-84.48%2C34.08&layer=mapnik&marker=33.983%2C-84.579"}],"moments":[{"time":"1:19","audioTime":79,"title":"The U.S. armies rested near Acworth","detail":"After the Dallas operations, soldiers camped south of Allatoona while engineers repaired the Etowah River railroad bridge."},{"time":"2:58","audioTime":178,"title":"The railroad reopened on June 11","detail":"Supplies again moved down the Western and Atlantic Railroad without interruption."},{"time":"3:10","audioTime":190,"title":"XVII Corps reinforcements arrived","detail":"About 9,000 men in two divisions joined the Army of the Tennessee on June 8."},{"time":"4:26","audioTime":266,"title":"High ground dominated the approach to Marietta","detail":"Lost, Pine, Brush, and Kennesaw mountains overlooked the roads and railroad leading south."},{"time":"5:00","audioTime":300,"title":"Kennesaw formed a three-part ridge","detail":"Big Kennesaw, Little Kennesaw, and Pigeon Hill extended for about two miles, with Confederate signal stations, artillery, and trenches."},{"time":"6:24","audioTime":384,"title":"The railroad fixed Sherman’s route","detail":"A movement east would expose the rail line and Allatoona depot. Sherman used Sandtown Road for his southward advance."},{"time":"8:31","audioTime":511,"title":"U.S. forces advanced on June 10","detail":"Cavalry found a fortified Confederate line from the railroad southwest to Lost Mountain."},{"time":"9:08","audioTime":548,"title":"Pine Mountain projected ahead of Johnston’s line","detail":"William B. Bate’s division held the salient, linked by trenches to the main Confederate works."},{"time":"9:34","audioTime":574,"title":"Thomas threatened to isolate Bate","detail":"By June 12, the Army of the Cumberland moved east of Pine Mountain and threatened the connection with Kennesaw."},{"time":"10:05","audioTime":605,"title":"Three Confederate generals inspected Pine Mountain","detail":"Johnston, Hardee, and Leonidas Polk climbed the exposed summit on June 14."},{"time":"10:43","audioTime":643,"title":"Sherman ordered artillery fire","detail":"U.S. gunners fired at the group after Sherman saw officers and soldiers on the summit."},{"time":"11:00","audioTime":660,"title":"Leonidas Polk was killed","detail":"Johnston and Hardee took cover. An artillery projectile passed through Polk’s body and killed him."},{"time":"12:00","audioTime":720,"title":"Loring took temporary corps command","detail":"William W. Loring replaced Polk, and Bate withdrew from Pine Mountain that night."},{"time":"13:25","audioTime":805,"title":"Schofield forced another Confederate adjustment","detail":"On June 16, U.S. troops gained ground that exposed Hardee’s line to enfilading artillery fire."},{"time":"14:07","audioTime":847,"title":"Hardee withdrew behind Mud Creek","detail":"The movement forced the Confederates to abandon Lost Mountain and created the second Kennesaw line."},{"time":"14:52","audioTime":892,"title":"Thomas exposed the second line","detail":"On June 17, U.S. artillery positions could enfilade Hardee again. Johnston ordered engineers to finish a stronger line."},{"time":"15:37","audioTime":937,"title":"The army occupied the final Kennesaw line","detail":"During the night of June 18–19, Hardee held the left, Loring the mountain ridge, and Hood the right, with cavalry on both flanks."},{"time":"18:41","audioTime":1121,"title":"The U.S. right extended south","detail":"Hooker moved toward Powder Springs Road and Schofield moved from Lost Mountain toward Kolb’s Farm."},{"time":"19:24","audioTime":1164,"title":"Johnston shifted Hood to the left","detail":"On the night of June 21–22, Hood’s corps moved south to block Hooker and Schofield."},{"time":"20:06","audioTime":1206,"title":"U.S. prisoners identified Hood’s move","detail":"Captured men from Hood’s corps warned Hooker and Schofield, who halted and built fieldworks."},{"time":"21:29","audioTime":1289,"title":"Hood attacked at Kolb’s Farm","detail":"Hood interpreted the retreat of two U.S. reconnaissance regiments as an attack and sent two divisions forward."},{"time":"22:00","audioTime":1320,"title":"U.S. artillery and rough ground stopped the attack","detail":"The Confederate advance failed. Hood lost about 1,000 men; U.S. losses were about 300, mostly in the forward regiments."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed the advance from Acworth"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"U.S. left near Kennesaw"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"U.S. center; threatened Pine Mountain and Mud Creek"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"U.S. right near Kolb’s Farm"},{"commander":"Joseph Hooker","command":"XX Corps","subordinates":"Joined Schofield along Powder Springs Road"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Directed three successive Kennesaw positions"},{"commander":"Leonidas Polk, then William W. Loring","command":"Polk’s Corps","subordinates":"Held the center and Kennesaw ridge"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Held the Confederate left"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Shifted from right to left and attacked at Kolb’s Farm"},{"commander":"William H. Jackson and Joseph Wheeler","command":"Cavalry divisions","subordinates":"Covered the Confederate flanks"}]}],"people":[{"name":"Leonidas Polk","role":"Corps commander killed on Pine Mountain","side":"Confederacy"},{"name":"William W. Loring","role":"Assumed temporary command of Polk’s corps","side":"Confederacy"},{"name":"William T. Sherman","role":"Directed the U.S. advance and ordered the artillery fire at Pine Mountain","side":"United States"},{"name":"Joseph E. Johnston","role":"Adjusted the Confederate line as U.S. forces moved south","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"John B. Hood","role":"Moved to the Confederate left and ordered the failed attack at Kolb’s Farm","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"William B. Bate","role":"Commanded the division holding the Pine Mountain salient","side":"Confederacy"},{"name":"George H. Thomas","role":"Threatened successive Confederate positions with the Army of the Cumberland","side":"United States"}],"losses":[{"name":"Leonidas Polk","side":"Confederacy","role":"Lieutenant general and corps commander","outcome":"Killed by U.S. artillery on Pine Mountain on June 14, 1864"}],"gallery":[{"image":"/images/kennesaw-battlefield-drawing.jpg","alt":"Wartime drawing of Confederate artillery positions at Kennesaw Mountain","caption":"The Kennesaw heights anchored Johnston’s final line north of Marietta.","source":"https://www.loc.gov/item/2004660525/"},{"image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map of the Kennesaw campaign and Kolb’s Farm","caption":"The map places Pine Mountain, the final Kennesaw line, and Kolb’s Farm in the same operational area.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"}],"sources":[{"label":"Official Episode 515 page","url":"https://civilwarpodcast.org/2026/01/04/civil-war-podcast-episode-515/"},{"label":"National Park Service battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ga015"},{"label":"National Park Service troop movements map","url":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"label":"National Park Service Confederate order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/confederate-order-of-battle.htm"},{"label":"Library of Congress Kennesaw battlefield drawing","url":"https://www.loc.gov/item/2004660525/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"}]}}]}]
