[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"May 16–20, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Resaca, Adairsville, Kingston, Cassville, and the Etowah River, Georgia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Johnston’s attempted ambush at Cassville was abandoned, and the Army of Tennessee withdrew south of the Etowah"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"May 16–20, 1864","place":"Resaca, Adairsville, Kingston, Cassville, and the Etowah River, Georgia","result":"Johnston’s attempted ambush at Cassville was abandoned, and the Army of Tennessee withdrew south of the Etowah","facts":[{"label":"Distance from Resaca to Etowah","value":"About 35 miles direct; about 45 miles by railroad"},{"label":"Confederate peak strength","value":"About 75,000 at Cassville"},{"label":"Cassville withdrawal","value":"Began around midnight, May 19–20"},{"label":"U.S. crossing secured","value":"Woolley’s Bridge over the Etowah"}],"maps":[{"title":"Resaca to Cassville and the Etowah","caption":"The campaign map follows the Western and Atlantic Railroad through Calhoun, Adairsville, Kingston, Cass Station, and Cartersville.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of the Atlanta campaign between Resaca and the Etowah River"},{"title":"Cassville roads and river crossings today","caption":"The Confederate plan depended on separated U.S. columns using the Kingston and direct Cassville roads. Woolley’s Bridge lay on the Etowah south of the position.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-85.10%2C34.02%2C-84.70%2C34.35&layer=mapnik&marker=34.244%2C-84.852"},{"title":"Fieldworks in the Atlanta campaign","caption":"A wartime view of Confederate earthworks. Johnston expected Sherman to attack the ridge south of Cassville.","source":"https://www.loc.gov/item/2018670937/","image":"/images/atlanta-fortifications.jpg","alt":"Civil War field fortifications made from earth and timber"}],"moments":[{"time":"1:16","audioTime":76,"title":"The Confederates left Resaca","detail":"On May 16, Johnston crossed the Oostanaula River and continued south through more open farming country."},{"time":"2:18","audioTime":138,"title":"The railroad connected the next objectives","detail":"The Western and Atlantic ran through Calhoun, Adairsville, Kingston, Cass Station, and Cartersville before crossing the Etowah."},{"time":"3:02","audioTime":182,"title":"Johnston rejected a position near Calhoun","detail":"A creek split the proposed line and would have prevented the wings from supporting each other."},{"time":"4:02","audioTime":242,"title":"Adairsville was also unsuitable","detail":"Johnston found the valley too wide to defend even after Polk’s reinforcements arrived."},{"time":"6:04","audioTime":364,"title":"Johnston planned an ambush farther south","detail":"Hardee argued for a stand at Adairsville, but Johnston instead looked for a way to strike part of Sherman’s divided pursuit."},{"time":"7:19","audioTime":439,"title":"Sherman spread his armies across a wide front","detail":"Thomas followed the railroad, Hooker and Schofield crossed farther east, and McPherson crossed at Lay’s Ferry."},{"time":"8:38","audioTime":518,"title":"Wheeler delayed the pursuit","detail":"Confederate cavalry slowed Thomas and McPherson, while Hooker and Schofield delayed each other during their crossing."},{"time":"9:53","audioTime":593,"title":"U.S. troops occupied Rome","detail":"A XIV Corps division and cavalry moved down the right bank of the Oostanaula and entered Rome on May 18."},{"time":"11:42","audioTime":702,"title":"Johnston used two roads toward Cassville","detail":"Polk and Hood marched directly from Adairsville; Hardee and the wagon train moved through Kingston and then east."},{"time":"13:27","audioTime":807,"title":"Sherman divided his pursuit","detail":"McPherson and most of Thomas moved toward Kingston, while Hooker and Schofield took the direct Cassville road."},{"time":"14:52","audioTime":892,"title":"The Confederate army concentrated north of Cassville","detail":"Polk blocked the direct road, Hood formed to his right, and Hardee formed on the left. Reinforcements raised the army to about 75,000."},{"time":"17:35","audioTime":1055,"title":"Hood moved to attack on May 19","detail":"Accounts differ over who initiated the plan. Hood moved east of the direct road to strike the U.S. column’s flank."},{"time":"18:37","audioTime":1117,"title":"An unexpected U.S. force appeared on Hood’s right","detail":"U.S. troops moving on a country road encountered Hood. He halted, deployed skirmishers, and abandoned the planned attack."},{"time":"19:55","audioTime":1195,"title":"The threat to Hood was real","detail":"Later evidence confirmed U.S. troops were present and could have struck his flank or rear if he continued."},{"time":"20:49","audioTime":1249,"title":"Johnston formed a new ridge line","detail":"Hood held the right, Polk the center, and Hardee the left on high ground south of Cassville."},{"time":"21:25","audioTime":1285,"title":"U.S. artillery enfiladed part of Polk’s line","detail":"Batteries northeast of the ridge fired along an angled section of the Confederate position."},{"time":"22:07","audioTime":1327,"title":"Hood and Polk met Johnston","detail":"The generals agreed the artillery compromised the position, but their later accounts differed over whether they favored attack or retreat."},{"time":"23:14","audioTime":1394,"title":"Hardee opposed another withdrawal","detail":"He arrived after Johnston had decided to leave and objected to abandoning the ridge."},{"time":"24:03","audioTime":1443,"title":"McPherson secured Woolley’s Bridge","detail":"U.S. troops captured an Etowah crossing that could have placed them behind the Cassville position and cut Johnston off from Atlanta."},{"time":"24:56","audioTime":1496,"title":"The Confederate army withdrew at midnight","detail":"Small parties maintained campfires while the main force left Cassville and crossed south of the Etowah."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed the pursuit and concentration"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"IV Corps and most of XIV Corps along the railroad"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Crossed at Lay’s Ferry and secured Woolley’s Bridge"},{"commander":"Joseph Hooker and John M. Schofield","command":"XX Corps and Army of the Ohio","subordinates":"Advanced on the direct Cassville road"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Directed the retreat and Cassville plans"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Assigned the Confederate right and proposed flank attack"},{"commander":"Leonidas Polk","command":"Polk’s Corps","subordinates":"Held the center at Cassville"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Moved through Kingston and held the left"},{"commander":"Joseph Wheeler","command":"Cavalry Corps","subordinates":"Covered the withdrawal south"}]}],"people":[{"name":"Joseph E. Johnston","role":"Planned the Cassville ambush and ordered the withdrawal","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"John B. Hood","role":"Abandoned the planned attack after U.S. troops appeared on his flank","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"William J. Hardee","role":"Argued for a stand at Adairsville and opposed leaving Cassville","side":"Confederacy"},{"name":"Leonidas Polk","role":"Brought reinforcements and held the center at Cassville","side":"Confederacy"},{"name":"William T. Sherman","role":"Pursued on divided routes and ordered a battle north of the Etowah if possible","side":"United States"},{"name":"James B. McPherson","role":"Secured the Etowah crossing that threatened the Confederate rear","side":"United States"}],"losses":[],"gallery":[{"image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of the Atlanta campaign","caption":"The rail and road network shaped the pursuit from Resaca to Cassville.","source":"https://www.loc.gov/item/2008628278/"},{"image":"/images/atlanta-fortifications.jpg","alt":"Civil War earthwork fortifications","caption":"Johnston expected Sherman to attack the ridge south of Cassville.","source":"https://www.loc.gov/item/2018670937/"}],"sources":[{"label":"Official Episode 512 page","url":"https://civilwarpodcast.org/2025/11/23/civil-war-podcast-episode-512/"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"Library of Congress Atlanta fortifications photograph","url":"https://www.loc.gov/item/2018670937/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
