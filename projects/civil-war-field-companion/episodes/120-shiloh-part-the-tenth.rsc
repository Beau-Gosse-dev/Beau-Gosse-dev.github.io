1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",120," · ","April 6, 1862, about 1:30 p.m. through late afternoon"," · ","The eastern and central Shiloh battlefield: Stuart’s ravine, MacArthur’s position, Bell Field, the peach orchard, and the Hamburg–Savannah Road, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Tenth)"}],["$","span",null,{"className":"result-label","children":"Johnston concentrated Statham, Bowen, and Jackson against MacArthur and Hurlbut at about 1:30 p.m. Stuart’s isolated brigade withdrew through a ravine under fire, exposing MacArthur’s flank; MacArthur then retreated. Additional Confederate brigades attacked Prentiss while Johnston personally led Statham forward. Hurlbut abandoned the peach orchard but formed another line immediately north of it. Johnston died at about 2:30 p.m.; Beauregard assumed army command from the rear and Bragg took direct control along the Hamburg–Savannah Road. The United States line continued to hold temporarily, while renewed fighting also pushed Sherman toward another withdrawal on the west"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7089812205.mp3?updated=1695140687","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Stuart’s remaining force",{"children":[["$","span",null,{"children":"Stuart’s remaining force"}],["$","strong",null,{"children":"About 800 men, isolated and nearly out of ammunition"}],"$undefined"]}],["$","div","Stuart’s obstacle",{"children":[["$","span",null,{"children":"Stuart’s obstacle"}],["$","strong",null,{"children":"Ravine roughly 100 feet deep and 100 feet wide behind the line"}],"$undefined"]}],["$","div","Johnston’s fresh brigades",{"children":[["$","span",null,{"children":"Johnston’s fresh brigades"}],["$","strong",null,{"children":"Statham: six regiments; Bowen: four regiments"}],"$undefined"]}],["$","div","Attack began",{"children":[["$","span",null,{"children":"Attack began"}],["$","strong",null,{"children":"About 1:30 p.m."}],"$undefined"]}],["$","div","United States defenders",{"children":[["$","span",null,{"children":"United States defenders"}],["$","strong",null,{"children":"MacArthur’s three Illinois regiments plus Hurlbut’s two brigades"}],"$undefined"]}],["$","div","Peach orchard lost",{"children":[["$","span",null,{"children":"Peach orchard lost"}],["$","strong",null,{"children":"Mid-afternoon after a coordinated multi-brigade assault"}],"$undefined"]}],["$","div","Johnston died",{"children":[["$","span",null,{"children":"Johnston died"}],["$","strong",null,{"children":"About 2:30 p.m."}],"$undefined"]}],["$","div","Command succession",{"children":[["$","span",null,{"children":"Command succession"}],["$","strong",null,{"children":"P.G.T. Beauregard assumed command; Braxton Bragg directed the eastern fighting"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],"$Le","$Lf"]}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16"]}]]}]
