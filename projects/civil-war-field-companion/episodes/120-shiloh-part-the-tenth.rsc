d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",120," · ","April 6, 1862, about 1:30 p.m. through late afternoon"," · ","The eastern and central Shiloh battlefield: Stuart’s ravine, MacArthur’s position, Bell Field, the peach orchard, and the Hamburg–Savannah Road, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Tenth)"}],["$","span",null,{"className":"result-label","children":"Johnston concentrated Statham, Bowen, and Jackson against MacArthur and Hurlbut at about 1:30 p.m. Stuart’s isolated brigade withdrew through a ravine under fire, exposing MacArthur’s flank; MacArthur then retreated. Additional Confederate brigades attacked Prentiss while Johnston personally led Statham forward. Hurlbut abandoned the peach orchard but formed another line immediately north of it. Johnston died at about 2:30 p.m.; Beauregard assumed army command from the rear and Bragg took direct control along the Hamburg–Savannah Road. The United States line continued to hold temporarily, while renewed fighting also pushed Sherman toward another withdrawal on the west"}]]}],["$","a",null,{"className":"primary-butt