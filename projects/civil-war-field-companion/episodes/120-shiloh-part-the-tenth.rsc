ze","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-johnston-last-charge.svg","alt":"Map of the Confederate attack through Bell Field and Johnston’s fatal wounding","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The attack through Bell Field"}],["$","span",null,{"children":"Statham and Bowen advanced across Bell Field. Johnston personally moved Statham forward, Hurlbut left the peach orchard, and Johnston was fatally wounded after the position fell."}],["$","span",null,{"className":"map-actions","children":["$L17","$L18"]}],"$undefined"]}]]}],"$L19"]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The western and central fronts were temporarily stable",{"className":"moment","children":[["$","$L1a",null,{"seconds":286,"label":"4:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"The western and central fronts were temporarily stable"}],["$","p",null,{"children":"Sherman and McClernand paused near Jones Field, while Wallace and Prentiss had repulsed attacks at the Hornet’s Nest."}]]}]]}],["$","div","Stuart remained isolated on the far left",{"className":"moment","children":[["$","$L1a",null,{"seconds":395,"label":"6:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart remained isolated on the far left"}],["$","p",null,{"children":"About 800 men had no artillery, little ammunition, a deep ravine behind them, and no direct contact with MacArthur."}]]}]]}],["$","div","Johnston assembled fresh brigades",{"className":"moment","children":[["$","$L1a",null,{"seconds":497,"label":"8:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston assembled fresh brigades"}],["$","p",null,{"children":"Statham’s six regiments deployed west of the Hamburg–Savannah Road and Bowen’s four regiments east of it; Jackson was redirected to support Bowen."}]]}]]}],["$","div","The attack opened at about 1:30 p.m.",{"className":"moment","children":[["$","$L1a",null,{"seconds":595,"label":"9:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack opened at about 1:30 p.m."}],["$","p",null,{"children":"Bowen and Jackson advanced against MacArthur while Statham moved toward Hurlbut in the peach orchard."}]]}]]}],["$","div","Johnston moved Bowen forward",{"className":"moment","children":[["$","$L1a",null,{"seconds":628,"label":"10:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston moved Bowen forward"}],["$","p",null,{"children":"When Bowen stopped at a shallow ravine under heavy fire, Johnston rode along the line and urged the men to resume their advance."}]]}]]}],["$","div","Hurlbut and MacArthur ran low on ammunition",{"className":"moment","children":[["$","$L1a",null,{"seconds":756,"label":"12:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hurlbut and MacArthur ran low on ammunition"}],["$","p",null,{"children":"The 31st Illinois was ordered to stop firing and prepare to use bayonets; Stuart’s men were searching casualties for cartridges."}]]}]]}],["$","div","Stuart ordered a withdrawal",{"className":"moment","children":[["$","$L1a",null,{"seconds":795,"label":"13:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart ordered a withdrawal"}],["$","p",null,{"children":"Confederates fired down the ravine and from its rim, turning the attempted orderly movement into a rout."}]]}]]}],["$","div","MacArthur’s flank was exposed",{"className":"moment","children":[["$","$L1a",null,{"seconds":856,"label":"14:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"MacArthur’s flank was exposed"}],["$","p",null,{"children":"Jackson struck the 50th Illinois from the side while Bowen pressed from the front. The 50th, 9th, and 12th Illinois withdrew in succession."}]]}]]}],["$","div","Hurlbut shifted troops toward his open left",{"className":"moment","children":[["$","$L1a",null,{"seconds":891,"label":"14:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hurlbut shifted troops toward his open left"}],["$","p",null,{"children":"With Stuart and MacArthur gone, Hurlbut reinforced the threatened end of his line and continued defending the peach orchard."}]]}]]}],["$","div","More Confederate brigades entered the attack",{"className":"moment","children":[["$","$L1a",null,{"seconds":922,"label":"15:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"More Confederate brigades entered the attack"}],["$","p",null,{"children":"Zachariah Deas led Gladden’s former brigade and George Maney led Stephens’s former brigade against Prentiss."}]]}]]}],["$","div","The 45th Tennessee refused another advance",{"className":"moment","children":[["$","$L1a",null,{"seconds":972,"label":"16:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 45th Tennessee refused another advance"}],"$L1b"]}]]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]]}]
