1b:["$","p",null,{"children":"The regiment had been stopped by the 41st Illinois. Breckinridge and Tennessee governor Isham Harris could not immediately get it moving."}]
1c:["$","div","Johnston personally led Statham forward",{"className":"moment","children":[["$","$L1a",null,{"seconds":1056,"label":"17:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston personally led Statham forward"}],["$","p",null,{"children":"His intervention produced a coordinated multi-brigade attack that continued through heavy infantry and artillery fire."}]]}]]}]
