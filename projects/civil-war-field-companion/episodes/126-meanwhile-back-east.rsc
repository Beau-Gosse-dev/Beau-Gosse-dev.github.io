1c:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Washington, Richmond, and the eastern seat of war"}],["$","span",null,{"children":"Jacob Monk’s 1861 map shows eastern Virginia, Maryland, the approaches to Washington, and the routes toward Richmond. It provides the strategic frame for McClellan’s assignment to defend the capital and prepare an advance against the Confederate capital."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep126-eastern-seat-of-war-1861.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$16:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448479/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$16:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
1e:["$","div","The Army of the Potomac took shape",{"className":"moment","children":[["$","$L1d",null,{"seconds":666,"label":"11:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Potomac took shape"}],["$","p",null,{"children":"Three-month units were replaced by longer-service volunteers, and the growing force received the name by which it would fight through the rest of the war."}]]}]]}]
1f:["$","div","Regiments became brigades and divisions",{"className":"moment","children":[["$","$L1d",null,{"seconds":756,"label":"12:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Regiments became brigades and divisions"}],["$","p",null,{"children":"Training advanced from company and regimental drill to coordinated brigade and division maneuvers, supported by cavalry and artillery."}]]}]]}]
20:["$","div","Officer quality remained uneven",{"className":"moment","children":[["$","$L1d",null,{"seconds":812,"label":"13:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Officer quality remained uneven"}],["$","p",null,{"children":"Many volunteer officers owed their commissions to state politics or election by their soldiers. Examination boards removed or induced the resignation of officers judged unfit."}]]}]]}]
21:["$","div","McClellan cultivated the rank and file",{"className":"moment","children":[["$","$L1d",null,{"seconds":873,"label":"14:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan cultivated the rank and file"}],["$","p",null,{"children":"Long inspections placed the commanding general before the soldiers and helped create the personal loyalty associated with “Little Mac.”"}]]}]]}]
22:["$","div","The grand reviews displayed the new army",{"className":"moment","children":[["$","$L1d",null,{"seconds":1032,"label":"17:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"The grand reviews displayed the new army"}],["$","p",null,{"children":"The episode culminates this theme with the mass review at Bailey’s Crossroads, where disciplined formations demonstrated the army’s growth to soldiers, officials, and spectators."}]]}]]}]
23:["$","div","Scott remained McClellan’s superior",{"className":"moment","children":[["$","$L1d",null,{"seconds":1154,"label":"19:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Scott remained McClellan’s superior"}],["$","p",null,{"children":"General-in-Chief Winfield Scott disputed McClellan’s threat estimates and objected to the younger general’s efforts to bypass the established chain of command."}]]}]]}]
24:["$","div","Pinkerton reinforced the inflated estimates",{"className":"moment","children":[["$","$L1d",null,{"seconds":1186,"label":"19:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pinkerton reinforced the inflated estimates"}],["$","p",null,{"children":"Allan Pinkerton’s intelligence organization gathered useful information but produced Confederate strength estimates far above the force actually available in northern Virginia."}]]}]]}]
25:["$","div","McClellan proposed a war-winning concentration",{"className":"moment","children":[["$","$L1d",null,{"seconds":1319,"label":"21:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan proposed a war-winning concentration"}],["$","p",null,{"children":"His August strategic memorandum asked for a main army of 273,000 men, supported by naval operations and subsidiary forces, to overwhelm organized Confederate resistance."}]]}]]}]
26:["$","div","McClellan resisted pressure to advance",{"className":"moment","children":[["$","$L1d",null,{"seconds":1369,"label":"22:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan resisted pressure to advance"}],["$","p",null,{"children":"On October 10 he asked Lincoln not to hurry him. The exchange closed the episode with the tension between thorough preparation and the administration’s need for action."}]]}]]}]
27:["$","p",null,{"children":"Reorganized the forces around Washington into the Army of the Potomac and delayed an offensive while seeking a much larger force"}]
28:["$","article","Abraham Lincoln",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/abraham-lincoln-1864.jpg","alt":"Portrait of Abraham Lincoln","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Abraham Lincoln"}],["$","p",null,{"children":"Called McClellan to Washington, approved his command, and balanced military preparation against political pressure for action"}]]}]]}]
29:["$","article","Winfield Scott",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep126-winfield-scott-portrait.jpg","alt":"Portrait of Winfield Scott","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Winfield Scott"}],["$","p",null,{"children":"Served as general-in-chief, challenged McClellan’s enemy estimates, and remained his immediate superior during the episode’s main period"}]]}]]}]
2a:["$","article","Randolph B. Marcy",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"RB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Randolph B. Marcy"}],["$","p",null,{"children":"Served as McClellan’s chief of staff and coordinated the expanding headquarters"}]]}]]}]
2b:["$","article","Allan Pinkerton",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep126-allan-pinkerton-portrait.jpg","alt":"Portrait of Allan Pinkerton","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Allan Pinkerton"}],["$","p",null,{"children":"Directed McClellan’s intelligence service and produced exaggerated estimates of Confederate strength"}]]}]]}]
2c:["$","article","John G. Barnard",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JG"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John G. Barnard"}],["$","p",null,{"children":"Chief engineer responsible for the fortifications protecting Washington"}]]}]]}]
2d:["$","article","Joseph E. Johnston",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/joseph-e-johnston.jpg","alt":"Portrait of Joseph E. Johnston","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Joseph E. Johnston"}],["$","p",null,{"children":"Commanded the Confederate force facing Washington and later was wounded at Fair Oaks in the episode’s 1862 prologue"}]]}]]}]
