10:["$","div","Chief of staff",{"children":[["$","span",null,{"children":"Chief of staff"}],["$","strong",null,{"children":"Colonel Randolph B. Marcy"}],["$","small",null,{"children":"Marcy was McClellan’s father-in-law; the formal staff post was unusual in the U.S. Army at the time."}]]}]
11:["$","div","Recruiting surge",{"children":[["$","span",null,{"children":"Recruiting surge"}],["$","strong",null,{"children":"About 10,000 new troops reached Washington each week in August and September"}],["$","small",null,{"children":"Episode figure; many enlisted for three years after the expiration of the three-month regiments."}]]}]
12:["$","div","Intelligence failure",{"children":[["$","span",null,{"children":"Intelligence failure"}],["$","strong",null,{"children":"Pinkerton reported at least 150,000 Confederates in early October"}],["$","small",null,{"children":"The episode states that the estimate exceeded the actual force by more than three times."}]]}]
13:["$","div","Proposed main army",{"children":[["$","span",null,{"children":"Proposed main army"}],["$","strong",null,{"children":"273,000 soldiers and 600 field guns"}],["$","small",null,{"children":"McClellan’s August 1861 strategic memorandum proposed 250 infantry regiments, 100 batteries, 28 cavalry regiments, and five engineer regiments."}]]}]
14:["$","div","Bailey’s Crossroads grand review",{"children":[["$","span",null,{"children":"Bailey’s Crossroads grand review"}],["$","strong",null,{"children":"November 20, 1861"}],["$","small",null,{"children":"The Library of Congress identifies a published caption describing 70,000 Army of the Potomac troops."}]]}]
