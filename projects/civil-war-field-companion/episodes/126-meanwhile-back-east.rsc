1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",126," · ","July 26–October 10, 1861, with a November 20 army review and an August 1862 framing prologue"," · ","Washington, D.C.; the Potomac defenses in Maryland and Virginia; Fairfax Court House, Centreville, and Bailey’s Crossroads, Virginia"]}],["$","h1",null,{"children":"\"MEANWHILE, BACK EAST...\""}],["$","span",null,{"className":"result-label","children":"George B. McClellan took command of the disorganized United States forces around Washington after First Bull Run and turned them into the Army of the Potomac. He restored discipline, expanded the army, organized brigades and divisions, developed a large staff, and strengthened the capital’s fortifications. The work made Washington more secure and won McClellan intense loyalty from many soldiers, but his inflated estimates of Confederate strength and conflict with General-in-Chief Winfield Scott encouraged delay. By October, McClellan had proposed an army of 273,000 for a broad offensive and resisted pressure for an immediate advance. The episode’s opening looks ahead to the failed Peninsula Campaign and the August 3, 1862 order to withdraw his army from Harrison’s Landing"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4057069473.mp3?updated=1695211731","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","McClellan arrived in Washington",{"children":[["$","span",null,{"children":"McClellan arrived in Washington"}],["$","strong",null,{"children":"July 26, 1861"}],["$","small",null,{"children":"He assumed command of the Military Division of the Potomac the next day."}]]}],["$","div","Age on arrival",{"children":[["$","span",null,{"children":"Age on arrival"}],["$","strong",null,{"children":"34"}],"$undefined"]}],["$","div","Immediate mission",{"children":[["$","span",null,{"children":"Immediate mission"}],["$","strong",null,{"children":"Defend Washington, reorganize the defeated troops, and prepare an army to operate against Richmond"}],"$undefined"]}],["$","div","New field army",{"children":[["$","span",null,{"children":"New field army"}],["$","strong",null,{"children":"Army of the Potomac"}],["$","small",null,{"children":"McClellan redesignated the force in August 1861."}]]}],["$","div","Washington defenses by the end of 1861",{"children":[["$","span",null,{"children":"Washington defenses by the end of 1861"}],["$","strong",null,{"children":"48 major forts"}],["$","small",null,{"children":"NPS also records supporting batteries, rifle pits, and military roads around the capital."}]]}],["$","div","Episode’s August force comparison",{"children":[["$","span",null,{"children":"Episode’s August force comparison"}],["$","strong",null,{"children":"Nearly 70,000 United States troops around Washington; fewer than 40,000 Confederates available to Joseph E. Johnston"}],"$undefined"]}],["$","div","McClellan’s staff",{"children":["$Le","$Lf","$undefined"]}],"$L10","$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18",false,"$L19","$L1a","$L1b"]}]]}]
