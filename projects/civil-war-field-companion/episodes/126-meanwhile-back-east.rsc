16:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","United States and Confederate positions, September 1861",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep126-union-confederate-positions-september-1861.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open United States and Confederate positions, September 1861 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep126-union-confederate-positions-september-1861.jpg","alt":"Historical map showing United States and Confederate positions around Washington and Fairfax County in September 1861","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"United States and Confederate positions, September 1861"}],["$","span",null,{"children":"Robert Knox Sneden’s map places the United States line west of Washington and Alexandria opposite Confederate positions in Fairfax County. It shows the narrow operational space in which McClellan feared a direct attack on the capital."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep126-union-confederate-positions-september-1861.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/gvhs01.vhs00064/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$16:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The fortified capital",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep126-washington-defenses-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The fortified capital at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep126-washington-defenses-map.jpg","alt":"Topographical map of Washington and vicinity showing Union forts and defenses built from 1861 to 1863","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The fortified capital"}],["$","span",null,{"children":"This wartime map shows the forts, roads, waterways, and approaches around Washington. The system expanded from the 48 major forts recorded by the end of 1861 to a still larger defensive ring later in the war."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep126-washington-defenses-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$16:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/gvhs01.vhs00240/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$16:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Washington, Richmond, and the eastern seat of war",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep126-eastern-seat-of-war-1861.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Washington, Richmond, and the eastern seat of war at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep126-eastern-seat-of-war-1861.jpg","alt":"1861 map of the eastern seat of war showing Washington, Richmond, roads, railroads, waterways, and military posts","width":1600,"height":1200,"loading":"lazy"}]}]}],"$L1c"]}]]}]]}]
17:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode opens at Harrison’s Landing",{"className":"moment","children":[["$","$L1d",null,{"seconds":32,"label":"0:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode opens at Harrison’s Landing"}],["$","p",null,{"children":"In early August 1862, the Army of the Potomac remained on the James River after the Seven Days Battles. This prologue shows where the story of McClellan’s rise will end."}]]}]]}],["$","div","Washington ordered the Peninsula evacuation",{"className":"moment","children":[["$","$L1d",null,{"seconds":64,"label":"1:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Washington ordered the Peninsula evacuation"}],["$","p",null,{"children":"On August 3, 1862, McClellan received the order to withdraw the Army of the Potomac from the Peninsula and join the force being assembled in northern Virginia."}]]}]]}],["$","div","Johnston’s wounding opened the way for Lee",{"className":"moment","children":[["$","$L1d",null,{"seconds":113,"label":"1:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston’s wounding opened the way for Lee"}],["$","p",null,{"children":"Joseph E. Johnston was seriously wounded at Fair Oaks on May 31, 1862. Robert E. Lee then took command of the Confederate army defending Richmond."}]]}]]}],["$","div","The narrative returns to July 1861",{"className":"moment","children":[["$","$L1d",null,{"seconds":259,"label":"4:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The narrative returns to July 1861"}],["$","p",null,{"children":"The main story begins five days after First Bull Run, when the United States needed to rebuild its field force and secure Washington."}]]}]]}],["$","div","McClellan arrived in Washington",{"className":"moment","children":[["$","$L1d",null,{"seconds":267,"label":"4:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan arrived in Washington"}],["$","p",null,{"children":"McClellan reached the capital on July 26 and assumed command of the troops in and around Washington on July 27."}]]}]]}],["$","div","Lincoln gave McClellan his assignment",{"className":"moment","children":[["$","$L1d",null,{"seconds":332,"label":"5:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln gave McClellan his assignment"}],["$","p",null,{"children":"McClellan was to defend the capital, impose order on the defeated regiments, and create an army capable of operating against Richmond."}]]}]]}],["$","div","Reorganization and training began",{"className":"moment","children":[["$","$L1d",null,{"seconds":450,"label":"7:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Reorganization and training began"}],["$","p",null,{"children":"McClellan concentrated on administration, discipline, supply, drill, and the formation of a field army rather than an immediate return to combat."}]]}]]}],["$","div","Marcy became chief of staff",{"className":"moment","children":[["$","$L1d",null,{"seconds":470,"label":"7:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Marcy became chief of staff"}],["$","p",null,{"children":"McClellan used a large headquarters staff and appointed his father-in-law, Randolph B. Marcy, to coordinate it as chief of staff."}]]}]]}],["$","div","Washington’s fortification accelerated",{"className":"moment","children":[["$","$L1d",null,{"seconds":488,"label":"8:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Washington’s fortification accelerated"}],["$","p",null,{"children":"McClellan endorsed and expanded the construction program that placed forts, batteries, rifle pits, and military roads around the capital."}]]}]]}],["$","div","McClellan exaggerated the threat",{"className":"moment","children":[["$","$L1d",null,{"seconds":545,"label":"9:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan exaggerated the threat"}],["$","p",null,{"children":"He repeatedly estimated that Johnston greatly outnumbered him even as the United States force around Washington expanded faster than the Confederate army."}]]}]]}],"$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}]]}]
18:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","President and commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander in chief"}],["$","span",null,{"children":"Abraham Lincoln"}],["$","small",null,{"children":"Set national policy, approved McClellan’s appointment, and pressed the army toward an eventual offensive"}]]}],["$","div","General-in-chief, U.S. Army",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief, U.S. Army"}],["$","span",null,{"children":"Winfield Scott"}],["$","small",null,{"children":"McClellan’s immediate military superior until Scott retired on November 1, 1861"}]]}],["$","div","Military Division of the Potomac; Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Military Division of the Potomac; Army of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Directed the troops around Washington, their field organization, training, and preparation for operations in Virginia"}]]}],["$","div","Chief of staff",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief of staff"}],["$","span",null,{"children":"Randolph B. Marcy"}],["$","small",null,{"children":"Coordinated McClellan’s headquarters staff and the administrative work of the growing army"}]]}],["$","div","Chief engineer, defenses of Washington",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief engineer, defenses of Washington"}],["$","span",null,{"children":"John G. Barnard"}],["$","small",null,{"children":"Supervised the expanding fortification system on both sides of the Potomac"}]]}],["$","div","Civilian intelligence chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Civilian intelligence chief"}],["$","span",null,{"children":"Allan Pinkerton"}],["$","small",null,{"children":"Ran McClellan’s secret-service operation and supplied estimates of Confederate strength"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","President and commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander in chief"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Exercised national authority over the Confederate armies defending northern Virginia and Richmond"}]]}],["$","div","Senior Confederate commander in northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior Confederate commander in northern Virginia"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"Concentrated the combined force after First Manassas and held the Centreville–Manassas line opposite McClellan"}]]}],["$","div","Confederate forces near Manassas and Centreville",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate forces near Manassas and Centreville"}],["$","span",null,{"children":"P.G.T. Beauregard"}],["$","small",null,{"children":"Continued to direct a major part of the northern Virginia force under Johnston’s senior authority"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","George B. McClellan",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep126-george-mcclellan-portrait.jpg","alt":"Portrait of George B. McClellan","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George B. McClellan"}],"$L27"]}]]}],"$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e"]}]]}]
19:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep126-george-mcclellan-portrait.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep126-george-mcclellan-portrait.jpg","alt":"Major General George B. McClellan in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This 1861 portrait presents McClellan at the moment his western Virginia victories and organizational confidence made him the administration’s choice to rebuild the army at Washington."}]]}],["$","figure","/images/ep126-baileys-crossroads-review.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep126-baileys-crossroads-review.jpg","alt":"Panoramic drawing of McClellan reviewing Army of the Potomac troops near Bailey’s Crossroads in November 1861","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alfred Waud’s field drawing records the grand review near Bailey’s Crossroads. A published version identified 70,000 troops, a public display of the army McClellan had organized."}]]}],["$","figure","/images/ep126-winfield-scott-portrait.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep126-winfield-scott-portrait.jpg","alt":"Portrait of Lieutenant General Winfield Scott in military uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Scott remained general-in-chief while McClellan commanded the Army of the Potomac. Their disagreements over strategy, estimates, and authority damaged the command relationship."}]]}],["$","figure","/images/ep126-allan-pinkerton-portrait.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep126-allan-pinkerton-portrait.jpg","alt":"Head-and-shoulders portrait of Allan Pinkerton facing left","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Pinkerton organized intelligence collection for McClellan. His agents found useful information, but their method produced severe overestimates of Confederate manpower."}]]}]]}]]}]
