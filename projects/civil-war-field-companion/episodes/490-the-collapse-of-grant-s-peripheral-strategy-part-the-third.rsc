17:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
19:["$","div","The May 9 movement reached Swift Creek",{"className":"moment","children":[["$","$L18",null,{"seconds":690,"label":"11:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"The May 9 movement reached Swift Creek"}],["$","p",null,{"children":"Nine U.S. brigades advanced to within about two miles of Petersburg, skirmished across the creek, and damaged the Richmond and Petersburg Railroad without forcing a general battle."}]]}]]}]
1a:["$","div","Smith and Gillmore proposed a different operation",{"className":"moment","children":[["$","$L18",null,{"seconds":781,"label":"13:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith and Gillmore proposed a different operation"}],["$","p",null,{"children":"They recommended returning to Bermuda Hundred, bridging the Appomattox, and attacking Petersburg’s southern rail links. Sending the proposal in writing deepened Butler’s distrust of both commanders."}]]}]]}]
1b:["$","div","False reports redirected Butler toward Richmond",{"className":"moment","children":[["$","$L18",null,{"seconds":1030,"label":"17:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"False reports redirected Butler toward Richmond"}],["$","p",null,{"children":"War Department messages incorrectly said Lee was retreating and Grant was coming to join Butler. Butler canceled the renewed Petersburg operation and prepared to advance north."}]]}]]}]
1c:["$","div","The advance toward Richmond began May 12",{"className":"moment","children":[["$","$L18",null,{"seconds":1181,"label":"19:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The advance toward Richmond began May 12"}],["$","p",null,{"children":"Butler intended to demonstrate against the southern defenses and wait for Grant rather than storm Richmond. By then Confederate reinforcements had made a direct attack impractical."}]]}]]}]
1d:["$","div","Pickett initially had only 750 troops near Petersburg",{"className":"moment","children":[["$","$L18",null,{"seconds":1246,"label":"20:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pickett initially had only 750 troops near Petersburg"}],["$","p",null,{"children":"George Pickett reported the Union landing and tried to organize a defense while Confederate authorities resolved unclear departmental responsibilities."}]]}]]}]
1e:["$","div","Confederate strength increased rapidly",{"className":"moment","children":[["$","$L18",null,{"seconds":1343,"label":"22:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate strength increased rapidly"}],["$","p",null,{"children":"The available force grew from about 1,350 on May 7 to 7,500 on May 10. Robert Ransom also led a 5,000-man field force from the Richmond defenses."}]]}]]}]
1f:["$","div","Beauregard took command and planned a counterattack",{"className":"moment","children":[["$","$L18",null,{"seconds":1380,"label":"23:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Beauregard took command and planned a counterattack"}],["$","p",null,{"children":"He reached Petersburg on May 10 and judged that Butler could be pushed back into the Bermuda Hundred peninsula."}]]}]]}]
20:["$","div","Kautz disrupted Confederate reinforcement routes",{"className":"moment","children":[["$","$L18",null,{"seconds":1501,"label":"25:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kautz disrupted Confederate reinforcement routes"}],["$","p",null,{"children":"A 3,000-man U.S. cavalry raid burned two bridges on the Weldon and Petersburg Railroad, forcing troops from the Carolinas to march across a ten-mile break in the line."}]]}]]}]
21:["$","div","Butler captured the outer works on May 13",{"className":"moment","children":[["$","$L18",null,{"seconds":1584,"label":"26:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Butler captured the outer works on May 13"}],["$","p",null,{"children":"U.S. troops gained part of the exterior Drewry’s Bluff defenses, then stopped and consolidated instead of continuing against the main position."}]]}]]}]
22:["$","div","Beauregard had about 20,000 troops at Fort Darling",{"className":"moment","children":[["$","$L18",null,{"seconds":1655,"label":"27:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Beauregard had about 20,000 troops at Fort Darling"}],["$","p",null,{"children":"He believed this force could drive Butler back but asked for 15,000 troops from Lee to make the destruction of the Army of the James more likely."}]]}]]}]
23:["$","div","Davis rejected Beauregard’s request for Lee’s troops",{"className":"moment","children":[["$","$L18",null,{"seconds":1802,"label":"30:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis rejected Beauregard’s request for Lee’s troops"}],["$","p",null,{"children":"Braxton Bragg argued that Lee could not safely retreat sixty miles while Grant pursued him and that Beauregard already had enough troops to attack Butler."}]]}]]}]
24:["$","div","The Confederate plan used three converging forces",{"className":"moment","children":[["$","$L18",null,{"seconds":1858,"label":"30:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate plan used three converging forces"}],["$","p",null,{"children":"Ransom was to break the U.S. right and cut it off from the James; Hoke was to pin the rest of the line; W. H. C. Whiting was to advance north from Petersburg into the U.S. rear."}]]}]]}]
25:["$","div","Ransom attacked before sunrise on May 16",{"className":"moment","children":[["$","$L18",null,{"seconds":1886,"label":"31:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ransom attacked before sunrise on May 16"}],["$","p",null,{"children":"Fog concealed the approach and helped the initial breakthrough, but it also disorganized the attackers. Confederate troops captured prisoners and artillery without completing the flank movement."}]]}]]}]
26:["$","div","Hoke’s attack stalled and Whiting did not arrive",{"className":"moment","children":[["$","$L18",null,{"seconds":1915,"label":"31:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hoke’s attack stalled and Whiting did not arrive"}],["$","p",null,{"children":"Hoke gained some ground before meeting stronger resistance. Whiting allowed a small blocking force to stop his column south of the battlefield, so it never joined the main attack."}]]}]]}]
27:["$","div","Butler ordered Gillmore to attack the weakened Confederate right",{"className":"moment","children":[["$","$L18",null,{"seconds":1978,"label":"32:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Butler ordered Gillmore to attack the weakened Confederate right"}],["$","p",null,{"children":"The heaviest Confederate pressure fell on Smith’s XVIII Corps. Butler correctly concluded that fewer troops opposed X Corps, but Gillmore did not make the requested counterattack."}]]}]]}]
28:["$","div","Both U.S. corps withdrew about a mile",{"className":"moment","children":[["$","$L18",null,{"seconds":2020,"label":"33:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both U.S. corps withdrew about a mile"}],["$","p",null,{"children":"Smith ordered his formations back, Gillmore followed, and the Army of the James formed a new line by early afternoon. Disorganized Confederate units did not immediately pursue."}]]}]]}]
29:["$","div","Butler returned to Bermuda Hundred",{"className":"moment","children":[["$","$L18",null,{"seconds":2078,"label":"34:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Butler returned to Bermuda Hundred"}],["$","p",null,{"children":"With both corps commanders unwilling to renew the battle and reports of Whiting approaching from Petersburg, Butler ordered a general withdrawal at about 3 p.m."}]]}]]}]
2a:["$","div","The Confederate line contained Butler’s army",{"className":"moment","children":[["$","$L18",null,{"seconds":2133,"label":"35:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate line contained Butler’s army"}],["$","p",null,{"children":"Beauregard entrenched across the peninsula after the withdrawal. He then sent about 7,000 troops to reinforce Lee and promised additional men."}]]}]]}]
2b:["$","div","Grant’s five supporting operations had ended",{"className":"moment","children":[["$","$L18",null,{"seconds":2154,"label":"35:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant’s five supporting operations had ended"}],["$","p",null,{"children":"By May 18 the offensives led by Averell, Sigel, Butler, Crook, and Sheridan were no longer holding Confederate troops away from Lee."}]]}]]}]
2c:["$","div","Grant learned of the defeats during the Spotsylvania fighting",{"className":"moment","children":[["$","$L18",null,{"seconds":2181,"label":"36:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant learned of the defeats during the Spotsylvania fighting"}],["$","p",null,{"children":"A dispatch from Henry Halleck reported Sigel’s retreat and Butler’s withdrawal. Grant expected Lee to receive troops from Beauregard and the Shenandoah Valley."}]]}]]}]
2d:["$","div","Grant ordered another movement around Lee’s right",{"className":"moment","children":[["$","$L18",null,{"seconds":2256,"label":"37:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant ordered another movement around Lee’s right"}],["$","p",null,{"children":"He decided the Spotsylvania position offered no further advantage and directed the Army of the Potomac to begin moving toward the North Anna the next day."}]]}]]}]
