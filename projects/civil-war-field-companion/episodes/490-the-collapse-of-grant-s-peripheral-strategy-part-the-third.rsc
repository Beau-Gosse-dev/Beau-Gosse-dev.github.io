f:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Operations at Bermuda Hundred and Drewry’s Bluff"}],["$","span",null,{"children":"Robert Knox Sneden’s map identifies Fort Darling, the Richmond and Petersburg Railroad, the Bermuda Hundred base, and the opposing works. Butler advanced north from the peninsula before withdrawing to its fortified neck."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/drewrys-bluff-operations-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/gvhs01.vhs00178/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
10:["$","figure","The full Bermuda Hundred position",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/bermuda-hundred-entrenchments-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The full Bermuda Hundred position at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/bermuda-hundred-entrenchments-map.jpg","alt":"Detailed historical map of the Bermuda Hundred region and opposing entrenchments","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The full Bermuda Hundred position"}],["$","span",null,{"children":"This detailed survey shows Richmond at the top, Petersburg to the southwest, the James and Appomattox rivers, and the later U.S. and Confederate entrenchments. The colored lines show how the peninsula became a contained front after Butler withdrew."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/bermuda-hundred-entrenchments-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/2006626083/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
11:["$","figure","Drewry’s Bluff and Bermuda Hundred today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.58%2C37.20%2C-77.20%2C37.58&layer=mapnik&marker=37.4218%2C-77.4228","title":"Drewry’s Bluff and Bermuda Hundred today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Drewry’s Bluff and Bermuda Hundred today"}],["$","span",null,{"children":"Drewry’s Bluff stands above a bend in the James River north of Bermuda Hundred. The Richmond and Petersburg corridor runs west of the peninsula."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode returns to Grant’s peripheral strategy",{"className":"moment","children":[["$","$L18",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode returns to Grant’s peripheral strategy"}],["$","p",null,{"children":"Earlier operations had ended in defeat at New Market and the mortal wounding of J. E. B. Stuart at Yellow Tavern. Butler’s Army of the James still threatened Richmond from the south."}]]}]]}],["$","div","Butler had a large force close to Richmond",{"className":"moment","children":[["$","$L18",null,{"seconds":151,"label":"2:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Butler had a large force close to Richmond"}],["$","p",null,{"children":"Union control of the lower James allowed roughly 36,000 troops to land at Bermuda Hundred, within twenty miles of a lightly defended Confederate capital."}]]}]]}],["$","div","Richmond depended on rapid reinforcement",{"className":"moment","children":[["$","$L18",null,{"seconds":198,"label":"3:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richmond depended on rapid reinforcement"}],["$","p",null,{"children":"Jefferson Davis kept most available troops in field armies. The Department of Richmond had only a little more than 7,100 soldiers on April 20 and expected militia and outside troops to meet an emergency."}]]}]]}],["$","div","The James River gave the expedition direct access",{"className":"moment","children":[["$","$L18",null,{"seconds":257,"label":"4:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The James River gave the expedition direct access"}],["$","p",null,{"children":"The river was navigable from Hampton Roads to Richmond. Confederate defenses began where the channel narrowed above Bermuda Hundred."}]]}]]}],["$","div","Mines, Fort Darling, and warships protected the upper river",{"className":"moment","children":[["$","$L18",null,{"seconds":285,"label":"4:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mines, Fort Darling, and warships protected the upper river"}],["$","p",null,{"children":"Confederates placed electrically detonated mines in the bends, mounted heavy guns on the ninety-foot bluff at Fort Darling, and held naval forces farther upstream."}]]}]]}],["$","div","Grant expected professional corps commanders to advise Butler",{"className":"moment","children":[["$","$L18",null,{"seconds":392,"label":"6:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant expected professional corps commanders to advise Butler"}],["$","p",null,{"children":"William F. Smith commanded XVIII Corps and Quincy Gillmore commanded X Corps. Grant expected their combat experience to compensate for Butler’s limited field experience."}]]}]]}],["$","div","Bermuda Hundred placed three targets within reach",{"className":"moment","children":[["$","$L18",null,{"seconds":461,"label":"7:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bermuda Hundred placed three targets within reach"}],["$","p",null,{"children":"Richmond was about fifteen miles north, Petersburg eight miles south, and the Richmond and Petersburg Railroad less than five miles west."}]]}]]}],["$","div","Butler fortified his base first",{"className":"moment","children":[["$","$L18",null,{"seconds":522,"label":"8:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Butler fortified his base first"}],["$","p",null,{"children":"After landing on May 5, he spent May 6 strengthening the five-mile neck between the James and Appomattox rivers and then probed toward the railroad."}]]}]]}],["$","div","Grant’s orders emphasized Richmond but left the method open",{"className":"moment","children":[["$","$L18",null,{"seconds":593,"label":"9:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant’s orders emphasized Richmond but left the method open"}],["$","p",null,{"children":"Butler was told to secure ground along the south side of the James and treat Richmond as the objective. He worried that moving north would expose his base to troops arriving from the Carolinas."}]]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","General-in-chief",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Assigned Butler the Richmond operation and coordinated it with the Army of the Potomac’s campaign"}]]}],["$","div","Army of the James and Department of Virginia and North Carolina",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the James and Department of Virginia and North Carolina"}],["$","span",null,{"children":"Benjamin F. Butler"}],["$","small",null,{"children":"William F. Smith’s XVIII Corps and Quincy A. Gillmore’s X Corps"}]]}],["$","div","XVIII Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"XVIII Corps"}],["$","span",null,{"children":"William F. “Baldy” Smith"}],["$","small",null,{"children":"Held the U.S. right at Drewry’s Bluff and ordered it to withdraw"}]]}],["$","div","X Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"X Corps"}],["$","span",null,{"children":"Quincy A. Gillmore"}],["$","small",null,{"children":"Held the U.S. left and did not make Butler’s requested counterattack"}]]}],["$","div","Cavalry division",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry division"}],["$","span",null,{"children":"August V. Kautz"}],["$","small",null,{"children":"Raided the railroads south of Petersburg with about 3,000 cavalry"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Department of North Carolina and Southern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of North Carolina and Southern Virginia"}],["$","span",null,{"children":"P. G. T. Beauregard"}],["$","small",null,{"children":"Directed the May 16 counterattack and the containment of Bermuda Hundred"}]]}],["$","div","Confederate left wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate left wing"}],["$","span",null,{"children":"Robert Ransom Jr."}],["$","small",null,{"children":"Made the main dawn attack against the U.S. right"}]]}],["$","div","Confederate right wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate right wing"}],["$","span",null,{"children":"Robert F. Hoke"}],["$","small",null,{"children":"Pinned X Corps and supported Ransom’s attack"}]]}],["$","div","Petersburg force",{"className":"command-entry","children":[["$","strong",null,{"children":"Petersburg force"}],["$","span",null,{"children":"W. H. C. Whiting"}],["$","small",null,{"children":"Was ordered to attack north into the U.S. left rear but did not reach the battlefield"}]]}],["$","div","Petersburg district commander through May 10",{"className":"command-entry","children":[["$","strong",null,{"children":"Petersburg district commander through May 10"}],["$","span",null,{"children":"George E. Pickett"}],["$","small",null,{"children":"Raised the alarm and organized the first response to Butler’s landing"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Benjamin F. Butler",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"BF"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Benjamin F. Butler"}],["$","p",null,{"children":"Secured Bermuda Hundred, advanced toward Richmond, and ordered the withdrawal after Drewry’s Bluff"}]]}]]}],["$","article","William F. Smith",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WF"}]}],["$","div",null,{"children":["$L2e","$L2f","$L30"]}]]}],"$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38"]}]]}]
14:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","J. E. B. Stuart",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"J. E. B. Stuart"}],["$","p",null,{"children":[["$","strong",null,{"children":["Army of Northern Virginia cavalry commander","."]}]," ","Mortally wounded at Yellow Tavern on May 11 and died in Richmond on May 12; the episode identifies his death as one of the concurrent failures of Grant’s supporting operations"]}]]}]]}]]}]
15:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/drewrys-bluff-ruins.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/drewrys-bluff-ruins.jpg","alt":"Civil War-era photograph of fortification ruins at Drewry’s Bluff","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Fort Darling occupied high ground above the James River and formed the center of the Confederate position south of Richmond."}]]}],["$","figure","/images/drewrys-bluff-operations-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/drewrys-bluff-operations-map.jpg","alt":"Robert Knox Sneden map of Bermuda Hundred and Drewry’s Bluff","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The operation depended on roads and railroads running between the James and Appomattox rivers and the fortified approach to Richmond."}]]}],["$","figure","/images/bermuda-hundred-entrenchments-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/bermuda-hundred-entrenchments-map.jpg","alt":"Survey map of the Bermuda Hundred region","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The opposing entrenchments across the narrow peninsula allowed Confederate forces to contain Butler with fewer troops."}]]}]]}]]}]
