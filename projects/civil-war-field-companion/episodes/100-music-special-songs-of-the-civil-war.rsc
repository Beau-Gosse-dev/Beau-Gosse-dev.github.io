17:["$","p",null,{"children":"Patrick Gilmore published the song in 1863 under the name Louis Lambert. Its upbeat tune accompanied lyrics about a soldier’s return."}]
18:["$","div","Home Sweet Home remained a favorite on both sides",{"className":"moment","children":[["$","$L16",null,{"seconds":2587,"label":"43:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Home Sweet Home remained a favorite on both sides"}],["$","p",null,{"children":"The 1823 song expressed soldiers’ desire to return to their families and was repeatedly described as moving listeners in opposing camps."}]]}]]}]
19:["$","div","Tramp, Tramp, Tramp was written for prisoners",{"className":"moment","children":[["$","$L16",null,{"seconds":2894,"label":"48:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Tramp, Tramp, Tramp was written for prisoners"}],["$","p",null,{"children":"George Frederick Root wrote the song from the viewpoint of captured U.S. soldiers expecting release and a return home."}]]}]]}]
1a:["$","div","Religious music was central to camp life",{"className":"moment","children":[["$","$L16",null,{"seconds":3213,"label":"53:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Religious music was central to camp life"}],["$","p",null,{"children":"Soldiers sang hymns including “Amazing Grace” and “Nearer, My God, to Thee.” Chaplains and religious organizations distributed hymnals."}]]}]]}]
1b:["$","div","African American songs joined faith and freedom",{"className":"moment","children":[["$","$L16",null,{"seconds":3538,"label":"58:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"African American songs joined faith and freedom"}],["$","p",null,{"children":"The episode discusses spirituals as religious expression, coded communication, and statements about emancipation, including “Go Down, Moses.”"}]]}]]}]
