11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode surveys Civil War music",{"className":"moment","children":[["$","$L16",null,{"seconds":34,"label":"0:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode surveys Civil War music"}],["$","p",null,{"children":"The hosts present more than twenty wartime songs, explain their origins and uses, and play portions of modern performances."}]]}]]}],["$","div","Music reached the home front and the armies",{"className":"moment","children":[["$","$L16",null,{"seconds":202,"label":"3:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Music reached the home front and the armies"}],["$","p",null,{"children":"Songs were performed in parlors, at rallies, during drill, around campfires, and sometimes during battles."}]]}]]}],["$","div","Thousands of songs were published",{"className":"moment","children":[["$","$L16",null,{"seconds":277,"label":"4:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thousands of songs were published"}],["$","p",null,{"children":"Publishers issued an estimated 9,000 to 10,000 Civil War songs as sheet music, song books, newspaper lyrics, and pocket songsters."}]]}]]}],["$","div","Dixie became a Confederate anthem",{"className":"moment","children":[["$","$L16",null,{"seconds":467,"label":"7:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Dixie became a Confederate anthem"}],["$","p",null,{"children":"Ohio-born minstrel performer Daniel Decatur Emmett wrote “Dixie” in New York in 1859. Its use at Jefferson Davis’s 1861 inauguration helped make it the Confederacy’s unofficial anthem."}]]}]]}],["$","div","The Bonnie Blue Flag promoted secession",{"className":"moment","children":[["$","$L16",null,{"seconds":728,"label":"12:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Bonnie Blue Flag promoted secession"}],["$","p",null,{"children":"Harry McCarthy’s song became the Confederacy’s second most popular patriotic anthem and was performed for soldiers across the South."}]]}]]}],["$","div","Maryland, My Maryland anticipated a secession that did not happen",{"className":"moment","children":[["$","$L16",null,{"seconds":977,"label":"16:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Maryland, My Maryland anticipated a secession that did not happen"}],["$","p",null,{"children":"James Ryder Randall wrote the poem after the Baltimore Riot. It peaked during Lee’s 1862 Maryland Campaign, then declined when Maryland did not join the Confederacy."}]]}]]}],["$","div","Lorena crossed sectional lines",{"className":"moment","children":[["$","$L16",null,{"seconds":1242,"label":"20:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lorena crossed sectional lines"}],["$","p",null,{"children":"Henry DeLafayette Webster and Joseph Philbrick Webster published the sentimental song in 1857. It became especially popular among Confederate soldiers."}]]}]]}],["$","div","Camp songs covered cavalry and food",{"className":"moment","children":[["$","$L16",null,{"seconds":1445,"label":"24:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Camp songs covered cavalry and food"}],["$","p",null,{"children":"“Join the Cavalry” was associated with J. E. B. Stuart’s command. “Goober Peas,” “Short Rations,” and “Hard Crackers Come Again No More” described army food and shortages."}]]}]]}],["$","div","Sentimental songs addressed separation and death",{"className":"moment","children":[["$","$L16",null,{"seconds":1960,"label":"32:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sentimental songs addressed separation and death"}],["$","p",null,{"children":"The episode groups them as home, sweetheart, mother, and death songs, including “Weeping Sad and Lonely,” “Just Before the Battle, Mother,” and “All Quiet Along the Potomac Tonight.”"}]]}]]}],["$","div","When Johnny Comes Marching Home looked toward reunion",{"className":"moment","children":[["$","$L16",null,{"seconds":2477,"label":"41:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"When Johnny Comes Marching Home looked toward reunion"}],"$L17"]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]]}]
