d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",100," · ","1859–1865; first published as episode 100 in 2014"," · ","United States and Confederate States; army camps, battlefields, homes, churches, rallies, and music halls"]}],["$","h1",null,{"children":"MUSIC SPECIAL: Songs of the Civil War"}],["$","span",null,{"className":"result-label","children":"A guide to more than twenty songs heard during the Civil War. The episode explains how patriotic, sentimental, religious, minstrel, emancipation, marching, and camp songs shaped wartime politics and morale. It also identifies the composers and the events that changed how several songs were understood"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"1859–1865; first published as episode 100 in 2014"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"United States and Confederate States; army camps, battlefields, homes, churches, rallies, and music halls"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"A guide to more than twenty songs heard during the Civil War. The episode explains how patriotic, sentimental, religious, minstrel, emancipation, marching, and camp songs shaped wartime politics and morale. It also identifies the composers and the events that changed how several songs were understood"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"1859–1865; first published as episode 100 in 2014","place":"United States and Confederate States; army camps, battlefields, homes, churches, rallies, and music halls","result":"A guide to more than twenty songs heard during the Civil War. The episode explains how patriotic, sentimental, religious, minstrel, emancipation, marching, and camp songs shaped wartime politics and morale. It also identifies the composers and the events that changed how several songs were understood","facts":[{"label":"Sheet music published during the war","value":"An estimated 9,000–10,000 songs"},{"label":"Main genres","value":"Patriotic, sentimental, minstrel, and religious music"},{"label":"Confederate songs covered","value":"Dixie, The Bonnie Blue Flag, Maryland, My Maryland, Lorena, Join the Cavalry, Goober Peas, and Short Rations"},{"label":"Shared songs covered","value":"Weeping Sad and Lonely, Home Sweet Home, and Nearer, My God, to Thee"},{"label":"United States songs covered","value":"John Brown’s Body, Battle Hymn of the Republic, The Battle Cry of Freedom, We Are Coming Father Abraham, and Marching Through Georgia"},{"label":"Military signal covered","value":"Taps"}],"maps":[{"title":"Places connected to the featured songs","caption":"The episode moves between New York, where “Dixie” was first performed; Montgomery and New Orleans, where Confederate patriotic music spread; Baltimore and the 1862 Maryland Campaign; Chicago’s major music publishers; Virginia army camps; and Georgia during Sherman’s 1864 campaign.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-97.5%2C27.0%2C-70.0%2C44.5&layer=mapnik&marker=38.5%2C-84.0"}],"moments":[{"time":"0:34","audioTime":34,"title":"The episode surveys Civil War music","detail":"The hosts present more than twenty wartime songs, explain their origins and uses, and play portions of modern performances."},{"time":"3:22","audioTime":202,"title":"Music reached the home front and the armies","detail":"Songs were performed in parlors, at rallies, during drill, around campfires, and sometimes during battles."},{"time":"4:37","audioTime":277,"title":"Thousands of songs were published","detail":"Publishers issued an estimated 9,000 to 10,000 Civil War songs as sheet music, song books, newspaper lyrics, and pocket songsters."},{"time":"7:47","audioTime":467,"title":"Dixie became a Confederate anthem","detail":"Ohio-born minstrel performer Daniel Decatur Emmett wrote “Dixie” in New York in 1859. Its use at Jefferson Davis’s 1861 inauguration helped make it the Confederacy’s unofficial anthem."},{"time":"12:08","audioTime":728,"title":"The Bonnie Blue Flag promoted secession","detail":"Harry McCarthy’s song became the Confederacy’s second most popular patriotic anthem and was performed for soldiers across the South."},{"time":"16:17","audioTime":977,"title":"Maryland, My Maryland anticipated a secession that did not happen","detail":"James Ryder Randall wrote the poem after the Baltimore Riot. It peaked during Lee’s 1862 Maryland Campaign, then declined when Maryland did not join the Confederacy."},{"time":"20:42","audioTime":1242,"title":"Lorena crossed sectional lines","detail":"Henry DeLafayette Webster and Joseph Philbrick Webster published the sentimental song in 1857. It became especially popular among Confederate soldiers."},{"time":"24:05","audioTime":1445,"title":"Camp songs covered cavalry and food","detail":"“Join the Cavalry” was associated with J. E. B. Stuart’s command. “Goober Peas,” “Short Rations,” and “Hard Crackers Come Again No More” described army food and shortages."},{"time":"32:40","audioTime":1960,"title":"Sentimental songs addressed separation and death","detail":"The episode groups them as home, sweetheart, mother, and death songs, including “Weeping Sad and Lonely,” “Just Before the Battle, Mother,” and “All Quiet Along the Potomac Tonight.”"},{"time":"41:17","audioTime":2477,"title":"When Johnny Comes Marching Home looked toward reunion","detail":"Patrick Gilmore published the song in 1863 under the name Louis Lambert. Its upbeat tune accompanied lyrics about a soldier’s return."},{"time":"43:07","audioTime":2587,"title":"Home Sweet Home remained a favorite on both sides","detail":"The 1823 song expressed soldiers’ desire to return to their families and was repeatedly described as moving listeners in opposing camps."},{"time":"48:14","audioTime":2894,"title":"Tramp, Tramp, Tramp was written for prisoners","detail":"George Frederick Root wrote the song from the viewpoint of captured U.S. soldiers expecting release and a return home."},{"time":"53:33","audioTime":3213,"title":"Religious music was central to camp life","detail":"Soldiers sang hymns including “Amazing Grace” and “Nearer, My God, to Thee.” Chaplains and religious organizations distributed hymnals."},{"time":"58:58","audioTime":3538,"title":"African American songs joined faith and freedom","detail":"The episode discusses spirituals as religious expression, coded communication, and statements about emancipation, including “Go Down, Moses.”"},{"time":"1:02:46","audioTime":3766,"title":"Kingdom Coming celebrated emancipation","detail":"Henry Clay Work wrote the 1862 song in dialect. It portrayed enslaved people taking control after their enslaver fled approaching U.S. troops."},{"time":"1:09:16","audioTime":4156,"title":"John Brown’s Body became the soldiers’ leading U.S. anthem","detail":"The marching song began with a Massachusetts militia joke, then listeners connected it to abolitionist John Brown and emancipation."},{"time":"1:14:03","audioTime":4443,"title":"Julia Ward Howe rewrote the tune","detail":"Howe wrote new words to the “John Brown’s Body” melody in 1861. “Battle Hymn of the Republic” was published in 1862 and became more prominent after the war."},{"time":"1:16:06","audioTime":4566,"title":"The Battle Cry of Freedom became a publishing success","detail":"George Frederick Root wrote it after Lincoln’s July 1862 call for 300,000 volunteers. It became especially popular with northern civilians."},{"time":"1:17:34","audioTime":4654,"title":"Recruiting songs answered Lincoln’s calls","detail":"“We Are Coming, Father Abraham, 300,000 More” responded to the July 1862 call for additional troops."},{"time":"1:22:01","audioTime":4921,"title":"Marching Through Georgia described Sherman’s campaign","detail":"Henry Clay Work published the song in 1865 about Sherman’s March to the Sea. It remained widely performed after the war."},{"time":"1:24:49","audioTime":5089,"title":"Bugle calls regulated army life","detail":"The episode closes with “Taps.” The familiar melody was standardized as the U.S. Army’s lights-out call during the war, though its exact origin is disputed."}],"command":[],"people":[{"name":"Daniel Decatur Emmett","role":"Wrote “Dixie” for a New York minstrel show in 1859","side":"United States"},{"name":"Harry McCarthy","role":"Wrote and promoted “The Bonnie Blue Flag” across the Confederacy","side":"Confederacy"},{"name":"George Frederick Root","role":"Chicago songwriter and publisher behind “The Battle Cry of Freedom,” “Tramp, Tramp, Tramp,” and other wartime songs","side":"United States"},{"name":"Henry Clay Work","role":"Wrote “Kingdom Coming” and “Marching Through Georgia”","side":"United States"},{"name":"Julia Ward Howe","role":"Wrote the lyrics to “Battle Hymn of the Republic”","side":"United States"},{"name":"Patrick S. Gilmore","role":"Published “When Johnny Comes Marching Home” under the name Louis Lambert","side":"United States"},{"name":"James Ryder Randall","role":"Wrote the poem used for “Maryland, My Maryland”","side":"Confederacy"},{"name":"J. E. B. Stuart","role":"Confederate cavalry commander closely associated in the episode with “Join the Cavalry”","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/battle-hymn-sheet-music.jpg","alt":"1862 sheet music for Battle Hymn of the Republic","caption":"The 1862 sheet music for “Battle Hymn of the Republic,” with words by Julia Ward Howe.","source":"https://www.loc.gov/item/2023782802/"},{"image":"/images/marching-through-georgia-sheet-music.jpg","alt":"Sheet music for Marching Through Georgia","caption":"Sheet music for “Marching Through Georgia,” written by Henry Clay Work in 1865.","source":"https://www.loc.gov/item/2023782390/"}],"sources":[{"label":"Civil War Podcast episode 100","url":"https://civilwarpodcast.libsyn.com/100-music-special-songs-of-the-civil-war"},{"label":"Library of Congress: Civil War Sheet Music Collection","url":"https://www.loc.gov/collections/civil-war-sheet-music/"},{"label":"Library of Congress: Battle Hymn of the Republic","url":"https://www.loc.gov/item/2023782802/"},{"label":"Library of Congress: Marching Through Georgia","url":"https://www.loc.gov/item/2023782390/"},{"label":"Library of Congress: The Bonnie Blue Flag","url":"https://www.loc.gov/item/2023784409/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
