1d:["$","div","John Brown’s Body became the soldiers’ leading U.S. anthem",{"className":"moment","children":[["$","$L16",null,{"seconds":4156,"label":"1:09:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"John Brown’s Body became the soldiers’ leading U.S. anthem"}],["$","p",null,{"children":"The marching song began with a Massachusetts militia joke, then listeners connected it to abolitionist John Brown and emancipation."}]]}]]}]
1e:["$","div","Julia Ward Howe rewrote the tune",{"className":"moment","children":[["$","$L16",null,{"seconds":4443,"label":"1:14:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Julia Ward Howe rewrote the tune"}],["$","p",null,{"children":"Howe wrote new words to the “John Brown’s Body” melody in 1861. “Battle Hymn of the Republic” was published in 1862 and became more prominent after the war."}]]}]]}]
1f:["$","div","The Battle Cry of Freedom became a publishing success",{"className":"moment","children":[["$","$L16",null,{"seconds":4566,"label":"1:16:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Battle Cry of Freedom became a publishing success"}],["$","p",null,{"children":"George Frederick Root wrote it after Lincoln’s July 1862 call for 300,000 volunteers. It became especially popular with northern civilians."}]]}]]}]
20:["$","div","Recruiting songs answered Lincoln’s calls",{"className":"moment","children":[["$","$L16",null,{"seconds":4654,"label":"1:17:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Recruiting songs answered Lincoln’s calls"}],["$","p",null,{"children":"“We Are Coming, Father Abraham, 300,000 More” responded to the July 1862 call for additional troops."}]]}]]}]
21:["$","div","Marching Through Georgia described Sherman’s campaign",{"className":"moment","children":[["$","$L16",null,{"seconds":4921,"label":"1:22:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Marching Through Georgia described Sherman’s campaign"}],["$","p",null,{"children":"Henry Clay Work published the song in 1865 about Sherman’s March to the Sea. It remained widely performed after the war."}]]}]]}]
22:["$","div","Bugle calls regulated army life",{"className":"moment","children":[["$","$L16",null,{"seconds":5089,"label":"1:24:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bugle calls regulated army life"}],["$","p",null,{"children":"The episode closes with “Taps.” The familiar melody was standardized as the U.S. Army’s lights-out call during the war, though its exact origin is disputed."}]]}]]}]
