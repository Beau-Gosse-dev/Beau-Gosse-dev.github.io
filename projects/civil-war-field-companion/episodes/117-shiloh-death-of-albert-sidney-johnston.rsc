1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",117," · ","April 6, 1862, early afternoon; Johnston died at about 2:30 p.m."," · ","Bell Field and the peach orchard on the eastern side of the Shiloh battlefield, Tennessee"]}],["$","h1",null,{"children":"SHILOH- Death of Albert Sidney Johnston"}],["$","span",null,{"className":"result-label","children":"Albert Sidney Johnston personally led Statham’s brigade across Bell’s cotton field while Bowen advanced east of the Hamburg–Savannah Road. The attack forced Hurlbut’s troops out of the peach orchard. Johnston then ordered Statham to attack a United States battery west of the orchard. A projectile struck the back of Johnston’s right leg and damaged an artery. He did not recognize the wound’s severity, was moved into a ravine after collapsing in the saddle, and bled to death at about 2:30 p.m. The Confederate army lost its commander during the battle"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3846989851.mp3?updated=1695140626","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Confederate brigade led forward",{"children":[["$","span",null,{"children":"Confederate brigade led forward"}],["$","strong",null,{"children":"Statham: four Tennessee and two Mississippi regiments"}],"$undefined"]}],["$","div","Supporting brigade",{"children":[["$","span",null,{"children":"Supporting brigade"}],["$","strong",null,{"children":"John S. Bowen east of the Hamburg–Savannah Road"}],"$undefined"]}],["$","div","Johnston wounded",{"children":[["$","span",null,{"children":"Johnston wounded"}],["$","strong",null,{"children":"Back of the right leg, behind and just below the knee"}],"$undefined"]}],["$","div","Cause of death",{"children":[["$","span",null,{"children":"Cause of death"}],["$","strong",null,{"children":"Blood loss from a damaged artery"}],"$undefined"]}],["$","div","Time after collapse",{"children":[["$","span",null,{"children":"Time after collapse"}],["$","strong",null,{"children":"Roughly 25–30 minutes before death"}],"$undefined"]}],["$","div","Estimated time of death",{"children":[["$","span",null,{"children":"Estimated time of death"}],["$","strong",null,{"children":"About 2:30 p.m."}],"$undefined"]}],["$","div","Medical aid",{"children":[["$","span",null,{"children":"Medical aid"}],["$","strong",null,{"children":"His surgeon had been sent to treat wounded soldiers elsewhere"}],"$undefined"]}],["$","div","Historical distinction",{"children":[["$","span",null,{"children":"Historical distinction"}],["$","strong",null,{"children":"Highest-ranking officer of either side killed on a Civil War battlefield"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}],"$undefined",["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Shiloh battlefield today",{"className":"reference-map","children":["$Le","$Lf"]}],"$L10","$L11"]}]]}],false,"$L12","$L13","$L14","$L15","$L16"]}]]}]
