f:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L17",null,{"guide":{"date":"April 6, 1862, early afternoon; Johnston died at about 2:30 p.m.","place":"Bell Field and the peach orchard on the eastern side of the Shiloh battlefield, Tennessee","result":"Albert Sidney Johnston personally led Statham’s brigade across Bell’s cotton field while Bowen advanced east of the Hamburg–Savannah Road. The attack forced Hurlbut’s troops out of the peach orchard. Johnston then ordered Statham to attack a United States battery west of the orchard. A projectile struck the back of Johnston’s right leg and damaged an artery. He did not recognize the wound’s severity, was moved into a ravine after collapsing in the saddle, and bled to death at about 2:30 p.m. The Confederate army lost its commander during the battle","facts":[{"label":"Confederate brigade led forward","value":"Statham: four Tennessee and two Mississippi regiments"},{"label":"Supporting brigade","value":"John S. Bowen east of the Hamburg–Savannah Road"},{"label":"Johnston wounded","value":"Back of the right leg, behind and just below the knee"},{"label":"Cause of death","value":"Blood loss from a damaged artery"},{"label":"Time after collapse","value":"Roughly 25–30 minutes before death"},{"label":"Estimated time of death","value":"About 2:30 p.m."},{"label":"Medical aid","value":"His surgeon had been sent to treat wounded soldiers elsewhere"},{"label":"Historical distinction","value":"Highest-ranking officer of either side killed on a Civil War battlefield"}],"maps":[{"title":"Shiloh battlefield today","caption":"The NPS map identifies Bell Field, the peach orchard, the Hamburg–Savannah Road, and the site associated with Johnston’s death.","source":"https://www.nps.gov/shil/planyourvisit/maps.htm","image":"/images/shiloh-nps-auto-tour-map.jpg","alt":"National Park Service map of the Shiloh battlefield"},{"title":"Johnston’s final attack","caption":"Statham and Bowen advanced across Bell Field and forced the United States line out of the peach orchard. Johnston was wounded after ordering Statham toward a battery west of the orchard, then was moved to a nearby ravine.","source":"https://www.nps.gov/places/death-of-albert-sidney-johnston-tour-stop-17.htm","image":"/images/shiloh-johnston-last-charge.svg","alt":"Map of Albert Sidney Johnston’s final attack and death at Shiloh"},{"title":"Historical troop-position map","caption":"The 1862 map approved by Beauregard shows the peach orchard, roads, camps, and army positions across the battlefield.","source":"https://www.loc.gov/item/85690890/","image":"/images/shiloh-beauregard-map.jpg","alt":"1862 manuscript map of the Battle of Shiloh"}],"moments":[{"time":"6:04","audioTime":364,"title":"Johnston directed the Confederate right from near the front","detail":"He left Beauregard in the rear to send reinforcements toward the firing while he supervised attacks on the eastern battlefield."},{"time":"6:35","audioTime":395,"title":"Johnston decided to lead from the firing line","detail":"After repeated attacks failed at the peach orchard, the army commander accepted the risk of personally leading the next assault."},{"time":"8:09","audioTime":489,"title":"Johnston rallied Statham’s brigade","detail":"The six regiments sheltered in a gully south of Bell Field. Johnston rode along the line and directed them to use their bayonets."},{"time":"8:57","audioTime":537,"title":"Johnston led the charge","detail":"He rode ahead of Statham’s brigade into the cotton field while Bowen’s brigade advanced on the other side of the Hamburg–Savannah Road."},{"time":"9:34","audioTime":574,"title":"Hurlbut’s line left the peach orchard","detail":"The United States infantry fired heavily but withdrew before the Confederate charge reached bayonet range."},{"time":"10:02","audioTime":602,"title":"Several projectiles struck Johnston and his horse","detail":"Two bullets hit his horse, one spent round struck his thigh, and another cut through the sole of his left boot without disabling him."},{"time":"11:06","audioTime":666,"title":"A United States battery opened west of the orchard","detail":"Johnston sent for Confederate artillery and ordered Isham Harris to have one of Statham’s regiments charge the battery."},{"time":"11:35","audioTime":695,"title":"Johnston was left with one aide","detail":"Other staff officers carried orders. W. Lee Wickham remained nearby and heard a projectile strike but did not see an obvious wound."},{"time":"11:57","audioTime":717,"title":"Johnston collapsed in the saddle","detail":"When Harris returned, Johnston sagged to the left and said that he feared he was seriously wounded."},{"time":"13:44","audioTime":824,"title":"Harris and Wickham moved Johnston into a ravine","detail":"They supported him on horseback, removed him from the saddle in sheltered ground, and sent for a surgeon."},{"time":"14:25","audioTime":865,"title":"Johnston’s surgeon was elsewhere","detail":"Earlier, Johnston had ordered Dr. David Yandell to remain with wounded United States and Confederate soldiers near Prentiss’s captured camps."},{"time":"14:41","audioTime":881,"title":"The staff could not locate the wound","detail":"Harris searched Johnston’s torso while Theodore O’Hara and other officers tried to find medical help."},{"time":"16:16","audioTime":976,"title":"Johnston died at about 2:30 p.m.","detail":"He stopped breathing roughly 25–30 minutes after reaching the ravine."},{"time":"16:34","audioTime":994,"title":"The leg wound caused fatal blood loss","detail":"A projectile entered behind and below the right knee and damaged an artery. Johnston had a tourniquet but apparently did not understand the injury in time to use it."},{"time":"18:02","audioTime":1082,"title":"The charge succeeded at a major command cost","detail":"Statham and nearby formations advanced, but the Confederate army was left without its commanding general during the battle."}],"command":[{"side":"Confederacy","color":"#9a3d32","branches":[{"commander":"Albert Sidney Johnston","command":"Army of the Mississippi","subordinates":"Personally rallied and led Statham’s brigade; died at about 2:30 p.m."},{"commander":"P.G.T. Beauregard","command":"Second in command / rear headquarters","subordinates":"Directed reinforcements elsewhere on the battlefield and had not yet learned of Johnston’s death"},{"commander":"William S. Statham","command":"Brigade, Breckinridge’s Reserve Corps","subordinates":"Four Tennessee and two Mississippi regiments crossing Bell Field"},{"commander":"John S. Bowen","command":"Brigade, Breckinridge’s Reserve Corps","subordinates":"Advanced east of the Hamburg–Savannah Road beside Statham"}]},{"side":"United States","color":"#315f8c","branches":[{"commander":"Stephen A. Hurlbut","command":"4th Division","subordinates":"Defended the peach orchard and Bell Field before withdrawing"},{"commander":"United States battery","command":"Position west of the peach orchard","subordinates":"Opened fire after Hurlbut’s infantry withdrew; became the target of Johnston’s final order"}]}],"people":[{"name":"Albert Sidney Johnston","role":"Commanded the Confederate army, personally led Statham’s charge, and died of blood loss after being wounded","side":"Confederacy","image":"/images/albert-sidney-johnston.jpg","source":"https://www.loc.gov/pictures/item/2018670318/"},{"name":"Isham G. Harris","role":"Tennessee governor serving as a volunteer aide; delivered Johnston’s final order and supported him after he collapsed","side":"Confederacy"},{"name":"W. Lee Wickham","role":"Aide who helped move Johnston into the ravine and rode for medical help","side":"Confederacy"},{"name":"David W. Yandell","role":"Johnston’s surgeon; had been detached to treat wounded soldiers and was not present when Johnston was hit","side":"Confederacy"},{"name":"Theodore O’Hara","role":"Staff officer who searched for a surgeon after Johnston was wounded","side":"Confederacy"},{"name":"William Preston","role":"Johnston’s brother-in-law and staff officer who reached him shortly before his death","side":"Confederacy"},{"name":"William S. Statham","role":"Commanded the brigade Johnston personally led across Bell Field","side":"Confederacy"},{"name":"John S. Bowen","role":"Commanded the brigade advancing beside Statham east of the road","side":"Confederacy"},{"name":"Stephen A. Hurlbut","role":"Commanded the United States division defending the peach orchard","side":"United States"}],"losses":[{"name":"General Albert Sidney Johnston","side":"Confederacy","role":"Commander, Army of the Mississippi","outcome":"Wounded behind the right knee during the attack at Bell Field and died from blood loss at about 2:30 p.m.; the highest-ranking officer killed on a Civil War battlefield"}],"gallery":[{"image":"/images/shiloh-battlefield-april-9.jpg","alt":"The Shiloh battlefield photographed April 9, 1862","caption":"The woods, fields, and ravines on the eastern battlefield shaped both the attack and the effort to move Johnston out of the line of fire.","source":"https://www.loc.gov/pictures/item/2017646904/"},{"image":"/images/shiloh-battle-print.jpg","alt":"Historical print of the Battle of Shiloh","caption":"Johnston’s personal intervention moved Statham’s brigade forward but exposed the army commander to fire at close range.","source":"https://www.loc.gov/pictures/item/2018757088/"},{"image":"/images/pittsburg-landing-1862.jpg","alt":"Pittsburg Landing in 1862","caption":"The fighting continued across the battlefield after Johnston died and command passed to Beauregard.","source":"https://www.loc.gov/pictures/item/2004660985/"}],"sources":[{"label":"Civil War Podcast episode 117","url":"https://civilwarpodcast.libsyn.com/117-shiloh-death-of-albert-sidney-johnston"},{"label":"National Park Service: Albert Sidney Johnston","url":"https://www.nps.gov/people/albert-sidney-johnston.htm"},{"label":"National Park Service: Johnston death site","url":"https://www.nps.gov/places/death-of-albert-sidney-johnston-tour-stop-17.htm"},{"label":"National Park Service: Johnston mortuary monument","url":"https://www.nps.gov/shil/learn/historyculture/monument-detail.htm?id=M017"},{"label":"Library of Congress: Shiloh battlefield map","url":"https://www.loc.gov/item/85690890/"},{"label":"Library of Congress: Shiloh battlefield photograph","url":"https://www.loc.gov/pictures/item/2017646904/"}]}}]}]
