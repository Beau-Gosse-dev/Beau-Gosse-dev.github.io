d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",117," · ","April 6, 1862, early afternoon; Johnston died at about 2:30 p.m."," · ","Bell Field and the peach orchard on the eastern side of the Shiloh battlefield, Tennessee"]}],["$","h1",null,{"children":"SHILOH- Death of Albert Sidney Johnston"}],["$","span",null,{"className":"result-label","children":"Albert Sidney Johnston personally led Statham’s brigade across Bell’s cotton field while Bowen advanced east of the Hamburg–Savannah Road. The attack forced Hurlbut’s troops out of the peach orchard. Johnston then ordered Statham to attack a United States battery west of the orchard. A projectile struck the back of Johnston’s right leg and damaged an artery. He did not recognize the wound’s severity, was moved into a ravine after collapsing in the saddle, and bled to death at about 2:30 p.m. The Confederate army lost its commander during the battle"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3