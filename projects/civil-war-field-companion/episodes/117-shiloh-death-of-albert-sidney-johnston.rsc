f:["$","figure","Johnston’s final attack",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/shiloh-johnston-last-charge.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Johnston’s final attack at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-johnston-last-charge.svg","alt":"Map of Albert Sidney Johnston’s final attack and death at Shiloh","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Johnston’s final attack"}],["$","span",null,{"children":"Statham and Bowen advanced across Bell Field and forced the United States line out of the peach orchard. Johnston was wounded after ordering Statham toward a battery west of the orchard, then was moved to a nearby ravine."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/shiloh-johnston-last-charge.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/places/death-of-albert-sidney-johnston-tour-stop-17.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
10:["$","figure","Historical troop-position map",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/shiloh-beauregard-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Historical troop-position map at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-beauregard-map.jpg","alt":"1862 manuscript map of the Battle of Shiloh","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Historical troop-position map"}],["$","span",null,{"children":"The 1862 map approved by Beauregard shows the peach orchard, roads, camps, and army positions across the battlefield."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/shiloh-beauregard-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/85690890/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Johnston directed the Confederate right from near the front",{"className":"moment","children":[["$","$L17",null,{"seconds":364,"label":"6:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston directed the Confederate right from near the front"}],["$","p",null,{"children":"He left Beauregard in the rear to send reinforcements toward the firing while he supervised attacks on the eastern battlefield."}]]}]]}],["$","div","Johnston decided to lead from the firing line",{"className":"moment","children":[["$","$L17",null,{"seconds":395,"label":"6:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston decided to lead from the firing line"}],["$","p",null,{"children":"After repeated attacks failed at the peach orchard, the army commander accepted the risk of personally leading the next assault."}]]}]]}],["$","div","Johnston rallied Statham’s brigade",{"className":"moment","children":[["$","$L17",null,{"seconds":489,"label":"8:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston rallied Statham’s brigade"}],["$","p",null,{"children":"The six regiments sheltered in a gully south of Bell Field. Johnston rode along the line and directed them to use their bayonets."}]]}]]}],["$","div","Johnston led the charge",{"className":"moment","children":[["$","$L17",null,{"seconds":537,"label":"8:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston led the charge"}],["$","p",null,{"children":"He rode ahead of Statham’s brigade into the cotton field while Bowen’s brigade advanced on the other side of the Hamburg–Savannah Road."}]]}]]}],["$","div","Hurlbut’s line left the peach orchard",{"className":"moment","children":[["$","$L17",null,{"seconds":574,"label":"9:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hurlbut’s line left the peach orchard"}],["$","p",null,{"children":"The United States infantry fired heavily but withdrew before the Confederate charge reached bayonet range."}]]}]]}],["$","div","Several projectiles struck Johnston and his horse",{"className":"moment","children":[["$","$L17",null,{"seconds":602,"label":"10:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Several projectiles struck Johnston and his horse"}],["$","p",null,{"children":"Two bullets hit his horse, one spent round struck his thigh, and another cut through the sole of his left boot without disabling him."}]]}]]}],["$","div","A United States battery opened west of the orchard",{"className":"moment","children":[["$","$L17",null,{"seconds":666,"label":"11:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"A United States battery opened west of the orchard"}],["$","p",null,{"children":"Johnston sent for Confederate artillery and ordered Isham Harris to have one of Statham’s regiments charge the battery."}]]}]]}],["$","div","Johnston was left with one aide",{"className":"moment","children":[["$","$L17",null,{"seconds":695,"label":"11:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston was left with one aide"}],["$","p",null,{"children":"Other staff officers carried orders. W. Lee Wickham remained nearby and heard a projectile strike but did not see an obvious wound."}]]}]]}],["$","div","Johnston collapsed in the saddle",{"className":"moment","children":[["$","$L17",null,{"seconds":717,"label":"11:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston collapsed in the saddle"}],["$","p",null,{"children":"When Harris returned, Johnston sagged to the left and said that he feared he was seriously wounded."}]]}]]}],["$","div","Harris and Wickham moved Johnston into a ravine",{"className":"moment","children":[["$","$L17",null,{"seconds":824,"label":"13:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Harris and Wickham moved Johnston into a ravine"}],["$","p",null,{"children":"They supported him on horseback, removed him from the saddle in sheltered ground, and sent for a surgeon."}]]}]]}],["$","div","Johnston’s surgeon was elsewhere",{"className":"moment","children":[["$","$L17",null,{"seconds":865,"label":"14:25"}],"$L18"]}],"$L19","$L1a","$L1b","$L1c"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of the Mississippi",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Mississippi"}],["$","span",null,{"children":"Albert Sidney Johnston"}],["$","small",null,{"children":"Personally rallied and led Statham’s brigade; died at about 2:30 p.m."}]]}],["$","div","Second in command / rear headquarters",{"className":"command-entry","children":[["$","strong",null,{"children":"Second in command / rear headquarters"}],["$","span",null,{"children":"P.G.T. Beauregard"}],["$","small",null,{"children":"Directed reinforcements elsewhere on the battlefield and had not yet learned of Johnston’s death"}]]}],["$","div","Brigade, Breckinridge’s Reserve Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Breckinridge’s Reserve Corps"}],["$","span",null,{"children":"William S. Statham"}],["$","small",null,{"children":"Four Tennessee and two Mississippi regiments crossing Bell Field"}]]}],["$","div","Brigade, Breckinridge’s Reserve Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Breckinridge’s Reserve Corps"}],["$","span",null,{"children":"John S. Bowen"}],["$","small",null,{"children":"Advanced east of the Hamburg–Savannah Road beside Statham"}]]}]]]}],["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","4th Division",{"className":"command-entry","children":[["$","strong",null,{"children":"4th Division"}],["$","span",null,{"children":"Stephen A. Hurlbut"}],["$","small",null,{"children":"Defended the peach orchard and Bell Field before withdrawing"}]]}],["$","div","Position west of the peach orchard",{"className":"command-entry","children":[["$","strong",null,{"children":"Position west of the peach orchard"}],["$","span",null,{"children":"United States battery"}],["$","small",null,{"children":"Opened fire after Hurlbut’s infantry withdrew; became the target of Johnston’s final order"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Albert Sidney Johnston",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/albert-sidney-johnston.jpg","alt":"Portrait of Albert Sidney Johnston","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Albert Sidney Johnston"}],["$","p",null,{"children":"Commanded the Confederate army, personally led Statham’s charge, and died of blood loss after being wounded"}]]}]]}],["$","article","Isham G. Harris",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"IG"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Isham G. Harris"}],["$","p",null,{"children":"Tennessee governor serving as a volunteer aide; delivered Johnston’s final order and supported him after he collapsed"}]]}]]}],["$","article","W. Lee Wickham",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"W. Lee Wickham"}],["$","p",null,{"children":"Aide who helped move Johnston into the ravine and rode for medical help"}]]}]]}],["$","article","David W. Yandell",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"DW"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"David W. Yandell"}],["$","p",null,{"children":"Johnston’s surgeon; had been detached to treat wounded soldiers and was not present when Johnston was hit"}]]}]]}],"$L1d","$L1e","$L1f","$L20","$L21"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","General Albert Sidney Johnston",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"General Albert Sidney Johnston"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Army of the Mississippi","."]}]," ","Wounded behind the right knee during the attack at Bell Field and died from blood loss at about 2:30 p.m.; the highest-ranking officer killed on a Civil War battlefield"]}]]}]]}]]}]
14:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/shiloh-battlefield-april-9.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-battlefield-april-9.jpg","alt":"The Shiloh battlefield photographed April 9, 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The woods, fields, and ravines on the eastern battlefield shaped both the attack and the effort to move Johnston out of the line of fire."}]]}],["$","figure","/images/shiloh-battle-print.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-battle-print.jpg","alt":"Historical print of the Battle of Shiloh","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Johnston’s personal intervention moved Statham’s brigade forward but exposed the army commander to fire at close range."}]]}],["$","figure","/images/pittsburg-landing-1862.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/pittsburg-landing-1862.jpg","alt":"Pittsburg Landing in 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The fighting continued across the battlefield after Johnston died and command passed to Beauregard."}]]}]]}]]}]
