n":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Strategic superior to Pope and McClellan; assessed Harrison’s Landing and ordered the Peninsula withdrawal"}]]}],["$","div","Army of Virginia-Maj. Gen. John Pope",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"I Corps: John C. Frémont, then Franz Sigel; II Corps: Nathaniel P. Banks; III Corps: Irvin McDowell; chief of staff: Col. George D. Ruggles"}]]}],["$","div","Army of the Potomac at Harrison’s Landing-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac at Harrison’s Landing"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Remained a separate army commander until Halleck ordered his force transferred north to join Pope"}]]}],["$","div","Department of North Carolina-Maj. Gen. Ambrose E. Burnside",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of North Carolina"}],["$","span",null,{"children":"Maj. Gen. Ambrose E. Burnside"}],["$","small",null,{"children":"The episode reports that he declined an offer to replace McClellan; part of his force later reinforced Pope"}]]}]]]}],["$","section","Confederate national and field command",{"className":"command-column #9a4037","children":[["$","h3",null,{"children":"Confederate national and field command"}],[["$","div","Confederate commander in chief-President Jefferson Davis",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate commander in chief"}],["$","span",null,{"children":"President Jefferson Davis"}],["$","small",null,{"children":"National political and military authority over the forces defending Richmond and central Virginia"}]]}],"$L1f","$L20","$L21"]]}]]}],"$L22"]]]}]
16:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L23","/images/ep170-army-of-virginia-map.jpg",{"image":"/images/ep170-army-of-virginia-map.jpg","alt":"Historical black-and-white map of northern and central Virginia roads, railroads, rivers, and towns.","caption":"This map of Pope’s July–August field of operations accompanied his 1866 report to Congress. It provides geographic detail but does not show troop positions or movements.","name":"Historical black-and-white map of northern and central Virginia roads, railroads, rivers, and towns.","source":"$undefined","credit":"Library of Congress Geography and Map Division; see sources below."}],["$","$L23","/images/ep170-john-pope.jpg",{"image":"/images/ep170-john-pope.jpg","alt":"Civil War-era glass-negative portrait of John Pope in United States Army uniform.","caption":"John Pope brought a record of success at New Madrid, Island No. 10, and Corinth to his new command in Virginia.","name":"Civil War-era glass-negative portrait of John Pope in United States Army uniform.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L23","/images/ep170-henry-halleck.jpg",{"image":"/images/ep170-henry-halleck.jpg","alt":"Civil War-era glass-negative portrait of Henry W. Halleck in United States Army uniform.","caption":"Henry W. Halleck became general-in-chief in July 1862 and was responsible for coordinating the separated Federal armies.","name":"Civil War-era glass-negative portrait of Henry W. Halleck in United States Army uniform.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L23","/images/ep170-george-mcclellan.jpg",{"image":"/images/ep170-george-mcclellan.jpg","alt":"Civil War-era glass-negative portrait of George B. McClellan with his wife, Ellen Mary Marcy McClellan.","caption":"George B. McClellan remained with the Army of the Potomac at Harrison’s Landing and opposed Pope’s strategic assumptions and coercive orders.","name":"Civil War-era glass-negative portrait of George B. McClellan with his wife, Ellen Mary Marcy McClellan.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L23","/images/ep170-virginia-refugees.jpg",{"image":"/images/ep170-virginia-refugees.jpg","alt":"Black-and-white photograph of Virginia civilians and wagons identified by the National Park Service as refugees in 1862.","caption":"The National Park Service uses this National Archives photograph to illustrate civilians affected by the expansion of military operations and Pope’s harder-war policies in Virginia.","name":"Black-and-white photograph of Virginia civilians and wagons identified by the National Park Service as refugees in 1862.","source":"$undefined","credit":"National Archives and Records Administration, presented by the National Park Service; see sources below."}]]}]]}]
