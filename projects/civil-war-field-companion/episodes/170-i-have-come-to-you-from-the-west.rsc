11:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/10/30/civil-war-podcast-episode-170/",{"href":"https://civilwarpodcast.org/2016/10/30/civil-war-podcast-episode-170/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 170 page"]}],["$","a","https://civilwarpodcast.org/book-recommendations/",{"href":"https://civilwarpodcast.org/book-recommendations/","target":"_blank","rel":"noreferrer","children":[" · ","Official Civil War Podcast book recommendations"]}],["$","a","https://www.nps.gov/people/john-pope.htm",{"href":"https://www.nps.gov/people/john-pope.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: John Pope"]}],["$","a","https://www.nps.gov/articles/pushing-forward.htm",{"href":"https://www.nps.gov/articles/pushing-forward.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Pushing Forward"]}],["$","a","https://www.nps.gov/articles/000/from-the-peninsula-to-maryland-burnside-s-role-in-the-summer-of-1862.htm",{"href":"https://www.nps.gov/articles/000/from-the-peninsula-to-maryland-burnside-s-role-in-the-summer-of-1862.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: From the Peninsula to Maryland—Burnside’s role in summer 1862"]}],["$","a","https://www.archives.gov/publications/prologue/2010/spring/lincoln-and-guerrillas",{"href":"https://www.archives.gov/publications/prologue/2010/spring/lincoln-and-guerrillas","target":"_blank","rel":"noreferrer","children":[" · ","National Archives: Abraham Lincoln and the Guerrillas"]}],["$","a","https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/",{"href":"https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Civil War campaign summary"]}],["$","a","https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo111054/pdf/GOVPUB-D114-PURL-gpo111054.pdf",{"href":"https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo111054/pdf/GOVPUB-D114-PURL-gpo111054.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Battle of Second Manassas staff ride"]}],["$","a","https://www.presidency.ucsb.edu/documents/order-constituting-the-army-virginia",{"href":"https://www.presidency.ucsb.edu/documents/order-constituting-the-army-virginia","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Lincoln’s June 26 order constituting the Army of Virginia"]}],["$","a","https://www.loc.gov/item/03003452/",{"href":"https://www.loc.gov/item/03003452/","target":"_blank","rel":"noreferrer","children":[" · ","Primary source collection: Official Records of the Union and Confederate Armies"]}],["$","a","https://www.govinfo.gov/content/pkg/STATUTE-12/pdf/STATUTE-12-Pg589.pdf",{"href":"https://www.govinfo.gov/content/pkg/STATUTE-12/pdf/STATUTE-12-Pg589.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Statutes at Large: Second Confiscation Act, July 17, 1862"]}],["$","a","https://www.loc.gov/collections/george-brinton-mcclellan-papers/articles-and-essays/timeline/",{"href":"https://www.loc.gov/collections/george-brinton-mcclellan-papers/articles-and-essays/timeline/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: McClellan papers timeline"]}],["$","a","https://www.loc.gov/item/mal1685600/",{"href":"https://www.loc.gov/item/mal1685600/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: July 7 Harrison’s Landing letter cover"]}],"$L1a","$L1b","$L1c","$L1d"]}]
