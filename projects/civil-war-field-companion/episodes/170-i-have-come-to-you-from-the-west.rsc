1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",170," · ","June 26–August 3, 1862"," · ","Washington, D.C.; the Shenandoah Valley, Rappahannock line, and Fredericksburg in northern Virginia; Gordonsville and Richmond in central Virginia; and Harrison’s Landing on the James River"]}],["$","h1",null,{"children":"\"I HAVE COME TO YOU FROM THE WEST\""}],["$","span",null,{"className":"result-label","children":"The Lincoln administration consolidated three independent Federal commands as the Army of Virginia under Maj. Gen. John Pope. The new army could not immediately cooperate with George B. McClellan’s Army of the Potomac because Robert E. Lee’s army stood between them. Henry W. Halleck became general-in-chief, McClellan’s Peninsula army was ordered north, and Pope’s July addresses and orders marked a more coercive Federal policy toward Confederate property, guerrillas, and disloyal civilians"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3826935249.mp3?updated=1695385214","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"John Pope’s background, the creation of the Army of Virginia, the Federal command problem after the Seven Days, and the policy dispute between Pope and McClellan"}],["$","small",null,{"children":"The narrative covers Pope’s earlier career before following events from his June appointment through the August 3 order withdrawing the Army of the Potomac from the Peninsula."}]]}],["$","div","John Pope in 1862",{"children":[["$","span",null,{"children":"John Pope in 1862"}],["$","strong",null,{"children":"Forty years old; West Point class of 1842"}],["$","small",null,{"children":"Pope was born in Louisville, Kentucky, grew up in Illinois, served in the Topographical Engineers, and received Mexican War brevets for Monterrey and Buena Vista."}]]}],["$","div","Western record",{"children":[["$","span",null,{"children":"Western record"}],["$","strong",null,{"children":"New Madrid, Island No. 10, and the advance on Corinth"}],["$","small",null,{"children":"Pope’s Army of the Mississippi captured New Madrid in March and Island No. 10 in April 1862, then joined Halleck’s advance on Corinth. These operations established the reputation that brought Pope east."}]]}],["$","div","Army of Virginia created",{"children":[["$","span",null,{"children":"Army of Virginia created"}],["$","strong",null,{"children":"June 26, 1862"}],["$","small",null,{"children":"Lincoln’s order combined the commands of John C. Frémont, Nathaniel P. Banks, and Irvin McDowell and assigned the new army to Pope."}]]}],["$","div","Army of Virginia mission",{"children":[["$","span",null,{"children":"Army of Virginia mission"}],["$","strong",null,{"children":"Protect Washington and western Virginia, defeat Jackson and Ewell, threaten toward Charlottesville, and aid McClellan"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}],"$L27","$undefined","$L28",false,"$L29",false,"$L2a","$L2b","$L2c"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","small",null,{"children":"Those four requirements appear in Lincoln’s June 26 order. They imposed simultaneous defensive and offensive responsibilities on Pope’s new command."}]
f:["$","div","Initial strength and distribution",{"children":[["$","span",null,{"children":"Initial strength and distribution"}],["$","strong",null,{"children":"About 45,000 men spread across northern Virginia"}],["$","small",null,{"children":"The U.S. Army campaign summary gives approximately 45,000. The episode describes the three commands as occupying an arc of roughly 60 miles from the lower Shenandoah Valley to Fredericksburg."}]]}]
10:["$","div","I Corps",{"children":[["$","span",null,{"children":"I Corps"}],["$","strong",null,{"children":"Mountain Department troops under Frémont, then Franz Sigel"}],["$","small",null,{"children":"Frémont, who was senior to Pope, asked to be relieved rather than serve under him. Stanton selected Sigel as the replacement."}]]}]
11:["$","div","II Corps",{"children":[["$","span",null,{"children":"II Corps"}],["$","strong",null,{"children":"Shenandoah Department troops under Nathaniel P. Banks"}],["$","small",null,{"children":"Banks’s army had been defeated by Jackson at Front Royal and Winchester during the preceding Valley Campaign."}]]}]
12:["$","div","III Corps",{"children":[["$","span",null,{"children":"III Corps"}],["$","strong",null,{"children":"Irvin McDowell’s Department of the Rappahannock troops"}],["$","small",null,{"children":"Part of McDowell’s command under James Shields had been defeated at Port Republic. Troops retained inside Washington’s fortifications were excluded from the new corps."}]]}]
13:["$","div","Pope’s first headquarters",{"children":[["$","span",null,{"children":"Pope’s first headquarters"}],["$","strong",null,{"children":"The War Department in Washington"}],["$","small",null,{"children":"Pope initially directed concentration from the capital and followed the Seven Days through the War Department telegraph office. He did not join his field command until late July."}]]}]
14:["$","div","McClellan at Harrison’s Landing",{"children":[["$","span",null,{"children":"McClellan at Harrison’s Landing"}],["$","strong",null,{"children":"Army of the Potomac on the James River from July 2"}],["$","small",null,{"children":"The Seven Days ended with McClellan separated from Pope by Richmond and Lee’s Army of Northern Virginia. McClellan wanted reinforcements and a renewed Peninsula offensive."}]]}]
15:["$","div","Pope’s strategic objection",{"children":[["$","span",null,{"children":"Pope’s strategic objection"}],["$","strong",null,{"children":"A direct march toward Richmond would expose his army to Lee before McClellan could support it"}],["$","small",null,{"children":"Pope made this argument in his July 4 letter to McClellan. He proposed holding a line that protected Washington and denied easy Confederate access to the Shenandoah until a coordinated plan existed."}]]}]
16:["$","div","New general-in-chief",{"children":[["$","span",null,{"children":"New general-in-chief"}],["$","strong",null,{"children":"Henry W. Halleck, appointed July 11, 1862"}],["$","small",null,{"children":"Lincoln restored the post that had been vacant since he removed McClellan from the general-in-chief role in March. Halleck visited Harrison’s Landing July 24–27 to assess McClellan’s position."}]]}]
17:["$","div","Burnside and Army of the Potomac command",{"children":[["$","span",null,{"children":"Burnside and Army of the Potomac command"}],["$","strong",null,{"children":"The episode reports that Ambrose E. Burnside declined an offer in late July"}],["$","small",null,{"children":"The hosts place the offer around July 25 and state that Burnside doubted his fitness for the larger command and was loyal to McClellan. The National Park Service confirms that Burnside declined an offer to replace McClellan during the summer crisis."}]]}]
18:["$","div","Peninsula withdrawal order",{"children":[["$","span",null,{"children":"Peninsula withdrawal order"}],["$","strong",null,{"children":"August 3, 1862"}],["$","small",null,{"children":"Halleck ordered the Army of the Potomac transferred from the Peninsula toward Aquia Creek so it could join Pope and cover Washington."}]]}]
19:["$","div","Army condition in late July",{"children":[["$","span",null,{"children":"Army condition in late July"}],["$","strong",null,{"children":"Three corps needing concentration, refit, and resupply"}],["$","small",null,{"children":"The episode also emphasizes morale and command friction. Pope used public language and orders to promote a more aggressive identity for the new army."}]]}]
1a:["$","div","Pope’s address to the army",{"children":[["$","span",null,{"children":"Pope’s address to the army"}],["$","strong",null,{"children":"July 14, 1862"}],["$","small",null,{"children":"The address contrasted Pope’s western service with eastern concern for defensive positions, supply bases, and retreat. The episode’s title comes from its opening claim that Pope had come from the West."}]]}]
1b:["$","div","Reaction inside the armies",{"children":[["$","span",null,{"children":"Reaction inside the armies"}],["$","strong",null,{"children":"Some enlisted soldiers approved; many officers resented the criticism"}],["$","small",null,{"children":"The episode describes the strongest hostility among Army of Virginia officers senior to Pope and among McClellan’s circle in the Army of the Potomac. Fitz John Porter condemned the address in a July 17 private letter."}]]}]
1c:["$","div","Administration role in the address",{"children":[["$","span",null,{"children":"Administration role in the address"}],["$","strong",null,{"children":"Stanton influenced its content and Lincoln approved it in the episode’s account"}],["$","small",null,{"children":"The hosts interpret the address as an administration-backed criticism of McClellan’s military approach, not simply an unsanctioned statement of Pope’s personality."}]]}]
1d:["$","div","General Orders No. 5",{"children":[["$","span",null,{"children":"General Orders No. 5"}],["$","strong",null,{"children":"Army to subsist from the country in its area of operations"}],["$","small",null,{"children":"Pope permitted requisition of food and forage and distinguished receipts for loyal citizens from vouchers payable only after restoration of peace for those who supported the Confederacy."}]]}]
1e:["$","div","General Orders No. 7",{"children":[["$","span",null,{"children":"General Orders No. 7"}],["$","strong",null,{"children":"Collective penalties for guerrilla attacks and damage to communications"}],["$","small",null,{"children":"The order held nearby civilians responsible for repairing railroads, roads, telegraphs, and bridges and authorized severe punishment for attacks made from civilian cover."}]]}]
1f:["$","div","General Orders No. 11",{"children":[["$","span",null,{"children":"General Orders No. 11"}],["$","strong",null,{"children":"Loyalty oaths, expulsion, and arrest of disloyal male civilians"}],["$","small",null,{"children":"Men who took the oath and provided security could remain. Those who refused were to be sent beyond Federal lines and treated as spies if they returned."}]]}]
20:["$","div","Policy purpose and effect",{"children":[["$","span",null,{"children":"Policy purpose and effect"}],["$","strong",null,{"children":"Suppress guerrillas and shift the burdens of war onto active Confederate supporters"}],["$","small",null,{"children":"The National Archives and National Park Service describe the orders as administration-approved measures that allowed executions, financial assessments, confiscation, requisition, and destruction of property. Their broad collective penalties also endangered civilians."}]]}]
21:["$","div","McClellan’s opposing policy",{"children":[["$","span",null,{"children":"McClellan’s opposing policy"}],["$","strong",null,{"children":"A limited war directed against Confederate armed forces rather than the Southern population"}],["$","small",null,{"children":"McClellan’s July 7 Harrison’s Landing letter advised against subjugation, confiscation, and forcible abolition. His later instructions warned the Army of the Potomac against plunder."}]]}]
22:["$","div","Second Confiscation Act",{"children":[["$","span",null,{"children":"Second Confiscation Act"}],["$","strong",null,{"children":"Approved July 17, 1862"}],["$","small",null,{"children":"The statute expanded Federal authority against rebel property and declared free enslaved people held by persons engaged in rebellion who came under United States control under the act’s terms."}]]}]
23:["$","div","Confederate response",{"children":[["$","span",null,{"children":"Confederate response"}],["$","strong",null,{"children":"Jackson sent toward Gordonsville on July 13"}],["$","small",null,{"children":"Lee moved Jackson north to protect the Virginia Central Railroad junction and confront Pope while Longstreet remained near Richmond. The deployment deepened the danger created by the two separated Federal armies."}]]}]
24:["$","div","Battle losses in this episode",{"children":[["$","span",null,{"children":"Battle losses in this episode"}],["$","strong",null,{"children":"None"}],["$","small",null,{"children":"This is an organizational, strategic, and policy episode. It reviews earlier battles and prepares the Northern Virginia Campaign but does not narrate a new battle."}]]}]
25:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“General John Pope: A Life for the Nation” by Peter Cozzens"}],["$","small",null,{"children":"The official episode page and the podcast’s book list identify this biography as the recommendation."}]]}]
26:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Shenandoah, Irvin McDowell, Franz Sigel, George B. McClellan, Fitz John Porter, and Harrison’s Landing"}],["$","small",null,{"children":"The automated transcript produces “Lower Chandoe,” “MacDowell,” “Siegel,” “Lomac,” “Fitzjohn,” and “Harrison’s landing.” “Lomac” refers to the hosts’ nickname “Little Mac” for McClellan."}]]}]
27:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
28:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The separated Federal armies and the Army of Virginia’s formation",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep170-strategic-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The separated Federal armies and the Army of Virginia’s formation at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep170-strategic-context.svg","alt":"Generalized schematic map showing the three corps of the Army of Virginia, Pope near Gordonsville, McClellan at Harrison’s Landing, and Lee near Richmond.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The separated Federal armies and the Army of Virginia’s formation"}],["$","span",null,{"children":"Lincoln combined the former Mountain, Shenandoah, and Rappahannock commands under Pope. McClellan remained at Harrison’s Landing, with Lee near Richmond and able to move toward Gordonsville between the two Federal armies. Rivers, routes, positions, arrows, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep170-strategic-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Lincoln’s June 26 order, National Park Service, U.S. Army Center of Military History, Library of Congress maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Government-published map of the Army of Virginia’s theater",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep170-army-of-virginia-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Government-published map of the Army of Virginia’s theater at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep170-army-of-virginia-map.jpg","alt":"Historical map of northern and central Virginia showing roads, railroads, rivers, and towns in the Army of Virginia’s field of operations.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Government-published map of the Army of Virginia’s theater"}],["$","span",null,{"children":"This 1866 map accompanied Pope’s report to the Joint Committee on the Conduct of the War. It shows the roads, railroads, rivers, terrain, and communities across the July–August theater but does not plot troop movements."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep170-army-of-virginia-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Geography and Map Division, from th