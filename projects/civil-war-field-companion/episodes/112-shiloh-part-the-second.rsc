1b:["$","div",null,{"children":[["$","h3",null,{"children":"Smith selected Pittsburg Landing as the camp"}],["$","p",null,{"children":"He ordered Sherman to camp several miles inland, leaving room for later divisions between Sherman and the river."}]]}]
1c:["$","div","Sherman occupied Shiloh Church",{"className":"moment","children":[["$","$L19",null,{"seconds":607,"label":"10:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman occupied Shiloh Church"}],["$","p",null,{"children":"His four brigades camped about two and a half miles from the river, with headquarters at the log Methodist meetinghouse."}]]}]]}]
1d:["$","div","The main army assembled",{"className":"moment","children":[["$","$L19",null,{"seconds":625,"label":"10:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The main army assembled"}],["$","p",null,{"children":"W.H.L. Wallace’s and McClernand’s divisions joined Hurlbut behind Sherman. Lew Wallace remained several miles away at Crump’s Landing."}]]}]]}]
1e:["$","div","Grant resumed command",{"className":"moment","children":[["$","$L19",null,{"seconds":687,"label":"11:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant resumed command"}],["$","p",null,{"children":"Grant arrived at Savannah on March 17 after Halleck restored him to duty."}]]}]]}]
1f:["$","div","Smith’s condition worsened",{"className":"moment","children":[["$","$L19",null,{"seconds":774,"label":"12:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith’s condition worsened"}],["$","p",null,{"children":"The infected leg wound left him unable to command. He died at Savannah on April 25."}]]}]]}]
20:["$","div","Halleck prohibited an advance",{"className":"moment","children":[["$","$L19",null,{"seconds":800,"label":"13:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck prohibited an advance"}],["$","p",null,{"children":"Grant wanted to move against Corinth, but orders required him to wait for Buell and avoid bringing on a battle."}]]}]]}]
21:["$","div","The camps were not arranged for defense",{"className":"moment","children":[["$","$L19",null,{"seconds":916,"label":"15:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"The camps were not arranged for defense"}],["$","p",null,{"children":"The army expected to advance from Pittsburg Landing and did not anticipate a Confederate attack from Corinth."}]]}]]}]
22:["$","div","Buell crossed the Duck River",{"className":"moment","children":[["$","$L19",null,{"seconds":1052,"label":"17:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell crossed the Duck River"}],["$","p",null,{"children":"On April 2, his army cleared a major obstacle but still had about eighty miles to reach Grant."}]]}]]}]
23:["$","div","A cavalry probe alarmed Beauregard",{"className":"moment","children":[["$","$L19",null,{"seconds":1073,"label":"17:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"A cavalry probe alarmed Beauregard"}],["$","p",null,{"children":"Routine United States activity near Crump’s Landing was mistaken for the start of an offensive."}]]}]]}]
24:["$","div","Johnston ordered the army to march",{"className":"moment","children":[["$","$L19",null,{"seconds":1116,"label":"18:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston ordered the army to march"}],["$","p",null,{"children":"The April 2 order called for departure at 6 a.m. on April 3, arrival near Pittsburg Landing that day, and an attack at dawn April 4."}]]}]]}]
25:["$","div","The march began hours late",{"className":"moment","children":[["$","$L19",null,{"seconds":1443,"label":"24:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The march began hours late"}],["$","p",null,{"children":"Inexperienced units, inadequate staff work, and unclear orders kept most troops in camp. Hardee finally left Corinth at 3 p.m."}]]}]]}]
26:["$","div","The attack was postponed",{"className":"moment","children":[["$","$L19",null,{"seconds":1512,"label":"25:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack was postponed"}],["$","p",null,{"children":"Johnston, Beauregard, and Bragg rescheduled the assault from Friday to Saturday morning."}]]}]]}]
27:["$","div","Thomas Jordan wrote the detailed order",{"className":"moment","children":[["$","$L19",null,{"seconds":1521,"label":"25:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas Jordan wrote the detailed order"}],["$","p",null,{"children":"Beauregard’s chief of staff prepared a complex march and deployment plan for four unequal corps."}]]}]]}]
28:["$","div","The corps were stacked in successive lines",{"className":"moment","children":[["$","$L19",null,{"seconds":1608,"label":"26:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"The corps were stacked in successive lines"}],["$","p",null,{"children":"Hardee formed the first line, followed by Bragg and Polk, with Breckinridge in reserve. Each line stretched across the battlefield."}]]}]]}]
29:["$","div","The order differed from Johnston’s stated plan",{"className":"moment","children":[["$","$L19",null,{"seconds":1646,"label":"27:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"The order differed from Johnston’s stated plan"}],["$","p",null,{"children":"Johnston had described Polk on the left, Hardee in the center, and Bragg on the right driving the United States left away from the river."}]]}]]}]
2a:["$","div","The deployment would break corps control",{"className":"moment","children":[["$","$L19",null,{"seconds":1702,"label":"28:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The deployment would break corps control"}],["$","p",null,{"children":"Successive formations would feed into the same contested ground and intermingle, reducing the corps to collections of brigades and regiments."}]]}]]}]
