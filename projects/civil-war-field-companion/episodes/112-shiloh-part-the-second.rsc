d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",112," · ","March 11–April 3, 1862; preparations for the Battle of Shiloh"," · ","Savannah, Crump’s Landing, Pittsburg Landing, and Corinth along the Tennessee River corridor"]}],["$","h1",null,{"children":"SHILOH (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Grant’s army established dispersed camps at Pittsburg Landing and Crump’s Landing while waiting for Buell. The United States position was organized for an advance on Corinth, not for defense. Johnston ordered about 42,000 Confederates north from Corinth, but delays disrupted the timetable. The written deployment order stacked four corps one behind another instead of assigning them separate sectors, creating a command problem before the battle began"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"March 11–April 3, 1862; preparations for the Battle of Shiloh"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Savannah, Crump’s Landing, Pittsburg Landing, and Corinth along the Tennessee River corridor"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Grant’s army established dispersed camps at Pittsburg Landing and Crump’s Landing while waiting for Buell. The United States position was organized for an advance on Corinth, not for defense. Johnston ordered about 42,000 Confederates north from Corinth, but delays disrupted the timetable. The written deployment order stacked four corps one behind another instead of assigning them separate sectors, creating a command problem before the battle began"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Confederate strength at Corinth",{"children":[["$","th",null,{"scope":"row","children":"Confederate strength at Corinth"}],"$Lf"]}]]}]]}],"$L10"]}],"$undefined"]}],"$L11","$L12","$L13",false,"$L14","$L15","$L16","$L17","$L18","$L19"]}]]}]
