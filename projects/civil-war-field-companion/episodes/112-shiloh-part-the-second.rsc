1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",112," · ","March 11–April 3, 1862; preparations for the Battle of Shiloh"," · ","Savannah, Crump’s Landing, Pittsburg Landing, and Corinth along the Tennessee River corridor"]}],["$","h1",null,{"children":"SHILOH (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Grant’s army established dispersed camps at Pittsburg Landing and Crump’s Landing while waiting for Buell. The United States position was organized for an advance on Corinth, not for defense. Johnston ordered about 42,000 Confederates north from Corinth, but delays disrupted the timetable. The written deployment order stacked four corps one behind another instead of assigning them separate sectors, creating a command problem before the battle began"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5880453739.mp3?updated=1695140519","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Confederate strength at Corinth",{"children":[["$","span",null,{"children":"Confederate strength at Corinth"}],["$","strong",null,{"children":"About 42,000 troops"}],"$undefined"]}],["$","div","Corinth to Pittsburg Landing",{"children":[["$","span",null,{"children":"Corinth to Pittsburg Landing"}],["$","strong",null,{"children":"About 23 road miles"}],"$undefined"]}],["$","div","United States transport fleet",{"children":[["$","span",null,{"children":"United States transport fleet"}],["$","strong",null,{"children":"About 80 steamboats assembled at Savannah"}],"$undefined"]}],["$","div","Grant’s main position",{"children":[["$","span",null,{"children":"Grant’s main position"}],["$","strong",null,{"children":"Five divisions near Pittsburg Landing; Lew Wallace at Crump’s Landing"}],"$undefined"]}],["$","div","Original Confederate timetable",{"children":[["$","span",null,{"children":"Original Confederate timetable"}],["$","strong",null,{"children":"Leave Corinth April 3 and attack at dawn April 4"}],"$undefined"]}],["$","div","Confederate corps",{"children":[["$","span",null,{"children":"Confederate corps"}],["$","strong",null,{"children":"Polk 9,100; Bragg 13,500; Hardee 6,700; Breckinridge 6,400"}],"$undefined"]}],["$","div","Johnston’s intended attack",{"children":[["$","span",null,{"children":"Johnston’s intended attack"}],["$","strong",null,{"children":"Bragg on the right, Hardee in the center, Polk on the left"}],"$undefined"]}],["$","div","Order actually issued",{"children":[["$","span",null,{"children":"Order actually issued"}],["$","strong",null,{"children":"Hardee, Bragg, Polk, and Breckinridge in successive lines across the battlefield"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"Peo