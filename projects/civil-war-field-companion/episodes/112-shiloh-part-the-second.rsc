f:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Grant’s river bases and the Confederate concentration"}],["$","span",null,{"children":"Savannah was on the east bank of the Tennessee River. Crump’s Landing and Pittsburg Landing were on the west bank. Corinth lay about 23 road miles southwest of the main camps."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
