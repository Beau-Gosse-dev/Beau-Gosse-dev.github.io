13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Johnston faced two approaching armies",{"className":"moment","children":[["$","$L19",null,{"seconds":68,"label":"1:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston faced two approaching armies"}],["$","p",null,{"children":"About 42,000 Confederates at Corinth could fight Grant on roughly equal terms, but Grant and Buell together would have a large numerical advantage."}]]}]]}],["$","div","Johnston chose to defeat the armies separately",{"className":"moment","children":[["$","$L19",null,{"seconds":192,"label":"3:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston chose to defeat the armies separately"}],["$","p",null,{"children":"He planned to attack Grant before Buell completed the march from Nashville."}]]}]]}],["$","div","Halleck directed Grant and Buell",{"className":"moment","children":[["$","$L19",null,{"seconds":231,"label":"3:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck directed Grant and Buell"}],["$","p",null,{"children":"Halleck remained in St. Louis and intended to take field command after the two armies united."}]]}]]}],["$","div","C.F. Smith led the initial river movement",{"className":"moment","children":[["$","$L19",null,{"seconds":307,"label":"5:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"C.F. Smith led the initial river movement"}],["$","p",null,{"children":"While Grant was sidelined, Smith took the army up the Tennessee River and Buell began marching from Nashville."}]]}]]}],["$","div","The first troops reached Savannah",{"className":"moment","children":[["$","$L19",null,{"seconds":331,"label":"5:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first troops reached Savannah"}],["$","p",null,{"children":"The 46th Ohio arrived March 11. About eighty steamboats brought the rest of Smith’s army over the following days."}]]}]]}],["$","div","Smith assigned railroad raids",{"className":"moment","children":[["$","$L19",null,{"seconds":377,"label":"6:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith assigned railroad raids"}],["$","p",null,{"children":"Sherman was to cut the Memphis & Charleston Railroad, and Lew Wallace was to damage the Mobile & Ohio Railroad near Purdy."}]]}]]}],["$","div","C.F. Smith injured his leg",{"className":"moment","children":[["$","$L19",null,{"seconds":414,"label":"6:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"C.F. Smith injured his leg"}],["$","p",null,{"children":"Smith scraped his shin while boarding a launch. The wound became infected and eventually caused his death."}]]}]]}],["$","div","Lew Wallace completed his raid",{"className":"moment","children":[["$","$L19",null,{"seconds":438,"label":"7:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lew Wallace completed his raid"}],["$","p",null,{"children":"His division marched from Crump’s Landing and destroyed a half-mile trestle north of Purdy, then occupied positions from Adamsville to the river."}]]}]]}],["$","div","Sherman moved upriver",{"className":"moment","children":[["$","$L19",null,{"seconds":487,"label":"8:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman moved upriver"}],["$","p",null,{"children":"Nineteen transports carried his division toward Eastport to reach the Memphis & Charleston Railroad."}]]}]]}],["$","div","Confederates blocked the Eastport landing",{"className":"moment","children":[["$","$L19",null,{"seconds":501,"label":"8:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates blocked the Eastport landing"}],["$","p",null,{"children":"Sherman shifted to Yellow Creek, but heavy rain, mud, and an unfordable creek ended the attempt."}]]}]]}],["$","div","Hurlbut reached Pittsburg Landing",{"className":"moment","children":[["$","$L19",null,{"seconds":548,"label":"9:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hurlbut reached Pittsburg Landing"}],["$","p",null,{"children":"Sherman encountered Hurlbut’s division unloading at the river bluff about eight miles above Savannah."}]]}]]}],["$","div","Smith selected Pittsburg Landing as the camp",{"className":"moment","children":["$L1a","$L1b"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a"]}]]}]
