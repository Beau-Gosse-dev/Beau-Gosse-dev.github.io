10:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.libsyn.com/112-shiloh-part-the-second",{"href":"https://civilwarpodcast.libsyn.com/112-shiloh-part-the-second","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 112"]}],["$","a","https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm",{"href":"https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of Shiloh"]}],["$","a","https://www.nps.gov/shil/planyourvisit/maps.htm",{"href":"https://www.nps.gov/shil/planyourvisit/maps.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Shiloh maps"]}],["$","a","https://www.loc.gov/item/85690890/",{"href":"https://www.loc.gov/item/85690890/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Shiloh battlefield map"]}],["$","a","https://www.loc.gov/pictures/item/2004660985/",{"href":"https://www.loc.gov/pictures/item/2004660985/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Pittsburg Landing"]}],["$","a","https://www.loc.gov/pictures/item/2017646904/",{"href":"https://www.loc.gov/pictures/item/2017646904/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Shiloh battlefield, April 9"]}],["$","a","https://www.loc.gov/pictures/item/2018757088/",{"href":"https://www.loc.gov/pictures/item/2018757088/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Battle of Shiloh print"]}]]}]
