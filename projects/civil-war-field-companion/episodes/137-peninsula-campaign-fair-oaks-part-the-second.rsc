f:["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Sedgwick’s lead force",{"children":[["$","th",null,{"scope":"row","children":"Sedgwick’s lead force"}],["$","td",null,{"children":["About 8,000 men in three brigades",["$","small",null,{"style":{"display":"block"},"children":"This is the episode’s estimate for the force that reached Couch shortly after 5 p.m., not the strength of all II Corps troops eventually south of the river."}]]}]]}],["$","tr","Johnston wounded",{"children":[["$","th",null,{"scope":"row","children":"Johnston wounded"}],["$","td",null,{"children":["About 7 p.m., May 31",["$","small",null,{"style":{"display":"block"},"children":"The episode describes a bullet wound to his right shoulder followed by a shell fragment striking his chest and throwing him from his horse. He survived but was absent from field command for about six months."}]]}]]}],["$","tr","Episode casualty figures",{"children":[["$","th",null,{"scope":"row","children":"Episode casualty figures"}],["$","td",null,{"children":["Confederacy: just over 6,100, including 980 killed; United States: just over 5,000, including 790 killed",["$","small",null,{"style":{"display":"block"},"children":"These are the traditional totals used by the episode and the National Park Service battle summary. Later battlefield studies give higher and materially different totals, so casualty counts should be identified by source."}]]}]]}]]}]]}]
10:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/01/03/civil-war-podcast-episode-137/",{"href":"https://civilwarpodcast.org/2016/01/03/civil-war-podcast-episode-137/","target":"_blank","rel":"noreferrer","children":["Source: ","The Civil War Podcast: episode 137 page"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va014",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va014","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Seven Pines battle summary"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Virginia Campaigns, March–August 1862"]}],["$","a","https://history.army.mil/Research/Reference-Topics/Irish-and-the-US-Army/Fair-Oaks-Seven-Pines/",{"href":"https://history.army.mil/Research/Reference-Topics/Irish-and-the-US-Army/Fair-Oaks-Seven-Pines/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Meagher’s official report at Fair Oaks"]}],["$","a","https://ehistory.osu.edu/books/official-records/012",{"href":"https://ehistory.osu.edu/books/official-records/012","target":"_blank","rel":"noreferrer","children":[" · ","Official Records, Series I, Volume XI, Part I: Peninsular Campaign reports"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00292/",{"href":"https://www.loc.gov/item/gvhs01.vhs00292/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Sneden plan of Fair Oaks, May 31"]}],["$","a","https://www.loc.gov/item/2004660060/",{"href":"https://www.loc.gov/item/2004660060/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Waud drawing of Sumner’s crossing"]}],["$","a","https://www.loc.gov/item/2018666177/",{"href":