d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",137," · ","May 31–June 2, 1862 (battle on May 31–June 1; immediate command change and withdrawal through June 2)"," · ","East of Richmond, Virginia, between the Chickahominy River, Fair Oaks Station, Seven Pines, the Richmond and York River Railroad, Nine Mile Road, and Williamsburg Road"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN: Fair Oaks (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Indecisive. Sumner’s II Corps crossed the flooded Chickahominy and stopped Whiting’s late May 31 attack near the Adams House. Joseph E. Johnston was seriously wounded, and Gustavus W. Smith assumed temporary command. Poorly coordinated Confederate attacks on June 1 failed against Richardson and Kearny; D. H. Hill ordered a withdrawal, and the fighting ended about 2 p.m. The Confederate army returned to its earlier lines, but Johnston’s removal led Jefferson Davis to place Robert E. Lee in command of the forces defending Richmond"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"May 31–June 2, 1862 (battle on May 31–June 1; immediate command change and withdrawal through June 2)"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"East of Richmond, Virginia, between the Chickahominy River, Fair Oaks Station, Seven Pines, the Richmond and York River Railroad, Nine Mile Road, and Williamsburg Road"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Indecisive. Sumner’s II Corps crossed the flooded Chickahominy and stopped Whiting’s late May 31 attack near the Adams House. Joseph E. Johnston was seriously wounded, and Gustavus W. Smith assumed temporary command. Poorly coordinated Confederate attacks on June 1 failed against Richardson and Kearny; D. H. Hill ordered a withdrawal, and the fighting ended about 2 p.m. The Confederate army returned to its earlier lines, but Johnston’s removal led Jefferson Davis to place Robert E. Lee in command of the forces defending Richmond"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],"$Lf","$L10"]}],"$undefined"]}],"$L11","$L12",false,false,"$L13","$L14","$L15","$L16","$L17","$L18"]}]]}]
