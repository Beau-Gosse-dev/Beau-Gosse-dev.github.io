15:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L21","/images/ep137-sumner-crossing.jpg",{"image":"/images/ep137-sumner-crossing.jpg","alt":"Alfred Waud drawing of Sumner’s troops crossing the Chickahominy toward Fair Oaks","caption":"Alfred R. Waud drew Sumner’s II Corps crossing the Chickahominy on May 31, 1862. The Library of Congress dates the drawing to the day of the battle.","name":"Alfred Waud drawing of Sumner’s troops crossing the Chickahominy toward Fair Oaks","source":"https://www.loc.gov/item/2004660060/","credit":"$undefined"}],["$","$L21","/images/ep137-seven-pines-twin-houses.jpg",{"image":"/images/ep137-seven-pines-twin-houses.jpg","alt":"June 1862 stereographic photograph of the twin houses and a field howitzer at Seven Pines","caption":"George N. Barnard photographed the twin houses and a 32-pounder field howitzer at Seven Pines in June 1862, shortly after the battle.","name":"June 1862 stereographic photograph of the twin houses and a field howitzer at Seven Pines","source":"https://www.loc.gov/item/2018666177/","credit":"$undefined"}],["$","$L21","/images/ep137-edwin-sumner.jpg",{"image":"/images/ep137-edwin-sumner.jpg","alt":"Portrait of United States major general Edwin Vose Sumner in uniform","caption":"Edwin V. Sumner placed II Corps near the bridges before receiving the final order to cross, then personally moved toward the fighting at Fair Oaks.","name":"Portrait of United States major general Edwin Vose Sumner in uniform","source":"https://www.nps.gov/people/edwin-vose-sumner.htm","credit":"$undefined"}],["$","$L21","/images/ep137-oliver-howard.jpg",{"image":"/images/ep137-oliver-howard.jpg","alt":"Portrait of United States brigadier general Oliver Otis Howard in uniform","caption":"Oliver O. Howard lost his right arm after being wounded while leading two regiments forward on June 1. He returned to active service later that year.","name":"Portrait of United States brigadier general Oliver Otis Howard in uniform","source":"https://goordnance.army.mil/HallOfFame/2000/2005/howard.html","credit":"$undefined"}],["$","$L21","/images/ep137-joseph-e-johnston.jpg",{"image":"/images/ep137-joseph-e-johnston.jpg","alt":"Portrait of Confederate general Joseph E. Johnston","caption":"Johnston’s serious wounding ended his command of the army outside Richmond and led directly to the appointment of Robert E. Lee.","name":"Portrait of Confederate general Joseph E. Johnston","source":"https://www.loc.gov/item/2018666539/","credit":"$undefined"}]]}]]}]
16:["$","details",null,{"className":"reference-sources","children":[["$","summary",null,{"children":"Sources and image credits"}],["$","ul",null,{"children":[["$","li","https://www.nps.gov/people/edwin-vose-sumner.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/people/edwin-vose-sumner.htm","target":"_blank","rel":"noreferrer","children":["National Park Service: Edwin V. Sumner biography"," ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://goordnance.army.mil/HallOfFame/2000/2005/howard.html",{"children":["$","a",null,{"href":"https://goordnance.army.mil/HallOfFame/2000/2005/howard.html","target":"_blank","rel":"noreferrer","children":["U.S. Army Ordnance Corps: Oliver O. Howard biography"," ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/2018666539/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/2018666539/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Joseph E. Johnston portrait"," ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://civilwarpodcast.org/2016/01/03/civil-war-podcast-episode-137/",{"children":["$","a",null,{"href":"https://civilwarpodcast.org/2016/01/03/civil-war-podcast-episode-137/","target":"_blank","rel":"noreferrer","children":["The Civil War Podcast: episode 137 page"," ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/civilwar/search-battle