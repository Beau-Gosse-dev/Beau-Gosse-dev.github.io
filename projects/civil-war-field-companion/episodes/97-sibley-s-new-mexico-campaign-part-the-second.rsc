17:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
19:["$","p",null,{"children":"The force included about 1,200 regulars, more than 2,000 New Mexico volunteers, roughly 500 militia, and a small Colorado company."}]
1a:["$","div","The Confederates reached Fort Craig",{"className":"moment","children":[["$","$L18",null,{"seconds":1885,"label":"31:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederates reached Fort Craig"}],["$","p",null,{"children":"By February 15, Sibley’s army was five to seven miles south of the fort. The strengthened post was too strong for a direct assault."}]]}]]}]
1b:["$","div","Green took field command",{"className":"moment","children":[["$","$L18",null,{"seconds":1920,"label":"32:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Green took field command"}],["$","p",null,{"children":"Sibley was unable to direct the movement on February 16. Colonel Thomas Green formed the Confederates south of the fort, but Canby kept the U.S. force behind its defenses."}]]}]]}]
1c:["$","div","The Confederates decided to bypass the fort",{"className":"moment","children":[["$","$L18",null,{"seconds":2016,"label":"33:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederates decided to bypass the fort"}],["$","p",null,{"children":"With about ten days of food left, Green’s council chose to cross to the east bank, march around Fort Craig, and recross at Valverde Ford."}]]}]]}]
1d:["$","div","Canby tried to stop the bypass",{"className":"moment","children":[["$","$L18",null,{"seconds":2121,"label":"35:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canby tried to stop the bypass"}],["$","p",null,{"children":"On February 20, U.S. troops moved against the Confederate dry camp. Artillery fire caused disorder among some New Mexico volunteers, and Canby ended the attack after dark."}]]}]]}]
1e:["$","div","U.S. cavalry reached Valverde Ford first",{"className":"moment","children":[["$","$L18",null,{"seconds":2272,"label":"37:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. cavalry reached Valverde Ford first"}],["$","p",null,{"children":"On February 21, Benjamin Roberts brought cavalry, infantry, and artillery north from Fort Craig and drove Charles Pyron’s advance guard away from the river."}]]}]]}]
1f:["$","div","The lancer attack failed",{"className":"moment","children":[["$","$L18",null,{"seconds":2395,"label":"39:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"The lancer attack failed"}],["$","p",null,{"children":"A company of 5th Texas lancers charged the Colorado volunteers. A close-range volley broke the attack; only three of about 70 lancers were reported unhurt."}]]}]]}]
20:["$","div","Canby arrived and ordered an attack on the Confederate left",{"className":"moment","children":[["$","$L18",null,{"seconds":2498,"label":"41:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canby arrived and ordered an attack on the Confederate left"}],["$","p",null,{"children":"Canby recalled Kit Carson’s regiment and tried to reinforce the assault. Most of the 2nd New Mexico refused the order, and the attack did not develop as planned."}]]}]]}]
21:["$","div","Green attacked both U.S. flanks",{"className":"moment","children":[["$","$L18",null,{"seconds":2558,"label":"42:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Green attacked both U.S. flanks"}],["$","p",null,{"children":"Henry Raguet’s attack on the U.S. right was repulsed. Samuel Lockridge then led about 750 dismounted Texans against Alexander McRae’s battery on the other flank."}]]}]]}]
22:["$","div","The Texans captured McRae’s battery",{"className":"moment","children":[["$","$L18",null,{"seconds":2582,"label":"43:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Texans captured McRae’s battery"}],["$","p",null,{"children":"The Confederates crossed open ground under canister fire, reached the guns, and fought at close range. Lockridge and McRae were both killed during the fighting."}]]}]]}]
23:["$","div","Canby ordered a retreat",{"className":"moment","children":[["$","$L18",null,{"seconds":2621,"label":"43:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canby ordered a retreat"}],["$","p",null,{"children":"The loss of the battery broke the U.S. line. Canby withdrew the field force across the Rio Grande to Fort Craig, and a truce allowed both sides to collect casualties."}]]}]]}]
24:["$","div","Fort Craig did not surrender",{"className":"moment","children":[["$","$L18",null,{"seconds":2674,"label":"44:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fort Craig did not surrender"}],["$","p",null,{"children":"Sibley demanded the fort and its supplies the next morning. Canby refused because his force remained intact behind the fortifications."}]]}]]}]
25:["$","div","The victory did not solve the Confederate supply problem",{"className":"moment","children":[["$","$L18",null,{"seconds":2765,"label":"46:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"The victory did not solve the Confederate supply problem"}],["$","p",null,{"children":"The Confederates held the field but had lost more than 200 men killed or wounded and had only about five days of provisions. The fort and its stores remained under U.S. control."}]]}]]}]
26:["$","div","Sibley continued north",{"className":"moment","children":[["$","$L18",null,{"seconds":2825,"label":"47:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sibley continued north"}],["$","p",null,{"children":"Unable to capture or besiege Fort Craig, Sibley chose to leave it behind and move toward the federal depots at Albuquerque and Santa Fe."}]]}]]}]
27:["$","img",null,{"src":"/projects/civil-war-field-companion/images/edward-canby.jpg","alt":"Portrait of Edward R. S. Canby","width":420,"height":520,"loading":"lazy"}]
