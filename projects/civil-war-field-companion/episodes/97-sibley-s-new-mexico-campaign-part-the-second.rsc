12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Canby took command in New Mexico",{"className":"moment","children":[["$","$L18",null,{"seconds":127,"label":"2:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canby took command in New Mexico"}],["$","p",null,{"children":"Edward R. S. Canby replaced William W. Loring after Loring resigned from the U.S. Army. Canby reorganized the department while officers and regular troops were leaving for service elsewhere."}]]}]]}],["$","div","Canby concentrated the territorial defenses",{"className":"moment","children":[["$","$L18",null,{"seconds":376,"label":"6:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canby concentrated the territorial defenses"}],["$","p",null,{"children":"Canby delayed some troop withdrawals, requested New Mexico and Colorado volunteers, and placed forces at key points along the Rio Grande and Santa Fe Trail."}]]}]]}],["$","div","Fort Fillmore was reinforced",{"className":"moment","children":[["$","$L18",null,{"seconds":505,"label":"8:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fort Fillmore was reinforced"}],["$","p",null,{"children":"Canby sent supplies and troops to Fort Fillmore and placed its roughly 700-man garrison under Major Isaac Lynde. Lynde later abandoned the post and surrendered his column to John Baylor."}]]}]]}],["$","div","Sibley presented his plan to Jefferson Davis",{"className":"moment","children":[["$","$L18",null,{"seconds":674,"label":"11:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sibley presented his plan to Jefferson Davis"}],["$","p",null,{"children":"Sibley argued that a Texas brigade could defeat the small U.S. force in New Mexico and sustain itself with captured federal supplies."}]]}]]}],["$","div","Sibley received authority to raise a brigade",{"className":"moment","children":[["$","$L18",null,{"seconds":844,"label":"14:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sibley received authority to raise a brigade"}],["$","p",null,{"children":"Jefferson Davis commissioned Sibley as a Confederate brigadier general and authorized three cavalry regiments, artillery, and supporting units for the invasion."}]]}]]}],["$","div","The Army of New Mexico was organized in Texas",{"className":"moment","children":[["$","$L18",null,{"seconds":1077,"label":"17:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of New Mexico was organized in Texas"}],["$","p",null,{"children":"The 4th, 5th, and 7th Texas Mounted Volunteers formed the main force. With artillery and supply units, the brigade initially numbered about 3,200 men."}]]}]]}],["$","div","Sibley selected the regimental commanders",{"className":"moment","children":[["$","$L18",null,{"seconds":1112,"label":"18:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sibley selected the regimental commanders"}],["$","p",null,{"children":"William R. Scurry led the 4th Texas, Thomas Green led the 5th Texas, and John S. Sutton led the 7th Texas."}]]}]]}],["$","div","The invasion moved north from Fort Thorn",{"className":"moment","children":[["$","$L18",null,{"seconds":1379,"label":"22:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"The invasion moved north from Fort Thorn"}],["$","p",null,{"children":"On February 7, 1862, Sibley started 2,515 men, 15 artillery pieces, a supply train, and a cattle herd toward Fort Craig."}]]}]]}],["$","div","A Confederate detachment went to Tucson",{"className":"moment","children":[["$","$L18",null,{"seconds":1594,"label":"26:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"A Confederate detachment went to Tucson"}],["$","p",null,{"children":"Captain Sherod Hunter took 54 men west to protect Confederate supporters, watch for U.S. troops from California, and secure Sibley’s flank."}]]}]]}],["$","div","Canby assembled about 3,800 troops at Fort Craig",{"className":"moment","children":[["$","$L18",null,{"seconds":1728,"label":"28:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canby assembled about 3,800 troops at Fort Craig"}],"$L19"]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Department of New Mexico and Fort Craig garrison",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of New Mexico and Fort Craig garrison"}],["$","span",null,{"children":"Edward R. S. Canby"}],["$","small",null,{"children":"Took field command during the battle and ordered the retreat to Fort Craig"}]]}],["$","div","Advance force at Valverde",{"className":"command-entry","children":[["$","strong",null,{"children":"Advance force at Valverde"}],["$","span",null,{"children":"Benjamin S. Roberts"}],["$","small",null,{"children":"Cavalry, infantry, and artillery sent to block the Confederate crossing"}]]}],["$","div","Battery, 3rd U.S. Cavalry",{"className":"command-entry","children":[["$","strong",null,{"children":"Battery, 3rd U.S. Cavalry"}],["$","span",null,{"children":"Alexander McRae"}],["$","small",null,{"children":"Six guns captured in the final Confederate assault"}]]}],["$","div","1st New Mexico Volunteer Infantry",{"className":"command-entry","children":[["$","strong",null,{"children":"1st New Mexico Volunteer Infantry"}],["$","span",null,{"children":"Christopher “Kit” Carson"}],["$","small",null,{"children":"Eight companies engaged east of the Rio Grande"}]]}],["$","div","U.S. regular infantry detachment",{"className":"command-entry","children":[["$","strong",null,{"children":"U.S. regular infantry detachment"}],["$","span",null,{"children":"Henry R. Selden"}],["$","small",null,{"children":"Crossed the river and drove Confederates from a wooded position"}]]}],["$","div","Colorado Volunteers",{"className":"command-entry","children":[["$","strong",null,{"children":"Colorado Volunteers"}],["