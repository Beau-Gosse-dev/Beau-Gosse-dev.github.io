29:["$","article","Henry H. Sibley",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"HH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Henry H. Sibley"}],["$","p",null,{"children":"Organized and led the Confederate Army of New Mexico"}]]}]]}]
