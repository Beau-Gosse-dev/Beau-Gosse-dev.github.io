",null,{"children":"Sibley’s invasion force"}],["$","strong",null,{"children":"2,515 men and 15 artillery pieces at the start of the advance"}],"$undefined"]}],["$","div","Fort Craig garrison",{"children":[["$","span",null,{"children":"Fort Craig garrison"}],["$","strong",null,{"children":"About 3,800 regulars, New Mexico volunteers and militia, and Colorado volunteers"}],"$undefined"]}],["$","div","Battle",{"children":[["$","span",null,{"children":"Battle"}],["$","strong",null,{"children":"February 21, 1862"}],"$undefined"]}],["$","div","Final Confederate assault",{"children":[["$","span",null,{"children":"Final Confederate assault"}],["$","strong",null,{"children":"About 750 dismounted Texans"}],"$undefined"]}],["$","div","U.S. guns captured",{"children":[["$","span",null,{"children":"U.S. guns captured"}],["$","strong",null,{"children":"Six"}],"$undefined"]}],["$","div","Casualties stated in the episode",{"children":[["$","span",null,{"children":"Casualties stated in the episode"}],["$","strong",null,{"children":"U.S.: 111 killed, 160 wounded, 204 missing; Confederate: 71 killed, 157 wounded"}],["$","small",null,{"children":"Published totals vary by source. The National Park Service gives 263 U.S. and 187 Confederate casualties."}]]}],["$","div","Immediate result",{"children":[["$","span",null,{"children":"Immediate result"}],["$","strong",null,{"children":"Confederate victory; Fort Craig remained in U.S. hands"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"classN