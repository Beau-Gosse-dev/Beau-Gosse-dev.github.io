15:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/edward-canby.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/edward-canby.jpg","alt":"Portrait of Edward R. S. Canby in United States Army uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Edward R. S. Canby organized the defense of New Mexico and commanded the U.S. forces at Fort Craig and Valverde."}]]}],["$","figure","/images/fort-craig-earthworks-1866.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/fort-craig-earthworks-1866.jpg","alt":"Fort Craig earthworks photographed around 1866","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Fort Craig’s earthworks, photographed around 1866. The post remained in U.S. hands after Valverde and still held the supplies Sibley needed."}]]}],["$","figure","/images/sibley-new-mexico-campaign-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/sibley-new-mexico-campaign-map.jpg","alt":"Historical map of Sibley’s campaign in New Mexico","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A 1910 map of the entire campaign area, with Valverde and Fort Craig numbered 7 and 8."}]]}]]}]]}]
