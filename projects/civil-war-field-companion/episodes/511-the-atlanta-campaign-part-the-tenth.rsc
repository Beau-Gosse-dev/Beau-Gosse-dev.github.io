16:["$","div","A false report ended the first crossing",{"className":"moment","children":[["$","$L15",null,{"seconds":637,"label":"10:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"A false report ended the first crossing"}],["$","p",null,{"children":"Sweeney withdrew after hearing that a large Confederate force was crossing above him. The report proved incorrect."}]]}]]}]
17:["$","div","Sherman prepared two attacks for May 15",{"className":"moment","children":[["$","$L15",null,{"seconds":714,"label":"11:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman prepared two attacks for May 15"}],["$","p",null,{"children":"Sweeney was ordered to cross again, while Hooker’s XX Corps moved into the U.S. left-center."}]]}]]}]
18:["$","div","Hooker’s attack failed",{"className":"moment","children":[["$","$L15",null,{"seconds":746,"label":"12:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker’s attack failed"}],["$","p",null,{"children":"Hood’s troops stopped the three U.S. divisions. Federals briefly overran a small fort held by Max Van Den Corput’s Georgia battery."}]]}]]}]
