12:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L19",null,{"guide":{"date":"May 13–16, 1864","place":"Resaca and Lay’s Ferry, Georgia","result":"The battle was tactically indecisive, but the U.S. crossing at Lay’s Ferry threatened Johnston’s railroad and forced the Confederates to withdraw south of the Oostanaula River","facts":[{"label":"Battle dates","value":"May 13–15, 1864"},{"label":"Estimated casualties","value":"5,547 total","note":"National Park Service estimate: 2,747 U.S. and 2,800 Confederate"},{"label":"Captured Confederate guns","value":"4"},{"label":"Confederate withdrawal","value":"Completed early May 16"}],"maps":[{"title":"Resaca, the Oostanaula, and the route south","caption":"The campaign map shows Resaca at the railroad crossing, Lay’s Ferry downstream, and the roads and railroad leading toward Calhoun.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-2.jpg","alt":"Historical map of the Atlanta campaign around Resaca and the Oostanaula River"},{"title":"Resaca and Lay’s Ferry today","caption":"The Confederate line covered Resaca’s road and railroad bridges. Sweeney crossed the Oostanaula several miles downstream near Lay’s Ferry.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-85.02%2C34.51%2C-84.78%2C34.67&layer=mapnik&marker=34.579%2C-84.943"},{"title":"Fieldworks in the Atlanta campaign","caption":"Both armies used earthworks extensively. At Resaca, the Confederate position followed high ground east of Camp Creek.","source":"https://www.loc.gov/item/2018670937/","image":"/images/atlanta-fortifications.jpg","alt":"Civil War earthwork fortifications made from earth and timber"}],"moments":[{"time":"1:17","audioTime":77,"title":"Sherman concentrated at Snake Creek Gap","detail":"By May 12, most U.S. forces had joined McPherson while Johnston moved south from Dalton toward Resaca."},{"time":"3:29","audioTime":209,"title":"U.S. troops met the Confederate army at Resaca","detail":"Advanced Confederate units delayed the U.S. deployment on May 13 while Johnston formed west of town."},{"time":"4:06","audioTime":246,"title":"Johnston covered the river crossings","detail":"Polk held the left near the Oostanaula, Hardee held the center, and Hood held the right toward the Conasauga River."},{"time":"5:43","audioTime":343,"title":"The position could be turned downstream","detail":"The Oostanaula protected Sherman’s right and offered a route to cross below Resaca and threaten the Western and Atlantic Railroad."},{"time":"6:08","audioTime":368,"title":"Sherman deployed three armies","detail":"McPherson formed on the U.S. right, Thomas in the center, Schofield to the left, and IV Corps on the far left."},{"time":"7:42","audioTime":462,"title":"Fighting began early on May 14","detail":"Sherman ordered Thomas Sweeney’s division downstream to find a crossing while the main line pressed the Confederate position."},{"time":"8:18","audioTime":498,"title":"U.S. attacks failed on the Confederate right-center","detail":"Assaults by XXIII and XIV Corps caused heavy U.S. losses without taking important ground."},{"time":"8:29","audioTime":509,"title":"Hood counterattacked the U.S. left","detail":"The Confederate attack initially advanced against an exposed flank before XX Corps reinforcements stopped it."},{"time":"8:59","audioTime":539,"title":"U.S. artillery gained a position above the bridges","detail":"XV Corps troops took a hill from which artillery could fire on the Resaca crossings."},{"time":"9:19","audioTime":559,"title":"Sweeney found a crossing at Lay’s Ferry","detail":"He concealed pontoon boats near the mouth of Snake Creek while most of the division demonstrated opposite the ferry."},{"time":"10:13","audioTime":613,"title":"U.S. troops crossed the Oostanaula","detail":"Soldiers of the 65th and 85th Ohio crossed in boats at 5 p.m. and drove away a small Confederate cavalry guard."},{"time":"10:37","audioTime":637,"title":"A false report ended the first crossing","detail":"Sweeney withdrew after hearing that a large Confederate force was crossing above him. The report proved incorrect."},{"time":"11:54","audioTime":714,"title":"Sherman prepared two attacks for May 15","detail":"Sweeney was ordered to cross again, while Hooker’s XX Corps moved into the U.S. left-center."},{"time":"12:26","audioTime":746,"title":"Hooker’s attack failed","detail":"Hood’s troops stopped the three U.S. divisions. Federals briefly overran a small fort held by Max Van Den Corput’s Georgia battery."},{"time":"13:22","audioTime":802,"title":"U.S. troops recovered four guns after dark","detail":"The cannon remained between the lines until soldiers removed part of the fort’s parapet and rolled them back."},{"time":"13:40","audioTime":820,"title":"Sweeney secured a second crossing","detail":"U.S. soldiers crossed in a flatboat before the planned operation. Walker’s Confederate division could not drive them back."},{"time":"14:38","audioTime":878,"title":"One Confederate attack went forward after cancellation","detail":"The order canceling Hood’s counterattack did not reach Alexander P. Stewart’s division in time. U.S. troops repulsed it with heavy losses."},{"time":"15:05","audioTime":905,"title":"Johnston ordered the evacuation of Resaca","detail":"The U.S. bridgehead at Lay’s Ferry threatened the railroad south of town. Hood withdrew first, followed by Hardee and Polk."},{"time":"15:56","audioTime":956,"title":"The Confederates completed the withdrawal","detail":"At 3:30 a.m. on May 16, the rear guard burned the railroad bridge and removed its pontoon bridge. U.S. troops captured the road bridge intact."},{"time":"17:34","audioTime":1054,"title":"The campaign’s operating pattern was established","detail":"Johnston repeatedly chose prepared defensive positions, while Sherman generally used flank movements instead of large frontal attacks."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed the battle and the downstream crossing"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"IV, XIV, and XX Corps"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Held the U.S. right near the Oostanaula"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"Held the U.S. left before moving to the far left"},{"commander":"Thomas W. Sweeney","command":"Division, XVI Corps","subordinates":"Established the Lay’s Ferry bridgehead"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Directed the defense and withdrawal"},{"commander":"Leonidas Polk","command":"Polk’s Corps","subordinates":"Held the Confederate left near the Oostanaula"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Held the center; Walker guarded Calhoun and Lay’s Ferry"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Held the right and directed counterattacks"}]}],"people":[{"name":"William T. Sherman","role":"Deployed three armies at Resaca and ordered the Lay’s Ferry crossing","side":"United States"},{"name":"Joseph E. Johnston","role":"Defended the Resaca bridges and withdrew when the railroad was threatened","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"Thomas W. Sweeney","role":"Commanded both U.S. crossings at Lay’s Ferry","side":"United States"},{"name":"John B. Hood","role":"Commanded the Confederate right and the May 14 counterattack","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"Benjamin Harrison","role":"Led the 70th Indiana during the fight for Van Den Corput’s battery","side":"United States","image":"/images/benjamin-harrison.jpg","source":"https://www.loc.gov/pictures/item/2005687179/"},{"name":"Alexander P. Stewart","role":"His division attacked after Johnston’s cancellation order failed to reach it","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/atlanta-campaign-map-2.jpg","alt":"Historical map of the Atlanta campaign","caption":"Resaca’s bridges and the railroad made the Oostanaula crossing operationally important.","source":"https://www.loc.gov/item/2008628278/"},{"image":"/images/benjamin-harrison.jpg","alt":"Portrait of Benjamin Harrison in military uniform","caption":"Colonel Benjamin Harrison led the 70th Indiana during the temporary capture of a Confederate battery.","source":"https://www.loc.gov/pictures/item/2005687179/"},{"image":"/images/atlanta-fortifications.jpg","alt":"Civil War earthwork fortifications","caption":"Earthworks strengthened the Confederate line around Resaca.","source":"https://www.loc.gov/item/2018670937/"}],"sources":[{"label":"Official Episode 511 page","url":"https://civilwarpodcast.org/2025/11/16/civil-war-podcast-episode-511/"},{"label":"National Park Service Resaca battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=GA008"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"Library of Congress Atlanta fortifications photograph","url":"https://www.loc.gov/item/2018670937/"}]}}]}]
