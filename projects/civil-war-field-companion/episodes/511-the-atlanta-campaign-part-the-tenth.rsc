10:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Sherman concentrated at Snake Creek Gap",{"className":"moment","children":[["$","$L15",null,{"seconds":77,"label":"1:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman concentrated at Snake Creek Gap"}],["$","p",null,{"children":"By May 12, most U.S. forces had joined McPherson while Johnston moved south from Dalton toward Resaca."}]]}]]}],["$","div","U.S. troops met the Confederate army at Resaca",{"className":"moment","children":[["$","$L15",null,{"seconds":209,"label":"3:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops met the Confederate army at Resaca"}],["$","p",null,{"children":"Advanced Confederate units delayed the U.S. deployment on May 13 while Johnston formed west of town."}]]}]]}],["$","div","Johnston covered the river crossings",{"className":"moment","children":[["$","$L15",null,{"seconds":246,"label":"4:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston covered the river crossings"}],["$","p",null,{"children":"Polk held the left near the Oostanaula, Hardee held the center, and Hood held the right toward the Conasauga River."}]]}]]}],["$","div","The position could be turned downstream",{"className":"moment","children":[["$","$L15",null,{"seconds":343,"label":"5:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"The position could be turned downstream"}],["$","p",null,{"children":"The Oostanaula protected Sherman’s right and offered a route to cross below Resaca and threaten the Western and Atlantic Railroad."}]]}]]}],["$","div","Sherman deployed three armies",{"className":"moment","children":[["$","$L15",null,{"seconds":368,"label":"6:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman deployed three armies"}],["$","p",null,{"children":"McPherson formed on the U.S. right, Thomas in the center, Schofield to the left, and IV Corps on the far left."}]]}]]}],["$","div","Fighting began early on May 14",{"className":"moment","children":[["$","$L15",null,{"seconds":462,"label":"7:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fighting began early on May 14"}],["$","p",null,{"children":"Sherman ordered Thomas Sweeney’s division downstream to find a crossing while the main line pressed the Confederate position."}]]}]]}],["$","div","U.S. attacks failed on the Confederate right-center",{"className":"moment","children":[["$","$L15",null,{"seconds":498,"label":"8:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. attacks failed on the Confederate right-center"}],["$","p",null,{"children":"Assaults by XXIII and XIV Corps caused heavy U.S. losses without taking important ground."}]]}]]}],["$","div","Hood counterattacked the U.S. left",{"className":"moment","children":[["$","$L15",null,{"seconds":509,"label":"8:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood counterattacked the U.S. left"}],["$","p",null,{"children":"The Confederate attack initially advanced against an exposed flank before XX Corps reinforcements stopped it."}]]}]]}],["$","div","U.S. artillery gained a position above the bridges",{"className":"moment","children":[["$","$L15",null,{"seconds":539,"label":"8:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. artillery gained a position above the bridges"}],["$","p",null,{"children":"XV Corps troops took a hill from which artillery could fire on the Resaca crossings."}]]}]]}],["$","div","Sweeney found a crossing at Lay’s Ferry",{"className":"moment","children":[["$","$L15",null,{"seconds":559,"label":"9:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sweeney found a crossing at Lay’s Ferry"}],["$","p",null,{"children":"He concealed pontoon boats near the mouth of Snake Creek while most of the division demonstrated opposite the ferry."}]]}]]}],["$","div","U.S. troops crossed the Oostanaula",{"className":"moment","children":[["$","$L15",null,{"seconds":613,"label":"10:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops crossed the Oostanaula"}],["$","p",null,{"children":"Soldiers of the 65th and 85th Ohio crossed in boats at 5 p.m. and drove away a small Confederate cavalry guard."}]]}]]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}]]}]
