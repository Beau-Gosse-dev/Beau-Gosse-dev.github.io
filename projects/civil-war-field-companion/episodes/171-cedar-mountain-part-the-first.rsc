3e:["$","div","Mosby reports movement from Fort Monroe",{"className":"moment","children":[["$","$L2f",null,{"seconds":933,"label":"15:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mosby reports movement from Fort Monroe"}],["$","p",null,{"children":"Recently exchanged cavalry lieutenant John S. Mosby tells Lee that Burnside’s Federal troops are moving north by water from the Peninsula."}]]}]]}]
3f:["$","div","Lee authorizes a limited offensive",{"className":"moment","children":[["$","$L2f",null,{"seconds":974,"label":"16:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee authorizes a limited offensive"}],["$","p",null,{"children":"Lee permits Jackson to attack an isolated Federal force before Pope receives Burnside and Army of the Potomac reinforcements."}]]}]]}]
40:["$","div","Pope joins his army",{"className":"moment","children":[["$","$L2f",null,{"seconds":1010,"label":"16:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope joins his army"}],["$","p",null,{"children":"At the end of July Pope leaves Washington, inspects the Army of Virginia, and begins preparing an advance against Jackson."}]]}]]}]
41:["$","div","Pope predicts the capture of Gordonsville",{"className":"moment","children":[["$","$L2f",null,{"seconds":1069,"label":"17:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope predicts the capture of Gordonsville"}],["$","p",null,{"children":"On August 3 he tells Halleck that he expects to possess the junction within ten days unless Jackson is heavily reinforced."}]]}]]}]
42:["$","div","The Army of Virginia is ordered to Culpeper",{"className":"moment","children":[["$","$L2f",null,{"seconds":1080,"label":"18:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of Virginia is ordered to Culpeper"}],["$","p",null,{"children":"Pope’s August 6 concentration places his army between the Rappahannock and Rapidan Rivers but does not yet unite all formations around Banks."}]]}]]}]
43:["$","div","McClellan’s withdrawal complicates the timing",{"className":"moment","children":[["$","$L2f",null,{"seconds":1102,"label":"18:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan’s withdrawal complicates the timing"}],["$","p",null,{"children":"Moving the Army of the Potomac from Harrison’s Landing to Fort Monroe and then by water to northern Virginia will take time."}]]}]]}]
44:["$","div","Halleck tells Pope to avoid a disaster",{"className":"moment","children":[["$","$L2f",null,{"seconds":1121,"label":"18:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck tells Pope to avoid a disaster"}],["$","p",null,{"children":"The general in chief wants Pope to hold the river line and await reinforcements instead of exposing the Army of Virginia prematurely."}]]}]]}]
45:["$","div","Federal cavalry covers the concentration",{"className":"moment","children":[["$","$L2f",null,{"seconds":1145,"label":"19:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal cavalry covers the concentration"}],["$","p",null,{"children":"Three newly organized cavalry brigades watch the Rapidan crossings and screen Pope’s troops around Culpeper."}]]}]]}]
46:["$","div","Jackson identifies Banks as isolated",{"className":"moment","children":[["$","$L2f",null,{"seconds":1166,"label":"19:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson identifies Banks as isolated"}],["$","p",null,{"children":"On August 7 Jackson learns that Banks’s II Corps, estimated by the episode at about 11,000 men, is the only major Federal force then at Culpeper."}]]}]]}]
47:["$","div","Jackson orders the advance",{"className":"moment","children":[["$","$L2f",null,{"seconds":1179,"label":"19:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson orders the advance"}],["$","p",null,{"children":"He plans to move through Orange Court House, cross the Rapidan, and attack Banks before the rest of Pope’s army can concentrate."}]]}]]}]
