31:["$","p",null,{"children":"McClellan remains at Harrison’s Landing while reports of Pope’s movement force Lee to consider shifting troops away from Richmond."}]
32:["$","div","Jackson is selected for detached command",{"className":"moment","children":[["$","$L2f",null,{"seconds":490,"label":"8:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson is selected for detached command"}],["$","p",null,{"children":"Lee relies on Jackson’s record of independent command in the Shenandoah Valley despite his poor performance during the Seven Days."}]]}]]}]
33:["$","div","Pope’s orders and Lee’s protest are reviewed",{"className":"moment","children":[["$","$L2f",null,{"seconds":532,"label":"8:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope’s orders and Lee’s protest are reviewed"}],["$","p",null,{"children":"The episode summarizes Pope’s occupation measures and Lee’s unsuccessful attempt to send a retaliatory warning through Halleck."}]]}]]}]
34:["$","div","Pope orders Banks forward",{"className":"moment","children":[["$","$L2f",null,{"seconds":640,"label":"10:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope orders Banks forward"}],["$","p",null,{"children":"On July 12, while Pope is still in Washington, Banks’s II Corps receives orders to move toward Culpeper Court House."}]]}]]}]
35:["$","div","Gordonsville becomes the operational objective",{"className":"moment","children":[["$","$L2f",null,{"seconds":680,"label":"11:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gordonsville becomes the operational objective"}],["$","p",null,{"children":"The rail junction links the Orange & Alexandria Railroad with the Virginia Central route between Richmond and the Shenandoah Valley."}]]}]]}]
36:["$","div","Jackson receives orders for Gordonsville",{"className":"moment","children":[["$","$L2f",null,{"seconds":734,"label":"12:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson receives orders for Gordonsville"}],["$","p",null,{"children":"On July 13 Lee sends Winder’s and Ewell’s divisions, estimated in the episode at about 14,000 men, to oppose Pope’s advance."}]]}]]}]
37:["$","div","Hatch’s railroad raid is ordered",{"className":"moment","children":[["$","$L2f",null,{"seconds":753,"label":"12:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hatch’s railroad raid is ordered"}],["$","p",null,{"children":"Pope directs cavalry commander John P. Hatch to damage the Virginia Central east of Gordonsville, but Hatch organizes a slow combined-arms column."}]]}]]}]
38:["$","div","The raid turns back",{"className":"moment","children":[["$","$L2f",null,{"seconds":784,"label":"13:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The raid turns back"}],["$","p",null,{"children":"Hatch reaches a point about ten miles from Gordonsville, finds Confederate troops occupying the town in strength, and abandons the mission."}]]}]]}]
39:["$","div","Buford replaces Hatch",{"className":"moment","children":[["$","$L2f",null,{"seconds":799,"label":"13:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buford replaces Hatch"}],["$","p",null,{"children":"Pope gives John Buford the cavalry field command and promotion to brigadier general of volunteers."}]]}]]}]
