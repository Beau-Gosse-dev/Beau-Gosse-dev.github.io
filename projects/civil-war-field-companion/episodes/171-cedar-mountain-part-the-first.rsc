3b:["$","div","Hill is sent to reinforce Jackson",{"className":"moment","children":[["$","$L2f",null,{"seconds":855,"label":"14:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hill is sent to reinforce Jackson"}],["$","p",null,{"children":"Lee orders the Light Division north after concluding that McClellan is unlikely to resume an immediate offensive from Harrison’s Landing."}]]}]]}]
3c:["$","div","The Light Division begins arriving",{"className":"moment","children":[["$","$L2f",null,{"seconds":878,"label":"14:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Light Division begins arriving"}],["$","p",null,{"children":"Hill’s approximately 12,000 men reach Gordonsville from July 27 and give Jackson enough strength to consider an attack on part of Pope’s army."}]]}]]}]
