1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",171," · ","July 8–August 7, 1862"," · ","Richmond and Harrison’s Landing in eastern Virginia; Gordonsville, Orange Court House, the Rapidan River crossings, and Culpeper Court House in central Virginia"]}],["$","h1",null,{"children":"CEDAR MOUNTAIN (Part the First)"}],["$","span",null,{"className":"result-label","children":"Operational movement without a battle in this episode. Robert E. Lee sent Thomas J. “Stonewall” Jackson to protect Gordonsville, reinforced him with A. P. Hill’s Light Division, and authorized a limited offensive. On August 7 Jackson began moving toward Nathaniel Banks’s isolated II Corps near Culpeper"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9398256296.mp3?updated=1695419200","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Lee’s post–Seven Days reorganization through Jackson’s August 7 advance"}],["$","small",null,{"children":"The episode establishes the strategic and command situation before the August 9 Battle of Cedar Mountain. It does not describe the battle itself."}]]}],["$","div","Strategic problem",{"children":[["$","span",null,{"children":"Strategic problem"}],["$","strong",null,{"children":"Lee had to watch both McClellan at Harrison’s Landing and Pope in northern Virginia"}],["$","small",null,{"children":"A junction between the Army of the Potomac and the new Army of Virginia would place a much larger Federal force between Richmond and Washington."}]]}],["$","div","Harrison’s Landing",{"children":[["$","span",null,{"children":"Harrison’s Landing"}],["$","strong",null,{"children":"Lee judged McClellan’s position too strong for a direct attack"}],["$","small",null,{"children":"The Army of the Potomac was protected by fieldworks and United States Navy gunfire from the James River. Lee began drawing most of his army back toward Richmond on July 8."}]]}],["$","div","Army repair",{"children":[["$","span",null,{"children":"Army repair"}],["$","strong",null,{"children":"Captured Federal stores helped refit the Army of Northern Virginia"}],["$","small",null,{"children":"Around Richmond, Lee also reviewed the performance of officers and addressed command failures exposed during the Seven Days."}]]}],["$","div","Command reform",{"children":[["$","span",null,{"children":"Command reform"}],["$","strong",null,{"children":"Lee grouped divisions into large commands under Longstreet and Jackson"}],["$","small",null,{"children":"The Confederate formations were called wings or commands because corps had not yet been formally authorized. Formal corps organization followed in November 1862."}]]}],["$","div","Longstreet’s wing",{"children":[["$","span",null,{"children":"Longstreet’s wing"}],["$","strong",null,{"children":"Five divisions under Richard H. Anderson, David R. Jones, Cadmus M. Wilcox, James L. Kemper, and John Bell Hood"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}],"$L26","$L27","$L28","$L29",false,"$L2a","$L2b","$L2c"]}]]}]
2f:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"The episode identifies James Longstreet as commander of the larger of Lee’s two new infantry groupings."}]
f:["$","div","Jackson’s wing",{"children":[["$","span",null,{"children":"Jackson’s wing"}],["$","strong",null,{"children":"Charles S. Winder’s and Richard S. Ewell’s divisions"}],["$","small",null,{"children":"Winder took over Jackson’s former division. Lee initially kept A. P. Hill’s Light Division under his own direction, then sent it to Jackson in late July."}]]}]
10:["$","div","Confederate cavalry",{"children":[["$","span",null,{"children":"Confederate cavalry"}],["$","strong",null,{"children":"J. E. B. Stuart with brigades under Wade Hampton, Fitzhugh Lee, and Beverly H. Robertson"}],["$","small",null,{"children":"The cavalry remained an army-level organization rather than part of either infantry wing."}]]}]
11:["$","div","Leadership changes",{"children":[["$","span",null,{"children":"Leadership changes"}],["$","strong",null,{"children":"John B. Magruder, Benjamin Huger, and Theophilus H. Holmes were removed from prominent field roles"}],["$","small",null,{"children":"Lee’s reorganization included reassignment or removal of senior officers whose Seven Days performance he judged unsatisfactory."}]]}]
12:["$","div","Longstreet–Hill dispute",{"children":[["$","span",null,{"children":"Longstreet–Hill dispute"}],["$","strong",null,{"children":"A newspaper controversy led to Hill’s arrest and preparations for a duel"}],["$","small",null,{"children":"Longstreet objected to a Richmond Examiner account praising Hill’s role at Glendale. Hill then refused communication with Longstreet; Lee intervened before a duel occurred."}]]}]
13:["$","div","Pope’s occupation policy",{"children":[["$","span",null,{"children":"Pope’s occupation policy"}],["$","strong",null,{"children":"Federal troops would requisition supplies and civilians could be held responsible for partisan attacks"}],["$","small",null,{"children":"The episode summarizes Pope’s July orders governing subsistence, guerrilla activity, and civilians. Lee protested the policy to General in Chief Henry W. Halleck."}]]}]
14:["$","div","Federal objective",{"children":[["$","span",null,{"children":"Federal objective"}],["$","strong",null,{"children":"Advance toward Gordonsville through Culpeper Court House"}],["$","small",null,{"children":"Secretary of War Edwin M. Stanton had assigned Pope’s Army of Virginia the task of moving toward Gordonsville. Pope ordered Banks forward on July 12."}]]}]
15:["$","div","Gordonsville",{"children":[["$","span",null,{"children":"Gordonsville"}],["$","strong",null,{"children":"Junction of the Orange & Alexandria and Virginia Central railroads"}],["$","small",null,{"children":"The Virginia Central connected Richmond with the Shenandoah Valley. A Federal seizure or destruction of the junction would damage an important Confederate transport link."}]]}]
16:["$","div","Jackson dispatched",{"children":[["$","span",null,{"children":"Jackson dispatched"}],["$","strong",null,{"children":"Winder’s and Ewell’s divisions moved toward Gordonsville under July 13 orders"}],["$","small",null,{"children":"The episode estimates the two divisions at about 14,000 men. National Park Service summaries likewise identify Lee’s mid-July movement of Jackson to protect the junction."}]]}]
17:["$","div","Hatch’s raid",{"children":[["$","span",null,{"children":"Hatch’s raid"}],["$","strong",null,{"children":"John P. Hatch failed to execute Pope’s intended rapid cavalry strike"}],["$","small",null,{"children":"Hatch took infantry, artillery, baggage, and three days of preparation. The column turned back after finding Confederates in strength near Gordonsville."}]]}]
18:["$","div","Cavalry command change",{"children":[["$","span",null,{"children":"Cavalry command change"}],["$","strong",null,{"children":"John Buford replaced Hatch and became a brigadier general of volunteers"}],["$","small",null,{"children":"Pope removed Hatch from the cavalry assignment after the failed raid and selected a staff officer who would soon become one of the war’s best-known cavalry commanders."}]]}]
19:["$","div","Jackson at Gordonsville",{"children":[["$","span",null,{"children":"Jackson at Gordonsville"}],["$","strong",null,{"children":"His force reached the railroad junction by July 19"}],["$","small",null,{"children":"The Confederate arrival blocked the immediate Federal plan to damage the Virginia Central Railroad."}]]}]
1a:["$","div","Hill reinforces Jackson",{"children":[["$","span",null,{"children":"Hill reinforces Jackson"}],["$","strong",null,{"children":"The Light Division began arriving at Gordonsville on July 27"}],["$","small",null,{"children":"The episode gives Hill about 12,000 men and says the division nearly doubled Jackson’s strength. Official summaries place Jackson’s eventual force in the area at about 24,000."}]]}]
1b:["$","div","Lee’s command warning",{"children":[["$","span",null,{"children":"Lee’s command warning"}],["$","strong",null,{"children":"Lee urged Jackson to consult his division commanders"}],["$","small",null,{"children":"Lee specifically pointed to Hill as an officer with whom Jackson could confer. The advice reflected concern about Jackson’s secrecy and Hill’s forceful temperament."}]]}]
1c:["$","div","Mosby’s intelligence",{"children":[["$","span",null,{"children":"Mosby’s intelligence"}],["$","strong",null,{"children":"John S. Mosby reported Federal troops moving north from the Virginia Peninsula"}],["$","small",null,{"children":"After his prisoner exchange, Mosby described transport activity at Fort Monroe. Lee concluded that Ambrose E. Burnside’s men were moving to reinforce Pope."}]]}]
1d:["$","div","Lee authorizes action",{"children":[["$","span",null,{"children":"Lee authorizes action"}],["$","strong",null,{"children":"Jackson could attack an isolated part of Pope’s army before Federal reinforcements arrived"}],["$","small",null,{"children":"Lee left the timing and location to Jackson’s judgment because the Confederate force was not large enough to attack Pope’s entire army safely."}]]}]
1e:["$","div","Pope takes the field",{"children":[["$","span",null,{"children":"Pope takes the field"}],["$","strong",null,{"children":"Pope joined the Army of Virginia at the end of July"}],["$","small",null,{"children":"After inspecting his command, he prepared to move against Jackson and predicted on August 3 that he would take Gordonsville within ten days unless Jackson received major reinforcements."}]]}]
1f:["$","div","Federal concentration",{"children":[["$","span",null,{"children":"Federal concentration"}],["$","strong",null,{"children":"On August 6 Pope ordered his army toward Culpeper between the Rappahannock and Rapidan"}],["$","small",null,{"children":"Federal cavalry covered river crossings while Pope waited for Burnside and units of the Army of the Potomac."}]]}]
20:["$","div","McClellan’s withdrawal order",{"children":[["$","span",null,{"children":"McClellan’s withdrawal order"}],["$","strong",null,{"children":"Halleck ordered the Army of the Potomac off the Peninsula on August 3"}],["$","small",null,{"children":"The order directed movement by water toward Aquia Creek and a junction with Pope. The episode gives August 4, the date on which the order was sent to McClellan; official Army history dates Halleck’s directive August 3."}]]}]
21:["$","div","Halleck’s restriction",{"children":[["$","span",null,{"children":"Halleck’s restriction"}],["$","strong",null,{"children":"Pope was warned not to risk a disaster before reinforcements arrived"}],["$","small",null,{"children":"The warning conflicted with Pope’s public emphasis on aggressive action and left Banks forward near Culpeper while the rest of the army was still concentrating."}]]}]
22:["$","div","August 7 decision",{"children":[["$","span",null,{"children":"August 7 decision"}],["$","strong",null,{"children":"Jackson moved after learning that Banks’s II Corps was isolated near Culpeper"}],["$","small",null,{"children":"The episode estimates Banks at about 11,000 men. Jackson planned to march through Orange Court House, cross the Rapidan, and attack before other Federal formations joined Banks."}]]}]
23:["$","div","Senior command casualties",{"children":[["$","span",null,{"children":"Senior command casualties"}],["$","strong",null,{"children":"None in the action covered by this episode"}],["$","small",null,{"children":"No battle occurs within the episode’s timeline. The August 9 fighting and its command casualties belong to the next episode’s scope."}]]}]
24:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Second Manassas 1862: Robert E. Lee’s Greatest Victory” by John Langellier"}],["$","small",null,{"children":"The transcript renders the surname approximately as “Lengelier.” The publisher and official podcast listing give John Langellier."}]]}]
25:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"corps, Ewell, Huger, Gordonsville, Charles S. Winder, and John Langellier"}],["$","small",null,{"children":"The automated transcript includes “core,” “Yule,” “U.J.,” “Gordon’sville,” “Winders,” and “Lengelier.” “Johnson decided to strike” at 19:39 refers to Jackson."}]]}]
26:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
27:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","From the James River to Culpeper",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep171-regional-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From the James River to Culpeper at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep171-regional-context.svg","alt":"Generalized schematic map of eastern and central Virginia showing Richmond, Harrison’s Landing, Fort Monroe, Aquia Creek, Fredericksburg, Gordonsville, Culpeper, major rivers, railroads, and July–August 1862 movements.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From the James River to Culpeper"}],["$","span",null,{"children":"McClellan remained at Harrison’s Landing while Pope concentrated toward Culpeper and Gordonsville. Lee sent Jackson north from Richmond, and Federal reinforcements were to move by water from the Peninsula toward Aquia Creek. Railroads, roads, rivers, coastlines, locations, and movement arrows are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep171-regional-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, John Pope’s field-operations map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Opposing concentrations on August 7",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep171-august-7-situation.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Opposing concentrations on August 7 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep171-august-7-situation.svg","alt":"Generalized schematic map of Jackson’s divisions near Gordonsville, Banks’s corps near Culpeper, Orange Court House, Rapidan crossings, Cedar Mountain, and Jackson’s intended northward movement on August 7, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Opposing concentrations on August 7"}],["$","span",null,{"children":"Winder, Ewell, and A. P. Hill were assembled under Jackson near Gordonsville while Banks’s II Corps stood near Culpeper. Jackson planned to move by Orange Court House, cross the Rapidan, and strike before Pope’s army fully concentrated. Positions, unit areas, routes, distances, and arrows are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep171-august-7-situation.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Official Records, John Pope’s maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2d"]}]]}],"$undefined"]}]]}],"$L2e"]}]]}]
28:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The campaign transition is summarized",{"className":"moment","children":[["$","$L2f",null,{"seconds":41,"label":"0:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign transition is summarized"}],["$","p",null,{"children":"The episode connects the end of the Peninsula Campaign with the formation of Pope’s army and the movement toward Second Manassas."}]]}]]}],["$","div","The shift from soft war to hard war is reviewed",{"className":"moment","children":[["$","$L2f",null,{"seconds":82,"label":"1:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The shift from soft war to hard war is reviewed"}],["$","p",null,{"children":"The hosts describe a Federal policy change toward wider use of coercion, confiscation, and emancipation as tools of war."}]]}]]}],["$","div","The intended Federal junction is identified",{"className":"moment","children":[["$","$L2f",null,{"seconds":135,"label":"2:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The intended Federal junction is identified"}],["$","p",null,{"children":"The Army of Virginia and the Army of the Potomac are expected to combine in northern Virginia while McClellan’s future command remains unsettled."}]]}]]}],["$","div","Lee turns to repairing his army",{"className":"moment","children":[["$","$L2f",null,{"seconds":172,"label":"2:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee turns to repairing his army"}],["$","p",null,{"children":"After judging Harrison’s Landing too strong to attack, Lee begins pulling the Army of Northern Virginia back toward Richmond on July 8."}]]}]]}],["$","div","Refitting and reorganization begin",{"className":"moment","children":[["$","$L2f",null,{"seconds":199,"label":"3:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Refitting and reorganization begin"}],["$","p",null,{"children":"Captured supplies help equip Confederate units as Lee addresses the command problems revealed during the Seven Days."}]]}]]}],["$","div","Lee adopts larger commands",{"className":"moment","children":[["$","$L2f",null,{"seconds":248,"label":"4:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee adopts larger commands"}],["$","p",null,{"children":"Lee groups divisions so fewer senior subordinates report directly to him, using wings because Confederate corps are not yet formally authorized."}]]}]]}],["$","div","Longstreet’s and Jackson’s wings are listed",{"className":"moment","children":[["$","$L2f",null,{"seconds":302,"label":"5:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet’s and Jackson’s wings are listed"}],["$","p",null,{"children":"Longstreet receives five divisions; Jackson receives the divisions of Winder and Ewell; Lee temporarily retains A. P. Hill."}]]}]]}],["$","div","The cavalry organization is listed",{"className":"moment","children":[["$","$L2f",null,{"seconds":351,"label":"5:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cavalry organization is listed"}],["$","p",null,{"children":"J. E. B. Stuart remains the overall cavalry commander with brigades led by Wade Hampton, Fitzhugh Lee, and Beverly H. Robertson."}]]}]]}],["$","div","Lee evaluates senior officers",{"className":"moment","children":[["$","$L2f",null,{"seconds":362,"label":"6:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee evaluates senior officers"}],["$","p",null,{"children":"The reorganization removes or reassigns officers Lee considers unsuited to the more responsive army he is building."}]]}]]}],["$","div","Longstreet and Hill clash",{"className":"moment","children":[["$","$L2f",null,{"seconds":396,"label":"6:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet and Hill clash"}],["$","p",null,{"children":"Competing newspaper accounts of Glendale produce a personal dispute, Hill’s arrest for insubordination, and preparations for a duel stopped by Lee."}]]}]]}],["$","div","Lee weighs two Federal threats",{"className":"moment","children":[["$","$L2f",null,{"seconds":442,"label":"7:22"}],["$","div",null,{"children":["$L30","$L31"]}]]}],"$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48"]}]]}]
29:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","General in Chief of the United States Army",{"className":"command-entry","children":[["$","strong",null,{"children":"General in Chief of the United States Army"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Coordinated the intended junction of Pope and McClellan; warned Pope not to expose his army before reinforcements arrived"}]]}],["$","div","Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"I Corps under Franz Sigel, II Corps under Nathaniel P. Banks, and III Corps under Irvin McDowell; ordered the August concentration at Culpeper"}]]}],["$","div","II Corps, Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"The forward Federal formation near Culpeper; approximately 11,000 men in the episode’s account"}]]}],["$","div","Cavalry brigade attached to Banks’s corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry brigade attached to Banks’s corps"}],["$","span",null,{"children":"Brig. Gen. John P. Hatch, then Brig. Gen. John Buford"}],["$","small",null,{"children":"Hatch failed to conduct the intended rapid railroad raid; Pope replaced him with Buford before the August operations"}]]}],["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Ge