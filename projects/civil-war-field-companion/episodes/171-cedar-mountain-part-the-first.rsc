2a:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep171-regional-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep171-regional-context.svg","alt":"Generalized regional map of Federal and Confederate movements between the James River, Richmond, Gordonsville, and Culpeper.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Lee used the Richmond defenses and McClellan’s inactivity to shift Jackson toward Gordonsville while Pope’s army moved south. This map is schematic and not to scale."}]]}],["$","figure","/images/ep171-august-7-situation.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep171-august-7-situation.svg","alt":"Generalized operational map of Jackson near Gordonsville and Banks near Culpeper on August 7, 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson had three divisions near Gordonsville and moved toward Banks’s isolated corps near Culpeper. This map is schematic and not to scale."}]]}],["$","figure","/images/ep171-army-of-virginia-operations-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep171-army-of-virginia-operations-map.jpg","alt":"Historical map of the Army of Virginia campaign area during July and August 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This general map of the campaign area accompanied John Pope’s report to Congress and was published in 1866."}]]}],["$","figure","/images/ep171-cedar-mountain-battlefield.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep171-cedar-mountain-battlefield.jpg","alt":"Timothy O’Sullivan stereograph showing the Cedar Mountain battlefield with the mountain in the distance.",