15:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L2b","/images/ep205-corinth-field-fortifications.jpg",{"image":"/images/ep205-corinth-field-fortifications.jpg","alt":"Manuscript military map of Union approaches and Confederate defenses around Corinth in May 1862.","caption":"Primary-source map: the colored approach and defense lines show why Corinth was a siege of fieldworks and careful movement rather than a single set-piece assault.","name":"Manuscript military map of Union approaches and Confederate defenses around Corinth in May 1862.","source":"$undefined","credit":"Library of Congress Geography and Map Division."}],["$","$L2b","/images/ep205-ormsby-mitchel-portrait.jpg",{"image":"/images/ep205-ormsby-mitchel-portrait.jpg","alt":"Nineteenth-century full-length lithographic portrait of United States Brigadier General Ormsby M. Mitchel in uniform.","caption":"Contextual image: this Currier & Ives portrait identifies the division commander whose exposed northern Alabama operations anchor the episode’s eastern flank.","name":"Nineteenth-century full-length lithographic portrait of United States Brigadier General Ormsby M. Mitchel in uniform.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division."}],["$","$L2b","/images/ep205-cumberland-gap-view.jpg",{"image":"/images/ep205-cumberland-gap-view.jpg","alt":"An 1862 lithographic view looking north through Cumberland Gap.","caption":"Contextual image: the contemporary lithograph is an interpreted landscape, not a photograph, but it makes the pass’s restrictive terrain immediately legible.","name":"An 1862 lithographic view looking north through Cumberland Gap.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division."}],["$","$L2b","/images/ep205-battle-of-memphis.jpg",{"image":"/images/ep205-battle-of-memphis.jpg",