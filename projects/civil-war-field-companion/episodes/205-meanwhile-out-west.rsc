3e:["$","div","The New Mexico invasion fails",{"className":"moment","children":[["$","$L33",null,{"seconds":488,"label":"8:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The New Mexico invasion fails"}],["$","p",null,{"children":"Logistical collapse and United States resistance end the Confederate attempt to carry the war north through New Mexico Territory."}]]}]]}]
3f:["$","div","Success creates a consolidation problem",{"className":"moment","children":[["$","$L33",null,{"seconds":573,"label":"9:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Success creates a consolidation problem"}],["$","p",null,{"children":"The episode pivots from victories to the difficulty of holding a wide western theater and sustaining further advances."}]]}]]}]
40:["$","div","Halleck disperses the Corinth concentration",{"className":"moment","children":[["$","$L33",null,{"seconds":599,"label":"9:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck disperses the Corinth concentration"}],["$","p",null,{"children":"Troops are assigned to key towns and supply routes rather than kept together for an immediate plunge south."}]]}]]}]
41:["$","div","Logistics becomes the episode’s central subject",{"className":"moment","children":[["$","$L33",null,{"seconds":614,"label":"10:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Logistics becomes the episode’s central subject"}],["$","p",null,{"children":"Rivers, railroads, roads, depots, and the distance from northern supply sources determine what the armies can do."}]]}]]}]
42:["$","div","The southbound railroad bottleneck appears",{"className":"moment","children":[["$","$L33",null,{"seconds":640,"label":"10:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"The southbound railroad bottleneck appears"}],["$","p",null,{"children":"Beyond the Corinth junction, a very large United States army would depend heavily on the Mobile & Ohio route into central Mississippi."}]]}]]}]
43:["$","div","The army reaches the end of its immediate reach",{"className":"moment","children":[["$","$L33",null,{"seconds":657,"label":"10:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army reaches the end of its immediate reach"}],["$","p",null,{"children":"The episode describes the captured network as the practical limit of the spring advance."}]]}]]}]
44:["$","div","The Upper South’s advantages are listed",{"className":"moment","children":[["$","$L33",null,{"seconds":661,"label":"11:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Upper South’s advantages are listed"}],["$","p",null,{"children":"Established settlement, roads, railroads, nearby northern territory, and navigable rivers help sustain occupation."}]]}]]}]
45:["$","div","Three rivers carried the advance",{"className":"moment","children":[["$","$L33",null,{"seconds":684,"label":"11:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Three rivers carried the advance"}],["$","p",null,{"children":"The Tennessee, Cumberland, and Mississippi offered deep transportation corridors for troops and supplies."}]]}]]}]
46:["$","div","The Deep South presents a different problem",{"className":"moment","children":[["$","$L33",null,{"seconds":696,"label":"11:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Deep South presents a different problem"}],["$","p",null,{"children":"Greater distances and weaker inland transport make broad occupation and supply much harder."}]]}]]}]
47:["$","div","Settlement and terrain shape supply",{"className":"moment","children":[["$","$L33",null,{"seconds":715,"label":"11:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Settlement and terrain shape supply"}],["$","p",null,{"children":"Plantations, pine forests, scattered farms, and long distances separate the Deep South’s limited urban centers."}]]}]]}]
48:["$","div","Railroad coverage thins",{"className":"moment","children":[["$","$L33",null,{"seconds":734,"label":"12:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Railroad coverage thins"}],["$","p",null,{"children":"Few cities and large areas without rail lines reduce the routes available to an advancing army."}]]}]]}]
49:["$","div","Interior rivers offer little replacement",{"className":"moment","children":[["$","$L33",null,{"seconds":744,"label":"12:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Interior rivers offer little replacement"}],["$","p",null,{"children":"Many Alabama and Mississippi rivers are shallow or useful only farther south, leaving the Mississippi as the principal deep penetration."}]]}]]}]
4a:["$","div","The landlocked interior resists mass movement",{"className":"moment","children":[["$","$L33",null,{"seconds":764,"label":"12:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The landlocked interior resists mass movement"}],["$","p",null,{"children":"Feeding and maneuvering large armies away from navigable water and rail becomes a defining constraint."}]]}]]}]
4b:["$","div","Occupation strategy reaches its limit",{"className":"moment","children":[["$","$L33",null,{"seconds":782,"label":"13:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Occupation strategy reaches its limit"}],["$","p",null,{"children":"The dispersed garrison model used in the Upper South cannot simply be extended across the entire Deep South."}]]}]]}]
4c:["$","div","Geography dictates the next strategy",{"className":"moment","children":[["$","$L33",null,{"seconds":817,"label":"13:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Geography dictates the next strategy"}],["$","p",null,{"children":"Commanders must select important objectives and prepare narrow campaigns capable of being supplied."}]]}]]}]
4d:["$","div","Two future corridors are identified",{"className":"moment","children":[["$","$L33",null,{"seconds":832,"label":"13:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two future corridors are identified"}],["$","p",null,{"children":"The Mississippi River and the railroad route from Chattanooga toward Atlanta illustrate the restricted axes available."}]]}]]}]
4e:["$","div","Movement becomes a measure of success",{"className":"moment","children":[["$","$L33",null,{"seconds":861,"label":"14:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Movement becomes a measure of success"}],["$","p",null,{"children":"In the vast western theater, shifting and supplying armies across the map matters as much as battlefield combat."}]]}]]}]
4f:["$","div","The Corinth pause is reconsidered",{"className":"moment","children":[["$","$L33",null,{"seconds":951,"label":"15:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Corinth pause is reconsidered"}],["$","p",null,{"children":"After the advertisement break, the hosts argue that Halleck had legitimate supply reasons not to rush south."}]]}]]}]
50:["$","div","Beauregard waits at Tupelo",{"className":"moment","children":[["$","$L33",null,{"seconds":958,"label":"15:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Beauregard waits at Tupelo"}],["$","p",null,{"children":"The Confederate army is about sixty miles away, but pursuit would extend the United States army along a narrow supply route."}]]}]]}]
51:["$","div","The cost of one vulnerable rail line",{"className":"moment","children":[["$","$L33",null,{"seconds":967,"label":"16:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cost of one vulnerable rail line"}],["$","p",null,{"children":"Food, ammunition, reinforcements, and evacuation of sick and wounded would all compete for the same corridor."}]]}]]}]
52:["$","div","Halleck looks west and east",{"className":"moment","children":[["$","$L33",null,{"seconds":1015,"label":"16:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck looks west and east"}],["$","p",null,{"children":"He gives priority to consolidating gains and supporting exposed commands rather than pursuing directly south."}]]}]]}]
53:["$","div","Curtis is isolated in Arkansas",{"className":"moment","children":[["$","$L33",null,{"seconds":1031,"label":"17:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Curtis is isolated in Arkansas"}],["$","p",null,{"children":"The Army of the Southwest is deep in hostile territory after Pea Ridge while Van Dorn has moved east to Corinth."}]]}]]}]
54:["$","div","The Rolla supply line stretches beyond 200 miles",{"className":"moment","children":[["$","$L33",null,{"seconds":1052,"label":"17:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Rolla supply line stretches beyond 200 miles"}],["$","p",null,{"children":"Wagon trains must cross the Ozarks to support Curtis at Batesville."}]]}]]}]
55:["$","div","Little Rock is abandoned as an immediate objective",{"className":"moment","children":[["$","$L33",null,{"seconds":1065,"label":"17:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Little Rock is abandoned as an immediate objective"}],["$","p",null,{"children":"Curtis cuts loose from the failing overland line and turns southeast for Helena and river supply."}]]}]]}]
56:["$","div","A White River supply effort narrowly misses",{"className":"moment","children":[["$","$L33",null,{"seconds":1080,"label":"18:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"A White River supply effort narrowly misses"}],["$","p",null,{"children":"Halleck’s relief fleet does not make the intended junction with Curtis’s moving army."}]]}]]}]
57:["$","div","Curtis reaches Helena",{"className":"moment","children":[["$","$L33",null,{"seconds":1085,"label":"18:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Curtis reaches Helena"}],["$","p",null,{"children":"After living off the countryside, the Army of the Southwest arrives on July 12 and regains a dependable river connection."}]]}]]}]
58:["$","div","The strategic view turns east",{"className":"moment","children":[["$","$L33",null,{"seconds":1104,"label":"18:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The strategic view turns east"}],["$","p",null,{"children":"Holding Tennessee proves more complicated than relieving Curtis because both sides had stripped broad areas to concentrate at Shiloh and Corinth."}]]}]]}]
59:["$","div","Large parts of Tennessee lack firm control",{"className":"moment","children":[["$","$L33",null,{"seconds":1128,"label":"18:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Large parts of Tennessee lack firm control"}],["$","p",null,{"children":"Outside Nashville and scattered posts, isolated detachments and contested countryside remain."}]]}]]}]
5a:["$","div","Mitchel’s exposed division is introduced",{"className":"moment","children":[["$","$L33",null,{"seconds":1145,"label":"19:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mitchel’s exposed division is introduced"}],["$","p",null,{"children":"About 8,000 Army of the Ohio troops have penetrated northern Alabama while Buell’s main body operated farther west."}]]}]]}]
5b:["$","div","Huntsville sits on the east-west railroad",{"className":"moment","children":[["$","$L33",null,{"seconds":1160,"label":"19:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Huntsville sits on the east-west railroad"}],["$","p",null,{"children":"Mitchel occupies a point on the Memphis & Charleston line connecting Corinth and Chattanooga."}]]}]]}]
5c:["$","div","Mitchel lives hand to mouth",{"className":"moment","children":[["$","$L33",null,{"seconds":1177,"label":"19:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mitchel lives hand to mouth"}],["$","p",null,{"children":"His command relies on wagon supply from Nashville, local forage, and aggressive patrols against guerrillas."}]]}]]}]
5d:["$","div","Kirby Smith is also overextended",{"className":"moment","children":[["$","$L33",null,{"seconds":1209,"label":"20:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kirby Smith is also overextended"}],["$","p",null,{"children":"The largest nearby Confederate command is dispersed across eastern Tennessee from Cumberland Gap to Chattanooga."}]]}]]}]
5e:["$","div","Morgan takes Cumberland Gap",{"className":"moment","children":[["$","$L33",null,{"seconds":1232,"label":"20:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Morgan takes Cumberland Gap"}],["$","p",null,{"children":"A United States division maneuvers against the pass in June and enters after the Confederate garrison withdraws."}]]}]]}]
5f:["$","div","The Gap opens an approach to Knoxville",{"className":"moment","children":[["$","$L33",null,{"seconds":1243,"label":"20:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Gap opens an approach to Knoxville"}],["$","p",null,{"children":"Possession threatens eastern Tennessee and the railroad connection toward Virginia."}]]}]]}]
60:["$","div","Chattanooga is endangered",{"className":"moment","children":[["$","$L33",null,{"seconds":1259,"label":"20:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Chattanooga is endangered"}],["$","p",null,{"children":"The combined pressure from northern Alabama and Cumberland Gap makes Kirby Smith’s eastern Tennessee position precarious."}]]}]]}]
61:["$","div","Chattanooga is the gateway to Georgia",{"className":"moment","children":[["$","$L33",null,{"seconds":1269,"label":"21:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Chattanooga is the gateway to Georgia"}],["$","p",null,{"children":"Its railroads and Tennessee River position could sustain a future United States invasion of the southeastern Confederacy."}]]}]]}]
62:["$","div","The east-west Confederate link runs through the city",{"className":"moment","children":[["$","$L33",null,{"seconds":1283,"label":"21:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"The east-west Confederate link runs through the city"}],["$","p",null,{"children":"Rail connections through Chattanooga help tie Virginia to the western Confederacy."}]]}]]}]
63:["$","div","Terrain reinforces Chattanooga’s value",{"className":"moment","children":[["$","$L33",null,{"seconds":1292,"label":"21:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Terrain reinforces Chattanooga’s value"}],["$","p",null,{"children":"The river, railroad junction, and surrounding mountains make the city a true strategic point."}]]}]]}]
64:["$","div","Halleck prepares a Chattanooga advance",{"className":"moment","children":[["$","$L33",null,{"seconds":1302,"label":"21:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck prepares a Chattanooga advance"}],["$","p",null,{"children":"By mid-June, the next intended move is east from Corinth and then into Georgia."}]]}]]}]
65:["$","div","Buell’s assignment sets up the next episode",{"className":"moment","children":[["$","$L33",null,{"seconds":1314,"label":"21:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell’s assignment sets up the next episode"}],["$","p",null,{"children":"The Army of the Ohio is directed toward Chattanooga, carrying the western story into its next phase."}]]}]]}]
66:["$","div","The book recommendation begins",{"className":"moment","children":[["$","$L33",null,{"seconds":1332,"label":"22:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"The book recommendation begins"}],["$","p",null,{"children":"The hosts recommend “The New York Times Disunion: A History of the Civil War,” edited by Ted Widmer."}]]}]]}]
