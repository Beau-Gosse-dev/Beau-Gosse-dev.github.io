d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",205," · ","February–July 1862, with a preview of the western campaigns of late 1862"," · ","The western theater from Missouri and Arkansas to Kentucky, Tennessee, Mississippi, Alabama, and the Appalachian gateway at Cumberland Gap"]}],["$","h1",null,{"children":"\"MEANWHILE, OUT WEST...\""}],["$","span",null,{"className":"result-label","children":"By early summer 1862, United States forces had broken the Confederacy’s first western defensive line, occupied Nashville, seized the railroad junction at Corinth, won control of Memphis, reached Helena on the Mississippi, occupied northern Alabama, and taken Cumberland Gap. Those gains did not produce an immediate drive into the Deep South. Henry W. Halleck dispersed forces to secure a long river-and-rail supply network, while distance, weak transportation links, and Confederate positions at Vicksburg, eastern Tennessee, and Chattanooga limited the next advances. The pause gave Confederate commanders time to prepare counteroffensives in Kentucky, Tennessee, and Mississippi"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"February–July 1862, with a preview of the western campaigns of late 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"The western theater from Missouri and Arkansas to Kentucky, Tennessee, Mississippi, Alabama, and the Appalachian gateway at Cumberland Gap"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"By early summer 1862, United States forces had broken the Confederacy’s first western defensive line, occupied Nashville, seized the railroad junction at Corinth, won control of Memphis, reached Helena on the Mississippi, occupied northern Alabama, and taken Cumberland Gap. Those gains did not produce an immediate drive into the Deep South. Henry W. Halleck dispersed forces to secure a long river-and-rail supply network, while distance, weak transportation links, and Confederate positions at Vicksburg, eastern Tennessee, and Chattanooga limited the next advances. The pause gave Confederate commanders time to prepare counteroffensives in Kentucky, Tennessee, and Mississippi"}]]}]]}],false,"$Lf","$undefined"]}],"$L10","$L11","$L12",false,"$L13","$L14","$L15","$L16","$L17","$L18"]}]]}]
