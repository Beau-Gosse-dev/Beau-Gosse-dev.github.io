f:["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","United States concentration",{"children":[["$","th",null,{"scope":"row","children":"United States concentration"}],["$","td",null,{"children":["More than 100,000 soldiers in three armies",["$","small",null,{"style":{"display":"block"},"children":"Halleck personally assembled Grant’s Army of the Tennessee, Buell’s Army of the Ohio, and Pope’s Army of the Mississippi for the advance on Corinth. National Park Service interpretation gives the combined strength as about 120,000."}]]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/category/1862/page/5/",{"href":"https://civilwarpodcast.org/category/1862/page/5/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 205 page"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-7.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-7.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Civil War in the Western Theater, 1862"]}],["$","a","https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/",{"href":"https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Civil War campaign summaries"]}],["$","a","https://www.nps.gov/shil/planyourvisit/corinth.htm",{"href":"https://www.nps.gov/shil/planyourvisit/corinth.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Corinth Battlefield Unit"]}],["$","a","https://www.nps.gov/articles/the-siege-and-battle-of-corinth-a-new-kind-of-war-teaching-with-historic-places.htm",{"href":"https://www.nps.gov/articles/the-siege-and-battle-of-corinth-a-new-kind-of-war-teaching-with-historic-places.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: The Siege and Battle of Corinth"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ms016",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ms016","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service battle detail: Corinth I"]}],["$","a","https://www.loc.gov/item/99446429/",{"href":"https://www.loc.gov/item/99446429/","target":"_blank","rel":"noreferrer","children":[" · ","Primary-source map: field fortifications around Corinth"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=tn004",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=tn004","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service battle detail: Memphis I"]}],["$","a","https://www.loc.gov/item/2004667779/",{"href":"https://www.loc.gov/item/2004667779/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: The Battle of Memphis, looking south"]}],["$","a","https://www.nps.gov/peri/planyourvisit/the-pea-ridge-campaign.htm",{"href":"https://www.nps.gov/peri/planyourvisit/the-pea-ridge-campaign.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: The Pea Ridge Campaign"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]]}]
