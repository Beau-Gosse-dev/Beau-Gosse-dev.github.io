6a:["$","section","Confederate western command",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederate western command"}],[["$","div","Confederate president and commander in chief-President Jefferson Davis",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate president and commander in chief"}],["$","span",null,{"children":"President Jefferson Davis"}],["$","small",null,{"children":"Set national strategy and appointed the senior commanders responsible for the western departments"}]]}],["$","div","Western Department until mortally wounded at Shiloh-Gen. Albert Sidney Johnston",{"className":"command-entry","children":[["$","strong",null,{"children":"Western Department until mortally wounded at Shiloh"}],["$","span",null,{"children":"Gen. Albert Sidney Johnston"}],["$","small",null,{"children":"Concentrated the Confederate army at Corinth and attacked Grant on April 6"}]]}],["$","div","Army of the Mississippi after Johnston’s death-Gen. P. G. T. Beauregard",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Mississippi after Johnston’s death"}],["$","span",null,{"children":"Gen. P. G. T. Beauregard"}],["$","small",null,{"children":"Retreated from Shiloh, defended Corinth, and evacuated the army to Tupelo"}]]}],["$","div","Army of the Mississippi from June 1862-Gen. Braxton Bragg",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Mississippi from June 1862"}],["$","span",null,{"children":"Gen. Braxton Bragg"}],["$","small",null,{"children":"Succeeded Beauregard and prepared the Confederate return to the strategic offensive"}]]}],["$","div","Army of the West-Maj. Gen. Earl Van Dorn",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the West"}],["$","span",null,{"children":"Maj. Gen. Earl Van Dorn"}],["$","small",null,{"children":"Commanded at Pea Ridge, then transferred his army east to reinforce the Corinth concentration"}]]}],["$","div","Department of East Tennessee-Maj. Gen. Edmund Kirby Smith",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of East Tennessee"}],["$","span",null,{"children":"Maj. Gen. Edmund Kirby Smith"}],["$","small",null,{"children":"Held the line from Cumberland Gap through Knoxville to Chattanooga; Carter L. Stevenson commanded the Gap garrison"}]]}]]]}]
