1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",205," · ","February–July 1862, with a preview of the western campaigns of late 1862"," · ","The western theater from Missouri and Arkansas to Kentucky, Tennessee, Mississippi, Alabama, and the Appalachian gateway at Cumberland Gap"]}],["$","h1",null,{"children":"\"MEANWHILE, OUT WEST...\""}],["$","span",null,{"className":"result-label","children":"By early summer 1862, United States forces had broken the Confederacy’s first western defensive line, occupied Nashville, seized the railroad junction at Corinth, won control of Memphis, reached Helena on the Mississippi, occupied northern Alabama, and taken Cumberland Gap. Those gains did not produce an immediate drive into the Deep South. Henry W. Halleck dispersed forces to secure a long river-and-rail supply network, while distance, weak transportation links, and Confederate positions at Vicksburg, eastern Tennessee, and Chattanooga limited the next advances. The pause gave Confederate commanders time to prepare counteroffensives in Kentucky, Tennessee, and Mississippi"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2230105762.mp3?updated=1695589003","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"A strategic reset in the western theater after Shiloh and Corinth"}],["$","small",null,{"children":"The episode surveys the position reached by mid-1862 and introduces the geographic and logistical constraints behind the Kentucky, Corinth, and Stones River campaigns covered next."}]]}],["$","div","Upper South at stake",{"children":[["$","span",null,{"children":"Upper South at stake"}],["$","strong",null,{"children":"Kentucky and Tennessee linked population, food production, rivers, roads, and railroads"}],["$","small",null,{"children":"Holding the region protected the Confederate interior; losing it placed United States armies near Mississippi, Alabama, Georgia, and the principal east-west railroad through Chattanooga."}]]}],["$","div","Three campaigns previewed",{"children":[["$","span",null,{"children":"Three campaigns previewed"}],["$","strong",null,{"children":"Bragg in Kentucky, Van Dorn at Corinth, and Rosecrans at Stones River"}],["$","small",null,{"children":"The episode previews Confederate attempts to recover the initiative and the United States response. It does not narrate those campaigns in detail."}]]}],["$","div","Opening victories",{"children":[["$","span",null,{"children":"Opening victories"}],["$","strong",null,{"children":"Forts Henry and Donelson fell in February 1862"}],["$","small",null,{"children":"The collapse of the Tennessee and Cumberland River positions forced the Confederacy to abandon Kentucky and much of Middle and West Tennessee."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}],"$L28","$undefined","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}]]}]
33:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Nashville occupied",{"children":[["$","span",null,{"children":"Nashville occupied"}],["$","strong",null,{"children":"First Confederate state capital captured by United States forces"}],["$","small",null,{"children":"Advance elements of the Army of the Ohio reached Nashville on February 23, and Don Carlos Buell accepted the city’s formal surrender on February 25. Nashville remained an essential United States supply base."}]]}]
f:["$","div","Shiloh",{"children":[["$","span",null,{"children":"Shiloh"}],["$","strong",null,{"children":"April 6–7, 1862; United States victory after a Confederate surprise attack"}],["$","small",null,{"children":"Albert Sidney Johnston was mortally wounded on April 6. P. G. T. Beauregard assumed command, and the reinforced United States armies drove his force back toward Corinth on April 7."}]]}]
10:["$","div","Why Corinth mattered",{"children":[["$","span",null,{"children":"Why Corinth mattered"}],["$","strong",null,{"children":"The Memphis & Charleston and Mobile & Ohio railroads crossed there"}],["$","small",null,{"children":"The east-west line linked the Mississippi Valley with Chattanooga and the Atlantic states; the north-south line connected western Tennessee with central Mississippi and Mobile."}]]}]
11:["$","div","United States concentration",{"children":[["$","span",null,{"children":"United States concentration"}],["$","strong",null,{"children":"More than 100,000 soldiers in three armies"}],["$","small",null,{"children":"Halleck personally assembled Grant’s Army of the Tennessee, Buell’s Army of the Ohio, and Pope’s Army of the Mississippi for the advance on Corinth. National Park Service interpretation gives the combined strength as about 120,000."}]]}]
12:["$","div","Siege of Corinth",{"children":[["$","span",null,{"children":"Siege of Corinth"}],["$","strong",null,{"children":"April 29–May 30, 1862"}],["$","small",null,{"children":"Halleck advanced slowly, entrenched after successive movements, and approached the Confederate defenses without risking the kind of surprise suffered at Shiloh."}]]}]
13:["$","div","Confederate evacuation",{"children":[["$","span",null,{"children":"Confederate evacuation"}],["$","strong",null,{"children":"Beauregard withdrew to Tupelo during the night of May 29–30"}],["$","small",null,{"children":"Outnumbered and suffering from disease and poor water, the Confederates removed troops and supplies by rail while deceptive cheering, train noise, campfires, and dummy guns concealed the movement."}]]}]
14:["$","div","Strategic gain, incomplete destruction",{"children":[["$","span",null,{"children":"Strategic gain, incomplete destruction"}],["$","strong",null,{"children":"The United States took Corinth; Beauregard preserved his army"}],["$","small",null,{"children":"Halleck secured the railroad crossing and northern Mississippi position, but the Confederate field army escaped roughly sixty miles south to Tupelo."}]]}]
15:["$","div","Fort Pillow and Memphis",{"children":[["$","span",null,{"children":"Fort Pillow and Memphis"}],["$","strong",null,{"children":"Fort Pillow was evacuated June 4; Memphis fell June 6"}],["$","small",null,{"children":"At Memphis, Flag Officer Charles H. Davis’s gunboats and Col. Charles Ellet’s rams destroyed or captured all but one vessel of the Confederate River Defense Fleet. United States forces then occupied the city."}]]}]
16:["$","div","Mississippi River remained contested",{"children":[["$","span",null,{"children":"Mississippi River remained contested"}],["$","strong",null,{"children":"Memphis opened another long reach of river, but Vicksburg still blocked complete control"}],["$","small",null,{"children":"The episode also names Port Hudson. Confederate forces did not begin fortifying Port Hudson until later in 1862, so it should not be treated as an established strongpoint at the exact moment Memphis fell."}]]}]
17:["$","div","Pea Ridge",{"children":[["$","span",null,{"children":"Pea Ridge"}],["$","strong",null,{"children":"March 7–8, 1862; United States victory in northwest Arkansas"}],["$","small",null,{"children":"Samuel R. Curtis defeated Earl Van Dorn’s larger Confederate army. The victory secured Missouri for the United States and ended the immediate Confederate effort to recover that state."}]]}]
18:["$","div","New Mexico campaign",{"children":[["$","span",null,{"children":"New Mexico campaign"}],["$","strong",null,{"children":"The Confederate invasion failed after Glorieta Pass, March 26–28"}],["$","small",null,{"children":"United States troops destroyed the Confederate supply train at Johnson’s Ranch. Without those supplies, Henry H. Sibley’s force abandoned its advance toward Fort Union and ultimately retreated to Texas."}]]}]
19:["$","div","Why Halleck paused",{"children":[["$","span",null,{"children":"Why Halleck paused"}],["$","strong",null,{"children":"The newly occupied network had to be supplied and defended"}],["$","small",null,{"children":"Halleck dispersed troops among key towns, railroads, rivers, and depots rather than moving his entire concentration south after Beauregard."}]]}]
1a:["$","div","Corinth’s railroad distinction",{"children":[["$","span",null,{"children":"Corinth’s railroad distinction"}],["$","strong",null,{"children":"A junction of two lines, but only one principal rail corridor continued south"}],["$","small",null,{"children":"The Mobile & Ohio Railroad offered the main rail penetration from Corinth toward Tupelo and central Mississippi. Moving a very large army along that single axis created a different problem from occupying the well-connected Upper South."}]]}]
1b:["$","div","Upper South logistics",{"children":[["$","span",null,{"children":"Upper South logistics"}],["$","strong",null,{"children":"Shorter distances and a denser transportation network"}],["$","small",null,{"children":"The Tennessee, Cumberland, and Mississippi Rivers, together with established roads and railroads, allowed United States forces to move inland and receive supplies from northern bases."}]]}]
1c:["$","div","Deep South logistics",{"children":[["$","span",null,{"children":"Deep South logistics"}],["$","strong",null,{"children":"Longer distances, fewer towns, thinner rail coverage, and limited navigable interior rivers"}],["$","small",null,{"children":"The episode contrasts the Deep South’s landlocked interior with the Upper South. Large armies could not occupy every locality; campaigns had to follow selected rivers, railroads, and strategically valuable corridors."}]]}]
1d:["$","div","Narrow axes of advance",{"children":[["$","span",null,{"children":"Narrow axes of advance"}],["$","strong",null,{"children":"The Mississippi River and the Chattanooga–Atlanta railroad corridor"}],["$","small",null,{"children":"The map logic of the western war concentrated future operations along transportation lines capable of sustaining armies over great distances."}]]}]
1e:["$","div","Curtis’s supply problem",{"children":[["$","span",null,{"children":"Curtis’s supply problem"}],["$","strong",null,{"children":"A wagon route of more than 200 miles from Rolla, Missouri"}],["$","small",null,{"children":"At Batesville, Curtis’s Army of the Southwest could not sustain an advance on Little Rock through an increasingly disrupted overland supply line."}]]}]
1f:["$","div","Curtis reaches Helena",{"children":[["$","span",null,{"children":"Curtis reaches Helena"}],["$","strong",null,{"children":"July 12, 1862"}],["$","small",null,{"children":"Curtis cut loose from his Rolla supply line, lived off the countryside, and marched to the Mississippi. Helena restored river supply and became an advanced United States base south of Memphis."}]]}]
20:["$","div","Civilian cost of Curtis’s march",{"children":[["$","span",null,{"children":"Civilian cost of Curtis’s march"}],["$","strong",null,{"children":"Foraging and destruction accompanied the movement to Helena"}],["$","small",null,{"children":"National Park Service accounts describe the army taking food and destroying property deemed economically or militarily useful to the Confederacy. Thousands of enslaved people also reached the army and moved toward freedom."}]]}]
21:["$","div","Mitchel in northern Alabama",{"children":[["$","span",null,{"children":"Mitchel in northern Alabama"}],["$","strong",null,{"children":"Huntsville occupied April 11, 1862"}],["$","small",null,{"children":"Ormsby M. Mitchel’s division of the Army of the Ohio seized Huntsville and sections of the Memphis & Charleston Railroad while Buell moved toward Shiloh. The division remained exposed and depended on a long route from Nashville, local forage, and aggressive patrols."}]]}]
22:["$","div","Kirby Smith’s position",{"children":[["$","span",null,{"children":"Kirby Smith’s position"}],["$","strong",null,{"children":"A thin Confederate line across eastern Tennessee"}],["$","small",null,{"children":"Edmund Kirby Smith had to cover approaches from Cumberland Gap through Knoxville to Chattanooga with a force the episode estimates at fewer than 10,000."}]]}]
23:["$","div","Cumberland Gap taken",{"children":[["$","span",null,{"children":"Cumberland Gap taken"}],["$","strong",null,{"children":"George W. Morgan occupied it June 18, 1862"}],["$","small",null,{"children":"Morgan maneuvered through mountain passes to threaten the Confederate position. Carter L. Stevenson withdrew his garrison, allowing Morgan’s 7th Division to enter without a major battle."}]]}]
24:["$","div","What the Gap offered",{"children":[["$","span",null,{"children":"What the Gap offered"}],["$","strong",null,{"children":"A route toward Knoxville and the Virginia–Tennessee railroad"}],["$","small",null,{"children":"The mountain pass could protect Kentucky, support Unionists in East Tennessee, and serve as a staging point for an advance against Confederate rail communications."}]]}]
25:["$","div","Why Chattanooga mattered",{"children":[["$","span",null,{"children":"Why Chattanooga mattered"}],["$","strong",null,{"children":"River crossing, railroad junction, mountain gateway, and supply hub"}],["$","small",null,{"children":"Lines through Chattanooga connected Virginia with the western Confederacy and opened a route toward Atlanta and Georgia. Its terrain also made direct operations difficult."}]]}]
26:["$","div","Next operational move",{"children":[["$","span",null,{"children":"Next operational move"}],["$","strong",null,{"children":"Halleck directed Buell east from Corinth toward Chattanooga"}],["$","small",null,{"children":"The episode ends in mid-June with the intended seizure of Chattanooga. The slow advance and Confederate response belong to the next phase of the western story."}]]}]
27:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The New York Times Disunion: A History of the Civil War,” edited by Ted Widmer"}],["$","small",null,{"children":"The volume collects selections from the New York Times Disunion series, which ran during the Civil War sesquicentennial."}]]}]
28:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
29:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The western theater’s strategic network in mid-1862",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep205-western-theater-network.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The western theater’s strategic network in mid-1862 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep205-western-theater-network.svg","alt":"Schematic map of Missouri, Arkansas, Kentucky, Tennessee, Mississippi, Alabama, and Georgia showing rivers, railroads, strategic cities, Curtis’s route to Helena, Beauregard’s retreat to Tupelo, and the proposed Union advance to Chattanooga.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The western theater’s strategic network in mid-1862"}],["$","span",null,{"children":"This custom schematic connects the episode’s widely separated operations. Blue marks United States control or bases, red marks Confederate positions, and the route lines show Curtis’s march to Helena, Beauregard’s withdrawal to Tupelo, and the proposed United States axis toward Chattanooga. It is intentionally not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep205-western-theater-network.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Created for this guide from the episode transcript, U.S. Army campaign histories, National Park Service battle studies, and Library of Congress railroad and campaign maps; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Field fortifications and approaches at Corinth",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep205-corinth-field-fortifications.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Field fortifications and approaches at Corinth at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep205-corinth-field-fortifications.jpg","alt":"Detailed 1862 manuscript map of Corinth showing roads, railroads, Union approaches, and Confederate fortifications in red and blue.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Field fortifications and approaches at Corinth"}],["$","span",null,{"children":"Primary-source map: Army engineers recorded the United States approaches in blue and Confederate works in red. North is at the bottom, an unusual orientation that must be kept in mind when reading the map."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep205-corinth-field-fortifications.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Geography and Map Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Cumberland Gap from the south",{"className":"reference-map","children":["$L30","$L31"]}],"$L32"]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The podcast returns to the western theater",{"className":"moment","children":[["$","$L33",null,{"seconds":71,"label":"1:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The podcast returns to the western theater"}],["$","p",null,{"children":"The hosts resume the western story after nearly two years of episodes centered on campaigns in Virginia and Maryland."}]]}]]}],["$","div","The position after the spring campaigns",{"className":"moment","children":[["$","$L33",null,{"seconds":141,"label":"2:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The position after the spring campaigns"}],["$","p",null,{"children":"Confederate forces have abandoned Kentucky, much of Tennessee, and the railroad center at Corinth."}]]}]]}],["$","div","Three counteroffensives are introduced",{"className":"moment","children":[["$","$L33",null,{"seconds":152,"label":"2:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Three counteroffensives are introduced"}],["$","p",null,{"children":"The episode previews Confederate campaigns in Kentucky and Mississippi and the United States campaign that will culminate at Stones River."}]]}]]}],["$","div","The Upper South becomes the strategic prize",{"className":"moment","children":[["$","$L33",null,{"seconds":163,"label":"2:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Upper South becomes the strategic prize"}],["$","p",null,{"children":"Kentucky and Tennessee matter for their population, agriculture, transport network, and position between northern territory and the Deep South."}]]}]]}],["$","div","Late 1862 is previewed as a net Confederate failure",{"className":"moment","children":[["$","$L33",null,{"seconds":198,"label":"3:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"