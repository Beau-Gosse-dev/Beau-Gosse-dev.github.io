2d:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep205-western-theater-network.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep205-western-theater-network.svg","alt":"Schematic western theater map showing control, river and rail corridors, and the principal movements discussed in episode 205.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The episode’s story is a network problem: armies could move only as far as their rivers, railroads, roads, depots, and forage could sustain them."}]]}],["$","figure","/images/ep205-corinth-field-fortifications.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep205-corinth-field-fortifications.jpg","alt":"Manuscript military map of Union approaches and Confederate defenses around Corinth in May 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Primary-source map: the colored approach and defense lines show why Corinth was a siege of fieldworks and careful movement rather than a single set-piece assault."}]]}],["$","figure","/images/ep205-ormsby-mitchel-portrait.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep205-ormsby-mitchel-portrait.jpg","alt":"Nineteenth-century full-length lithographic portrait of United States Brigadier General Ormsby M. Mitchel in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Contextual image: this Currier & Ives portrait identifies the division commander whose exposed northern Alabama operations anchor the episode’s eastern flank."}]]}],["$","figure","/images/ep205-cumberland-gap-view.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep205-cumberland-gap-view.jpg","alt":"An 1862 lithog