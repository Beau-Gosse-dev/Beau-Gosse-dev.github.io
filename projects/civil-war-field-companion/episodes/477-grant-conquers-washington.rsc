17:["$","div","Grant met Lincoln",{"className":"moment","children":[["$","$L15",null,{"seconds":813,"label":"13:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant met Lincoln"}],["$","p",null,{"children":"The president greeted him in front of the assembled crowd and Secretary of State William Seward introduced him to Mary Lincoln."}]]}]]}]
18:["$","div","The East Room crowd surrounded Grant",{"className":"moment","children":[["$","$L15",null,{"seconds":860,"label":"14:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The East Room crowd surrounded Grant"}],["$","p",null,{"children":"Visitors pressed forward to shake his hand, and he reluctantly stood on a sofa so the crowd could see him."}]]}]]}]
19:["$","div","Lincoln prepared Grant for the ceremony",{"className":"moment","children":[["$","$L15",null,{"seconds":993,"label":"16:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln prepared Grant for the ceremony"}],["$","p",null,{"children":"Lincoln asked Grant to acknowledge other generals and build good relations with the Army of the Potomac in his acceptance remarks."}]]}]]}]
1a:["$","div","Grant received the commission on March 9",{"className":"moment","children":[["$","$L15",null,{"seconds":1048,"label":"17:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant received the commission on March 9"}],["$","p",null,{"children":"Lincoln presented the lieutenant general’s commission in front of the cabinet and emphasized the responsibility attached to the rank."}]]}]]}]
1b:["$","div","Grant accepted the appointment",{"className":"moment","children":[["$","$L15",null,{"seconds":1110,"label":"18:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant accepted the appointment"}],["$","p",null,{"children":"He credited the armies that had fought for the Union and accepted responsibility for meeting the government’s expectations."}]]}]]}]
1c:["$","div","Grant became general-in-chief",{"className":"moment","children":[["$","$L15",null,{"seconds":1239,"label":"20:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant became general-in-chief"}],["$","p",null,{"children":"On March 10, Lincoln formally placed Grant over all U.S. armies. Sherman took Grant’s western command and Halleck became chief of staff."}]]}]]}]
1d:["$","div","General headquarters moved out of Washington",{"className":"moment","children":[["$","$L15",null,{"seconds":1265,"label":"21:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"General headquarters moved out of Washington"}],["$","p",null,{"children":"Unlike Halleck, Grant would locate his headquarters wherever he was operating rather than maintain a permanent War Department office."}]]}]]}]
1e:["$","div","Grant visited Meade at Brandy Station",{"className":"moment","children":[["$","$L15",null,{"seconds":1282,"label":"21:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant visited Meade at Brandy Station"}],["$","p",null,{"children":"He and Rawlins went to Army of the Potomac headquarters immediately after leaving Washington."}]]}]]}]
1f:["$","div","Grant decided to remain in the East",{"className":"moment","children":[["$","$L15",null,{"seconds":1298,"label":"21:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant decided to remain in the East"}],["$","p",null,{"children":"Direct meetings with Lincoln and Stanton and closer supervision of military administration made proximity to Washington valuable."}]]}]]}]
20:["$","div","Grant reconsidered removing Meade",{"className":"moment","children":[["$","$L15",null,{"seconds":1348,"label":"22:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant reconsidered removing Meade"}],["$","p",null,{"children":"Meade offered to step aside if Grant preferred a western commander, and Grant treated the offer as evidence of Meade’s character."}]]}]]}]
21:["$","div","Meade retained command",{"className":"moment","children":[["$","$L15",null,{"seconds":1397,"label":"23:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade retained command"}],["$","p",null,{"children":"Grant kept Meade at the head of the Army of the Potomac and planned to place his own headquarters with the field army."}]]}]]}]
22:["$","div","Grant informed Lincoln of the arrangement",{"className":"moment","children":[["$","$L15",null,{"seconds":1451,"label":"24:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant informed Lincoln of the arrangement"}],["$","p",null,{"children":"He told the president and cabinet that he would remain in the East but left that night to confer with Sherman and other western generals."}]]}]]}]
23:["$","div","Grant returned from Nashville",{"className":"moment","children":[["$","$L15",null,{"seconds":1503,"label":"25:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant returned from Nashville"}],["$","p",null,{"children":"He came back to Washington on March 23 after discussing the upcoming campaigns with western commanders."}]]}]]}]
24:["$","div","Headquarters opened near Culpeper",{"className":"moment","children":[["$","$L15",null,{"seconds":1520,"label":"25:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Headquarters opened near Culpeper"}],["$","p",null,{"children":"On March 26, Grant established a separate headquarters near Meade and refined the coordinated operations scheduled to begin in early May."}]]}]]}]
25:["$","div","Grant briefed Lincoln and Stanton",{"className":"moment","children":[["$","$L15",null,{"seconds":1544,"label":"25:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant briefed Lincoln and Stanton"}],["$","p",null,{"children":"He made repeated trips to Washington and gave civilian leaders the main outline of the eastern and western plans."}]]}]]}]
26:["$","div","Lincoln delegated operational responsibility",{"className":"moment","children":[["$","$L15",null,{"seconds":1560,"label":"26:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln delegated operational responsibility"}],["$","p",null,{"children":"Lincoln wanted Grant to take responsibility and act decisively rather than require the president to approve and own every military decision."}]]}]]}]
