d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",477," · ","March 8–26, 1864"," · ","Washington, D.C.; Brandy Station and Culpeper, Virginia; Nashville, Tennessee"]}],["$","h1",null,{"children":"GRANT CONQUERS WASHINGTON"}],["$","span",null,{"className":"result-label","children":"Grant arrived in Washington on March 8, received his lieutenant general’s commission on March 9, and became general-in-chief on March 10. Halleck moved to the new position of army chief of staff, and Sherman replaced Grant as commander of the Military Division of the Mississippi. After meeting Meade, Grant kept him in command of the Army of the Potomac. Grant also abandoned his plan to direct the war from the West, established field headquarters near Culpeper, and maintained direct access to Lincoln and Stanton while preparing coordinated offensives"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"March 8–26, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Washington, D.C.; Brandy Station and Culpeper, Virginia; Nashville, Tennessee"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Grant arrived in Washington on March 8, received his lieutenant general’s commission on March 9, and became general-in-chief on March 10. Halleck moved to the new position of army chief of staff, and Sherman replaced Grant as commander of the Military Division of the Mississippi. After meeting Meade, Grant kept him in command of the Army of the Potomac. Grant also abandoned his plan to direct the war from the West, established field headquarters near Culpeper, and maintained direct access to Lincoln and Stanton while preparing coordinated offensives"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"March 8–26, 1864","place":"Washington, D.C.; Brandy Station and Culpeper, Virginia; Nashville, Tennessee","result":"Grant arrived in Washington on March 8, received his lieutenant general’s commission on March 9, and became general-in-chief on March 10. Halleck moved to the new position of army chief of staff, and Sherman replaced Grant as commander of the Military Division of the Mississippi. After meeting Meade, Grant kept him in command of the Army of the Potomac. Grant also abandoned his plan to direct the war from the West, established field headquarters near Culpeper, and maintained direct access to Lincoln and Stanton while preparing coordinated offensives","facts":[{"label":"Grant arrived in Washington","value":"March 8, 1864"},{"label":"Lieutenant general commission","value":"March 9, 1864"},{"label":"Named general-in-chief","value":"March 10, 1864"},{"label":"First field headquarters","value":"Culpeper, Virginia, March 26"},{"label":"Previous holder of three-star rank","value":"George Washington"},{"label":"Grant’s planned campaign start","value":"May 3, 1864"},{"label":"Army of the Potomac commander retained","value":"George G. Meade"},{"label":"Western successor","value":"William T. Sherman"}],"maps":[{"title":"Washington, Brandy Station, and Culpeper","caption":"Grant arrived in Washington by rail, visited Meade’s headquarters at Brandy Station, returned to Nashville for conferences, and then established headquarters near Culpeper within reach of both the field army and the capital.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-78.30%2C38.20%2C-76.70%2C39.20&layer=mapnik&marker=38.4732%2C-77.9967"},{"title":"Field headquarters at the start of the Overland Campaign","caption":"The campaign map places Culpeper north of the Rapidan and shows the Virginia theater in which Grant would accompany Meade’s army while directing operations elsewhere.","source":"https://www.loc.gov/item/99448882/","image":"/images/overland-campaign-1864-map.jpg","alt":"Historical map of northern Virginia from Culpeper through the Overland Campaign corridor"}],"moments":[{"time":"2:01","audioTime":121,"title":"Grant arrived on March 8","detail":"Secretary of War Edwin Stanton summoned Grant from Nashville. He reached Washington with his son Fred and staff officers John Rawlins and Cyrus Comstock."},{"time":"2:45","audioTime":165,"title":"No delegation met the train","detail":"A mix-up left Grant unrecognized at the station, so he and his son walked to Willard’s Hotel while his staff reported to the War Department."},{"time":"3:37","audioTime":217,"title":"Willard’s staff initially failed to recognize him","detail":"Grant accepted a small room until the desk clerk read his signature; the hotel then moved him to its best available suite."},{"time":"4:41","audioTime":281,"title":"The public recognized Grant","detail":"Hotel guests cheered the general, surrounded his table, and prevented him from finishing dinner."},{"time":"5:19","audioTime":319,"title":"Grant’s military reputation was national","detail":"His record included Forts Henry and Donelson, Shiloh, Vicksburg, and Chattanooga."},{"time":"6:21","audioTime":381,"title":"Congress honored Grant","detail":"The House and Senate thanked Grant and his army and authorized a gold medal after Chattanooga."},{"time":"6:40","audioTime":400,"title":"Congress revived the lieutenant general rank","detail":"Elihu Washburne introduced legislation for a rank previously associated with George Washington, with Grant understood as the intended appointee."},{"time":"7:20","audioTime":440,"title":"Political groups considered Grant for president","detail":"Some Democrats promoted him as a possible candidate in 1864, although Grant repeatedly rejected political office."},{"time":"9:07","audioTime":547,"title":"Lincoln evaluated Grant’s political intentions","detail":"Lincoln supported the promotion after David Hunter reported that Grant did not seek the presidency and backed the administration."},{"time":"10:21","audioTime":621,"title":"Grant was confirmed and summoned","detail":"After the House passed the bill on February 29, Lincoln nominated Grant and the Senate confirmed him."},{"time":"10:56","audioTime":656,"title":"Grant planned to avoid Washington headquarters","detail":"He told Sherman that he would not accept a role requiring him to remain in the capital and initially intended to continue directing operations from the West."},{"time":"12:29","audioTime":749,"title":"Grant went to the White House","detail":"Simon Cameron and James Morehead escorted him from Willard’s to Lincoln’s public reception on March 8."},{"time":"13:33","audioTime":813,"title":"Grant met Lincoln","detail":"The president greeted him in front of the assembled crowd and Secretary of State William Seward introduced him to Mary Lincoln."},{"time":"14:20","audioTime":860,"title":"The East Room crowd surrounded Grant","detail":"Visitors pressed forward to shake his hand, and he reluctantly stood on a sofa so the crowd could see him."},{"time":"16:33","audioTime":993,"title":"Lincoln prepared Grant for the ceremony","detail":"Lincoln asked Grant to acknowledge other generals and build good relations with the Army of the Potomac in his acceptance remarks."},{"time":"17:28","audioTime":1048,"title":"Grant received the commission on March 9","detail":"Lincoln presented the lieutenant general’s commission in front of the cabinet and emphasized the responsibility attached to the rank."},{"time":"18:30","audioTime":1110,"title":"Grant accepted the appointment","detail":"He credited the armies that had fought for the Union and accepted responsibility for meeting the government’s expectations."},{"time":"20:39","audioTime":1239,"title":"Grant became general-in-chief","detail":"On March 10, Lincoln formally placed Grant over all U.S. armies. Sherman took Grant’s western command and Halleck became chief of staff."},{"time":"21:05","audioTime":1265,"title":"General headquarters moved out of Washington","detail":"Unlike Halleck, Grant would locate his headquarters wherever he was operating rather than maintain a permanent War Department office."},{"time":"21:22","audioTime":1282,"title":"Grant visited Meade at Brandy Station","detail":"He and Rawlins went to Army of the Potomac headquarters immediately after leaving Washington."},{"time":"21:38","audioTime":1298,"title":"Grant decided to remain in the East","detail":"Direct meetings with Lincoln and Stanton and closer supervision of military administration made proximity to Washington valuable."},{"time":"22:28","audioTime":1348,"title":"Grant reconsidered removing Meade","detail":"Meade offered to step aside if Grant preferred a western commander, and Grant treated the offer as evidence of Meade’s character."},{"time":"23:17","audioTime":1397,"title":"Meade retained command","detail":"Grant kept Meade at the head of the Army of the Potomac and planned to place his own headquarters with the field army."},{"time":"24:11","audioTime":1451,"title":"Grant informed Lincoln of the arrangement","detail":"He told the president and cabinet that he would remain in the East but left that night to confer with Sherman and other western generals."},{"time":"25:03","audioTime":1503,"title":"Grant returned from Nashville","detail":"He came back to Washington on March 23 after discussing the upcoming campaigns with western commanders."},{"time":"25:20","audioTime":1520,"title":"Headquarters opened near Culpeper","detail":"On March 26, Grant established a separate headquarters near Meade and refined the coordinated operations scheduled to begin in early May."},{"time":"25:44","audioTime":1544,"title":"Grant briefed Lincoln and Stanton","detail":"He made repeated trips to Washington and gave civilian leaders the main outline of the eastern and western plans."},{"time":"26:00","audioTime":1560,"title":"Lincoln delegated operational responsibility","detail":"Lincoln wanted Grant to take responsibility and act decisively rather than require the president to approve and own every military decision."}],"command":[{"side":"United States","color":"#315f8c","branches":[{"commander":"Abraham Lincoln","command":"President and commander-in-chief","subordinates":"Appointed Grant and retained final civilian authority"},{"commander":"Ulysses S. Grant","command":"Lieutenant general and general-in-chief","subordinates":"Directed all U.S. armies from a field headquarters"},{"commander":"Henry W. Halleck","command":"Army chief of staff","subordinates":"Managed Washington administration and transmitted Grant’s orders"},{"commander":"George G. Meade","command":"Army of the Potomac","subordinates":"Retained operational command under Grant’s direct strategic supervision"},{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Succeeded Grant as senior western commander"},{"commander":"Edwin M. Stanton","command":"Secretary of War","subordinates":"Controlled War Department administration and worked directly with Grant"}]},{"side":"Confederacy","color":"#9a3d32","branches":[{"commander":"Robert E. Lee","command":"Army of Northern Virginia","subordinates":"Principal opponent of the Army of the Potomac in the coming campaign"}]}],"people":[{"name":"George G. Meade","role":"Offered to step aside and was retained as commander of the Army of the Potomac","side":"United States"},{"name":"Henry W. Halleck","role":"Moved from general-in-chief to the new post of army chief of staff under Grant","side":"United States"},{"name":"John A. Rawlins","role":"Accompanied Grant to Washington and Brandy Station as a senior staff officer","side":"United States"},{"name":"Elihu B. Washburne","role":"Introduced the bill reviving the rank of lieutenant general for Grant","side":"United States"},{"name":"Edwin M. Stanton","role":"Summoned Grant and worked with him as secretary of war","side":"United States","image":"/images/edwin-stanton.jpg","source":"https://www.loc.gov/item/2018666385/"},{"name":"Abraham Lincoln","role":"Presented Grant’s commission and delegated military planning to him","side":"United States","image":"/images/abraham-lincoln-1864.jpg","source":"https://www.loc.gov/item/2008680391/"},{"personId":"ulysses-s-grant","role":"Became lieutenant general and general-in-chief of all U.S. armies"},{"name":"William T. Sherman","role":"Succeeded Grant as commander of the Military Division of the Mississippi","side":"United States","image":"/images/william-t-sherman.jpg","source":"https://www.loc.gov/item/2018666274/"}],"losses":[],"gallery":[{"image":"/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","caption":"Grant received the lieutenant general’s commission and command of all U.S. armies in March 1864.","source":"https://www.loc.gov/item/2018666428/"},{"image":"/images/abraham-lincoln-1864.jpg","alt":"Portrait of Abraham Lincoln in 1864","caption":"Lincoln selected Grant and gave him responsibility for military plans and their execution.","source":"https://www.loc.gov/item/2008680391/"},{"image":"/images/edwin-stanton.jpg","alt":"Portrait of Secretary of War Edwin Stanton","caption":"Stanton summoned Grant to Washington and became a principal civilian partner in administering the war effort.","source":"https://www.loc.gov/item/2018666385/"},{"image":"/images/william-t-sherman.jpg","alt":"Portrait of William T. Sherman","caption":"Sherman replaced Grant as the senior western commander and prepared the Atlanta campaign.","source":"https://www.loc.gov/item/2018666274/"}],"sources":[{"label":"Civil War Podcast episode 477","url":"https://civilwarpodcast.org/2024/12/15/civil-war-podcast-episode-477/"},{"label":"National Park Service: Ulysses S. Grant","url":"https://www.nps.gov/people/ulysses-s-grant.htm"},{"label":"Library of Congress: Ulysses S. Grant portrait","url":"https://www.loc.gov/item/2018666428/"},{"label":"Library of Congress: Abraham Lincoln portrait","url":"https://www.loc.gov/item/2008680391/"},{"label":"Library of Congress: Edwin Stanton portrait","url":"https://www.loc.gov/item/2018666385/"},{"label":"Library of Congress: William T. Sherman portrait","url":"https://www.loc.gov/item/2018666274/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
