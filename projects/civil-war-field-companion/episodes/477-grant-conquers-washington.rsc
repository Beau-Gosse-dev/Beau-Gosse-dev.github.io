10:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Grant arrived on March 8",{"className":"moment","children":[["$","$L15",null,{"seconds":121,"label":"2:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant arrived on March 8"}],["$","p",null,{"children":"Secretary of War Edwin Stanton summoned Grant from Nashville. He reached Washington with his son Fred and staff officers John Rawlins and Cyrus Comstock."}]]}]]}],["$","div","No delegation met the train",{"className":"moment","children":[["$","$L15",null,{"seconds":165,"label":"2:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"No delegation met the train"}],["$","p",null,{"children":"A mix-up left Grant unrecognized at the station, so he and his son walked to Willard’s Hotel while his staff reported to the War Department."}]]}]]}],["$","div","Willard’s staff initially failed to recognize him",{"className":"moment","children":[["$","$L15",null,{"seconds":217,"label":"3:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Willard’s staff initially failed to recognize him"}],["$","p",null,{"children":"Grant accepted a small room until the desk clerk read his signature; the hotel then moved him to its best available suite."}]]}]]}],["$","div","The public recognized Grant",{"className":"moment","children":[["$","$L15",null,{"seconds":281,"label":"4:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The public recognized Grant"}],["$","p",null,{"children":"Hotel guests cheered the general, surrounded his table, and prevented him from finishing dinner."}]]}]]}],["$","div","Grant’s military reputation was national",{"className":"moment","children":[["$","$L15",null,{"seconds":319,"label":"5:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant’s military reputation was national"}],["$","p",null,{"children":"His record included Forts Henry and Donelson, Shiloh, Vicksburg, and Chattanooga."}]]}]]}],["$","div","Congress honored Grant",{"className":"moment","children":[["$","$L15",null,{"seconds":381,"label":"6:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Congress honored Grant"}],["$","p",null,{"children":"The House and Senate thanked Grant and his army and authorized a gold medal after Chattanooga."}]]}]]}],["$","div","Congress revived the lieutenant general rank",{"className":"moment","children":[["$","$L15",null,{"seconds":400,"label":"6:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Congress revived the lieutenant general rank"}],["$","p",null,{"children":"Elihu Washburne introduced legislation for a rank previously associated with George Washington, with Grant understood as the intended appointee."}]]}]]}],["$","div","Political groups considered Grant for president",{"className":"moment","children":[["$","$L15",null,{"seconds":440,"label":"7:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Political groups considered Grant for president"}],["$","p",null,{"children":"Some Democrats promoted him as a possible candidate in 1864, although Grant repeatedly rejected political office."}]]}]]}],["$","div","Lincoln evaluated Grant’s political intentions",{"className":"moment","children":[["$","$L15",null,{"seconds":547,"label":"9:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln evaluated Grant’s political intentions"}],["$","p",null,{"children":"Lincoln supported the promotion after David Hunter reported that Grant did not seek the presidency and backed the administration."}]]}]]}],["$","div","Grant was confirmed and summoned",{"className":"moment","children":[["$","$L15",null,{"seconds":621,"label":"10:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant was confirmed and summoned"}],["$","p",null,{"children":"After the House passed the bill on February 29, Lincoln nominated Grant and the Senate confirmed him."}]]}]]}],["$","div","Grant planned to avoid Washington headquarters",{"className":"moment","children":[["$","$L15",null,{"seconds":656,"label":"10:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant planned to avoid Washington headquarters"}],["$","p",null,{"children":"He told Sherman that he would not accept a role requiring him to remain in the capital and initially intended to continue directing operations from the West."}]]}]]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}]]}]
