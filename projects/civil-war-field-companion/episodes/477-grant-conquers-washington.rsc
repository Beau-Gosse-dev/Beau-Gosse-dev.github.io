1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",477," · ","March 8–26, 1864"," · ","Washington, D.C.; Brandy Station and Culpeper, Virginia; Nashville, Tennessee"]}],["$","h1",null,{"children":"GRANT CONQUERS WASHINGTON"}],["$","span",null,{"className":"result-label","children":"Grant arrived in Washington on March 8, received his lieutenant general’s commission on March 9, and became general-in-chief on March 10. Halleck moved to the new position of army chief of staff, and Sherman replaced Grant as commander of the Military Division of the Mississippi. After meeting Meade, Grant kept him in command of the Army of the Potomac. Grant also abandoned his plan to direct the war from the West, established field headquarters near Culpeper, and maintained direct access to Lincoln and Stanton while preparing coordinated offensives"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1325813888.mp3?updated=1734308220","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Grant arrived in Washington",{"children":[["$","span",null,{"children":"Grant arrived in Washington"}],["$","strong",null,{"children":"March 8, 1864"}],"$undefined"]}],["$","div","Lieutenant general commission",{"children":[["$","span",null,{"children":"Lieutenant general commission"}],["$","strong",null,{"children":"March 9, 1864"}],"$undefined"]}],["$","div","Named general-in-chief",{"children":[["$","span",null,{"children":"Named general-in-chief"}],["$","strong",null,{"children":"March 10, 1864"}],"$undefined"]}],["$","div","First field headquarters",{"children":[["$","span",null,{"children":"First field headquarters"}],["$","strong",null,{"children":"Culpeper, Virginia, March 26"}],"$undefined"]}],["$","div","Previous holder of three-star rank",{"children":[["$","span",null,{"children":"Previous holder of three-star rank"}],["$","strong",null,{"children":"George Washington"}],"$undefined"]}],["$","div","Grant’s planned campaign start",{"children":[["$","span",null,{"children":"Grant’s planned campaign start"}],["$","strong",null,{"children":"May 3, 1864"}],"$undefined"]}],["$","div","Army of the Potomac commander retained",{"children":[["$","span",null,{"children":"Army of the Potomac commander retained"}],["$","strong",null,{"children":"George G. Meade"}],"$undefined"]}],["$","div","Western successor",{"children":[["$","span",null,{"children":"Western successor"}],["$","strong",null,{"children":"William T. Sherman"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],"$undefined",["$","section",null,{"className":"reference-section maps-section","id":"maps","children"