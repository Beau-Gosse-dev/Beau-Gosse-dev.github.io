e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Washington, Brandy Station, and Culpeper"}],["$","span",null,{"children":"Grant arrived in Washington by rail, visited Meade’s headquarters at Brandy Station, returned to Nashville for conferences, and then established headquarters near Culpeper within reach of both the field army and the capital."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
