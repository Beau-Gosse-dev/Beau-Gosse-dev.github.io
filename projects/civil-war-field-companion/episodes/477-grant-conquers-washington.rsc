12:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ulysses-s-grant.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Grant received the lieutenant general’s commission and command of all U.S. armies in March 1864."}]]}],["$","figure","/images/abraham-lincoln-1864.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/abraham-lincoln-1864.jpg","alt":"Portrait of Abraham Lincoln in 1864","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Lincoln selected Grant and gave him responsibility for military plans and their execution."}]]}],["$","figure","/images/edwin-stanton.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/edwin-stanton.jpg","alt":"Portrait of Secretary of War Edwin Stanton","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Stanton summoned Grant to Washington and became a principal civilian partner in administering the war effort."}]]}],["$","figure","/images/william-t-sherman.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/william-t-sherman.jpg","alt":"Portrait of William T. Sherman","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Sherman replaced Grant as the senior western commander and prepared the Atlanta campaign."}]]}]]}]]}]
