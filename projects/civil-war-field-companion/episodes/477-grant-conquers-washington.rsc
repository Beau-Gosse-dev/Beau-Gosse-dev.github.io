":"Controlled War Department administration and worked directly with Grant"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Robert E. Lee"}],["$","small",null,{"children":"Principal opponent of the Army of the Potomac in the coming campaign"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","George G. Meade",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GG"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George G. Meade"}],["$","p",null,{"children":"Offered to step aside and was retained as commander of the Army of the Potomac"}]]}]]}],["$","article","Henry W. Halleck",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"HW"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Henry W. Halleck"}],["$","p",null,{"children":"Moved from general-in-chief to the new post of army chief of staff under Grant"}]]}]]}],["$","article","John A. Rawlins",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John A. Rawlins"}],["$","p",null,{"children":"Accompanied Grant to Washington and Brandy Station as a senior staff officer"}]]}]]}],["$","article","Eli