3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"#201 EMANCIPATION PROCLAMATION (Part the First) · Field Companion"}],["$","meta","1",{"name":"description","content":"In which we begin to trace the evolution of the federal government's ideas & policies about slavery & emancipation during the Civil War."}],["$","meta","2",{"property":"og:title","content":"#201 EMANCIPATION PROCLAMATION (Part the First) · Field Companion"}],["$","meta","3",{"property":"og:description","content":"In which we begin to trace the evolution of the federal government's ideas & policies about slavery & emancipation during the Civil War."}],["$","meta","4",{"name":"twitter:card","content":"summary"}],["$","meta","5",{"name":"twitter:title","content":"#201 EMANCIPATION PROCLAMATION (Part the First) · Field Companion"}],["$","meta","6",{"name":"twitter:description","content":"In which we begin to trace the evolution of the federal government's ideas & policies about slavery & emancipation during the Civil War."}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["episodes","201-emancipation-proclamation-part-the-first"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"episodes","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (pr