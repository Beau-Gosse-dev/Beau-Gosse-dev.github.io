1e:["$","div","Independent political movement-Abolitionists and the Black press",{"className":"command-entry","children":[["$","strong",null,{"children":"Independent political movement"}],["$","span",null,{"children":"Abolitionists and the Black press"}],["$","small",null,{"children":"Frederick Douglass and other organizers, writers, speakers, and petitioners demanded that the United States destroy slavery and enlist Black power against the Confederacy"}]]}]
1f:["$","div","Independent actors outside formal command structures-Enslaved people seeking freedom",{"className":"command-entry","children":[["$","strong",null,{"children":"Independent actors outside formal command structures"}],["$","span",null,{"children":"Enslaved people seeking freedom"}],["$","small",null,{"children":"By leaving enslavers, withholding labor from the Confederacy, and reaching federal lines, they forced commanders and lawmakers to decide their legal and military status"}]]}]
