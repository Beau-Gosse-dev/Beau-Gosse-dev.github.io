1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",201," · ","December 1860–August 1862, with consequences through January 1, 1863"," · ","Washington, D.C.; the loyal slave states of Delaware, Maryland, Kentucky, and Missouri; Fort Monroe and Hampton Roads, Virginia; and the wider United States"]}],["$","h1",null,{"children":"EMANCIPATION PROCLAMATION (Part the First)"}],["$","span",null,{"className":"result-label","children":"The United States entered the war with an official policy of restoring the Union without attacking slavery where it existed. Enslaved people seeking protection behind United States lines, abolitionist and Radical Republican pressure, congressional action, military reverses, and the demonstrated value of enslaved labor to the Confederacy steadily weakened that limited-war policy. Benjamin Butler’s May 1861 refusal to return Frank Baker, Shepard Mallory, and James Townsend at Fort Monroe became an early operational break with conciliation and introduced the “contraband” policy developed in the next episode"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5087417883.mp3?updated=1695588912","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Why United States policy toward slavery began as limited war"}],["$","small",null,{"children":"The episode sets out the constitutional, military, electoral, and border-state calculations behind conciliation, then traces the pressure for emancipation to Fort Monroe in May 1861."}]]}],["$","div","Central distinction",{"children":[["$","span",null,{"children":"Central distinction"}],["$","strong",null,{"children":"The cause of secession was not the same as the United States government’s initial war aim"}],["$","small",null,{"children":"Slaveholding states seceded to protect slavery. Lincoln and Congress initially defined the federal war aim as suppressing rebellion and restoring the Union, not abolishing slavery in the states."}]]}],["$","div","Frederick Douglass’s position",{"children":[["$","span",null,{"children":"Frederick Douglass’s position"}],["$","strong",null,{"children":"War should be used to destroy slavery and the slaveholders’ power"}],["$","small",null,{"children":"Douglass argued that enslaved labor sustained the Confederate economy and military effort and that liberation would convert a Confederate resource into a United States advantage."}]]}],["$","div","Abolitionist forecast",{"children":[["$","span",null,{"children":"Abolitionist forecast"}],["$","strong",null,{"children":"Secession and war would force the slavery question into federal policy"}],["$","small",null,{"children":"The episode opens with Douglass in December 1860 and Joshua Giddings after Fort Sumter treating the crisis as the beginning of slavery’s destruction."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a"]}],"$L2b","$undefined","$L2c",false,"$L2d",false,"$L2e","$L2f","$L30"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Conservative opposition",{"children":[["$","span",null,{"children":"Conservative opposition"}],["$","strong",null,{"children":"Federal authority could not constitutionally abolish slavery inside a state"}],["$","small",null,{"children":"Kentucky Representative Aaron Harding represents the view that the war should leave slavery untouched. Lincoln and most of the contemporary political establishment also recognized state control over slavery in peacetime."}]]}]
f:["$","div","Lincoln to Alexander H. Stephens",{"children":[["$","span",null,{"children":"Lincoln to Alexander H. Stephens"}],["$","strong",null,{"children":"December 22, 1860"}],["$","small",null,{"children":"Lincoln privately assured the Georgia Unionist that Southern people had no reason to fear that his administration would directly or indirectly interfere with slavery in their states."}]]}]
10:["$","div","First Inaugural Address",{"children":[["$","span",null,{"children":"First Inaugural Address"}],["$","strong",null,{"children":"March 4, 1861"}],["$","small",null,{"children":"Lincoln publicly repeated that he had no lawful right or intention to interfere with slavery where it already existed."}]]}]
11:["$","div","Initial military policy",{"children":[["$","span",null,{"children":"Initial military policy"}],["$","strong",null,{"children":"Suppress rebellion while avoiding unnecessary interference with Southern property"}],["$","small",null,{"children":"The administration hoped restraint would preserve a broad Northern coalition, retain loyal slave states, and encourage Southern Unionists to end secession."}]]}]
12:["$","div","Lincoln’s personal position",{"children":[["$","span",null,{"children":"Lincoln’s personal position"}],["$","strong",null,{"children":"Antislavery, but not an abolitionist in 1861"}],["$","small",null,{"children":"Lincoln considered slavery unjust and opposed its expansion. He also held racist views, supported voluntary colonization, and initially favored gradual, compensated emancipation through state action."}]]}]
13:["$","div","Colonization",{"children":[["$","span",null,{"children":"Colonization"}],["$","strong",null,{"children":"Voluntary emigration of free Black people outside the United States"}],["$","small",null,{"children":"Lincoln’s support for colonization reflected his doubt that Black and white Americans could live together as equals. The policy remained part of his emancipation proposals into 1862."}]]}]
14:["$","div","Federalism constraint",{"children":[["$","span",null,{"children":"Federalism constraint"}],["$","strong",null,{"children":"State governments controlled slavery within their borders in peacetime"}],["$","small",null,{"children":"A nationwide federal abolition law was not considered constitutionally available in 1861. The later proclamation rested instead on the president’s commander-in-chief power during an armed rebellion and applied only to designated rebellious territory."}]]}]
15:["$","div","Political coalition constraint",{"children":[["$","span",null,{"children":"Political coalition constraint"}],["$","strong",null,{"children":"Lincoln won 54 percent of the free-state popular vote in 1860"}],["$","small",null,{"children":"A large minority of Northern voters had supported Stephen A. Douglas, John C. Breckinridge, or John Bell. Lincoln needed many of those voters to sustain a long war."}]]}]
16:["$","div","Loyal slave states",{"children":[["$","span",null,{"children":"Loyal slave states"}],["$","strong",null,{"children":"Delaware, Maryland, Kentucky, and Missouri"}],["$","small",null,{"children":"Their location, people, transportation routes, and military resources made their continued loyalty essential. Washington itself bordered slaveholding Maryland and Virginia."}]]}]
17:["$","div","“Lose Kentucky” letter",{"children":[["$","span",null,{"children":"“Lose Kentucky” letter"}],["$","strong",null,{"children":"Lincoln to Orville H. Browning, September 22, 1861"}],["$","small",null,{"children":"Defending his modification of John C. Frémont’s Missouri emancipation order, Lincoln wrote that losing Kentucky was nearly the same as losing the entire contest and could also cost Missouri, Maryland, and Washington."}]]}]
18:["$","div","Policy of conciliation",{"children":[["$","span",null,{"children":"Policy of conciliation"}],["$","strong",null,{"children":"Restore federal authority without making reunification harder"}],["$","small",null,{"children":"It relied on an exaggerated expectation that a suppressed Southern Unionist majority would reassert itself if the federal government avoided attacking slavery and other local institutions."}]]}]
19:["$","div","Crittenden Resolution",{"children":[["$","span",null,{"children":"Crittenden Resolution"}],["$","strong",null,{"children":"House adopted July 22, 1861"}],["$","small",null,{"children":"The House declared that the war was not waged for conquest, subjugation, or interference with the established institutions of the rebelling states. The operative section passed 117–2."}]]}]
1a:["$","div","Johnson Resolution",{"children":[["$","span",null,{"children":"Johnson Resolution"}],["$","strong",null,{"children":"Senate adopted July 25, 1861"}],["$","small",null,{"children":"Andrew Johnson of Tennessee introduced the Senate’s substantially identical declaration of limited war aims; it passed 30–5."}]]}]
1b:["$","div","Transcript vote correction",{"children":[["$","span",null,{"children":"Transcript vote correction"}],["$","strong",null,{"children":"117–2 in the House and 30–5 in the Senate"}],["$","small",null,{"children":"The transcript says 119–2 and 35–5. The House Journal and Congressional Globe record 117–2 for the operative House section and 30–5 for the Senate resolution."}]]}]
1c:["$","div","Lincoln’s first annual message",{"children":[["$","span",null,{"children":"Lincoln’s first annual message"}],["$","strong",null,{"children":"December 3, 1861"}],["$","small",null,{"children":"Lincoln said the Union must be preserved but warned against haste in deciding that radical and extreme measures were indispensable. He still sought compensated emancipation and colonization rather than immediate general emancipation."}]]}]
1d:["$","div","Military-necessity argument",{"children":[["$","span",null,{"children":"Military-necessity argument"}],["$","strong",null,{"children":"Attack slavery because enslaved labor sustained the Confederate war effort"}],["$","small",null,{"children":"Abolitionists and congressional Radicals emphasized that liberation would remove labor from Confederate fortifications, farms, and logistics while adding workers and eventually soldiers to the United States cause."}]]}]
1e:["$","div","Enslaved people as political actors",{"children":[["$","span",null,{"children":"Enslaved people as political actors"}],["$","strong",null,{"children":"They forced policy decisions by escaping to United States lines"}],["$","small",null,{"children":"Self-emancipation confronted commanders with immediate choices about return, protection, work, and legal status. Federal policy did not change through elite debate alone."}]]}]
1f:["$","div","Fort Monroe freedom seekers",{"children":[["$","span",null,{"children":"Fort Monroe freedom seekers"}],["$","strong",null,{"children":"Frank Baker, Shepard Mallory, and James Townsend"}],["$","small",null,{"children":"The three enslaved men escaped from work on Confederate defenses at Sewell’s Point during the night of May 23–24, 1861, and sought protection at Union-held Fort Monroe."}]]}]
20:["$","div","Butler’s decision",{"children":[["$","span",null,{"children":"Butler’s decision"}],["$","strong",null,{"children":"Refuse the enslaver’s demand for their return"}],["$","small",null,{"children":"Maj. Gen. Benjamin F. Butler reasoned that Virginia claimed to be outside United States law while using the men’s coerced labor for war. He treated that labor as enemy property subject to seizure and withheld the men from their enslaver."}]]}]
21:["$","div","Meaning of “contraband”",{"children":[["$","span",null,{"children":"Meaning of “contraband”"}],["$","strong",null,{"children":"A wartime property classification, not a declaration of full legal freedom"}],["$","small",null,{"children":"The policy blocked return and offered practical protection, but it preserved the law’s degrading treatment of people as property and left their exact legal status uncertain."}]]}]
22:["$","div","Immediate consequence at Fort Monroe",{"children":[["$","span",null,{"children":"Immediate consequence at Fort Monroe"}],["$","strong",null,{"children":"Hundreds of additional freedom seekers reached the fort"}],["$","small",null,{"children":"The National Park Service reports that roughly 900 men, women, and children had arrived within a little more than a month of Butler’s decision."}]]}]
23:["$","div","Congressional consequence",{"children":[["$","span",null,{"children":"Congressional consequence"}],["$","strong",null,{"children":"First Confiscation Act, August 6, 1861"}],["$","small",null,{"children":"Congress provided that an enslaver forfeited claims to the labor of people employed in aid of the rebellion. The act did not abolish slavery generally and left many questions unresolved."}]]}]
24:["$","div","Public opinion changed unevenly",{"children":[["$","span",null,{"children":"Public opinion changed unevenly"}],["$","strong",null,{"children":"Military reverses increased support for attacking slavery"}],["$","small",null,{"children":"The episode cites antislavery petitions, larger abolitionist audiences, press criticism, and John Sherman’s August 1862 letter as evidence that military necessity moved some moderates toward emancipation."}]]}]
25:["$","div","John Sherman’s August 1862 position",{"children":[["$","span",null,{"children":"John Sherman’s August 1862 position"}],["$","strong",null,{"children":"Use Black Americans as allies and accept broad emancipation"}],["$","small",null,{"children":"The Ohio senator told his brother William T. Sherman that Northern opinion had changed and that the United States should enlist Black assistance in every way that advanced the national cause."}]]}]
26:["$","div","What the final proclamation did",{"children":[["$","span",null,{"children":"What the final proclamation did"}],["$","strong",null,{"children":"Declared enslaved people in designated rebellious areas free and authorized Black enlistment"}],["$","small",null,{"children":"It did not abolish slavery nationwide, did not apply to loyal slave states, and depended on United States military power for enforcement. Nearly 200,000 Black soldiers and sailors served by the war’s end."}]]}]
27:["$","div","Watch Night, December 31, 1862",{"children":[["$","span",null,{"children":"Watch Night, December 31, 1862"}],["$","strong",null,{"children":"Black communities gathered to await the proclamation’s effective date"}],["$","small",null,{"children":"The episode describes about 600 people at a Washington contraband camp singing, recounting experiences of slavery, and praying before midnight. Watch Night observances occurred across free and enslaved Black communities."}]]}]
28:["$","div","No battle losses in this episode",{"children":[["$","span",null,{"children":"No battle losses in this episode"}],["$","strong",null,{"children":"The narrative concerns policy, political authority, and self-emancipation"}],["$","small",null,{"children":"No military leader is killed or mortally wounded within the events narrated. The losses section is therefore intentionally empty."}]]}]
29:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The Fall of the House of Dixie” by Bruce Levine"}],["$","small",null,{"children":"The full subtitle is “The Civil War and the Social Revolution That Transformed the South.”"}]]}]
2a:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"George E. Stephens, Orville H. Browning, Shepard Mallory, and First Manassas"}],["$","small",null,{"children":"The transcript renders or omits several names and produces “Lincoln fighted.” The documented wording is that Lincoln wrote to Browning; standard historical names and forms are used here."}]]}]
2b:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
2c:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Fort Monroe and the first three freedom seekers",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep201-fort-monroe-map.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Fort Monroe and the first three freedom seekers at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep201-fort-monroe-map.svg","alt":"Schematic map of Hampton Roads showing the route of Frank Baker, Shepard Mallory, and James Townsend from Sewell’s Point to Fort Monroe.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Fort Monroe and the first three freedom seekers"}],["$","span",null,{"children":"During the night of May 23–24, 1861, Frank Baker, Shepard Mallory, and James Townsend escaped from coerced work on Confederate gun positions at Sewell’s Point and crossed Hampton Roads to Union-held Fort Monroe. Butler interviewed them on May 24 and refused their enslaver’s demand for return. The route and shorelines are generalized and the map is not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep201-fort-monroe-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Fort Monroe National Monument, National Park Service; Library of Congress; and episode transcript. See sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2c:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","From limited war to emancipation policy",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep201-emancipation-policy-timeline.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From limited war to emancipation policy at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep201-emancipation-policy-timeline.svg","alt":"Timeline of United States policy from Lincoln’s December 1860 assurance through the final Emancipation Proclamation on January 1, 1863.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From limited war to emancipation policy"}],["$","span",null,{"children":"The federal position changed in stages. Lincoln began with constitutional assurances and conciliation; self-emancipation and Butler’s Fort Monroe decision created operational pressure; Congress, abolitionists, military reverses, and changing public opinion expanded the policy debate; Lincoln ultimately used commander-in-chief authority for the preliminary and final proclamations."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep201-emancipation-policy-timeline.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2c:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Abraham Lincoln Papers, National Archives, U.S. congressional documents, National Park Service, and episode transcript. See sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2c:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],"$L31"]}]]}]
2d:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States executive and military authority",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States executive and military authority"}],[["$","div","President and constitutional commander in chief-President Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"President and constitutional commander in chief"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Set executive war policy, directed cabinet departments and military commanders, protected the loyal slave-state coalition, and later invoked commander-in-chief power for emancipation in rebellious territory"}]]}],["$","div","Civilian head of the War Department through January 14, 1862-Secretary of War Simon Cameron",{"className":"command-entry","children":[["$","strong",null,{"children":"Civilian head of the War Department through January 14, 1862"}],["$","span",null,{"children":"Secretary of War Simon Cameron"}],["$","small",null,{"children":"Supervised the Army under presidential authority during the Fort Monroe decision and the first phase of wartime slavery policy"}]]}],["$","div","Civilian head of the War Department from January 15, 1862-Secretary of War Edwin M. Stanton",{"className":"command-entry","children":[["$","strong",null,{"children":"Civilian head of the War Department from January 15, 1862"}],["$","span",null,{"children":"Secretary of War Edwin M. Stanton"}],["$","small",null,{"children":"Administered the Army as military reverses, congressional measures, Black labor, and emancipation became central federal war-policy questions"}]]}],["$","div","Commander, Department of Virginia; headquarters at Fort Monroe-Maj. Gen. Benjamin F. Butler",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Department of Virginia; headquarters at Fort Monroe"}],["$","span",null,{"children":"Maj. Gen. Benjamin F. Butler"}],["$","small",null,{"children":"Interviewed Baker, Mallory, and Townsend on May 24, 1861, refused to return them, and reported his developing policy to Washington"}]]}]]]}],["$","section","Independent legislative and public pressure",{"className":"command-column #8b4d3a","children":[["$","h3",null,{"children":"Independent legislative and public pressure"}],[["$","div","Independent federal legislative authority-Thirty-seventh Congress",{"className":"command-entry","children":[["$","strong",null,{"children":"Independent federal legislative authority"}],["$","span",null,{"children":"Thirty-seventh Congress"}],["$","small",null,{"children":"The House and Senate declared limited war aims in July 1861; Congress then enacted confiscation and other antislavery measures as policy changed"}]]}],["$","div","Congressional faction, not subordinate to the president-Radical Republicans",{"className":"command-entry","children":[["$","strong",null,{"children":"Congressional faction, not subordinate to the president"}],"$L32","$L33"]}],"$L34","$L35"]]}]]}],"$L36"]]]}]
2e:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep201-fort-monroe-map.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep201-fort-monroe-map.svg","alt":"Schematic map of the route from Sewell’s Point to Fort Monroe across Hampton Roads.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Baker, Mallory, and Townsend acted for their own freedom by escaping Confederate military labor and reaching federal lines. Their arrival made slavery an immediate command problem for Butler."}]]}],["$","figure","/images/ep201-emancipation-policy-timeline.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep201-emancipation-policy-timeline.svg","alt":"Timeline from Lincoln’s December 1860 assurance to the final Emancipation Proclamation.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Federal policy changed through cumulative military, legal, political, and human pressure rather than through a single decision made at the war’s outset."}]]}],["$","figure","/images/ep201-frederick-douglass.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep201-frederick-douglass.jpg","alt":"Head-and-shoulders portrait of Frederick Douglass on an oval studio mount.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Douglass insisted that the United States could not defeat slaveholders’ rebellion while protecting the labor system that made their war possible. This portrait dates to about 1862."}]]}],["$","figure","/images/ep201-fort-monroe-contraband.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep201-fort-monroe-contraband.jpg","alt":"An 1861 racist caricature showing Black freedom seekers running toward Fort Monroe while a white enslaver chases them.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This 1861 printed card uses racist caricature and slurs while recording a contemporary understanding of Fort Monroe as a destination that enslaved people could reach and from which enslavers could not easily reclaim them."}]]}]]}]]}]
