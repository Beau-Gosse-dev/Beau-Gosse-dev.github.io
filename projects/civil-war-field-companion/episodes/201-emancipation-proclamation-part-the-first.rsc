35:["$","div","Independent actors outside formal command structures-Enslaved people seeking freedom",{"className":"command-entry","children":[["$","strong",null,{"children":"Independent actors outside formal command structures"}],["$","span",null,{"children":"Enslaved people seeking freedom"}],["$","small",null,{"children":"By leaving enslavers, withholding labor from the Confederacy, and reaching federal lines, they forced commanders and lawmakers to decide their legal and military status"}]]}]
