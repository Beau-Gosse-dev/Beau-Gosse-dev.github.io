d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",201," · ","December 1860–August 1862, with consequences through January 1, 1863"," · ","Washington, D.C.; the loyal slave states of Delaware, Maryland, Kentucky, and Missouri; Fort Monroe and Hampton Roads, Virginia; and the wider United States"]}],["$","h1",null,{"children":"EMANCIPATION PROCLAMATION (Part the First)"}],["$","span",null,{"className":"result-label","children":"The United States entered the war with an official policy of restoring the Union without attacking slavery where it existed. Enslaved people seeking protection behind United States lines, abolitionist and Radical Republican pressure, congressional action, military reverses, and the demonstrated value of enslaved labor to the Confederacy steadily weakened that limited-war policy. Benjamin Butler’s May 1861 refusal to return Frank Baker, Shepard Mallory, and James Townsend at Fort Monroe became an early operational break with conciliation and introduced the “contraband” policy developed in the next episode"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"December 1860–August 1862, with consequences through January 1, 1863"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Washington, D.C.; the loyal slave states of Delaware, Maryland, Kentucky, and Missouri; Fort Monroe and Hampton Roads, Virginia; and the wider United States"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"The United States entered the war with an official policy of restoring the Union without attacking slavery where it existed. Enslaved people seeking protection behind United States lines, abolitionist and Radical Republican pressure, congressional action, military reverses, and the demonstrated value of enslaved labor to the Confederacy steadily weakened that limited-war policy. Benjamin Butler’s May 1861 refusal to return Frank Baker, Shepard Mallory, and James Townsend at Fort Monroe became an early operational break with conciliation and introduced the “contraband” policy developed in the next episode"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$Lf","$L10",false,"$L11",false,"$L12","$L13"]}],"$L14","$L15",false,"$L16",false,"$L17","$L18","$L19","$L1a"]}]]}]
