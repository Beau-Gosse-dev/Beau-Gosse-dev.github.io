ll,{"children":["About 9,000 men under Franz Sigel in the episode’s account",["$","small",null,{"style":{"display":"block"},"children":"Sigel advanced west from Henry Hill across a front about two miles wide during the morning."}]]}]]}],["$","tr","Confederate concentration",{"children":["$Lf","$L10"]}],"$L11"]}]]}],"$L12"]}],"$undefined"]}],"$L13","$L14","$L15",false,"$L16","$L17","$L18","$L19","$L1a","$L1b"]}]]}]
