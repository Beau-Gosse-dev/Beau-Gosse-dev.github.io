12:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2017/01/01/civil-war-podcast-episode-177/",{"href":"https://civilwarpodcast.org/2017/01/01/civil-war-podcast-episode-177/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 177 page"]}],["$","a","https://www.nps.gov/mana/learn/historyculture/second-manassas.htm",{"href":"https://www.nps.gov/mana/learn/historyculture/second-manassas.htm","target":"_blank","rel":"noreferrer","children":[" · ","Manassas National Battlefield Park: Second Manassas"]}],["$","a","https://www.nps.gov/articles/constant-attack.htm",{"href":"https://www.nps.gov/articles/constant-attack.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Constant Attack, August 29"]}],["$","a","https://www.nps.gov/places/information-panel-federal-breakthrough.htm",{"href":"https://www.nps.gov/places/information-panel-federal-breakthrough.htm","target":"_blank","rel":"noreferrer","children":[" · ","Manassas National Battlefield Park: Federal Breakthrough interpretive panel"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va026",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va026","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service battle summary: Manassas II"]}],["$","a","https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo111054/pdf/GOVPUB-D114-PURL-gpo111054.pdf",{"href":"https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo111054/pdf/GOVPUB-D114-PURL-gpo111054.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Battle of Second Manassas staff ride guide"]}],["$","a","https://ehistory.osu.edu/books/official-records/016",{"href":"https://ehistory.osu.edu/books/official-records/016","target":"_blank","rel":"noreferrer","children":[" · ","Official Records of the Union and Confederate Armies, Series I, Volume XII, Part II"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00241/",{"href":"https://www.loc.gov/item/gvhs01.vhs00241/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Robert Knox Sneden map of the Second Bull Run battlefield"]}],["$","a","https://www.loc.gov/item/91721281/",{"href":"https://www.loc.gov/item/91721281/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Currier and Ives lithograph of the August 29 battle"]}],["$","a","https://www.loc.gov/item/2018666476/",{"href":"https://www.loc.gov/item/2018666476/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: John Pope portrait"]}],["$","a","https://www.loc.gov/item/2018670324/",{"href":"https://www.loc.gov/item/2018670324/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Stonewall Jackson portrait"]}],["$","a","https://archive.org/details/loyalwestvirgini00lang",{"href":"https://archive.org/details/loyalwestvirgini00lang","target":"_blank","rel":"noreferrer","children":[" · ","Primary account: Theodore F. Lang, “Loyal West Virginia from 1861 to 1865”"]}],["$","a","https://archive.org/details/storyofconnoneer00moor_0",{"href":"https://archive.org/details/storyofconnoneer00moor_0","target":"_blank","rel":"noreferrer","children":[" · ","Primary account: Edward A. Moore, “The Story of a Cannoneer under Stonewall Jackson”"]}],["$","a","https://civilwarpodcast.org/book-recommendations/",{"href":"https://civilwarpodcast.org/book-recommendations/","target":"_blank","rel":"noreferrer","children":[" · ","Official podcast book-recommendations list"]}]]}]
