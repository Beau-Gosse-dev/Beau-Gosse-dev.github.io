2f:["$","div",null,{"children":[["$","h3",null,{"children":"Pope arrives without an accurate picture of Longstreet"}],["$","p",null,{"children":"By about 1 p.m., Pope remains focused on Jackson even though Longstreet is substantially deployed to the south."}]]}]
30:["$","div","The Confederate line reaches nearly three miles",{"className":"moment","children":[["$","$L2e",null,{"seconds":831,"label":"13:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate line reaches nearly three miles"}],["$","p",null,{"children":"Jackson faces southeast north of the turnpike, and Longstreet faces east from Jackson’s right."}]]}]]}]
31:["$","div","Fresh Federal formations replace Sigel’s troops",{"className":"moment","children":[["$","$L2e",null,{"seconds":893,"label":"14:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fresh Federal formations replace Sigel’s troops"}],["$","p",null,{"children":"Elements of Heintzelman’s III Corps and Reno’s IX Corps prepare new attacks on the unfinished railroad."}]]}]]}]
32:["$","div","Grover’s brigade attacks",{"className":"moment","children":[["$","$L2e",null,{"seconds":904,"label":"15:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grover’s brigade attacks"}],["$","p",null,{"children":"At about 3 p.m., five regiments move through woods and charge a vulnerable gap between Gregg and Thomas."}]]}]]}]
33:["$","div","Thomas gives way at the railroad",{"className":"moment","children":[["$","$L2e",null,{"seconds":941,"label":"15:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas gives way at the railroad"}],["$","p",null,{"children":"Grover’s men pass the grade, but Gregg shifts troops and Pender arrives before the Federal breach can be reinforced."}]]}]]}]
34:["$","div","Nagle attacks Lawton’s division",{"className":"moment","children":[["$","$L2e",null,{"seconds":973,"label":"16:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nagle attacks Lawton’s division"}],["$","p",null,{"children":"Three IX Corps regiments penetrate the railroad position southwest of Grover’s attack."}]]}]]}]
35:["$","div","Bradley Johnson hits Nagle’s flank",{"className":"moment","children":[["$","$L2e",null,{"seconds":992,"label":"16:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bradley Johnson hits Nagle’s flank"}],["$","p",null,{"children":"The Virginia brigade forces Nagle back; Taylor arrives too late and is also driven from the immediate front."}]]}]]}]
36:["$","div","Hooker restores the Federal line",{"className":"moment","children":[["$","$L2e",null,{"seconds":1009,"label":"16:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker restores the Federal line"}],["$","p",null,{"children":"A Federal battery nearly falls during the Confederate pursuit, and two guns are lost before Hooker stops the advance."}]]}]]}]
37:["$","div","A. P. Hill reports an ammunition crisis",{"className":"moment","children":[["$","$L2e",null,{"seconds":1077,"label":"17:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"A. P. Hill reports an ammunition crisis"}],["$","p",null,{"children":"Henry Kyd Douglas recalls a brigade without cartridges and Hill warning Jackson that another attack could be difficult to defeat."}]]}]]}]
38:["$","div","Jackson’s line repulses another attack",{"className":"moment","children":[["$","$L2e",null,{"seconds":1192,"label":"19:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s line repulses another attack"}],["$","p",null,{"children":"Douglas’s account ends with Hill reporting that the new Federal assault has been driven back."}]]}]]}]
39:["$","div","Kearny’s division begins the largest assault",{"className":"moment","children":[["$","$L2e",null,{"seconds":1209,"label":"20:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kearny’s division begins the largest assault"}],["$","p",null,{"children":"Ten regiments attack the battered Confederate left at about 5 p.m., while two regiments from Stevens’s division join the penetration."}]]}]]}]
3a:["$","div","Early’s brigade restores Jackson’s position",{"className":"moment","children":[["$","$L2e",null,{"seconds":1304,"label":"21:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early’s brigade restores Jackson’s position"}],["$","p",null,{"children":"Jackson commits his remaining reserve, and the unsupported Federal breakthrough is forced back before night."}]]}]]}]
3b:["$","div","Porter’s expected attack does not occur",{"className":"moment","children":[["$","$L2e",null,{"seconds":1321,"label":"22:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Porter’s expected attack does not occur"}],["$","p",null,{"children":"Porter receives conflicting orders and encounters Longstreet’s large force on Jackson’s right."}]]}]]}]
3c:["$","div","Hatch moves west on the turnpike",{"className":"moment","children":[["$","$L2e",null,{"seconds":1346,"label":"22:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hatch moves west on the turnpike"}],["$","p",null,{"children":"McDowell directs Hatch toward Groveton, where the division collides with Longstreet’s troops in a confused dusk action."}]]}]]}]
3d:["$","div","Pope accepts that Longstreet is present",{"className":"moment","children":[["$","$L2e",null,{"seconds":1375,"label":"22:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope accepts that Longstreet is present"}],["$","p",null,{"children":"At about 7 p.m., Pope finally revises his estimate but still interprets Lee’s movements as reinforcement or withdrawal rather than preparation for an attack."}]]}]]}]
3e:["$","div","The book recommendation is given",{"className":"moment","children":[["$","$L2e",null,{"seconds":1439,"label":"23:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"The book recommendation is given"}],["$","p",null,{"children":"The hosts recommend John J. Hennessy’s “Return to Bull Run: The Campaign and Battle of Second Manassas.”"}]]}]]}]
3f:["$","span",null,{"children":"Brig. Gen. Alexander R. Lawton"}]
40:["$","small",null,{"children":"Temporarily commanded Richard S. Ewell’s division after Ewell was wounded at Brawner Farm; Bradley T. Johnson and Jubal Early played important roles in the counterattacks."}]
41:["$","div","Division on Jackson’s right",{"className":"command-entry","children":[["$","strong",null,{"children":"Division on Jackson’s right"}],["$","span",null,{"children":"Brig. Gen. William E. Starke"}],["$","small",null,{"children":"Temporarily commanded William B. Taliaferro’s division after Taliaferro was wounded at Brawner Farm."}]]}]
