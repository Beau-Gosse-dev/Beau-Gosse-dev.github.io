1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",177," · ","August 29, 1862"," · ","The Second Manassas battlefield around Groveton, Stony Ridge, the unfinished Manassas Gap Railroad, and the Warrenton Turnpike in Prince William County, Virginia"]}],["$","h1",null,{"children":"SECOND MANASSAS (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Tactical stalemate on August 29. Repeated United States assaults temporarily penetrated Jackson’s line but did not hold the unfinished railroad. Longstreet’s wing joined Jackson and deployed across the exposed Federal left-front. The battle remained undecided until the Confederate counterattack on August 30"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9236611071.mp3?updated=1695419372","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The second day of Second Manassas, Friday, August 29, 1862"}],["$","small",null,{"children":"Episode 176 covered the August 28 fight at Brawner Farm. This episode follows the attacks on Jackson’s railroad position, Longstreet’s arrival, and the evening action on the Warrenton Turnpike."}]]}],["$","div","Battle names",{"children":[["$","span",null,{"children":"Battle names"}],["$","strong",null,{"children":"Second Manassas and Second Bull Run"}],["$","small",null,{"children":"The National Park Service also lists Manassas, Manassas Plains, Groveton, Gainesville, and Brawner’s Farm as associated names for the August 28–30 battle."}]]}],["$","div","Pope’s objective",{"children":[["$","span",null,{"children":"Pope’s objective"}],["$","strong",null,{"children":"Concentrate against Jackson before he could withdraw or receive support"}],["$","small",null,{"children":"Pope interpreted Jackson’s movements as an attempted escape and directed converging movements toward Groveton and Gainesville."}]]}],["$","div","Jackson’s position",{"children":[["$","span",null,{"children":"Jackson’s position"}],["$","strong",null,{"children":"Stony Ridge and the unfinished Manassas Gap Railroad"}],["$","small",null,{"children":"A. P. Hill held the Confederate left, Alexander Lawton commanded the center in place of the wounded Richard Ewell, and William E. Starke commanded the right in place of the wounded William B. Taliaferro."}]]}],["$","div","Railroad terrain",{"children":[["$","span",null,{"children":"Railroad terrain"}],["$","strong",null,{"children":"Cuts, fills, embankments, and level stretches formed an irregular defensive line"}],["$","small",null,{"children":"The railroad grade offered cover in many places, but deep cuts, steep fills, and unfinished gaps prevented Jackson’s infantry from using it as one continuous breastwork."}]]}],["$","div","Opening Federal force",{"children":["$Le","$Lf","$L10"]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}],"$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b"]}]]}]
2e:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","span",null,{"children":"Opening Federal force"}]
f:["$","strong",null,{"children":"About 9,000 men under Franz Sigel in the episode’s account"}]
10:["$","small",null,{"children":"Sigel advanced west from Henry Hill across a front about two miles wide during the morning."}]
11:["$","div","Morning attacks",{"children":[["$","span",null,{"children":"Morning attacks"}],["$","strong",null,{"children":"Carl Schurz and Robert H. Milroy struck Jackson’s left and center"}],["$","small",null,{"children":"Schurz engaged Maxcy Gregg’s South Carolinians near the rocky ridge. Milroy attacked across the Groveton–Sudley Road toward a gap in the unfinished railroad. Both movements were repulsed."}]]}]
12:["$","div","Longstreet arrives",{"children":[["$","span",null,{"children":"Longstreet arrives"}],["$","strong",null,{"children":"Lee and Longstreet reached Jackson at about 10 a.m."}],["$","small",null,{"children":"John Bell Hood’s division led Longstreet’s column into position astride the Warrenton Turnpike. By shortly after noon, most of Longstreet’s wing had deployed on Jackson’s right."}]]}]
13:["$","div","Federal fire grazes Lee",{"children":[["$","span",null,{"children":"Federal fire grazes Lee"}],["$","strong",null,{"children":"A Federal bullet grazed Lee’s cheek during reconnaissance"}],["$","small",null,{"children":"The episode places the incident while Lee examined the Federal line after the two Confederate wings reunited."}]]}]
14:["$","div","Confederate concentration",{"children":[["$","span",null,{"children":"Confederate concentration"}],["$","strong",null,{"children":"More than 50,000 men available after the two wings reunited"}],["$","small",null,{"children":"The episode’s figure describes Lee’s combined battlefield force, not the number simultaneously engaged on August 29."}]]}]
15:["$","div","Pope reaches the field",{"children":[["$","span",null,{"children":"Pope reaches the field"}],["$","strong",null,{"children":"About 1 p.m., still unaware that Longstreet was substantially deployed"}],["$","small",null,{"children":"The Confederate line then extended nearly three miles: Jackson faced southeast north of the turnpike, while Longstreet faced generally east from Jackson’s right."}]]}]
16:["$","div","Federal left",{"children":[["$","span",null,{"children":"Federal left"}],["$","strong",null,{"children":"Open ground east of Longstreet’s concealed position"}],["$","small",null,{"children":"Woodland screened Longstreet’s deployment. Porter and McDowell encountered this force south of the turnpike while trying to act on Pope’s orders."}]]}]
17:["$","div","Grover’s attack",{"children":[["$","span",null,{"children":"Grover’s attack"}],["$","strong",null,{"children":"About 1,500 men charged at roughly 3 p.m."}],["$","small",null,{"children":"Cuvier Grover shifted through woods and struck an incompletely defended gap between Gregg’s and Edward L. Thomas’s brigades. Thomas’s Georgians gave way, but Dorsey Pender’s brigade helped close the breach."}]]}]
18:["$","div","Grover’s losses",{"children":[["$","span",null,{"children":"Grover’s losses"}],["$","strong",null,{"children":"More than one-third of the brigade in the episode’s account"}],["$","small",null,{"children":"The National Park Service summary gives about 25 percent. Strength and casualty tabulations vary by source and by the units or time span included."}]]}]
19:["$","div","Nagle’s penetration",{"children":[["$","span",null,{"children":"Nagle’s penetration"}],["$","strong",null,{"children":"Three IX Corps regiments crossed the railroad against Lawton’s division"}],["$","small",null,{"children":"Bradley T. Johnson’s Virginia brigade hit James Nagle’s exposed left. Nelson Taylor arrived too late to support the penetration, and a Confederate pursuit briefly threatened a Federal battery."}]]}]
1a:["$","div","Federal battery fight",{"children":[["$","span",null,{"children":"Federal battery fight"}],["$","strong",null,{"children":"Two guns were lost before Hooker restored the line"}],["$","small",null,{"children":"The episode describes a Confederate pursuit after Nagle and Taylor withdrew, followed by a Federal rally under Joseph Hooker."}]]}]
1b:["$","div","A. P. Hill’s ammunition",{"children":[["$","span",null,{"children":"A. P. Hill’s ammunition"}],["$","strong",null,{"children":"At least one brigade had exhausted its cartridges late in the day"}],["$","small",null,{"children":"Henry Kyd Douglas recalled details collecting ammunition from dead and wounded soldiers while Hill warned Jackson that another attack could be difficult to stop."}]]}]
1c:["$","div","Largest assault of the day",{"children":[["$","span",null,{"children":"Largest assault of the day"}],["$","strong",null,{"children":"Kearny sent ten regiments forward at about 5 p.m."}],["$","small",null,{"children":"Kearny’s division broke through parts of Gregg’s and Thomas’s line. Two regiments from Isaac Stevens’s division also penetrated the Confederate defense."}]]}]
1d:["$","div","Jackson’s last reserve",{"children":[["$","span",null,{"children":"Jackson’s last reserve"}],["$","strong",null,{"children":"Jubal Early’s brigade restored the threatened sector"}],["$","small",null,{"children":"The Federal penetrations were not reinforced in time, and Jackson’s counterattacks recovered the railroad position before dark."}]]}]
1e:["$","div","Porter and McDowell",{"children":[["$","span",null,{"children":"Porter and McDowell"}],["$","strong",null,{"children":"Their southward movement encountered Longstreet instead of Jackson’s open flank"}],["$","small",null,{"children":"Pope’s orders were contradictory and based on an inaccurate picture of the field. Porter did not make the attack against Jackson that Pope expected."}]]}]
1f:["$","div","Hatch at dusk",{"children":[["$","span",null,{"children":"Hatch at dusk"}],["$","strong",null,{"children":"Moved west on the Warrenton Turnpike and collided with Longstreet’s troops"}],["$","small",null,{"children":"McDowell ordered John P. Hatch’s division toward Groveton. The resulting action ended in darkness without a decisive result."}]]}]
20:["$","div","Pope recognizes Longstreet",{"children":[["$","span",null,{"children":"Pope recognizes Longstreet"}],["$","strong",null,{"children":"About 7 p.m."}],["$","small",null,{"children":"Even after accepting that Longstreet was present, Pope concluded that Lee was reinforcing Jackson or preparing to withdraw rather than preparing a major offensive."}]]}]
21:["$","div","August 29 result",{"children":[["$","span",null,{"children":"August 29 result"}],["$","strong",null,{"children":"Jackson held; Longstreet deployed; neither side launched a decisive general attack"}],["$","small",null,{"children":"Federal assaults made several local breaches but failed to coordinate or exploit them. The full battle’s Confederate victory belongs to the August 28–30 result, not to August 29 alone."}]]}]
22:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Return to Bull Run” by John J. Hennessy"}],["$","small",null,{"children":"The official episode page and podcast book list identify the full title as “Return to Bull Run: The Campaign and Battle of Second Manassas.”"}]]}]
23:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Brawner, Irvin McDowell, Ricketts, Fitz John Porter, Sigel, Heintzelman, Taliaferro, Ewell, Starke, Maxcy Gregg, Nagle, Kearny, and Henry Kyd Douglas"}],["$","small",null,{"children":"The automated transcript produces forms including “Bronner,” “Urban,” “Bricket,” “Fitch,” “Siegel,” “Heinselman,” “Tolliver,” “Yule,” “Stark,” “Maxie,” “Nagel,” “Carney,” and “Henry Kye Douglas.”"}]]}]
24:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
25:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Operational setting: the armies converge at Groveton",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep177-operational-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Operational setting: the armies converge at Groveton at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep177-operational-context.svg","alt":"Generalized operational map showing Jackson at Groveton, Longstreet approaching from Thoroughfare Gap, and Pope concentrating from Manassas Junction and Centreville.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Operational setting: the armies converge at Groveton"}],["$","span",null,{"children":"Jackson moved from Manassas Junction to Stony Ridge, Pope concentrated from Manassas Junction and Centreville, and Longstreet approached through Thoroughfare Gap and Gainesville. Routes, locations, and movements are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep177-operational-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Library of Congress campaign maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","August 29 attacks along the unfinished railroad",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep177-august-29-positions.svg","target":"_blank","rel":"noreferrer","aria-label":"Open August 29 attacks along the unfinished railroad at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep177-august-29-positions.svg","alt":"Generalized map of Jackson’s divisions along the unfinished railroad, Longstreet south of the turnpike, and the principal Federal attacks on August 29, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"August 29 attacks along the unfinished railroad"}],["$","span",null,{"children":"Jackson’s divisions held Stony Ridge north of the Warrenton Turnpike. Sigel, Grover, Nagle, Kearny, and Stevens attacked from the east and southeast, while Longstreet deployed south of Jackson and blocked Porter and McDowell. Hatch moved west on the turnpike near dusk. Bars, arrows, and breakthrough markers show generalized relationships, not exact routes, timing, frontages, or troop geometry. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep177-august-29-positions.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, official reports, Library of Congress maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2c"]}]]}],"$undefined"]}]]}],"$L2d"]}]]}]
26:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The August 28 fight is summarized",{"className":"moment","children":[["$","$L2e",null,{"seconds":280,"label":"4:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"The August 28 fight is summarized"}],["$","p",null,{"children":"The hosts identify Brawner Farm as the opening action and begin the account of Friday, August 29."}]]}]]}],["$","div","Pope renews the attempt to trap Jackson",{"className":"moment","children":[["$","$L2e",null,{"seconds":332,"label":"5:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope renews the attempt to trap Jackson"}],["$","p",null,{"children":"After Jackson leaves Manassas Junction, the Brawner Farm fight reveals his position near the old Bull Run battlefield."}]]}]]}],["$","div","Federal columns concentrate around Groveton",{"className":"moment","children":[["$","$L2e",null,{"seconds":409,"label":"6:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal columns concentrate around Groveton"}],["$","p",null,{"children":"King, Ricketts, Porter, Reynolds, Sigel, IX Corps, and Heintzelman’s III Corps receive movements intended to close on Jackson from several directions."}]]}]]}],["$","div","Jackson’s line is placed on Stony Ridge",{"className":"moment","children":[["$","$L2e",null,{"seconds":486,"label":"8:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s line is placed on Stony Ridge"}],["$","p",null,{"children":"A. P. Hill holds the left, Lawton the center, and Starke the right along the unfinished railroad north of the Warrenton Turnpike."}]]}]]}],["$","div","The railroad is described as an irregular defense",{"className":"moment","children":[["$","$L2e",null,{"seconds":525,"label":"8:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The railroad is described as an irregular defense"}],["$","p",null,{"children":"Cuts, fills, steep banks, and level gaps explain why Jackson’s infantry did not follow the railroad grade continuously."}]]}]]}],["$","div","Sigel begins the morning pressure",{"className":"moment","children":[["$","$L2e",null,{"seconds":564,"label":"9:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sigel begins the morning pressure"}],["$","p",null,{"children":"About 9,000 men advance west from Henry Hill; Schurz engages Gregg while Milroy attacks toward a gap in the railroad."}]]}]]}],["$","div","Lee and Longstreet reach the battlefield",{"className":"moment","children":[["$","$L2e",null,{"seconds":613,"label":"10:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee and Longstreet reach the battlefield"}],["$","p",null,{"children":"Hood’s division begins deploying astride the Warrenton Turnpike on Jackson’s right at about 10 a.m."}]]}]]}],["$","div","A bullet grazes Lee",{"className":"moment","children":[["$","$L2e",null,{"seconds":631,"label":"10:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"A bullet grazes Lee"}],["$","p",null,{"children":"Lee is struck on the cheek while reconnoitering, then continues organizing the reunited Confederate army."}]]}]]}],["$","div","Thomas’s brigade describes a Federal penetration",{"className":"moment","children":[["$","$L2e",null,{"seconds":654,"label":"10:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas’s brigade describes a Federal penetration"}],["$","p",null,{"children":"Marion H. Fitzpatrick of the 45th Georgia recalls the regiment nearly being surrounded and Branch’s brigade helping drive the attackers back."}]]}]]}],["$","div","Nagle’s attack is described from the railroad ditch",{"className":"moment","children":[["$","$L2e",null,{"seconds":726,"label":"12:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nagle’s attack is described from the railroad ditch"}],["$","p",null,{"children":"Henry H. Pearson of the 6th New Hampshire recounts finding Confederate troops close to the opposite side of the grade and withdrawing under fire."}]]}]]}],["$","div","Pope arrives without an accurate picture of Longstreet",{"className":"moment","children":[["$","$L2e",null,{"seconds":816,"label":"13:36"}],"$L2f"]}],"$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e"]}]]}]
27:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"Directed the converging movements and repeated assaults against Jackson; reached the battlefield about 1 p.m."}]]}],["$","div","I Corps, Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Franz Sigel"}],["$","small",null,{"children":"Carl Schurz’s division, Robert H. Milroy’s brigade, and other I Corps formations conducted the morning attacks."}]]}],["$","div","III Corps, Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"James B. Ricketts’s and Rufus King’s divisions; John P. Hatch led King’s division toward Groveton during the evening action."}]]}],["$","div","V Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps, Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"Moved with McDowell south of the turnpike, encountered Longstreet, and did not make Pope’s expected attack on Jackson."}]]}],["$","div","III Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. Samuel P. Heintzelman"}],["$","small",null,{"children":"Joseph Hooker’s division included Cuvier Grover and Nelson Taylor; Philip Kearny’s division made the largest late-afternoon assault."}]]}],["$","div","IX Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"IX Corps"}],["$","span",null,{"children":"Maj. Gen. Jesse L. Reno"}],["$","small",null,{"children":"Isaac I. Stevens’s division and James Nagle’s brigade attacked Jackson’s line during the afternoon."}]]}],["$","div","Pennsylvania Reserves division",{"className":"command-entry","children":[["$","strong",null,{"children":"Pennsylvania Reserves division"}],["$","span",null,{"children":"Brig. Gen. John F. Reynolds"}],["$","small",null,{"children":"Operated on the Federal left near the Warrenton Turnpike and was assigned to strike Jackson’s right with Sigel’s command."}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Reunited Longstreet’s wing with Jackson and examined the possibility of attacking Pope’s exposed left."}]]}],["$","div","Jackson’s wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Jackson’s wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Divisions under A. P. Hill, Alexander Lawton, and William E. Starke defended the unfinished railroad."}]]}],["$","div","Light Division on Jackson’s left",{"className":"command-entry","children":[["$","strong",null,{"children":"Light Division on Jackson’s left"}],["$","span",null,{"children":"Maj. Gen. A. P. Hill"}],["$","small",null,{"children":"Episode-focused brigades under Maxcy Gregg, Edward L. Thomas, Dorsey Pender, Lawrence O. Branch, and Charles W. Field."}]]}],["$","div","Division in Jackson’s center",{"className":"command-entry","children":[["$","strong",null,{"children":"Division in Jackson’s center"}],"$L3f","$L40"]}],"$L41","$L42"]]}]]}],"$L43","$L44"]}]
28:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. James Cantwell",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. James Cantwell"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 82nd Ohio Infantry, Milroy’s brigade","."]}]," ","Killed while leading his regiment in the morning attacks against Jackson’s railroad position."]}]]}],["$","article","Capt. David Gibson",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Capt. David Gibson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Company H, 3rd West Virginia Infantry, Milroy’s brigade","."]}]," ","Killed by a bullet to the forehead while leading a charge toward the railroad embankment. Theodore F. Lang’s postwar account supplies the episode’s opening description."]}]]}],["$","article","Sgt. Henry Ruffner Paine",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Sgt. Henry Ruffner Paine"}],["$","p",null,{"children":[["$","strong",null,{"children":["First Rockbridge Artillery","."]}]," ","Mortally wounded by solid shot during a close artillery exchange and died about two hours later. Edward A. Moore’s memoir supplies the episode’s opening account; the transcript renders the surname as “Payne.”"]}]]}]]}]]}]
29:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep177-operational-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep177-operational-context.svg","alt":"Generalized map showing the roads and movements that brought Jackson, Longstreet, and Pope together near Groveton.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson waited near Groveton while Longstreet approached from the west and Pope concentrated from the east and southeast. This map is schematic and not to scale."}]]}],["$","figure","/images/ep177-august-29-positions.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep177-august-29-positions.svg","alt":"Generalized troop-position map of the unfinished railroad fighting on August 29, 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Federal assaults made temporary breaches in Jackson’s line. Longstreet’s arrival extended the Confederate position south of the turnpike and blocked Porter. This map is schematic and not to scale."}]]}],["$","figure","/images/ep177-battle-lithograph.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep177-battle-lithograph.jpg","alt":"Currier and Ives lithograph of the Second Battle of Bull Run on August 29, 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This 1862 popular print presents a stylized view of the fighting. It is useful as a contemporary visual artifact, not as a tactical map."}]]}],["$","figure","/images/ep177-john-pope.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep177-john-pope.jpg","alt":"Civil War-era glass-negative portrait of United States major general John Pope in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"John Pope reached the field about 1 p.m. and continued directing attacks against Jackson before recognizing Longstreet’s presence."}]]}],["$","figure","/images/ep177-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep177-stonewall-jackson.jpg","alt":"Civil War-era glass-negative portrait of Confederate major general Thomas J. Stonewall Jackson.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s three divisions defended Stony Ridge and the unfinished railroad throughout August 29."}]]}]]}]]}]
