17:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. James Cantwell",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. James Cantwell"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 82nd Ohio Infantry, Milroy’s brigade","."]}]," ","Killed while leading his regiment in the morning attacks against Jackson’s railroad position."]}]]}],["$","article","Capt. David Gibson",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Capt. David Gibson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Company H, 3rd West Virginia Infantry, Milroy’s brigade","."]}]," ","Killed by a bullet to the forehead while leading a charge toward the railroad embankment. Theodore F. Lang’s postwar account supplies the episode’s opening description."]}]]}],["$","article","Sgt. Henry Ruffner Paine",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Sgt. Henry Ruffner Paine"}],["$","p",null,{"children":[["$","strong",null,{"children":["First Rockbridge Artillery","."]}]," ","Mortally wounded by solid shot during a close artillery exchange and died about two hours later. Edward A. Moore’s memoir supplies the episode’s opening account; the transcript renders the surname as “Payne.”"]}]]}]]}]]}]
18:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L1f","/images/ep177-battle-lithograph.jpg",{"image":"/images/ep177-battle-lithograph.jpg","alt":"Currier and Ives lithograph of the Second Battle of Bull Run on August 29, 1862.","caption":"This 1862 popular print presents a stylized view of the fighting. It is useful as a contemporary visual artifact, not as a tactical map.","name":"Currier and Ives lithograph of the Second Battle of Bull Run on August 29, 1862.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L1f","/images/ep177-john-pope.jpg",{"image":"/images/ep177-john-pope.jpg","alt":"Civil War-era glass-negative portrait of United States major general John Pope in uniform.","caption":"John Pope reached the field about 1 p.m. and continued directing attacks against Jackson before recognizing Longstreet’s presence.","name":"Civil War-era glass-negative portrait of United States major general John Pope in uniform.","source":"$undefined","credit":"Brady’s National Photographic Portrait Galleries, Library of Congress Prints and Photographs Division; see sources below."}],["$","$L1f","/images/ep177-stonewall-jackson.jpg",{"image":"/images/ep177-stonewall-jackson.jpg","alt":"Civil War-era glass-negative portrait of Confederate major general Thomas J. Stonewall Jackson.","caption":"Jackson’s three divisions defended Stony Ridge and the unfinished railroad throughout August 29.","name":"Civil War-era glass-negative portrait of Confederate major general Thomas J. Stonewall Jackson.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}]]}]]}]
