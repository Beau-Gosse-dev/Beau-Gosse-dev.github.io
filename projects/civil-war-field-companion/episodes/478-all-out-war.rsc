19:["$","div",null,{"children":[["$","h3",null,{"children":"Grant consulted the principal army commanders"}],["$","p",null,{"children":"He visited Meade’s Army of the Potomac and then traveled to Nashville to meet Sherman and other western generals."}]]}]
1a:["$","div","Sherman received the Atlanta assignment",{"className":"moment","children":[["$","$L18",null,{"seconds":625,"label":"10:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman received the Atlanta assignment"}],["$","p",null,{"children":"Three U.S. armies would move from Chattanooga against Joseph E. Johnston’s Army of Tennessee along the railroad toward Atlanta."}]]}]]}]
1b:["$","div","Grant defined Sherman’s objective",{"className":"moment","children":[["$","$L18",null,{"seconds":648,"label":"10:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant defined Sherman’s objective"}],["$","p",null,{"children":"Sherman was to break up Johnston’s army, penetrate Confederate territory, and damage resources supporting the war."}]]}]]}]
1c:["$","div","Mobile was planned as a supporting operation",{"className":"moment","children":[["$","$L18",null,{"seconds":676,"label":"11:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mobile was planned as a supporting operation"}],["$","p",null,{"children":"Grant wanted an Army–Navy expedition against the Confederacy’s remaining major Gulf port."}]]}]]}]
1d:["$","div","The Red River campaign delayed Mobile",{"className":"moment","children":[["$","$L18",null,{"seconds":687,"label":"11:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Red River campaign delayed Mobile"}],["$","p",null,{"children":"Lincoln and Halleck had already committed Nathaniel Banks to Louisiana, so Grant deferred the Gulf operation."}]]}]]}]
1e:["$","div","Grant had considered a North Carolina main effort",{"className":"moment","children":[["$","$L18",null,{"seconds":733,"label":"12:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant had considered a North Carolina main effort"}],["$","p",null,{"children":"He proposed a 60,000-man movement through Raleigh and New Bern toward Wilmington and its blockade-running trade."}]]}]]}]
1f:["$","div","Washington required the main eastern attack against Lee",{"className":"moment","children":[["$","$L18",null,{"seconds":764,"label":"12:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Washington required the main eastern attack against Lee"}],["$","p",null,{"children":"Halleck advised that Lincoln would not support a plan that left the Army of the Potomac and Lee’s army outside the principal operation."}]]}]]}]
20:["$","div","Grant adopted a three-part Virginia plan",{"className":"moment","children":[["$","$L18",null,{"seconds":865,"label":"14:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant adopted a three-part Virginia plan"}],["$","p",null,{"children":"The Army of the Potomac would attack Lee while other forces threatened his supplies, reinforcements, railroads, and Richmond."}]]}]]}]
21:["$","div","Sigel received the Shenandoah assignment",{"className":"moment","children":[["$","$L18",null,{"seconds":887,"label":"14:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sigel received the Shenandoah assignment"}],["$","p",null,{"children":"His troops would move south through the valley to restrict food shipments and prevent Confederate reinforcement of Lee or Richmond."}]]}]]}]
22:["$","div","Butler received the James River assignment",{"className":"moment","children":[["$","$L18",null,{"seconds":923,"label":"15:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Butler received the James River assignment"}],["$","p",null,{"children":"The Army of the James would land at Bermuda Hundred and threaten the Richmond–Petersburg railroad and the Confederate capital."}]]}]]}]
23:["$","div","The Army of the Potomac remained the main effort",{"className":"moment","children":[["$","$L18",null,{"seconds":963,"label":"16:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Potomac remained the main effort"}],["$","p",null,{"children":"Meade’s army would operate directly against Robert E. Lee and the Army of Northern Virginia."}]]}]]}]
24:["$","div","Grant retained Meade",{"className":"moment","children":[["$","$L18",null,{"seconds":1007,"label":"16:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant retained Meade"}],["$","p",null,{"children":"Meade offered to step aside, but Grant kept him in command of the Army of the Potomac."}]]}]]}]
25:["$","div","Meade was ordered to follow Lee",{"className":"moment","children":[["$","$L18",null,{"seconds":1022,"label":"17:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade was ordered to follow Lee"}],["$","p",null,{"children":"Grant made Lee’s army the objective and directed Meade to go wherever Lee moved."}]]}]]}]
26:["$","div","Destruction did not require one decisive battle",{"className":"moment","children":[["$","$L18",null,{"seconds":1034,"label":"17:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Destruction did not require one decisive battle"}],["$","p",null,{"children":"Grant expected maneuver, interrupted supplies, and threats to Richmond to make Lee’s position unsustainable even without a single annihilating engagement."}]]}]]}]
27:["$","div","The offensives shared one plan",{"className":"moment","children":[["$","$L18",null,{"seconds":1065,"label":"17:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The offensives shared one plan"}],["$","p",null,{"children":"For the first time, major U.S. armies across the Confederacy were directed to apply coordinated pressure at the same time."}]]}]]}]
28:["$","div","Field armies were the central objectives",{"className":"moment","children":[["$","$L18",null,{"seconds":1089,"label":"18:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Field armies were the central objectives"}],["$","p",null,{"children":"Grant aimed to destroy Johnston’s and Lee’s armies, expecting the rebellion to collapse when its main organized forces could no longer fight."}]]}]]}]
29:["$","div","The strategy depended on Northern endurance",{"className":"moment","children":[["$","$L18",null,{"seconds":1104,"label":"18:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The strategy depended on Northern endurance"}],["$","p",null,{"children":"Military pressure could succeed only if voters and soldiers accepted the casualties and costs needed to continue the war."}]]}]]}]
