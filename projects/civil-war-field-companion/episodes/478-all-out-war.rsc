1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",478," · ","March–May 1864"," · ","United States and Confederate theaters of war, with main operations in Virginia and Georgia"]}],["$","h1",null,{"children":"ALL-OUT WAR"}],["$","span",null,{"className":"result-label","children":"Grant replaced disconnected departmental campaigns with coordinated offensives against the Confederacy’s principal field armies and supply systems. Sherman was assigned to break up Johnston’s army and advance toward Atlanta. In Virginia, Meade would follow Lee’s army, Sigel would move through the Shenandoah Valley, and Butler would land at Bermuda Hundred against Richmond’s rail connections. The Mobile operation and Grant’s earlier North Carolina proposal were deferred. The strategy depended on applying pressure at the same time so the Confederacy could not shift reinforcements between fronts"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9701511178.mp3?up