13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Theodore Lyman assessed Grant",{"className":"moment","children":[["$","$L18",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Theodore Lyman assessed Grant"}],["$","p",null,{"children":"The Army of the Potomac staff officer recognized the new general-in-chief’s competence despite his plain appearance and earlier personal difficulties."}]]}]]}],["$","div","Grant entered the role with major victories",{"className":"moment","children":[["$","$L18",null,{"seconds":138,"label":"2:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant entered the role with major victories"}],["$","p",null,{"children":"His record included the surrender of Confederate armies at Fort Donelson and Vicksburg and victories at Shiloh and Chattanooga."}]]}]]}],["$","div","Grant’s task was national strategy",{"className":"moment","children":[["$","$L18",null,{"seconds":206,"label":"3:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant’s task was national strategy"}],["$","p",null,{"children":"As general-in-chief, he had to design and supervise operations that would defeat the rebellion and restore the Union."}]]}]]}],["$","div","The Anaconda Plan had achieved major goals",{"className":"moment","children":[["$","$L18",null,{"seconds":219,"label":"3:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Anaconda Plan had achieved major goals"}],["$","p",null,{"children":"Vicksburg opened the Mississippi River and the naval blockade increasingly restricted Confederate imports."}]]}]]}],["$","div","Time favored Confederate endurance",{"className":"moment","children":[["$","$L18",null,{"seconds":273,"label":"4:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Time favored Confederate endurance"}],["$","p",null,{"children":"After three bloody years, Northern war weariness created a possibility that the Confederacy could survive by outlasting public support."}]]}]]}],["$","div","The eastern stalemate carried political weight",{"className":"moment","children":[["$","$L18",null,{"seconds":321,"label":"5:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The eastern stalemate carried political weight"}],["$","p",null,{"children":"Campaigns between Washington and Richmond received exceptional attention, while repeated U.S. failures strengthened public frustration."}]]}]]}],["$","div","Lincoln identified the interior-lines problem",{"className":"moment","children":[["$","$L18",null,{"seconds":405,"label":"6:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln identified the interior-lines problem"}],["$","p",null,{"children":"He wanted superior U.S. forces to attack at several points simultaneously so Confederate troops could not move between threatened fronts."}]]}]]}],["$","div","Grant received his commission",{"className":"moment","children":[["$","$L18",null,{"seconds":498,"label":"8:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant received his commission"}],["$","p",null,{"children":"Grant became lieutenant general on March 9, 1864, after months of considering operations for the next campaigning season."}]]}]]}],["$","div","Grant and Halleck exchanged broad proposals",{"className":"moment","children":[["$","$L18",null,{"seconds":520,"label":"8:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant and Halleck exchanged broad proposals"}],["$","p",null,{"children":"Ideas included operations in Mississippi, Mobile, Atlanta, North Carolina, and up the James River against Richmond’s railroads."}]]}]]}],["$","div","Halleck became chief of staff",{"className":"moment","children":[["$","$L18",null,{"seconds":578,"label":"9:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck became chief of staff"}],["$","p",null,{"children":"He transmitted orders and coordinated departments, while final strategic authority rested with Grant."}]]}]]}],["$","div","Grant consulted the principal army commanders",{"className":"moment","children":[["$","$L18",null,{"seconds":607,"label":"10:07"}],"$L19"]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a"]}]]}]
