12:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2017/01/29/civil-war-podcast-episode-180/",{"href":"https://civilwarpodcast.org/2017/01/29/civil-war-podcast-episode-180/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 180 page"]}],["$","a","https://www.nps.gov/mana/learn/historyculture/second-manassas.htm",{"href":"https://www.nps.gov/mana/learn/historyculture/second-manassas.htm","target":"_blank","rel":"noreferrer","children":[" · ","Manassas National Battlefield Park: Battle of Second Manassas"]}],["$","a","https://www.nps.gov/mana/learn/historyculture/union-order-of-battle-at-second-manassas.htm",{"href":"https://www.nps.gov/mana/learn/historyculture/union-order-of-battle-at-second-manassas.htm","target":"_blank","rel":"noreferrer","children":[" · ","Manassas National Battlefield Park: United States order of battle at Second Manassas"]}],["$","a","https://www.nps.gov/articles/the-attack-continues.htm",{"href":"https://www.nps.gov/articles/the-attack-continues.htm","target":"_blank","rel":"noreferrer","children":[" · ","Manassas National Battlefield Park: The Attack Continues and Chantilly aftermath"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va027",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va027","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service battle summary: Chantilly / Ox Hill"]}],["$","a","https://www.nps.gov/places/information-panel-aftermath.htm",{"href":"https://www.nps.gov/places/information-panel-aftermath.htm","target":"_blank","rel":"noreferrer","children":[" · ","Manassas National Battlefield Park: Second Manassas aftermath"]}],["$","a","https://www.nps.gov/anti/learn/historyculture/timeline.htm",{"href":"https://www.nps.gov/anti/learn/historyculture/timeline.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Antietam campaign timeline"]}],["$","a","https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/",{"href":"https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Civil War campaign summaries"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://www.loc.gov/item/mal1818700/",{"href":"https://www.loc.gov/item/mal1818700/","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: McClellan’s September 2, 1862 report to Lincoln"]}],["$","a","https://www.archives.gov/publications/prologue/1995/fall/honorable-reports-2.html",{"href":"https://www.archives.gov/publications/prologue/1995/fall/honorable-reports-2.html","target":"_blank","rel":"noreferrer","children":[" · ","National Archives: Fitz John Porter court-martial and review records"]}],["$","a","https://www.loc.gov/item/lva0000020/",{"href":"https://www.loc.gov/item/lva0000020/","target":"_blank","rel":"noreferrer","children":[" · ","Primary map: U.S. War Department map of northeastern Virginia and Washington"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00107/",{"href":"https://www.loc.gov/item/gvhs01.vhs00107/","target":"_blank","rel":"noreferrer","children":[" · ","Primary map: Robert Knox Sneden’s Centreville position, August 31, 1862"]}],["$","a","https://www.loc.gov/item/2003653567/",{"href":"https://www.loc.gov/item/2003653567/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: “McClellan is our man” engraving"]}],"$L1c","$L1d","$L1e"]}]
