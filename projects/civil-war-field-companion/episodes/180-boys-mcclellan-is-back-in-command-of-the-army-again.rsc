27:["$","figure","“McClellan is our man”",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep180-mcclellan-cheered.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open “McClellan is our man” at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep180-mcclellan-cheered.jpg","alt":"An 1862 Harper’s Weekly engraving of Union soldiers in camp cheering George B. McClellan.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"“McClellan is our man”"}],["$","span",null,{"children":"This Harper’s Weekly engraving, published on August 2, 1862, shows soldiers in camp cheering McClellan. It predates the September 2 restoration and does not depict Hatch’s announcement, but it is contemporary evidence of the personal attachment to McClellan that shaped Lincoln’s decision."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep180-mcclellan-cheered.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$20:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Prints and Photographs Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$20:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
29:["$","div","Pope makes Porter the principal target",{"className":"moment","children":[["$","$L28",null,{"seconds":572,"label":"9:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope makes Porter the principal target"}],["$","p",null,{"children":"The episode explains why Fitz John Porter, a McClellan ally, became the focus of Pope’s accusations after the campaign."}]]}]]}]
2a:["$","div","Porter’s eventual restoration is noted",{"className":"moment","children":[["$","$L28",null,{"seconds":628,"label":"10:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Porter’s eventual restoration is noted"}],["$","p",null,{"children":"After years contesting the court-martial, Porter receives a favorable review and has his commission restored by Congress in 1886."}]]}]]}]
2b:["$","div","Halleck’s coordination failure is examined",{"className":"moment","children":[["$","$L28",null,{"seconds":672,"label":"11:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck’s coordination failure is examined"}],["$","p",null,{"children":"The general-in-chief struggles to bring Pope’s and McClellan’s armies together while Lee exploits the separation."}]]}]]}]
2c:["$","div","McClellan controls a critical campaign variable",{"className":"moment","children":[["$","$L28",null,{"seconds":813,"label":"13:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan controls a critical campaign variable"}],["$","p",null,{"children":"The speed with which Army of the Potomac units join Pope determines how long Lee can operate against the Army of Virginia alone."}]]}]]}]
2d:["$","div","McClellan’s delays are reviewed",{"className":"moment","children":[["$","$L28",null,{"seconds":892,"label":"14:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan’s delays are reviewed"}],["$","p",null,{"children":"The episode describes a slow Peninsula evacuation and resistance to sending troops from Alexandria during Pope’s crisis."}]]}]]}]
2e:["$","div","Lincoln uses the available commander",{"className":"moment","children":[["$","$L28",null,{"seconds":954,"label":"15:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln uses the available commander"}],["$","p",null,{"children":"Despite condemning McClellan’s recent behavior, Lincoln concludes that he is the officer most able to meet the emergency."}]]}]]}]
2f:["$","div","Responsibility for the defeat is assigned",{"className":"moment","children":[["$","$L28",null,{"seconds":994,"label":"16:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Responsibility for the defeat is assigned"}],["$","p",null,{"children":"The episode holds Halleck and McClellan partly responsible but identifies Pope’s decisions as the principal cause of the Federal calamity."}]]}]]}]
30:["$","div","Pope is ordered to Minnesota",{"className":"moment","children":[["$","$L28",null,{"seconds":1206,"label":"20:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope is ordered to Minnesota"}],["$","p",null,{"children":"The September 6 assignment removes Pope from the eastern command after the Army of Virginia’s dissolution."}]]}]]}]
31:["$","div","Washington confronts alarm and demoralization",{"className":"moment","children":[["$","$L28",null,{"seconds":1286,"label":"21:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Washington confronts alarm and demoralization"}],["$","p",null,{"children":"Reports from the capital and the retreating ranks show fear for Washington and a collapse of confidence in the army’s leadership."}]]}]]}]
32:["$","div","Lincoln weighs cabinet opposition",{"className":"moment","children":[["$","$L28",null,{"seconds":1438,"label":"23:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln weighs cabinet opposition"}],["$","p",null,{"children":"Stanton seeks a court-martial, Chase urges extreme punishment, and four cabinet members support removing McClellan."}]]}]]}]
33:["$","div","Lincoln and Halleck visit McClellan",{"className":"moment","children":[["$","$L28",null,{"seconds":1491,"label":"24:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln and Halleck visit McClellan"}],["$","p",null,{"children":"On the morning of September 2, they ask McClellan to take charge of the forces retreating into the Washington defenses."}]]}]]}]
34:["$","div","McClellan accepts the command",{"className":"moment","children":[["$","$L28",null,{"seconds":1515,"label":"25:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan accepts the command"}],["$","p",null,{"children":"McClellan later writes that Lincoln asked him to resume command and do the best possible, and that he accepted without conditions."}]]}]]}]
35:["$","div","The cabinet receives Lincoln’s decision",{"className":"moment","children":[["$","$L28",null,{"seconds":1568,"label":"26:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cabinet receives Lincoln’s decision"}],["$","p",null,{"children":"Stanton and Chase protest, while Lincoln insists that McClellan is the one commander who can reorganize the demoralized army."}]]}]]}]
36:["$","div","McClellan rides out to meet the retreat",{"className":"moment","children":[["$","$L28",null,{"seconds":1635,"label":"27:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan rides out to meet the retreat"}],["$","p",null,{"children":"In dress uniform and riding Dan Webster, McClellan encounters Pope, McDowell, and the returning columns."}]]}]]}]
37:["$","div","Hatch announces McClellan’s return",{"className":"moment","children":[["$","$L28",null,{"seconds":1666,"label":"27:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hatch announces McClellan’s return"}],["$","p",null,{"children":"John P. Hatch calls to the soldiers that McClellan is back in command and asks for three cheers within Pope’s hearing."}]]}]]}]
38:["$","div","The cheering spreads through the column",{"className":"moment","children":[["$","$L28",null,{"seconds":1688,"label":"28:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cheering spreads through the column"}],["$","p",null,{"children":"Soldiers and observers describe an immediate change in morale as news of McClellan’s restoration moves along the road."}]]}]]}]
39:["$","div","The merged army is made ready again",{"className":"moment","children":[["$","$L28",null,{"seconds":1781,"label":"29:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The merged army is made ready again"}],["$","p",null,{"children":"Within days McClellan reorganizes and integrates the formations into a force capable of responding to Lee."}]]}]]}]
