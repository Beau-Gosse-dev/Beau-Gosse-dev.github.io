1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",180," · ","August 30–September 4, 1862"," · ","Northern Virginia and the approaches to Washington, from Manassas and Centreville through Chantilly and Fairfax Court House to Washington and Alexandria"]}],["$","h1",null,{"children":"\"BOYS, McCLELLAN IS BACK IN COMMAND OF THE ARMY AGAIN!\""}],["$","span",null,{"className":"result-label","children":"Federal command transition after a Confederate campaign victory. Pope’s Army of Virginia withdrew into the Washington defenses and was absorbed into McClellan’s Army of the Potomac. McClellan took command of the forces defending the capital on September 2 and rapidly restored order, while Lee ended his pursuit and turned toward the Potomac for the Maryland Campaign"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5744090887.mp3?updated=1695419442","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The aftermath of Second Manassas and McClellan’s return to command"}],["$","small",null,{"children":"The episode reviews the August campaign, assigns responsibility for the Federal defeat, follows Pope’s retreat, and explains Lincoln’s September 2 decision. It ends as Lee begins crossing the Potomac into Maryland on September 4."}]]}],["$","div","Second Manassas campaign strength",{"children":[["$","span",null,{"children":"Second Manassas campaign strength"}],["$","strong",null,{"children":"75,696 United States troops and 48,527 Confederates"}],["$","small",null,{"children":"These are campaign participation figures used by the episode and the U.S. Army Center of Military History. They are not the number simultaneously engaged on one battlefield."}]]}],["$","div","United States campaign losses",{"children":[["$","span",null,{"children":"United States campaign losses"}],["$","strong",null,{"children":"1,724 killed, 8,372 wounded, and 5,958 missing"}],["$","small",null,{"children":"The three categories total 16,054. The episode rounds this to about 16,000 while noting that published totals vary according to the dates and actions included."}]]}],["$","div","Confederate campaign losses",{"children":[["$","span",null,{"children":"Confederate campaign losses"}],["$","strong",null,{"children":"1,481 killed, 7,627 wounded, and 89 missing"}],["$","small",null,{"children":"The three categories total 9,197, commonly rounded to about 9,200 in the episode’s account."}]]}],["$","div","Lee’s strategic objective",{"children":[["$","span",null,{"children":"Lee’s strategic objective"}],["$","strong",null,{"children":"Defeat Pope before the Army of the Potomac could unite with him"}],["$","small",null,{"children":"Lee used Jackson’s wide turning movement to force Pope away from the Rappahannock and strike the Federal rear. Longstreet followed and delivered the decisive August 30 counterattack."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}],"$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}]]}]
28:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Jackson’s flank march",{"children":[["$","span",null,{"children":"Jackson’s flank march"}],["$","strong",null,{"children":"54 miles in 36 hours in the episode’s account"}],["$","small",null,{"children":"Jackson reached Manassas Junction, destroyed Federal stores, and withdrew to ground near the earlier Bull Run battlefield. The episode credits this strategic movement while sharply criticizing his tactical performance at Groveton and on August 30."}]]}]
f:["$","div","Longstreet’s August 30 attack",{"children":[["$","span",null,{"children":"Longstreet’s August 30 attack"}],["$","strong",null,{"children":"The largest attack Lee launched during the war"}],["$","small",null,{"children":"The assault crushed Pope’s left but lost cohesion across difficult ground. Federal defenders at Chinn Ridge and Henry Hill kept the defeat from becoming the destruction of Pope’s army."}]]}]
10:["$","div","Chantilly / Ox Hill",{"children":[["$","span",null,{"children":"Chantilly / Ox Hill"}],["$","strong",null,{"children":"An indecisive September 1 action that stopped Jackson’s attempt to cut the retreat"}],["$","small",null,{"children":"Kearny’s and Stevens’s divisions fought Jackson in a severe thunderstorm. Both Federal division commanders were killed, but Pope’s army continued toward Washington."}]]}]
11:["$","div","Pope’s command",{"children":[["$","span",null,{"children":"Pope’s command"}],["$","strong",null,{"children":"Army of Virginia dissolved after its return to Washington"}],["$","small",null,{"children":"Its formations were integrated into the Army of the Potomac. Pope received orders on September 6 to proceed to Minnesota, ending his 74 days in command of the Army of Virginia."}]]}]
12:["$","div","Fitz John Porter prosecution",{"children":[["$","span",null,{"children":"Fitz John Porter prosecution"}],["$","strong",null,{"children":"Court-martialed in 1863 for alleged disobedience during Second Manassas"}],["$","small",null,{"children":"Pope made Porter the principal target of his post-campaign accusations. Porter was dismissed from the Army; after a later review rejected the original findings, Congress restored his commission in 1886."}]]}]
13:["$","div","Halleck’s position",{"children":[["$","span",null,{"children":"Halleck’s position"}],["$","strong",null,{"children":"General-in-chief over two poorly coordinated Federal armies"}],["$","small",null,{"children":"Halleck had ordered the Army of the Potomac away from the Peninsula. The episode argues that his indecision and inability to compel rapid cooperation helped leave Pope exposed to Lee."}]]}]
14:["$","div","McClellan’s role before the defeat",{"children":[["$","span",null,{"children":"McClellan’s role before the defeat"}],["$","strong",null,{"children":"Controlled the pace at which Army of the Potomac units reached Pope"}],["$","small",null,{"children":"McClellan opposed the Peninsula withdrawal, regarded Pope as a rival, and delayed or resisted orders to send forces forward from Alexandria. Lincoln described his conduct as bad but still judged him the available commander most able to restore the army."}]]}]
15:["$","div","Crisis at Washington",{"children":[["$","span",null,{"children":"Crisis at Washington"}],["$","strong",null,{"children":"Defeat produced public alarm and severe army demoralization"}],["$","small",null,{"children":"Pope’s beaten formations and Army of the Potomac units converged on the capital with low confidence in their senior commanders. Lee’s army remained close enough to make defense and reorganization urgent."}]]}]
16:["$","div","Lincoln’s decision",{"children":[["$","span",null,{"children":"Lincoln’s decision"}],["$","strong",null,{"children":"McClellan placed in command of the capital’s defenses on September 2"}],["$","small",null,{"children":"Lincoln and Halleck visited McClellan that morning and asked him to take charge of the forces falling back into Washington, including Pope’s army. The restoration did not make McClellan general-in-chief."}]]}]
17:["$","div","McClellan’s first arrangements",{"children":[["$","span",null,{"children":"McClellan’s first arrangements"}],["$","strong",null,{"children":"Alert garrisons, clear roads, collect stragglers, and secure trains"}],["$","small",null,{"children":"In a 12:50 p.m. report to Lincoln, McClellan described guards and food on the roads, cavalry moving Pope’s trains, wagons placed away from troop routes, and Abercrombie’s brigade ordered to Chain Bridge."}]]}]
18:["$","div","Cabinet opposition",{"children":[["$","span",null,{"children":"Cabinet opposition"}],["$","strong",null,{"children":"Stanton and Chase protested the restoration"}],["$","small",null,{"children":"Four cabinet members had supported a memorandum urging McClellan’s removal. Lincoln acknowledged the accusations against him but maintained that McClellan could reorganize the army and bring it out of chaos."}]]}]
19:["$","div","Episode title",{"children":[["$","span",null,{"children":"Episode title"}],["$","strong",null,{"children":"John P. Hatch announced McClellan’s return within Pope’s hearing"}],["$","small",null,{"children":"As McClellan met the retreating column, Hatch called out that McClellan was back in command and asked for three cheers. The episode uses the announcement as its title."}]]}]
1a:["$","div","Army reaction",{"children":[["$","span",null,{"children":"Army reaction"}],["$","strong",null,{"children":"Retreating soldiers cheered McClellan’s return"}],["$","small",null,{"children":"Contemporary observers who did not share McClellan’s politics nevertheless recorded his exceptional popularity with the Army of the Potomac. The episode treats that confidence as the practical reason Lincoln’s choice worked in the immediate emergency."}]]}]
1b:["$","div","Immediate reorganization",{"children":[["$","span",null,{"children":"Immediate reorganization"}],["$","strong",null,{"children":"Separate formations became a workable field army within days"}],["$","small",null,{"children":"McClellan integrated the Army of Virginia’s units with the Army of the Potomac, restored discipline and supply movement, and prepared the combined force to respond to Lee."}]]}]
1c:["$","div","Next campaign",{"children":[["$","span",null,{"children":"Next campaign"}],["$","strong",null,{"children":"Lee began crossing the Potomac into Maryland on September 4"}],["$","small",null,{"children":"The transfer of command at Washington therefore became the opening Federal response to the Maryland Campaign, not merely an administrative aftermath to Second Manassas."}]]}]
1d:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The Quartermaster: Montgomery C. Meigs, Lincoln’s General, Master Builder of the Union Army” by Robert O’Harrow Jr."}],["$","small",null,{"children":"The official episode page and transcript identify this biography of the Union quartermaster general as the recommendation."}]]}]
1e:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Hennessy, Irvin McDowell, Philip Kearny, Montgomery C. Meigs, and Robert O’Harrow Jr."}],["$","small",null,{"children":"The automated transcript produces forms including “Hennessey,” “Ervin MacDowell,” “Phil Carney,” “Migs,” and “Robert O’Hara Jr.” The guide uses the standard historical spellings and the author spelling supplied by the official episode page."}]]}]
1f:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
20:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Retreat into the Washington defenses",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep180-retreat-to-washington.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Retreat into the Washington defenses at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep180-retreat-to-washington.svg","alt":"Schematic map of Pope’s retreat from Manassas through Centreville, Chantilly, and Fairfax Court House into the Washington defenses, with Lee turning toward Leesburg.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Retreat into the Washington defenses"}],["$","span",null,{"children":"After the August 30 defeat, Pope withdrew through Centreville. Jackson’s attempt to cut the route produced the September 1 fight at Chantilly, after which the Federal column continued through Fairfax Court House toward Washington and Alexandria. Lee then turned northwest toward Leesburg. Roads, waterways, routes, and locations are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep180-retreat-to-washington.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, U.S. War Department map, Robert Knox Sneden map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$20:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","McClellan’s defensive response on September 2",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep180-washington-response.svg","target":"_blank","rel":"noreferrer","aria-label":"Open McClellan’s defensive response on September 2 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep180-washington-response.svg","alt":"Schematic map of Washington, Alexandria, Chain Bridge, Fairfax Court House, and McClellan’s first measures for receiving Pope’s retreating army.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"McClellan’s defensive response on September 2"}],["$","span",null,{"children":"McClellan reported alerting the garrisons, placing guards and food on the roads, using cavalry to clear Pope’s trains, moving wagons away from troop routes, and ordering Abercrombie’s brigade to Chain Bridge. Arrows indicate the generalized direction of the army’s return, not exact unit routes. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep180-washington-response.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$20:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"George B. McClellan’s September 2, 1862 report to Abraham Lincoln, U.S. War Department map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$20:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],"$L27"]}]]}]
21:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode turns to the campaign aftermath",{"className":"moment","children":[["$","$L28",null,{"seconds":71,"label":"1:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode turns to the campaign aftermath"}],["$","p",null,{"children":"The hosts move from Second Manassas and Chantilly to the command crisis surrounding Pope, Halleck, Lincoln, and McClellan."}]]}]]}],["$","div","Campaign casualties are clarified",{"className":"moment","children":[["$","$L28",null,{"seconds":96,"label":"1:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Campaign casualties are clarified"}],["$","p",null,{"children":"The episode notes that totals vary, then gives about 16,000 United States losses and 9,200 Confederate losses for the campaign."}]]}]]}],["$","div","Lee’s first full campaign in command is assessed",{"className":"moment","children":[["$","$L28",null,{"seconds":170,"label":"2:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s first full campaign in command is assessed"}],["$","p",null,{"children":"The review distinguishes Lee’s mid-campaign assumption of command during the Peninsula Campaign from his direction of the Northern Virginia Campaign from the outset."}]]}]]}],["$","div","Jackson begins the wide turning movement",{"className":"moment","children":[["$","$L28",null,{"seconds":237,"label":"3:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson begins the wide turning movement"}],["$","p",null,{"children":"Lee sends Jackson around Pope’s right on August 24; the episode credits the 54-mile march with making the Second Manassas victory possible."}]]}]]}],["$","div","Jackson’s battlefield performance is criticized",{"className":"moment","children":[["$","$L28",null,{"seconds":286,"label":"4:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s battlefield performance is criticized"}],["$","p",null,{"children":"The episode contrasts Jackson’s strategic movement with his handling of the Groveton fight and his delayed advance on August 30."}]]}]]}],["$","div","Longstreet’s decisive contribution is reviewed",{"className":"moment","children":[["$","$L28",null,{"seconds":345,"label":"5:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet’s decisive contribution is reviewed"}],["$","p",null,{"children":"Longstreet’s large August 30 assault broke Pope’s left, though terrain and command control caused successive blows rather than one coordinated impact."}]]}]]}],["$","div","Lee’s command decisions are summarized",{"className":"moment","children":[["$","$L28",null,{"seconds":395,"label":"6:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s command decisions are summarized"}],["$","p",null,{"children":"Lee waits on August 29 and attacks decisively on August 30, coming close to destroying a United States army without completing that objective."}]]}]]}],["$","div","Pope reaches the Washington defenses",{"className":"moment","children":[["$","$L28",null,{"seconds":454,"label":"7:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope reaches the Washington defenses"}],["$","p",null,{"children":"Chantilly stops Jackson’s final turning attempt, and Pope completes the retreat from Centreville toward the capital."}]]}]]}],["$","div","Lincoln reacts to another defeat",{"className":"moment","children":[["$","$L28",null,{"seconds":512,"label":"8:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln reacts to another defeat"}],["$","p",null,{"children":"The episode uses Lincoln’s comment to John Hay to frame the discouragement in Washington after Second Manassas."}]]}]]}],["$","div","McDowell’s Chinn Ridge decision is revisited",{"className":"moment","children":[["$","$L28",null,{"seconds":547,"label":"9:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"McDowell’s Chinn Ridge decision is revisited"}],["$","p",null,{"children":"McDowell’s removal of Reynolds’s division shortly before Longstreet struck is identified as one of the Federal army’s gravest tactical errors."}]]}]]}],"$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b"]}]]}]
22:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Made the September 2 decision to place McClellan over the forces defending Washington despite strong cabinet opposition"}]]}],["$","div","General-in-chief, United States Army",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief, United States Army"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Transmitted national strategy and orders; accompanied Lincoln to McClellan and remained senior to him after the command change"}]]}],["$","div","Forces in and around Washington; Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Forces in and around Washington; Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Received Pope’s retreating formations, controlled the capital’s garrisons and approaches, and reorganized the combined force for field operations"}]]}],["$","div","Army of Virginia during the retreat",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia during the retreat"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"Directed the withdrawal from Second Manassas and Chantilly; relinquished his forces to McClellan before assignment to Minnesota"}]]}],["$","div","III Corps, Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Retreated with Pope and met McClellan on September 2; his August 30 decisions remained a focus of post-battle criticism"}]]}],["$","div","1st Division, III Corps, Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, III Corps, Army of Virginia"}],["$","span",null,{"children":"Brig. Gen. John P. Hatch"}],["$","small",null,{"children":"Had earlier been removed from cavalry command by Pope; publicly announced McClellan’s return to the passing troops"}]]}],["$","div","Brigade, Darius N. Couch’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Darius N. Couch’s division"}],["$","span",null,{"children":"Brig. Gen. John J. Abercrombie"}],["$","small",null,{"children":"Ordered to Chain Bridge as part of McClellan’s immediate defensive arrangements on September 2"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Ended the pursuit after Chantilly, concentrated near Chantilly on September 2, and then turned the army toward Leesburg and Maryland"}]]}],["$","div","Left Wing, Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing, Army of Northern Virginia"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Conducted the campaign’s wide flank march and the final attempt to intercept Pope at Chantilly"}]]}],["$","div","Right Wing, Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing, Army of Northern Virginia"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],"$L3c"]}]]]}]]}],"$L3d","$L3e"]}]
23:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Maj. Gen. Isaac I. Stevens",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. Isaac I. Stevens"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 1st Division, IX Corps","."]}]," ","Killed at Chantilly on September 1 while leading his division against Jackson’s attempt to cut Pope’s retreat route."]}]]}],["$","article","Maj. Gen. Philip Kearny",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. Philip Kearny"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 1st Division, III Corps, Army of the Potomac","."]}]," ","Killed at Chantilly on September 1 after riding into Confederate troops while checking his line during the thunderstorm."]}]]}]]}]]}]
24:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep180-retreat-to-washington.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep180-retreat-to-washington.svg","alt":"Schematic map of the Federal retreat from Manassas through Centreville, Chantilly, and Fairfax Court House to Washington and Alexandria.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The fight at Chantilly stopped Jackson’s last effort to cut the Federal retreat. Pope’s army continued into the capital’s defenses while Lee turned toward Leesburg."}]]}],["$","figure","/images/ep180-washington-response.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep180-washington-response.svg","alt":"Schematic map of McClellan’s September 2 arrangements on the western approaches to Washington.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"McClellan’s first report after taking charge describes an immediate traffic, supply, garrison, and straggler-control response as Pope’s troops returned."}]]}],["$","figure","/images/ep180-mcclellan-cheered.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep180-mcclellan-cheered.jpg","alt":"An 1862 wood engraving of Union soldiers cheering George B. McClellan in camp.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Published one month before McClellan’s restoration, this Harper’s Weekly engraving documents the army attachment that Lincoln relied upon after Second Manassas. It is not a view of the September 2 encounter."}]]}],["$","figure","/images/ep180-george-mcclellan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep180-george-mcclellan.jpg","alt":"Civil War-era glass-negative portrait of United States general George B. McClellan.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"George B. McClellan resumed command around Washington on September 2 and quickly reorganized the returning formations for the Maryland Campaign."}]]}],["$","figure","/images/ep180-john-pope.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep180-john-pope.jpg","alt":"Civil War-era glass-negative portrait of United States general John Pope in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"John Pope’s Army of Virginia ceased to exist as an independent army after its retreat. Pope was ordered to Minnesota on September 6."}]]}],["$","figure","/images/ep180-henry-halleck.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep180-henry-halleck.jpg","alt":"Civil War-era glass-negative portrait of United States general-in-chief Henry W. Halleck.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Henry W. Halleck remained general-in-chief. McClellan’s restored authority covered the troops in and around Washington, not Halleck’s national post."}]]}]]}]]}]
