d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",180," · ","August 30–September 4, 1862"," · ","Northern Virginia and the approaches to Washington, from Manassas and Centreville through Chantilly and Fairfax Court House to Washington and Alexandria"]}],["$","h1",null,{"children":"\"BOYS, McCLELLAN IS BACK IN COMMAND OF THE ARMY AGAIN!\""}],["$","span",null,{"className":"result-label","children":"Federal command transition after a Confederate campaign victory. Pope’s Army of Virginia withdrew into the Washington defenses and was absorbed into McClellan’s Army of the Potomac. McClellan took command of the forces defending the capital on September 2 and rapidly restored order, while Lee ended his pursuit and turned toward the Potomac for the Maryland Campaign"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"classN