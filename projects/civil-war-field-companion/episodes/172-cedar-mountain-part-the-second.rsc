28:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep172-regional-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-regional-context.svg","alt":"Generalized regional schematic of Jackson’s advance to Cedar Mountain and withdrawal across the Rapidan.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson moved north to strike Banks before Pope concentrated, then withdrew after the battle as the balance of the Army of Virginia arrived. This map is schematic and not to scale."}]]}],["$","figure","/images/ep172-cedar-mountain-tactics.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-cedar-mountain-tactics.svg","alt":"Generalized tactical sequence of Banks’s attacks and Hill’s Confederate counterattack.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Crawford broke the Confederate left, but the advance lost momentum before Hill’s brigades counterattacked. This map is schematic and not to scale."}]]}],["$","figure","/images/ep172-popes-battle-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-popes-battle-map.jpg","alt":"John Pope’s historical map of Cedar Mountain showing troop positions, terrain, roads, and farms.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Published in 1866 with Pope’s congressional report, this map records the battlefield at a scale of 1:31,680."}]]}],["$","figure","/images/ep172-federal-battery.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-federal-battery.jpg","alt":"Timothy O’Sullivan stereograph of a Federal battery fording a tributary of the Rappahannock on the day of the battle.","width":1280,"height":820,"