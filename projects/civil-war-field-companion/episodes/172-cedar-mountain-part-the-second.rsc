2c:["$","figure","John Pope’s published battlefield map",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep172-popes-battle-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open John Pope’s published battlefield map at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-popes-battle-map.jpg","alt":"Historical map titled Battlefield of Cedar Mountain, August 9th, 1862, showing roads, terrain, farms, and troop positions.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"John Pope’s published battlefield map"}],["$","span",null,{"children":"This surveyed historical map accompanied Pope’s report to the congressional Joint Committee on the Conduct of the War and was published in 1866. It plots troop positions, roads, farms, waterways, and relief at a scale of 1:31,680."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep172-popes-battle-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Geography and Map Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
2e:["$","p",null,{"children":"Jackson intends to cross the Rapidan on August 8 and attack Banks near Culpeper on August 9."}]
2f:["$","div","Heat and confusion disrupt the march",{"className":"moment","children":[["$","$L2d",null,{"seconds":910,"label":"15:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Heat and confusion disrupt the march"}],["$","p",null,{"children":"Changes in marching order, limited communication, and extreme temperatures string out the Confederate column."}]]}]]}]
30:["$","div","Only half the command crosses the Rapidan",{"className":"moment","children":[["$","$L2d",null,{"seconds":957,"label":"15:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Only half the command crosses the Rapidan"}],["$","p",null,{"children":"Jackson’s divisions are not concentrated as planned, and many soldiers are exhausted before the battle day begins."}]]}]]}]
31:["$","div","Banks advances to meet Jackson",{"className":"moment","children":[["$","$L2d",null,{"seconds":992,"label":"16:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks advances to meet Jackson"}],["$","p",null,{"children":"Instead of waiting at Culpeper, Banks moves south under verbal orders whose later interpretations remain disputed."}]]}]]}]
32:["$","div","Banks supports Crawford and Bayard",{"className":"moment","children":[["$","$L2d",null,{"seconds":1048,"label":"17:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks supports Crawford and Bayard"}],["$","p",null,{"children":"Banks moves the rest of his corps toward Crawford’s infantry brigade and George Bayard’s cavalry near Cedar Mountain."}]]}]]}]
33:["$","div","The Federal strength is estimated",{"className":"moment","children":[["$","$L2d",null,{"seconds":1088,"label":"18:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Federal strength is estimated"}],["$","p",null,{"children":"The episode gives Banks about 9,000 men at Cedar Mountain, including roughly 1,200 cavalry."}]]}]]}]
34:["$","div","The battlefield terrain is described",{"className":"moment","children":[["$","$L2d",null,{"seconds":1095,"label":"18:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battlefield terrain is described"}],["$","p",null,{"children":"The opposing lines run roughly north to south across wheat, corn, pasture, and wooded ground beneath Cedar Mountain."}]]}]]}]
35:["$","div","The artillery duel begins",{"className":"moment","children":[["$","$L2d",null,{"seconds":1136,"label":"18:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"The artillery duel begins"}],["$","p",null,{"children":"At about 3 p.m. the guns open; Confederate positions on and behind the line create a damaging crossfire."}]]}]]}]
