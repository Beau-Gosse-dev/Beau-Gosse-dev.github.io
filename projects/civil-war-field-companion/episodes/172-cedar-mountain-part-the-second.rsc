4f:["$","div","The casualty totals are given",{"className":"moment","children":[["$","$L2d",null,{"seconds":1972,"label":"32:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"The casualty totals are given"}],["$","p",null,{"children":"The episode counts 2,403 Federal and 1,418 Confederate killed, wounded, or captured."}]]}]]}]
50:["$","div","Jackson withdraws after the burials",{"className":"moment","children":[["$","$L2d",null,{"seconds":2005,"label":"33:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson withdraws after the burials"}],["$","p",null,{"children":"Following flags of truce to bury the dead, the Confederates begin retiring across the Rapidan on August 11."}]]}]]}]
51:["$","div","The operational result is assessed",{"className":"moment","children":[["$","$L2d",null,{"seconds":2017,"label":"33:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"The operational result is assessed"}],["$","p",null,{"children":"Although Jackson’s tactics were costly and he left the field, the battle checked Pope and transferred the initiative to Lee."}]]}]]}]
52:["$","div","The book recommendation is given",{"className":"moment","children":[["$","$L2d",null,{"seconds":2090,"label":"34:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"The book recommendation is given"}],["$","p",null,{"children":"The hosts recommend Robert K. Krick’s “Stonewall Jackson at Cedar Mountain.”"}]]}]]}]
