3a:["$","div","Jackson and Ewell make the battle plan",{"className":"moment","children":[["$","$L2d",null,{"seconds":1400,"label":"23:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson and Ewell make the battle plan"}],["$","p",null,{"children":"Ewell will place Trimble and Henry Forno on Cedar Mountain while Early presses up the road and Winder comes in on the left."}]]}]]}]
3b:["$","div","Jackson’s engaged strength is estimated",{"className":"moment","children":[["$","$L2d",null,{"seconds":1459,"label":"24:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s engaged strength is estimated"}],["$","p",null,{"children":"The episode states that Jackson ultimately brings about 15,000 men into the Cedar Mountain fighting."}]]}]]}]
3c:["$","div","Early forms near the Crittenden farmhouse",{"className":"moment","children":[["$","$L2d",null,{"seconds":1496,"label":"24:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early forms near the Crittenden farmhouse"}],["$","p",null,{"children":"His roughly 1,500 men cross the farm lane and take position before Federal artillery forces them below the crest."}]]}]]}]
3d:["$","div","Ewell occupies Cedar Mountain",{"className":"moment","children":[["$","$L2d",null,{"seconds":1528,"label":"25:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell occupies Cedar Mountain"}],["$","p",null,{"children":"Trimble and Forno move to the northern shoulder, giving Confederate artillery commanding ground over the southern battlefield."}]]}]]}]
3e:["$","div","Winder’s division arrives",{"className":"moment","children":[["$","$L2d",null,{"seconds":1576,"label":"26:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Winder’s division arrives"}],["$","p",null,{"children":"The division begins deploying north of the road while A. P. Hill’s six brigades remain stretched along the route behind it."}]]}]]}]
3f:["$","div","Banks conceals the smaller Federal force",{"className":"moment","children":[["$","$L2d",null,{"seconds":1603,"label":"26:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks conceals the smaller Federal force"}],["$","p",null,{"children":"Augur is screened by the cornfield south of the road and Williams by woods north of it."}]]}]]}]
40:["$","div","The artillery duel intensifies",{"className":"moment","children":[["$","$L2d",null,{"seconds":1667,"label":"27:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"The artillery duel intensifies"}],["$","p",null,{"children":"The batteries exchange fire for about two hours while the Confederate infantry line remains imperfectly aligned."}]]}]]}]
41:["$","div","Winder becomes the senior casualty",{"className":"moment","children":[["$","$L2d",null,{"seconds":1681,"label":"28:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Winder becomes the senior casualty"}],["$","p",null,{"children":"A Federal shell mortally wounds Winder while he is helping direct artillery fire near the road."}]]}]]}]
42:["$","div","Taliaferro assumes division command",{"className":"moment","children":[["$","$L2d",null,{"seconds":1707,"label":"28:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taliaferro assumes division command"}],["$","p",null,{"children":"Without Jackson’s full plan and unable to find him, Taliaferro concentrates on the immediate center of the line."}]]}]]}]
43:["$","div","Thomas reinforces Early",{"className":"moment","children":[["$","$L2d",null,{"seconds":1722,"label":"28:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas reinforces Early"}],["$","p",null,{"children":"Edward L. Thomas’s Georgians, the first brigade of Hill’s division to arrive, strengthen the Confederate right."}]]}]]}]
44:["$","div","Banks attacks first",{"className":"moment","children":[["$","$L2d",null,{"seconds":1737,"label":"28:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks attacks first"}],["$","p",null,{"children":"At about 5:30 p.m., Augur sends Geary and Prince through the cornfield against the Confederate center and right."}]]}]]}]
45:["$","div","Augur is wounded",{"className":"moment","children":[["$","$L2d",null,{"seconds":1765,"label":"29:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Augur is wounded"}],["$","p",null,{"children":"George S. Greene replaces the wounded division commander as the attack disrupts Jackson’s intended advance south of the road."}]]}]]}]
46:["$","div","Crawford crosses the wheat field",{"className":"moment","children":[["$","$L2d",null,{"seconds":1774,"label":"29:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crawford crosses the wheat field"}],["$","p",null,{"children":"Three regiments emerge from the woods north of the road and strike the exposed Confederate left shortly before 6 p.m."}]]}]]}]
47:["$","div","Garnett’s line breaks",{"className":"moment","children":[["$","$L2d",null,{"seconds":1801,"label":"30:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Garnett’s line breaks"}],["$","p",null,{"children":"After three volleys, part of Garnett’s brigade and the Stonewall Brigade fall back as Crawford drives into the woods."}]]}]]}]
48:["$","div","Jackson rallies the left",{"className":"moment","children":[["$","$L2d",null,{"seconds":1839,"label":"30:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson rallies the left"}],["$","p",null,{"children":"Jackson rides into the disordered sector and urges the men to hold while the Federal advance loses cohesion and reserves."}]]}]]}]
49:["$","div","Hill’s brigades counterattack",{"className":"moment","children":[["$","$L2d",null,{"seconds":1881,"label":"31:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hill’s brigades counterattack"}],["$","p",null,{"children":"Branch attacks Crawford’s front while Archer and Pender move against his right, reversing the Federal breakthrough."}]]}]]}]
4a:["$","div","Crawford retreats",{"className":"moment","children":[["$","$L2d",null,{"seconds":1902,"label":"31:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crawford retreats"}],["$","p",null,{"children":"With more than half the brigade killed, wounded, or captured, the survivors withdraw across the wheat field."}]]}]]}]
4b:["$","div","Federal reserves cover the withdrawal",{"className":"moment","children":[["$","$L2d",null,{"seconds":1911,"label":"31:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal reserves cover the withdrawal"}],["$","p",null,{"children":"The 10th Maine and parts of Gordon’s brigade suffer heavily while trying to slow the Confederate counterattack."}]]}]]}]
4c:["$","div","Banks retreats toward Culpeper",{"className":"moment","children":[["$","$L2d",null,{"seconds":1930,"label":"32:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks retreats toward Culpeper"}],["$","p",null,{"children":"Darkness settles as the Federal line gives way; a division from McDowell’s corps reaches the area too late to fight."}]]}]]}]
4d:["$","div","Pegram’s battery is silenced",{"className":"moment","children":[["$","$L2d",null,{"seconds":1947,"label":"32:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pegram’s battery is silenced"}],["$","p",null,{"children":"Federal guns catch William J. Pegram’s exposed battery in crossfire during the pursuit."}]]}]]}]
