37:["$","div","Early meets Federal sentries",{"className":"moment","children":[["$","$L2d",null,{"seconds":1232,"label":"20:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early meets Federal sentries"}],["$","p",null,{"children":"Confederate skirmishers make contact and pause while commanders observe the growing Federal force."}]]}]]}]
38:["$","div","Early moves on the road junction",{"className":"moment","children":[["$","$L2d",null,{"seconds":1247,"label":"20:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early moves on the road junction"}],["$","p",null,{"children":"Ewell directs Early to secure the intersection where the Madison Court House road met the Culpeper–Orange route."}]]}]]}]
