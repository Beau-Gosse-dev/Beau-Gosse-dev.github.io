1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",172," · ","August 7–11, 1862; battle fought August 9"," · ","Cedar Mountain battlefield along the Culpeper–Orange Road south of Culpeper Court House, Culpeper County, Virginia"]}],["$","h1",null,{"children":"CEDAR MOUNTAIN (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Confederate victory. Banks’s outnumbered II Corps struck first and broke part of Jackson’s left, but arriving brigades from A. P. Hill’s Light Division restored the line and drove the Federals toward Culpeper. Jackson stopped the pursuit after dark and withdrew across the Rapidan on August 11 as the rest of Pope’s army concentrated"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5163971458.mp3?updated=1695419257","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Jackson’s August 7 advance through the August 11 withdrawal after Cedar Mountain"}],["$","small",null,{"children":"Episode 171 established the opposing armies and the move toward Culpeper. This episode covers the approach march, deployment, battle, casualties, and immediate operational result."}]]}],["$","div","Campaign",{"children":[["$","span",null,{"children":"Campaign"}],["$","strong",null,{"children":"Northern Virginia Campaign"}],["$","small",null,{"children":"The National Park Service treats Cedar Mountain as the opening battle of the campaign that culminated at Second Manassas."}]]}],["$","div","Confederate objective",{"children":[["$","span",null,{"children":"Confederate objective"}],["$","strong",null,{"children":"Defeat Banks before Pope’s Army of Virginia could concentrate"}],["$","small",null,{"children":"Jackson moved north from the Gordonsville area after learning that Banks’s II Corps was forward near Culpeper and separated from Pope’s other corps."}]]}],["$","div","August 8 march",{"children":[["$","span",null,{"children":"August 8 march"}],["$","strong",null,{"children":"Confused, delayed, and broken up by severe heat"}],["$","small",null,{"children":"Jackson’s secrecy and changes to the order of march contributed to friction with A. P. Hill. The episode states that only about half of Jackson’s command crossed the Rapidan that day."}]]}],["$","div","Banks’s decision",{"children":[["$","span",null,{"children":"Banks’s decision"}],["$","strong",null,{"children":"Advanced south and attacked before Federal reinforcements arrived"}],["$","small",null,{"children":"Banks and Pope later disagreed about the meaning of Pope’s verbal orders. The episode assigns responsibility to Pope for failing to provide unambiguous written instructions."}]]}],["$","div","Forces in the episode",{"children":[["$","span",null,{"children":"Forces in the episode"}],["$","strong",null,{"children":"About 9,000 Federals and about 15,000 Confederates brought into the fight"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}],"$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b"]}]]}]
2d:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"The National Park Service battlefield database lists 8,030 United States and 16,868 Confederate troops engaged. Differences reflect how cavalry, artillery, late arrivals, and troops actually committed are counted."}]
f:["$","div","Battlefield",{"children":[["$","span",null,{"children":"Battlefield"}],["$","strong",null,{"children":"A roughly north–south front of fields and woods beneath Cedar Mountain"}],["$","small",null,{"children":"The Federal and Confederate lines were generally separated by about half a mile. Woods screened the northern flanks; wheat, corn, pasture, and rolling ground shaped the attacks."}]]}]
10:["$","div","Other names",{"children":[["$","span",null,{"children":"Other names"}],["$","strong",null,{"children":"Cedar Run, Slaughter’s Mountain, and Belle Grove"}],["$","small",null,{"children":"The episode explains that Cedar Mountain was also called Slaughter’s Mountain. The National Park Service battlefield database lists Belle Grove as another name."}]]}]
11:["$","div","Weather",{"children":[["$","span",null,{"children":"Weather"}],["$","strong",null,{"children":"Extreme heat, reaching about 98°F in the episode’s account"}],["$","small",null,{"children":"Men in both armies fell out from exhaustion and heat illness during the approach and deployment."}]]}]
12:["$","div","Early’s advance",{"children":[["$","span",null,{"children":"Early’s advance"}],["$","strong",null,{"children":"Secured the road junction and formed near the Crittenden farm"}],["$","small",null,{"children":"Jubal Early detached part of his brigade to guard against cavalry, drove back Federal horsemen with artillery support, and deployed astride the Culpeper–Orange Road."}]]}]
13:["$","div","Confederate high ground",{"children":[["$","span",null,{"children":"Confederate high ground"}],["$","strong",null,{"children":"Ewell placed Trimble, Forno, and artillery on Cedar Mountain’s northern shoulder"}],["$","small",null,{"children":"The position protected the Confederate right and enabled artillery to fire across much of the Federal front."}]]}]
14:["$","div","Federal deployment",{"children":[["$","span",null,{"children":"Federal deployment"}],["$","strong",null,{"children":"Williams north of the road; Augur south of it"}],["$","small",null,{"children":"Crawford’s and Gordon’s brigades formed in the wooded and open ground north of the road. Geary, Prince, and Greene formed in Augur’s sector south of it."}]]}]
15:["$","div","Artillery duel",{"children":[["$","span",null,{"children":"Artillery duel"}],["$","strong",null,{"children":"Opened at about 3 p.m. and continued for roughly two hours"}],["$","small",null,{"children":"Confederate guns near the road, behind the infantry line, and on Cedar Mountain created intersecting fields of fire against Federal batteries north of Cedar Run."}]]}]
16:["$","div","Winder mortally wounded",{"children":[["$","span",null,{"children":"Winder mortally wounded"}],["$","strong",null,{"children":"Struck by a shell while directing artillery fire"}],["$","small",null,{"children":"Brig. Gen. Charles S. Winder suffered devastating wounds to his left arm and side and died within hours. His loss disrupted command of the Confederate division immediately before the infantry battle."}]]}]
17:["$","div","Command succession",{"children":[["$","span",null,{"children":"Command succession"}],["$","strong",null,{"children":"William B. Taliaferro took command of Winder’s division"}],["$","small",null,{"children":"Taliaferro could not locate Jackson and had not been told the full plan. He concentrated on the sector around his own brigade and Early’s left."}]]}]
18:["$","div","Federal attack",{"children":[["$","span",null,{"children":"Federal attack"}],["$","strong",null,{"children":"Banks attacked at about 5:30 p.m."}],["$","small",null,{"children":"Augur’s brigades advanced through the cornfield south of the road. Shortly before 6 p.m., three regiments of Crawford’s brigade crossed the wheat field north of the road."}]]}]
19:["$","div","Crawford’s penetration",{"children":[["$","span",null,{"children":"Crawford’s penetration"}],["$","strong",null,{"children":"Broke Garnett’s left and disordered part of the Stonewall Brigade"}],["$","small",null,{"children":"Crawford’s men struck a poorly aligned Confederate left, fought through the woods, and turned into Taliaferro’s flank. The advance was not supported by enough fresh Federal infantry to exploit the opening."}]]}]
1a:["$","div","Jackson’s rally",{"children":[["$","span",null,{"children":"Jackson’s rally"}],["$","strong",null,{"children":"Jackson entered the broken sector and steadied retreating troops"}],["$","small",null,{"children":"The episode repeats the account that his sword had rusted in its scabbard, so he brandished the sheathed weapon while urging the men to stand."}]]}]
1b:["$","div","Hill’s counterattack",{"children":[["$","span",null,{"children":"Hill’s counterattack"}],["$","strong",null,{"children":"Branch, Archer, and Pender struck Crawford’s front and right"}],["$","small",null,{"children":"The arrival of A. P. Hill’s brigades supplied the reserves Jackson lacked. Edward L. Thomas also reinforced the Confederate right near Early."}]]}]
1c:["$","div","Crawford’s losses",{"children":[["$","span",null,{"children":"Crawford’s losses"}],["$","strong",null,{"children":"More than half of the attacking brigade killed, wounded, or captured"}],["$","small",null,{"children":"The episode describes the brigade retreating across the wheat field after its initial success and severe close-range fighting."}]]}]
1d:["$","div","Federal retreat",{"children":[["$","span",null,{"children":"Federal retreat"}],["$","strong",null,{"children":"Banks withdrew toward Culpeper after dark"}],["$","small",null,{"children":"The 10th Maine, elements of Gordon’s brigade, Federal artillery, and a cavalry charge helped cover the retreat. A division from McDowell’s corps arrived too late to enter the battle."}]]}]
1e:["$","div","Pegram’s battery",{"children":[["$","span",null,{"children":"Pegram’s battery"}],["$","strong",null,{"children":"Caught in Federal crossfire during the pursuit"}],["$","small",null,{"children":"Capt. William J. Pegram unlimbered on open ground against the retreating Federals. United States batteries silenced his guns, and Jackson halted the pursuit after roughly a mile."}]]}]
1f:["$","div","Casualties in the episode",{"children":[["$","span",null,{"children":"Casualties in the episode"}],["$","strong",null,{"children":"2,403 Federal and 1,418 Confederate casualties"}],["$","small",null,{"children":"The episode gives 1,786 Federals killed or wounded and 617 captured; Confederate losses are 1,376 killed or wounded and 42 captured. The National Park Service rounds the totals to about 2,500 and 1,400."}]]}]
20:["$","div","Immediate aftermath",{"children":[["$","span",null,{"children":"Immediate aftermath"}],["$","strong",null,{"children":"Burials under flags of truce; Jackson withdrew on August 11"}],["$","small",null,{"children":"Jackson could not remain against the rest of Pope’s concentrating army and retired toward Gordonsville across the Rapidan."}]]}]
21:["$","div","Operational effect",{"children":[["$","span",null,{"children":"Operational effect"}],["$","strong",null,{"children":"Pope lost the initiative despite Jackson’s withdrawal"}],["$","small",null,{"children":"The U.S. Army Center of Military History records that Jackson defeated Banks but did not pursue because Pope’s main body was nearby. Lee then shifted the broader campaign into northern Virginia."}]]}]
22:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Stonewall Jackson at Cedar Mountain” by Robert K. Krick"}],["$","small",null,{"children":"The hosts describe the book as detailed on the Confederate side and less complete on Federal movements."}]]}]
23:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Ewell, Augur, Alpheus S. Williams, Henry Forno, William B. Taliaferro, Thomas S. Garnett, Charles A. Ronald, and Irvin McDowell"}],["$","small",null,{"children":"The automated transcript produces “Yule,” “August,” “Altheus,” “Fornow,” “Tolliver,” and “Ervin.” Taliaferro was commonly pronounced “Tolliver.” “A rise” is a terrain description, not a place name."}]]}]
24:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
25:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Cedar Mountain in the Northern Virginia Campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep172-regional-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Cedar Mountain in the Northern Virginia Campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-regional-context.svg","alt":"Generalized schematic map of central Virginia showing Richmond, Gordonsville, Orange Court House, Rapidan crossings, Cedar Mountain, Culpeper, and the movements of Jackson and Banks.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Cedar Mountain in the Northern Virginia Campaign"}],["$","span",null,{"children":"Jackson moved north from Gordonsville through Orange Court House and the Rapidan crossings while Banks moved south from Culpeper. After the August 9 battle, Jackson withdrew south on August 11 as Pope concentrated. Routes, rivers, locations, arrows, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep172-regional-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, John Pope’s 1866 maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Federal attack and Confederate counterattack",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep172-cedar-mountain-tactics.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Federal attack and Confederate counterattack at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-cedar-mountain-tactics.svg","alt":"Two-panel generalized tactical map of the Federal attacks and the Confederate counterattack at Cedar Mountain on August 9, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Federal attack and Confederate counterattack"}],["$","span",null,{"children":"Williams deployed north of the Culpeper–Orange Road and Augur south of it. Crawford broke into the Confederate left while Geary and Prince pressed Early and Taliaferro. Branch, Archer, and Pender then counterattacked Crawford as Thomas and Ewell’s division strengthened the Confederate right. Unit bars, fields, woods, road alignments, and arrows are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep172-cedar-mountain-tactics.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, Official Records, John Pope’s 1866 battlefield map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],"$L2c"]}]]}]
26:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","William Warren describes five wounds",{"className":"moment","children":[["$","$L2d",null,{"seconds":45,"label":"0:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"William Warren describes five wounds"}],["$","p",null,{"children":"Lt. William P. Warren of the 28th New York recounts being wounded repeatedly during Crawford’s charge and remaining in the wheat field until Monday."}]]}]]}],["$","div","Edward Moore recalls Winder’s battery position",{"className":"moment","children":[["$","$L2d",null,{"seconds":152,"label":"2:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Edward Moore recalls Winder’s battery position"}],["$","p",null,{"children":"Pvt. Edward A. Moore of the Rockbridge Artillery describes Charles Winder directing guns near the road and Capt. Joseph Carpenter being mortally wounded."}]]}]]}],["$","div","The shell strikes Winder",{"className":"moment","children":[["$","$L2d",null,{"seconds":222,"label":"3:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"The shell strikes Winder"}],["$","p",null,{"children":"Moore’s account records the shell tearing through Winder’s arm and side; the general dies a few hours later."}]]}]]}],["$","div","The battle date and campaign setting are established",{"className":"moment","children":[["$","$L2d",null,{"seconds":288,"label":"4:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battle date and campaign setting are established"}],["$","p",null,{"children":"The hosts place Cedar Mountain on August 9, 1862, south of Culpeper and at the beginning of the campaign leading to Second Manassas."}]]}]]}],["$","div","Lee’s two-army problem is reviewed",{"className":"moment","children":[["$","$L2d",null,{"seconds":311,"label":"5:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s two-army problem is reviewed"}],["$","p",null,{"children":"McClellan remains at Harrison’s Landing while Pope’s Army of Virginia threatens Confederate rail links in central Virginia."}]]}]]}],["$","div","McClellan is ordered off the Peninsula",{"className":"moment","children":[["$","$L2d",null,{"seconds":389,"label":"6:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan is ordered off the Peninsula"}],["$","p",null,{"children":"The Army of the Potomac is to move by water and join Pope, producing a limited window for Jackson to attack."}]]}]]}],["$","div","Jackson identifies Banks as isolated",{"className":"moment","children":[["$","$L2d",null,{"seconds":478,"label":"7:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson identifies Banks as isolated"}],["$","p",null,{"children":"On August 7 Jackson learns that Banks’s II Corps is forward near Culpeper and begins moving to strike it."}]]}]]}],["$","div","John Gould describes close-range fire",{"className":"moment","children":[["$","$L2d",null,{"seconds":521,"label":"8:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"John Gould describes close-range fire"}],["$","p",null,{"children":"Lt. John M. Gould of the 10th Maine describes the confusion, intermingled formations, and varied weapons in Crawford’s fight."}]]}]]}],["$","div","John Blue watches Jackson react",{"className":"moment","children":[["$","$L2d",null,{"seconds":705,"label":"11:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"John Blue watches Jackson react"}],["$","p",null,{"children":"Lt. John M. Blue, a Confederate courier, recounts Jackson hearing the battle intensify and riding toward the threatened left."}]]}]]}],["$","div","Jackson enters the retreating line",{"className":"moment","children":[["$","$L2d",null,{"seconds":809,"label":"13:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson enters the retreating line"}],["$","p",null,{"children":"Blue describes the disputed sword-rally episode amid smoke, dense foliage, noise, and men falling back through the woods."}]]}]]}],["$","div","The August 7 advance begins",{"className":"moment","children":[["$","$L2d",null,{"seconds":897,"label":"14:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The August 7 advance begins"}],"$L2e"]}]]}],"$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51","$L52"]}]]}]
27:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"Directed the concentration around Culpeper; Banks’s II Corps fought before the rest of the army arrived"}]]}],["$","div","II Corps, Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Ordered the August 9 attack with divisions under Alpheus S. Williams and Christopher C. Augur"}]]}],["$","div","1st Division, II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, II Corps"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Brigades under Brig. Gen. Samuel W. Crawford and Brig. Gen. George H. Gordon north of the Culpeper–Orange Road"}]]}],["$","div","2nd Division, II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, II Corps"}],["$","span",null,{"children":"Brig. Gen. Christopher C. Augur"}],["$","small",null,{"children":"Brigades under Brig. Gens. John W. Geary, Henry Prince, and George S. Greene south of the road; Greene assumed command after Augur was wounded"}]]}],["$","div","Cavalry brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry brigade"}],["$","span",null,{"children":"Brig. Gen. George D. Bayard"}],["$","small",null,{"children":"Screened Banks’s advance with approximately 1,200 cavalry in the episode’s account"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Jackson’s command",{"className":"command-entry","children":[["$","strong",null,{"children":"Jackson’s command"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Divisions under Richard S. Ewell, Charles S. Winder, and A. P. Hill; directed the advance and rallied the threatened left"}]]}],["$","div","Ewell’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Ewell’s division"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Brigades under Jubal A. Early, Isaac R. Trimble, and Henry Forno; Early deployed near the road while Trimble and Forno occupied Cedar Mountain"}]]}],["$","div","Winder’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Winder’s division"}],["$","span",null,{"children":"Brig. Gen. Charles S. Winder; then Brig. Gen. William B. Taliaferro"}],["$","small",null,{"children":"Brigades under Col. Thomas S. Garnett, Taliaferro, and Col. Charles A. Ronald; Taliaferro assumed division command after Winder was mortally wounded"}]]}],["$","div","Light Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Light Division"}],["$","span",null,{"children":"Maj. Gen. A. P. Hill"}],["$","small",null,{"children":"Edward L. Thomas reinforced the Confederate right; Lawrence O’Bryan Branch, James J. Archer, and William Dorsey Pender led the counterattack against Crawford"}]]}],["$","div","Cavalry brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry brigade"}],["$","span",null,{"children":"Brig. Gen. Beverly H. Robertson"}],["$","small",null,{"children":"Included the 17th Virginia Cavalry Battalion, whose Lt. John M. Blue served as a courier with Jackson"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":["$L53","$L54","$L55","$L56","$L57","$L58","$L59","$L5a","$L5b","$L5c","$L5d","$L5e","$L5f","$L60","$L61","$L62","$L63","$L64","$L65","$L66","$L67","$L68","$L69","$L6a"]}]]}]
28:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. Charles S. Winder",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Charles S. Winder"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of Winder’s division","."]}]," ","Mortally wounded by a Federal shell while directing artillery near the road; died a few hours later on August 9, 1862"]}]]}],["$","article","Capt. Joseph Carpenter",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Capt. Joseph Carpenter"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of Carpenter’s Battery","."]}]," ","Struck in the head by a shell fragment near Winder’s position; lingered for several weeks before dying of the wound"]}]]}],["$","article","Brig. Gen. Christopher C. Augur",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brig. Gen. Christopher C. Augur"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the 2nd Division, II Corps","."]}]," ","Wounded during the attack south of the Culpeper–Orange Road; Brig. Gen. George S. Greene assumed division command"]}]]}]]}]]}]
29:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep172-regional-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-regional-context.svg","alt":"Generalized regional schematic of Jackson’s advance to Cedar Mountain and withdrawal across the Rapidan.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson moved north to strike Banks before Pope concentrated, then withdrew after the battle as the balance of the Army of Virginia arrived. This map is schematic and not to scale."}]]}],["$","figure","/images/ep172-cedar-mountain-tactics.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-cedar-mountain-tactics.svg","alt":"Generalized tactical sequence of Banks’s attacks and Hill’s Confederate counterattack.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Crawford broke the Confederate left, but the advance lost momentum before Hill’s brigades counterattacked. This map is schematic and not to scale."}]]}],["$","figure","/images/ep172-popes-battle-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-popes-battle-map.jpg","alt":"John Pope’s historical map of Cedar Mountain showing troop positions, terrain, roads, and farms.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Published in 1866 with Pope’s congressional report, this map records the battlefield at a scale of 1:31,680."}]]}],["$","figure","/images/ep172-federal-battery.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-federal-battery.jpg","alt":"Timothy O’Sullivan stereograph of a Federal battery fording a tributary of the Rappahannock on the day of the battle.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Timothy H. O’Sullivan photographed this Federal battery moving through the Cedar Mountain area on August 9, 1862."}]]}],["$","figure","/images/ep172-winder-death-house.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-winder-death-house.jpg","alt":"Timothy O’Sullivan stereograph of a family outside the house where Charles S. Winder died.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"O’Sullivan photographed the house where Charles S. Winder died after receiving his artillery wound at Cedar Mountain."}]]}],["$","figure","/images/ep172-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-stonewall-jackson.jpg","alt":"Civil War-era glass-negative portrait of Confederate general Thomas J. Stonewall Jackson.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson rallied the threatened Confederate left and used Hill’s arriving brigades to reverse the Federal breakthrough."}]]}],["$","figure","/images/ep172-nathaniel-banks.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-nathaniel-banks.jpg","alt":"Civil War-era portrait of United States general Nathaniel P. Banks in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Banks committed his outnumbered corps before Pope’s other formations reached the battlefield."}]]}],["$","figure","/images/ep172-ap-hill.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep172-ap-hill.jpg","alt":"Civil War-era portrait of Confederate general A. P. Hill in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hill’s Light Division arrived in time to supply the brigades that broke Crawford’s attack."}]]}]]}]]}]
