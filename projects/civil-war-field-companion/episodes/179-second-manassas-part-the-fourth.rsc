3a:["$","div","Pope regroups on August 31",{"className":"moment","children":[["$","$L2c",null,{"seconds":984,"label":"16:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope regroups on August 31"}],["$","p",null,{"children":"At Centreville, Pope has more than 60,000 soldiers available despite the losses and widespread straggling."}]]}]]}]
3b:["$","div","Lee orders another flanking movement",{"className":"moment","children":[["$","$L2c",null,{"seconds":1038,"label":"17:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee orders another flanking movement"}],["$","p",null,{"children":"Jackson is sent around the Federal right toward the Little River Turnpike while Longstreet holds Pope’s attention."}]]}]]}]
3c:["$","div","Germantown becomes the objective",{"className":"moment","children":[["$","$L2c",null,{"seconds":1053,"label":"17:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Germantown becomes the objective"}],["$","p",null,{"children":"The road junction east of Centreville could let Jackson cut the Federal route toward Fairfax and Washington."}]]}]]}]
3d:["$","div","Jackson’s exhausted wing moves slowly",{"className":"moment","children":[["$","$L2c",null,{"seconds":1083,"label":"18:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s exhausted wing moves slowly"}],["$","p",null,{"children":"With A. P. Hill leading in intermittent rain, the column stops near Chantilly instead of reaching Pope’s rear."}]]}]]}]
