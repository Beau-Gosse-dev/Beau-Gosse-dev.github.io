37:["$","div","Lee reports a “signal victory”",{"className":"moment","children":[["$","$L2c",null,{"seconds":819,"label":"13:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee reports a “signal victory”"}],["$","p",null,{"children":"The Confederate commander sends news of the Second Manassas victory to Richmond."}]]}]]}]
