1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",179," · ","August 30–September 4, 1862"," · ","Chinn Ridge and Henry Hill at Manassas, the withdrawal across Bull Run to Centreville, and Ox Hill near Chantilly, Virginia"]}],["$","h1",null,{"children":"SECOND MANASSAS (Part the Fourth)"}],["$","span",null,{"className":"result-label","children":"Confederate victory at Second Manassas. United States stands on Chinn Ridge and Henry Hill delayed Longstreet long enough for Pope’s army to escape across Bull Run. Lee retained the initiative, but the September 1 battle at Ox Hill/Chantilly was indecisive and did not cut the Federal route toward Washington"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2678374590.mp3?updated=1695419416","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The August 30 fight from Chinn Ridge to Henry Hill, Pope’s retreat, and the September 1 battle at Ox Hill/Chantilly"}],["$","small",null,{"children":"The episode closes both the Second Manassas battle narrative and the broader Northern Virginia Campaign, then follows the first organized relief of wounded soldiers left on the battlefield."}]]}],["$","div","McLean’s delaying stand",{"children":[["$","span",null,{"children":"McLean’s delaying stand"}],["$","strong",null,{"children":"About 1,200 Ohio soldiers held Chinn Ridge for roughly half an hour"}],["$","small",null,{"children":"Col. Nathaniel C. McLean’s four regiments were the only organized formation immediately between Longstreet’s leading brigades and Henry Hill. Their stand gave Pope and Irvin McDowell time to move additional brigades south of the turnpike."}]]}],["$","div","Confederate spearhead",{"children":[["$","span",null,{"children":"Confederate spearhead"}],["$","strong",null,{"children":"Hood’s Texas Brigade and Nathan G. “Shanks” Evans’s brigade"}],["$","small",null,{"children":"The two brigades struck McLean before James L. Kemper’s division wheeled north past the Chinn house and added weight to the attack."}]]}],["$","div","Second Federal line",{"children":[["$","span",null,{"children":"Second Federal line"}],["$","strong",null,{"children":"Zealous B. Tower’s and John W. Stiles’s brigades"}],["$","small",null,{"children":"McDowell rushed the brigades across the Warrenton Turnpike. Tower’s regiments formed near the four guns of the 5th Maine Light Artillery; Stiles arrived as Tower’s position gave way."}]]}],["$","div","5th Maine Light Artillery",{"children":[["$","span",null,{"children":"5th Maine Light Artillery"}],["$","strong",null,{"children":"Four guns fought beside Tower’s line and were overrun"}],["$","small",null,{"children":"The battery became a focal point of the Chinn Ridge fighting. The 88th Pennsylvania defended this sector, where Lt. Col. Joseph A. McLean was mortally wounded."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}],"$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
2c:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Final reinforcements on Chinn Ridge",{"children":[["$","span",null,{"children":"Final reinforcements on Chinn Ridge"}],["$","strong",null,{"children":"John A. Koltes’s and Włodzimierz Krzyżanowski’s brigades"}],["$","small",null,{"children":"Franz Sigel shifted the two brigades south across the turnpike while Jackson remained largely inactive on Stony Ridge. Confederate artillery killed Koltes during the advance."}]]}]
f:["$","div","Chinn Ridge falls",{"children":[["$","span",null,{"children":"Chinn Ridge falls"}],["$","strong",null,{"children":"The Federal defenders withdrew by about 6 p.m."}],["$","small",null,{"children":"David R. Jones’s division extended Longstreet’s line and helped turn the last Federal position. The defense cost the Confederates men, cohesion, and most of the remaining daylight."}]]}]
10:["$","div","Henry Hill defense",{"children":[["$","span",null,{"children":"Henry Hill defense"}],["$","strong",null,{"children":"An improvised line held for about two hours"}],["$","small",null,{"children":"John F. Reynolds’s and George Sykes’s divisions, Robert H. Milroy’s and Robert C. Schenck’s brigades, artillery, and rallied fragments of the left wing defended the hill and the sunken Sudley Road."}]]}]
11:["$","div","Confederate attacks on Henry Hill",{"children":[["$","span",null,{"children":"Confederate attacks on Henry Hill"}],["$","strong",null,{"children":"David R. Jones and Richard H. Anderson did not break the line"}],["$","small",null,{"children":"Their attacks went forward without the unity or organization of Longstreet’s earlier advance. The Federal line yielded ground but remained intact long enough to cover the army’s withdrawal."}]]}]
12:["$","div","Jackson’s late movement",{"children":[["$","span",null,{"children":"Jackson’s late movement"}],["$","strong",null,{"children":"Four brigades advanced tentatively against the Federal right"}],["$","small",null,{"children":"The movement began after the opportunity to prevent Sigel from reinforcing the left had passed. Federal troops north of the Warrenton Turnpike remained in comparatively good order."}]]}]
13:["$","div","Cavalry at the escape route",{"children":[["$","span",null,{"children":"Cavalry at the escape route"}],["$","strong",null,{"children":"John Buford checked Beverly H. Robertson near the southern flank"}],["$","small",null,{"children":"Confederate cavalry pushed through Buford’s line but did not continue toward the Bull Run crossings. The withdrawal route therefore remained open."}]]}]
14:["$","div","Second Manassas result",{"children":[["$","span",null,{"children":"Second Manassas result"}],["$","strong",null,{"children":"Pope’s army escaped across Bull Run but had been decisively defeated"}],["$","small",null,{"children":"Under cover of darkness, Federal units crossed toward prepared positions at Centreville. Lee had won a major victory but had not destroyed the Army of Virginia."}]]}]
15:["$","div","Second Manassas casualties",{"children":[["$","span",null,{"children":"Second Manassas casualties"}],["$","strong",null,{"children":"The episode gives up to 13,000 United States and about 8,700 Confederate casualties"}],["$","small",null,{"children":"Published totals differ by source and by the treatment of missing soldiers. The National Park Service order of battle and U.S. Army campaign studies should be used alongside the hosts’ rounded figures rather than implying a single uncontested total."}]]}]
16:["$","div","Army still available to Pope",{"children":[["$","span",null,{"children":"Army still available to Pope"}],["$","strong",null,{"children":"More than 60,000 men around Centreville on August 31"}],["$","small",null,{"children":"Fresh elements of William B. Franklin’s VI Corps and Edwin V. Sumner’s II Corps arrived from the Army of the Potomac, offsetting the battle losses numerically but not restoring the defeated army’s organization or morale."}]]}]
17:["$","div","Lee’s next maneuver",{"children":[["$","span",null,{"children":"Lee’s next maneuver"}],["$","strong",null,{"children":"Jackson marched around Pope’s right toward Germantown"}],["$","small",null,{"children":"Lee ordered Longstreet to hold Pope’s attention while Jackson used the Little River Turnpike. Reaching its junction with the Warrenton Turnpike ahead of Pope could have cut the Federal route toward Fairfax and Washington."}]]}]
18:["$","div","March to Chantilly",{"children":[["$","span",null,{"children":"March to Chantilly"}],["$","strong",null,{"children":"A. P. Hill led Jackson’s tired wing through intermittent rain"}],["$","small",null,{"children":"The column moved too slowly to gain surprise and stopped near Chantilly. Federal scouts tracked it, and Pope ordered a further withdrawal on September 1."}]]}]
19:["$","div","Battle of Chantilly",{"children":[["$","span",null,{"children":"Battle of Chantilly"}],["$","strong",null,{"children":"Also called the Battle of Ox Hill"}],["$","small",null,{"children":"The action took place late on September 1 south of the Little River Turnpike during a severe thunderstorm. The National Park Service classifies the result as indecisive."}]]}]
1a:["$","div","Stevens’s attack",{"children":[["$","span",null,{"children":"Stevens’s attack"}],["$","strong",null,{"children":"The IX Corps division briefly broke into Jackson’s line"}],["$","small",null,{"children":"Brig. Gen. Isaac I. Stevens led his men across open ground near the junction of Alexander R. Lawton’s and A. P. Hill’s divisions. He was killed while carrying the colors of the 79th New York."}]]}]
1b:["$","div","Kearny’s death",{"children":[["$","span",null,{"children":"Kearny’s death"}],["$","strong",null,{"children":"Killed after riding into Confederate troops in rain and darkness"}],["$","small",null,{"children":"Maj. Gen. Philip Kearny rode forward while his division supported Stevens. He encountered Georgians in Edward L. Thomas’s brigade and was shot while turning away."}]]}]
1c:["$","div","Chantilly casualties",{"children":[["$","span",null,{"children":"Chantilly casualties"}],["$","strong",null,{"children":"The episode gives about 500 on each side"}],["$","small",null,{"children":"The National Park Service battle summary estimates 2,100 total casualties: 1,300 United States and 800 Confederate. The discrepancy illustrates the uncertainty and differing definitions in battle-level estimates."}]]}]
1d:["$","div","Wounded left behind",{"children":[["$","span",null,{"children":"Wounded left behind"}],["$","strong",null,{"children":"Hundreds remained exposed for days after the armies moved away"}],["$","small",null,{"children":"Small Federal parties arrived under flag of truce on September 2, but the episode dates the large-scale evacuation effort to September 4. Rain, hunger, exposure, and infection compounded the original wounds."}]]}]
1e:["$","div","Command after the retreat",{"children":[["$","span",null,{"children":"Command after the retreat"}],["$","strong",null,{"children":"George B. McClellan resumed control of the forces defending Washington"}],["$","small",null,{"children":"Pope’s Army of Virginia was soon discontinued and its corps were absorbed into the Army of the Potomac. Lee then turned north, beginning the Maryland Campaign."}]]}]
1f:["$","div","Campaign consequence",{"children":[["$","span",null,{"children":"Campaign consequence"}],["$","strong",null,{"children":"Lee carried the initiative into Maryland"}],["$","small",null,{"children":"Within three weeks the armies fought at Antietam near Sharpsburg on September 17, 1862."}]]}]
20:["$","div","Book recommendations",{"children":[["$","span",null,{"children":"Book recommendations"}],["$","strong",null,{"children":"Scott C. Patchan on Chinn Ridge and Paul Taylor on Ox Hill"}],["$","small",null,{"children":"The official episode page gives the titles as “Second Manassas: Longstreet’s Attack and the Struggle for Chinn Ridge” and “He Hath Loosed the Fateful Lightning: The Battle of Ox Hill (Chantilly) September 1, 1862.”"}]]}]
21:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Chinn, Irvin McDowell, Zealous Tower, John Stiles, John Koltes, David R. Jones, Robert Schenck, Philip Kearny, David Birney, Beverly Robertson, and Scott C. Patchan"}],["$","small",null,{"children":"The automated transcript produces forms including “Chin,” “Urban,” “Zellis,” “Stiles,” “Coltys,” “Jonesman,” “Shirts,” “Carney,” “Burney,” “Robinson,” and “Paton.” The quoted opening identifies Joseph A. McLean; he was not related to Nathaniel C. McLean."}]]}]
22:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
23:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The delaying fight from Chinn Ridge to Henry Hill",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep179-chinn-ridge-henry-hill.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The delaying fight from Chinn Ridge to Henry Hill at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep179-chinn-ridge-henry-hill.svg","alt":"Schematic map of Confederate attacks on Chinn Ridge and Henry Hill and the Federal retreat toward Bull Run on August 30, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The delaying fight from Chinn Ridge to Henry Hill"}],["$","span",null,{"children":"Longstreet’s brigades rolled up the Federal left on August 30. Successive stands by McLean, Tower, Stiles, Koltes, and Krzyżanowski on Chinn Ridge consumed time and organization. Reynolds, Sykes, Milroy, Schenck, artillery, and rallied troops then held Henry Hill while Pope withdrew toward Bull Run. Arrows and formation bars show generalized relationships, not exact routes, timing, frontages, or troop geometry. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep179-chinn-ridge-henry-hill.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Manassas National Battlefield Park, U.S. Army Center of Military History, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Pope’s retreat and Jackson’s move toward Chantilly",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep179-retreat-to-chantilly.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Pope’s retreat and Jackson’s move toward Chantilly at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep179-retreat-to-chantilly.svg","alt":"Schematic map showing Pope’s retreat through Centreville, Jackson’s flank march toward Germantown, and the Battle of Chantilly at Ox Hill.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Pope’s retreat and Jackson’s move toward Chantilly"}],["$","span",null,{"children":"After Second Manassas, Pope concentrated at Centreville and then continued toward Fairfax. Jackson marched northeast on the Little River Turnpike in an attempt to reach Germantown and the Federal line of retreat. Stevens and Kearny moved to block him near Ox Hill on September 1. Roads, waterways, routes, positions, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep179-retreat-to-chantilly.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, Robert Knox Sneden’s campaign and Chantilly maps, Official Records, U.S. Army Center of Military History, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2a"]}]]}],"$undefined"]}]]}],"$L2b"]}]]}]
24:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Longstreet’s attack rolls up the Federal left",{"className":"moment","children":[["$","$L2c",null,{"seconds":251,"label":"4:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet’s attack rolls up the Federal left"}],["$","p",null,{"children":"The episode resumes on Saturday, August 30, with the Army of Virginia facing defeat after the Confederate counterattack."}]]}]]}],["$","div","McLean stands on Chinn Ridge",{"className":"moment","children":[["$","$L2c",null,{"seconds":271,"label":"4:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"McLean stands on Chinn Ridge"}],["$","p",null,{"children":"Nathaniel C. McLean’s four Ohio regiments, about 1,200 men, are the only organized force immediately between the Confederate spearhead and Henry Hill."}]]}]]}],["$","div","The Ohio brigade buys half an hour",{"className":"moment","children":[["$","$L2c",null,{"seconds":297,"label":"4:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Ohio brigade buys half an hour"}],["$","p",null,{"children":"McLean’s resistance against Hood’s Texans and Evans’s South Carolinians gives Pope time to reinforce the threatened flank."}]]}]]}],["$","div","Tower and Stiles move across the turnpike",{"className":"moment","children":[["$","$L2c",null,{"seconds":308,"label":"5:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Tower and Stiles move across the turnpike"}],["$","p",null,{"children":"Irvin McDowell sends two more brigades south to Chinn Ridge as McLean’s line nears collapse."}]]}]]}],["$","div","Tower forms beside the 5th Maine battery",{"className":"moment","children":[["$","$L2c",null,{"seconds":330,"label":"5:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Tower forms beside the 5th Maine battery"}],["$","p",null,{"children":"Tower’s regiments and four artillery pieces open on Confederates advancing past the Chinn house."}]]}]]}],["$","div","Joseph A. McLean is mortally wounded",{"className":"moment","children":[["$","$L2c",null,{"seconds":339,"label":"5:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Joseph A. McLean is mortally wounded"}],["$","p",null,{"children":"The 88th Pennsylvania commander falls while supporting the battery; the opening letter describes the effort to stop his bleeding and his death on the field."}]]}]]}],["$","div","McLean’s final letter is recalled",{"className":"moment","children":[["$","$L2c",null,{"seconds":405,"label":"6:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"McLean’s final letter is recalled"}],["$","p",null,{"children":"The hosts quote his August 22 letter to his wife and explain his anxiety about leaving his family without support."}]]}]]}],["$","div","Tower’s line collapses",{"className":"moment","children":[["$","$L2c",null,{"seconds":418,"label":"6:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Tower’s line collapses"}],["$","p",null,{"children":"Kemper’s brigades link with Hood’s disordered advance and overrun the 5th Maine guns on Chinn Ridge."}]]}]]}],["$","div","Pope recognizes the danger",{"className":"moment","children":[["$","$L2c",null,{"seconds":463,"label":"7:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope recognizes the danger"}],["$","p",null,{"children":"Pope orders McDowell to keep shifting troops while he assembles a final defensive position on Henry Hill."}]]}]]}],["$","div","Sigel sends two brigades south",{"className":"moment","children":[["$","$L2c",null,{"seconds":490,"label":"8:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sigel sends two brigades south"}],["$","p",null,{"children":"Koltes and Krzyżanowski cross the Warrenton Turnpike to make the final organized Federal effort on Chinn Ridge."}]]}]]}],["$","div","Jackson remains slow to support Longstreet",{"className":"moment","children":[["$","$L2c",null,{"seconds":502,"label":"8:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson remains slow to support Longstreet"}],["$","p",null,{"children":"His failure to press the Federal right allows Sigel to transfer troops toward the collapsing left."}]]}]]}],"$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c"]}]]}]
25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"Directed the defense and withdrawal from Second Manassas; continued the retreat from Centreville toward Fairfax on September 1"}]]}],["$","div","III Corps, Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Moved Zealous B. Tower’s and John W. Stiles’s brigades from James B. Ricketts’s division to Chinn Ridge; John F. Reynolds’s attached division helped defend Henry Hill"}]]}],["$","div","I Corps, Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Franz Sigel"}],["$","small",null,{"children":"Robert C. Schenck’s division included Nathaniel C. McLean’s brigade; Carl Schurz’s division supplied John A. Koltes’s and Włodzimierz Krzyżanowski’s brigades"}]]}],["$","div","V Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps, Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"George Sykes’s Regular division helped form the final Federal line on Henry Hill"}]]}],["$","div","IX Corps detachment",{"className":"command-entry","children":[["$","strong",null,{"children":"IX Corps detachment"}],["$","span",null,{"children":"Maj. Gen. Jesse L. Reno"}],["$","small",null,{"children":"Isaac I. Stevens’s division moved to block Jackson at Chantilly; Stevens was killed while leading the attack"}]]}],["$","div","III Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. Samuel P. Heintzelman"}],["$","small",null,{"children":"Philip Kearny’s division, including David B. Birney’s brigade, reinforced Stevens at Chantilly; Kearny was killed"}]]}],["$","div","Forces defending Washington after Pope’s retreat",{"className":"command-entry","children":[["$","strong",null,{"children":"Forces defending Washington after Pope’s retreat"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Resumed command as Pope’s defeated field army returned; Franklin’s VI Corps and Sumner’s II Corps had reached the Centreville area"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #913c35","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Won at Second Manassas, then attempted to turn Pope’s Centreville position and cut the retreat toward Washington"}]]}],["$","div","Right Wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Divisions of John B. Hood, James L. Kemper, David R. Jones, Richard H. Anderson, and Cadmus M. Wilcox; drove across Chinn Ridge toward Henry Hill"}]]}],["$","div","Left Wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Advanced only tentatively late on August 30; on August 31–September 1 marched by the Little River Turnpike toward Germantown and deployed at Chantilly"}]]}],"$L4d","$L4e","$L4f"]]}]]}],"$L50","$L51"]}]
26:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Lt. Col. Joseph A. McLean",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Lt. Col. Joseph A. McLean"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 88th Pennsylvania Infantry, Tower’s brigade","."]}]," ","Mortally wounded while his regiment supported the 5th Maine Light Artillery on Chinn Ridge. An Ohio lieutenant tried to control the bleeding before the Confederate advance passed over the position; McLean died on the field."]}]]}],["$","article","Col. John A. Koltes",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. John A. Koltes"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 1st Brigade, Schurz’s division, I Corps","."]}]," ","Killed by Confederate artillery while leading his brigade south across the Warrenton Turnpike in the final effort to hold Chinn Ridge."]}]]}],["$","article","Col. Fletcher Webster",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. Fletcher Webster"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 12th Massachusetts Infantry, Stiles’s brigade","."]}]," ","Mortally wounded on Chinn Ridge while attempting to recover the overrun 5th Maine Light Artillery guns. He was captured and died later on August 30."]}]]}],["$","article","Brig. Gen. Isaac I. Stevens",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brig. Gen. Isaac I. Stevens"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 1st Division, IX Corps detachment","."]}]," ","Killed at Chantilly on September 1 while carrying the colors of the 79th New York and leading an attack into Jackson’s line during the thunderstorm."]}]]}],["$","article","Maj. Gen. Philip Kearny",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. Philip Kearny"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 1st Division, III Corps, Army of the Potomac","."]}]," ","Killed at Chantilly after riding into Edward L. Thomas’s Georgia brigade in rain and darkness and being shot while turning his horse away. Lee returned his body under a flag of truce."]}]]}]]}]]}]
27:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep179-chinn-ridge-henry-hill.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep179-chinn-ridge-henry-hill.svg","alt":"Schematic map of Confederate attacks on Chinn Ridge and Henry Hill and the Federal retreat toward Bull Run.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Successive Federal stands on Chinn Ridge delayed Longstreet before the final defense on Henry Hill covered Pope’s withdrawal. This map is schematic and not to scale."}]]}],["$","figure","/images/ep179-retreat-to-chantilly.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep179-retreat-to-chantilly.svg","alt":"Schematic map of Pope’s retreat, Jackson’s Little River Turnpike march, and the Battle of Chantilly.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s attempt to reach Germantown brought the armies together again at Ox Hill/Chantilly on September 1. This map is schematic and not to scale."}]]}],["$","figure","/images/ep179-kearny-charge.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep179-kearny-charge.jpg","alt":"Color lithograph of Philip Kearny on horseback leading United States soldiers during the Battle of Chantilly.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Augustus Tholey published this dramatic memory image of Kearny’s final battle in 1867. Its lightning, rain, and mounted figure evoke the event but do not document Kearny’s actual movements precisely."}]]}],["$","figure","/images/ep179-john-pope.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep179-john-pope.jpg","alt":"Civil War-era glass-negative portrait of United States general John Pope in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"John Pope saved most of the Army of Virginia from destruction on August 30 but lost the battle and soon lost his command."}]]}],["$","figure","/images/ep179-philip-kearny.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep179-philip-kearny.jpg","alt":"Half-length 1862 stereograph portrait of United States general Philip Kearny facing right.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Philip Kearny, photographed in 1862, was killed at Chantilly after riding into Confederate troops in the storm and darkness."}]]}],["$","figure","/images/ep179-isaac-stevens.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep179-isaac-stevens.jpg","alt":"1862 engraved portrait of United States general Isaac Ingalls Stevens in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Isaac I. Stevens was killed while carrying the colors of the 79th New York during his division’s attack at Chantilly."}]]}]]}]]}]
