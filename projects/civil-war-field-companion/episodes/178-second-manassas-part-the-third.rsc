"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Gouverneur K. Warren"}],["$","p",null,{"children":"Commander of the 5th and 10th New York in the path of Hood’s opening attack"}]]}]]}],["$","article","Robert E. Lee",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"RE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],"$L50","$L51"]}]]}],"$L52","$L53","$L54","$L55","$L56","$L57"]}]
