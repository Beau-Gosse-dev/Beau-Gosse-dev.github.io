1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",178," · ","August 30, 1862"," · ","The Second Manassas battlefield around Groveton, the unfinished railroad, Brawner Farm, Dogan Ridge, Chinn Ridge, and the Warrenton Turnpike in Prince William County, Virginia"]}],["$","h1",null,{"children":"SECOND MANASSAS (Part the Third)"}],["$","span",null,{"className":"result-label","children":"Confederate victory. Porter’s and Hatch’s afternoon assault briefly pressed Jackson’s line at the unfinished railroad but was repulsed. Longstreet then struck the exposed Federal left, destroyed Warren’s small brigade, and began the counterattack that drove Pope’s army from the field; this episode ends before the fighting on Chinn Ridge and Henry Hill is completed"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7742280499.mp3?updated=1695419393","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"McClellan’s response to Pope’s crisis and the first major actions of August 30"}],["$","small",null,{"children":"The episode follows events through the repulse of Porter and Hatch and the opening of Longstreet’s counterattack. The battle’s final phase is reserved for the next episode."}]]}],["$","div","McClellan and Franklin",{"children":[["$","span",null,{"children":"McClellan and Franklin"}],["$","strong",null,{"children":"Franklin’s VI Corps did not reach Pope before the battle"}],["$","small",null,{"children":"The episode describes Halleck’s repeated efforts to move Franklin from Alexandria. Franklin marched about 10 miles on August 29 and about 12 miles on August 30, reaching the vicinity of Centreville only after the battle was already in progress."}]]}],["$","div","McClellan’s August 29 telegram",{"children":[["$","span",null,{"children":"McClellan’s August 29 telegram"}],["$","strong",null,{"children":"One option was to “leave Pope to get out of his scrape”"}],["$","small",null,{"children":"The Library of Congress preserves McClellan’s telegram to Lincoln. McClellan offered either to concentrate available forces to open communication with Pope or to leave Pope and secure Washington, and asked for a prompt decision."}]]}],["$","div","Sumner’s II Corps",{"children":[["$","span",null,{"children":"Sumner’s II Corps"}],["$","strong",null,{"children":"Held near Washington until the afternoon of August 30"}],["$","small",null,{"children":"Sumner’s corps was the last Army of the Potomac formation to reach Alexandria from the Peninsula. It started toward Centreville on August 30 and arrived on August 31."}]]}],["$","div","Last Confederate arrivals",{"children":[["$","span",null,{"children":"Last Confederate arrivals"}],["$","strong",null,{"children":"Richard H. Anderson’s division reached the field at about 3 a.m."}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],"$L23","$undefined","$L24",false,"$L25","$L26","$L27","$L28","$L29"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","small",null,{"children":"The episode gives Anderson 6,100 infantry and Stephen D. Lee 18 guns after a 17-hour march. Anderson’s confused movement in the darkness helped reinforce Pope’s mistaken belief that Lee was withdrawing."}]
f:["$","div","Pope’s central error",{"children":[["$","span",null,{"children":"Pope’s central error"}],["$","strong",null,{"children":"He interpreted Confederate activity as a retreat"}],["$","small",null,{"children":"Federal probes met resistance on the morning of August 30, but Pope continued to treat the opposition as a rear guard and did not adequately account for Longstreet’s large force south of the turnpike."}]]}]
10:["$","div","Noon pursuit",{"children":[["$","span",null,{"children":"Noon pursuit"}],["$","strong",null,{"children":"Porter and Ricketts were ordered forward and stopped by artillery"}],["$","small",null,{"children":"After the short-lived movement showed that the Confederates had not left, Pope ordered a larger assault against Jackson rather than withdrawing behind Bull Run."}]]}]
11:["$","div","Federal assault force",{"children":[["$","span",null,{"children":"Federal assault force"}],["$","strong",null,{"children":"About 10,000 men under Porter and Hatch"}],["$","small",null,{"children":"Porter’s troops formed on the left, Hatch’s division on the right, and Sykes’s regulars in reserve. The episode places the main advance at 3 p.m."}]]}]
12:["$","div","Assault ground",{"children":[["$","span",null,{"children":"Assault ground"}],["$","strong",null,{"children":"Open fields, Schoolhouse Branch, and a steep rise to the railroad"}],["$","small",null,{"children":"The National Park Service describes 300 to 600 yards of exposed ground in front of Starke’s line, with the final 150 yards rising sharply. Butterfield’s men on the Federal left had the longest approach."}]]}]
13:["$","div","Confederate defenders",{"children":[["$","span",null,{"children":"Confederate defenders"}],["$","strong",null,{"children":"William E. Starke’s division behind the unfinished railroad"}],["$","small",null,{"children":"Bradley T. Johnson held the Deep Cut, Leroy A. Stafford held the sector known as the Dump, and the Stonewall Brigade supported Johnson’s right."}]]}]
14:["$","div","Confederate artillery advantage",{"children":[["$","span",null,{"children":"Confederate artillery advantage"}],["$","strong",null,{"children":"Stephen D. Lee’s 18 guns enfiladed the Federal assault"}],["$","small",null,{"children":"Lee’s battalion occupied high ground near Brawner Farm. Jackson’s guns joined the fire, and Longstreet added batteries rather than sending infantry directly to Jackson."}]]}]
15:["$","div","Federal foothold",{"children":[["$","span",null,{"children":"Federal foothold"}],["$","strong",null,{"children":"Hatch’s men reached the embankment near the Dump"}],["$","small",null,{"children":"Two New York regiments from Timothy Sullivan’s brigade fought Stafford’s Louisianians at close range while parts of Butterfield’s command pressed Johnson at the Deep Cut."}]]}]
16:["$","div","Stonewall Brigade counterattack",{"children":[["$","span",null,{"children":"Stonewall Brigade counterattack"}],["$","strong",null,{"children":"Fewer than 500 men helped close a gap in Jackson’s line"}],["$","small",null,{"children":"The brigade initially recoiled after its commander, Col. William S. H. Baylor, was killed. It rallied and helped restore the Confederate position."}]]}]
17:["$","div","Rock throwing",{"children":[["$","span",null,{"children":"Rock throwing"}],["$","strong",null,{"children":"Soldiers on both sides threw stones across the railroad grade"}],["$","small",null,{"children":"Some Confederate units exhausted their ammunition during the close fight. Federal soldiers returned stones thrown from behind the embankment."}]]}]
18:["$","div","Why the assault failed",{"children":[["$","span",null,{"children":"Why the assault failed"}],["$","strong",null,{"children":"Artillery crossfire, Confederate reinforcements, and no timely Federal reserve"}],["$","small",null,{"children":"Lawton and A. P. Hill shifted troops toward Starke. Porter did not commit Sykes’s division to renew the attack, and the exposed Federal formations withdrew under fire."}]]}]
19:["$","div","Reynolds moved north",{"children":[["$","span",null,{"children":"Reynolds moved north"}],["$","strong",null,{"children":"McDowell weakened the Federal left to support Porter’s withdrawal"}],["$","small",null,{"children":"Reynolds’s Pennsylvania Reserves left Chinn Ridge and crossed the turnpike. The move was unnecessary north of the road and left only McLean’s and Warren’s small brigades in Longstreet’s path."}]]}]
1a:["$","div","Exposed Federal flank",{"children":[["$","span",null,{"children":"Exposed Federal flank"}],["$","strong",null,{"children":"About 2,200 Federals faced Longstreet’s five divisions"}],["$","small",null,{"children":"The episode earlier estimates 8,000 Federals south of the turnpike against 25,000 Confederates. After Reynolds moved, the immediate Federal covering force was much smaller."}]]}]
1b:["$","div","Longstreet’s objective",{"children":[["$","span",null,{"children":"Longstreet’s objective"}],["$","strong",null,{"children":"Henry Hill and the Federal retreat routes across Bull Run"}],["$","small",null,{"children":"Longstreet’s front extended about a mile and a half from Brawner Farm to beyond the Manassas Gap Railroad. His divisions had between roughly one and a half and two miles to cover."}]]}]
1c:["$","div","Counterattack formation",{"children":[["$","span",null,{"children":"Counterattack formation"}],["$","strong",null,{"children":"Hood led; Kemper advanced on his right; Anderson supported"}],["$","small",null,{"children":"David R. Jones’s division had the longest and most obstructed route on the Confederate right. Wilcox maintained the connection between Longstreet and Jackson."}]]}]
1d:["$","div","Opening of Longstreet’s attack",{"children":[["$","span",null,{"children":"Opening of Longstreet’s attack"}],["$","strong",null,{"children":"Hood advanced shortly after 4 p.m."}],["$","small",null,{"children":"The Texas Brigade spearheaded the attack astride the Warrenton Turnpike and struck Warren’s two New York regiments before the Federal command understood the scale of the Confederate movement."}]]}]
1e:["$","div","Warren’s brigade",{"children":[["$","span",null,{"children":"Warren’s brigade"}],["$","strong",null,{"children":"The 5th and 10th New York were broken in minutes"}],["$","small",null,{"children":"Warren had moved south of the turnpike on his own initiative and joined Charles E. Hazlett’s battery. Hazlett withdrew his guns, but Warren’s exposed infantry suffered catastrophic losses."}]]}]
1f:["$","div","5th New York losses",{"children":[["$","span",null,{"children":"5th New York losses"}],["$","strong",null,{"children":"117 killed or mortally wounded from 490 engaged"}],["$","small",null,{"children":"The New York State Military Museum gives this regimental total. The National Park Service calls it the greatest number killed in ten minutes by any regiment during the Civil War."}]]}]
20:["$","div","Episode endpoint",{"children":[["$","span",null,{"children":"Episode endpoint"}],["$","strong",null,{"children":"The Texas Brigade surged toward Chinn Ridge"}],["$","small",null,{"children":"Hood’s troops overran Mark Kern’s Pennsylvania battery and shattered stragglers from Reynolds’s movement. The episode closes before the improvised Federal defense on Chinn Ridge."}]]}]
21:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Summer Lightning: A Guide to the Second Battle of Manassas” by Matt Spruill III and Matt Spruill IV"}],["$","small",null,{"children":"The episode recommends the guide for its official-report excerpts, battle narrative, tactical maps, and 20-stop battlefield tour."}]]}]
22:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Brawner, Groveton, Dogan Ridge, Chinn Ridge, Warrenton Turnpike, Starke, Hazlett, and Spruill"}],["$","small",null,{"children":"The automated transcript produces forms including “Bronner,” “Groughton,” “Dogen,” “Chen,” “Warrington,” “Stark,” “Haslett,” and “Sproul.” “Urban McDowell” refers to Irvin McDowell, and “Red Bridge’s Zouops” refers to the red-breeched Zouaves of the 5th New York."}]]}]
23:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
24:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The armies before the 3 p.m. assault",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep178-august-30-positions.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The armies before the 3 p.m. assault at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep178-august-30-positions.svg","alt":"Schematic north-up map of Second Manassas before the 3 p.m. Federal assault, with Jackson at the unfinished railroad, Longstreet south of the turnpike, and Pope’s forces to the east.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The armies before the 3 p.m. assault"}],["$","span",null,{"children":"Jackson’s wing held the unfinished railroad north of the Warrenton Turnpike while Longstreet’s five divisions waited to the south and west. Porter and Hatch formed east of the railroad, Sigel remained on Dogan Ridge, and Reynolds guarded Chinn Ridge. Roads, waterways, formations, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep178-august-30-positions.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Robert Knox Sneden map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Porter’s assault and Longstreet’s opening blow",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep178-deep-cut-and-counterattack.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Porter’s assault and Longstreet’s opening blow at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep178-deep-cut-and-counterattack.svg","alt":"Schematic map of Porter and Hatch attacking the unfinished railroad and Hood opening Longstreet’s counterattack against Warren on August 30, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Porter’s assault and Longstreet’s opening blow"}],["$","span",null,{"children":"Porter and Hatch advanced across the Dogan farm against Starke at the Deep Cut and the Dump while Confederate artillery struck their flank. After the repulse, Reynolds moved north and Hood attacked Warren south of the turnpike shortly after 4 p.m. Arrows show generalized relationships, not exact routes, timing, frontages, or troop geometry. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep178-deep-cut-and-counterattack.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service Civil War Series, U.S. Army Center of Military History, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2a"]}]]}],"$undefined"]}]]}],"$L2b"]}]]}]
25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #235d9f","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of Virginia and attached Army of the Potomac formations-Maj. Gen. John Pope",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia and attached Army of the Potomac formations"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"Concluded that Lee was withdrawing, ordered the noon pursuit, and then ordered the assault against Jackson’s right"}]]}],["$","div","Federal left wing-Maj. Gen. Irvin McDowell",{"className":"command-entry","children":[["$","strong",null,{"children":"Federal left wing"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Directed Hatch’s division and Reynolds’s Pennsylvania Reserves; shifted Reynolds north as Porter withdrew"}]]}],["$","div","V Corps, Army of the Potomac-Maj. Gen. Fitz John Porter",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps, Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"Commanded the main assault against the unfinished railroad with Butterfield’s formation on the left and Sykes’s regulars in reserve"}]]}],["$","div","1st Division, III Corps, Army of Virginia-Brig. Gen. John P. Hatch",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, III Corps, Army of Virginia"}],["$","span",null,{"children":"Brig. Gen. John P. Hatch"}],["$","small",null,{"children":"Advanced on Porter’s right; elements of Timothy Sullivan’s brigade reached the railroad near the Dump"}]]}],["$","div","Morell’s division in the August 30 assault-Brig. Gen. Daniel Butterfield",{"className":"command-entry","children":[["$","strong",null,{"children":"Morell’s division in the August 30 assault"}],["$","span",null,{"children":"Brig. Gen. Daniel Butterfield"}],["$","small",null,{"children":"Led the Federal left across the longest stretch of exposed ground toward the Deep Cut"}]]}],["$","div","2nd Division, V Corps-Brig. Gen. George W. Sykes",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, V Corps"}],["$","span",null,{"children":"Brig. Gen. George W. Sykes"}],["$","small",null,{"children":"Regular infantry held in reserve behind Porter’s attacking formations"}]]}],["$","div","Pennsylvania Reserves-Brig. Gen. John F. Reynolds",{"className":"command-entry","children":[["$","strong",null,{"children":"Pennsylvania Reserves"}],["$","span",null,{"children":"Brig. Gen. John F. Reynolds"}],["$","small",null,{"children":"Warned of Longstreet’s strength south of the turnpike, then was ordered north from Chinn Ridge"}]]}],["$","div","3rd Brigade, Sykes’s division-Col. Gouverneur K. Warren",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Brigade, Sykes’s division"}],["$","span",null,{"children":"Col. Gouverneur K. Warren"}],["$","small",null,{"children":"5th and 10th New York; moved south of the turnpike and met the opening of Hood’s assault"}]]}]]]}],"$L2c"]}],"$L2d"]]]}]
