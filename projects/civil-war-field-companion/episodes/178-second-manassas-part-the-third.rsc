27:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. William S. H. Baylor",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. William S. H. Baylor"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Stonewall Brigade","."]}]," ","Killed while leading the depleted Stonewall Brigade into the threatened Deep Cut sector. The National Park Service account states that he died with the 33rd Virginia’s flag wrapped around his body."]}]]}],["$","article","Col. Henry S. Roberts",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. Henry S. Roberts"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 1st Michigan Infantry","."]}]," ","Killed during Porter’s assault. The 1st Michigan belonged to Charles W. Roberts’s brigade in the center of the Federal formation advancing toward the unfinished railroad."]}]]}]]}]]}]
