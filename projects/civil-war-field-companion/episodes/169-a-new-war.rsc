32:["$","div","The earlier Federal winning streak recedes",{"className":"moment","children":[["$","$L31",null,{"seconds":321,"label":"5:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The earlier Federal winning streak recedes"}],["$","p",null,{"children":"United States victories from February through June no longer sustained expectations of a rapid restoration of the prewar Union."}]]}]]}]
33:["$","div","A harsher Federal war becomes more likely",{"className":"moment","children":[["$","$L31",null,{"seconds":347,"label":"5:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"A harsher Federal war becomes more likely"}],["$","p",null,{"children":"The defeat of the Army of the Potomac strengthened the case for measures that attacked slavery and the Confederate social and economic system."}]]}]]}]
34:["$","div","Confederate morale improves",{"className":"moment","children":[["$","$L31",null,{"seconds":367,"label":"6:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate morale improves"}],["$","p",null,{"children":"The defense of Richmond increased confidence in the survival of the slaveholding Confederacy."}]]}]]}]
35:["$","div","The East’s political weight is explained",{"className":"moment","children":[["$","$L31",null,{"seconds":387,"label":"6:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The East’s political weight is explained"}],["$","p",null,{"children":"Large population centers, major newspapers, celebrated armies, and both capitals made eastern campaigns especially influential."}]]}]]}]
36:["$","div","The northern political effect begins",{"className":"moment","children":[["$","$L31",null,{"seconds":473,"label":"7:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"The northern political effect begins"}],["$","p",null,{"children":"The episode moves from military perception to Republican legislation and division over emancipation and reunion."}]]}]]}]
37:["$","div","The Republican economic program advances",{"className":"moment","children":[["$","$L31",null,{"seconds":494,"label":"8:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Republican economic program advances"}],["$","p",null,{"children":"The Homestead Act is followed by land-grant college, transcontinental railroad, and internal revenue legislation."}]]}]]}]
38:["$","div","Emancipation divides northern politics",{"className":"moment","children":[["$","$L31",null,{"seconds":532,"label":"8:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Emancipation divides northern politics"}],["$","p",null,{"children":"Most Democrats support restoring the Union but reject destroying slavery, while abolitionists and many Republicans press for broader action."}]]}]]}]
39:["$","div","Congress’s antislavery measures are listed",{"className":"moment","children":[["$","$L31",null,{"seconds":573,"label":"9:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Congress’s antislavery measures are listed"}],["$","p",null,{"children":"The episode identifies the ban on military return of fugitives and the abolition of slavery in the District of Columbia and federal territories."}]]}]]}]
3a:["$","div","Richmond is the variable in the war-aims debate",{"className":"moment","children":[["$","$L31",null,{"seconds":619,"label":"10:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richmond is the variable in the war-aims debate"}],["$","p",null,{"children":"A successful campaign might have ended the rebellion before emancipation became a condition and instrument of Federal victory."}]]}]]}]
3b:["$","div","Lee’s victory changes the military and political setting",{"className":"moment","children":[["$","$L31",null,{"seconds":654,"label":"10:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s victory changes the military and political setting"}],["$","p",null,{"children":"The continuation of the war weakens conciliation and increases pressure for action against slavery and rebel property."}]]}]]}]
3c:["$","div","Confiscation and emancipation follow",{"className":"moment","children":[["$","$L31",null,{"seconds":691,"label":"11:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confiscation and emancipation follow"}],["$","p",null,{"children":"The Second Confiscation Act becomes law in July, and Lincoln later issues the preliminary Emancipation Proclamation in September."}]]}]]}]
3d:["$","div","Northern expectations before the campaign are reviewed",{"className":"moment","children":[["$","$L31",null,{"seconds":783,"label":"13:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Northern expectations before the campaign are reviewed"}],["$","p",null,{"children":"Early-1862 victories encouraged confident predictions that McClellan could destroy the Confederate field army and government."}]]}]]}]
3e:["$","div","Confederate public anxiety is contrasted",{"className":"moment","children":[["$","$L31",null,{"seconds":825,"label":"13:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate public anxiety is contrasted"}],["$","p",null,{"children":"Defeats, territorial losses, shortages, and government demands created a strong need for battlefield success."}]]}]]}]
3f:["$","div","The Confederate draft is examined",{"className":"moment","children":[["$","$L31",null,{"seconds":860,"label":"14:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate draft is examined"}],["$","p",null,{"children":"The April 16 Conscription Act kept soldiers in service but angered states’ rights advocates and men expecting discharge."}]]}]]}]
40:["$","div","Confederates seek an aggressive commander",{"className":"moment","children":[["$","$L31",null,{"seconds":935,"label":"15:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates seek an aggressive commander"}],["$","p",null,{"children":"The episode connects civilian morale to a preference for offensive victories and generals who seized the initiative."}]]}]]}]
41:["$","div","Four leading Confederate generals are compared",{"className":"moment","children":[["$","$L31",null,{"seconds":954,"label":"15:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Four leading Confederate generals are compared"}],["$","p",null,{"children":"Beauregard, Joseph E. Johnston, Albert Sidney Johnston, and Lee had entered the war as prominent commanders, but death, wounds, and political conflict narrowed the field."}]]}]]}]
42:["$","div","Lee takes command with a damaged reputation",{"className":"moment","children":[["$","$L31",null,{"seconds":989,"label":"16:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee takes command with a damaged reputation"}],["$","p",null,{"children":"Lee replaces the wounded Joseph E. Johnston after Seven Pines despite doubts created by western Virginia and coastal service."}]]}]]}]
43:["$","div","Jackson and Lee enter the Richmond comparison",{"className":"moment","children":[["$","$L31",null,{"seconds":1027,"label":"17:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson and Lee enter the Richmond comparison"}],["$","p",null,{"children":"Jackson’s Valley victories made him the leading Confederate military idol before Lee directed the defense of Richmond."}]]}]]}]
44:["$","div","The Seven Days reverses expectations",{"className":"moment","children":[["$","$L31",null,{"seconds":1100,"label":"18:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Seven Days reverses expectations"}],["$","p",null,{"children":"The episode returns to the post-campaign armies, politics, and morale after establishing the conditions that existed before the fighting."}]]}]]}]
45:["$","div","McClellan’s reputation suffers inside the army",{"className":"moment","children":[["$","$L31",null,{"seconds":1107,"label":"18:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan’s reputation suffers inside the army"}],["$","p",null,{"children":"Some officers and soldiers believed he had retreated unnecessarily and lost an opportunity to capture Richmond."}]]}]]}]
46:["$","div","Many soldiers remain loyal to McClellan",{"className":"moment","children":[["$","$L31",null,{"seconds":1124,"label":"18:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Many soldiers remain loyal to McClellan"}],["$","p",null,{"children":"A larger group blamed the administration for failing to provide the men and material they believed their commander required."}]]}]]}]
47:["$","div","Army-administration distrust deepens",{"className":"moment","children":[["$","$L31",null,{"seconds":1143,"label":"19:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Army-administration distrust deepens"}],["$","p",null,{"children":"The failure sharpened conflict between Democratic officers associated with McClellan and Republicans in Washington."}]]}]]}]
48:["$","div","Zachariah Chandler attacks McClellan",{"className":"moment","children":[["$","$L31",null,{"seconds":1155,"label":"19:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Zachariah Chandler attacks McClellan"}],["$","p",null,{"children":"The radical Republican senator uses the Joint Committee on the Conduct of the War and Senate debate to challenge the general."}]]}]]}]
49:["$","div","Chase and Stanton press for change",{"className":"moment","children":[["$","$L31",null,{"seconds":1176,"label":"19:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Chase and Stanton press for change"}],["$","p",null,{"children":"The treasury and war secretaries condemn McClellan’s conduct, reinforcement demands, and political opposition to administration policy."}]]}]]}]
4a:["$","div","Lincoln’s Harrison’s Landing visit is recalled",{"className":"moment","children":[["$","$L31",null,{"seconds":1213,"label":"20:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln’s Harrison’s Landing visit is recalled"}],["$","p",null,{"children":"The July 8–9 visit and McClellan’s July 7 policy letter place the field commander’s limited-war program directly before the president."}]]}]]}]
4b:["$","div","Lincoln rejects continued conciliation",{"className":"moment","children":[["$","$L31",null,{"seconds":1272,"label":"21:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln rejects continued conciliation"}],["$","p",null,{"children":"The administration moves closer to Republicans who demand confiscation and emancipation as means of suppressing the rebellion."}]]}]]}]
4c:["$","div","The Second Confiscation Act is tied to Richmond",{"className":"moment","children":[["$","$L31",null,{"seconds":1294,"label":"21:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Second Confiscation Act is tied to Richmond"}],["$","p",null,{"children":"The episode uses Charles Sumner’s July 17 statement to connect the measure’s passage with the military reverse before Richmond."}]]}]]}]
4d:["$","div","Northern civilians absorb the failure",{"className":"moment","children":[["$","$L31",null,{"seconds":1328,"label":"22:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Northern civilians absorb the failure"}],["$","p",null,{"children":"Few treat the campaign as proof of Confederate independence, but high expectations make the defeat especially damaging."}]]}]]}]
4e:["$","div","Partisan newspapers assign blame differently",{"className":"moment","children":[["$","$L31",null,{"seconds":1352,"label":"22:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Partisan newspapers assign blame differently"}],["$","p",null,{"children":"Democratic papers emphasize the administration’s failure to reinforce McClellan rather than faulting the general."}]]}]]}]
4f:["$","div","European reaction enters the analysis",{"className":"moment","children":[["$","$L31",null,{"seconds":1371,"label":"22:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"European reaction enters the analysis"}],["$","p",null,{"children":"The campaign’s outcome carried unusual weight in Britain and France and strengthened discussion of Confederate recognition in Britain."}]]}]]}]
50:["$","div","Lincoln describes the moral effect abroad",{"className":"moment","children":[["$","$L31",null,{"seconds":1393,"label":"23:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln describes the moral effect abroad"}],["$","p",null,{"children":"His August 4 letter contrasts the limited benefit of United States victories elsewhere with the damage caused by the reverse at Richmond."}]]}]]}]
51:["$","div","Lee’s debut becomes a Confederate turning point",{"className":"moment","children":[["$","$L31",null,{"seconds":1433,"label":"23:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s debut becomes a Confederate turning point"}],["$","p",null,{"children":"The episode describes an eleven-month process in which Lee shaped the Army of Northern Virginia into the Confederacy’s central military institution."}]]}]]}]
52:["$","div","Lee becomes the principal Confederate military idol",{"className":"moment","children":[["$","$L31",null,{"seconds":1489,"label":"24:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee becomes the principal Confederate military idol"}],["$","p",null,{"children":"His army’s battlefield success assumes a growing role in sustaining civilian morale."}]]}]]}]
53:["$","div","The Richmond Dispatch reverses its judgment",{"className":"moment","children":[["$","$L31",null,{"seconds":1541,"label":"25:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Richmond Dispatch reverses its judgment"}],["$","p",null,{"children":"A newspaper that had doubted Lee reports on July 9 that his rise in public confidence was without precedent."}]]}]]}]
54:["$","div","Lee calls the victory incomplete",{"className":"moment","children":[["$","$L31",null,{"seconds":1559,"label":"25:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee calls the victory incomplete"}],["$","p",null,{"children":"His private and official assessments emphasize that the Army of the Potomac escaped destruction."}]]}]]}]
55:["$","div","Lee’s own errors are acknowledged",{"className":"moment","children":[["$","$L31",null,{"seconds":1610,"label":"26:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s own errors are acknowledged"}],["$","p",null,{"children":"The episode separates Lee’s mistakes in planning and command from his frustration with subordinates who failed to carry out orders."}]]}]]}]
56:["$","div","Command defects drive reorganization",{"className":"moment","children":[["$","$L31",null,{"seconds":1630,"label":"27:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Command defects drive reorganization"}],["$","p",null,{"children":"Lee responds to the difficulty of directing eight or nine division commanders and to an army that had assembled only shortly before the Seven Days."}]]}]]}]
57:["$","div","Three senior commanders leave the army",{"className":"moment","children":[["$","$L31",null,{"seconds":1666,"label":"27:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Three senior commanders leave the army"}],["$","p",null,{"children":"Magruder, Holmes, and Huger are removed from their former field roles within days of the campaign."}]]}]]}]
58:["$","div","Longstreet and Jackson receive the two wings",{"className":"moment","children":[["$","$L31",null,{"seconds":1725,"label":"28:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet and Jackson receive the two wings"}],["$","p",null,{"children":"Lee expands Longstreet’s command and reduces Jackson’s, creating a more manageable senior command structure that later received formal corps status."}]]}]]}]
59:["$","div","The Confederate command for the next campaign is identified",{"className":"moment","children":[["$","$L31",null,{"seconds":1776,"label":"29:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate command for the next campaign is identified"}],["$","p",null,{"children":"Lee, Longstreet, and Jackson form the senior field-command structure that will operate against Pope."}]]}]]}]
5a:["$","div","Halleck becomes general-in-chief",{"className":"moment","children":[["$","$L31",null,{"seconds":1788,"label":"29:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck becomes general-in-chief"}],["$","p",null,{"children":"Lincoln’s July appointment places Halleck over both McClellan and Pope and repudiates McClellan’s effort to shape national war policy."}]]}]]}]
5b:["$","div","The Army of the Potomac can be transferred by units",{"className":"moment","children":[["$","$L31",null,{"seconds":1808,"label":"30:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Potomac can be transferred by units"}],["$","p",null,{"children":"Removing the army from the Peninsula gives Lincoln and Halleck a means to strengthen Pope without immediately dismissing McClellan."}]]}]]}]
5c:["$","div","The Army of Virginia’s origin is explained",{"className":"moment","children":[["$","$L31",null,{"seconds":1827,"label":"30:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of Virginia’s origin is explained"}],["$","p",null,{"children":"Lincoln had already decided to consolidate the separate Federal commands in northern Virginia under one army commander."}]]}]]}]
5d:["$","div","Pope’s western record is summarized",{"className":"moment","children":[["$","$L31",null,{"seconds":1849,"label":"30:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope’s western record is summarized"}],["$","p",null,{"children":"His capture of Island No. 10 and service in Halleck’s advance on Corinth contributed to his selection for eastern command."}]]}]]}]
5e:["$","div","Pope assumes command during Gaines’s Mill",{"className":"moment","children":[["$","$L31",null,{"seconds":1867,"label":"31:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope assumes command during Gaines’s Mill"}],["$","p",null,{"children":"The episode places his arrival on June 27 as the battle outside Richmond was being fought."}]]}]]}]
5f:["$","div","The three corps are named",{"className":"moment","children":[["$","$L31",null,{"seconds":1875,"label":"31:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The three corps are named"}],["$","p",null,{"children":"Irvin McDowell, Nathaniel P. Banks, and Franz Sigel command the principal parts of Pope’s new army."}]]}]]}]
60:["$","div","Pope’s strength is estimated",{"className":"moment","children":[["$","$L31",null,{"seconds":1902,"label":"31:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope’s strength is estimated"}],["$","p",null,{"children":"The episode gives the Army of Virginia about 51,000 soldiers and explains that Peninsula transfers could add to it."}]]}]]}]
61:["$","div","The opposing senior commands are set",{"className":"moment","children":[["$","$L31",null,{"seconds":1934,"label":"32:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The opposing senior commands are set"}],["$","p",null,{"children":"The episode closes its analysis with Lee, Longstreet, and Jackson opposed by Lincoln, Halleck, Pope, and McClellan."}]]}]]}]
