1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",169," · ","March 20–August 26, 1862"," · ","The Virginia Peninsula, Richmond, northern Virginia, Washington, D.C., and the national political and diplomatic arenas shaped by the Peninsula Campaign"]}],["$","h1",null,{"children":"A NEW WAR"}],["$","span",null,{"className":"result-label","children":"Confederate forces protected Richmond and ended the Army of the Potomac’s Peninsula offensive. The result damaged George B. McClellan’s standing with the Lincoln administration, strengthened Robert E. Lee’s authority and Confederate morale, accelerated the shift from conciliation toward emancipation and a harder Federal war policy, and placed John Pope’s Army of Virginia at the center of the next campaign in the East"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3027983816.mp3?updated=1695385191","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The military, political, social, and diplomatic consequences of the Peninsula Campaign and Seven Days Battles"}],["$","small",null,{"children":"The episode closes the Peninsula sequence and establishes the command structure for the Northern Virginia Campaign."}]]}],["$","div","Campaign span used in the episode",{"children":[["$","span",null,{"children":"Campaign span used in the episode"}],["$","strong",null,{"children":"March 20–August 26, 1862: 160 days"}],["$","small",null,{"children":"The count begins with the arrival of the first Army of the Potomac elements at Fort Monroe and ends with the final evacuation from the Peninsula. Standard campaign summaries often use March–July because the major fighting ended at Malvern Hill."}]]}],["$","div","Strategic result",{"children":[["$","span",null,{"children":"Strategic result"}],["$","strong",null,{"children":"Confederate victory; Richmond remained in Confederate hands"}],["$","small",null,{"children":"McClellan reached the outskirts of Richmond but withdrew to the James River during the Seven Days and later evacuated the Peninsula."}]]}],["$","div","Participation estimate",{"children":[["$","span",null,{"children":"Participation estimate"}],["$","strong",null,{"children":"About 250,000 soldiers and sailors in the episode’s account"}],["$","small",null,{"children":"The episode describes this as the largest number involved in any single Civil War campaign. The total covers service on land and water across the full campaign, not one battlefield."}]]}],["$","div","Campaign casualties in the episode",{"children":[["$","span",null,{"children":"Campaign casualties in the episode"}],["$","strong",null,{"children":"25,370 United States and 30,450 Confederate"}],["$","small",null,{"children":"These figures total 55,820 killed, wounded, or missing in battles and skirmishes from Yorktown to Malvern Hill. Published campaign totals vary by scope and method, so these are retained as the episode’s compiled estimates."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}],"$L28","$undefined","$L29",false,"$L2a","$L2b","$L2c","$L2d","$L2e"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Battle deaths in the episode",{"children":[["$","span",null,{"children":"Battle deaths in the episode"}],["$","strong",null,{"children":"At least 8,670"}],["$","small",null,{"children":"The episode adds an estimated 5,000 deaths from disease and cautions that incomplete sickness records and unresolved missing cases make the resulting death estimate conservative."}]]}]
f:["$","div","Total death estimate",{"children":[["$","span",null,{"children":"Total death estimate"}],["$","strong",null,{"children":"Approximately 13,670 from battle and disease"}],["$","small",null,{"children":"This is the episode’s minimum estimate for the full campaign, not a modern definitive count."}]]}]
10:["$","div","Combined loss share",{"children":[["$","span",null,{"children":"Combined loss share"}],["$","strong",null,{"children":"More than 24 percent of participants"}],["$","small",null,{"children":"Using the episode’s figures, almost one in four participants was wounded, missing, killed in battle, or estimated to have died from disease."}]]}]
11:["$","div","McClellan’s original political premise",{"children":[["$","span",null,{"children":"McClellan’s original political premise"}],["$","strong",null,{"children":"A decisive campaign could restore the Union through limited war"}],["$","small",null,{"children":"The episode uses Stephen W. Sears’s interpretation that McClellan expected victory near Richmond to end the rebellion before the conflict became a social revolution centered on slavery."}]]}]
12:["$","div","Effect on Federal war aims",{"children":[["$","span",null,{"children":"Effect on Federal war aims"}],["$","strong",null,{"children":"The failure of conciliation strengthened support for emancipation as a military measure"}],["$","small",null,{"children":"The campaign did not alone cause emancipation, but it altered the military and political setting in which Congress and Lincoln acted during July 1862."}]]}]
13:["$","div","Second Confiscation Act",{"children":[["$","span",null,{"children":"Second Confiscation Act"}],["$","strong",null,{"children":"Signed July 17, 1862"}],["$","small",null,{"children":"The act expanded confiscation against participants in rebellion and declared free specified enslaved people held by rebels. Its provisions were narrower and more procedurally limited than the later Emancipation Proclamation."}]]}]
14:["$","div","Emancipation draft before the cabinet",{"children":[["$","span",null,{"children":"Emancipation draft before the cabinet"}],["$","strong",null,{"children":"July 22, 1862"}],["$","small",null,{"children":"Lincoln presented his preliminary draft as a military measure, then delayed public issuance until after a favorable military event. The preliminary proclamation was issued on September 22 after Antietam."}]]}]
15:["$","div","Other 1862 antislavery legislation",{"children":[["$","span",null,{"children":"Other 1862 antislavery legislation"}],["$","strong",null,{"children":"Army return of fugitives prohibited March 13; slavery abolished in the District of Columbia April 16 and in the federal territories June 19"}],["$","small",null,{"children":"The episode places these measures within the widening Republican effort against slavery before the Peninsula Campaign ended."}]]}]
16:["$","div","Republican economic program",{"children":[["$","span",null,{"children":"Republican economic program"}],["$","strong",null,{"children":"Homestead, land-grant college, Pacific railroad, and internal revenue legislation"}],["$","small",null,{"children":"The Homestead Act became law May 20. The Internal Revenue Act and Pacific Railway Act became law July 1, and the Morrill Land-Grant College Act became law July 2."}]]}]
17:["$","div","Northern political division",{"children":[["$","span",null,{"children":"Northern political division"}],["$","strong",null,{"children":"Democrats generally supported reunion but opposed emancipation as a war aim"}],["$","small",null,{"children":"The episode contrasts Democratic support for McClellan’s limited-war position with Republican and abolitionist demands for broader action against slavery and rebel property."}]]}]
18:["$","div","Eastern Theater influence",{"children":[["$","span",null,{"children":"Eastern Theater influence"}],["$","strong",null,{"children":"Events near Washington and Richmond carried disproportionate public and diplomatic weight"}],["$","small",null,{"children":"Population, high-circulation newspapers, prominent armies, and the proximity of both capitals focused attention on the East even as United States forces won large territorial gains elsewhere."}]]}]
19:["$","div","Foreign-policy consequence",{"children":[["$","span",null,{"children":"Foreign-policy consequence"}],["$","strong",null,{"children":"The failure before Richmond increased British debate about Confederate recognition"}],["$","small",null,{"children":"The episode does not state that recognition was granted. It describes the campaign as damaging the United States position in European public and political discussion."}]]}]
1a:["$","div","Lincoln’s “half-defeat” letter",{"children":[["$","span",null,{"children":"Lincoln’s “half-defeat” letter"}],["$","strong",null,{"children":"Written to Agénor-Étienne de Gasparin on August 4, 1862"}],["$","small",null,{"children":"Lincoln contrasted the weak political benefit of months of United States victories and large territorial gains with the heavy damage caused by the reverse before Richmond."}]]}]
1b:["$","div","Confederate Conscription Act",{"children":[["$","span",null,{"children":"Confederate Conscription Act"}],["$","strong",null,{"children":"Approved April 16, 1862"}],["$","small",null,{"children":"The first comprehensive national draft in American history helped maintain Confederate armies but provoked opposition from states’ rights advocates and men approaching the end of twelve-month enlistments."}]]}]
1c:["$","div","Confederate morale before the Seven Days",{"children":[["$","span",null,{"children":"Confederate morale before the Seven Days"}],["$","strong",null,{"children":"Military reverses, territorial losses, shortages, and conscription produced deep anxiety"}],["$","small",null,{"children":"The episode stresses the demand for an aggressive commander and offensive victories rather than treating the battlefield outcome in isolation."}]]}]
1d:["$","div","Confederate command before Lee",{"children":[["$","span",null,{"children":"Confederate command before Lee"}],["$","strong",null,{"children":"Albert Sidney Johnston was dead, P. G. T. Beauregard had lost Jefferson Davis’s confidence, and Joseph E. Johnston was severely wounded"}],["$","small",null,{"children":"Stonewall Jackson’s Valley victories made him the Confederacy’s leading military celebrity before Lee’s Seven Days offensive transformed Lee’s reputation."}]]}]
1e:["$","div","Lee’s public standing",{"children":[["$","span",null,{"children":"Lee’s public standing"}],["$","strong",null,{"children":"The Seven Days made him the principal military figure of the Confederacy"}],["$","small",null,{"children":"The episode uses the Richmond Dispatch’s rapid reversal as evidence that aggressive action and the defense of Richmond changed public judgments of Lee."}]]}]
1f:["$","div","Lee’s assessment",{"children":[["$","span",null,{"children":"Lee’s assessment"}],["$","strong",null,{"children":"Success was incomplete because the Army of the Potomac escaped"}],["$","small",null,{"children":"In his correspondence and official report, Lee expressed disappointment that the Federal army had not been destroyed. The episode also assigns Lee responsibility for important planning and command errors."}]]}]
20:["$","div","Confederate command removals",{"children":[["$","span",null,{"children":"Confederate command removals"}],["$","strong",null,{"children":"John B. Magruder, Theophilus H. Holmes, and Benjamin Huger left field command"}],["$","small",null,{"children":"Magruder and Holmes went to the Western Theater. Huger became inspector of artillery and ordnance. The episode presents these changes as Lee’s response to command failures revealed during the Seven Days."}]]}]
21:["$","div","Army of Northern Virginia reorganization",{"children":[["$","span",null,{"children":"Army of Northern Virginia reorganization"}],["$","strong",null,{"children":"Two large wings under James Longstreet and Stonewall Jackson"}],["$","small",null,{"children":"They functioned as corps before Confederate law formally authorized the corps structure. The episode states that Longstreet’s enlarged command contained 28 brigades and Jackson’s reduced command seven."}]]}]
22:["$","div","Army of Virginia created",{"children":[["$","span",null,{"children":"Army of Virginia created"}],["$","strong",null,{"children":"June 26, 1862, under Maj. Gen. John Pope"}],["$","small",null,{"children":"The new army combined the previously separate northern Virginia commands. Pope took up the assignment while the Seven Days fighting was beginning near Richmond."}]]}]
23:["$","div","Army of Virginia organization",{"children":[["$","span",null,{"children":"Army of Virginia organization"}],["$","strong",null,{"children":"Three corps under Franz Sigel, Nathaniel P. Banks, and Irvin McDowell"}],["$","small",null,{"children":"Sigel replaced John C. Frémont, who declined a corps command subordinate to Pope. The automated transcript mishears Irvin as “Urban” and spells Sigel as “Siegel.”"}]]}]
24:["$","div","Army of Virginia strength",{"children":[["$","span",null,{"children":"Army of Virginia strength"}],["$","strong",null,{"children":"About 51,000 in the episode’s account"}],["$","small",null,{"children":"The U.S. Army campaign summary gives about 45,000 when the scattered commands were consolidated. Strength varies with date and which detached forces are counted."}]]}]
25:["$","div","New United States command structure",{"children":[["$","span",null,{"children":"New United States command structure"}],["$","strong",null,{"children":"Lincoln, General-in-Chief Halleck, Pope in northern Virginia, and McClellan on the Peninsula"}],["$","small",null,{"children":"Halleck’s appointment on July 11 placed a military superior between the president and the two field-army commanders. The Army of the Potomac’s transfer allowed the administration to move units gradually toward Pope."}]]}]
26:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Struggle for a Vast Future: The American Civil War,” edited by Aaron Sheehan-Dean"}],["$","small",null,{"children":"The collection contains twelve essays on the war’s origins, conduct, home fronts, and legacy."}]]}]
27:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Gaines’s Mill, Agénor-Étienne de Gasparin, Zachariah Chandler, Glenn David Brasher, Benjamin Huger, Irvin McDowell, Franz Sigel, and Aaron Sheehan-Dean"}],["$","small",null,{"children":"The automated transcript produces forms including “Gance’s Mill,” “Zacharia,” “Glen,” “Ujet,” “Urban,” “Siegel,” and “Sheehan Dean.”"}]]}]
28:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
29:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The Peninsula Campaign: advance and withdrawal",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep169-peninsula-campaign.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The Peninsula Campaign: advance and withdrawal at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-peninsula-campaign.svg","alt":"Generalized schematic map of the 1862 Peninsula Campaign from Fort Monroe toward Richmond and back to Harrison’s Landing and Fort Monroe.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Peninsula Campaign: advance and withdrawal"}],["$","span",null,{"children":"The Army of the Potomac moved from Fort Monroe through Yorktown and Williamsburg to the outskirts of Richmond. Lee’s Seven Days offensive drove the Federal army to Harrison’s Landing; Halleck later ordered it evacuated by way of Fort Monroe. Shorelines, waterways, routes, locations, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep169-peninsula-campaign.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Library of Congress campaign maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Eastern Virginia after the Seven Days",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep169-strategic-realignment.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Eastern Virginia after the Seven Days at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-strategic-realignment.svg","alt":"Generalized schematic map showing Washington, Pope in northern Virginia, McClellan at Harrison’s Landing, Richmond, and the opposing army movements of summer 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Eastern Virginia after the Seven Days"}],["$","span",null,{"children":"Pope’s Army of Virginia concentrated in northern Virginia while McClellan remained at Harrison’s Landing. Halleck ordered the Army of the Potomac transferred through Fort Monroe toward Aquia and Alexandria. With Richmond secure, Lee sent Jackson toward Gordonsville and then moved against Pope. Waterways, routes, locations, positions, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep169-strategic-realignment.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","