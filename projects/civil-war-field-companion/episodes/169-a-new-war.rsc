2a:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States national and army command",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States national and army command"}],[["$","div","Commander in chief and head of the administration-President Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief and head of the administration"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Secretary of War Edwin M. Stanton; Secretary of the Treasury Salmon P. Chase; the cabinet that considered emancipation policy"}]]}],["$","div","General-in-chief of the United States Army from July 11, 1862-Maj. Gen. Henry W. Halleck",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief of the United States Army from July 11, 1862"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Strategic superior of George B. McClellan and John Pope; directed the transfer and concentration of Federal forces"}]]}],["$","div","Army of the Potomac-Maj. Gen. George B. 