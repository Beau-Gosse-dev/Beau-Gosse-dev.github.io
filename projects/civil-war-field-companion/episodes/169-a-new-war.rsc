1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",169," · ","March 20–August 26, 1862"," · ","The Virginia Peninsula, Richmond, northern Virginia, Washington, D.C., and the national political and diplomatic arenas shaped by the Peninsula Campaign"]}],["$","h1",null,{"children":"A NEW WAR"}],["$","span",null,{"className":"result-label","children":"Confederate forces protected Richmond and ended the Army of the Potomac’s Peninsula offensive. The result damaged George B. McClellan’s standing with the Lincoln administration, strengthened Robert E. Lee’s authority and Confederate morale, accelerated the shift from conciliation toward emancipation and a harder Federal war policy, and placed John Pope’s Army of Virginia at the center of the next campaign in the East"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3027983816.mp3?updated=1695385191","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The military, political, social, and diplomatic consequences of the Peninsula Campaign and Seven Days Battles"}],["$","small",null,{"children":"The episode closes the Peninsula sequence and establishes the command structure for the Northern Virginia Campaign."}]]}],["$","div","Campaign span used in the episode",{"children":[["$","span",null,{"children":"Campaign span used in the episode"}],["$","strong",null,{"children":"March 20–August 26, 1862: 160 days"}],["$","small",null,{"children":"The count begins with the arrival of the first Army of the Potomac elements at Fort Monroe and ends with the final evacuation from the Peninsula. Standard campaign summaries often use March–July because the major fighting ended at Malvern Hill."}]]}],["$","div","Strategic result",{"children":[["$","span",null,{"children":"Strategic result"}],["$","strong",null,{"children":"Confederate victory; Richmond remained in Confederate hands"}],["$","small",null,{"children":"McClellan reached the outskirts of Richmond but withdrew to the James River during the Seven Days and later evacuated the Peninsula."}]]}],["$","div","Participation estimate",{"children":[["$","span",null,{"children":"Participation estimate"}],["$","strong",null,{"children":"About 250,000 soldiers and sailors in the episode’s account"}],["$","small",null,{"children":"The episode describes this as the largest number involved in any single Civil War campaign. The total covers service on land and water across the full campaign, not one battlefield."}]]}],["$","div","Campaign casualties in the episode",{"children":[["$","span",null,{"children":"Campaign casualties in the episode"}],["$","strong",null,{"children":"25,370 United States and 30,450 Confederate"}],["$","small",null,{"children":"These figures total 55,820 killed, wounded, or missing in battles and skirmishes from Yorktown to Malvern Hill. Published campaign totals vary by scope and method, so these are retained as the episode’s compiled estimates."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}],"$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}]]}]
31:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Battle deaths in the episode",{"children":[["$","span",null,{"children":"Battle deaths in the episode"}],["$","strong",null,{"children":"At least 8,670"}],["$","small",null,{"children":"The episode adds an estimated 5,000 deaths from disease and cautions that incomplete sickness records and unresolved missing cases make the resulting death estimate conservative."}]]}]
f:["$","div","Total death estimate",{"children":[["$","span",null,{"children":"Total death estimate"}],["$","strong",null,{"children":"Approximately 13,670 from battle and disease"}],["$","small",null,{"children":"This is the episode’s minimum estimate for the full campaign, not a modern definitive count."}]]}]
10:["$","div","Combined loss share",{"children":[["$","span",null,{"children":"Combined loss share"}],["$","strong",null,{"children":"More than 24 percent of participants"}],["$","small",null,{"children":"Using the episode’s figures, almost one in four participants was wounded, missing, killed in battle, or estimated to have died from disease."}]]}]
11:["$","div","McClellan’s original political premise",{"children":[["$","span",null,{"children":"McClellan’s original political premise"}],["$","strong",null,{"children":"A decisive campaign could restore the Union through limited war"}],["$","small",null,{"children":"The episode uses Stephen W. Sears’s interpretation that McClellan expected victory near Richmond to end the rebellion before the conflict became a social revolution centered on slavery."}]]}]
12:["$","div","Effect on Federal war aims",{"children":[["$","span",null,{"children":"Effect on Federal war aims"}],["$","strong",null,{"children":"The failure of conciliation strengthened support for emancipation as a military measure"}],["$","small",null,{"children":"The campaign did not alone cause emancipation, but it altered the military and political setting in which Congress and Lincoln acted during July 1862."}]]}]
13:["$","div","Second Confiscation Act",{"children":[["$","span",null,{"children":"Second Confiscation Act"}],["$","strong",null,{"children":"Signed July 17, 1862"}],["$","small",null,{"children":"The act expanded confiscation against participants in rebellion and declared free specified enslaved people held by rebels. Its provisions were narrower and more procedurally limited than the later Emancipation Proclamation."}]]}]
14:["$","div","Emancipation draft before the cabinet",{"children":[["$","span",null,{"children":"Emancipation draft before the cabinet"}],["$","strong",null,{"children":"July 22, 1862"}],["$","small",null,{"children":"Lincoln presented his preliminary draft as a military measure, then delayed public issuance until after a favorable military event. The preliminary proclamation was issued on September 22 after Antietam."}]]}]
15:["$","div","Other 1862 antislavery legislation",{"children":[["$","span",null,{"children":"Other 1862 antislavery legislation"}],["$","strong",null,{"children":"Army return of fugitives prohibited March 13; slavery abolished in the District of Columbia April 16 and in the federal territories June 19"}],["$","small",null,{"children":"The episode places these measures within the widening Republican effort against slavery before the Peninsula Campaign ended."}]]}]
16:["$","div","Republican economic program",{"children":[["$","span",null,{"children":"Republican economic program"}],["$","strong",null,{"children":"Homestead, land-grant college, Pacific railroad, and internal revenue legislation"}],["$","small",null,{"children":"The Homestead Act became law May 20. The Internal Revenue Act and Pacific Railway Act became law July 1, and the Morrill Land-Grant College Act became law July 2."}]]}]
17:["$","div","Northern political division",{"children":[["$","span",null,{"children":"Northern political division"}],["$","strong",null,{"children":"Democrats generally supported reunion but opposed emancipation as a war aim"}],["$","small",null,{"children":"The episode contrasts Democratic support for McClellan’s limited-war position with Republican and abolitionist demands for broader action against slavery and rebel property."}]]}]
18:["$","div","Eastern Theater influence",{"children":[["$","span",null,{"children":"Eastern Theater influence"}],["$","strong",null,{"children":"Events near Washington and Richmond carried disproportionate public and diplomatic weight"}],["$","small",null,{"children":"Population, high-circulation newspapers, prominent armies, and the proximity of both capitals focused attention on the East even as United States forces won large territorial gains elsewhere."}]]}]
19:["$","div","Foreign-policy consequence",{"children":[["$","span",null,{"children":"Foreign-policy consequence"}],["$","strong",null,{"children":"The failure before Richmond increased British debate about Confederate recognition"}],["$","small",null,{"children":"The episode does not state that recognition was granted. It describes the campaign as damaging the United States position in European public and political discussion."}]]}]
1a:["$","div","Lincoln’s “half-defeat” letter",{"children":[["$","span",null,{"children":"Lincoln’s “half-defeat” letter"}],["$","strong",null,{"children":"Written to Agénor-Étienne de Gasparin on August 4, 1862"}],["$","small",null,{"children":"Lincoln contrasted the weak political benefit of months of United States victories and large territorial gains with the heavy damage caused by the reverse before Richmond."}]]}]
1b:["$","div","Confederate Conscription Act",{"children":[["$","span",null,{"children":"Confederate Conscription Act"}],["$","strong",null,{"children":"Approved April 16, 1862"}],["$","small",null,{"children":"The first comprehensive national draft in American history helped maintain Confederate armies but provoked opposition from states’ rights advocates and men approaching the end of twelve-month enlistments."}]]}]
1c:["$","div","Confederate morale before the Seven Days",{"children":[["$","span",null,{"children":"Confederate morale before the Seven Days"}],["$","strong",null,{"children":"Military reverses, territorial losses, shortages, and conscription produced deep anxiety"}],["$","small",null,{"children":"The episode stresses the demand for an aggressive commander and offensive victories rather than treating the battlefield outcome in isolation."}]]}]
1d:["$","div","Confederate command before Lee",{"children":[["$","span",null,{"children":"Confederate command before Lee"}],["$","strong",null,{"children":"Albert Sidney Johnston was dead, P. G. T. Beauregard had lost Jefferson Davis’s confidence, and Joseph E. Johnston was severely wounded"}],["$","small",null,{"children":"Stonewall Jackson’s Valley victories made him the Confederacy’s leading military celebrity before Lee’s Seven Days offensive transformed Lee’s reputation."}]]}]
1e:["$","div","Lee’s public standing",{"children":[["$","span",null,{"children":"Lee’s public standing"}],["$","strong",null,{"children":"The Seven Days made him the principal military figure of the Confederacy"}],["$","small",null,{"children":"The episode uses the Richmond Dispatch’s rapid reversal as evidence that aggressive action and the defense of Richmond changed public judgments of Lee."}]]}]
1f:["$","div","Lee’s assessment",{"children":[["$","span",null,{"children":"Lee’s assessment"}],["$","strong",null,{"children":"Success was incomplete because the Army of the Potomac escaped"}],["$","small",null,{"children":"In his correspondence and official report, Lee expressed disappointment that the Federal army had not been destroyed. The episode also assigns Lee responsibility for important planning and command errors."}]]}]
20:["$","div","Confederate command removals",{"children":[["$","span",null,{"children":"Confederate command removals"}],["$","strong",null,{"children":"John B. Magruder, Theophilus H. Holmes, and Benjamin Huger left field command"}],["$","small",null,{"children":"Magruder and Holmes went to the Western Theater. Huger became inspector of artillery and ordnance. The episode presents these changes as Lee’s response to command failures revealed during the Seven Days."}]]}]
21:["$","div","Army of Northern Virginia reorganization",{"children":[["$","span",null,{"children":"Army of Northern Virginia reorganization"}],["$","strong",null,{"children":"Two large wings under James Longstreet and Stonewall Jackson"}],["$","small",null,{"children":"They functioned as corps before Confederate law formally authorized the corps structure. The episode states that Longstreet’s enlarged command contained 28 brigades and Jackson’s reduced command seven."}]]}]
22:["$","div","Army of Virginia created",{"children":[["$","span",null,{"children":"Army of Virginia created"}],["$","strong",null,{"children":"June 26, 1862, under Maj. Gen. John Pope"}],["$","small",null,{"children":"The new army combined the previously separate northern Virginia commands. Pope took up the assignment while the Seven Days fighting was beginning near Richmond."}]]}]
23:["$","div","Army of Virginia organization",{"children":[["$","span",null,{"children":"Army of Virginia organization"}],["$","strong",null,{"children":"Three corps under Franz Sigel, Nathaniel P. Banks, and Irvin McDowell"}],["$","small",null,{"children":"Sigel replaced John C. Frémont, who declined a corps command subordinate to Pope. The automated transcript mishears Irvin as “Urban” and spells Sigel as “Siegel.”"}]]}]
24:["$","div","Army of Virginia strength",{"children":[["$","span",null,{"children":"Army of Virginia strength"}],["$","strong",null,{"children":"About 51,000 in the episode’s account"}],["$","small",null,{"children":"The U.S. Army campaign summary gives about 45,000 when the scattered commands were consolidated. Strength varies with date and which detached forces are counted."}]]}]
25:["$","div","New United States command structure",{"children":[["$","span",null,{"children":"New United States command structure"}],["$","strong",null,{"children":"Lincoln, General-in-Chief Halleck, Pope in northern Virginia, and McClellan on the Peninsula"}],["$","small",null,{"children":"Halleck’s appointment on July 11 placed a military superior between the president and the two field-army commanders. The Army of the Potomac’s transfer allowed the administration to move units gradually toward Pope."}]]}]
26:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Struggle for a Vast Future: The American Civil War,” edited by Aaron Sheehan-Dean"}],["$","small",null,{"children":"The collection contains twelve essays on the war’s origins, conduct, home fronts, and legacy."}]]}]
27:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Gaines’s Mill, Agénor-Étienne de Gasparin, Zachariah Chandler, Glenn David Brasher, Benjamin Huger, Irvin McDowell, Franz Sigel, and Aaron Sheehan-Dean"}],["$","small",null,{"children":"The automated transcript produces forms including “Gance’s Mill,” “Zacharia,” “Glen,” “Ujet,” “Urban,” “Siegel,” and “Sheehan Dean.”"}]]}]
28:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
29:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The Peninsula Campaign: advance and withdrawal",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep169-peninsula-campaign.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The Peninsula Campaign: advance and withdrawal at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-peninsula-campaign.svg","alt":"Generalized schematic map of the 1862 Peninsula Campaign from Fort Monroe toward Richmond and back to Harrison’s Landing and Fort Monroe.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Peninsula Campaign: advance and withdrawal"}],["$","span",null,{"children":"The Army of the Potomac moved from Fort Monroe through Yorktown and Williamsburg to the outskirts of Richmond. Lee’s Seven Days offensive drove the Federal army to Harrison’s Landing; Halleck later ordered it evacuated by way of Fort Monroe. Shorelines, waterways, routes, locations, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep169-peninsula-campaign.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Library of Congress campaign maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Eastern Virginia after the Seven Days",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep169-strategic-realignment.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Eastern Virginia after the Seven Days at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-strategic-realignment.svg","alt":"Generalized schematic map showing Washington, Pope in northern Virginia, McClellan at Harrison’s Landing, Richmond, and the opposing army movements of summer 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Eastern Virginia after the Seven Days"}],["$","span",null,{"children":"Pope’s Army of Virginia concentrated in northern Virginia while McClellan remained at Harrison’s Landing. Halleck ordered the Army of the Potomac transferred through Fort Monroe toward Aquia and Alexandria. With Richmond secure, Lee sent Jackson toward Gordonsville and then moved against Pope. Waterways, routes, locations, positions, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep169-strategic-realignment.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Library of Congress maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L30"]}]]}],"$undefined"]}]]}]]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The withdrawal order closes the Peninsula sequence",{"className":"moment","children":[["$","$L31",null,{"seconds":70,"label":"1:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The withdrawal order closes the Peninsula sequence"}],["$","p",null,{"children":"The episode begins with Halleck’s August 3 instruction ordering McClellan to remove the Army of the Potomac from the Peninsula."}]]}]]}],["$","div","The campaign’s 160-day span is defined",{"className":"moment","children":[["$","$L31",null,{"seconds":88,"label":"1:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign’s 160-day span is defined"}],["$","p",null,{"children":"The episode counts from the first Federal arrivals at Fort Monroe on March 20 through the final evacuation on August 26."}]]}]]}],["$","div","Victory and defeat are stated",{"className":"moment","children":[["$","$L31",null,{"seconds":103,"label":"1:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Victory and defeat are stated"}],["$","p",null,{"children":"Richmond remained secure under Lee, while McClellan’s offensive ended in retreat."}]]}]]}],["$","div","Campaign participation is estimated",{"className":"moment","children":[["$","$L31",null,{"seconds":117,"label":"1:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Campaign participation is estimated"}],["$","p",null,{"children":"The episode gives approximately 250,000 participants on land and at sea across the campaign."}]]}]]}],["$","div","Battle casualties are totaled",{"className":"moment","children":[["$","$L31",null,{"seconds":129,"label":"2:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Battle casualties are totaled"}],["$","p",null,{"children":"The hosts give 25,370 United States and 30,450 Confederate battle and skirmish casualties."}]]}]]}],["$","div","Disease deaths are added",{"className":"moment","children":[["$","$L31",null,{"seconds":153,"label":"2:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Disease deaths are added"}],["$","p",null,{"children":"At least 8,670 battle deaths and an estimated 5,000 disease deaths produce a minimum death estimate of about 13,670."}]]}]]}],["$","div","The human cost is expressed as a share",{"className":"moment","children":[["$","$L31",null,{"seconds":173,"label":"2:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"The human cost is expressed as a share"}],["$","p",null,{"children":"The episode concludes that more than 24 percent of all participants were wounded, missing, or dead from battle or disease."}]]}]]}],["$","div","McClellan’s limited-war vision is described",{"className":"moment","children":[["$","$L31",null,{"seconds":187,"label":"3:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan’s limited-war vision is described"}],["$","p",null,{"children":"A passage from Stephen W. Sears explains the expectation that capturing Richmond could end the rebellion through negotiation before the conflict became revolutionary."}]]}]]}],["$","div","The campaign’s larger turning point is stated",{"className":"moment","children":[["$","$L31",null,{"seconds":227,"label":"3:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign’s larger turning point is stated"}],["$","p",null,{"children":"The failed offensive meant no negotiated end followed the Seven Days; the war continued and its aims expanded."}]]}]]}],["$","div","The episode turns to consequences",{"className":"moment","children":[["$","$L31",null,{"seconds":265,"label":"4:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode turns to consequences"}],["$","p",null,{"children":"The analysis broadens from the two armies to civilians, political institutions, war aims, and international opinion."}]]}]]}],["$","div","McClellan’s failure and Lee’s rise are paired",{"className":"moment","children":[["$","$L31",null,{"seconds":303,"label":"5:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan’s failure and Lee’s rise are paired"}],["$","p",null,{"children":"The episode identifies the reversal in the East as a pivotal change in the larger direction of the war."}]]}]]}],"$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51","$L52","$L53","$L54","$L55","$L56","$L57","$L58","$L59","$L5a","$L5b","$L5c","$L5d","$L5e","$L5f","$L60","$L61","$L62"]}]]}]
2b:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States national and army command",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States national and army command"}],[["$","div","Commander in chief and head of the administration",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief and head of the administration"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Secretary of War Edwin M. Stanton; Secretary of the Treasury Salmon P. Chase; the cabinet that considered emancipation policy"}]]}],["$","div","General-in-chief of the United States Army from July 11, 1862",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief of the United States Army from July 11, 1862"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Strategic superior of George B. McClellan and John Pope; directed the transfer and concentration of Federal forces"}]]}],["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Remained at Harrison’s Landing until the army’s evacuation; retained strong loyalty among many officers and soldiers despite conflict with the administration"}]]}],["$","div","Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"I Corps, Maj. Gen. Franz Sigel; II Corps, Maj. Gen. Nathaniel P. Banks; III Corps, Maj. Gen. Irvin McDowell"}]]}]]]}],["$","section","Confederate national and army command",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederate national and army command"}],[["$","div","Confederate commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate commander in chief"}],["$","span",null,{"children":"President Jefferson Davis"}],["$","small",null,{"children":"Selected Robert E. Lee after Joseph E. Johnston was wounded; his disputes with P. G. T. Beauregard also shaped the senior command picture"}]]}],["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Protected Richmond, reorganized the army after the Seven Days, and then shifted forces north against Pope"}]]}],["$","div","Right Wing, Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing, Army of Northern Virginia"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Received the larger grouping in Lee’s post-campaign organization and became the senior subordinate Lee relied on most heavily"}]]}],["$","div","Left Wing, Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing, Army of Northern Virginia"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Retained Lee’s confidence despite poor coordination during the Seven Days; moved north toward Gordonsville and Pope"}]]}],["$","div","Post-Seven Days reassignments",{"className":"command-entry","children":[["$","strong",null,{"children":"Post-Seven Days reassignments"}],["$","span",null,{"children":"Senior commanders removed from field roles"}],["$","small",null,{"children":"John B. Magruder and Theophilus H. Holmes transferred west; Benjamin Huger became inspector of artillery and ordnance"}]]}]]]}]]}],"$L63","$L64"]}]
2c:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Gen. Albert Sidney Johnston",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Gen. Albert Sidney Johnston"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the Confederate Army of the Mississippi","."]}]," ","Killed at the Battle of Shiloh on April 6, 1862. The episode identifies his death as one reason the Confederacy lacked a broadly successful senior army commander before Lee’s defense of Richmond."]}]]}]]}]]}]
2d:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep169-peninsula-campaign.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-peninsula-campaign.svg","alt":"Generalized schematic map of the Federal advance up the Virginia Peninsula and withdrawal to Harrison’s Landing and Fort Monroe.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The Army of the Potomac reached the outskirts of Richmond but withdrew to the James River during the Seven Days and later evacuated through Fort Monroe. This map is schematic and not to scale."}]]}],["$","figure","/images/ep169-strategic-realignment.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-strategic-realignment.svg","alt":"Generalized schematic map of the eastern Virginia strategic realignment after the Seven Days.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The new Army of Virginia covered Washington and northern Virginia while the Army of the Potomac remained on the James. Lee soon shifted from Richmond toward Pope. This map is schematic and not to scale."}]]}],["$","figure","/images/ep169-emancipation-cabinet.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-emancipation-cabinet.jpg","alt":"Mezzotint showing Abraham Lincoln and his cabinet considering the Emancipation Proclamation.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alexander Hay Ritchie’s 1866 engraving after Francis Bicknell Carpenter’s 1864 painting reconstructs Lincoln’s first presentation of an emancipation draft to the cabinet on July 22, 1862. It is a later commemorative image, not an eyewitness record."}]]}],["$","figure","/images/ep169-abraham-lincoln.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-abraham-lincoln.jpg","alt":"Head-and-shoulders photographic portrait of Abraham Lincoln facing slightly left.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Abraham Lincoln concluded that a conciliatory war policy had failed and presented an emancipation draft to his cabinet in July 1862."}]]}],["$","figure","/images/ep169-george-mcclellan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-george-mcclellan.jpg","alt":"Carte-de-visite portrait of Major General George B. McClellan in United States Army uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"George B. McClellan retained the loyalty of many soldiers after the Peninsula defeat but lost influence with Lincoln, Congress, and senior cabinet officials."}]]}],["$","figure","/images/ep169-robert-e-lee.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-robert-e-lee.jpg","alt":"Civil War glass-negative portrait of Confederate general Robert E. Lee.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Robert E. Lee’s aggressive defense of Richmond raised his standing and began the post-Seven Days reorganization of the Army of Northern Virginia."}]]}],["$","figure","/images/ep169-john-pope.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-john-pope.jpg","alt":"Civil War glass-negative portrait of United States general John Pope.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"John Pope came east from the Western Theater to command the Army of Virginia, the consolidated force that became Lee’s next target."}]]}]]}]]}]
