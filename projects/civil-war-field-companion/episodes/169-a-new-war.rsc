2c:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep169-peninsula-campaign.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-peninsula-campaign.svg","alt":"Generalized schematic map of the Federal advance up the Virginia Peninsula and withdrawal to Harrison’s Landing and Fort Monroe.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The Army of the Potomac reached the outskirts of Richmond but withdrew to the James River during the Seven Days and later evacuated through Fort Monroe. This map is schematic and not to scale."}]]}],["$","figure","/images/ep169-strategic-realignment.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-strategic-realignment.svg","alt":"Generalized schematic map of the eastern Virginia strategic realignment after the Seven Days.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The new Army of Virginia covered Washington and northern Virginia while the Army of the Potomac remained on the James. Lee soon shifted from Richmond toward Pope. This map is schematic and not to scale."}]]}],["$","figure","/images/ep169-emancipation-cabinet.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-emancipation-cabinet.jpg","alt":"Mezzotint showing Abraham Lincoln and his cabinet considering the Emancipation Proclamation.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alexander Hay Ritchie’s 1866 engraving after Francis Bicknell Carpenter’s 1864 painting reconstructs Lincoln’s first presentation of an emancipation draft to the cabinet on July 22, 1862. It is a later commemorative image, not an eyewitness record."}]]}],["$","figure","/images/ep169-abraham-lincoln.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-abraham-lincoln.jpg","alt":"Head-and-shoulders photographic portrait of Abraham Lincoln facing slightly left.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Abraham Lincoln concluded that a conciliatory war policy had failed and presented an emancipation draft to his cabinet in July 1862."}]]}],["$","figure","/images/ep169-george-mcclellan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-george-mcclellan.jpg","alt":"Carte-de-visite portrait of Major General George B. McClellan in United States Army uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"George B. McClellan retained the loyalty of many soldiers after the Peninsula defeat but lost influence with Lincoln, Congress, and senior cabinet officials."}]]}],["$","figure","/images/ep169-robert-e-lee.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-robert-e-lee.jpg","alt":"Civil War glass-negative portrait of Confederate general Robert E. Lee.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Robert E. Lee’s aggressive defense of Richmond raised his standing and began the post-Seven Days reorganization of the Army of Northern Virginia."}]]}],["$","figure","/images/ep169-john-pope.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep169-john-pope.jpg","alt":"Civil War glass-negative portrait of United States general John Pope.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"John Pope came east from the Western Theater to command the Army of Virginia, the consolidated force that became Lee’s next target."}]]}]]}]]}]
