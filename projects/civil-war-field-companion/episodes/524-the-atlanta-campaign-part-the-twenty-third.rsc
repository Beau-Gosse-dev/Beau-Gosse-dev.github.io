12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode shifts to Mitchell’s brigade",{"className":"moment","children":[["$","$L18",null,{"seconds":101,"label":"1:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode shifts to Mitchell’s brigade"}],["$","p",null,{"children":"Jefferson C. Davis sent Daniel McCook Jr. and John G. Mitchell against the Dead Angle. The previous episode covered McCook; this one follows Mitchell."}]]}]]}],["$","div","John G. Mitchell commanded the second attacking brigade",{"className":"moment","children":[["$","$L18",null,{"seconds":145,"label":"2:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"John G. Mitchell commanded the second attacking brigade"}],["$","p",null,{"children":"The 25-year-old Ohio lawyer had led troops at Chickamauga but had seen limited combat during the Atlanta campaign."}]]}]]}],["$","div","Mitchell formed a column of regiments",{"className":"moment","children":[["$","$L18",null,{"seconds":197,"label":"3:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mitchell formed a column of regiments"}],["$","p",null,{"children":"The 113th Ohio led, followed by the 121st and 98th Ohio and 78th Illinois. The 34th Illinois deployed ahead as skirmishers."}]]}]]}],["$","div","The brigade was to deploy into line at the works",{"className":"moment","children":[["$","$L18",null,{"seconds":244,"label":"4:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The brigade was to deploy into line at the works"}],["$","p",null,{"children":"Henry Banning’s 121st Ohio was to move right when the leading regiment reached the defenses. The remaining regiments would extend the line farther right."}]]}]]}],["$","div","George Maney’s brigade held the Dead Angle",{"className":"moment","children":[["$","$L18",null,{"seconds":326,"label":"5:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"George Maney’s brigade held the Dead Angle"}],["$","p",null,{"children":"Maney’s Tennessee troops occupied the tip and south face of the salient. Benjamin Cheatham ordered them to hold the works."}]]}]]}],["$","div","The attack began with artillery fire",{"className":"moment","children":[["$","$L18",null,{"seconds":376,"label":"6:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack began with artillery fire"}],["$","p",null,{"children":"At 8 a.m., U.S. guns opened and the 34th Illinois overran the Confederate skirmish line. The brigade moved into the stream valley below the works."}]]}]]}],["$","div","Confederate soldiers saw the column approaching",{"className":"moment","children":[["$","$L18",null,{"seconds":459,"label":"7:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate soldiers saw the column approaching"}],["$","p",null,{"children":"Captain W. D. Kelly of the 1st Tennessee alerted the defenders as Mitchell’s troops climbed the slope."}]]}]]}],["$","div","Abatis and enfilading artillery broke up the formation",{"className":"moment","children":[["$","$L18",null,{"seconds":484,"label":"8:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Abatis and enfilading artillery broke up the formation"}],["$","p",null,{"children":"Cut saplings disrupted the U.S. column. Eight Confederate guns south of the salient fired along the attacking line."}]]}]]}],["$","div","The leading regiments reached the works",{"className":"moment","children":[["$","$L18",null,{"seconds":552,"label":"9:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"The leading regiments reached the works"}],["$","p",null,{"children":"The 34th Illinois stopped 12 to 15 yards short. Men of the 113th Ohio reached the parapet, where some were killed and others captured."}]]}]]}],["$","div","The 113th Ohio lost many officers",{"className":"moment","children":[["$","$L18",null,{"seconds":591,"label":"9:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 113th Ohio lost many officers"}],["$","p",null,{"children":"Lieutenant Colonel Darius B. Warner was badly wounded. Ten of the regiment’s 19 officers were killed or wounded."}]]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}]]}]
