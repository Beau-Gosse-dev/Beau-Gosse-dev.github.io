1a:["$","div","About 180 Confederates held the tip",{"className":"moment","children":[["$","$L18",null,{"seconds":651,"label":"10:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"About 180 Confederates held the tip"}],["$","p",null,{"children":"Maney placed the consolidated 1st and 27th Tennessee in the salient while additional regiments held the adjoining works."}]]}]]}]
