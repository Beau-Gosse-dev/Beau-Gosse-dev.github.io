2d:["$","figure","Jedediah Hotchkiss’s map of Jackson’s operations",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep174-hotchkiss-campaign-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Jedediah Hotchkiss’s map of Jackson’s operations at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep174-hotchkiss-campaign-map.jpg","alt":"Jedediah Hotchkiss manuscript map of Second Corps positions around Bristoe Station, Manassas Junction, Groveton, and Chantilly in late August and early September 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jedediah Hotchkiss’s map of Jackson’s operations"}],["$","span",null,{"children":"This Confederate manuscript map records positions of Jackson’s Second Corps from August 26 through September 2, including Bristoe Station, Manassas Junction, Groveton, Second Manassas, and Chantilly. Its time span extends beyond this episode, but it provides a primary geographic record of the campaign area."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep174-hotchkiss-campaign-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Geography and Map Division, Hotchkiss Map Collection; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
2f:["$","div","The division order is given",{"className":"moment","children":[["$","$L2e",null,{"seconds":426,"label":"7:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The division order is given"}],["$","p",null,{"children":"Ewell marches first, followed by A. P. Hill and Taliaferro, with approximately 80 guns in the column."}]]}]]}]
30:["$","div","Jackson crosses at Hinson’s Mill",{"className":"moment","children":[["$","$L2e",null,{"seconds":443,"label":"7:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson crosses at Hinson’s Mill"}],["$","p",null,{"children":"The column uses an upper Rappahannock ford that the Federals have not guarded."}]]}]]}]
31:["$","div","The first day ends near Salem",{"className":"moment","children":[["$","$L2e",null,{"seconds":449,"label":"7:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first day ends near Salem"}],["$","p",null,{"children":"Jackson halts after about 15 miles; Salem places the column roughly midway to Manassas Junction in the episode’s account."}]]}]]}]
32:["$","div","Pope receives reports of the movement",{"className":"moment","children":[["$","$L2e",null,{"seconds":517,"label":"8:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope receives reports of the movement"}],["$","p",null,{"children":"By noon on August 25, reports identify a large Confederate body moving northwest, but Pope concludes it is bound for the Shenandoah Valley."}]]}]]}]
33:["$","div","Federal units move away from the threat",{"className":"moment","children":[["$","$L2e",null,{"seconds":542,"label":"9:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal units move away from the threat"}],["$","p",null,{"children":"McDowell remains at Warrenton while Sigel goes to Fayetteville and Banks moves toward Kelly’s Ford."}]]}]]}]
34:["$","div","Pope orders a delayed probe",{"className":"moment","children":[["$","$L2e",null,{"seconds":583,"label":"9:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope orders a delayed probe"}],["$","p",null,{"children":"Late in the day, Pope orders McDowell to cross at White Sulphur Springs the next morning instead of sending cavalry directly toward Salem."}]]}]]}]
35:["$","div","Pope reports the wrong destination",{"className":"moment","children":[["$","$L2e",null,{"seconds":607,"label":"10:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope reports the wrong destination"}],["$","p",null,{"children":"Pope tells Halleck that Jackson is moving toward the Shenandoah Valley and interprets the force at Salem as a flank guard."}]]}]]}]
36:["$","div","Reinforcements encounter logistical disorder",{"className":"moment","children":[["$","$L2e",null,{"seconds":650,"label":"10:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Reinforcements encounter logistical disorder"}],["$","p",null,{"children":"The arrival of Army of the Potomac units at Alexandria creates transport demands that Halleck and the field commanders do not coordinate effectively."}]]}]]}]
37:["$","div","Pope’s railcars cause congestion",{"className":"moment","children":[["$","$L2e",null,{"seconds":695,"label":"11:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope’s railcars cause congestion"}],["$","p",null,{"children":"More than 200 cars have been concentrated at Warrenton Junction; releasing them does not immediately restore the disrupted schedules."}]]}]]}]
38:["$","div","Sturgis appropriates a train",{"className":"moment","children":[["$","$L2e",null,{"seconds":727,"label":"12:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sturgis appropriates a train"}],["$","p",null,{"children":"Brig. Gen. Samuel D. Sturgis stops a train outside Alexandria for his troops, leading railroad chief Herman Haupt to intervene."}]]}]]}]
39:["$","div","Lee’s maneuver gains operational room",{"className":"moment","children":[["$","$L2e",null,{"seconds":781,"label":"13:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s maneuver gains operational room"}],["$","p",null,{"children":"Pope’s incorrect reading of Jackson’s route and the railroad disorder leave the Confederate march toward the Federal rear unopposed."}]]}]]}]
3a:["$","div","Jackson resumes on August 26",{"className":"moment","children":[["$","$L2e",null,{"seconds":831,"label":"13:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson resumes on August 26"}],["$","p",null,{"children":"The column begins the second day with Thoroughfare Gap as the principal obstacle between Salem and Gainesville."}]]}]]}]
3b:["$","div","Cavalry examines Thoroughfare Gap",{"className":"moment","children":[["$","$L2e",null,{"seconds":873,"label":"14:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cavalry examines Thoroughfare Gap"}],["$","p",null,{"children":"Jackson sends horsemen ahead at first light to learn whether Federal troops hold the pass."}]]}]]}]
3c:["$","div","The gap is open",{"className":"moment","children":[["$","$L2e",null,{"seconds":880,"label":"14:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"The gap is open"}],["$","p",null,{"children":"The cavalry finds no Federal troops, allowing the infantry and artillery column to continue without a fight or warning from the pass."}]]}]]}]
3d:["$","div","Stuart rejoins Jackson",{"className":"moment","children":[["$","$L2e",null,{"seconds":890,"label":"14:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart rejoins Jackson"}],["$","p",null,{"children":"After leaving the Rappahannock at 2 a.m., Stuart and the rest of his cavalry catch the column in mid-afternoon."}]]}]]}]
3e:["$","div","Pope remains on the river",{"className":"moment","children":[["$","$L2e",null,{"seconds":904,"label":"15:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope remains on the river"}],["$","p",null,{"children":"Pope continues to assume Jackson is moving toward the valley and keeps most of the Army of Virginia along the upper Rappahannock."}]]}]]}]
3f:["$","div","Longstreet recommends following Jackson",{"className":"moment","children":[["$","$L2e",null,{"seconds":974,"label":"16:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet recommends following Jackson"}],["$","p",null,{"children":"A direct river crossing risks delay against Federal rear guards, so Longstreet proposes using Jackson’s route to reunite the army."}]]}]]}]
40:["$","div","Lee orders Longstreet toward Salem",{"className":"moment","children":[["$","$L2e",null,{"seconds":984,"label":"16:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee orders Longstreet toward Salem"}],["$","p",null,{"children":"Late in the afternoon, Lee accepts Longstreet’s recommendation and starts the other Confederate wing after Jackson."}]]}]]}]
41:["$","div","The Federal rear is lightly guarded",{"className":"moment","children":[["$","$L2e",null,{"seconds":1037,"label":"17:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Federal rear is lightly guarded"}],["$","p",null,{"children":"The episode identifies only small infantry detachments at Bristoe and Manassas, plus one battery and an inexperienced cavalry regiment at Manassas."}]]}]]}]
42:["$","div","Jackson chooses Bristoe first",{"className":"moment","children":[["$","$L2e",null,{"seconds":1058,"label":"17:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson chooses Bristoe first"}],["$","p",null,{"children":"Reaching Gainesville around 2 p.m., Jackson decides to cut the railroad at Bristoe before attempting the larger Manassas depot."}]]}]]}]
43:["$","div","Munford seizes Bristoe Station",{"className":"moment","children":[["$","$L2e",null,{"seconds":1099,"label":"18:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Munford seizes Bristoe Station"}],["$","p",null,{"children":"The 2nd Virginia Cavalry captures the station; Munford reports 43 prisoners, nine Federals killed or wounded, and three Confederates wounded."}]]}]]}]
44:["$","div","Forno joins the railroad work",{"className":"moment","children":[["$","$L2e",null,{"seconds":1120,"label":"18:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forno joins the railroad work"}],["$","p",null,{"children":"Henry Forno’s Louisiana brigade comes up, and its infantry works with Munford’s cavalry to stop rail traffic."}]]}]]}]
