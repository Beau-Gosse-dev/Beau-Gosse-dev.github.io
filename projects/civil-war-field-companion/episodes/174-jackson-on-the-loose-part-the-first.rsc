 operations"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/2018666231/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/2018666231/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Manassas Junction damaged rolling stock"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/2012646205/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/2012646205/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Thomas J. “Stonewall” Jackson portrait"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/2018666476/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/2018666476/","target":"_blank","rel":"noreferrer","children":["Library of Congress: John Pope portrait"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://civilwarpodcast.org/book-recommendations/",{"children":"$L55"}]]}]]}]
