48:["$","div","Prisoners describe Manassas Junction",{"className":"moment","children":[["$","$L2e",null,{"seconds":1235,"label":"20:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Prisoners describe Manassas Junction"}],["$","p",null,{"children":"Jackson learns that the large supply depot four miles northeast is defended by only a few hundred men."}]]}]]}]
