1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",174," · ","August 24–26, 1862"," · ","Northern Virginia, from the upper Rappahannock River and Warrenton through Salem and Thoroughfare Gap to Gainesville, Bristoe Station, and the approaches to Manassas Junction"]}],["$","h1",null,{"children":"JACKSON ON THE LOOSE (Part the First)"}],["$","span",null,{"className":"result-label","children":"Confederate operational success in progress. Jackson marched around Pope’s right, passed unopposed through Thoroughfare Gap, and cut the Orange and Alexandria Railroad at Bristoe Station. By the end of the episode, Trimble and Stuart were moving toward the lightly defended supply depot at Manassas Junction; its capture occurred after the episode’s stopping point"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4953950141.mp3?updated=1695419313","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Lee’s August 24 order through Jackson’s night movement on August 26"}],["$","small",null,{"children":"The account ends after Jackson detaches Isaac Trimble’s two regiments toward Manassas Junction and sends Jeb Stuart to reinforce and command the expedition."}]]}],["$","div","Operational setting",{"children":[["$","span",null,{"children":"Operational setting"}],["$","strong",null,{"children":"A stalemate along the upper Rappahannock"}],["$","small",null,{"children":"Pope held from Warrenton north to Waterloo Bridge while elements of the Army of the Potomac approached. Lee wanted to act before those reinforcements shifted the balance."}]]}],["$","div","Lee’s objective",{"children":[["$","span",null,{"children":"Lee’s objective"}],["$","strong",null,{"children":"Turn Pope’s right and strike his railroad supply line"}],["$","small",null,{"children":"Lee directed Jackson around the Federal flank through Thoroughfare Gap toward the Orange and Alexandria Railroad and Manassas Junction. Longstreet initially remained opposite Pope to threaten the river line."}]]}],["$","div","Operational risk",{"children":[["$","span",null,{"children":"Operational risk"}],["$","strong",null,{"children":"Jackson would be separated from Lee and Longstreet"}],["$","small",null,{"children":"The movement exposed Jackson to interception by Pope or arriving troops from McClellan’s army before the Confederate wings could reunite."}]]}],["$","div","Jackson’s strength",{"children":[["$","span",null,{"children":"Jackson’s strength"}],["$","strong",null,{"children":"Approximately 25,000–27,000 men"}],["$","small",null,{"children":"The episode uses about 27,000. The National Park Service uses about 25,000 for Jackson and Stuart. Such figures vary with the units and effectives counted."}]]}],["$","div","Marching column",{"children":["$Le","$Lf","$L10"]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}],"$L26","$undefined","$L27",false,"$L28",false,"$L29","$L2a","$L2b"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","span",null,{"children":"Marching column"}]
f:["$","strong",null,{"children":"Ewell, A. P. Hill, then Taliaferro"}]
10:["$","small",null,{"children":"Richard S. Ewell’s division led, followed by A. P. Hill’s Light Division and William B. Taliaferro’s division. The episode also gives approximately 80 guns in 21 batteries."}]
11:["$","div","March preparation",{"children":[["$","span",null,{"children":"March preparation"}],["$","strong",null,{"children":"Three days’ cooked rations and 60 rounds per man"}],["$","small",null,{"children":"Knapsacks were left behind, and wagons were excluded except ambulances and ordnance vehicles. Orders prohibited straggling and delays while crossing streams."}]]}]
12:["$","div","Route",{"children":[["$","span",null,{"children":"Route"}],["$","strong",null,{"children":"Jeffersonton–Hinson’s Mill–Salem–Thoroughfare Gap–Gainesville–Bristoe"}],["$","small",null,{"children":"Jackson crossed the unguarded upper Rappahannock at Hinson’s Mill, camped near Salem on August 25, and reached Bristoe Station near sunset on August 26."}]]}]
13:["$","div","Distance",{"children":[["$","span",null,{"children":"Distance"}],["$","strong",null,{"children":"Approximately 55 miles in two days"}],["$","small",null,{"children":"The National Park Service gives about 55 miles for the August 25–26 march. The episode describes 15 miles on the first day and roughly 54 miles across several days when discussing troop fatigue at Bristoe."}]]}]
14:["$","div","Courier link",{"children":[["$","span",null,{"children":"Courier link"}],["$","strong",null,{"children":"25 Black Horse Cavalry troopers"}],["$","small",null,{"children":"Lee selected couriers to carry information between his headquarters and Jackson because Longstreet’s movement depended on Jackson’s progress."}]]}]
15:["$","div","Pope’s assessment on August 25",{"children":[["$","span",null,{"children":"Pope’s assessment on August 25"}],["$","strong",null,{"children":"Jackson was moving toward the Shenandoah Valley"}],["$","small",null,{"children":"Pope treated the force reported at Salem as a flank guard and did not move troops against Jackson’s actual line of advance."}]]}]
16:["$","div","Federal movements",{"children":[["$","span",null,{"children":"Federal movements"}],["$","strong",null,{"children":"McDowell stayed near Warrenton while Sigel and Banks moved south"}],["$","small",null,{"children":"The episode places Sigel at Fayetteville and sends Banks past Bealeton toward Kelly’s Ford. These dispositions did not cover Thoroughfare Gap or the railroad rear."}]]}]
17:["$","div","Reinforcement problem",{"children":[["$","span",null,{"children":"Reinforcement problem"}],["$","strong",null,{"children":"Army of the Potomac units were arriving through Alexandria"}],["$","small",null,{"children":"Halleck, Pope, McClellan, and the railroad administration did not coordinate the transfer efficiently. The episode treats this disruption as part of the command problem facing Pope."}]]}]
18:["$","div","Railroad congestion",{"children":[["$","span",null,{"children":"Railroad congestion"}],["$","strong",null,{"children":"More than 200 cars concentrated at Warrenton Junction"}],["$","small",null,{"children":"The episode says Pope had gathered the available cars for a possible emergency, then released them after the concentration had already disrupted reinforcement schedules."}]]}]
19:["$","div","Herman Haupt",{"children":[["$","span",null,{"children":"Herman Haupt"}],["$","strong",null,{"children":"Chief of U.S. Military Railroads in Virginia"}],["$","small",null,{"children":"The automated transcript renders his surname as “Hopped.” Haupt attempted to control train movements while officers competed for transport."}]]}]
1a:["$","div","Thoroughfare Gap",{"children":[["$","span",null,{"children":"Thoroughfare Gap"}],["$","strong",null,{"children":"Unguarded at first light on August 26"}],["$","small",null,{"children":"Jackson sent cavalry ahead to examine the pass. Its occupation by even a small Federal force could have delayed the march and disclosed his route."}]]}]
1b:["$","div","Stuart’s movement",{"children":[["$","span",null,{"children":"Stuart’s movement"}],["$","strong",null,{"children":"Rejoined Jackson during the afternoon of August 26"}],["$","small",null,{"children":"Stuart left the Rappahannock sector at about 2 a.m. and caught Jackson’s column after it had passed the gap."}]]}]
1c:["$","div","Longstreet’s movement",{"children":[["$","span",null,{"children":"Longstreet’s movement"}],["$","strong",null,{"children":"Ordered to follow Jackson’s route toward Salem"}],["$","small",null,{"children":"Because Pope remained strong on the river, Longstreet advised against a direct crossing. Lee accepted the recommendation late on August 26."}]]}]
1d:["$","div","Federal rear guard",{"children":[["$","span",null,{"children":"Federal rear guard"}],["$","strong",null,{"children":"Small detachments at Bristoe and Manassas"}],["$","small",null,{"children":"The episode gives three infantry companies at Bristoe and, at Manassas, three infantry companies, one artillery battery, and an inexperienced cavalry regiment."}]]}]
1e:["$","div","Gainesville decision",{"children":[["$","span",null,{"children":"Gainesville decision"}],["$","strong",null,{"children":"Cut the railroad at Bristoe before attacking Manassas Junction"}],["$","small",null,{"children":"At about 2 p.m. on August 26, Jackson chose the less-defended railroad point and also hoped to damage the nearby Kettle Run bridge."}]]}]
1f:["$","div","Bristoe seizure",{"children":[["$","span",null,{"children":"Bristoe seizure"}],["$","strong",null,{"children":"2nd Virginia Cavalry under Col. Thomas T. Munford"}],["$","small",null,{"children":"Munford reported nine Federals killed or wounded and 43 captured, including the lieutenant colonel of the 4th New York Cavalry, at a cost of three Confederate wounded."}]]}]
20:["$","div","Railroad interdiction",{"children":[["$","span",null,{"children":"Railroad interdiction"}],["$","strong",null,{"children":"Munford and Henry Forno obstructed the track"}],["$","small",null,{"children":"One locomotive broke through the first obstruction. A later train stopped after hitting a stronger barrier and receiving infantry fire; the following train collided with it."}]]}]
21:["$","div","Warning spreads",{"children":[["$","span",null,{"children":"Warning spreads"}],["$","strong",null,{"children":"A fourth train backed away from the wreckage"}],["$","small",null,{"children":"Its crew could warn Catlett Station and Warrenton Junction, increasing the need for Jackson to act quickly against Manassas Junction."}]]}]
22:["$","div","Manassas expedition",{"children":[["$","span",null,{"children":"Manassas expedition"}],["$","strong",null,{"children":"21st Georgia and 21st North Carolina, about 500 men"}],["$","small",null,{"children":"Brig. Gen. Isaac R. Trimble volunteered his two regiments. They departed at about 9 p.m.; Jackson then sent Stuart with cavalry to reinforce them and take command."}]]}]
23:["$","div","Senior command casualties",{"children":[["$","span",null,{"children":"Senior command casualties"}],["$","strong",null,{"children":"None killed or mortally wounded in the episode’s events"}],["$","small",null,{"children":"The Bristoe seizure produced small reported losses, but the episode names no senior leader killed or mortally wounded between August 24 and the night of August 26."}]]}]
24:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The American War: A History of the Civil War Era”"}],["$","small",null,{"children":"The hosts recommend the 2015 general history by Gary W. Gallagher and Joan Waugh."}]]}]
25:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Ewell, Taliaferro, Munford, Forno, Haupt, Hinson’s Mill, and Bealeton"}],["$","small",null,{"children":"The automated transcript produces forms including “Yule,” “Tolliver,” “Mumford,” “Forna,” “Hopped,” “Henson’s Mill,” and “Beelton.”"}]]}]
26:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
27:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Jackson’s flank march around Pope’s right",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep174-flank-march.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Jackson’s flank march around Pope’s right at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep174-flank-march.svg","alt":"Generalized map of Jackson’s August 25 and 26 flank march from the upper Rappahannock through Salem and Thoroughfare Gap to Bristoe Station.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jackson’s flank march around Pope’s right"}],["$","span",null,{"children":"Jackson left the upper Rappahannock on August 25, crossed at Hinson’s Mill, camped near Salem, and on August 26 passed through Thoroughfare Gap and Gainesville to Bristoe Station. Longstreet remained opposite Pope before Lee ordered him to follow Jackson’s route. Towns, roads, river line, distances, and routes are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep174-flank-march.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Jedediah Hotchkiss map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Bristoe Station railroad operation",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep174-bristoe-operation.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Bristoe Station railroad operation at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep174-bristoe-operation.svg","alt":"Generalized diagram of Confederate forces at Bristoe Station, the sequence of trains at the railroad obstruction, and the night movement toward Manassas Junction.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Bristoe Station railroad operation"}],["$","span",null,{"children":"Munford’s cavalry seized Bristoe Station, and Forno’s Louisiana infantry helped obstruct the Orange and Alexandria Railroad. One train broke through, two collided at the obstruction, and another withdrew. Trimble’s two regiments then moved northeast toward Manassas Junction, followed by Stuart. The diagram shows operational relationships and sequence, not exact tracks, positions, or unit frontages. It is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep174-bristoe-operation.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],"$L2c"]}]]}]
28:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","General-in-Chief, U.S. Army-Maj. Gen. Henry W. Halleck",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-Chief, U.S. Army"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Supervised the transfer of Army of the Potomac units toward Pope but lacked effective coordination with the field headquarters and railroad system"}]]}],["$","div","Army of Virginia-Maj. Gen. John Pope",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"Held the upper Rappahannock from the Warrenton area to Waterloo Bridge and interpreted Jackson’s movement as a march toward the Shenandoah Valley"}]]}],["$","div","I Corps, Army of Virginia-Maj. Gen. Franz Sigel",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Franz Sigel"}],["$","small",null,{"children":"Directed from the river line toward Fayetteville on August 25 in the episode’s account"}]]}],["$","div","II Corps, Army of Virginia-Maj. Gen. Nathaniel P. Banks",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Moved south past Bealeton toward Kelly’s Ford rather than toward Jackson at Salem"}]]}],["$","div","III Corps, Army of Virginia-Maj. Gen. Irvin McDowell",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Remained at Warrenton and was ordered to probe across White Sulphur Springs on August 26"}]]}],["$","div","III and V Corps, Army of the Potomac-Maj. Gens. Samuel P. Heintzelman and Fitz John Porter",{"className":"command-entry","children":[["$","strong",null,{"children":"III and V Corps, Army of the Potomac"}],["$","span",null,{"children":"Maj. Gens. Samuel P. Heintzelman and Fitz John Porter"}],["$","small",null,{"children":"Their arriving corps were within supporting distance but had not yet given Pope the full reinforcement strength he expected"}]]}],["$","div","U.S. Military Railroads in Virginia-Col. Herman Haupt",{"className":"command-entry","children":[["$","strong",null,{"children":"U.S. Military Railroads in Virginia"}],["$","span",null,{"children":"Col. Herman Haupt"}],["$","small",null,{"children":"Managed trains moving reinforcements and supplies through Alexandria amid competing demands and disrupted schedules"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],"$L2d","$L2e"]}],"$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36"]]}]]}],"$L37"]]]}]
29:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep174-flank-march.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep174-flank-march.svg","alt":"Generalized map of Jackson’s August 25 and 26 flank march from the upper Rappahannock through Salem and Thoroughfare Gap to Bristoe Station.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s column covered approximately 55 miles in two days to reach Pope’s railroad rear. Routes, positions, and distances are generalized; the map is not to scale."}]]}],["$","figure","/images/ep174-bristoe-operation.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep174-bristoe-operation.svg","alt":"Generalized diagram of the Bristoe Station railroad obstruction and the Confederate movement toward Manassas Junction.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Munford and Forno blocked the railroad at Bristoe while Trimble and Stuart moved toward Manassas Junction. The diagram is generalized and not to scale."}]]}],["$","figure","/images/ep174-hotchkiss-campaign-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep174-hotchkiss-campaign-map.jpg","alt":"Jedediah Hotchkiss manuscript map of Jackson’s operations around Manassas in late August and early September 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jedediah Hotchkiss mapped Jackson’s positions from August 26 through September 2. The manuscript shows the broader campaign geography extending beyond this episode."}]]}],["$","figure","/images/ep174-manassas-rolling-stock.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep174-manassas-rolling-stock.jpg","alt":"Soldiers beside damaged Orange and Alexandria Railroad rolling stock at Manassas Junction in August 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The Library of Congress dates Timothy H. O’Sullivan’s photograph of soldiers beside damaged Orange and Alexandria Railroad rolling stock to August 1862. The catalog record associates it with the Second Bull Run campaign but does not identify the precise damage event shown."}]]}],["$","figure","/images/ep174-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep174-stonewall-jackson.jpg","alt":"Carte-de-visite portrait of Confederate general Thomas J. Stonewall Jackson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson commanded the three-division column sent around Pope’s right and into the Federal railroad rear."}]]}],["$","figure","/images/ep174-john-pope.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep174-john-pope.jpg","alt":"Civil War glass-negative portrait of United States major general John Pope in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Pope remained along the Rappahannock on August 25 and 26 because he incorrectly assessed Jackson’s destination."}]]}]]}]]}]
