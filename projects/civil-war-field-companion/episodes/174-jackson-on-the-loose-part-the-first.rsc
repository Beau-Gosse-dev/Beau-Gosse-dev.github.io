46:["$","div","A stronger obstruction stops the next train",{"className":"moment","children":[["$","$L2e",null,{"seconds":1172,"label":"19:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"A stronger obstruction stops the next train"}],["$","p",null,{"children":"Confederates reinforce the barrier and fire at the locomotive from alongside the track; the train hits the obstruction and stops."}]]}]]}]
