11:["$","figure","Ships in Hampton Roads on March 8–9",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/hampton-roads-march-8-map.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Ships in Hampton Roads on March 8–9 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/hampton-roads-march-8-map.svg","alt":"Schematic map showing CSS Virginia’s March 8 route and USS Monitor arriving in Hampton Roads that night","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Ships in Hampton Roads on March 8–9"}],["$","span",null,{"children":"Blue shows Monitor entering from Chesapeake Bay and taking station near the grounded Minnesota. Red shows Virginia’s route from Gosport toward Cumberland and Congress on March 8. The next episode covers the March 9 duel."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/hampton-roads-march-8-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.history.navy.mil/browse-by-topic/wars-conflicts-and-operations/civil-war/cw-operations-and-engagements/1862-civil-war/hampton-roads.html","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode turns to the United States ironclad",{"className":"moment","children":[["$","$L17",null,{"seconds":69,"label":"1:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode turns to the United States ironclad"}],["$","p",null,{"children":"Reports of the Confederate Merrimack conversion convinced Secretary of the Navy Gideon Welles that the Hampton Roads squadron needed an armored warship."}]]}]]}],["$","div","The episode introduces Gideon Welles",{"className":"moment","children":[["$","$L17",null,{"seconds":135,"label":"2:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode introduces Gideon Welles"}],["$","p",null,{"children":"Welles came from Connecticut, worked in journalism and politics, and headed the Navy’s Bureau of Provisions and Clothing during the Mexican War."}]]}]]}],["$","div","Welles joined the Republican Party",{"className":"moment","children":[["$","$L17",null,{"seconds":186,"label":"3:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Welles joined the Republican Party"}],["$","p",null,{"children":"He broke with the Democratic Party over the Kansas–Nebraska Act, became a Republican candidate for governor, and helped Lincoln win the party’s 1860 presidential nomination."}]]}]]}],["$","div","Lincoln appointed Welles navy secretary",{"className":"moment","children":[["$","$L17",null,{"seconds":220,"label":"3:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln appointed Welles navy secretary"}],["$","p",null,{"children":"Welles entered the cabinet in March 1861 and remained secretary of the navy throughout the war."}]]}]]}],["$","div","Congress authorized three ironclads",{"className":"moment","children":[["$","$L17",null,{"seconds":276,"label":"4:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Congress authorized three ironclads"}],["$","p",null,{"children":"In August 1861, Congress provided $1.5 million. Welles appointed Hiram Paulding, Joseph Smith, and Charles H. Davis to evaluate designs."}]]}]]}],["$","div","The board reviewed sixteen proposals",{"className":"moment","children":[["$","$L17",null,{"seconds":294,"label":"4:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"The board reviewed sixteen proposals"}],["$","p",null,{"children":"The board initially selected two designs, including Samuel Pook’s proposal backed by Cornelius Bushnell."}]]}]]}],["$","div","The episode introduces John Ericsson",{"className":"moment","children":[["$","$L17",null,{"seconds":328,"label":"5:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode introduces John Ericsson"}],["$","p",null,{"children":"The Swedish-born engineer had served in the Swedish army, moved to England to work on steam propulsion, and developed a screw propeller."}]]}]]}],["$","div","The Princeton accident damaged Ericsson’s relationship with the Navy",{"className":"moment","children":[["$","$L17",null,{"seconds":360,"label":"6:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Princeton accident damaged Ericsson’s relationship with the Navy"}],["$","p",null,{"children":"Ericsson designed the ship’s machinery, but a cannon designed by Robert Stockton exploded during an 1844 demonstration. Ericsson was blamed despite having no responsibility for the gun."}]]}]]}],["$","div","Bushnell brought Ericsson’s design to Washington",{"className":"moment","children":[["$","$L17",null,{"seconds":413,"label":"6:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bushnell brought Ericsson’s design to Washington"}],["$","p",null,{"children":"Bushnell visited Ericsson for advice on Pook’s ship, saw Ericsson’s ironclad model, and persuaded him to let Welles and Lincoln examine it."}]]}]]}],["$","div","Lincoln supported the design",{"className":"moment","children":[["$","$L17",null,{"seconds":453,"label":"7:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln supported the design"}],["$","p",null,{"children":"Lincoln attended the Ironclad Board’s meeting and endorsed Ericsson’s proposal when naval officers questioned whether it would work."}]]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b"]}]]}]
