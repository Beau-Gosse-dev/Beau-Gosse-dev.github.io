":"Secretary of the Navy"}],["$","span",null,{"children":"Stephen R. Mallory"}],["$","small",null,{"children":"Directed the Confederate ironclad program"}]]}],["$","div","CSS Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"CSS Virginia"}],["$","span",null,{"children":"Catesby ap Roger Jones"}],["$","small",null,{"children":"Held command after Franklin Buchanan was wounded on March 8"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Gideon Welles",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/gideon-welles.jpg","alt":"Portrait of Gideon Welles","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Gideon Welles"}],["$","p",null,{"children":"United States secretary of the navy who created the Ironclad Board and approved rapid construction"}]]}]]}],["$","article","John Ericsson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/john-ericsson.jpg","alt":"Portrait of John Ericsson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John Ericsson"}],["$","p",null,{"children":"Engineer who designed Monitor, its machinery, and its rotating turret"}]]}]]}],["$","article","John L. Worden",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John L. Worden"}],["$","p",null,{"children":"Commanding officer who brought Monitor from New York to