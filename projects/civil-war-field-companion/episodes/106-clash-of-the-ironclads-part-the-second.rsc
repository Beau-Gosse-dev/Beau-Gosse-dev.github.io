e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Construction and destination"}],["$","span",null,{"children":"Monitor was built at Continental Iron Works in Greenpoint, Brooklyn, fitted out at the Brooklyn Navy Yard, and sent to Hampton Roads, Virginia. The direct distance is roughly 300 miles, but the voyage exposed the low-decked ship to Atlantic weather."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
f:["$","figure","Monitor’s maiden voyage",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/monitor-maiden-voyage-map.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Monitor’s maiden voyage at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/monitor-maiden-voyage-map.svg","alt":"Schematic map of USS Monitor traveling from Brooklyn past Sandy Hook and Atlantic City to Cape Charles, Cape Henry, and Hampton Roads","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Monitor’s maiden voyage"}],["$","span",null,{"children":"Monitor left New York on March 6 with the tug Seth Low and the gunboats Sachem and Currituck. A gale nearly sank the ironclad off the New Jersey and Delaware coasts. The group entered Chesapeake Bay and reached Hampton Roads on March 8."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/monitor-maiden-voyage-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://monitor.noaa.gov/150th/orders.html","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
