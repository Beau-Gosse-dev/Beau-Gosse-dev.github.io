d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",106," · ","August 1861–March 9, 1862"," · ","Washington, D.C.; Brooklyn, New York; the Atlantic coast; and Hampton Roads, Virginia"]}],["$","h1",null,{"children":"CLASH OF THE IRONCLADS (Part the Second)"}],["$","span",null,{"className":"result-label","children":"The United States Navy approved John Ericsson’s ironclad design, built USS Monitor in about 100 days, and commissioned the ship under John L. Worden. Monitor survived severe flooding and toxic fumes during its trip from New York and reached Hampton Roads on the night of March 8. It took position beside the grounded USS Minnesota before CSS Virginia returned the next morning"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"August 1861–March 9, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Washington, D.C.; Brooklyn, New York; the Atlantic coast; and Hampton Roads, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"The United States Navy approved John Ericsson’s ironclad design, built USS Monitor in about 100 days, and commissioned the ship under John L. Worden. Monitor survived severe flooding and toxic fumes during its trip from New York and reached Hampton Roads on the night of March 8. It took position beside the grounded USS Minnesota before CSS Virginia returned the next morning"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"August 1861–March 9, 1862","place":"Washington, D.C.; Brooklyn, New York; the Atlantic coast; and Hampton Roads, Virginia","result":"The United States Navy approved John Ericsson’s ironclad design, built USS Monitor in about 100 days, and commissioned the ship under John L. Worden. Monitor survived severe flooding and toxic fumes during its trip from New York and reached Hampton Roads on the night of March 8. It took position beside the grounded USS Minnesota before CSS Virginia returned the next morning","facts":[{"label":"Ironclad construction appropriation","value":"$$1.5 million for three ships"},{"label":"Ericsson contract signed","value":"October 4, 1861"},{"label":"Contract price","value":"$$275,000"},{"label":"Keel laid","value":"October 25, 1861"},{"label":"Launched","value":"January 30, 1862, after 98 days of construction"},{"label":"Commissioned","value":"February 25, 1862"},{"label":"Turret","value":"20 feet in diameter, 9 feet high, and protected by 8 inches of iron"},{"label":"Main armament","value":"Two 11-inch Dahlgren smoothbore guns"},{"label":"Freeboard","value":"The deck stood about 18 inches above the water"},{"label":"Top speed","value":"About 8 knots"}],"maps":[{"title":"Construction and destination","caption":"Monitor was built at Continental Iron Works in Greenpoint, Brooklyn, fitted out at the Brooklyn Navy Yard, and sent to Hampton Roads, Virginia. The direct distance is roughly 300 miles, but the voyage exposed the low-decked ship to Atlantic weather.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-77.8%2C36.3%2C-72.6%2C41.3&layer=mapnik&marker=36.987%2C-76.309"},{"title":"Monitor’s maiden voyage","caption":"Monitor left New York on March 6 with the tug Seth Low and the gunboats Sachem and Currituck. A gale nearly sank the ironclad off the New Jersey and Delaware coasts. The group entered Chesapeake Bay and reached Hampton Roads on March 8.","source":"https://monitor.noaa.gov/150th/orders.html","image":"/images/monitor-maiden-voyage-map.svg","alt":"Schematic map of USS Monitor traveling from Brooklyn past Sandy Hook and Atlantic City to Cape Charles, Cape Henry, and Hampton Roads"},{"title":"Hampton Roads before the duel","caption":"This 1862 reconnaissance map identifies the Elizabeth River, Norfolk and Portsmouth, Newport News, Fort Monroe, and the roadstead where Monitor anchored beside Minnesota.","source":"https://www.history.navy.mil/browse-by-topic/wars-conflicts-and-operations/civil-war/cw-operations-and-engagements/1862-civil-war/hampton-roads.html","image":"/images/hampton-roads-1862-map.jpg","alt":"1862 U.S. Army reconnaissance map of the Hampton Roads vicinity with military positions"},{"title":"Ships in Hampton Roads on March 8–9","caption":"Blue shows Monitor entering from Chesapeake Bay and taking station near the grounded Minnesota. Red shows Virginia’s route from Gosport toward Cumberland and Congress on March 8. The next episode covers the March 9 duel.","source":"https://www.history.navy.mil/browse-by-topic/wars-conflicts-and-operations/civil-war/cw-operations-and-engagements/1862-civil-war/hampton-roads.html","image":"/images/hampton-roads-march-8-map.svg","alt":"Schematic map showing CSS Virginia’s March 8 route and USS Monitor arriving in Hampton Roads that night"}],"moments":[{"time":"1:09","audioTime":69,"title":"The episode turns to the United States ironclad","detail":"Reports of the Confederate Merrimack conversion convinced Secretary of the Navy Gideon Welles that the Hampton Roads squadron needed an armored warship."},{"time":"2:15","audioTime":135,"title":"The episode introduces Gideon Welles","detail":"Welles came from Connecticut, worked in journalism and politics, and headed the Navy’s Bureau of Provisions and Clothing during the Mexican War."},{"time":"3:06","audioTime":186,"title":"Welles joined the Republican Party","detail":"He broke with the Democratic Party over the Kansas–Nebraska Act, became a Republican candidate for governor, and helped Lincoln win the party’s 1860 presidential nomination."},{"time":"3:40","audioTime":220,"title":"Lincoln appointed Welles navy secretary","detail":"Welles entered the cabinet in March 1861 and remained secretary of the navy throughout the war."},{"time":"4:36","audioTime":276,"title":"Congress authorized three ironclads","detail":"In August 1861, Congress provided $1.5 million. Welles appointed Hiram Paulding, Joseph Smith, and Charles H. Davis to evaluate designs."},{"time":"4:54","audioTime":294,"title":"The board reviewed sixteen proposals","detail":"The board initially selected two designs, including Samuel Pook’s proposal backed by Cornelius Bushnell."},{"time":"5:28","audioTime":328,"title":"The episode introduces John Ericsson","detail":"The Swedish-born engineer had served in the Swedish army, moved to England to work on steam propulsion, and developed a screw propeller."},{"time":"6:00","audioTime":360,"title":"The Princeton accident damaged Ericsson’s relationship with the Navy","detail":"Ericsson designed the ship’s machinery, but a cannon designed by Robert Stockton exploded during an 1844 demonstration. Ericsson was blamed despite having no responsibility for the gun."},{"time":"6:53","audioTime":413,"title":"Bushnell brought Ericsson’s design to Washington","detail":"Bushnell visited Ericsson for advice on Pook’s ship, saw Ericsson’s ironclad model, and persuaded him to let Welles and Lincoln examine it."},{"time":"7:33","audioTime":453,"title":"Lincoln supported the design","detail":"Lincoln attended the Ironclad Board’s meeting and endorsed Ericsson’s proposal when naval officers questioned whether it would work."},{"time":"8:02","audioTime":482,"title":"The board approved three different ships","detail":"Ericsson’s Monitor joined Pook’s USS Galena and the larger armored frigate USS New Ironsides in the construction program."},{"time":"8:12","audioTime":492,"title":"Monitor used two connected hulls","detail":"A low armored raft formed the visible upper hull while a deeper metal hull contained the machinery and living spaces."},{"time":"8:42","audioTime":522,"title":"A rotating turret carried both guns","detail":"The 120-ton turret was 20 feet wide and 9 feet high. Eight layers of one-inch plate protected two 11-inch Dahlgren guns, and steam machinery rotated it through 360 degrees."},{"time":"9:31","audioTime":571,"title":"Special carriages controlled the recoil","detail":"Each nearly eight-ton gun fired a 166-pound solid shot. Friction carriages stopped the recoil inside the confined turret."},{"time":"10:19","audioTime":619,"title":"Monitor had a very low profile","detail":"The ship’s deck stood about 18 inches above the waterline. Its shallow draft suited coastal and river operations but left it vulnerable in ocean waves."},{"time":"11:45","audioTime":705,"title":"The contract required rapid construction","detail":"Ericsson agreed to deliver a complete ship in 90 days and refund the $275,000 price if it was not a success, although the contract did not define success."},{"time":"13:06","audioTime":786,"title":"Construction began in October","detail":"Ericsson signed the contract on October 4 and the keel was laid at Continental Iron Works on October 25. Engines and the turret were built by separate New York firms."},{"time":"13:18","audioTime":798,"title":"Ericsson named the ship Monitor","detail":"He intended the name to describe a warning or instruction to the Confederacy and to foreign governments considering support for it."},{"time":"13:48","audioTime":828,"title":"Monitor launched after 98 days","detail":"The ship entered the East River on January 30, 1862, and floated at the draft Ericsson had predicted."},{"time":"15:23","audioTime":923,"title":"John Worden received command","detail":"Welles and Ironclad Board member Joseph Smith selected the 43-year-old lieutenant, a 27-year Navy veteran who had recently returned from Confederate imprisonment."},{"time":"16:28","audioTime":988,"title":"Worden received orders for Hampton Roads","detail":"After provisioning and trials at Brooklyn Navy Yard, Worden was ordered south on March 4. Weather delayed the departure for two days."},{"time":"17:01","audioTime":1021,"title":"Monitor left New York on March 6","detail":"The tug Seth Low towed the ironclad, and the gunboats Sachem and Currituck escorted it down the coast."},{"time":"18:10","audioTime":1090,"title":"A gale exposed serious leaks","detail":"On March 7, water entered around the turret base and through ventilation ducts. Wet drive belts stopped the ventilation fans."},{"time":"19:02","audioTime":1142,"title":"Toxic gases filled the engine room","detail":"With the fans stopped, carbon monoxide and other fumes accumulated. Engineers abandoned the machinery space, and the ship lost pumping capacity."},{"time":"19:36","audioTime":1176,"title":"The tow saved the ship","detail":"Worden signaled for help. Seth Low pulled Monitor toward calmer water, where engineers ventilated the ship, restarted the machinery, and pumped it dry."},{"time":"20:26","audioTime":1226,"title":"A steering failure created a second emergency","detail":"Loose tiller ropes left Monitor broadside to the waves. The crew repaired the steering in about half an hour."},{"time":"21:23","audioTime":1283,"title":"Monitor entered Chesapeake Bay on March 8","detail":"The crew sighted Cape Charles around noon, passed Cape Henry, and then saw flashes and heard the fighting in Hampton Roads."},{"time":"22:11","audioTime":1331,"title":"A pilot reported Virginia’s attack","detail":"A harbor pilot told the crew that CSS Virginia had destroyed or disabled ships in the blockading squadron."},{"time":"22:26","audioTime":1346,"title":"Monitor anchored near Roanoke","detail":"Monitor reached Hampton Roads around 9 p.m. while Congress was still burning. Congress’s magazine exploded after midnight."},{"time":"23:04","audioTime":1384,"title":"Monitor took position beside Minnesota","detail":"Worden was ordered to protect the grounded frigate. The exhausted crew prepared for Virginia to return on the morning of March 9."}],"command":[{"side":"United States","color":"#315f8c","branches":[{"commander":"Abraham Lincoln","command":"President of the United States","subordinates":"Supported Ericsson’s proposal before the Ironclad Board"},{"commander":"Gideon Welles","command":"Secretary of the Navy","subordinates":"Created the Ironclad Board and directed the armored-ship program"},{"commander":"Hiram Paulding, Joseph Smith, and Charles H. Davis","command":"Ironclad Board","subordinates":"Reviewed sixteen proposals and recommended Monitor, Galena, and New Ironsides"},{"commander":"John L. Worden","command":"USS Monitor","subordinates":"Led the maiden voyage; Samuel D. Greene served as executive officer"}]},{"side":"Confederacy","color":"#9a3d32","branches":[{"commander":"Jefferson Davis","command":"President of the Confederate States","subordinates":"National executive authority"},{"commander":"Stephen R. Mallory","command":"Secretary of the Navy","subordinates":"Directed the Confederate ironclad program"},{"commander":"Catesby ap Roger Jones","command":"CSS Virginia","subordinates":"Held command after Franklin Buchanan was wounded on March 8"}]}],"people":[{"name":"Gideon Welles","role":"United States secretary of the navy who created the Ironclad Board and approved rapid construction","side":"United States","image":"/images/gideon-welles.jpg","source":"https://www.loc.gov/pictures/item/2017895749/"},{"name":"John Ericsson","role":"Engineer who designed Monitor, its machinery, and its rotating turret","side":"United States","image":"/images/john-ericsson.jpg","source":"https://www.loc.gov/item/2021669476/"},{"name":"John L. Worden","role":"Commanding officer who brought Monitor from New York to Hampton Roads","side":"United States"},{"name":"Cornelius S. Bushnell","role":"Shipbuilder who brought Ericsson’s ironclad model to Welles, Lincoln, and the board","side":"United States"},{"name":"Samuel H. Pook","role":"Naval constructor whose separate ironclad design became USS Galena","side":"United States"},{"name":"Joseph Smith","role":"Ironclad Board member who helped select Worden to command Monitor","side":"United States"},{"name":"Abraham Lincoln","role":"Supported Ericsson’s proposal when the Ironclad Board expressed doubts","side":"United States"},{"name":"Samuel D. Greene","role":"Monitor’s executive officer during the voyage and the coming battle","side":"United States"}],"losses":[],"gallery":[{"image":"/images/uss-monitor-at-sea.jpg","alt":"USS Monitor at sea in an 1862 drawing","caption":"USS Monitor at sea. Its low deck and single revolving turret made it unlike conventional warships.","source":"https://www.history.navy.mil/browse-by-topic/wars-conflicts-and-operations/civil-war/cw-operations-and-engagements/1862-civil-war/hampton-roads.html"},{"image":"/images/uss-monitor-crew.jpg","alt":"Members of USS Monitor’s crew on deck near the turret in 1862","caption":"Members of Monitor’s crew on deck near the turret later in 1862. Most of the ship and all living spaces were below the waterline.","source":"https://www.loc.gov/item/2011646197/"},{"image":"/images/john-ericsson.jpg","alt":"Portrait of engineer John Ericsson","caption":"John Ericsson designed Monitor and coordinated construction among several New York contractors.","source":"https://www.loc.gov/item/2021669476/"},{"image":"/images/gideon-welles.jpg","alt":"Portrait of United States Secretary of the Navy Gideon Welles","caption":"Gideon Welles obtained congressional funding, appointed the Ironclad Board, and selected Monitor’s commander.","source":"https://www.loc.gov/pictures/item/2017895749/"}],"sources":[{"label":"Civil War Podcast episode 106","url":"https://civilwarpodcast.libsyn.com/106-clash-of-the-ironclads-part-the-second"},{"label":"NOAA Monitor National Marine Sanctuary: History of USS Monitor","url":"https://monitor.noaa.gov/about/history.html"},{"label":"NOAA Monitor National Marine Sanctuary: Orders and voyage","url":"https://monitor.noaa.gov/150th/orders.html"},{"label":"Naval History and Heritage Command: Monitor ship history","url":"https://www.history.navy.mil/research/histories/ship-histories/danfs/m/monitor-i.html"},{"label":"Naval History and Heritage Command: Hampton Roads","url":"https://www.history.navy.mil/browse-by-topic/wars-conflicts-and-operations/civil-war/cw-operations-and-engagements/1862-civil-war/hampton-roads.html"},{"label":"Library of Congress: Crew of Monitor","url":"https://www.loc.gov/item/2011646197/"},{"label":"Library of Congress: John Ericsson","url":"https://www.loc.gov/item/2021669476/"},{"label":"Library of Congress: Gideon Welles","url":"https://www.loc.gov/pictures/item/2017895749/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
