14:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/uss-monitor-at-sea.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/uss-monitor-at-sea.jpg","alt":"USS Monitor at sea in an 1862 drawing","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"USS Monitor at sea. Its low deck and single revolving turret made it unlike conventional warships."}]]}],["$","figure","/images/uss-monitor-crew.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/uss-monitor-crew.jpg","alt":"Members of USS Monitor’s crew on deck near the turret in 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Members of Monitor’s crew on deck near the turret later in 1862. Most of the ship and all living spaces were below the waterline."}]]}],["$","figure","/images/john-ericsson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/john-ericsson.jpg","alt":"Portrait of engineer John Ericsson","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"John Ericsson designed Monitor and coordinated construction among several New York contractors."}]]}],["$","figure","/images/gideon-welles.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/gideon-welles.jpg","alt":"Portrait of United States Secretary of the Navy Gideon Welles","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Gideon Welles obtained congressional funding, appointed the Ironclad Board, and selected Monitor’s commander."}]]}]]}]]}]
