16:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
18:["$","div","The board approved three different ships",{"className":"moment","children":[["$","$L17",null,{"seconds":482,"label":"8:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The board approved three different ships"}],["$","p",null,{"children":"Ericsson’s Monitor joined Pook’s USS Galena and the larger armored frigate USS New Ironsides in the construction program."}]]}]]}]
19:["$","div","Monitor used two connected hulls",{"className":"moment","children":[["$","$L17",null,{"seconds":492,"label":"8:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor used two connected hulls"}],["$","p",null,{"children":"A low armored raft formed the visible upper hull while a deeper metal hull contained the machinery and living spaces."}]]}]]}]
1a:["$","div","A rotating turret carried both guns",{"className":"moment","children":[["$","$L17",null,{"seconds":522,"label":"8:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"A rotating turret carried both guns"}],["$","p",null,{"children":"The 120-ton turret was 20 feet wide and 9 feet high. Eight layers of one-inch plate protected two 11-inch Dahlgren guns, and steam machinery rotated it through 360 degrees."}]]}]]}]
1b:["$","div","Special carriages controlled the recoil",{"className":"moment","children":[["$","$L17",null,{"seconds":571,"label":"9:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Special carriages controlled the recoil"}],["$","p",null,{"children":"Each nearly eight-ton gun fired a 166-pound solid shot. Friction carriages stopped the recoil inside the confined turret."}]]}]]}]
1c:["$","div","Monitor had a very low profile",{"className":"moment","children":[["$","$L17",null,{"seconds":619,"label":"10:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor had a very low profile"}],["$","p",null,{"children":"The ship’s deck stood about 18 inches above the waterline. Its shallow draft suited coastal and river operations but left it vulnerable in ocean waves."}]]}]]}]
1d:["$","div","The contract required rapid construction",{"className":"moment","children":[["$","$L17",null,{"seconds":705,"label":"11:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The contract required rapid construction"}],["$","p",null,{"children":"Ericsson agreed to deliver a complete ship in 90 days and refund the $275,000 price if it was not a success, although the contract did not define success."}]]}]]}]
1e:["$","div","Construction began in October",{"className":"moment","children":[["$","$L17",null,{"seconds":786,"label":"13:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Construction began in October"}],["$","p",null,{"children":"Ericsson signed the contract on October 4 and the keel was laid at Continental Iron Works on October 25. Engines and the turret were built by separate New York firms."}]]}]]}]
1f:["$","div","Ericsson named the ship Monitor",{"className":"moment","children":[["$","$L17",null,{"seconds":798,"label":"13:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ericsson named the ship Monitor"}],["$","p",null,{"children":"He intended the name to describe a warning or instruction to the Confederacy and to foreign governments considering support for it."}]]}]]}]
20:["$","div","Monitor launched after 98 days",{"className":"moment","children":[["$","$L17",null,{"seconds":828,"label":"13:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor launched after 98 days"}],["$","p",null,{"children":"The ship entered the East River on January 30, 1862, and floated at the draft Ericsson had predicted."}]]}]]}]
21:["$","div","John Worden received command",{"className":"moment","children":[["$","$L17",null,{"seconds":923,"label":"15:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"John Worden received command"}],["$","p",null,{"children":"Welles and Ironclad Board member Joseph Smith selected the 43-year-old lieutenant, a 27-year Navy veteran who had recently returned from Confederate imprisonment."}]]}]]}]
22:["$","div","Worden received orders for Hampton Roads",{"className":"moment","children":[["$","$L17",null,{"seconds":988,"label":"16:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Worden received orders for Hampton Roads"}],["$","p",null,{"children":"After provisioning and trials at Brooklyn Navy Yard, Worden was ordered south on March 4. Weather delayed the departure for two days."}]]}]]}]
23:["$","div","Monitor left New York on March 6",{"className":"moment","children":[["$","$L17",null,{"seconds":1021,"label":"17:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor left New York on March 6"}],["$","p",null,{"children":"The tug Seth Low towed the ironclad, and the gunboats Sachem and Currituck escorted it down the coast."}]]}]]}]
24:["$","div","A gale exposed serious leaks",{"className":"moment","children":[["$","$L17",null,{"seconds":1090,"label":"18:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"A gale exposed serious leaks"}],["$","p",null,{"children":"On March 7, water entered around the turret base and through ventilation ducts. Wet drive belts stopped the ventilation fans."}]]}]]}]
25:["$","div","Toxic gases filled the engine room",{"className":"moment","children":[["$","$L17",null,{"seconds":1142,"label":"19:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Toxic gases filled the engine room"}],["$","p",null,{"children":"With the fans stopped, carbon monoxide and other fumes accumulated. Engineers abandoned the machinery space, and the ship lost pumping capacity."}]]}]]}]
26:["$","div","The tow saved the ship",{"className":"moment","children":[["$","$L17",null,{"seconds":1176,"label":"19:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The tow saved the ship"}],["$","p",null,{"children":"Worden signaled for help. Seth Low pulled Monitor toward calmer water, where engineers ventilated the ship, restarted the machinery, and pumped it dry."}]]}]]}]
27:["$","div","A steering failure created a second emergency",{"className":"moment","children":[["$","$L17",null,{"seconds":1226,"label":"20:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"A steering failure created a second emergency"}],["$","p",null,{"children":"Loose tiller ropes left Monitor broadside to the waves. The crew repaired the steering in about half an hour."}]]}]]}]
28:["$","div","Monitor entered Chesapeake Bay on March 8",{"className":"moment","children":[["$","$L17",null,{"seconds":1283,"label":"21:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor entered Chesapeake Bay on March 8"}],["$","p",null,{"children":"The crew sighted Cape Charles around noon, passed Cape Henry, and then saw flashes and heard the fighting in Hampton Roads."}]]}]]}]
29:["$","div","A pilot reported Virginia’s attack",{"className":"moment","children":[["$","$L17",null,{"seconds":1331,"label":"22:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"A pilot reported Virginia’s attack"}],["$","p",null,{"children":"A harbor pilot told the crew that CSS Virginia had destroyed or disabled ships in the blockading squadron."}]]}]]}]
2a:["$","div","Monitor anchored near Roanoke",{"className":"moment","children":[["$","$L17",null,{"seconds":1346,"label":"22:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor anchored near Roanoke"}],["$","p",null,{"children":"Monitor reached Hampton Roads around 9 p.m. while Congress was still burning. Congress’s magazine exploded after midnight."}]]}]]}]
2b:["$","div","Monitor took position beside Minnesota",{"className":"moment","children":[["$","$L17",null,{"seconds":1384,"label":"23:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor took position beside Minnesota"}],["$","p",null,{"children":"Worden was ordered to protect the grounded frigate. The exhausted crew prepared for Virginia to return on the morning of March 9."}]]}]]}]
2c:["$","article","Samuel H. Pook",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"SH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Samuel H. Pook"}],["$","p",null,{"children":"Naval constructor whose separate ironclad design became USS Galena"}]]}]]}]
2d:["$","article","Joseph Smith",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JS"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Joseph Smith"}],["$","p",null,{"children":"Ironclad Board member who helped select Worden to command Monitor"}]]}]]}]
2e:["$","article","Abraham Lincoln",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Abraham Lincoln"}],["$","p",null,{"children":"Supported Ericsson’s proposal when the Ironclad Board expressed doubts"}]]}]]}]
2f:["$","article","Samuel D. Greene",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"SD"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Samuel D. Greene"}],["$","p",null,{"children":"Monitor’s executive officer during the voyage and the coming battle"}]]}]]}]
