1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",106," · ","August 1861–March 9, 1862"," · ","Washington, D.C.; Brooklyn, New York; the Atlantic coast; and Hampton Roads, Virginia"]}],["$","h1",null,{"children":"CLASH OF THE IRONCLADS (Part the Second)"}],["$","span",null,{"className":"result-label","children":"The United States Navy approved John Ericsson’s ironclad design, built USS Monitor in about 100 days, and commissioned the ship under John L. Worden. Monitor survived severe flooding and toxic fumes during its trip from New York and reached Hampton Roads on the night of March 8. It took position beside the grounded USS Minnesota before CSS Virginia returned the next morning"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7399464214.mp3?updated=1695129220","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Ironclad construction appropriation",{"children":[["$","span",null,{"children":"Ironclad construction appropriation"}],["$","strong",null,{"children":"$$1.5 million for three ships"}],"$undefined"]}],["$","div","Ericsson contract signed",{"children":[["$","span",null,{"children":"Ericsson contract signed"}],["$","strong",null,{"children":"October 4, 1861"}],"$undefined"]}],["$","div","Contract price",{"children":[["$","span",null,{"children":"Contract price"}],["$","strong",null,{"children":"$$275,000"}],"$undefined"]}],["$","div","Keel laid",{"children":[["$","span",null,{"children":"Keel laid"}],["$","strong",null,{"children":"October 25, 1861"}],"$undefined"]}],["$","div","Launched",{"children":[["$","span",null,{"children":"Launched"}],["$","strong",null,{"children":"January 30, 1862, after 98 days of construction"}],"$undefined"]}],["$","div","Commissioned",{"children":[["$","span",null,{"children":"Commissioned"}],["$","strong",null,{"children":"February 25, 1862"}],"$undefined"]}],["$","div","Turret",{"children":[["$","span",null,{"children":"Turret"}],["$","strong",null,{"children":"20 feet in diameter, 9 feet high, and protected by 8 inches of iron"}],"$undefined"]}],["$","div","Main armament",{"children":[["$","span",null,{"children":"Main armament"}],["$","strong",null,{"children":"Two 11-inch Dahlgren smoothbore guns"}],"$undefined"]}],["$","div","Freeboard",{"children":[["$","span",null,{"children":"Freeboard"}],["$","strong",null,{"children":"The deck stood about 18 inches above the water"}],"$undefined"]}],["$","div","Top speed",{"children":[["$","span",null,{"children":"Top speed"}],["$","strong",null,{"children":"About 8 knots"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","ch