d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",139," · ","April 22–November 5, 1861"," · ","Richmond and Harpers Ferry, Virginia; the northern Shenandoah Valley from Williamsport and Falling Waters through Martinsburg and Winchester; Ashby’s Gap and Piedmont; and Manassas Junction and Henry Hill, Virginia"]}],["$","h1",null,{"children":"STONEWALL JACKSON (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Jackson converted Virginia volunteers at Harpers Ferry into the First Virginia Brigade, served under Joseph E. Johnston, conducted a fighting withdrawal at Falling Waters, and led his brigade in Johnston’s rapid movement to Manassas. The brigade’s stand and counterattack on Henry Hill helped produce the Confederate victory at First Manassas and gave Jackson and the brigade the name “Stonewall.” Promoted to major general in October, Jackson left the brigade on November 4 and assumed independent command in the Shenandoah Valley at Winchester on November 5"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 22–November 5, 1861"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Richmond and Harpers Ferry, Virginia; the northern Shenandoah Valley from Williamsport and Falling Waters through Martinsburg and Winchester; Ashby’s Gap and Piedmont; and Manassas Junction and Henry Hill, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Jackson converted Virginia volunteers at Harpers Ferry into the First Virginia Brigade, served under Joseph E. Johnston, conducted a fighting withdrawal at Falling Waters, and led his brigade in Johnston’s rapid movement to Manassas. The brigade’s stand and counterattack on Henry Hill helped produce the Confederate victory at First Manassas and gave Jackson and the brigade the name “Stonewall.” Promoted to major general in October, Jackson left the brigade on November 4 and assumed independent command in the Shenandoah Valley at Winchester on November 5"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],false,false,"$Lf","$L10","$L11","$L12"]}],"$L13",false,false,"$L14","$L15","$L16","$L17","$L18","$L19"]}]]}]
