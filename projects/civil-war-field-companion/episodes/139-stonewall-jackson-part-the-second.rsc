1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",139," · ","April 22–November 5, 1861"," · ","Richmond and Harpers Ferry, Virginia; the northern Shenandoah Valley from Williamsport and Falling Waters through Martinsburg and Winchester; Ashby’s Gap and Piedmont; and Manassas Junction and Henry Hill, Virginia"]}],["$","h1",null,{"children":"STONEWALL JACKSON (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Jackson converted Virginia volunteers at Harpers Ferry into the First Virginia Brigade, served under Joseph E. Johnston, conducted a fighting withdrawal at Falling Waters, and led his brigade in Johnston’s rapid movement to Manassas. The brigade’s stand and counterattack on Henry Hill helped produce the Confederate victory at First Manassas and gave Jackson and the brigade the name “Stonewall.” Promoted to major general in October, Jackson left the brigade on November 4 and assumed independent command in the Shenandoah Valley at Winchester on November 5"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9074199719.mp3?updated=1695220167","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Jackson’s first six months of Civil War command"}],["$","small",null,{"children":"The narrative begins with his April 1861 Virginia commission and ends with his assumption of command at Winchester. First Manassas is summarized rather than retold in detail."}]]}],["$","div","Harpers Ferry command",{"children":[["$","span",null,{"children":"Harpers Ferry command"}],["$","strong",null,{"children":"Colonel of Virginia forces; arrived April 28, 1861"}],["$","small",null,{"children":"Jackson found an unorganized concentration of volunteers and militia and imposed drill, discipline, and a brigade structure. Sources differ by one day on whether his command technically began April 27 or April 28."}]]}],["$","div","Why Harpers Ferry mattered",{"children":[["$","span",null,{"children":"Why Harpers Ferry mattered"}],["$","strong",null,{"children":"Armory, railroad, canal, river crossings, and the northern entrance to the Valley"}],["$","small",null,{"children":"Its industrial and transportation value was considerable, but surrounding heights made the town itself difficult to defend against artillery."}]]}],["$","div","Maryland Heights",{"children":[["$","span",null,{"children":"Maryland Heights"}],["$","strong",null,{"children":"Jackson occupied the commanding height in May 1861"}],["$","small",null,{"children":"The National Park Service identifies this as one of Jackson’s earliest aggressive command decisions. It also created political risk because Maryland had not seceded."}]]}],["$","div","First Virginia Brigade",{"children":["$Le","$Lf","$L10"]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}],"$L20","$undefined","$L21",false,"$L22","$L23","$L24","$L25","$L26"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","span",null,{"children":"First Virginia Brigade"}]
f:["$","strong",null,{"children":"2nd, 4th, 5th, 27th, and 33rd Virginia Infantry with the Rockbridge Artillery"}]
10:["$","small",null,{"children":"The formation became the Stonewall Brigade after First Manassas. The episode concentrates on Jackson’s training and discipline rather than enumerating every regiment."}]
11:["$","div","B&O railroad seizure",{"children":[["$","span",null,{"children":"B&O railroad seizure"}],["$","strong",null,{"children":"The scale and method are disputed"}],["$","small",null,{"children":"The traditional Imboden story says Jackson manipulated train schedules and trapped 56 locomotives and more than 300 cars. The U.S. Army Center of Military History repeats the large seizure, but biographer James I. Robertson Jr., as the episode notes, rejected Imboden’s elaborate account for lack of contemporary documentation. Confederate interference with the B&O and seizures of railroad property are not in dispute."}]]}]
12:["$","div","Little Sorrel",{"children":[["$","span",null,{"children":"Little Sorrel"}],["$","strong",null,{"children":"Jackson’s small sorrel gelding and best-known wartime mount"}],["$","small",null,{"children":"The episode links the horse to railroad property seized near Harpers Ferry and says Jackson paid his quartermaster for it. The exact acquisition story depends on later recollections and should not be treated as fully documented."}]]}]
13:["$","div","Johnston takes command",{"children":[["$","span",null,{"children":"Johnston takes command"}],["$","strong",null,{"children":"May 23–24, 1861"}],["$","small",null,{"children":"The Army history dates Johnston’s assumption of command to May 23; Encyclopedia Virginia gives May 24. Jackson initially required written evidence of Johnston’s authority, then accepted command of the First Brigade under him."}]]}]
14:["$","div","Withdrawal from Harpers Ferry",{"children":[["$","span",null,{"children":"Withdrawal from Harpers Ferry"}],["$","strong",null,{"children":"June 14, 1861"}],["$","small",null,{"children":"Johnston considered Winchester more defensible and more important to the Valley. Confederate troops destroyed government and railroad property as they left."}]]}]
15:["$","div","Falling Waters / Hoke’s Run",{"children":[["$","span",null,{"children":"Falling Waters / Hoke’s Run"}],["$","strong",null,{"children":"July 2, 1861; United States tactical success"}],["$","small",null,{"children":"Jackson’s mission was to determine Patterson’s strength and retire if the United States force was substantial. His official report says he accomplished that mission and withdrew in order; the Army history describes Patterson as brushing the Confederates aside. Both descriptions fit a limited reconnaissance followed by a Confederate retreat."}]]}]
16:["$","div","Jackson’s force engaged",{"children":[["$","span",null,{"children":"Jackson’s force engaged"}],["$","strong",null,{"children":"380 men of the 5th Virginia and one artillery piece"}],["$","small",null,{"children":"Jackson’s official report says three of Pendleton’s four guns were left behind. Two additional regiments moved in support but did not enter the action."}]]}]
17:["$","div","Falling Waters losses",{"children":[["$","span",null,{"children":"Falling Waters losses"}],["$","strong",null,{"children":"Contemporary and later totals conflict"}],["$","small",null,{"children":"Jackson reported 11 wounded and 9 missing in the 5th Virginia, several of the missing believed dead; Stuart reported 1 wounded and 2 missing. He also claimed 49 United States prisoners. The episode’s rounded statement of about two dozen Confederate casualties and a similar United States total should not be combined with later, higher estimates as if they were one settled count."}]]}]
18:["$","div","Promotion to brigadier general",{"children":[["$","span",null,{"children":"Promotion to brigadier general"}],["$","strong",null,{"children":"Appointment dated June 17; news reached Jackson after Falling Waters"}],["$","small",null,{"children":"The episode places receipt of the commission a few days after the July 2 skirmish. The formal appointment date was earlier."}]]}]
19:["$","div","March to Piedmont",{"children":[["$","span",null,{"children":"March to Piedmont"}],["$","strong",null,{"children":"About 20 miles in 14 hours, July 18–19"}],["$","small",null,{"children":"The episode traces the brigade from Winchester through Millwood, a Shenandoah River ford, Ashby’s Gap, and Paris, followed by another six-mile march to the railroad at Piedmont."}]]}]
1a:["$","div","Rail movement to Manassas",{"children":[["$","span",null,{"children":"Rail movement to Manassas"}],["$","strong",null,{"children":"About 34 miles from Piedmont; Jackson arrived July 19"}],["$","small",null,{"children":"Johnston’s infantry used the Manassas Gap Railroad while cavalry and artillery moved overland. This concentration helped the two Confederate armies meet McDowell on July 21."}]]}]
1b:["$","div","First Manassas",{"children":[["$","span",null,{"children":"First Manassas"}],["$","strong",null,{"children":"Confederate victory, July 21, 1861"}],["$","small",null,{"children":"Jackson’s roughly 2,500 Virginians formed on Henry Hill. The episode emphasizes his initiative, the brigade’s stand, and its counterattack; the full battle was covered in earlier podcast episodes."}]]}]
1c:["$","div","“Stonewall” quotation",{"children":[["$","span",null,{"children":"“Stonewall” quotation"}],["$","strong",null,{"children":"Attributed to Brig. Gen. Barnard E. Bee Jr."}],["$","small",null,{"children":"The wording varies among accounts, and some contemporary evidence allows the remark to have been critical rather than purely complimentary. Bee was mortally wounded before he could explain it."}]]}]
1d:["$","div","Tactical ideas emphasized",{"children":[["$","span",null,{"children":"Tactical ideas emphasized"}],["$","strong",null,{"children":"Bayonet action, flank attacks, concentration, secrecy, and surprise"}],["$","small",null,{"children":"The episode presents Jackson’s preference for the bayonet as increasingly outdated against rifled muskets, while identifying flank attack and concentration against a weak point as more consequential parts of his method."}]]}]
1e:["$","div","Independent Valley command",{"children":[["$","span",null,{"children":"Independent Valley command"}],["$","strong",null,{"children":"Promoted October 7; assigned district command October 28; reached Winchester November 5"}],["$","small",null,{"children":"Jackson bid farewell to the First Brigade on November 4. The episode’s “6,000-square-mile district” is a descriptive estimate, not a surveyed administrative area."}]]}]
1f:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"Rebel Yell by S. C. Gwynne"}],["$","small",null,{"children":"The transcript renders the author’s surname incorrectly. The full title is Rebel Yell: The Violence, Passion, and Redemption of Stonewall Jackson."}]]}]
20:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
21:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Harpers Ferry, Falling Waters, and the Valley line",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep139-harpers-ferry-falling-waters.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Harpers Ferry, Falling Waters, and the Valley line at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep139-harpers-ferry-falling-waters.svg","alt":"Schematic map of Harpers Ferry, Winchester, Martinsburg, Falling Waters, and Patterson and Jackson movements on July 2, 1861","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Harpers Ferry, Falling Waters, and the Valley line"}],["$","span",null,{"children":"Jackson organized and drilled the First Virginia Brigade at Harpers Ferry before Johnston withdrew the army to Winchester. On July 2 Patterson crossed at Williamsport. Jackson advanced from near Martinsburg with the 5th Virginia and one gun, skirmished at Falling Waters, and retired through his forward camp toward Big Spring. Geography and movements are schematic; the map does not claim exact unit frontages."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep139-harpers-ferry-falling-waters.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-2.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$21:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The First Brigade moves from Winchester to Manassas",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep139-valley-to-manassas.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The First Brigade moves from Winchester to Manassas at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep139-valley-to-manassas.svg","alt":"Schematic map of Jackson’s July 18 and 19 forced march and rail movement from Winchester through Ashby’s Gap and Piedmont to Manassas Junction","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The First Brigade moves from Winchester to Manassas"}],["$","span",null,{"children":"On July 18 Jackson’s brigade led Johnston’s movement from Winchester to Millwood, forded the Shenandoah, crossed the Blue Ridge at Ashby’s Gap, and halted near Paris about 2 a.m. After reaching Piedmont on foot, the infantry traveled roughly 34 miles by the Manassas Gap Railroad and arrived at Manassas Junction on July 19. The route and distances are schematic."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep139-valley-to-manassas.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$21:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-2.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$21:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
22:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","General-in-Chief, United States Army-Lt. Gen. Winfield Scott",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-Chief, United States Army"}],["$","span",null,{"children":"Lt. Gen. Winfield Scott"}],["$","small",null,{"children":"Directed the separate forces under Patterson in the Shenandoah Valley and McDowell in northeastern Virginia"}]]}],["$","div","Army of the Shenandoah / Department of Pennsylvania-Maj. Gen. Robert Patterson",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Shenandoah / Department of Pennsylvania"}],["$","span",null,{"children":"Maj. Gen. Robert Patterson"}],["$","small",null,{"children":"Crossed from Williamsport on July 2 and drove toward Martinsburg; failed to prevent Johnston from leaving the Valley for Manassas"}]]}],["$","div","Lead brigade at Falling Waters-Brig. Gen. John J. Abercrombie",{"className":"command-entry","children":[["$","strong",null,{"children":"Lead brigade at Falling Waters"}],["$","span",null,{"children":"Brig. Gen. John J. Abercrombie"}],["$","small",null,{"children":"United States infantry and artillery pressed Jackson’s small force south from the Falling Waters area"}]]}],["$","div","Department of Northeastern Virginia-Brig. Gen. Irvin McDowell",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Northeastern Virginia"}],["$","span",null,{"children":"Brig. Gen. Irvin McDowell"}],["$","small",null,{"children":"Commanded the United States army defeated by Johnston and Beauregard at First Manassas"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Commander of Virginia forces-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander of Virginia forces"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Issued guidance to Jackson about Maryland and provided the written authority by which Johnston assumed command at Harpers Ferry"}]]}],["$","div","Army of the Shenandoah-Gen. Joseph E. Johnston",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Shenandoah"}],["$","span",null,{"children":"Gen. Joseph E. Johnston"}],["$","small",null,{"children":"Replaced Jackson at Harpers Ferry, withdrew to Winchester, ordered the reconnaissance at Falling Waters, and moved the army to Manassas"}]]}],["$","div","First Brigade, Army of the Shenandoah-Brig. Gen. Thomas J. Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"First Brigade, Army of the Shenandoah"}],["$","span",null,{"children":"Brig. Gen. Thomas J. Jackson"}],["$","small",null,{"children":"2nd, 4th, 5th, 27th, and 33rd Virginia Infantry and the Rockbridge Artillery; led the brigade until November 1861"}]]}],["$","div","5th Virginia Infantry at Falling Waters-Col. Kenton Harper",{"className":"command-entry","children":["$L27","$L28","$L29"]}],"$L2a","$L2b","$L2c"]]}]]}],"$L2d"]]]}]
23:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. Barnard E. Bee Jr.",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Barnard E. Bee Jr."}],["$","p",null,{"children":[["$","strong",null,{"children":["Third Brigade, Army of the Shenandoah","."]}]," ","Mortally wounded on Henry Hill at First Manassas on July 21, 1861. His reported comparison of Jackson to a stone wall became the source of Jackson’s enduring nickname."]}]]}],["$","article","Col. Francis S. Bartow",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Francis S. Bartow"}],["$","p",null,{"children":[["$","strong",null,{"children":["Second Brigade, Army of the Shenandoah","."]}]," ","Killed at First Manassas on July 21, 1861 while leading his brigade in the fighting associated with the Confederate defense and counterattack."]}]]}]]}]]}]
24:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep139-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep139-stonewall-jackson.jpg","alt":"Photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A wartime portrait of Jackson. During the six months covered here, he rose from a Virginia colonel commanding at Harpers Ferry to a Confederate major general with an independent Valley district."}]]}],["$","figure","/images/ep139-harpers-ferry-1861.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep139-harpers-ferry-1861.jpg","alt":"1861 photograph of Harpers Ferry after Confederate evacuation with the railroad bridge in ruins","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Harpers Ferry photographed in 1861 after the Confederate evacuation. The ruined railroad bridge shows the direct connection between the town’s geography, the B&O, and the destruction accompanying military withdrawal."}]]}],["$","figure","/images/ep139-first-manassas-lithograph.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep139-first-manassas-lithograph.jpg","alt":"Color lithograph of the Battle of Bull Run on July 21, 1861","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A contemporary popular lithograph of First Manassas, published in 1861. It is an artistic overview rather than a reliable tactical diagram. Jackson’s brigade fought on Henry Hill, where the Stonewall name originated."}]]}],["$","figure","/images/ep139-harpers-ferry-falling-waters.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep139-harper