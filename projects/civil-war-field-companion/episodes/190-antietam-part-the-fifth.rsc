16:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Ordered I Corps across Antietam Creek against Lee’s left and sent XII Corps to reinforce Hooker during the night"}]]}],["$","div","I Corps-Maj. Gen. Joseph Hooker",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps"}],["$","span",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","small",null,{"children":"Directed the crossing and southward advance, asked