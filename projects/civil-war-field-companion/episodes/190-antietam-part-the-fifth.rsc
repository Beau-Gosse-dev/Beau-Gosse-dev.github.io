32:["$","div","Battery C, 5th U.S. Artillery-Capt. Dunbar R. Ransom",{"className":"command-entry","children":[["$","strong",null,{"children":"Battery C, 5th U.S. Artillery"}],["$","span",null,{"children":"Capt. Dunbar R. Ransom"}],["$","small",null,{"children":"Opened an enfilading fire from the woods’ edge that drove the opposing battery to another position before darkness"}]]}]
33:["$","div","XII Corps-Maj. Gen. Joseph K. F. Mansfield",{"className":"command-entry","children":[["$","strong",null,{"children":"XII Corps"}],["$","span",null,{"children":"Maj. Gen. Joseph K. F. Mansfield"}],["$","small",null,{"children":"Crossed Antietam Creek near midnight and bivouacked north and rear of I Corps before the dawn battle"}]]}]
34:["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Reacted to Stuart’s warning by directing that Hood’s division move north to protect the army’s left"}]]}],["$","div","Confederate left wing-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate left wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Held responsibility for the northern battlefield and took operational control of Hood’s division after it shifted north"}]]}],["$","div","Confederate right wing-Maj. Gen. James Longstreet",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate right wing"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Received Lee’s direction to detach Hood from his normal command and send the division toward Jackson’s sector"}]]}],["$","div","Cavalry Division-Maj. Gen. J. E. B. Stuart",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry Division"}],["$","span",null,{"children":"Maj. Gen. J. E. B. Stuart"}],["$","small",null,{"children":"Used mounted sentries near the Upper Bridge to watch the Confederate left and passed word of Hooker’s crossing to Lee"}]]}],["$","div","Hood’s Division-Brig. Gen. John B. Hood",{"className":"command-entry","children":[["$","strong",null,{"children":"Hood’s Division"}],["$","span",null,{"children":"Brig. Gen. John B. Hood"}],["$","small",null,{"children":"Moved north from near Dunker Church, placed Wofford on the left and Law on the right, and sent skirmishers toward the Federal approach"}]]}],["$","div","Texa