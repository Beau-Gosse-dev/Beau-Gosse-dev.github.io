1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",190," · ","September 16–17, 1862"," · ","The northern Antietam battlefield between the Upper Bridge and Pry Ford, the Miller farm, Smoketown Road, and the East Woods north of Sharpsburg, Maryland"]}],["$","h1",null,{"children":"ANTIETAM (Part the Fifth)"}],["$","span",null,{"className":"result-label","children":"Joseph Hooker’s I Corps crossed Antietam Creek on September 16 and advanced against Robert E. Lee’s left. George G. Meade’s Pennsylvania Reserves fought John B. Hood’s Confederates around the East Woods until darkness. The United States troops retained an advanced foothold, Joseph K. F. Mansfield’s XII Corps crossed near midnight to support them, and both sides prepared to renew the battle at dawn"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4132935089.mp3?updated=1695462593","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The opening infantry fight at Antietam on Tuesday evening, September 16"}],["$","small",null,{"children":"The episode backtracks from the planned dawn attack to examine Hooker’s crossing, the East Woods skirmish, and the wet night before the main battle."}]]}],["$","div","Hooker’s orders",{"children":[["$","span",null,{"children":"Hooker’s orders"}],["$","strong",null,{"children":"Cross the Antietam, incline left, and feel for Lee’s left flank"}],["$","small",null,{"children":"Hooker received the order between 1 and 2 p.m. His official report says he was to attack the Confederate left; the episode emphasizes that McClellan supplied few additional details."}]]}],["$","div","I Corps strength",{"children":[["$","span",null,{"children":"I Corps strength"}],["$","strong",null,{"children":"About 12,000–13,000 in Hooker’s official report"}],["$","small",null,{"children":"Hooker told McClellan that his corps had already lost nearly 1,000 men at South Mountain and asked for prompt reinforcement."}]]}],["$","div","Crossing begins",{"children":[["$","span",null,{"children":"Crossing begins"}],["$","strong",null,{"children":"Hooker’s three divisions started across at about 4 p.m."}],["$","small",null,{"children":"The episode’s time is consistent with the Army staff-ride chronology, which places the crossing at approximately 3:30–4 p.m."}]]}],["$","div","Upper Bridge",{"children":[["$","span",null,{"children":"Upper Bridge"}],["$","strong",null,{"children":"George G. Meade’s and James B. Ricketts’s divisions crossed here"}],["$","small",null,{"children":"Meade’s Pennsylvania Reserves led the corps and then turned across country toward the Confederate left."}]]}],["$","div","Pry Ford",{"children":[["$","span",null,{"children":"Pry Ford"}],["$","strong",null,{"children":"Abner Doubleday’s division crossed just downstream"}],["$","small",null,{"children":"The ford had been located and improved during the approach to Sharpsburg. It is distinct from the Pry House, McClellan’s battlefield headquarters farther south."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}],"$L27","$undefined","$L28",false,"$L29","$L2a","$L2b","$L2c","$L2d"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Hooker’s approach",{"children":[["$","span",null,{"children":"Hooker’s approach"}],["$","strong",null,{"children":"Gain the divide, then incline south toward the Confederate flank"}],["$","small",null,{"children":"Meade advanced first. Hooker’s official report describes the initial direction as nearly perpendicular to Antietam Creek before the corps turned left."}]]}]
f:["$","div","Northern battlefield triangle",{"children":[["$","span",null,{"children":"Northern battlefield triangle"}],["$","strong",null,{"children":"Hagerstown Pike, Smoketown Road, and Dunker Church"}],["$","small",null,{"children":"The roads met near the church. The Miller cornfield occupied much of the ground between them, with the West Woods on the pike side and the East Woods along the Federal approach."}]]}]
10:["$","div","Miller’s cornfield",{"children":[["$","span",null,{"children":"Miller’s cornfield"}],["$","strong",null,{"children":"About 30 acres in the episode’s description"}],["$","small",null,{"children":"The field extended east from the Hagerstown Pike toward the East Woods and became the principal landmark of the next morning’s fighting."}]]}]
11:["$","div","Confederate warning",{"children":[["$","span",null,{"children":"Confederate warning"}],["$","strong",null,{"children":"J. E. B. Stuart’s mounted sentries detected Hooker’s movement"}],["$","small",null,{"children":"The episode traces the report from vedettes near the Upper Bridge to Stuart at Dunker Church, then to Lee, Longstreet, and Jackson in Sharpsburg."}]]}]
12:["$","div","Lee’s response",{"children":[["$","span",null,{"children":"Lee’s response"}],["$","strong",null,{"children":"John B. Hood’s division moved north to protect the army’s left"}],["$","small",null,{"children":"Lee directed Longstreet to send Hood. Once in the northern sector, Hood operated in Stonewall Jackson’s area of responsibility."}]]}]
13:["$","div","Hood’s command arrangement",{"children":[["$","span",null,{"children":"Hood’s command arrangement"}],["$","strong",null,{"children":"A Longstreet division temporarily taking orders from Jackson"}],["$","small",null,{"children":"Hood’s two brigades were commanded by Col. William T. Wofford and Col. Evander M. Law. The episode uses the transfer to illustrate Lee’s flexible battlefield command structure."}]]}]
14:["$","div","Hood’s initial line",{"children":[["$","span",null,{"children":"Hood’s initial line"}],["$","strong",null,{"children":"From Hagerstown Pike along the south edge of the cornfield into the East Woods"}],["$","small",null,{"children":"The exhausted division had been resting near Dunker Church before the long roll called it into line."}]]}]
15:["$","div","Condition of Hood’s men",{"children":[["$","span",null,{"children":"Condition of Hood’s men"}],["$","strong",null,{"children":"Fatigued, hungry, and living largely on corn and green apples"}],["$","small",null,{"children":"They had marched hard through the Maryland Campaign and had not received a proper meal. The episode connects the poor diet with widespread illness in the ranks."}]]}]
16:["$","div","Long-range Federal artillery",{"children":[["$","span",null,{"children":"Long-range Federal artillery"}],["$","strong",null,{"children":"Heavy guns fired from the high ground east of Antietam Creek"}],["$","small",null,{"children":"The episode identifies 20-pounder Parrott rifles in the Army of the Potomac’s artillery reserve near the Pry House. Their range allowed them to reach Hood’s movement north of Dunker Church."}]]}]
17:["$","div","Confederate skirmish screen",{"children":[["$","span",null,{"children":"Confederate skirmish screen"}],["$","strong",null,{"children":"About 100 men of the 4th Texas occupied a fence-line position"}],["$","small",null,{"children":"Hood sent skirmishers ahead of the main division. The episode places this detachment beyond the East Woods with a clear field of fire toward the approaching Federals."}]]}]
18:["$","div","Federal advance guard",{"children":[["$","span",null,{"children":"Federal advance guard"}],["$","strong",null,{"children":"The 13th Pennsylvania Reserves, the Bucktails"}],["$","small",null,{"children":"Hooker personally selected Col. Hugh W. McNeil’s regiment as skirmishers. Four companies led on both sides of Smoketown Road while six followed in support."}]]}]
19:["$","div","Bucktail equipment",{"children":[["$","span",null,{"children":"Bucktail equipment"}],["$","strong",null,{"children":"Sharps breech-loading rifles"}],["$","small",null,{"children":"The rifles could be loaded while the men lay prone, letting the regiment keep firing from shallow furrows as it crossed exposed ground."}]]}]
1a:["$","div","Contact",{"children":[["$","span",null,{"children":"Contact"}],["$","strong",null,{"children":"The 4th Texas opened fire at about 6 p.m."}],["$","small",null,{"children":"After roughly fifteen minutes of exchanging fire, McNeil ordered the Bucktails forward across the plowed field toward the fence."}]]}]
1b:["$","div","McNeil’s death",{"children":[["$","span",null,{"children":"McNeil’s death"}],["$","strong",null,{"children":"Killed while leading the final rush"}],["$","small",null,{"children":"The episode says McNeil was shot in the chest as he called the Bucktails forward. His men carried the fence and pursued the Confederate skirmishers into the East Woods."}]]}]
1c:["$","div","Bucktail losses in the episode",{"children":[["$","span",null,{"children":"Bucktail losses in the episode"}],["$","strong",null,{"children":"29 killed and 65 wounded during the evening advance"}],["$","small",null,{"children":"The episode attributes these figures to the movement across the open ground. Regimental and army returns often combine casualties from September 16 and 17, so totals vary by accounting method."}]]}]
1d:["$","div","Confederate counter",{"children":[["$","span",null,{"children":"Confederate counter"}],["$","strong",null,{"children":"5th Texas and 18th Georgia checked the Bucktails in the woods"}],["$","small",null,{"children":"Capt. Ike Turner led the 5th Texas forward as the 4th Texas fell back; the 18th Georgia advanced on its left."}]]}]
1e:["$","div","Seymour reinforces",{"children":[["$","span",null,{"children":"Seymour reinforces"}],["$","strong",null,{"children":"The rest of First Brigade secured a Federal foothold"}],["$","small",null,{"children":"Truman Seymour sent the 1st, 2nd, 5th, and 6th Pennsylvania Reserves forward after the Bucktails disappeared into the trees."}]]}]
1f:["$","div","Meade deploys the division",{"children":[["$","span",null,{"children":"Meade deploys the division"}],["$","strong",null,{"children":"Magilton’s and Anderson’s brigades moved up in support"}],["$","small",null,{"children":"Meade’s remaining brigades formed and advanced while Capt. Dunbar R. Ransom’s Battery C, 5th U.S. Artillery, enfiladed Confederate infantry and artillery near the cornfield."}]]}]
20:["$","div","End of the evening fight",{"children":[["$","span",null,{"children":"End of the evening fight"}],["$","strong",null,{"children":"Darkness stopped the organized musketry and cannon fire"}],["$","small",null,{"children":"The United States held part of the East Woods. Hood withdrew toward the West Woods, while the opposing pickets remained close enough to exchange fire through the damp night."}]]}]
21:["$","div","XII Corps reinforcement",{"children":[["$","span",null,{"children":"XII Corps reinforcement"}],["$","strong",null,{"children":"Mansfield crossed shortly before midnight"}],["$","small",null,{"children":"The corps moved into a supporting bivouac north and rear of Hooker. The episode places the end of its confused, rain-soaked night march at about 2 a.m."}]]}]
22:["$","div","Casualty reporting limit",{"children":[["$","span",null,{"children":"Casualty reporting limit"}],["$","strong",null,{"children":"No complete separate total survives for the September 16 clash"}],["$","small",null,{"children":"The episode explains that many Confederate reports merged losses from the evening and the next day. The guide therefore does not present a combined battlefield total for this preliminary action."}]]}]
23:["$","div","Contested interpretation",{"children":[["$","span",null,{"children":"Contested interpretation"}],["$","strong",null,{"children":"Did Hooker’s movement sacrifice surprise or draw troops north?"}],["$","small",null,{"children":"Longstreet and Stephen W. Sears argued that the crossing revealed the Federal approach. The hosts contend that it fit McClellan’s plan to pressure both flanks before striking Lee’s center. That defense is the episode’s interpretation, not a settled fact."}]]}]
24:["$","div","Important Confederate loss",{"children":[["$","span",null,{"children":"Important Confederate loss"}],["$","strong",null,{"children":"Col. Phillip F. Liddell, 11th Mississippi, mortally wounded"}],["$","small",null,{"children":"The transcript renders his name as “Philip Little.” Historical records identify Col. Phillip Frank Liddell, wounded on September 16 and dead at Shepherdstown on September 25."}]]}]
25:["$","div","Recommended field guide",{"children":[["$","span",null,{"children":"Recommended field guide"}],["$","strong",null,{"children":"“Antietam Expedition Guide” by TravelBrains and the History Channel"}],["$","small",null,{"children":"The hosts recommend the self-guided audio tour and accompanying booklet for a battlefield visit."}]]}]
26:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Liddell, Magilton, Pry Ford, Hagerstown Pike, Smoketown Road, Dunker Church, Sharps rifle, Parrott rifle, and Poffenberger"}],["$","small",null,{"children":"The automated transcript produces phonetic or variant forms including “Philip Little,” “Magelton,” “Sharp’s,” and “Parrot.” This guide uses standard historical spellings."}]]}]
27:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
28:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Hooker crosses and turns toward Lee’s left",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep190-hooker-crossing.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Hooker crosses and turns toward Lee’s left at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep190-hooker-crossing.svg","alt":"Schematic map showing Meade and Ricketts crossing the Upper Bridge, Doubleday crossing Pry Ford, Hooker turning south toward the East Woods, and Hood moving north from Dunker Church.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Hooker crosses and turns toward Lee’s left"}],["$","span",null,{"children":"Meade and Ricketts crossed the Upper Bridge while Doubleday used Pry Ford. Hooker first moved toward the divide west of Antietam Creek, then inclined south behind Meade. Stuart’s sentries detected the crossing, and Lee sent Hood north toward the cornfield and East Woods. Routes and positions are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep190-hooker-crossing.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History staff-ride guide, Hooker’s and Meade’s official reports, Antietam Battlefield Board atlas, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The evening fight at the East Woods",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep190-east-woods-evening.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The evening fight at the East Woods at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep190-east-woods-evening.svg","alt":"Schematic action map of the Bucktails advancing on Fourth Texas skirmishers, McNeil falling near the fence, Confederate reinforcements countering through the East Woods, and Seymour’s brigade securing a Federal foothold.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The evening fight at the East Woods"}],["$","span",null,{"children":"The Bucktails advanced toward 4th Texas skirmishers at a fence line, fought forward by short rushes, and lost Col. Hugh W. McNeil during the final advance. The 5th Texas and 18th Georgia countered, Seymour brought up the rest of his brigade, and Federal artillery enfiladed Confederate positions near the cornfield. Exact fence and unit footprints are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep190-east-woods-evening.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Meade’s official report, Antietam National Battlefield East Woods interpretation, U.S. Army Center of Military History, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2e"]}]]}],"$undefined"]}]]}],"$L2f","$L30"]}]]}]
29:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Ordered I Corps across Antietam Creek against Lee’s left and sent XII Corps to reinforce Hooker during the night"}]]}],["$","div","I Corps-Maj. Gen. Joseph Hooker",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps"}],["$","span",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","small",null,{"children":"Directed the crossing and southward advance, asked for reinforcement, and reported that he would renew the attack at dawn"}]]}],["$","div","First Division, I Corps-Brig. Gen. Abner Doubleday",{"className":"command-entry","children":[["$","strong",null,{"children":"First Division, I Corps"}],["$","span",null,{"children":"Brig. Gen. Abner Doubleday"}],["$","small",null,{"children":"Crossed at Pry Ford and advanced on the right of the other I Corps divisions"}]]}],["$","div","Second Division, I Corps-Brig. Gen. James B. Ricketts",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Division, I Corps"}],["$","span",null,{"children":"Brig. Gen. James B. Ricketts"}],["$","small",null,{"children":"Crossed at the Upper Bridge behind or beside Meade’s leading division"}]]}],["$","div","Third Division, I Corps · Pennsylvania Reserves-Brig. Gen. George G. Meade",{"className":"command-entry","children":[["$","strong",null,{"children":"Third Division, I Corps · Pennsylvania Reserves"}],["$","span",null,{"children":"Brig. Gen. George G. Meade"}],["$","small",null,{"children":"Led Hooker’s advance, deployed skirmishers toward the East Woods, and brought artillery and the remainder of the division forward"}]]}],["$","div","First Brigade, Meade’s Division-Brig. Gen. Truman Seymour",{"className":"command-entry","children":[["$","strong",null,{"children":"First Brigade, Meade’s Division"}],["$","span",null,{"children":"Brig. Gen. Truman Seymour"}],["$","small",null,{"children":"Supported the Bucktails with the 1st, 2nd, 5th, and 6th Pennsylvania Reserves and held the advanced East Woods position"}]]}],["$","div","13th Pennsylvania Reserves · First Pennsylvania Rifles · “Bucktails”-Col. Hugh W. McNeil",{"className":"command-entry","children":[["$","strong",null,{"children":"13th Pennsylvania Reserves · First Pennsylvania Rifles · “Bucktails”"}],["$","span",null,{"children":"Col. Hugh W. McNeil"}],["$","small",null,{"children":"Led the Federal skirmish line toward the fence and was killed while ordering the final advance"}]]}],["$","div","Second Brigade, Meade’s Division-Col. Albert L. Magilton",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Brigade, Meade’s Division"}],["$","span",null,{"children":"Col. Albert L. Magilton"}],["$","small",null,{"children":"Formed and advanced in support of Seymour as the fight expanded around the East Woods"}]]}],"$L31","$L32","$L33"]]}],"$L34"]}],"$L35"]]]}]
2a:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. Hugh W. McNeil",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. Hugh W. McNeil"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 13th Pennsylvania Reserves (First Pennsylvania Rifles or Bucktails)","."]}]," ","Shot in the chest and killed while calling the regiment forward near the East Woods on September 16; the Bucktails carried the contested fence line after he fell"]}]]}],["$","article","Col. Phillip F. Liddell",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Phillip F. Liddell"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 11th Mississippi Infantry, Law’s Brigade, Hood’s Division","."]}]," ","Mortally wounded while defending the Confederate line south of the East Woods on September 16; died at Shepherdstown on September 25, 1862"]}]]}]]}]]}]
2b:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep190-hooker-crossing.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep190-hooker-crossing.svg","alt":"Schematic map of Hooker’s I Corps crossing Antietam Creek and turning south toward Lee’s left.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Meade and Ricketts crossed at the Upper Bridge, Doubleday used Pry Ford, and the corps turned south. Stuart’s warning brought Hood north to meet the movement."}]]}],["$","figure","/images/ep190-east-woods-evening.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep190-east-woods-evening.svg","alt":"Schematic map of the September 16 evening action at the East Woods.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The Bucktails led the Federal approach against 4th Texas skirmishers. Confederate reinforcements checked their advance, while Seymour’s brigade and Federal artillery preserved a United States foothold as darkness fell."}]]}],["$","figure","/images/ep190-miller-farm-west-woods.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep190-miller-farm-west-woods.jpg","alt":"Alexander Gardner photograph of Union soldiers and Confederate dead on the Miller farm after Antietam.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Gardner’s September 19 view looks from the Miller farm toward the West Woods. It documents the terrain around the cornfield and woodlots after the battle; the fallen men make the image graphic."}]]}],["$","figure","/images/ep190-hooker-headquarters.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep190-hooker-headquarters.jpg","alt":"Alexander Gardner photograph of the building identified as Joseph Hooker’s Antietam headquarters.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This September 1862 glass-negative view records the headquarters associated with Hooker, the I Corps commander at the center of the episode."}]]}]]}]]}]
