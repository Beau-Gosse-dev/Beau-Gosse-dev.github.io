12:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2017/04/09/civil-war-podcast-episode-190/",{"href":"https://civilwarpodcast.org/2017/04/09/civil-war-podcast-episode-190/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 190 page"]}],["$","a","https://www.nps.gov/places/the-east-woods.htm",{"href":"https://www.nps.gov/places/the-east-woods.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: The East Woods"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/35-3-1.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/35-3-1.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Guide to the Battle of Antietam"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-6.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-6.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Maryland and Fredericksburg Campaigns, 1862–1863"]}],["$","a","https://ehistory.osu.edu/books/official-records/027",{"href":"https://ehistory.osu.edu/books/official-records/027","target":"_blank","rel":"noreferrer","children":[" · ","Official Records, Series I, Volume XIX, Part I: Maryland Campaign reports"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=19",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=19","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: George B. McClellan’s official campaign reports"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=246",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=246","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Joseph Hooker’s official report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=25",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=25","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: George G. Meade’s official report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=47",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=47","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Abner Doubleday’s official reports"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=31",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=31","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: John B. Hood’s official report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=26",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=26","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: James Longstreet’s official report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=99",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=99","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: William T. Wofford’s official report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=442",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=442","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Dunbar R. Ransom’s battery report"]}],["$","a","https://antietam.aotw.org/officers.php?officer_id=239",{"href":"https://antietam.aotw.org/officers.php?officer_id=239","target":"_blank","rel":"noreferrer","children":[" · ","Antietam on the Web: Col. Hugh Watson McNeil"]}],["$","a","https://antietam.aotw.org/officers.php?officer_id=535",{"href":"https://antietam.aotw.org/officers.php?officer_id=535","target":"_blank","rel":"noreferrer","children":[" · ","Antietam on the Web: Col. Phillip Frank Liddell"]}],"$L1c","$L1d","$L1e","$L1f"]}]
