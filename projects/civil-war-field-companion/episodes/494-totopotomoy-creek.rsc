19:["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Potomac approached the creek cautiously"}],["$","p",null,{"children":"Hancock and part of Warren’s corps neared Totopotomoy Creek while Wright remained farther north. Burnside and most of Warren’s corps were still near Haw’s Shop."}]]}]
1a:["$","div","Lee formed a line south of Totopotomoy Creek",{"className":"moment","children":[["$","$L18",null,{"seconds":984,"label":"16:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee formed a line south of Totopotomoy Creek"}],["$","p",null,{"children":"From west to east the line contained Hill, Breckinridge, Anderson, and the Second Corps under Jubal Early."}]]}]]}]
1b:["$","div","Early replaced Ewell",{"className":"moment","children":[["$","$L18",null,{"seconds":1077,"label":"17:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early replaced Ewell"}],["$","p",null,{"children":"Richard Ewell left because of illness on May 26. Lee made Early the temporary Second Corps commander and did not later return the corps to Ewell."}]]}]]}]
1c:["$","div","Lee identified the U.S. left as an opportunity",{"className":"moment","children":[["$","$L18",null,{"seconds":1234,"label":"20:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee identified the U.S. left as an opportunity"}],["$","p",null,{"children":"When VI Corps left the Hanover Court House area, Lee concluded that Grant would move southeast. He authorized Early to attack Warren if the chance looked favorable."}]]}]]}]
1d:["$","div","Early shifted his corps toward Bethesda Church",{"className":"moment","children":[["$","$L18",null,{"seconds":1314,"label":"21:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early shifted his corps toward Bethesda Church"}],["$","p",null,{"children":"Rodes led the march, followed by Ramseur and Gordon, using new military roads from Shady Grove Church Road toward Old Church Road."}]]}]]}]
1e:["$","div","Rodes broke the first U.S. positions",{"className":"moment","children":[["$","$L18",null,{"seconds":1346,"label":"22:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rodes broke the first U.S. positions"}],["$","p",null,{"children":"George Doles’s brigade struck west of Bethesda Church. Rodes drove back a skirmish line, a full brigade, and two brigades of Samuel Crawford’s division."}]]}]]}]
1f:["$","div","Warren restored the Fifth Corps line",{"className":"moment","children":[["$","$L18",null,{"seconds":1418,"label":"23:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Warren restored the Fifth Corps line"}],["$","p",null,{"children":"U.S. artillery and arriving infantry stopped the Confederate advance. Early lacked enough troops on the field to exploit the initial retreat."}]]}]]}]
20:["$","div","The planned flank attack was not coordinated",{"className":"moment","children":[["$","$L18",null,{"seconds":1471,"label":"24:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"The planned flank attack was not coordinated"}],["$","p",null,{"children":"Early wanted Anderson to advance along Old Church Road against Warren’s flank. Communications failed, Anderson did not make the supporting movement, and Early waited."}]]}]]}]
21:["$","div","Willis attacked the U.S. guns",{"className":"moment","children":[["$","$L18",null,{"seconds":1494,"label":"24:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Willis attacked the U.S. guns"}],["$","p",null,{"children":"Edward Willis’s brigade cleared one battery, then came under canister from three more batteries and rifle fire from Pennsylvania infantry."}]]}]]}]
22:["$","div","Willis was mortally wounded",{"className":"moment","children":[["$","$L18",null,{"seconds":1547,"label":"25:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Willis was mortally wounded"}],["$","p",null,{"children":"His brigade reached within about fifty yards of the U.S. line but suffered casualties approaching sixty percent. Hundreds surrendered after the attack stopped."}]]}]]}]
23:["$","div","Hancock demonstrated along the creek",{"className":"moment","children":[["$","$L18",null,{"seconds":1645,"label":"27:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock demonstrated along the creek"}],["$","p",null,{"children":"Grant ordered attacks to reduce pressure on Warren. Hancock’s three divisions advanced near dark, gained little ground, and withdrew after about thirty minutes."}]]}]]}]
24:["$","div","Cavalry fought near Old Cold Harbor",{"className":"moment","children":[["$","$L18",null,{"seconds":1710,"label":"28:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cavalry fought near Old Cold Harbor"}],["$","p",null,{"children":"Matthew Butler’s Confederate brigade moved northeast and met Alfred Torbert’s cavalry near Matadequin Creek, threatening the U.S. route to White House Landing."}]]}]]}]
25:["$","div","Torbert drove Butler back",{"className":"moment","children":[["$","$L18",null,{"seconds":1741,"label":"29:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Torbert drove Butler back"}],["$","p",null,{"children":"Torbert committed all three brigades of his division against Butler’s one and pursued the Confederates nearly to the Cold Harbor crossroads."}]]}]]}]
26:["$","div","Grant chose another southeastern movement",{"className":"moment","children":[["$","$L18",null,{"seconds":1768,"label":"29:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant chose another southeastern movement"}],["$","p",null,{"children":"The Totopotomoy line was too strong for a direct attack. Grant ordered Sheridan to clear the route for Smith and prepared to move around Lee’s right."}]]}]]}]
27:["$","div","Smith added a fifth U.S. infantry corps",{"className":"moment","children":[["$","$L18",null,{"seconds":1852,"label":"30:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith added a fifth U.S. infantry corps"}],["$","p",null,{"children":"About 10,000 XVIII Corps troops had begun landing at White House. Their arrival increased the pressure on Lee’s three infantry corps."}]]}]]}]
28:["$","div","Lee warned that delay would cause disaster",{"className":"moment","children":[["$","$L18",null,{"seconds":1881,"label":"31:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee warned that delay would cause disaster"}],["$","p",null,{"children":"Lee bypassed normal procedure and asked Beauregard directly for reinforcements, then told Davis that Smith would reach Grant before Hoke’s division could arrive."}]]}]]}]
29:["$","div","Hoke’s division received orders to join Lee",{"className":"moment","children":[["$","$L18",null,{"seconds":1950,"label":"32:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hoke’s division received orders to join Lee"}],["$","p",null,{"children":"Davis ordered Beauregard to send troops. Beauregard had already reconsidered and issued the transfer shortly before the government order arrived."}]]}]]}]
