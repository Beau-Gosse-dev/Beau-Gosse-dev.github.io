10:["$","figure","The Totopotomoy battlefield today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.52%2C37.61%2C-77.24%2C37.79&layer=mapnik&marker=37.6777%2C-77.3344","title":"The Totopotomoy battlefield today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Totopotomoy battlefield today"}],["$","span",null,{"children":"Rural Plains stands near the center of the creek line. Bethesda Church and Shady Grove Road marked the open U.S. left where Early attacked Warren on May 30."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
11:["$","figure","From the Pamunkey crossings toward Richmond",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.63%2C37.50%2C-76.98%2C38.02&layer=mapnik&marker=37.6777%2C-77.3344","title":"From the Pamunkey crossings toward Richmond","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From the Pamunkey crossings toward Richmond"}],["$","span",null,{"children":"Grant crossed the Pamunkey north and east of the battlefield, then advanced southwest. Lee’s army occupied shorter interior routes between the creek and Richmond."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Haw’s Shop clarified the armies’ locations",{"className":"moment","children":[["$","$L18",null,{"seconds":98,"label":"1:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Haw’s Shop clarified the armies’ locations"}],["$","p",null,{"children":"Confederate prisoners showed Sheridan where Anderson and Ewell were positioned. U.S. prisoners confirmed to Wade Hampton that V and VI Corps had crossed the Pamunkey."}]]}]]}],["$","div","Lee reported an incomplete picture",{"className":"moment","children":[["$","$L18",null,{"seconds":147,"label":"2:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee reported an incomplete picture"}],["$","p",null,{"children":"Lee told Secretary of War James Seddon that Grant appeared to be concentrating near Hanovertown, but he did not yet know the exact U.S. position or strength."}]]}]]}],["$","div","Grant had three possible routes",{"className":"moment","children":[["$","$L18",null,{"seconds":215,"label":"3:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant had three possible routes"}],["$","p",null,{"children":"The U.S. Army could move northwest toward the Virginia Central Railroad, southeast around Lee’s right, or directly against the Confederate line at Totopotomoy Creek."}]]}]]}],["$","div","Lee had little room left to maneuver",{"className":"moment","children":[["$","$L18",null,{"seconds":252,"label":"4:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee had little room left to maneuver"}],["$","p",null,{"children":"Richmond was about nine miles behind the Confederate position. A successful flank movement or breakthrough threatened the capital."}]]}]]}],["$","div","Lee sought troops from Bermuda Hundred",{"className":"moment","children":[["$","$L18",null,{"seconds":320,"label":"5:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee sought troops from Bermuda Hundred"}],["$","p",null,{"children":"Breckinridge, Pickett, and one Hoke brigade had joined the army, but Lee still faced greater U.S. numbers. He asked for more of Beauregard’s force."}]]}]]}],["$","div","Davis rejected Beauregard’s earlier combined plan",{"className":"moment","children":[["$","$L18",null,{"seconds":402,"label":"6:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis rejected Beauregard’s earlier combined plan"}],["$","p",null,{"children":"Beauregard had proposed joining Lee for a concentrated blow after Lee withdrew behind the Chickahominy. Davis considered the plan too risky and Beauregard remained reluctant to release troops."}]]}]]}],["$","div","Beauregard initially refused the request",{"className":"moment","children":[["$","$L18",null,{"seconds":567,"label":"9:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Beauregard initially refused the request"}],["$","p",null,{"children":"He reported that moving troops away from Bermuda Hundred could expose Richmond and its rail connections to Butler’s Army of the James."}]]}]]}],["$","div","Grant removed troops from Butler instead",{"className":"moment","children":[["$","$L18",null,{"seconds":669,"label":"11:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant removed troops from Butler instead"}],["$","p",null,{"children":"A War Department inspection found that about 10,000 men could hold the Bermuda Hundred lines. Grant ordered William F. Smith’s XVIII Corps to join the Army of the Potomac."}]]}]]}],["$","div","Smith boarded transports",{"className":"moment","children":[["$","$L18",null,{"seconds":845,"label":"14:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith boarded transports"}],["$","p",null,{"children":"On May 28 sufficient vessels arrived before Butler could begin a Petersburg operation. Smith’s command started moving around the Virginia Peninsula to White House Landing."}]]}]]}],["$","div","The Army of the Potomac approached the creek cautiously",{"className":"moment","children":[["$","$L18",null,{"seconds":929,"label":"15:29"}],"$L19"]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
