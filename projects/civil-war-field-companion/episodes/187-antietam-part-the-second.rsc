33:["$","figure","William H. Willcox’s 1862 battlefield map",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep187-willcox-antietam-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open William H. Willcox’s 1862 battlefield map at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep187-willcox-antietam-map.jpg","alt":"William H. Willcox’s detailed 1862 map of the Antietam battlefield around Sharpsburg, showing roads, Antietam Creek, buildings, field boundaries, and troop positions.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"William H. Willcox’s 1862 battlefield map"}],["$","span",null,{"children":"Prepared by a topographical officer on Abner Doubleday’s staff, this participant-era map records the roads, buildings, fences, vegetation, drainage, and troop positions around Sharpsburg. It depicts the September 17 battle rather than the incomplete concentration on September 15, but preserves the terrain and road network that shaped both armies’ approach."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep187-willcox-antietam-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2b:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Geography and Map Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2b:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
35:["$","div","Hill counts about 3,000 muskets",{"className":"moment","children":[["$","$L34",null,{"seconds":732,"label":"12:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hill counts about 3,000 muskets"}],["$","p",null,{"children":"His surviving infantry is weak, but divisional and reserve artillery gives the position substantial gun support."}]]}]]}]
36:["$","div","Longstreet waits for the trains",{"className":"moment","children":[["$","$L34",null,{"seconds":751,"label":"12:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet waits for the trains"}],["$","p",null,{"children":"D. R. Jones’s and Hood’s divisions cannot begin the withdrawal until the army wagons clear the South Mountain roads."}]]}]]}]
37:["$","div","Carman describes disorder and straggling",{"className":"moment","children":[["$","$L34",null,{"seconds":804,"label":"13:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Carman describes disorder and straggling"}],["$","p",null,{"children":"The Confederate retreat succeeds, but exhaustion and the hard march cost Longstreet many men from the ranks."}]]}]]}]
38:["$","div","Lee has about 15,000 men at Sharpsburg",{"className":"moment","children":[["$","$L34",null,{"seconds":828,"label":"13:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee has about 15,000 men at Sharpsburg"}],["$","p",null,{"children":"Most Confederate brigades remain near Harpers Ferry, leaving the temporary line badly outnumbered."}]]}]]}]
39:["$","div","Hunger and physical collapse thin the army",{"className":"moment","children":[["$","$L34",null,{"seconds":882,"label":"14:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hunger and physical collapse thin the army"}],["$","p",null,{"children":"The episode uses W. B. Judkins’s search for fruit to show how poor food, diarrhea, bare feet, and fatigue affected Confederate strength."}]]}]]}]
3a:["$","div","Lee trusts his veterans",{"className":"moment","children":[["$","$L34",null,{"seconds":952,"label":"15:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee trusts his veterans"}],["$","p",null,{"children":"Despite the army’s physical condition, Lee believes its combat experience and senior leadership can withstand the Federal pursuit."}]]}]]}]
3b:["$","div","Lee expects McClellan to become cautious",{"className":"moment","children":[["$","$L34",null,{"seconds":999,"label":"16:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee expects McClellan to become cautious"}],["$","p",null,{"children":"He treats the Union attack at South Mountain as uncharacteristic and assumes McClellan will hesitate before the new position."}]]}]]}]
3c:["$","div","Jackson confirms the surrender",{"className":"moment","children":[["$","$L34",null,{"seconds":1039,"label":"17:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson confirms the surrender"}],["$","p",null,{"children":"A second message around noon strengthens Lee’s decision to remain until the detached formations arrive."}]]}]]}]
3d:["$","div","The episode states Lee’s larger motive",{"className":"moment","children":[["$","$L34",null,{"seconds":1083,"label":"18:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode states Lee’s larger motive"}],["$","p",null,{"children":"Lee still wants a battle with strategic value and accepts a defensive contest as the remaining way to salvage the campaign."}]]}]]}]
3e:["$","div","Federal pursuit begins at first light",{"className":"moment","children":[["$","$L34",null,{"seconds":1207,"label":"20:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal pursuit begins at first light"}],["$","p",null,{"children":"Skirmishers find the South Mountain gaps abandoned, and McClellan orders I, II, XII, IX, and part of V Corps forward on two roads."}]]}]]}]
3f:["$","div","A burial party uses the Wise farm well",{"className":"moment","children":[["$","$L34",null,{"seconds":1299,"label":"21:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"A burial party uses the Wise farm well"}],["$","p",null,{"children":"Fifty-eight Confederate dead are placed in the well as Federal troops move over the previous day’s battlefield."}]]}]]}]
40:["$","div","False reports inflate the Federal success",{"className":"moment","children":[["$","$L34",null,{"seconds":1326,"label":"22:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"False reports inflate the Federal success"}],["$","p",null,{"children":"McClellan receives and forwards claims that Lee is wounded and that Confederate losses reached 15,000."}]]}]]}]
41:["$","div","Lincoln urges destruction of Lee’s army",{"className":"moment","children":[["$","$L34",null,{"seconds":1360,"label":"22:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln urges destruction of Lee’s army"}],["$","p",null,{"children":"The president responds to McClellan’s optimistic telegram from the War Department telegraph office."}]]}]]}]
42:["$","div","McClellan celebrates South Mountain",{"className":"moment","children":[["$","$L34",null,{"seconds":1412,"label":"23:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan celebrates South Mountain"}],["$","p",null,{"children":"The victory strengthens his confidence and his sense that he has answered political and professional critics."}]]}]]}]
43:["$","div","McClellan sends Winfield Scott a pointed message",{"className":"moment","children":[["$","$L34",null,{"seconds":1497,"label":"24:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan sends Winfield Scott a pointed message"}],["$","p",null,{"children":"He emphasizes that the defeated army had Robert E. Lee in command, giving the campaign a personal significance."}]]}]]}]
44:["$","div","The Army of the Potomac advances in high spirits",{"className":"moment","children":[["$","$L34",null,{"seconds":1584,"label":"26:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Potomac advances in high spirits"}],["$","p",null,{"children":"Federal troops see Confederate stragglers and experience the rare morale lift of marching beyond a battlefield they won."}]]}]]}]
45:["$","div","Raw recruits make up about one-fourth of the army",{"className":"moment","children":[["$","$L34",null,{"seconds":1623,"label":"27:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Raw recruits make up about one-fourth of the army"}],["$","p",null,{"children":"The episode counts about 15,000 men in new regiments and 5,000 recent replacements who lack battle experience."}]]}]]}]
46:["$","div","The Federal army is a patchwork force",{"className":"moment","children":[["$","$L34",null,{"seconds":1682,"label":"28:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Federal army is a patchwork force"}],["$","p",null,{"children":"Peninsula veterans, former Army of Virginia corps, Burnside’s expeditionary troops, and the Kanawha Division now operate under McClellan."}]]}]]}]
47:["$","div","McClellan remains behind the advance",{"className":"moment","children":[["$","$L34",null,{"seconds":1744,"label":"29:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan remains behind the advance"}],["$","p",null,{"children":"He leaves headquarters around midday and catches the vanguard west of Keedysville rather than pressing immediately toward the creek."}]]}]]}]
48:["$","div","The reconnaissance begins at 3 p.m.",{"className":"moment","children":[["$","$L34",null,{"seconds":1800,"label":"30:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The reconnaissance begins at 3 p.m."}],["$","p",null,{"children":"McClellan and Porter examine the Confederate line after enemy artillery disperses the larger mounted party."}]]}]]}]
49:["$","div","McClellan says it is too late to attack",{"className":"moment","children":[["$","$L34",null,{"seconds":1829,"label":"30:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan says it is too late to attack"}],["$","p",null,{"children":"His official explanation ends the possibility of a general assault on September 15."}]]}]]}]
4a:["$","div","The temporary imbalance is measured",{"className":"moment","children":[["$","$L34",null,{"seconds":1867,"label":"31:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"The temporary imbalance is measured"}],["$","p",null,{"children":"The episode contrasts Lee’s estimated 15,000 with more than twice that number immediately available to McClellan."}]]}]]}]
4b:["$","div","Lee’s visible stand creates uncertainty",{"className":"moment","children":[["$","$L34",null,{"seconds":1901,"label":"31:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s visible stand creates uncertainty"}],["$","p",null,{"children":"McClellan expected a rear guard protecting a retreat but instead found the Confederate commander deployed in apparent strength."}]]}]]}]
4c:["$","div","The episode’s map recommendations are given",{"className":"moment","children":[["$","$L34",null,{"seconds":1971,"label":"32:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode’s map recommendations are given"}],["$","p",null,{"children":"The hosts recommend Bradley M. Gottfried’s “The Maps of Antietam” and the McElfresh Antietam battlefield map."}]]}]]}]
4d:["$","div","Jackson’s command at Harpers Ferry-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Jackson’s command at Harpers Ferry"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Reported the imminent surrender and then its completion; left A. P. Hill to process the capitulation and began marching the rest of his immediate command toward Sharpsburg"}]]}]
4e:["$","div","Detached commands around Harpers Ferry-Maj. Gen. Lafayette McLaws and Brig. Gen. John G. Walker",{"className":"command-entry","children":[["$","strong",null,{"children":"Detached commands around Harpers Ferry"}],["$","span",null,{"children":"Maj. Gen. Lafayette McLaws and Brig. Gen. John G. Walker"}],["$","small",null,{"children":"Received orders to hurry toward Sharpsburg after the surrender. McLaws escaped Pleasant Valley by returning through Harpers Ferry"}]]}]
4f:["$","div","Light Division-Maj. Gen. A. P. Hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Light Division"}],["$","span",null,{"children":"Maj. Gen. A. P. Hill"}],["$","small",null,{"children":"Remained temporarily at Harpers Ferry to receive prisoners and secure captured property while other Confederate formations began concentrating with Lee"}]]}]
