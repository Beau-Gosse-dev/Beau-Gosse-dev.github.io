1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",187," · ","September 14–15, 1862"," · ","From Turner’s and Fox’s Gaps across Boonsboro and Keedysville to the Antietam Creek valley and Sharpsburg, Maryland, with the Confederate escape route running south to Boteler’s Ford on the Potomac River"]}],["$","h1",null,{"children":"ANTIETAM (Part the Second)"}],["$","span",null,{"className":"result-label","children":"No general engagement occurred on September 15. Robert E. Lee halted behind Antietam Creek with about 15,000 men then present, while George B. McClellan brought more than twice that number to the opposite side of the creek but deferred an attack. The pause allowed Confederate formations leaving Harpers Ferry to begin rejoining Lee before the Battle of Antietam"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3134417189.mp3?updated=1695462524","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The ground at Sharpsburg and the opposing movements on September 15"}],["$","small",null,{"children":"The episode explains why Lee stood at Sharpsburg, follows the Confederate retreat from South Mountain, and traces McClellan’s pursuit to Antietam Creek. It ends before the September 16 preliminary fighting and the main battle on September 17."}]]}],["$","div","Campaign turning point",{"children":[["$","span",null,{"children":"Campaign turning point"}],["$","strong",null,{"children":"Harpers Ferry surrendered on the morning of September 15"}],["$","small",null,{"children":"Jackson’s first message that the surrender was imminent, followed by confirmation around noon, persuaded Lee that most of the detached Confederate army could soon concentrate at Sharpsburg."}]]}],["$","div","Lee’s initial intention",{"children":[["$","span",null,{"children":"Lee’s initial intention"}],["$","strong",null,{"children":"Withdraw across the Potomac after South Mountain"}],["$","small",null,{"children":"Lee first treated Sharpsburg as a temporary halt. He needed to give Lafayette McLaws a way out of Pleasant Valley and then protect the divided army during a retreat."}]]}],["$","div","Decision at Sharpsburg",{"children":[["$","span",null,{"children":"Decision at Sharpsburg"}],["$","strong",null,{"children":"Make a defensive stand and reunite the army"}],["$","small",null,{"children":"The fall of Harpers Ferry changed Lee’s calculation. Jackson could march north, McLaws could escape through Harpers Ferry, and Lee could still seek the battle he wanted from the Maryland Campaign."}]]}],["$","div","Antietam Creek",{"children":[["$","span",null,{"children":"Antietam Creek"}],["$","strong",null,{"children":"A north–south tributary entering the Potomac south of Sharpsburg"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}],"$L2a","$undefined","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31"]}]]}]
34:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"The creek was not exceptionally broad or deep, but formed a meaningful obstacle for organized infantry and artillery. Bridges and usable fords controlled the easiest crossings."}]
f:["$","div","Four stone bridges",{"children":[["$","span",null,{"children":"Four stone bridges"}],["$","strong",null,{"children":"A bridge near the creek mouth, Rohrbach, Middle, and Upper bridges"}],["$","small",null,{"children":"The Rohrbach Bridge on the Sharpsburg–Rohrersville Road became known as Burnside Bridge. The Middle Bridge carried the Boonsboro Turnpike, and the Upper Bridge stood near the Samuel Pry gristmill."}]]}]
10:["$","div","Sharpsburg’s importance",{"children":[["$","span",null,{"children":"Sharpsburg’s importance"}],["$","strong",null,{"children":"A road junction between Antietam Creek and the Potomac"}],["$","small",null,{"children":"The Hagerstown Pike ran north, the Boonsboro Turnpike ran northeast through Keedysville, and local roads led east toward Rohrersville and south toward Harpers Ferry and the Potomac crossings."}]]}]
11:["$","div","Lee’s lifeline",{"children":[["$","span",null,{"children":"Lee’s lifeline"}],["$","strong",null,{"children":"The road from Sharpsburg to Boteler’s Ford"}],["$","small",null,{"children":"The Shepherdstown bridge had been burned in 1861. Boteler’s Ford, below Shepherdstown, was the nearby practical crossing for Lee’s army and therefore the principal escape route back to Virginia."}]]}]
12:["$","div","D. H. Hill’s withdrawal",{"children":[["$","span",null,{"children":"D. H. Hill’s withdrawal"}],["$","strong",null,{"children":"Five brigades left South Mountain during the night of September 14–15"}],["$","small",null,{"children":"Rodes and Colquitt used the main road toward Sharpsburg. Ripley, George B. Anderson, and Garland’s brigade under Duncan K. McRae used country roads to reach Boonsboro and then followed the same general route."}]]}]
13:["$","div","Hill crosses the creek",{"children":[["$","span",null,{"children":"Hill crosses the creek"}],["$","strong",null,{"children":"The Middle Bridge at daylight on September 15"}],["$","small",null,{"children":"Most of Hill’s division formed on high ground north and east of Sharpsburg. Rodes initially held ground southwest of town, while Colquitt continued toward Boteler’s Ford to cover the Potomac crossing."}]]}]
14:["$","div","Hill’s strength",{"children":[["$","span",null,{"children":"Hill’s strength"}],["$","strong",null,{"children":"About 3,000 muskets at Sharpsburg"}],["$","small",null,{"children":"Hill’s infantry had been badly reduced at South Mountain. The episode says he also had 26 divisional guns and roughly 20 guns from the army artillery reserve available in the area."}]]}]
15:["$","div","Longstreet’s withdrawal",{"children":[["$","span",null,{"children":"Longstreet’s withdrawal"}],["$","strong",null,{"children":"D. R. Jones’s division followed the army trains"}],["$","small",null,{"children":"Quartermaster, ordnance, ambulance, and commissary wagons delayed the night movement. Jones’s men went first when the road cleared, followed by John Bell Hood’s division."}]]}]
16:["$","div","Army trains",{"children":[["$","span",null,{"children":"Army trains"}],["$","strong",null,{"children":"Moved through Sharpsburg toward the Potomac"}],["$","small",null,{"children":"The wagons halted about halfway between town and the river. Sending the trains toward the ford preserved the option to withdraw even as Lee prepared a line of battle."}]]}]
17:["$","div","Lee’s force on hand",{"children":[["$","span",null,{"children":"Lee’s force on hand"}],["$","strong",null,{"children":"About 15,000 men by September 15"}],["$","small",null,{"children":"This is the episode’s estimate for D. H. Hill and Longstreet at Sharpsburg. Twenty-six of the Army of Northern Virginia’s forty brigades were still around Harpers Ferry, a hard march away."}]]}]
18:["$","div","Confederate condition",{"children":[["$","span",null,{"children":"Confederate condition"}],["$","strong",null,{"children":"Hungry, ragged, shoeless, and depleted by straggling"}],["$","small",null,{"children":"Weeks of marching and fighting, poor food, illness, and inadequate equipment reduced the effective strength of both the troops already at Sharpsburg and the formations hurrying from Harpers Ferry."}]]}]
19:["$","div","Private Judkins’s account",{"children":[["$","span",null,{"children":"Private Judkins’s account"}],["$","strong",null,{"children":"Hunger dominated the soldiers’ experience"}],["$","small",null,{"children":"W. B. Judkins of the 22nd Georgia described eating grapes and unripe gooseberries during the march, then lacking the strength to climb back over a stone fence. He escaped arrest for straggling and rejoined his regiment."}]]}]
1a:["$","div","Lee’s confidence",{"children":[["$","span",null,{"children":"Lee’s confidence"}],["$","strong",null,{"children":"Veterans and trusted lieutenants could offset weakness in numbers"}],["$","small",null,{"children":"Lee considered his soldiers battle tested and relied heavily on Jackson and Longstreet. He also expected McClellan to become cautious again after the unusually aggressive attack at South Mountain."}]]}]
1b:["$","div","Federal pursuit begins",{"children":[["$","span",null,{"children":"Federal pursuit begins"}],["$","strong",null,{"children":"At first light on September 15"}],["$","small",null,{"children":"Federal skirmishers found the South Mountain passes abandoned. McClellan ordered the army forward across the previous day’s battlefield toward Boonsboro and Sharpsburg."}]]}]
1c:["$","div","Federal routes",{"children":[["$","span",null,{"children":"Federal routes"}],["$","strong",null,{"children":"I, II, and XII Corps on the National Road; IX Corps and Sykes on the Old Sharpsburg Road"}],["$","small",null,{"children":"The columns converged toward Keedysville and Antietam Creek. Sykes’s Regular Division belonged to V Corps; the rest of Fitz John Porter’s corps followed as the army concentrated."}]]}]
1d:["$","div","South Mountain burials",{"children":[["$","span",null,{"children":"South Mountain burials"}],["$","strong",null,{"children":"Fifty-eight Confederate dead were placed in Daniel Wise’s well"}],["$","small",null,{"children":"A Federal burial party used the farm well as a mass grave. The episode quotes a Pennsylvania officer who recognized how haste and war had dehumanized the men doing the work."}]]}]
1e:["$","div","Unreliable field reports",{"children":[["$","span",null,{"children":"Unreliable field reports"}],["$","strong",null,{"children":"McClellan forwarded claims that Lee was wounded and had lost 15,000 men"}],["$","small",null,{"children":"Those claims were false. McClellan nevertheless sent the reports to Washington as evidence that the Confederate retreat was a panic and the South Mountain victory complete."}]]}]
1f:["$","div","Lincoln’s instruction",{"children":[["$","span",null,{"children":"Lincoln’s instruction"}],["$","strong",null,{"children":"Destroy the Confederate army if possible"}],["$","small",null,{"children":"Lincoln followed events from the War Department telegraph office and encouraged McClellan after receiving the optimistic South Mountain dispatches."}]]}]
20:["$","div","Welles’s skepticism",{"children":[["$","span",null,{"children":"Welles’s skepticism"}],["$","strong",null,{"children":"The navy secretary doubted the victory was decisive"}],["$","small",null,{"children":"Gideon Welles accepted that McClellan had won at South Mountain but questioned the exaggerated reports and whether the Federal army had actually overtaken Lee."}]]}]
21:["$","div","McClellan after South Mountain",{"children":[["$","span",null,{"children":"McClellan after South Mountain"}],["$","strong",null,{"children":"Confident in his first major offensive victory with the Army of the Potomac"}],["$","small",null,{"children":"He sent retired general in chief Winfield Scott a message emphasizing that he had defeated an army commanded by Robert E. Lee. The episode connects the message to their personal and professional rivalry."}]]}]
22:["$","div","Federal army composition",{"children":[["$","span",null,{"children":"Federal army composition"}],["$","strong",null,{"children":"A reorganized and partly inexperienced force"}],["$","small",null,{"children":"The army combined II, V, and VI Corps from the Peninsula army with I and XII Corps reorganized from Pope’s Army of Virginia and IX Corps built around Burnside’s coastal expedition and the Kanawha Division."}]]}]
23:["$","div","New Federal soldiers",{"children":[["$","span",null,{"children":"New Federal soldiers"}],["$","strong",null,{"children":"About 20,000 recent recruits"}],["$","small",null,{"children":"The episode identifies eighteen new nine-month regiments totaling about 15,000 men and another 5,000 replacements added to existing regiments shortly before Antietam."}]]}]
24:["$","div","Federal force at the creek",{"children":[["$","span",null,{"children":"Federal force at the creek"}],["$","strong",null,{"children":"More than twice Lee’s estimated 15,000 immediately available"}],["$","small",null,{"children":"Richardson’s II Corps division and Sykes’s Regulars reached the front near Keedysville, with Hooker’s I Corps and the rest of Sumner’s II Corps behind them. The episode treats this as a temporary opportunity before Confederate reinforcements arrived."}]]}]
25:["$","div","McClellan’s reconnaissance",{"children":[["$","span",null,{"children":"McClellan’s reconnaissance"}],["$","strong",null,{"children":"Began about 3 p.m."}],["$","small",null,{"children":"McClellan and a large mounted party drew Confederate artillery fire. He and Fitz John Porter continued examining Lee’s position, after which McClellan reported that it was too late to attack that day."}]]}]
26:["$","div","Operational consequence",{"children":[["$","span",null,{"children":"Operational consequence"}],["$","strong",null,{"children":"September 15 passed without a Federal assault"}],["$","small",null,{"children":"Lee’s exposed force survived the afternoon. Jackson and Walker arrived on September 16, while McLaws and other detached troops continued toward Sharpsburg before the main battle."}]]}]
27:["$","div","Important leader loss",{"children":[["$","span",null,{"children":"Important leader loss"}],["$","strong",null,{"children":"Samuel Garland Jr. had been killed at Fox’s Gap on September 14"}],["$","small",null,{"children":"No senior commander was killed or mortally wounded in the September 15 movements. Garland appears because the episode identifies Duncan K. McRae as the officer leading his brigade during the retreat to Sharpsburg."}]]}]
28:["$","div","Recommended resources",{"children":[["$","span",null,{"children":"Recommended resources"}],["$","strong",null,{"children":"“The Maps of Antietam” and the McElfresh Antietam battlefield map"}],["$","small",null,{"children":"The main recommendation is Bradley M. Gottfried’s atlas “The Maps of Antietam: An Atlas of the Antietam (Sharpsburg) Campaign, Including the Battle of South Mountain.” The hosts also recommend the McElfresh Map Company battlefield map."}]]}]
29:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Keedysville, Rohrersville, Rohrbach Bridge, Boteler’s Ford, Samuel Pry, Rodes, Duncan K. McRae, Ezra A. Carman, and Kanawha Division"}],["$","small",null,{"children":"The automated transcript produces forms including “Kittiesville,” “Rorsville,” “Roarbach,” “Bottler’s,” “Price,” “Rhodes,” “McCray,” and “Canaw.” The farm surnames in the Sharpsburg quotation include Mumma and Poffenberger."}]]}]
2a:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
2b:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Sharpsburg, the creek crossings, and Lee’s lifeline",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep187-sharpsburg-ground.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Sharpsburg, the creek crossings, and Lee’s lifeline at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep187-sharpsburg-ground.svg","alt":"Schematic map of Sharpsburg between the Potomac River and Antietam Creek, showing the Upper, Middle, and Rohrbach bridges, the Hagerstown and Boonsboro turnpikes, and the road to Boteler’s Ford.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Sharpsburg, the creek crossings, and Lee’s lifeline"}],["$","span",null,{"children":"Sharpsburg stood between Antietam Creek and the Potomac. The Middle Bridge carried the Boonsboro Turnpike toward town, while the Upper and Rohrbach bridges offered additional crossings. South of town, the road to Boteler’s Ford was Lee’s practical route back to Virginia. Roads, watercourses, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep187-sharpsburg-ground.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, William H. Willcox battlefield map, Antietam Battlefield Board maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2b:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The opposing approaches on September 15",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep187-september-15-approach.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The opposing approaches on September 15 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep187-september-15-approach.svg","alt":"Schematic operational map of Confederate forces retreating from South Mountain to Sharpsburg and Federal corps pursuing by the National and Old Sharpsburg roads on September 15, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The opposing approaches on September 15"}],["$","span",null,{"children":"Hill and Longstreet withdrew from South Mountain through Boonsboro and Keedysville to Lee’s line west of Antietam Creek, while their trains moved toward the Potomac. Federal I, II, and XII Corps followed the National Road; IX Corps and Sykes’s division used the Old Sharpsburg Road. The map depicts the operational relationship at midafternoon, not exact unit boundaries or march order. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep187-september-15-approach.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2b:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, McClellan and Lee official reports, Antietam Battlefield Board maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L32"]}]]}],"$undefined"]}]]}],"$L33"]}]]}]
2c:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode resumes after South Mountain",{"className":"moment","children":[["$","$L34",null,{"seconds":71,"label":"1:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode resumes after South Mountain"}],["$","p",null,{"children":"The hosts review the September 14 tactical defeat that nevertheless bought Lee time to begin reuniting his divided army."}]]}]]}],["$","div","Jackson reports Harpers Ferry near surrender",{"className":"moment","children":[["$","$L34",null,{"seconds":190,"label":"3:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson reports Harpers Ferry near surrender"}],["$","p",null,{"children":"The message reaching Lee on Monday morning changes the value of the temporary halt at Sharpsburg."}]]}]]}],["$","div","Lee decides to stand",{"className":"moment","children":[["$","$L34",null,{"seconds":243,"label":"4:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee decides to stand"}],["$","p",null,{"children":"Instead of continuing directly to the Potomac, Lee orders Jackson toward Sharpsburg and prepares to defend the position."}]]}]]}],["$","div","The battle site emerges from the failed campaign plan",{"className":"moment","children":[["$","$L34",null,{"seconds":269,"label":"4:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battle site emerges from the failed campaign plan"}],["$","p",null,{"children":"The episode explains that Antietam resulted from delays at Harpers Ferry and McClellan’s faster-than-expected movement across South Mountain."}]]}]]}],["$","div","Antietam Creek is introduced",{"className":"moment","children":[["$","$L34",null,{"seconds":367,"label":"6:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Antietam Creek is introduced"}],["$","p",null,{"children":"The creek runs south from Pennsylvania past Sharpsburg and enters the Potomac about three miles below town."}]]}]]}],["$","div","The four stone bridges define the crossings",{"className":"moment","children":[["$","$L34",null,{"seconds":414,"label":"6:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"The four stone bridges define the crossings"}],["$","p",null,{"children":"The Rohrbach, Middle, and Upper bridges are located in relation to Sharpsburg, along with a lower bridge near the creek mouth."}]]}]]}],["$","div","Sharpsburg’s road network is traced",{"className":"moment","children":[["$","$L34",null,{"seconds":529,"label":"8:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sharpsburg’s road network is traced"}],["$","p",null,{"children":"The Hagerstown and Boonsboro turnpikes and secondary roads made the town a natural point of concentration."}]]}]]}],["$","div","Boteler’s Ford becomes Lee’s lifeline",{"className":"moment","children":[["$","$L34",null,{"seconds":610,"label":"10:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Boteler’s Ford becomes Lee’s lifeline"}],["$","p",null,{"children":"With the Shepherdstown bridge destroyed, the three-mile road south from Sharpsburg led to the army’s practical escape route across the Potomac."}]]}]]}],["$","div","D. H. Hill leaves South Mountain",{"className":"moment","children":[["$","$L34",null,{"seconds":642,"label":"10:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"D. H. Hill leaves South Mountain"}],["$","p",null,{"children":"Hill’s battered division begins its night withdrawal along the Boonsboro–Sharpsburg route."}]]}]]}],["$","div","Rodes and Colquitt separate near Sharpsburg",{"className":"moment","children":[["$","$L34",null,{"seconds":676,"label":"11:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rodes and Colquitt separate near Sharpsburg"}],["$","p",null,{"children":"Rodes takes ground southwest of town while Colquitt continues toward the ford to guard the Potomac crossing."}]]}]]}],["$","div","Hill’s other brigades cross the Middle Bridge",{"className":"moment","children":[["$","$L34",null,{"seconds":715,"label":"11:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hill’s other brigades cross the Middle Bridge"}],["$","p",null,{"children":"Ripley, G. B. Anderson, and Garland’s brigade under McRae form on the high ground north of Sharpsburg."}]]}]]}],"$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c"]}]]}]
2d:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Ordered the September 15 pursuit, joined the advance west of Keedysville, and reconnoitered Lee’s position with Fitz John Porter before deciding against an attack that afternoon"}]]}],["$","div","Right Wing, Army of the Potomac-Maj. Gen. Ambrose E. Burnside",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing, Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. Ambrose E. Burnside"}],["$","small",null,{"children":"Oversaw Joseph Hooker’s I Corps and the IX Corps, provisionally led by Jacob D. Cox after Jesse Reno’s death; IX Corps advanced on the Old Sharpsburg Road"}]]}],["$","div","II Corps-Maj. Gen. Edwin V. Sumner",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps"}],["$","span",null,{"children":"Maj. Gen. Edwin V. Sumner"}],["$","small",null,{"children":"Israel B. Richardson’s division reached the front west of Keedysville; the remainder of the corps followed behind the vanguard on the Boonsboro–Sharpsburg axis"}]]}],["$","div","I Corps-Maj. Gen. Joseph Hooker",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps"}],["$","span",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","small",null,{"children":"Advanced from South Mountain by way of the National Road and Boonsboro, then halted behind the leading Federal divisions east of Antietam Creek"}]]}],["$","div","XII Corps-Maj. Gen. Joseph K. F. Mansfield",{"className":"command-entry","children":[["$","strong",null,{"children":"XII Corps"}],["$","span",null,{"children":"Maj. Gen. Joseph K. F. Mansfield"}],["$","small",null,{"children":"Led one of the corps ordered through Turner’s Gap and Boonsboro on the National Road during the September 15 pursuit"}]]}],["$","div","V Corps-Maj. Gen. Fitz John Porter",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"George Sykes’s Regular Division advanced with IX Corps on the Old Sharpsburg Road; Porter accompanied McClellan during the afternoon reconnaissance"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Changed the halt at Sharpsburg into a defensive stand after learning that Harpers Ferry would fall, while ordering detached commands to concentrate with him"}]]}],["$","div","Right Wing, Army of Northern Virginia-Maj. Gen. James Longstreet",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing, Army of Northern Virginia"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Withdrew from South Mountain after the army trains; D. R. Jones’s division and John Bell Hood’s division reached the Sharpsburg position"}]]}],["$","div","Hill’s Division-Maj. Gen. D. H. Hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Hill’s Division"}],["$","span",null,{"children":"Maj. Gen. D. H. Hill"}],["$","small",null,{"children":"Directed the retreat through Boonsboro and deployed the brigades of Rodes, Colquitt, Ripley, G. B. Anderson, and Garland under Duncan K. McRae around Sharpsburg"}]]}],"$L4d","$L4e","$L4f"]]}]]}],"$L50","$L51"]}]
2e:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. Samuel Garland Jr.",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Samuel Garland Jr."}],["$","p",null,{"children":[["$","strong",null,{"children":["Garland’s Brigade, D. H. Hill’s Division","."]}]," ","Killed at Fox’s Gap on September 14; his death is reflected in this episode when Duncan K. McRae leads the brigade during its withdrawal to Sharpsburg"]}]]}]]}]]}]
2f:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep187-sharpsburg-ground.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep187-sharpsburg-ground.svg","alt":"Schematic map of Sharpsburg, Antietam Creek, the stone bridges, the Potomac, and Boteler’s Ford.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Sharpsburg’s road junction, the Antietam crossings, and the open road to Boteler’s Ford explain why the ground could serve both as a defensive position and as the last stop before a retreat to Virginia."}]]}],["$","figure","/images/ep187-september-15-approach.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep187-september-15-approach.svg","alt":"Schematic map of the Confederate withdrawal to Sharpsburg and the two Federal approach routes on September 15.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The armies converged from South Mountain on September 15. Lee’s reduced force formed west of the creek while McClellan’s leading divisions gathered east of it and the detached Confederate commands remained near Harpers Ferry."}]]}],["$","figure","/images/ep187-willcox-antietam-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep187-willcox-antietam-map.jpg","alt":"William H. Willcox’s detailed 1862 map of the Antietam battlefield and Sharpsburg road network.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"William H. Willcox’s map was prepared in 1862 from the perspective of a Federal topographical officer. It preserves the landscape in exceptional detail, although its marked troop positions belong to the September 17 battle."}]]}],["$","figure","/images/ep187-robert-e-lee.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep187-robert-e-lee.jpg","alt":"Civil War-era glass-negative portrait of Confederate general Robert E. Lee in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Robert E. Lee accepted the risk of standing at Sharpsburg with much of his army still absent because Harpers Ferry had fallen and he expected McClellan to hesitate."}]]}],["$","figure","/images/ep187-george-mcclellan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep187-george-mcclellan.jpg","alt":"Civil War-era portrait of United States major general George B. McClellan in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"George B. McClellan reached the front during the afternoon of September 15, reconnoitered Lee’s line with Fitz John Porter, and reported that it was too late to attack that day."}]]}]]}]]}]
