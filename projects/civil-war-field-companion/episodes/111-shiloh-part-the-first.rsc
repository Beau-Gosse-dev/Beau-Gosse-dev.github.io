12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode introduces Shiloh",{"className":"moment","children":[["$","$L17",null,{"seconds":68,"label":"1:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode introduces Shiloh"}],["$","p",null,{"children":"The battle took place on April 6 and 7 near Pittsburg Landing, a river landing beside scattered farms and Shiloh Church."}]]}]]}],["$","div","The battle produced more than 23,000 casualties",{"className":"moment","children":[["$","$L17",null,{"seconds":132,"label":"2:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battle produced more than 23,000 casualties"}],["$","p",null,{"children":"The episode compares the two-day total with the combined losses at First Manassas, Wilson’s Creek, Fort Donelson, and Pea Ridge."}]]}]]}],["$","div","The battlefield restricted movement",{"className":"moment","children":[["$","$L17",null,{"seconds":175,"label":"2:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battlefield restricted movement"}],["$","p",null,{"children":"Forests, thick undergrowth, ridges, ravines, and swamps made it difficult to keep formations aligned. The Tennessee River and Owl and Snake creeks bounded the area."}]]}]]}],["$","div","Many troops had little training",{"className":"moment","children":[["$","$L17",null,{"seconds":215,"label":"3:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Many troops had little training"}],["$","p",null,{"children":"Most soldiers in both armies had no battle experience, and some had received little instruction with their weapons."}]]}]]}],["$","div","Fort Henry and Fort Donelson changed the theater",{"className":"moment","children":[["$","$L17",null,{"seconds":414,"label":"6:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fort Henry and Fort Donelson changed the theater"}],["$","p",null,{"children":"Grant’s February victories broke the Confederate line in Kentucky and northern Tennessee and opened the Tennessee and Cumberland rivers."}]]}]]}],["$","div","Johnston ordered a general withdrawal",{"className":"moment","children":[["$","$L17",null,{"seconds":451,"label":"7:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston ordered a general withdrawal"}],["$","p",null,{"children":"Confederate forces abandoned Bowling Green and Nashville to avoid being cut off and defeated separately."}]]}]]}],["$","div","Johnston’s column moved south",{"className":"moment","children":[["$","$L17",null,{"seconds":507,"label":"8:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston’s column moved south"}],["$","p",null,{"children":"About 15,000 men withdrew from Bowling Green through Nashville and Murfreesboro toward northern Alabama while Buell followed."}]]}]]}],["$","div","Nashville fell",{"className":"moment","children":[["$","$L17",null,{"seconds":538,"label":"8:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nashville fell"}],["$","p",null,{"children":"United States troops occupied the Tennessee capital and major supply center on February 25."}]]}]]}],["$","div","Polk abandoned Columbus",{"className":"moment","children":[["$","$L17",null,{"seconds":543,"label":"9:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Polk abandoned Columbus"}],["$","p",null,{"children":"The Fort Henry and Donelson victories outflanked the Confederate position on the Mississippi River, forcing Polk to retreat south."}]]}]]}],["$","div","Pope advanced on New Madrid and Island No. 10",{"className":"moment","children":[["$","$L17",null,{"seconds":570,"label":"9:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope advanced on New Madrid and Island No. 10"}],["$","p",null,{"children":"About 25,000 United States troops moved down the newly opened stretch of the Mississippi River."}]]}]]}],["$","div","Johnston continued into Alabama",{"className":"moment","children":[["$","$L17",null,{"seconds":632,"label":"10:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston continued into Alabama"}],["$","p",null,{"children":"His command left Murfreesboro on February 28 and reached Decatur on March 15 after abandoning most of western and central Tennessee."}]]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}]
