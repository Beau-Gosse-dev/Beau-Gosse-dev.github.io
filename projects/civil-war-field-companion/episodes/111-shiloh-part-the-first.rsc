1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",111," · ","February–early April 1862; background to the Battle of Shiloh, April 6–7"," · ","Kentucky, Tennessee, northern Alabama, and Corinth, Mississippi, with both armies converging near Pittsburg Landing"]}],["$","h1",null,{"children":"SHILOH (Part the First)"}],["$","span",null,{"className":"result-label","children":"The loss of Forts Henry and Donelson forced Confederate troops out of Kentucky, Nashville, and Columbus. Albert Sidney Johnston and P.G.T. Beauregard concentrated about 40,000 men at Corinth. Grant’s army moved up the Tennessee River while Buell marched from Nashville. Johnston decided to attack Grant near Pittsburg Landing before the two United States armies could unite"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9144708856.mp3?updated=1695140498","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Battle dates introduced",{"children":[["$","span",null,{"children":"Battle dates introduced"}],["$","strong",null,{"children":"April 6–7, 1862"}],"$undefined"]}],["$","div","Battlefield",{"children":[["$","span",null,{"children":"Battlefield"}],["$","strong",null,{"children":"West bank of the Tennessee River near Pittsburg Landing and Shiloh Church"}],"$undefined"]}],["$","div","Eventual casualties stated in episode",{"children":[["$","span",null,{"children":"Eventual casualties stated in episode"}],["$","strong",null,{"children":"More than 23,000 over two days"}],"$undefined"]}],["$","div","Confederate concentration",{"children":[["$","span",null,{"children":"Confederate concentration"}],["$","strong",null,{"children":"About 40,000 men assembled at Corinth"}],"$undefined"]}],["$","div","Distance",{"children":[["$","span",null,{"children":"Distance"}],["$","strong",null,{"children":"Pittsburg Landing was about 20 miles north of Corinth"}],"$undefined"]}],["$","div","United States plan",{"children":[["$","span",null,{"children":"United States plan"}],["$","strong",null,{"children":"Unite Grant and Buell, then advance on Corinth under Halleck"}],"$undefined"]}],["$","div","Confederate plan",{"children":[["$","span",null,{"children":"Confederate plan"}],["$","strong",null,{"children":"Defeat Grant before Buell arrived"}],"$undefined"]}],["$","div","Strategic objective",{"children":[["$","span",null,{"children":"Strategic objective"}],["$","strong",null,{"children":"Corinth’s junction connected the Memphis & Charleston and Mobile & Ohio railroads"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],"$undefined",["$","section",null,{"className":"reference-section m