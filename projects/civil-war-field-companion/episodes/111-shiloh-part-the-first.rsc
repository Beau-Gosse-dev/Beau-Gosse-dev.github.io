18:["$","div","Beauregard organized the western concentration",{"className":"moment","children":[["$","$L17",null,{"seconds":660,"label":"11:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Beauregard organized the western concentration"}],["$","p",null,{"children":"He directed Polk’s withdrawal, reinforced Island No. 10, and gathered troops from across the lower South at Corinth."}]]}]]}]
19:["$","div","Corinth was the key rail junction",{"className":"moment","children":[["$","$L17",null,{"seconds":714,"label":"11:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Corinth was the key rail junction"}],["$","p",null,{"children":"The Memphis & Charleston Railroad crossed the Mobile & Ohio at Corinth, connecting the lower Mississippi region with Chattanooga and Richmond."}]]}]]}]
1a:["$","div","Johnston reached Corinth",{"className":"moment","children":[["$","$L17",null,{"seconds":772,"label":"12:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston reached Corinth"}],["$","p",null,{"children":"When his column arrived on March 24, troops under Polk, Ruggles, and Bragg were already assembling there."}]]}]]}]
1b:["$","div","The Army of the Mississippi reached about 40,000 men",{"className":"moment","children":[["$","$L17",null,{"seconds":793,"label":"13:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Mississippi reached about 40,000 men"}],["$","p",null,{"children":"Van Dorn’s force from Arkansas had not arrived, and the troops captured at Fort Donelson were unavailable."}]]}]]}]
1c:["$","div","Two United States armies moved toward Corinth",{"className":"moment","children":[["$","$L17",null,{"seconds":859,"label":"14:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two United States armies moved toward Corinth"}],["$","p",null,{"children":"Grant’s army approached by the Tennessee River while Buell marched overland from Nashville."}]]}]]}]
1d:["$","div","Halleck received the unified western command",{"className":"moment","children":[["$","$L17",null,{"seconds":883,"label":"14:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck received the unified western command"}],["$","p",null,{"children":"He became Buell’s superior and planned to take field command after Grant and Buell combined."}]]}]]}]
1e:["$","div","Halleck accused Grant of disobedience",{"className":"moment","children":[["$","$L17",null,{"seconds":1080,"label":"18:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck accused Grant of disobedience"}],["$","p",null,{"children":"Missing reports and an unauthorized visit to Nashville led Halleck to complain to Washington and imply that Grant had resumed drinking, without evidence."}]]}]]}]
1f:["$","div","Grant was removed temporarily",{"className":"moment","children":[["$","$L17",null,{"seconds":1219,"label":"20:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant was removed temporarily"}],["$","p",null,{"children":"Halleck placed C.F. Smith in field command and ordered Grant to remain at Fort Henry."}]]}]]}]
20:["$","div","Lincoln required evidence or Grant’s restoration",{"className":"moment","children":[["$","$L17",null,{"seconds":1282,"label":"21:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln required evidence or Grant’s restoration"}],["$","p",null,{"children":"Halleck brought no charges and returned Grant to command on March 13."}]]}]]}]
21:["$","div","Smith moved the army toward Savannah",{"className":"moment","children":[["$","$L17",null,{"seconds":1369,"label":"22:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith moved the army toward Savannah"}],["$","p",null,{"children":"The expedition traveled up the Tennessee River to establish a base, threaten the Memphis & Charleston Railroad, and meet Sherman’s new division."}]]}]]}]
22:["$","div","Johnston chose to attack before Buell arrived",{"className":"moment","children":[["$","$L17",null,{"seconds":1489,"label":"24:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston chose to attack before Buell arrived"}],["$","p",null,{"children":"Grant’s and Johnston’s forces were then of similar size. The combined United States force would have a large numerical advantage."}]]}]]}]
