1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",116," · ","April 6, 1862, about 7 a.m.–noon"," · ","Savannah, Crump’s Landing, Pittsburg Landing, Shiloh Church, the Hamburg–Purdy Road, and Jones Field, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Sixth)"}],["$","span",null,{"className":"result-label","children":"Sherman abandoned the line near Shiloh Church at about 10 a.m. and joined McClernand along the Hamburg–Purdy Road. Grant reached Pittsburg Landing at about 9 a.m., organized ammunition and straggler control, ordered Lew Wallace and William Nelson toward the battlefield, and met Sherman around 10 a.m. A renewed Confederate attack broke Marsh’s and Raith’s brigades, then forced Sherman, McClernand, and Veatch to retreat toward Jones Field. The attack lost momentum while intermingled Confederate units reorganized and soldiers searched the captured camps"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2091319673.mp3?updated=1695140606","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Sherman’s first withdrawal",{"children":[["$","span",null,{"children":"Sherman’s first withdrawal"}],["$","strong",null,{"children":"About 600 yards to the Hamburg–Purdy Road"}],"$undefined"]}],["$","div","Grant left Savannah",{"children":[["$","span",null,{"children":"Grant left Savannah"}],["$","strong",null,{"children":"About 7:30 a.m. aboard the Tigress"}],"$undefined"]}],["$","div","Grant reached Pittsburg Landing",{"children":[["$","span",null,{"children":"Grant reached Pittsburg Landing"}],["$","strong",null,{"children":"About 9 a.m."}],"$undefined"]}],["$","div","Stragglers at the landing",{"children":[["$","span",null,{"children":"Stragglers at the landing"}],["$","strong",null,{"children":"At least 3,000 when Grant arrived"}],"$undefined"]}],["$","div","Expected reinforcements",{"children":[["$","span",null,{"children":"Expected reinforcements"}],["$","strong",null,{"children":"Lew Wallace’s and William Nelson’s divisions"}],"$undefined"]}],["$","div","Attack on Marsh",{"children":[["$","span",null,{"children":"Attack on Marsh"}],["$","strong",null,{"children":"Eleven Confederate regiments or battalions against four Illinois regiments"}],"$undefined"]}],["$","div","Second line collapsed",{"children":[["$","span",null,{"children":"Second line collapsed"}],["$","strong",null,{"children":"About 11:30 a.m."}],"$undefined"]}],["$","div","Rallying point",{"children":[["$","span",null,{"children":"Rallying point"}],["$","strong",null,{"children":"Jones Field, about half a mile north of the crossroads"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and