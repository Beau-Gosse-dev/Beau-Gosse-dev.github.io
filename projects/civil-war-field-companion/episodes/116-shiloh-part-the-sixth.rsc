10:["$","figure","Grant’s arrival and the collapse of the United States right",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/shiloh-april-6-grant-and-right.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Grant’s arrival and the collapse of the United States right at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-april-6-grant-and-right.svg","alt":"Map of Grant’s route to Shiloh and the fighting on the United States right","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Grant’s arrival and the collapse of the United States right"}],["$","span",null,{"children":"Grant traveled upriver from Savannah while Sherman withdrew from Shiloh Church. The second United States line formed along the Hamburg–Purdy Road, broke under Confederate attacks, and rallied near Jones Field."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/shiloh-april-6-grant-and-right.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
