12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Hildebrand’s brigade came apart",{"className":"moment","children":[["$","$L18",null,{"seconds":159,"label":"2:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hildebrand’s brigade came apart"}],["$","p",null,{"children":"The 53rd, 57th, and 77th Ohio withdrew in succession as Confederate pressure spread across Sherman’s left."}]]}]]}],["$","div","Sherman abandoned Shiloh Church",{"className":"moment","children":[["$","$L18",null,{"seconds":219,"label":"3:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman abandoned Shiloh Church"}],["$","p",null,{"children":"He ordered Buckland and McDowell to fall back about 600 yards to the Hamburg–Purdy Road; Raith’s brigade withdrew with them."}]]}]]}],["$","div","McDowell became separated",{"className":"moment","children":[["$","$L18",null,{"seconds":293,"label":"4:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"McDowell became separated"}],["$","p",null,{"children":"During the retreat, McDowell’s brigade moved off course. Buckland remained Sherman’s only organized brigade, reinforced by rallied men from Hildebrand."}]]}]]}],["$","div","The second United States line formed",{"className":"moment","children":[["$","$L18",null,{"seconds":324,"label":"5:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The second United States line formed"}],["$","p",null,{"children":"Sherman joined McClernand’s three brigades along the Hamburg–Purdy Road. Wallace’s division stood 200–300 yards beyond McClernand’s left."}]]}]]}],["$","div","Grant re-entered the battle narrative",{"className":"moment","children":[["$","$L18",null,{"seconds":396,"label":"6:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant re-entered the battle narrative"}],["$","p",null,{"children":"He reached the Sherman–McClernand sector after arriving from Savannah and inspecting conditions around Pittsburg Landing."}]]}]]}],["$","div","Grant heard the battle from Savannah",{"className":"moment","children":[["$","$L18",null,{"seconds":518,"label":"8:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant heard the battle from Savannah"}],["$","p",null,{"children":"Between 7 and 7:30 a.m., artillery interrupted breakfast at the Cherry Mansion. Grant immediately ordered preparations to leave."}]]}]]}],["$","div","The Tigress departed",{"className":"moment","children":[["$","$L18",null,{"seconds":544,"label":"9:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Tigress departed"}],["$","p",null,{"children":"Grant’s headquarters steamer traveled south against the Tennessee River’s current toward Pittsburg Landing."}]]}]]}],["$","div","Nelson was ordered toward the battlefield",{"className":"moment","children":[["$","$L18",null,{"seconds":559,"label":"9:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nelson was ordered toward the battlefield"}],["$","p",null,{"children":"Before leaving Savannah, Grant directed William “Bull” Nelson’s division down the east bank to a point opposite Pittsburg Landing."}]]}]]}],["$","div","Grant stopped at Crump’s Landing",{"className":"moment","children":[["$","$L18",null,{"seconds":581,"label":"9:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant stopped at Crump’s Landing"}],["$","p",null,{"children":"He told Lew Wallace to hold the 3rd Division ready and continued upriver without disembarking."}]]}]]}],["$","div","Grant reached Pittsburg Landing",{"className":"moment","children":[["$","$L18",null,{"seconds":615,"label":"10:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant reached Pittsburg Landing"}],["$","p",null,{"children":"At about 9 a.m., he found at least 3,000 wounded men, teamsters, and stragglers gathered around the bluff."}]]}]]}],["$","div","Grant organized the landing",{"className":"moment","children":[["$","$L18",null,{"seconds":670,"label":"11:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant organized the landing"}],["$","p",null,{"children":"He used the 15th and 16th Iowa to intercept stragglers and organized an ammunition train for the firing line."}]]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Tennessee"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Reached Pittsburg Landing, organized support, called Lew Wallace forward, and inspected the army’s line"}]]}],["$","div","5th Division",{"className":"command-entry","children":[["$","strong",null,{"children":"5th Division"}],["$","span",null,{"children":"William T. Sherman"}],["$","small",null,{"children":"Buckland and rallied elements held on McClernand’s right; McDowell became separated"}]]}],["$","div","1st Division",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division"}],["$","span",null,{"children":"John A. McClernand"}],["$","small",null,{"children":"Raith, C. C. Marsh, and Abram Hare along the Hamburg–Purdy Road"}]]}],["$","div","Brigade, Hurlbut’s 4th Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Hurlbut’s 4th Division"}],["$","span",null,{"children":"James C. Veatch"}],["$","small",null,{"children":"Three Illinois regiments and one Indiana regiment covering the retreat"}]]}],["$","div","2nd Division",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division"}],["$","span",null,{"children":"W. H. L. Wallace"}],["$","small",null,{"children":"Held east of McClernand and briefed Grant near the Corinth Road"}]]}],["$","div","3rd Division",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division"}],["$","span",null,{"children":"Lew Wallace"}],["$","small",null,{"children":"At Crump’s Landing; 