rong",null,{"children":"36,872"}],["$","small",null,{"children":"3,814 killed, 22,298 wounded, and 10,733 missing in the early field returns cited in the episode"}]]}],["$","div","Loss from the force that crossed the Rapidan",{"children":[["$","span",null,{"children":"Loss from the force that crossed the Rapidan"}],["$","strong",null,{"children":"About 36%"}],"$undefined"]}],["$","div","Confederate hospital patients by May 24",{"children":[["$","span",null,{"children":"Confederate hospital patients by May 24"}],["$","strong",null,{"children":"More than 18,000"}],"$undefined"]}],["$","div","U.S. ambulances available",{"children":[["$","span",null,{"children":"U.S. ambulances available"}],["$","strong",null,{"children":"Nearly 800"}],"$undefined"]}],["$","div","Wounded in Fredericksburg by May 12",{"children":[["$","span",null,{"children":"Wounded in Fredericksburg by May 12"}],["$","strong",null,{"children":"About 14,000"}],"$undefined"]}],["$","div","Prisoners taken during the campaign",{"children":[["$","span",null,{"children":"Prisoners taken during the campaign"}],["$","strong",null,{"children":"More than 19,000"}],["$","small",null,{"children":"Both sides combined"}]]}],["$","div","Dead produced by the campaign",{"children":[["$","span",null,{"children":"Dead produced by the campaign"}],["$","strong",null,{"children":"At least 12,000"}],"$undefined"]}],["$","div","Burials at Fredericksburg National Cemetery",{"children":[["$","span",null,{"children":"Burials at Fredericksburg National Cemetery"}],["$","strong",null,{"children":"15,243"}],["$","small",null,{"children":"Current National Park Service count; at least 85% are unidentified"}]]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],"$undefined",["$","section",null