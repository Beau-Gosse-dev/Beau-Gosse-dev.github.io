d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",495," · ","May 4–June 1864 and postwar burials"," · ","Overland Campaign corridor, Fredericksburg, and evacuation routes to Washington"]}],["$","h1",null,{"children":"THE OVERLAND CAMPAIGN'S WOUNDED, PRISONERS, & DEAD"}],["$","span",null,{"className":"result-label","children":"The campaign produced tens of thousands of casualties, overwhelmed the first U.S. evacuation route, sent more than 19,000 captured soldiers to prison, and left at least 12,000 dead for wartime and postwar burial details to recover"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"May 4–June 1864 and postwar burials"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Overland Campaign corridor, Fredericksburg, and evacuation routes to Washington"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"The campaign produced tens of thousands of casualties, overwhelmed the first U.S. evacuation route, sent more than 19,000 captured soldiers to prison, and left at least 12,000 dead for wartime and postwar burial details to recover"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"May 4–June 1864 and postwar burials","place":"Overland Campaign corridor, Fredericksburg, and evacuation routes to Washington","result":"The campaign produced tens of thousands of casualties, overwhelmed the first U.S. evacuation route, sent more than 19,000 captured soldiers to prison, and left at least 12,000 dead for wartime and postwar burial details to recover","facts":[{"label":"Army of the Potomac casualties by mid-May","value":"36,872","note":"3,814 killed, 22,298 wounded, and 10,733 missing in the early field returns cited in the episode"},{"label":"Loss from the force that crossed the Rapidan","value":"About 36%"},{"label":"Confederate hospital patients by May 24","value":"More than 18,000"},{"label":"U.S. ambulances available","value":"Nearly 800"},{"label":"Wounded in Fredericksburg by May 12","value":"About 14,000"},{"label":"Prisoners taken during the campaign","value":"More than 19,000","note":"Both sides combined"},{"label":"Dead produced by the campaign","value":"At least 12,000"},{"label":"Burials at Fredericksburg National Cemetery","value":"15,243","note":"Current National Park Service count; at least 85% are unidentified"}],"maps":[{"title":"The campaign and casualty evacuation corridor","caption":"The campaign moved from the Wilderness through Spotsylvania, the North Anna, and Cold Harbor. Each move required the U.S. Army to alter the route used to remove wounded soldiers and supply the front.","source":"https://www.loc.gov/item/99448882/","image":"/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland Campaign route through eastern Virginia"},{"title":"The Wilderness, Spotsylvania, and Fredericksburg","caption":"Wounded soldiers traveled roughly ten miles from the first battlefields to Fredericksburg. The damaged town became a temporary depot hospital before patients continued northeast toward Belle Plain and Aquia Creek.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-77.95%2C38.08%2C-77.25%2C38.48&layer=mapnik&marker=38.3032%2C-77.4605"},{"title":"Fredericksburg to Washington","caption":"Once roads, bridges, and the railroad were improved, patients moved from Fredericksburg to Belle Plain or Aquia Creek, then traveled by steamer to hospitals in Washington and Alexandria.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-77.75%2C38.05%2C-76.75%2C39.05&layer=mapnik&marker=38.3032%2C-77.4605"}],"moments":[{"time":"1:41","audioTime":101,"title":"Early field returns showed the scale of the losses","detail":"By mid-May the Army of the Potomac, including IX Corps but excluding cavalry and some recent reinforcements, reported 56,124 men present and 36,872 casualties since crossing the Rapidan."},{"time":"5:15","audioTime":315,"title":"Ambulances filled the roads behind the armies","detail":"Wagons and ambulances carried wounded soldiers away from the battlefields. The Confederate system had fewer casualties to move and shorter routes to established Virginia hospitals."},{"time":"6:11","audioTime":371,"title":"Richmond hospitals received Confederate wounded","detail":"Confederate patients usually moved from an aid station to a field hospital, then by ambulance and rail to permanent hospitals. Chimborazo Hospital outside Richmond had about 8,000 beds."},{"time":"7:43","audioTime":463,"title":"Thomas McParlin directed the U.S. medical system","detail":"The Army of the Potomac medical director had 60 officers, about 2,300 enlisted personnel, nearly 800 ambulances, and support from hundreds of regimental and brigade surgeons."},{"time":"8:28","audioTime":508,"title":"U.S. evacuation used three main levels of care","detail":"A wounded soldier moved through a regimental or brigade station, a division or corps hospital, and then a general hospital. Washington had sixteen general hospitals and Alexandria had seven."},{"time":"9:27","audioTime":567,"title":"Changing the supply base disrupted evacuation","detail":"After the Wilderness, the army abandoned the shorter Culpeper rail route and established a base at Belle Plain. Wounded soldiers first had to pass through Fredericksburg."},{"time":"10:34","audioTime":634,"title":"The army improvised a depot hospital","detail":"Fredericksburg became a fourth stage between field hospitals and transportation to Washington. No organization was ready when the first wounded arrived."},{"time":"12:51","audioTime":771,"title":"About 14,000 wounded accumulated in Fredericksburg","detail":"Damaged buildings, heavy rain, few surgeons, poor roads, missing bridges, and competition with supply traffic delayed treatment and movement by May 12."},{"time":"14:15","audioTime":855,"title":"Civilian relief organizations supplied staff and material","detail":"The U.S. Sanitary Commission and U.S. Christian Commission sent doctors, nurses, ambulances, food, bedding, and other supplies to Fredericksburg."},{"time":"15:45","audioTime":945,"title":"Cornelia Hancock organized immediate improvements","detail":"Hancock found wounded men lying in water inside damaged churches. Her work party cut church pews into improvised cots to lift patients off the wet floors."},{"time":"16:41","audioTime":1001,"title":"Clara Barton carried the emergency to Washington","detail":"After seeing conditions in Fredericksburg, Barton informed Senator Henry Wilson. Wilson pressed Secretary of War Edwin Stanton to intervene."},{"time":"18:14","audioTime":1094,"title":"Montgomery Meigs reorganized the depot","detail":"Stanton sent Quartermaster General Meigs with broad authority. Meigs opened civilian buildings, added a pontoon bridge, accelerated railroad repairs, and requested supplies."},{"time":"18:54","audioTime":1134,"title":"Evacuation improved by May 23","detail":"Patients moved by wagon to Belle Plain and by rail to Aquia Creek. The army then shifted its depot hospitals to Port Royal and White House Landing as the front moved south."},{"time":"20:26","audioTime":1226,"title":"Anesthesia was available but infection control was not","detail":"Surgeons used ether and chloroform and could perform complex operations. Germ theory and effective antiseptic practice were not yet part of routine care."},{"time":"22:31","audioTime":1351,"title":"Captured wounded could remain without adequate supplies","detail":"Union surgeons sometimes stayed with patients who fell into Confederate hands, but food and medical material were limited. William Watson cared for about 275 men in the Wilderness and repeatedly requested supplies."},{"time":"24:53","audioTime":1493,"title":"More than 19,000 soldiers became prisoners","detail":"The formal exchange system had broken down over the treatment of Black U.S. soldiers and disputed Confederate paroles. Capture therefore meant transport to a prison camp rather than prompt exchange."},{"time":"26:38","audioTime":1598,"title":"The Wilderness produced the largest captures","detail":"Dense woods separated individuals and units. Soldiers often had only seconds to decide whether escape was possible or surrender was the safer choice."},{"time":"30:03","audioTime":1803,"title":"Breakthroughs captured entire formations","detail":"The U.S. assault at the Mule Shoe took about 3,000 Confederates. Prisoners first went to provost guards and holding areas before marching away from the battlefield."},{"time":"33:04","audioTime":1984,"title":"Prisoners entered the armies’ transport systems","detail":"About 7,500 Confederates moved through Grant’s supply corridor toward Point Lookout. Many U.S. prisoners marched to Orange Court House and went by rail toward Andersonville."},{"time":"34:07","audioTime":2047,"title":"The campaign left at least 12,000 dead","detail":"At Spotsylvania and Cold Harbor, soldiers occupied trenches near unburied bodies for days. Immediate burial was often incomplete because the armies moved or remained under fire."},{"time":"35:29","audioTime":2129,"title":"Postwar details recovered scattered remains","detail":"In 1865 Captain J. M. Moore’s detail found bodies that had been buried temporarily, exposed, or never buried. Identification was often impossible after a year outdoors."},{"time":"37:33","audioTime":2253,"title":"Permanent cemeteries replaced battlefield graves","detail":"Union remains were moved to Fredericksburg and Cold Harbor national cemeteries. The current National Park Service count is 15,243 burials at Fredericksburg, at least 85 percent unidentified. Confederate remains went to separate cemeteries established by local memorial associations."}],"command":[{"side":"United States — military and medical administration","color":"blue","branches":[{"commander":"Ulysses S. Grant","command":"General-in-chief","subordinates":"Directed the campaign and changes to the army’s supply and evacuation bases"},{"commander":"George G. Meade","command":"Army of the Potomac","subordinates":"Commanded the field army whose wounded entered the evacuation system"},{"commander":"Thomas A. McParlin","command":"Medical director, Army of the Potomac","subordinates":"Supervised medical officers, enlisted staff, ambulances, and field evacuation"},{"commander":"Montgomery C. Meigs","command":"Quartermaster general","subordinates":"Reorganized transport, buildings, bridges, railroad work, and supplies at Fredericksburg"},{"commander":"Provost guards","command":"Prisoner control","subordinates":"Collected, guarded, and moved captured Confederate soldiers toward Belle Plain and prison camps"}]},{"side":"Confederacy — military and medical administration","color":"red","branches":[{"commander":"Robert E. Lee","command":"Army of Northern Virginia","subordinates":"Commanded the army whose shorter routes connected field hospitals with Richmond’s hospital system"},{"commander":"Army medical officers","command":"Aid stations and field hospitals","subordinates":"Treated Confederate casualties first and also handled U.S. wounded left on the battlefield"},{"commander":"Provost guards","command":"Prisoner control","subordinates":"Moved U.S. prisoners west to Orange Court House and onward by rail"}]}],"people":[{"personId":"ulysses-s-grant","role":"Reviewed the early casualty returns and continued the campaign while the evacuation base moved south"},{"name":"George G. Meade","role":"Commanded the Army of the Potomac and responded to the first report of its severe losses","side":"United States"},{"name":"Thomas A. McParlin","role":"Medical director responsible for the Army of the Potomac’s evacuation and field-hospital system","side":"United States"},{"name":"Montgomery C. Meigs","role":"Quartermaster general sent to repair the evacuation crisis at Fredericksburg","side":"United States"},{"name":"Cornelia Hancock","role":"Nurse who organized care and improvised cots for wounded soldiers in Fredericksburg","side":"United States"},{"name":"Clara Barton","role":"Relief worker who reported Fredericksburg’s conditions to Senator Henry Wilson","side":"United States"},{"name":"William Watson","role":"Surgeon who stayed with about 275 U.S. wounded left in Confederate hands in the Wilderness","side":"United States"},{"name":"Robert E. Lee","role":"Commanded the Army of Northern Virginia and its shorter medical evacuation route toward Richmond","side":"Confederacy","image":"/images/robert-e-lee-1864.jpg","source":"https://www.loc.gov/item/2018666540/"}],"losses":[],"gallery":[{"image":"/images/fredericksburg-wounded-wilderness-1864.jpg","alt":"Wounded soldiers from the Wilderness at Fredericksburg in May 1864","caption":"Wounded U.S. soldiers reached Fredericksburg before an adequate depot hospital and transport system had been organized.","source":"https://www.loc.gov/item/2018666572/"},{"image":"/images/spotsylvania-field-hospital-drawing.jpg","alt":"Drawing of the Fifth Corps field hospital near Spotsylvania Court House","caption":"Field hospitals performed operations and stabilized patients before longer evacuation when transport was available.","source":"https://www.loc.gov/item/2004662323/"},{"image":"/images/cold-harbor-burial-party.jpg","alt":"Burial party recovering remains on the Cold Harbor battlefield","caption":"Burial details returned after the war to recover remains from temporary and scattered battlefield graves.","source":"https://www.loc.gov/item/2002713100/"},{"image":"/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland Campaign route","caption":"The army repeatedly changed bases as it moved south, forcing medical officers to rebuild evacuation routes.","source":"https://www.loc.gov/item/99448882/"}],"sources":[{"label":"Civil War Podcast, episode 495","url":"https://civilwarpodcast.org/2025/06/22/civil-war-podcast-episode-495/"},{"label":"U.S. Army Center of Military History: The Overland Campaign","url":"https://history.army.mil/Publications/Publications-Catalog/Overland-Campaign/"},{"label":"National Park Service: Civil War medicine","url":"https://www.nps.gov/gett/learn/education/a-nation-at-war-traveling-trunk-table-5-the-medical-corps-at-war.htm"},{"label":"National Park Service: history of Spotsylvania Court House","url":"https://www.nps.gov/frsp/learn/historyculture/spotsylvania.htm"},{"label":"National Park Service: Fredericksburg National Cemetery","url":"https://home.nps.gov/frsp/learn/historyculture/natcem.htm"},{"label":"Library of Congress: Overland Campaign map","url":"https://www.loc.gov/item/99448882/"},{"label":"Library of Congress: wounded from the Wilderness at Fredericksburg","url":"https://www.loc.gov/item/2018666572/"},{"label":"Library of Congress: Fifth Corps field hospital drawing","url":"https://www.loc.gov/item/2004662323/"},{"label":"Library of Congress: Cold Harbor burial party","url":"https://www.loc.gov/item/2002713100/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
