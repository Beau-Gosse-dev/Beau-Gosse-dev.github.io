3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"#495- THE OVERLAND CAMPAIGN'S WOUNDED, PRISONERS, & DEAD · Field Companion"}],["$","meta","1",{"name":"description","content":"In which we look at the care of the large numbers of wounded during the Overland Campaign, how both sides dealt with the many enemy soldiers taken captive, and what happened with the dead."}],["$","meta","2",{"property":"og:title","content":"#495- THE OVERLAND CAMPAIGN'S WOUNDED, PRISONERS, & DEAD · Field Companion"}],["$","meta","3",{"property":"og:description","content":"In which we look at the care of the large numbers of wounded during the Overland Campaign, how both sides dealt with the many enemy soldiers taken captive, and what happened with the dead."}],["$","meta","4",{"name":"twitter:card","content":"summary"}],["$","meta","5",{"name":"twitter:title","content":"#495- THE OVERLAND CAMPAIGN'S WOUNDED, PRISONERS, & DEAD · Field Companion"}],["$","meta","6",{"name":"twitter:description","content":"In which we look at the care of the large numbers of wounded during the Overland Campaign, how both sides dealt with the many enemy soldiers taken captive, and what happened with the dead."}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["episodes","495-the-overland-campaign-s-wounded-prisoners-and-dead"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"episodes","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"childr