f:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The campaign and casualty evacuation corridor"}],["$","span",null,{"children":"The campaign moved from the Wilderness through Spotsylvania, the North Anna, and Cold Harbor. Each move required the U.S. Army to alter the route used to remove wounded soldiers and supply the front."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
10:["$","figure","The Wilderness, Spotsylvania, and Fredericksburg",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.95%2C38.08%2C-77.25%2C38.48&layer=mapnik&marker=38.3032%2C-77.4605","title":"The Wilderness, Spotsylvania, and Fredericksburg","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Wilderness, Spotsylvania, and Fredericksburg"}],["$","span",null,{"children":"Wounded soldiers traveled roughly ten miles from the first battlefields to Fredericksburg. The damaged town became a temporary depot hospital before patients continued northeast toward Belle Plain and Aquia Creek."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
11:["$","figure","Fredericksburg to Washington",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.75%2C38.05%2C-76.75%2C39.05&layer=mapnik&marker=38.3032%2C-77.4605","title":"Fredericksburg to Washington","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Fredericksburg to Washington"}],["$","span",null,{"children":"Once roads, bridges, and the railroad were improved, patients moved from Fredericksburg to Belle Plain or Aquia Creek, then traveled by steamer to hospitals in Washington and Alexandria."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
