e:["$","span",null,{"children":"Forces at Corinth"}]
f:["$","strong",null,{"children":"About 120,000 United States troops against about 53,000 effective Confederates"}]
10:["$","small",null,{"children":"The Confederate paper strength was near 75,000, but sickness sharply reduced the number fit for duty."}]
11:["$","div","Confederate withdrawal ruse",{"children":[["$","span",null,{"children":"Confederate withdrawal ruse"}],["$","strong",null,{"children":"Empty trains, staged cheering, bugles, campfires, planted reports, and log “Quaker guns”"}],"$undefined"]}]
12:["$","div","Corinth occupied",{"children":[["$","span",null,{"children":"Corinth occupied"}],["$","strong",null,{"children":"May 30, after Beauregard withdrew toward Tupelo"}],"$undefined"]}]
13:["$","div","Confederate command change",{"children":[["$","span",null,{"children":"Confederate command change"}],["$","strong",null,{"children":"Braxton Bragg replaced Beauregard in June 1862"}],"$undefined"]}]
14:["$","div","Grant’s later conclusion",{"children":[["$","span",null,{"children":"Grant’s later conclusion"}],["$","strong",null,{"children":"Shiloh ended his expectation that the rebellion could be defeated without complete conquest"}],"$undefined"]}]
