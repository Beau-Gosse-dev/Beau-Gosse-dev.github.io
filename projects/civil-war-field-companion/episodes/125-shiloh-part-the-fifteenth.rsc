1d:["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/corinth-halleck-advance-map-1862.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$16:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99447412/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$16:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}]
1e:["$","figure","Shiloh troop positions",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/shiloh-beauregard-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Shiloh troop positions at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-beauregard-map.jpg","alt":"1862 manuscript map of the Battle of Shiloh","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Shiloh troop positions"}],["$","span",null,{"children":"The 1862 manuscript map approved by Beauregard shows the battlefield roads, camps, river landing, and positions from which the two armies began the campaign’s decisive battle."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/shiloh-beauregard-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$16:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/85690890/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$16:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
20:["$","p",null,{"children":"Halleck arrived at Pittsburg Landing on April 11 and assembled the Armies of the Tennessee, Ohio, and Mississippi for the advance on Corinth."}]
21:["$","div","Grant was sidelined as Halleck’s deputy",{"className":"moment","children":[["$","$L1f",null,{"seconds":962,"label":"16:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant was sidelined as Halleck’s deputy"}],["$","p",null,{"children":"Halleck made Grant nominal second-in-command of the combined force but gave him little authority; George H. Thomas led the Army of the Tennessee during the Corinth operation."}]]}]]}]
22:["$","div","Grant remained with the army",{"className":"moment","children":[["$","$L1f",null,{"seconds":1064,"label":"17:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant remained with the army"}],["$","p",null,{"children":"Grant considered leaving the immediate command and later described seeking a leave of absence. Sherman urged him to stay, and Grant resumed an active role after Halleck went to Washington."}]]}]]}]
23:["$","div","The advance on Corinth began",{"className":"moment","children":[["$","$L1f",null,{"seconds":1114,"label":"18:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"The advance on Corinth began"}],["$","p",null,{"children":"Starting April 29, Halleck kept the three armies on a connected front, repeatedly stopping to entrench as they moved toward the railroad junction."}]]}]]}]
24:["$","div","Beauregard concealed his evacuation",{"className":"moment","children":[["$","$L1f",null,{"seconds":1215,"label":"20:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Beauregard concealed his evacuation"}],["$","p",null,{"children":"Confederates used train whistles, cheering, drums, bugles, campfires, false reports, and wooden guns to suggest reinforcements while the army and supplies moved south."}]]}]]}]
25:["$","div","United States troops entered Corinth",{"className":"moment","children":[["$","$L1f",null,{"seconds":1320,"label":"22:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States troops entered Corinth"}],["$","p",null,{"children":"On May 30, Halleck’s patrols found that Beauregard’s main army had withdrawn toward Tupelo, leaving the vital rail junction in United States hands."}]]}]]}]
26:["$","div","Davis replaced Beauregard",{"className":"moment","children":[["$","$L1f",null,{"seconds":1354,"label":"22:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis replaced Beauregard"}],["$","p",null,{"children":"After leaving Corinth, Beauregard took sick leave without prior presidential approval. Davis replaced him with Braxton Bragg in June."}]]}]]}]
27:["$","div","Shiloh changed Grant’s understanding of the war",{"className":"moment","children":[["$","$L1f",null,{"seconds":1416,"label":"23:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shiloh changed Grant’s understanding of the war"}],["$","p",null,{"children":"Grant later wrote that the scale of the fighting and the Confederacy’s determination convinced him that restoring the Union required complete conquest."}]]}]]}]
28:["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Ulysses S. Grant"}],["$","p",null,{"children":"Won at Shiloh, served briefly as Halleck’s deputy, remained in the army, and later described Shiloh as a turning point in his understanding of the war"}]]}]
29:["$","article","P.G.T. Beauregard",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/pgt-beauregard.jpg","alt":"Portrait of P.G.T. Beauregard","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"P.G.T. Beauregard"}],["$","p",null,{"children":"Succeeded Johnston at Shiloh, evacuated Corinth while preserving the army, and was replaced after taking sick leave"}]]}]]}]
2a:["$","article","Jefferson Davis",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/jefferson-davis.jpg","alt":"Portrait of Jefferson Davis","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Jefferson Davis"}],["$","p",null,{"children":"Announced the early reports as a victory, mourned Johnston, blamed Beauregard for lost opportunities, and authorized his replacement"}]]}]]}]
2b:["$","article","Albert Sidney Johnston",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/albert-sidney-johnston.jpg","alt":"Portrait of Albert Sidney Johnston","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Albert Sidney Johnston"}],["$","p",null,{"children":"Planned the offensive against Grant and died while directing the Confederate attack on April 6"}]]}]]}]
