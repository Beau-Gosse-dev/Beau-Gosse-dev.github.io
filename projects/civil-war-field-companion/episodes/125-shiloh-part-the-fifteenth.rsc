f:["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Shiloh casualties",{"children":[["$","th",null,{"scope":"row","children":"Shiloh casualties"}],["$","td",null,{"children":["23,746 killed, wounded, or missing",["$","small",null,{"style":{"display":"block"},"children":"NPS total: 13,047 United States and 10,699 Confederate casualties."}]]}]]}],["$","tr","Halleck’s army group",{"children":[["$","th",null,{"scope":"row","children":"Halleck’s army group"}],["$","td",null,{"children":["Three armies and about 120,000 soldiers on paper",["$","small",null,{"style":{"display":"block"},"children":"The episode describes 16 divisions and more than 108,000 troops assembled in the field; NPS interpretive material gives about 120,000."}]]}]]}],["$","tr","Forces at Corinth",{"children":[["$","th",null,{"scope":"row","children":"Forces at Corinth"}],["$","td",null,{"children":["About 120,000 United States troops against about 53,000 effective Confederates",["$","small",null,{"style":{"display":"block"},"children":"The Confederate paper strength was near 75,000, but sickness sharply reduced the number fit for duty."}]]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2015/09/13/civil-war-podcast-episode-125/",{"href":"https://civilwarpodcast.org/2015/09/13/civil-war-podcast-episode-125/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 125 page"]}],["$","a","https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm",{"href":"https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of Shiloh"]}],["$","a","https://home.nps.gov/articles/000/was-general-grant-surprised-by-the-confederate-attack-at-shiloh.htm",{"href":"https://home.nps.gov/articles/000/was-general-grant-surprised-by-the-confederate-attack-at-shiloh.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Was General Grant Surprised at Shiloh?"]}],["$","a","https://www.nps.gov/shil/planyourvisit/corinth.htm",{"href":"https://www.nps.gov/shil/planyourvisit/corinth.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Corinth Battlefield Unit"]}],["$","a","https://home.nps.gov/articles/000/union-siege-lines-may-19.htm",{"href":"https://home.nps.gov/articles/000/union-siege-lines-may-19.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Union Siege Lines at Corinth"]}],["$","a","https://www.nps.gov/articles/the-siege-and-battle-of-corinth-a-new-kind-of-war-teaching-with-historic-places.htm",{"href":"https://www.nps.gov/articles/the-siege-and-battle-of-corinth-a-new-kind-of-war-teaching-with-historic-places.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Siege and Battle of Corinth"]}],["$","a","https://npgallery.nps.gov/NRHP/GetAsset/NHLS/91001050_text",{"href":"https://npgallery.nps.gov/NRHP/GetAsset/NHLS/91001050_text","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Siege and Battle of Corinth NHL record"]}],["$","a","https://www.nps.gov/places/corinth-tour-2-stop-1-rail-crossover.htm",{"href":"https://www.nps.gov/places/corinth-tour-2-stop-1-rail-crossover.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Corinth rail crossover"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}]]}]
