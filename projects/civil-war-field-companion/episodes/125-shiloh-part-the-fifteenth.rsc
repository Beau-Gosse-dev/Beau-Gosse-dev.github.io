1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",125," · ","April 6–7, 1862, with consequences through June 1862"," · ","Shiloh and Pittsburg Landing, Tennessee; Corinth, Mississippi; and the Mississippi Valley"]}],["$","h1",null,{"children":"SHILOH (Part the Fifteenth)"}],["$","span",null,{"className":"result-label","children":"The United States victory at Shiloh prevented Albert Sidney Johnston’s army from destroying Grant before Buell joined him. Halleck then combined three armies for a methodical advance on Corinth. Beauregard evacuated the railroad junction on the night of May 29–30 and preserved his army, but the loss of Corinth strengthened United States control of West Tennessee and northern Mississippi. Together with the capture of Island No. 10, New Orleans, and Memphis, the campaign opened more of the Mississippi River and broke the Confederacy’s principal east–west railroad connection in the region. Grant endured public criticism and a temporary loss of field authority but remained in the army; Beauregard was replaced by Braxton Bragg in June"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2457831544.mp3?updated=1695211711","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Shiloh casualties",{"children":[["$","span",null,{"children":"Shiloh casualties"}],["$","strong",null,{"children":"23,746 killed, wounded, or missing"}],["$","small",null,{"children":"NPS total: 13,047 United States and 10,699 Confederate casualties."}]]}],["$","div","Confederate objective",{"children":[["$","span",null,{"children":"Confederate objective"}],["$","strong",null,{"children":"Defeat Grant before Buell’s Army of the Ohio completed its junction with him"}],"$undefined"]}],["$","div","Corinth’s importance",{"children":[["$","span",null,{"children":"Corinth’s importance"}],["$","strong",null,{"children":"Junction of the Memphis & Charleston and Mobile & Ohio railroads"}],"$undefined"]}],["$","div","Parallel river gains",{"children":[["$","span",null,{"children":"Parallel river gains"}],["$","strong",null,{"children":"Island No. 10 fell April 7–8; New Orleans was occupied May 1; Memphis fell June 6"}],"$undefined"]}],["$","div","Halleck’s army group",{"children":[["$","span",null,{"children":"Halleck’s army group"}],["$","strong",null,{"children":"Three armies and about 120,000 soldiers on paper"}],["$","small",null,{"children":"The episode describes 16 divisions and more than 108,000 troops assembled in the field; NPS interpretive material gives about 120,000."}]]}],["$","div","Grant’s post-Shiloh role",{"children":[["$","span",null,{"children":"Grant’s post-Shiloh role"}],["$","strong",null,{"children":"Halleck’s deputy, with little independent responsibility"}],"$undefined"]}],["$","div","Siege of Corinth",{"children":[["$","span",null,{"children":"Siege of Corinth"}],["$","strong",null,{"children":"April 29–May 30, 1862"}],"$undefined"]}],["$","div","Forces at Corinth",{"children":["$Le","$Lf","$L10"]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c"]}]]}]
