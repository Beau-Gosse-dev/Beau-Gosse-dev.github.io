ap-image-link","href":"/projects/civil-war-field-companion/images/corinth-halleck-advance-map-1862.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Halleck’s advance on Corinth at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/corinth-halleck-advance-map-1862.jpg","alt":"1862 map of Halleck’s approaches and entrenchments north of Corinth, Mississippi","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Halleck’s advance on Corinth"}],["$","span",null,{"children":"Otto H. Matz’s 1862 map records the roads, railroads, streams, United States approaches, and successive entrenchments between Monterey and Corinth during the month-long advance."}],"$L1d","$undefined"]}]]}],"$L1e"]}]]}]
17:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode begins its assessment of Shiloh",{"className":"moment","children":[["$","$L1f",null,{"seconds":210,"label":"3:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode begins its assessment of Shiloh"}],["$","p",null,{"children":"The fighting had ended, and the discussion turns to the battle’s strategic results and the campaign that followed."}]]}]]}],["$","div","Johnston had sought a decisive battle",{"className":"moment","children":[["$","$L1f",null,{"seconds":226,"label":"3:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston had sought a decisive battle"}],["$","p",null,{"children":"Albert Sidney Johnston attacked near Pittsburg Landing to destroy Grant before Buell’s approaching army could unite with him."}]]}]]}],["$","div","The Confederate offensive failed",{"className":"moment","children":[["$","$L1f",null,{"seconds":401,"label":"6:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate offensive failed"}],["$","p",null,{"children":"Grant’s army survived the surprise attack, Buell joined it, and the combined force drove Beauregard from the field on April 7."}]]}]]}],["$","div","United States victories changed the western theater",{"className":"moment","children":[["$","$L1f",null,{"seconds":417,"label":"6:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States victories changed the western theater"}],["$","p",null,{"children":"Shiloh was followed by the occupation of Corinth and Memphis. Island No. 10 and New Orleans also fell during the spring Mississippi River offensives."}]]}]]}],["$","div","Richmond first received reports of victory",{"className":"moment","children":[["$","$L1f",null,{"seconds":533,"label":"8:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richmond first received reports of victory"}],["$","p",null,{"children":"Telegrams arriving on April 6 presented the Confederate advance as victorious, and Jefferson Davis prepared a message for Congress before the outcome was known."}]]}]]}],["$","div","Davis learned that Johnston was dead",{"className":"moment","children":[["$","$L1f",null,{"seconds":574,"label":"9:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis learned that Johnston was dead"}],["$","p",null,{"children":"Johnston had bled to death after being wounded on April 6. Davis added a eulogy to his congressional message while reports still described the battle as a Confederate success."}]]}]]}],["$","div","The scale of the defeat became clear",{"className":"moment","children":[["$","$L1f",null,{"seconds":615,"label":"10:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The scale of the defeat became clear"}],["$","p",null,{"children":"Beauregard emphasized the gains made on April 6 and attributed the April 7 withdrawal to the larger United States force, but his request for reinforcements showed the army’s condition."}]]}]]}],["$","div","Grant filed a brief official report",{"className":"moment","children":[["$","$L1f",null,{"seconds":752,"label":"12:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant filed a brief official report"}],["$","p",null,{"children":"Grant reported a victory but supplied few details, leaving newspapers to shape much of the early public account of Shiloh."}]]}]]}],["$","div","Newspaper criticism centered on surprise and disorder",{"className":"moment","children":[["$","$L1f",null,{"seconds":803,"label":"13:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Newspaper criticism centered on surprise and disorder"}],["$","p",null,{"children":"Whitelaw Reid’s widely reprinted Cincinnati Gazette account emphasized the lack of fortifications, weak reconnaissance, surprise, and the mass of stragglers below Pittsburg Landing."}]]}]]}],["$","div","Halleck took personal command",{"className":"moment","children":[["$","$L1f",null,{"seconds":931,"label":"15:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck took personal command"}],"$L20"]}]]}],"$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}]]}]
18:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Department of the Mississippi and combined army group",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Mississippi and combined army group"}],["$","span",null,{"children":"Henry W. Halleck"}],["$","small",null,{"children":"Directed the Armies of the Tennessee, Ohio, and Mississippi during the advance on Corinth"}]]}],["$","div","Deputy to Halleck",{"className":"command-entry","children":[["$","strong",null,{"children":"Deputy to Halleck"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Nominal second-in-command of the combined force, with little independent authority"}]]}],["$","div","Army of the Tennessee; right wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Tennessee; right wing"}],["$","span",null,{"children":"George H. Thomas"}],["$","small",null,{"children":"Five divisions, including William T. Sherman’s division on the extreme right"}]]}],["$","div","Army of the Ohio; center",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Ohio; center"}],["$","span",null,{"children":"Don Carlos Buell"}],["$","small",null,{"children":"Advanced over rain-soaked ground while building roads and bridges"}]]}],["$","div","Army of the Mississippi; left wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Mississippi; left wing"}],["$","span",null,{"children":"John Pope"}],["$","small",null,{"children":"Joined Halleck after the capture of New Madrid and Island No. 10"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Overall command at Corinth",{"className":"command-entry","children":[["$","strong",null,{"children":"Overall command at Corinth"}],["$","span",null,{"children":"P.G.T. Beauregard"}],["$","small",null,{"children":"Defended the railroad junction, planned the withdrawal, and evacuated toward Tupelo"}]]}],["$","div","Army of the Mississippi",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Mississippi"}],["$","span",null,{"children":"Braxton Bragg"}],["$","small",null,{"children":"Led the principal Confederate army at Corinth and replaced Beauregard in June"}]]}],["$","div","Army of the West",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the West"}],["$","span",null,{"children":"Earl Van Dorn"}],["$","small",null,{"children":"Reinforced Beauregard from the Trans-Mississippi and held part of the Corinth defenses"}]]}],["$","div","Corps under Beauregard and Bragg",{"className":"command-entry","children":[["$","strong",null,{"children":"Corps under Beauregard and Bragg"}],["$","span",null,{"children":"Leonidas Polk / William J. Hardee"}],["$","small",null,{"children":"Held the defenses and prepared to exploit Van Dorn’s planned May 22 attack before it was canceled"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Henry W. Halleck",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/henry-halleck.jpg","alt":"Portrait of Henry W. Halleck","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Henry W. Halleck"}],["$","p",null,{"children":"Took field command of the three United States armies, sidelined Grant, and directed the advance on Corinth"}]]}]]}],["$","article","Ulysses S. Grant",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","width":420,"height":520,"loading":"lazy"}],"$L28"]}],"$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30"]}]]}]
19:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","General Albert Sidney Johnston",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"General Albert Sidney Johnston"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Army of the Mississippi","."]}]," ","Mortally wounded behind the right knee while directing the attack on April 6; died from blood loss on the battlefield"]}]]}],["$","article","Brigadier General W.H.L. Wallace",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brigadier General W.H.L. Wallace"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 2nd Division, Army of the Tennessee","."]}]," ","Shot through the head during the April 6 withdrawal from the Hornet’s Nest; recovered alive April 7 and died April 10"]}]]}]]}]]}]
1a:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/shiloh-battlefield-april-9.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-battlefield-april-9.jpg","alt":"The Shiloh battlefield photographed on April 9, 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This photograph made two days after the battle records the wooded ground on which more than 23,000 soldiers were killed, wounded, or reported missing."}]]}],["$","figure","/images/corinth-confederate-hospital-1862.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/corinth-confederate-hospital-1862.jpg","alt":"1862 graphite drawing of a Confederate hospital at Corinth, Mississippi","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Adolph Metzner’s 1862 drawing shows a building at Corona Women’s College used as a Confederate hospital. Disease and poor water left nearly one-third of Beauregard’s force unfit for duty during the siege."}]]}],["$","figure","/images/pgt-beauregard.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/pgt-beauregard.jpg","alt":"Wartime portrait of Confederate General P.G.T. Beauregard","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Beauregard preserved his army by abandoning Corinth but lost the strategic rail junction and, soon afterward, his command."}]]}]]}]]}]
