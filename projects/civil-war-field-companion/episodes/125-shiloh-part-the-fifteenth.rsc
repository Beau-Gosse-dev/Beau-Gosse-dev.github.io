18:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","General Albert Sidney Johnston",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"General Albert Sidney Johnston"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Army of the Mississippi","."]}]," ","Mortally wounded behind the right knee while directing the attack on April 6; died from blood loss on the battlefield"]}]]}],["$","article","Brigadier General W.H.L. Wallace",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brigadier General W.H.L. Wallace"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 2nd Division, Army of the Tennessee","."]}]," ","Shot through the head during the April 6 withdrawal from the Hornet’s Nest; recovered alive April 7 and died April 10"]}]]}]]}]]}]
19:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/shiloh-battlefield-april-9.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-battlefield-april-9.jpg","alt":"The Shiloh battlefield photographed on April 9, 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This photograph made two days after the battle records the wooded ground on which more than 23,000 soldiers were killed, wounded, or reported missing."}]]}],["$","figure","/images/corinth-confederate-hospital-1862.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/corinth-confederate-hospital-1862.jpg","alt":"1862 graphite drawing of a Confederate hospital at Corinth, Mississippi","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Adolph Metzner’s 1862 drawing shows a building at Corona Women’s College used as a Confederate hospital. Disease and poor water left nearly one-third of Beauregard’s force unfit for duty during the siege."}]]}],["$","figure","/images/pgt-beauregard.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/pgt-beauregard.jpg","alt":"Wartime portrait of Confederate General P.G.T. Beauregard","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Beauregard preserved his army by abandoning Corinth but lost the strategic rail junction and, soon afterward, his command."}]]}]]}]]}]
