1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",151," · ","May 26–30, 1862"," · ","Lower Shenandoah Valley and its approaches: Harpers Ferry, Halltown, Charles Town, Winchester, Front Royal, Strasburg, Moorefield, and the roads west from Fredericksburg"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: THE HUNTER BECOMES THE HUNTED"}],["$","span",null,{"className":"result-label","children":"Jackson completed his demonstration against Harpers Ferry and began withdrawing toward Winchester, but the Federal attempt to cut his route through Strasburg was still developing when the episode ended. Shields retook Front Royal on May 30 and Frémont approached from the west, placing Jackson’s separated columns in serious danger. No decisive battle or final result occurs within this episode; the escape through Strasburg continues in episode 152"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8861659975.mp3?updated=1695325817","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"May 26 through the night of May 30, 1862"}],["$","small",null,{"children":"The opening reviews the campaign through First Winchester. The ending looks ahead to the threatened closure of Jackson’s escape route on May 31."}]]}],["$","div","Strategic purpose",{"children":[["$","span",null,{"children":"Strategic purpose"}],["$","strong",null,{"children":"Keep United States troops away from Richmond"}],["$","small",null,{"children":"Jackson’s Valley operations forced Washington to retain or redirect formations that otherwise could reinforce George B. McClellan on the Peninsula."}]]}],["$","div","May 26–27",{"children":[["$","span",null,{"children":"May 26–27"}],["$","strong",null,{"children":"Two rest days at Winchester, then a move toward Harpers Ferry"}],["$","small",null,{"children":"Jackson ordered thanksgiving services on May 26. On May 27 he decided to carry out Robert E. Lee’s direction to create the appearance of a threat to the Potomac line."}]]}],["$","div","Stonewall Brigade",{"children":[["$","span",null,{"children":"Stonewall Brigade"}],["$","strong",null,{"children":"Ordered toward Harpers Ferry by way of Charles Town"}],["$","small",null,{"children":"Charles S. Winder’s brigade led the demonstration and later had to hurry back to rejoin the army."}]]}],["$","div","Confederate flank guards",{"children":[["$","span",null,{"children":"Confederate flank guards"}],["$","strong",null,{"children":"12th Georgia at Front Royal; Taylor at Berryville; Ashby to the west; 1st Maryland at Martinsburg"}],["$","small",null,{"children":"The detachments watched routes into Jackson’s exposed flanks and rear while the main body moved north."}]]}],["$","div","Harpers Ferry defense",{"children":[["$","span",null,{"children":"Harpers Ferry defense"}],"$Le","$Lf"]}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}],"$L24","$L25","$L26","$L27",false,"$L28","$L29","$L2a"]}]]}]
2d:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","strong",null,{"children":"About 7,000 United States troops under Brig. Gen. Rufus Saxton"}]
f:["$","small",null,{"children":"This is the episode’s figure. Saxton held commanding ground that included Maryland Heights."}]
10:["$","div","Confederate high-water mark",{"children":[["$","span",null,{"children":"Confederate high-water mark"}],["$","strong",null,{"children":"Loudoun Heights and the approaches to Bolivar Heights"}],["$","small",null,{"children":"By May 29 the Stonewall Brigade occupied Loudoun Heights, while Jackson brought the main body to Halltown within sight of Bolivar Heights."}]]}]
11:["$","div","Warning and confirmation",{"children":[["$","span",null,{"children":"Warning and confirmation"}],["$","strong",null,{"children":"A civilian warned of Shields; Ashby and scouts later confirmed both Federal pincers"}],["$","small",null,{"children":"Jackson initially dismissed the unidentified civilian’s report as rumor. On the night of May 29 he accepted military reports that Frémont was moving toward Strasburg and Shields toward Front Royal."}]]}]
12:["$","div","Federal trap",{"children":[["$","span",null,{"children":"Federal trap"}],["$","strong",null,{"children":"Frémont from the west and Shields from the east, converging toward Strasburg"}],["$","small",null,{"children":"Strasburg controlled Jackson’s direct southward route on the Valley Turnpike."}]]}]
13:["$","div","Federal forces in the episode",{"children":[["$","span",null,{"children":"Federal forces in the episode"}],["$","strong",null,{"children":"Saxton 7,000; Banks 7,000; Frémont 14,800; Shields 11,000; Ord 10,000"}],["$","small",null,{"children":"Those figures sum to 49,800. The episode says “just over 52,000”; the Army Center of Military History also places about 2,000 under Geary east of the Blue Ridge, bringing the wider nearby total to about 51,800. These were approximate strengths spread across the theater."}]]}]
14:["$","div","Jackson’s strength",{"children":[["$","span",null,{"children":"Jackson’s strength"}],["$","strong",null,{"children":"About 16,000 in the episode’s accounting"}],["$","small",null,{"children":"The National Park Service gives approximately 17,000 by late May. Differences reflect rounding and the inclusion or availability of detached troops."}]]}]
15:["$","div","Frémont’s original order",{"children":[["$","span",null,{"children":"Frémont’s original order"}],["$","strong",null,{"children":"Move from Franklin to Harrisonburg"}],["$","small",null,{"children":"The episode gives 41 miles on the map but emphasizes that poor roads, weak horses, bad weather, and an overextended supply line made the direct route impracticable."}]]}]
16:["$","div","Frémont’s chosen route",{"children":[["$","span",null,{"children":"Frémont’s chosen route"}],["$","strong",null,{"children":"Back to Petersburg, then east through Moorefield toward Strasburg"}],["$","small",null,{"children":"He left extra baggage, tents, and knapsacks at Petersburg, replenished ammunition, and issued five days of cooked rations."}]]}]
17:["$","div","Lincoln’s rebuke",{"children":[["$","span",null,{"children":"Lincoln’s rebuke"}],["$","strong",null,{"children":"“You were expressly ordered to march to Harrisonburg. What does this mean?”"}],["$","small",null,{"children":"The episode dates the telegram at 9:58 p.m. after Frémont reached Moorefield. The wording is preserved in the Official Records."}]]}]
18:["$","div","Revised convergence order",{"children":[["$","span",null,{"children":"Revised convergence order"}],["$","strong",null,{"children":"Shields at Front Royal and Frémont at or near Strasburg"}],["$","small",null,{"children":"At noon on May 29 Lincoln directed Frémont to be at Strasburg, or as near it as Jackson could be, by noon May 30. Frémont replied that he could not arrive before 5 p.m. May 31."}]]}]
19:["$","div","Lincoln to McDowell",{"children":[["$","span",null,{"children":"Lincoln to McDowell"}],["$","strong",null,{"children":"“It is for you a question of legs”"}],["$","small",null,{"children":"Lincoln urged maximum speed on May 28. McDowell answered that he was using everything “which legs and steam are capable of.”"}]]}]
1a:["$","div","Shields’s movement",{"children":[["$","span",null,{"children":"Shields’s movement"}],["$","strong",null,{"children":"Departed Fredericksburg on May 26 and pushed rapidly toward Front Royal"}],["$","small",null,{"children":"Edward O. C. Ord’s division followed on a more circuitous route, and George D. Bayard’s cavalry was ordered to use the shortest road."}]]}]
1b:["$","div","May 30 withdrawal",{"children":[["$","span",null,{"children":"May 30 withdrawal"}],["$","strong",null,{"children":"Most of Jackson’s army left the Harpers Ferry front for Winchester"}],["$","small",null,{"children":"Winder remained behind for one final feint, then became the rear guard. Heavy rain and muddy roads slowed the march."}]]}]
1c:["$","div","Jackson’s rail movement",{"children":[["$","span",null,{"children":"Jackson’s rail movement"}],["$","strong",null,{"children":"Charles Town to Winchester by train"}],["$","small",null,{"children":"Alexander R. Boteler recalled that Jackson slept during the trip except when Jedediah Hotchkiss intercepted the train at Stephenson’s Depot."}]]}]
1d:["$","div","Front Royal retaken",{"children":[["$","span",null,{"children":"Front Royal retaken"}],["$","strong",null,{"children":"Nathan Kimball’s brigade arrived about 11:30 a.m. on May 30"}],["$","small",null,{"children":"The 12th Georgia withdrew. Conner’s men burned the road bridge over the South Fork but left the railroad bridge intact."}]]}]
1e:["$","div","Conner arrested",{"children":[["$","span",null,{"children":"Conner arrested"}],["$","strong",null,{"children":"Jackson held him responsible for yielding Front Royal without losses"}],["$","small",null,{"children":"The episode’s dialogue comes from postwar recollection. Conner reported that none of his men had been killed; that statement is not a complete casualty return."}]]}]
1f:["$","div","Night of May 30",{"children":[["$","span",null,{"children":"Night of May 30"}],["$","strong",null,{"children":"Jackson sent Hotchkiss to recall Winder after 10 p.m."}],["$","small",null,{"children":"Hotchkiss later remembered unusual anxiety as Jackson waited in Winchester for the distant Stonewall Brigade."}]]}]
20:["$","div","Race to Strasburg",{"children":[["$","span",null,{"children":"Race to Strasburg"}],["$","strong",null,{"children":"Shields about 12 miles away; Frémont about 20 miles away"}],["$","small",null,{"children":"The episode places Jackson’s main body about 25 miles from Strasburg at Stephenson’s Depot and the Stonewall Brigade nearly twice that distance away. These are approximate nighttime positions."}]]}]
21:["$","div","Casualties and leader losses",{"children":[["$","span",null,{"children":"Casualties and leader losses"}],["$","strong",null,{"children":"No complete loss return; no important leader killed or mortally wounded"}],["$","small",null,{"children":"Conner’s assertion of no men killed does not establish zero wounded, captured, or missing. The episode is dominated by marches, demonstrations, reports, and command decisions."}]]}]
22:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Frémont, Ewell, Staunton, Schenck, Luray, Massanutten, Loudoun Heights, Moorefield, Ord, Conner, Hotchkiss, Boteler, and Strasburg"}],["$","small",null,{"children":"The automated transcript renders several of these names as “Yule,” “Stanton,” “Cenk,” “LeRae,” “Massanet,” “Loudon,” “Moorfield,” “Orr,” “Connor,” “Jedidiah,” “Bodler,” and “Strasbourg.”"}]]}]
23:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“Lens of War: Exploring Iconic Photographs of the Civil War”"}],["$","small",null,{"children":"Edited by J. Matthew Gallman and Gary W. Gallagher."}]]}]
24:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
25:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The Federal pincer and Jackson’s withdrawal",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep151-operational-trap.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The Federal pincer and Jackson’s withdrawal at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep151-operational-trap.svg","alt":"Schematic operational map showing Frémont advancing toward Strasburg, Shields advancing toward Front Royal, and Jackson withdrawing south from Harpers Ferry.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Federal pincer and Jackson’s withdrawal"}],["$","span",null,{"children":"Frémont approached Strasburg from the west while Shields and McDowell’s other detachments moved toward Front Royal from the east. Jackson’s widely separated army began withdrawing from Harpers Ferry through Charles Town and Winchester. Town placement, routes, distances, and arrow timing are approximate. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep151-operational-trap.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Official Records, and Jedediah Hotchkiss map; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Front Royal: the bridges and the open flank",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep151-front-royal-bridges.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Front Royal: the bridges and the open flank at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep151-front-royal-bridges.svg","alt":"Schematic tactical map of Front Royal showing Kimball advancing, the 12th Georgia withdrawing, the road bridge burning, and the railroad bridge intact.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Front Royal: the bridges and the open flank"}],["$","span",null,{"children":"Kimball’s brigade approached from the east late on the morning of May 30. Conner’s 12th Georgia withdrew toward Winchester, burning the road bridge across the South Fork but leaving the railroad bridge usable. The transcript does not establish precise formations or firing lines. The river, bridge spacing, road alignment, and unit footprints are schematic."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep151-front-royal-bridges.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History and Official Records; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Hotchkiss map of the Shenandoah Valley",{"className":"reference-map","children":["$L2b","$L2c"]}]]}]]}]
26:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode resumes after First Winchester",{"className":"moment","children":[["$","$L2d",null,{"seconds":71,"label":"1:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode resumes after First Winchester"}],["$","p",null,{"children":"The hosts pause before continuing the campaign and review how Jackson’s May 25 victory changed the situation in the Lower Valley."}]]}]]}],["$","div","The campaign’s strategic purpose is restated",{"className":"moment","children":[["$","$L2d",null,{"seconds":99,"label":"1:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign’s strategic purpose is restated"}],["$","p",null,{"children":"Confederate operations in the Valley were intended to hold United States troops away from the direct campaign against Richmond."}]]}]]}],["$","div","Kernstown and McDowell are reviewed",{"className":"moment","children":[["$","$L2d",null,{"seconds":155,"label":"2:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kernstown and McDowell are reviewed"}],["$","p",null,{"children":"The tactical defeat at Kernstown helped keep Banks in the Valley, and Jackson later checked Frémont at McDowell."}]]}]]}],["$","div","Front Royal forces Banks from Strasburg",{"className":"moment","children":[["$","$L2d",null,{"seconds":248,"label":"4:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Front Royal forces Banks from Strasburg"}],["$","p",null,{"children":"Jackson’s May 23 success turned Banks’s position and led to the retreat through Winchester and across the Potomac."}]]}]]}],["$","div","Lincoln forms a counterstroke",{"className":"moment","children":[["$","$L2d",null,{"seconds":286,"label":"4:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln forms a counterstroke"}],["$","p",null,{"children":"Banks was to be reinforced in front of Jackson while Frémont and a detachment from McDowell moved toward his rear."}]]}]]}],["$","div","The two jaws receive their objectives",{"className":"moment","children":[["$","$L2d",null,{"seconds":313,"label":"5:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"The two jaws receive their objectives"}],["$","p",null,{"children":"Frémont was directed toward Harrisonburg from the west, while McDowell’s troops were sent through Front Royal toward Strasburg."}]]}]]}],["$","div","Jackson grants rest and thanksgiving",{"className":"moment","children":[["$","$L2d",null,{"seconds":358,"label":"5:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson grants rest and thanksgiving"}],["$","p",null,{"children":"On May 26 the Valley Army rested at Winchester. Chaplains held services at 4 p.m., and Jackson worshiped with the 33rd Virginia."}]]}]]}],["$","div","A second rest day follows",{"className":"moment","children":[["$","$L2d",null,{"seconds":401,"label":"6:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"A second rest day follows"}],["$","p",null,{"children":"On May 27 Jackson considered how far north to advance while Lee’s May 16 direction remained in force."}]]}]]}],["$","div","Lee’s directive guides the demonstration",{"className":"moment","children":[["$","$L2d",null,{"seconds":419,"label":"6:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s directive guides the demonstration"}],["$","p",null,{"children":"Jackson had driven Banks toward the Potomac and now sought to create the impression that the Confederate army threatened that line."}]]}]]}],["$","div","The Stonewall Brigade moves toward Harpers Ferry",{"className":"moment","children":[["$","$L2d",null,{"seconds":442,"label":"7:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Stonewall Brigade moves toward Harpers Ferry"}],["$","p",null,{"children":"Winder’s brigade received orders to march by way of Charles Town on the morning of May 28."}]]}]]}],["$","div","The 12th Georgia guards Front Royal",{"className":"moment","children":[["$","$L2d",null,{"seconds":465,"label":"7:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 12th Georgia guards Front Royal"}],["$","p",null,{"children":"Conner was told to protect the bridges over the forks of the Shenandoah and destroy them if forced out."}]]}]]}],"$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51","$L52","$L53"]}]]}]
27:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","National strategic direction",{"className":"command-entry","children":[["$","strong",null,{"children":"National strategic direction"}],["$","span",null,{"children":"President Abraham Lincoln / Secretary of War Edwin M. Stanton"}],["$","small",null,{"children":"Issued separate orders to Frémont, McDowell, Banks, and Saxton and attempted to coordinate the converging columns without appointing one field commander over the operation"}]]}],["$","div","Department of the Rappahannock",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Rappahannock"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Directed the eastern jaw from Manassas Junction; sent Shields toward Front Royal, Ord in support, and Bayard’s cavalry by the shortest available road"}]]}],["$","div","Division from McDowell’s force",{"className":"command-entry","children":[["$","strong",null,{"children":"Division from McDowell’s force"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"Approximately 11,000 in the episode; pushed west toward Front Royal with Nathan Kimball’s brigade leading"}]]}],["$","div","Lead brigade of Shields’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Lead brigade of Shields’s division"}],["$","span",null,{"children":"Brig. Gen. Nathan Kimball"}],["$","small",null,{"children":"Completed an overnight march and retook Front Royal late on the morning of May 30"}]]}],["$","div","Supporting division from McDowell’s force",{"className":"command-entry","children":[["$","strong",null,{"children":"Supporting division from McDowell’s force"}],["$","span",null,{"children":"Brig. Gen. Edward O. C. Ord"}],["$","small",null,{"children":"Approximately 10,000 in the episode; followed Shields on a more circuitous route"}]]}],["$","div","Cavalry brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry brigade"}],["$","span",null,{"children":"Brig. Gen. George D. Bayard"}],["$","small",null,{"children":"Ordered to hurry toward Front Royal by the shortest road"}]]}],["$","div","Mountain Department",{"className":"command-entry","children":[["$","strong",null,{"children":"Mountain Department"}],["$","span",null,{"children":"Maj. Gen. John C. Frémont"}],["$","small",null,{"children":"Approximately 14,800 in the episode; moved from Franklin through Petersburg and Moorefield toward Strasburg rather than taking the prescribed route to Harrisonburg"}]]}],["$","div","Harpers Ferry garrison",{"className":"command-entry","children":[["$","strong",null,{"children":"Harpers Ferry garrison"}],["$","span",null,{"children":"Brig. Gen. Rufus Saxton"}],["$","small",null,{"children":"Approximately 7,000 in the episode; occupied Maryland Heights and other strong ground against Jackson’s demonstration"}]]}],["$","div","Department of the Shenandoah",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Shenandoah"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Reinforced at Williamsport to about 7,000 in the episode and sent patrols back across the Potomac"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Valley District and combined Valley Army",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District and combined Valley Army"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Approximately 16,000 in the episode; directed the Harpers Ferry demonstration, distributed flank guards, and ordered the withdrawal toward Winchester"}]]}],"$L54","$L55","$L56","$L57","$L58","$L59","$L5a"]]}]]}],"$L5b","$L5c"]}]
28:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep151-operational-trap.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep151-operational-trap.svg","alt":"Schematic map of the converging Federal columns and Jackson’s withdrawal from Harpers Ferry.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Strasburg was the operational hinge. Frémont approached from the west while Shields moved through Front Royal, and Jackson had to pull separated detachments south before the route closed."}]]}],["$","figure","/images/ep151-front-royal-bridges.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep151-front-royal-bridges.svg","alt":"Schematic tactical map showing the May 30 advance into Front Royal and the two South Fork bridges.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Conner’s men burned the road bridge during their withdrawal but left the railroad bridge intact. The diagram is schematic because the transcript does not establish exact firing lines or formation positions."}]]}],["$","figure","/images/ep151-harpers-ferry.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep151-harpers-ferry.jpg","alt":"Civil War-era photograph of Harpers Ferry, its railroad, river gap, and Bolivar Heights.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A wartime view of Harpers Ferry and Bolivar Heights. Saxton’s fortified position used the commanding terrain around the Potomac and Shenandoah junction."}]]}],["$","figure","/images/ep151-hotchkiss-valley-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep151-hotchkiss-valley-map.jpg","alt":"Historical Hotchkiss map of the Shenandoah Valley and surrounding mountain corridors.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The published Hotchkiss map shows the geographic system behind the campaign. It provides historical context but does not depict the movements of May 26–30."}]]}],["$","figure","/images/ep151-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep151-stonewall-jackson.jpg","alt":"Photographic portrait from life of Confederate general Thomas J. Stonewall Jackson.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson pressed the Harpers Ferry demonstration after learning that United States columns were approaching his rear, then ordered a difficult withdrawal in heavy rain."}]]}],["$","figure","/images/ep151-john-fremont.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep151-john-fremont.jpg","alt":"Civil War-era photographic portrait of United States general John C. Frémont in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Frémont took an indirect but supplied route through Petersburg and Moorefield. Lincoln regarded the deviation as disobedience; the episode argues that the prescribed mountain route was not operationally feasible."}]]}],["$","figure","/images/ep151-irvin-mcdowell.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep151-irvin-mcdowell.jpg","alt":"Civil War-era photographic portrait of United States general Irvin McDowell in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"McDowell hurried Shields, Ord, and Bayard toward Front Royal while warning that the diversion weakened the larger movement against Richmond."}]]}],"$L5d"]}]]}]
