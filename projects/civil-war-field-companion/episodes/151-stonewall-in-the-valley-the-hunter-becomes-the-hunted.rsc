2f:["$","div","Saxton is ready at Harpers Ferry",{"className":"moment","children":[["$","$L2d",null,{"seconds":524,"label":"8:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Saxton is ready at Harpers Ferry"}],["$","p",null,{"children":"The episode gives his garrison as 7,000 and describes Maryland Heights as part of the strong defensive position."}]]}]]}]
30:["$","div","Confederates occupy Loudoun Heights",{"className":"moment","children":[["$","$L2d",null,{"seconds":543,"label":"9:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates occupy Loudoun Heights"}],["$","p",null,{"children":"By May 29 the Stonewall Brigade had advanced close to town and held the height east of the Shenandoah."}]]}]]}]
31:["$","div","The main body advances to Halltown",{"className":"moment","children":[["$","$L2d",null,{"seconds":575,"label":"9:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"The main body advances to Halltown"}],["$","p",null,{"children":"Jackson moved north from Winchester to a position within sight of Bolivar Heights."}]]}]]}]
32:["$","div","A civilian warns of Shields",{"className":"moment","children":[["$","$L2d",null,{"seconds":596,"label":"9:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"A civilian warns of Shields"}],["$","p",null,{"children":"After a twelve-hour ride, an unidentified older man reported Shields a day from Front Royal. Jackson dismissed the warning as rumor."}]]}]]}]
33:["$","div","Military reports confirm the danger",{"className":"moment","children":[["$","$L2d",null,{"seconds":625,"label":"10:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Military reports confirm the danger"}],["$","p",null,{"children":"Ashby reported Frémont moving toward Strasburg, and scouts east of the Blue Ridge confirmed Shields’s advance."}]]}]]}]
34:["$","div","The hunter becomes the hunted",{"className":"moment","children":[["$","$L2d",null,{"seconds":650,"label":"10:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"The hunter becomes the hunted"}],["$","p",null,{"children":"Jackson recognized that Federal columns threatened his rear while Saxton and Banks remained to his front and north."}]]}]]}]
35:["$","div","The episode compares the available forces",{"className":"moment","children":[["$","$L2d",null,{"seconds":660,"label":"11:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode compares the available forces"}],["$","p",null,{"children":"It places about 52,000 United States troops in the wider area against roughly 16,000 Confederates, though its five major Federal figures total 49,800."}]]}]]}]
36:["$","div","The map plan meets field conditions",{"className":"moment","children":[["$","$L2d",null,{"seconds":715,"label":"11:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"The map plan meets field conditions"}],["$","p",null,{"children":"Distance, roads, supply, weather, and command friction complicated the planned convergence of independent Federal commands."}]]}]]}]
37:["$","div","Frémont is ordered to Harrisonburg",{"className":"moment","children":[["$","$L2d",null,{"seconds":733,"label":"12:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Frémont is ordered to Harrisonburg"}],["$","p",null,{"children":"The direct map distance from Franklin is given as 41 miles, but his supply line and the mountain road made that route impracticable."}]]}]]}]
38:["$","div","Frémont chooses Petersburg and Moorefield",{"className":"moment","children":[["$","$L2d",null,{"seconds":808,"label":"13:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Frémont chooses Petersburg and Moorefield"}],["$","p",null,{"children":"He retraced his supply line, resupplied at Petersburg, and moved east through Moorefield toward Strasburg."}]]}]]}]
39:["$","div","Frémont reaches Moorefield",{"className":"moment","children":[["$","$L2d",null,{"seconds":864,"label":"14:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Frémont reaches Moorefield"}],["$","p",null,{"children":"The episode places him there by the evening of May 27 after extra baggage had been stripped and five days of cooked rations issued."}]]}]]}]
3a:["$","div","Lincoln demands an explanation",{"className":"moment","children":[["$","$L2d",null,{"seconds":877,"label":"14:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln demands an explanation"}],["$","p",null,{"children":"The president’s 9:58 p.m. telegram asked why Frémont was at Moorefield after being expressly ordered to Harrisonburg."}]]}]]}]
3b:["$","div","Lincoln sets a place and time",{"className":"moment","children":[["$","$L2d",null,{"seconds":944,"label":"15:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln sets a place and time"}],["$","p",null,{"children":"At noon on May 29 he asked Frémont to reach Strasburg, or an equally close point, by noon the next day."}]]}]]}]
3c:["$","div","Frémont cannot meet the deadline",{"className":"moment","children":[["$","$L2d",null,{"seconds":990,"label":"16:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Frémont cannot meet the deadline"}],["$","p",null,{"children":"He estimated that exhaustion, weak horses, poor terrain, and rain would delay arrival near Strasburg until 5 p.m. on May 31."}]]}]]}]
3d:["$","div","Lincoln expects McDowell to be sufficient",{"className":"moment","children":[["$","$L2d",null,{"seconds":1034,"label":"17:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln expects McDowell to be sufficient"}],["$","p",null,{"children":"Even without prompt help from Frémont, the president regarded McDowell’s 20,000-man detachment as capable of defeating Jackson."}]]}]]}]
3e:["$","div","Shields marches back toward the Valley",{"className":"moment","children":[["$","$L2d",null,{"seconds":1119,"label":"18:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shields marches back toward the Valley"}],["$","p",null,{"children":"Shields left on May 26 despite his displeasure with the reversal. Ord’s division also moved, but by a longer route."}]]}]]}]
3f:["$","div","Lincoln calls it a question of legs",{"className":"moment","children":[["$","$L2d",null,{"seconds":1150,"label":"19:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln calls it a question of legs"}],["$","p",null,{"children":"On May 28 he urged McDowell to use all possible speed because Jackson and Ewell appeared to remain near Winchester."}]]}]]}]
40:["$","div","McDowell promises legs and steam",{"className":"moment","children":[["$","$L2d",null,{"seconds":1175,"label":"19:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"McDowell promises legs and steam"}],["$","p",null,{"children":"He reported that rail and marching columns were being hurried forward despite an expected wagon shortage beyond the railroad."}]]}]]}]
41:["$","div","Shields promises Front Royal",{"className":"moment","children":[["$","$L2d",null,{"seconds":1202,"label":"20:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shields promises Front Royal"}],["$","p",null,{"children":"On May 29 Shields told McDowell that he would start early and reach Front Royal by evening; Ord was ordered to support him."}]]}]]}]
42:["$","div","Bayard’s cavalry receives the shortest road",{"className":"moment","children":[["$","$L2d",null,{"seconds":1221,"label":"20:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bayard’s cavalry receives the shortest road"}],["$","p",null,{"children":"McDowell ordered the mounted brigade toward Front Royal with all possible haste."}]]}]]}]
43:["$","div","The podcast judges the Richmond diversion",{"className":"moment","children":[["$","$L2d",null,{"seconds":1234,"label":"20:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"The podcast judges the Richmond diversion"}],["$","p",null,{"children":"The hosts argue that suspending McDowell’s movement toward McClellan served the Confederate strategic purpose."}]]}]]}]
44:["$","div","May 30 brings more grim reports",{"className":"moment","children":[["$","$L2d",null,{"seconds":1371,"label":"22:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"May 30 brings more grim reports"}],["$","p",null,{"children":"Couriers told Jackson that Shields and Frémont were closing on Front Royal and Strasburg, while Banks sent patrols across the Potomac."}]]}]]}]
45:["$","div","Jackson sustains the bluff",{"className":"moment","children":[["$","$L2d",null,{"seconds":1398,"label":"23:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson sustains the bluff"}],["$","p",null,{"children":"He continued movements suggesting an attack on Harpers Ferry even as the danger to his rear increased."}]]}]]}]
46:["$","div","The withdrawal begins",{"className":"moment","children":[["$","$L2d",null,{"seconds":1418,"label":"23:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The withdrawal begins"}],["$","p",null,{"children":"On Friday afternoon most of the army started toward Winchester. Winder remained for one last feint and then covered the rear."}]]}]]}]
47:["$","div","Heavy rain catches the marching army",{"className":"moment","children":[["$","$L2d",null,{"seconds":1446,"label":"24:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Heavy rain catches the marching army"}],["$","p",null,{"children":"The Confederates moved through mud while rumors of the converging Federal columns spread through the ranks."}]]}]]}]
48:["$","div","A chaplain remembers the race",{"className":"moment","children":[["$","$L2d",null,{"seconds":1477,"label":"24:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"A chaplain remembers the race"}],["$","p",null,{"children":"J. William Jones later described repeated orders to press farther despite exhaustion as the army hurried toward Strasburg."}]]}]]}]
49:["$","div","Jackson takes the train",{"className":"moment","children":[["$","$L2d",null,{"seconds":1508,"label":"25:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson takes the train"}],["$","p",null,{"children":"He rode from Charles Town toward Winchester and slept for most of the trip, according to Alexander Boteler."}]]}]]}]
4a:["$","div","Hotchkiss intercepts the train",{"className":"moment","children":[["$","$L2d",null,{"seconds":1532,"label":"25:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hotchkiss intercepts the train"}],["$","p",null,{"children":"At Stephenson’s Depot the mapmaker delivered Conner’s report that the 12th Georgia had been driven from Front Royal."}]]}]]}]
4b:["$","div","Kimball retakes Front Royal",{"className":"moment","children":[["$","$L2d",null,{"seconds":1581,"label":"26:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kimball retakes Front Royal"}],["$","p",null,{"children":"An all-night march placed Shields’s lead brigade outside the town around 11:30 a.m. on May 30."}]]}]]}]
4c:["$","div","Conner withdraws and one bridge survives",{"className":"moment","children":[["$","$L2d",null,{"seconds":1609,"label":"26:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Conner withdraws and one bridge survives"}],["$","p",null,{"children":"The Georgians fired the road bridge over the South Fork but failed to burn the parallel railroad bridge."}]]}]]}]
4d:["$","div","Jackson questions Conner",{"className":"moment","children":[["$","$L2d",null,{"seconds":1626,"label":"27:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson questions Conner"}],["$","p",null,{"children":"At Winchester, Jackson challenged the colonel’s account after learning that Conner reported no men killed."}]]}]]}]
4e:["$","div","Conner is placed under arrest",{"className":"moment","children":[["$","$L2d",null,{"seconds":1664,"label":"27:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Conner is placed under arrest"}],["$","p",null,{"children":"Staff officer Alexander “Sandy” Pendleton stopped the colonel after he left Jackson’s office."}]]}]]}]
4f:["$","div","Hotchkiss rides back for Winder",{"className":"moment","children":[["$","$L2d",null,{"seconds":1711,"label":"28:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hotchkiss rides back for Winder"}],["$","p",null,{"children":"After 10 p.m. Jackson sent him through the storm to bring the distant Stonewall Brigade toward Winchester at maximum speed."}]]}]]}]
50:["$","div","Jackson’s army is dangerously separated",{"className":"moment","children":[["$","$L2d",null,{"seconds":1760,"label":"29:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s army is dangerously separated"}],["$","p",null,{"children":"Hotchkiss recalled exceptional anxiety as Jackson waited for Winder while the two Federal columns approached the line of retreat."}]]}]]}]
51:["$","div","The distances favor the Federal trap",{"className":"moment","children":[["$","$L2d",null,{"seconds":1785,"label":"29:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The distances favor the Federal trap"}],["$","p",null,{"children":"The episode places Shields 12 miles and Frémont 20 miles from Strasburg, Jackson’s main body 25 miles away, and Winder nearly twice that distance."}]]}]]}]
52:["$","div","Saxton and Banks add pressure",{"className":"moment","children":[["$","$L2d",null,{"seconds":1834,"label":"30:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Saxton and Banks add pressure"}],["$","p",null,{"children":"Saxton remained behind the Harpers Ferry defenses, but Banks appeared capable of returning across the Potomac."}]]}]]}]
53:["$","div","The book recommendation",{"className":"moment","children":[["$","$L2d",null,{"seconds":1864,"label":"31:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The book recommendation"}],["$","p",null,{"children":"The hosts recommend “Lens of War,” a collection of essays in which historians interpret selected Civil War photographs."}]]}]]}]
