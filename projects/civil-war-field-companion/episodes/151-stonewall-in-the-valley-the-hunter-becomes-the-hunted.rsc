2f:["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Valley District and combined Valley Army-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District and combined Valley Army"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Approximately 16,000 in the episode; directed the Harpers Ferry demonstration, distributed flank guards, and ordered the withdrawal toward Winchester"}]]}],["$","div","Division in Jackson’s army-Maj. Gen. Richard S. Ewell",{"className":"command-entry","children":[["$","strong",null,{"children":"Division in Jackson’s army"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Part of the main Confederate force moving north from Winchester and then back toward the Valley Turnpike"}]]}],["$","div","Stonewall Brigade-Brig. Gen. Charles S. Winder",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Brig. Gen. Charles S. Winder"}],["$","small",null,{"children":"Led the demonstration closest to Harpers Ferry, made a final May 30 feint, and then covered the army’s withdrawal"}]]}],["$","div","Louisiana Brigade-Brig. Gen. Richard Taylor",{"className":"command-entry","children":[["$","strong",null,{"children":"Louisiana Brigade"}],["$","span",null,{"children":"Brig. Gen. Richard Taylor"}],["$","small",null,{"children":"Detached to Berryville to watch the road into the Valley from Leesburg"}]]}],["$","div","Valley Army cavalry-Col. Turner Ashby",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley Army cavalry"}],["$","span",null,{"children":"Col. Turner Ashby"}],["$","small",null,{"children":"Watched Frémont west of the Valley and reported that his column was moving toward Strasburg"}]]}],["$","div","12th Georgia Infantry at Front Royal-Col. Zephaniah T. Conner",{"className":"command-entry","children":[["$","strong",null,{"children":"12th Georgia Infantry at Front Royal"}],["$","span",null,{"children":"Col. Zephaniah T. Conner"}],["$","small",null,{"children":"Guarded the Shenandoah bridges, withdrew before Kimball on May 30, burned the road bridge, and was arrested after reporting to Jackson"}]]}],["$","div","1st Maryland Infantry-Col. Bradley T. Johnson",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Maryland Infantry"}],["$","span",null,{"children":"Col. Bradley T. Johnson"}],["$","small",null,{"children":"Detached to occupy Martinsburg, watch for Banks, and collect Federal stores left in the town"}]]}],["$","div","Jackson’s staff-Capt. Jedediah Hotchkiss / Lt. Alexander “Sandy” Pendleton",{"className":"command-entry","children":[["$","strong",null,{"children":"Jackson’s staff"}],["$","span",null,{"children":"Capt. Jedediah Hotchkiss / Lt. Alexander “Sandy” Pendleton"}],["$","small",null,{"children":"Hotchkiss carried urgent information and recalled Winder; Pendleton handled reports and placed Conner under arrest"}]]}]]]}]
