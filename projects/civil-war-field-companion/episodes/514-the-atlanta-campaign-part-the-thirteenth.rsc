hildren":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"Late May–June 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"North Georgia, Alabama, Mississippi, and Tennessee"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Both armies adopted extensive fieldworks; Johnston’s command relationships deteriorated; no major cavalry raid broke Sherman’s railroad"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"Late May–June 1864","place":"North Georgia, Alabama, Mississippi, and Tennessee","result":"Both armies adopted extensive fieldworks; Johnston’s command relationships deteriorated; no major cavalry raid broke Sherman’s railroad","facts":[{"label":"Fieldworks","value":"Built whenever either army stopped"},{"label":"U.S. distance from Atlanta","value":"About 25 miles by early June"},{"label":"Confederate cavalry reported","value":"About 8,000 present; about 2,400 classified effective"},{"label":"Railroad raid result","value":"No sustained break in Sherman’s supply line"}],"maps":[{"title":"Atlanta campaign and railroad supply line","caption":"The map shows Sherman’s advance along the Western and Atlantic Railroad from Chattanooga toward Atlanta.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of the Atlanta campaign and railroad route"},{"title":"Fieldworks at Atlanta","caption":"A wartime photograph of Confederate earthworks shows the earth-and-timber construction used throughout the later campaign.","source":"https://www.loc.gov/item/2018670937/","image":"/images/atlanta-fortifications.jpg","alt":"Confederate earthwork fortifications at Atlanta in 1864"},{"title":"The western theater today","caption":"Johnston wanted cavalry from Mississippi and Alabama to strike the railroad through Tennessee and north Georgia.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-91%2C30%2C-81%2C36&layer=mapnik&marker=34.77%2C-84.97"}],"moments":[{"time":"1:19","audioTime":79,"title":"Three changes reshaped the campaign","detail":"The episode covers extensive fieldworks, Johnston’s changing relationships with Hood and Hardee, and the dispute over cavalry raids against Sherman’s railroad."},{"time":"3:04","audioTime":184,"title":"Both armies expanded their field defenses","detail":"Close contact after New Hope Church produced continuous sharpshooting, artillery fire, limited attacks, and immediate digging."},{"time":"5:38","audioTime":338,"title":"Soldiers built trenches under fire","detail":"They used available tools, plates, boards, bayonets, and their hands, piling excavated earth toward the enemy."},{"time":"6:21","audioTime":381,"title":"Head logs protected firing positions","detail":"Green logs rested on skids above the parapet, with openings beneath for soldiers to fire through."},{"time":"7:34","audioTime":454,"title":"Obstacles covered the approach","detail":"Defenders cleared fields of fire, built abatis from felled trees, sometimes added telegraph wire, and placed forward rifle pits."},{"time":"10:42","audioTime":642,"title":"Johnston lost confidence in Hood","detail":"Hood had not produced the expected results and criticized Johnston to contacts in Richmond."},{"time":"12:47","audioTime":767,"title":"Johnston’s opinion of Hardee improved","detail":"Johnston praised Hardee’s battlefield conduct and advice. The two later became professional allies."},{"time":"14:20","audioTime":860,"title":"Johnston’s original strategy had failed","detail":"The army repulsed some attacks but won no decisive battle and repeatedly withdrew as Sherman maneuvered south."},{"time":"19:07","audioTime":1147,"title":"Johnston adopted an inflated casualty estimate","detail":"His staff estimated more than 45,000 U.S. casualties, more than twice the actual figure, and concluded Sherman was being worn down."},{"time":"21:42","audioTime":1302,"title":"Returning to the railroad solved U.S. supply problems","detail":"Shortages during the movement near Dallas ended once Sherman reconnected with the Western and Atlantic."},{"time":"22:26","audioTime":1346,"title":"Johnston focused on breaking the railroad","detail":"He believed a long interruption might force Sherman to retreat or attack prepared defenses directly."},{"time":"24:08","audioTime":1448,"title":"Johnston did not detach his own main cavalry force","detail":"He believed the army was outnumbered and wanted cavalry in Alabama and Mississippi to attack the railroad instead."},{"time":"25:42","audioTime":1542,"title":"Stephen D. Lee controlled the western cavalry","detail":"Johnston lacked authority over forces in Alabama and Mississippi and needed Lee or Richmond to approve the operation."},{"time":"26:39","audioTime":1599,"title":"Sherman kept Forrest occupied","detail":"U.S. raids from Memphis drew Nathan Bedford Forrest into repeated defensive operations in Mississippi."},{"time":"29:42","audioTime":1782,"title":"Richmond and Johnston disputed who should raid","detail":"Davis and Bragg questioned why Johnston’s cavalry could not do the job. Johnston provided little operational detail."},{"time":"30:25","audioTime":1825,"title":"Most Confederate cavalrymen lacked horses","detail":"Of more than 8,000 reported present, only about 2,400 were classified effective. Joseph Wheeler nevertheless claimed he could attack the railroad."},{"time":"31:01","audioTime":1861,"title":"The dispute produced no major raid","detail":"Distrust between Johnston and Davis prevented a coordinated decision, and Sherman’s railroad remained usable."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Controlled U.S. forces across the western theater"},{"commander":"James B. McPherson, George H. Thomas, and John M. Schofield","command":"Three field armies","subordinates":"Advanced toward Atlanta and built fieldworks"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army and Department of Tennessee","subordinates":"Hood, Hardee, and Wheeler"},{"commander":"John B. Hood","command":"Corps commander","subordinates":"Increasingly opposed Johnston"},{"commander":"William J. Hardee","command":"Corps commander","subordinates":"Became Johnston’s ally"},{"commander":"Joseph Wheeler","command":"Army of Tennessee Cavalry Corps","subordinates":"Asked to raid Sherman’s railroad"},{"commander":"Stephen D. Lee","command":"Department of Alabama, Mississippi, and East Louisiana","subordinates":"Nathan Bedford Forrest and western cavalry"}]}],"people":[{"name":"Joseph E. Johnston","role":"Developed the railroad-raiding plan but failed to secure a coordinated operation","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"John B. Hood","role":"Corps commander whose relationship with Johnston deteriorated","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"William J. Hardee","role":"Corps commander whose relationship with Johnston improved","side":"Confederacy"},{"name":"Joseph Wheeler","role":"Cavalry chief who claimed his troops could attack Sherman’s railroad","side":"Confederacy"},{"personId":"nathan-bedford-forrest","role":"Defeated U.S. raids in Mississippi but could not simultaneously attack Sherman’s supply line"},{"name":"Jefferson Davis","role":"Confederate president who disputed Johnston’s proposed use of western cavalry","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/atlanta-fortifications.jpg","alt":"Confederate earthwork fortifications at Atlanta","caption":"Earth, logs, firing positions, and obstacles became routine parts of the campaign.","source":"https://www.loc.gov/item/2018670937/"},{"image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of the Atlanta campaign","caption":"The railroad from Chattanooga was Sherman’s essential supply route.","source":"https://www.loc.gov/item/2008628278/"}],"sources":[{"label":"Official Episode 514 page","url":"https://civilwarpodcast.org/2025/12/21/civil-war-podcast-episode-514/"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"Library of Congress Atlanta fortifications photograph","url":"https://www.loc.gov/item/2018670937/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
