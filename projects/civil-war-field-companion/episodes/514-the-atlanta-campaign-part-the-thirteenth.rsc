16:["$","div","Johnston did not detach his own main cavalry force",{"className":"moment","children":[["$","$L15",null,{"seconds":1448,"label":"24:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston did not detach his own main cavalry force"}],["$","p",null,{"children":"He believed the army was outnumbered and wanted cavalry in Alabama and Mississippi to attack the railroad instead."}]]}]]}]
17:["$","div","Stephen D. Lee controlled the western cavalry",{"className":"moment","children":[["$","$L15",null,{"seconds":1542,"label":"25:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stephen D. Lee controlled the western cavalry"}],["$","p",null,{"children":"Johnston lacked authority over forces in Alabama and Mississippi and needed Lee or Richmond to approve the operation."}]]}]]}]
18:["$","div","Sherman kept Forrest occupied",{"className":"moment","children":[["$","$L15",null,{"seconds":1599,"label":"26:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman kept Forrest occupied"}],["$","p",null,{"children":"U.S. raids from Memphis drew Nathan Bedford Forrest into repeated defensive operations in Mississippi."}]]}]]}]
19:["$","div","Richmond and Johnston disputed who should raid",{"className":"moment","children":[["$","$L15",null,{"seconds":1782,"label":"29:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richmond and Johnston disputed who should raid"}],["$","p",null,{"children":"Davis and Bragg questioned why Johnston’s cavalry could not do the job. Johnston provided little operational detail."}]]}]]}]
1a:["$","div","Most Confederate cavalrymen lacked horses",{"className":"moment","children":[["$","$L15",null,{"seconds":1825,"label":"30:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Most Confederate cavalrymen lacked horses"}],["$","p",null,{"children":"Of more than 8,000 reported present, only about 2,400 were classified effective. Joseph Wheeler nevertheless claimed he could attack the railroad."}]]}]]}]
1b:["$","div","The dispute produced no major raid",{"className":"moment","children":[["$","$L15",null,{"seconds":1861,"label":"31:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"The dispute produced no major raid"}],["$","p",null,{"children":"Distrust between Johnston and Davis prevented a coordinated decision, and Sherman’s railroad remained usable."}]]}]]}]
