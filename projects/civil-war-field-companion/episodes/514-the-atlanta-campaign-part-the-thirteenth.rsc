10:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Three changes reshaped the campaign",{"className":"moment","children":[["$","$L15",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Three changes reshaped the campaign"}],["$","p",null,{"children":"The episode covers extensive fieldworks, Johnston’s changing relationships with Hood and Hardee, and the dispute over cavalry raids against Sherman’s railroad."}]]}]]}],["$","div","Both armies expanded their field defenses",{"className":"moment","children":[["$","$L15",null,{"seconds":184,"label":"3:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both armies expanded their field defenses"}],["$","p",null,{"children":"Close contact after New Hope Church produced continuous sharpshooting, artillery fire, limited attacks, and immediate digging."}]]}]]}],["$","div","Soldiers built trenches under fire",{"className":"moment","children":[["$","$L15",null,{"seconds":338,"label":"5:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Soldiers built trenches under fire"}],["$","p",null,{"children":"They used available tools, plates, boards, bayonets, and their hands, piling excavated earth toward the enemy."}]]}]]}],["$","div","Head logs protected firing positions",{"className":"moment","children":[["$","$L15",null,{"seconds":381,"label":"6:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Head logs protected firing positions"}],["$","p",null,{"children":"Green logs rested on skids above the parapet, with openings beneath for soldiers to fire through."}]]}]]}],["$","div","Obstacles covered the approach",{"className":"moment","children":[["$","$L15",null,{"seconds":454,"label":"7:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Obstacles covered the approach"}],["$","p",null,{"children":"Defenders cleared fields of fire, built abatis from felled trees, sometimes added telegraph wire, and placed forward rifle pits."}]]}]]}],["$","div","Johnston lost confidence in Hood",{"className":"moment","children":[["$","$L15",null,{"seconds":642,"label":"10:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston lost confidence in Hood"}],["$","p",null,{"children":"Hood had not produced the expected results and criticized Johnston to contacts in Richmond."}]]}]]}],["$","div","Johnston’s opinion of Hardee improved",{"className":"moment","children":[["$","$L15",null,{"seconds":767,"label":"12:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston’s opinion of Hardee improved"}],["$","p",null,{"children":"Johnston praised Hardee’s battlefield conduct and advice. The two later became professional allies."}]]}]]}],["$","div","Johnston’s original strategy had failed",{"className":"moment","children":[["$","$L15",null,{"seconds":860,"label":"14:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston’s original strategy had failed"}],["$","p",null,{"children":"The army repulsed some attacks but won no decisive battle and repeatedly withdrew as Sherman maneuvered south."}]]}]]}],["$","div","Johnston adopted an inflated casualty estimate",{"className":"moment","children":[["$","$L15",null,{"seconds":1147,"label":"19:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston adopted an inflated casualty estimate"}],["$","p",null,{"children":"His staff estimated more than 45,000 U.S. casualties, more than twice the actual figure, and concluded Sherman was being worn down."}]]}]]}],["$","div","Returning to the railroad solved U.S. supply problems",{"className":"moment","children":[["$","$L15",null,{"seconds":1302,"label":"21:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Returning to the railroad solved U.S. supply problems"}],["$","p",null,{"children":"Shortages during the movement near Dallas