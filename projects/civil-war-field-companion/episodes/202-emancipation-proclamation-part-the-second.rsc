d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",202," · ","May 23, 1861–July 17, 1862"," · ","Fort Monroe and Hampton Roads, Virginia; Washington, D.C.; Missouri and Kentucky; the Department of the South in South Carolina, Georgia, and Florida; and the loyal slave states of Delaware, Maryland, Kentucky, and Missouri"]}],["$","h1",null,{"children":"EMANCIPATION PROCLAMATION (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Self-emancipating people and Union field commanders forced the United States government to decide how its armies would treat people escaping slavery. Benjamin Butler’s refusal to return three men used on Confederate fortifications led to the “contraband” policy, but neither that policy nor the First Confiscation Act freed every enslaved person who reached United States lines. Congress prohibited military personnel from returning freedom seekers in March 1862. Lincoln revoked broader emancipation orders issued by John C. Frémont and David Hunter while unsuccessfully urging the loyal slave states to adopt gradual, state-directed emancipation with federal compensation. By July 1862, field practice, legislation, and military necessity had moved federal policy substantially closer to presidential emancipation"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"May 23, 1861–July 17, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Fort Monroe and Hampton Roads, Virginia; Washington, D.C.; Missouri and Kentucky; the Department of the South in South Carolina, Georgia, and Florida; and the loyal slave states of Delaware, Maryland, Kentucky, and Missouri"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Self-emancipating people and Union field commanders forced the United States government to decide how its armies would treat people escaping slavery. Benjamin Butler’s refusal to return three men used on Confederate fortifications led to the “contraband” policy, but neither that policy nor the First Confiscation Act freed every enslaved person who reached United States lines. Congress prohibited military personnel from returning freedom seekers in March 1862. Lincoln revoked broader emancipation orders issued by John C. Frémont and David Hunter while unsuccessfully urging the loyal slave states to adopt gradual, state-directed emancipation with federal compensation. By July 1862, field practice, legislation, and military necessity had moved federal policy substantially closer to presidential emancipation"}]]}]]}],false,false,"$undefined"]}],"$Lf","$L10","$L11",false,"$L12",false,"$L13","$L14","$L15","$L16"]}]]}]
