1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",202," · ","May 23, 1861–July 17, 1862"," · ","Fort Monroe and Hampton Roads, Virginia; Washington, D.C.; Missouri and Kentucky; the Department of the South in South Carolina, Georgia, and Florida; and the loyal slave states of Delaware, Maryland, Kentucky, and Missouri"]}],["$","h1",null,{"children":"EMANCIPATION PROCLAMATION (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Self-emancipating people and Union field commanders forced the United States government to decide how its armies would treat people escaping slavery. Benjamin Butler’s refusal to return three men used on Confederate fortifications led to the “contraband” policy, but neither that policy nor the First Confiscation Act freed every enslaved person who reached United States lines. Congress prohibited military personnel from returning freedom seekers in March 1862. Lincoln revoked broader emancipation orders issued by John C. Frémont and David Hunter while unsuccessfully urging the loyal slave states to adopt gradual, state-directed emancipation with federal compensation. By July 1862, field practice, legislation, and military necessity had moved federal policy substantially closer to presidential emancipation"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3184486013.mp3?updated=1695588935","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The federal policy path from “contraband” to compensated emancipation"}],["$","small",null,{"children":"The episode follows events from May 1861 through Lincoln’s final July 1862 appeal to border-state representatives. The Second Confiscation Act and Lincoln’s presidential proclamation are reserved for the next episode."}]]}],["$","div","Enslaved population in 1860",{"children":[["$","span",null,{"children":"Enslaved population in 1860"}],["$","strong",null,{"children":"3,953,760 people in the United States"}],["$","small",null,{"children":"The episode rounds the total to almost four million. The 1860 census map counted 3,350,343 enslaved people in the fifteen slaveholding states shown on the map; the national total also included enslaved people elsewhere."}]]}],["$","div","Deep South total",{"children":[["$","span",null,{"children":"Deep South total"}],["$","strong",null,{"children":"More than 2.3 million enslaved people in seven seceding states"}],["$","small",null,{"children":"The state totals for South Carolina, Mississippi, Louisiana, Alabama, Florida, Georgia, and Texas sum to 2,312,046."}]]}],["$","div","Largest state proportions",{"children":[["$","span",null,{"children":"Largest state proportions"}],"$Le","$Lf"]}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}],"$L28","$undefined","$L29",false,"$L2a",false,"$L2b","$L2c","$L2d"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","strong",null,{"children":"57.2% in South Carolina and 55.1% in Mississippi"}]
f:["$","small",null,{"children":"In 1860 enslaved people were also 47.0% of Louisiana’s population, 45.1% of Alabama’s, 43.9% of Florida’s, and 43.7% of Georgia’s."}]
10:["$","div","Fort Monroe’s status",{"children":[["$","span",null,{"children":"Fort Monroe’s status"}],["$","strong",null,{"children":"A United States-held fort inside seceded Virginia"}],["$","small",null,{"children":"Its position at Hampton Roads made it both a military base and a reachable place of refuge for people escaping nearby enslavement."}]]}]
11:["$","div","The first three at Fort Monroe",{"children":[["$","span",null,{"children":"The first three at Fort Monroe"}],["$","strong",null,{"children":"Frank Baker, Shepard Mallory, and James Townsend"}],["$","small",null,{"children":"These are the names by which the three men are known today; the National Park Service notes that definitive contemporary identification records have not survived. They escaped after being forced to work on Confederate gun positions."}]]}]
12:["$","div","Arrival and decision",{"children":[["$","span",null,{"children":"Arrival and decision"}],["$","strong",null,{"children":"May 23–24, 1861"}],["$","small",null,{"children":"The men arrived on May 23. Butler interviewed them the next day and refused a demand that they be returned to enslaver and Confederate colonel Charles K. Mallory."}]]}]
13:["$","div","Butler’s legal reasoning",{"children":[["$","span",null,{"children":"Butler’s legal reasoning"}],["$","strong",null,{"children":"Enemy property used for war could be retained as “contraband”"}],["$","small",null,{"children":"Butler accepted slavery’s property-law premise for the limited purpose of denying labor to the rebellion. He also argued that Virginia could not claim the benefits of the Fugitive Slave Act while claiming to have left the United States."}]]}]
14:["$","div","What the contraband decision did not do",{"children":[["$","span",null,{"children":"What the contraband decision did not do"}],["$","strong",null,{"children":"It did not issue a formal declaration of freedom"}],["$","small",null,{"children":"The three men passed from an enslaver’s control into United States military custody and were hired to work at the fort. Their initiative protected them in practice, but their legal status remained unsettled."}]]}]
15:["$","div","Administration approval",{"children":[["$","span",null,{"children":"Administration approval"}],["$","strong",null,{"children":"Secretary of War Simon Cameron approved Butler’s policy on May 30"}],["$","small",null,{"children":"General-in-Chief Winfield Scott and the Lincoln administration supported the refusal to surrender people reaching United States lines and the use of their labor."}]]}]
16:["$","div","Refugee movement",{"children":[["$","span",null,{"children":"Refugee movement"}],["$","strong",null,{"children":"More than 1,000 freedom seekers near Fort Monroe by August 1861"}],["$","small",null,{"children":"The policy followed, rather than initiated, self-emancipation. Men, women, and children continued crossing into United States-held territory, expanding the issue beyond Butler’s immediate labor needs."}]]}]
17:["$","div","House resolution",{"children":[["$","span",null,{"children":"House resolution"}],["$","strong",null,{"children":"July 9, 1861: soldiers had no duty to capture and return fugitives"}],["$","small",null,{"children":"The House resolution, urged by Representative Owen Lovejoy, expressed policy but was not yet the binding military prohibition Congress enacted in March 1862."}]]}]
18:["$","div","First Confiscation Act",{"children":[["$","span",null,{"children":"First Confiscation Act"}],["$","strong",null,{"children":"Signed August 6, 1861"}],["$","small",null,{"children":"The law authorized forfeiture of an enslaver’s claim when the enslaved person was required or permitted to work in support of the rebellion. It did not abolish slavery generally or automatically cover every person who reached United States lines."}]]}]
19:["$","div","Additional Article of War",{"children":[["$","span",null,{"children":"Additional Article of War"}],["$","strong",null,{"children":"Signed March 13, 1862"}],["$","small",null,{"children":"Congress prohibited officers and other military or naval personnel from using forces under their command to return people escaping claimed service or labor. A court-martial conviction required dismissal from service."}]]}]
1a:["$","div","Frémont’s proclamation",{"children":[["$","span",null,{"children":"Frémont’s proclamation"}],["$","strong",null,{"children":"August 30, 1861, in Missouri"}],["$","small",null,{"children":"Maj. Gen. John C. Frémont imposed martial law and declared enslaved people belonging to active Confederate supporters free. He acted without prior approval from Washington."}]]}]
1b:["$","div","Lincoln’s response to Frémont",{"children":[["$","span",null,{"children":"Lincoln’s response to Frémont"}],["$","strong",null,{"children":"Ordered the emancipation clause conformed to the First Confiscation Act"}],["$","small",null,{"children":"Lincoln first asked Frémont to modify the order on September 2. After Frémont declined to do so on his own authority, Lincoln publicly directed the change on September 11."}]]}]
1c:["$","div","Hunter’s proclamation",{"children":[["$","span",null,{"children":"Hunter’s proclamation"}],["$","strong",null,{"children":"May 9, 1862, in South Carolina, Georgia, and Florida"}],["$","small",null,{"children":"Maj. Gen. David Hunter declared enslaved people in the Department of the South free. United States control in the department extended over only limited coastal areas."}]]}]
1d:["$","div","Lincoln’s response to Hunter",{"children":[["$","span",null,{"children":"Lincoln’s response to Hunter"}],["$","strong",null,{"children":"Declared the emancipation provision void on May 19"}],["$","small",null,{"children":"Lincoln stated that no commander had authority from the government to issue such a declaration and reserved to himself the decision whether emancipation had become a military necessity."}]]}]
1e:["$","div","Border-state constraint",{"children":[["$","span",null,{"children":"Border-state constraint"}],["$","strong",null,{"children":"Delaware, Maryland, Kentucky, and Missouri remained in the United States"}],["$","small",null,{"children":"Lincoln feared that unauthorized general emancipation could damage Unionist support in loyal slave states. Missouri was also the setting of Frémont’s order, making the issue immediate rather than hypothetical."}]]}]
1f:["$","div","Contradictory field practice",{"children":[["$","span",null,{"children":"Contradictory field practice"}],["$","strong",null,{"children":"Some officers sheltered freedom seekers while others excluded or returned them"}],["$","small",null,{"children":"Orders by Henry W. Halleck and John A. Dix restricting entry to military lines illustrate why federal practice remained inconsistent before Congress imposed the March 1862 prohibition."}]]}]
20:["$","div","Compensated-emancipation proposal",{"children":[["$","span",null,{"children":"Compensated-emancipation proposal"}],["$","strong",null,{"children":"Lincoln asked Congress for federal aid on March 6, 1862"}],["$","small",null,{"children":"His proposed resolution offered federal financial assistance to any state that voluntarily adopted gradual abolition. Congress approved the joint resolution in April, but no loyal slave state adopted the program."}]]}]
21:["$","div","Colonization in the proposal",{"children":[["$","span",null,{"children":"Colonization in the proposal"}],["$","strong",null,{"children":"Voluntary emigration was paired with gradual emancipation"}],["$","small",null,{"children":"Lincoln presented colonization as a way to reduce white resistance. Most Black Americans opposed leaving the country, and the wartime colonization projects attempted by the administration failed."}]]}]
22:["$","div","Delaware test case",{"children":[["$","span",null,{"children":"Delaware test case"}],["$","strong",null,{"children":"1,798 enslaved people in the 1860 census"}],["$","small",null,{"children":"Lincoln hoped the smallest slaveholding state would lead, but opposition was strong enough that supporters did not bring a compensated-emancipation proposal to a vote in its legislature."}]]}]
23:["$","div","Final border-state appeal",{"children":[["$","span",null,{"children":"Final border-state appeal"}],["$","strong",null,{"children":"July 12, 1862"}],["$","small",null,{"children":"Lincoln warned representatives that slavery would be destroyed by the continuing war without compensation. A majority response dated July 14 disputed his reasoning and declined immediate action, although its signers said their states could consider the proposal."}]]}]
24:["$","div","Policy transition",{"children":[["$","span",null,{"children":"Policy transition"}],["$","strong",null,{"children":"Congress enacted the Second Confiscation Act on July 17, 1862"}],["$","small",null,{"children":"The episode stops just before discussing the act. Its emancipation and Black-enlistment provisions supplied part of the immediate legal setting for Lincoln’s July 22 draft proclamation."}]]}]
25:["$","div","Agency and policy",{"children":[["$","span",null,{"children":"Agency and policy"}],["$","strong",null,{"children":"Freedom seekers made federal inaction impossible"}],["$","small",null,{"children":"Baker, Mallory, Townsend, and thousands of others acted before national emancipation policy existed. Their arrival inside United States lines forced commanders, Congress, and the president to respond."}]]}]
26:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The Fiery Trial” by Eric Foner"}],["$","small",null,{"children":"The full title is “The Fiery Trial: Abraham Lincoln and American Slavery.” The hosts had also recommended it in episode 50."}]]}]
27:["$","div","Language in this guide",{"children":[["$","span",null,{"children":"Language in this guide"}],["$","strong",null,{"children":"“Contraband” appears only as a period legal and administrative term"}],["$","small",null,{"children":"The term treated human beings as seized property. This guide otherwise uses “enslaved people,” “freedom seekers,” and “self-emancipating people” to describe the people whose actions drove the policy change."}]]}]
28:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
29:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Where field policy changed, 1861–1862",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep202-policy-geography.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Where field policy changed, 1861–1862 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep202-policy-geography.svg","alt":"Schematic map locating Fort Monroe, Missouri, Washington, the loyal slave states, and the Department of the South in the evolution of United States emancipation policy.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Where field policy changed, 1861–1862"}],["$","span",null,{"children":"The most important field decisions occurred in distinct military jurisdictions. Butler retained freedom seekers at Fort Monroe in Virginia; Frémont issued a broader order in Missouri; Hunter did the same in the Department of the South; and Lincoln’s political concern centered on the loyal slave states. Locations and department boundaries are generalized, and the diagram is not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep202-policy-geography.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, Library of Congress, Abraham Lincoln Papers, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","From refuge to federal policy",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep202-policy-timeline.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From refuge to federal policy at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep202-policy-timeline.svg","alt":"Three-lane timeline of self-emancipation, military decisions, legislation, and presidential policy between May 1861 and July 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From refuge to federal policy"}],["$","span",null,{"children":"Self-emancipation created the immediate problem. Military decisions, congressional legislation, and presidential action then developed in parallel. The arrows show chronological movement, not a claim that any single event alone caused the next."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep202-policy-timeline.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Senate Historical Office, Library of Congress, National Archives, and Abraham Lincoln’s messages; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Arrival at Fortress Monroe",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep202-fort-monroe-arrivals.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Arrival at Fortress Monroe at full size","children":"$L2e"}]}],"$L2f"]}]]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States civil and military authority",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States civil and military authority"}],[["$","div","Commander in Chief and chief executive-President Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in Chief and chief executive"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Approved Butler’s limited field policy, ordered Frémont’s proclamation narrowed, voided Hunter’s proclamation, and proposed state-directed compensated emancipation"}]]}],["$","div","War Department through January 14, 1862-Secretary of War Simon Cameron",{"className":"command-entry","children":[["$","strong",null,{"children":"War Department through January 14, 1862"}],["$","span",null,{"children":"Secretary of War Simon Cameron"}],["$","small",null,{"children":"Approved Butler’s refusal to return freedom seekers and authorized their employment while leaving final legal status unresolved"}]]}],["$","div","War Department from January 15, 1862-Secretary of War Edwin M. Stanton",{"className":"command-entry","children":[["$","strong",null,{"children":"War Department from January 15, 1862"}],["$","span",null,{"children":"Secretary of War Edwin M. Stanton"}],["$","small",null,{"children":"Led the department when Congress prohibited military returns and Lincoln revoked Hunter’s departmental emancipation order"}]]}],["$","div","General in Chief through November 1, 1861-Lt. Gen. Winfield Scott",{"className":"command-entry","children":[["$","strong",null,{"children":"General in Chief through November 1, 1861"}],["$","span",null,{"children":"Lt. Gen. Winfield Scott"}],["$","small",null,{"children":"Received Butler’s report from Fort Monroe and supported the decision to retain people used in Confederate military labor"}]]}],["$","div","General in Chief, November 1, 1861–March 11, 1862-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"General in Chief, November 1, 1861–March 11, 1862"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Held senior Army authority during part of the period; field policies nevertheless remained inconsistent across departments"}]]}]]]}],["$","section","United States field commands",{"className":"command-column #8b5b25","children":[["$","h3",null,{"children":"United States field commands"}],[["$","div","Department of Virginia at Fort Monroe-Maj. Gen. Benjamin F. Butler",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Virginia at Fort Monroe"}],["$","span",null,{"children":"Maj. Gen. Benjamin F. Butler"}],["$","small",null,{"children":"Refused to return Baker, Mallory, and Townsend; retained and employed freedom seekers reaching United States lines"}]]}],["$","div","Department of the West-Maj. Gen. John C. Frémont",{"className":"command-entry","children":["$L30","$L31","$L32"]}],"$L33","$L34","$L35"]]}]]}],"$L36"]]]}]
2b:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep202-policy-geography.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep202-policy-geography.svg","alt":"Schematic map of the military departments and loyal slave states central to the episode.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Field policy varied by place and commander: refuge at Fort Monroe, departmental proclamations in Missouri and the South Atlantic, and presidential caution focused on the loyal slave states."}]]}],["$","figure","/images/ep202-policy-timeline.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep202-policy-timeline.svg","alt":"Timeline tracing self-emancipation, military action, legislation, and presidential policy from May 1861 to July 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Self-emancipation, military policy, congressional legislation, and presidential action moved on related but distinct tracks."}]]}],["$","figure","/images/ep202-fort-monroe-arrivals.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep202-fort-monroe-arrivals.jpg","alt":"An illustrated newspaper spread depicting African American freedom seekers arriving at Fort Monroe in 1861.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Frank Leslie’s Illustrated Newspaper represented the arrival of freedom seekers at Fort Monroe in its June 8, 1861, issue."}]]}],["$","figure","/images/ep202-yorktown-contrabands.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep202-yorktown-contrabands.jpg","alt":"African American refugees and United States soldiers outside a farmhouse near Yorktown, Virginia, in May 1862.","wi