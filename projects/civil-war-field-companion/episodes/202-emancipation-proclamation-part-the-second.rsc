2f:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Arrival at Fortress Monroe"}],["$","span",null,{"children":"Frank Leslie’s Illustrated Newspaper published this composite engraving on June 8, 1861. Its central scene depicts African American freedom seekers entering Fort Monroe, while surrounding scenes show movement, reception, work, and camp life. It is a contemporary illustrated-news representation, not a photograph of the May 23 arrival."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep202-fort-monroe-arrivals.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Prints and Photographs Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
