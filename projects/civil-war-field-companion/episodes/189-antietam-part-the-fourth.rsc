23:["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Received warning of Hooker’s crossing while meeting Jackson and Longstreet in Sharpsburg and reinforced the threatened left"}]]}],["$","div","Left Wing-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Shifted his divisions behind and to the left of Hood to meet the United States movement on the northern battlefield"}]]}],["$","div","Right Wing-Maj. Gen. James Longstreet",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Sent Hood’s two brigades north from their reserve near the Dunker Church when Lee learned of Hooker’s advance"}]]}],["$","div","Hood’s Division, Longstreet’s Wing-Brig. Gen. John Bell Hood",{"className":"command-entry","children":[["$","strong",null,{"children":"Hood’s Division, Longstreet’s Wing"}],["$","span",null,{"children":"Brig. Gen. John Bell Hood"}],["$","small",null,{"children":"Moved the Texas and Law brigades toward the East Woods and checked Meade’s evening advance"}]]}],["$","div","Cavalry Division-Maj. Gen. J. E. B. Stuart",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry Division"}],["$","span",null,{"children":"Maj. Gen. J. E. B. Stuart"}],["$","small",null,{"children":"Relayed cavalry reports of the United States crossing from the northern battlefield to Lee in Sharpsburg"}]]}]]]}]
