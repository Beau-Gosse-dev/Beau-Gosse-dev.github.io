10:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2017/04/02/civil-war-podcast-episode-189/",{"href":"https://civilwarpodcast.org/2017/04/02/civil-war-podcast-episode-189/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 189 page"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=MD003",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=MD003","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Antietam battle detail"]}],["$","a","https://www.nps.gov/articles/antietam-lead-up-to-and-after.htm",{"href":"https://www.nps.gov/articles/antietam-lead-up-to-and-after.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Antietam lead-up and aftermath"]}],["$","a","https://www.nps.gov/places/the-north-woods.htm",{"href":"https://www.nps.gov/places/the-north-woods.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: The North Woods"]}],["$","a","https://www.nps.gov/places/the-east-woods.htm",{"href":"https://www.nps.gov/places/the-east-woods.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: The East Woods"]}],["$","a","https://www.nps.gov/places/the-cornfield.htm",{"href":"https://www.nps.gov/places/the-cornfield.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: The Cornfield"]}],["$","a","https://www.nps.gov/places/the-pry-farm.htm",{"href":"https://www.nps.gov/places/the-pry-farm.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: The Pry Farm"]}],["$","a","https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo63555/pdf/GOVPUB-D114-PURL-gpo63555.pdf",{"href":"https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo63555/pdf/GOVPUB-D114-PURL-gpo63555.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Maryland and Fredericksburg Campaigns, 1862–1863"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/35-3-1.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/35-3-1.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Antietam staff ride guide"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-6.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-6.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Antietam order of battle"]}],["$","a","https://ehistory.osu.edu/books/official-records/027",{"href":"https://ehistory.osu.edu/books/official-records/027","target":"_blank","rel":"noreferrer","children":[" · ","Official Records, Series I, Volume XIX, Part I: Maryland Campaign reports"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=19",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=19","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: George B. McClellan’s official reports"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=246",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=246","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Joseph Hooker’s official reports"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=25",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=25","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: George G. Meade’s official report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=31",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=31","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: John Bell Hood’s official report"]}],"$L19","$L1a","$L1b","$L1c","$L1d"]}]
