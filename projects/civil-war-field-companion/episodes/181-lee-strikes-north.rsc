d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",181," · ","September 3–7, 1862"," · ","Northern Virginia from the Second Manassas and Chantilly area through Dranesville and Leesburg, and the Potomac River crossing at White’s Ford into Maryland"]}],["$","h1",null,{"children":"LEE STRIKES NORTH"}],["$","span",null,{"className":"result-label","children":"The Maryland Campaign opened. Robert E. Lee kept the strategic initiative after Second Manassas and moved the Army of Northern Virginia north of the Potomac before the United States army had fully reorganized. No battle occurred in this episode; the campaign’s military, political, diplomatic, and emancipation consequences remained undecided"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"September 3–7, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Northern Virginia from the Second Manassas and Chantilly area through Dranesville and Leesburg, and the Potomac River crossing at White’s Ford into Maryland"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"The Maryland Campaign opened. Robert E. Lee kept the strategic initiative after Second Manassas and moved the Army of Northern Virginia north of the Potomac before the United States army had fully reorganized. No battle occurred in this episode; the campaign’s military, political, diplomatic, and emancipation consequences remained undecided"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"September 3–7, 1862","place":"Northern Virginia from the Second Manassas and Chantilly area through Dranesville and Leesburg, and the Potomac River crossing at White’s Ford into Maryland","result":"The Maryland Campaign opened. Robert E. Lee kept the strategic initiative after Second Manassas and moved the Army of Northern Virginia north of the Potomac before the United States army had fully reorganized. No battle occurred in this episode; the campaign’s military, political, diplomatic, and emancipation consequences remained undecided","facts":[{"label":"Episode scope","value":"Lee’s decision to enter Maryland and the opening river crossing","note":"The episode explains the campaign’s strategic stakes, reviews Lincoln’s decision to delay announcing emancipation, and follows the Army of Northern Virginia to the Potomac. The next episode continues the movement toward Frederick and the Lost Order."},{"label":"Campaign opening","value":"September 3, 1862","note":"The U.S. Army campaign register dates the Antietam Campaign from September 3. That day Lee began shifting north and west and wrote Jefferson Davis from the Alexandria and Leesburg Road near Dranesville."},{"label":"Lee’s proposal","value":"Enter Maryland while the Federal armies were weakened and reorganizing","note":"Lee’s September 3 letter called the moment the most favorable since the war began. He believed the combined Federal forces around Washington were demoralized and that newly raised troops were not ready for field service."},{"label":"Washington ruled out","value":"Lee did not plan to assault or invest the capital’s fortifications","note":"The defenses were formidable, and the United States forces gathering behind them were much larger than Lee’s army. His letter to Davis explicitly rejected following the retreating Federals into those works."},{"label":"Alternatives rejected","value":"Retreat behind the Rappahannock or remain in depleted northern Virginia","note":"Either course could give Lee’s army time to rest, but both would surrender the initiative. The countryside around the armies had also been stripped by months of campaigning and foraging."},{"label":"Central military purpose","value":"Bring the United States army to battle away from Washington","note":"The episode treats the search for another major battlefield victory as Lee’s primary objective. He hoped to act before the Federal army recovered its organization, morale, and numerical advantage."},{"label":"Supply objective","value":"Obtain food and forage in Maryland during harvest season","note":"Moving north promised access to an agricultural region not yet consumed by the fighting in Virginia, although the army entered Maryland with weak transportation and serious shortages."},{"label":"Relief for Virginia","value":"Shift the burden of campaigning north of the Potomac","note":"Lee expected the movement to spare Virginia farms from additional operations during the fall harvest and to draw Federal forces away from the state."},{"label":"Maryland expectation","value":"Possible recruits and political support, but no general uprising","note":"Maryland was a slave state that remained in the United States and contained divided loyalties. Confederate leaders hoped the army’s presence would attract recruits, but the later response around Frederick was limited."},{"label":"Parallel offensives","value":"Lee entered Maryland while Braxton Bragg and Edmund Kirby Smith operated in Kentucky","note":"The simultaneous Confederate movements created pressure in both eastern and western theaters, but they were separate campaigns rather than one centrally directed combined operation."},{"label":"Northern elections","value":"Congressional midterms were less than two months away","note":"Lee believed another Confederate victory could strengthen Northern voters and politicians who favored an armistice or negotiated settlement. The transcript distinguishes peace Democrats from war Democrats, who supported restoring the Union by force but opposed many Republican hard-war measures."},{"label":"Diplomatic stakes","value":"British and French leaders were actively discussing mediation","note":"Confederate victories in the summer of 1862 strengthened European expectations that the United States might fail to restore the Union. Mediation based on separation could have moved toward recognition of Confederate independence, but British leaders waited to see the result of Lee’s invasion."},{"label":"Emancipation stakes","value":"Lincoln was waiting for military success before announcing his policy","note":"Lincoln had presented a preliminary emancipation draft to his cabinet on July 22. William H. Seward advised delaying publication so it would not appear to be an act of desperation after military reverses."},{"label":"Border-state meeting","value":"July 12, 1862","note":"Lincoln made a final appeal to border-state representatives for gradual compensated emancipation. Their rejection preceded his decision to proceed under his wartime authority as commander in chief."},{"label":"Cabinet disclosure","value":"Lincoln informed Seward and Gideon Welles on July 13 and the full cabinet on July 22","note":"Welles later recalled Lincoln describing emancipation as a military necessity. Montgomery Blair was the only cabinet member described in the episode as opposing the decision itself; Seward supported delay rather than abandonment."},{"label":"Army condition","value":"Exhausted, underfed, poorly clothed, and short of shoes","note":"Lee admitted to Davis that the army lacked equipment, transportation animals were reduced, and thousands of soldiers had no shoes. Many veterans had marched or fought almost continuously for ten weeks."},{"label":"Straggling","value":"Thousands fell out before or during the march into Maryland","note":"Illness, fatigue, hunger, damaged feet, unauthorized returns home, and objections to invading United States territory all contributed. The episode uses the 8th Virginia’s loss of two-thirds of its strength on the march as one example."},{"label":"Morale in the ranks","value":"High among the soldiers who crossed","note":"Despite severe material shortages, accounts quoted in the episode describe confidence after the victories of the Seven Days and Second Manassas and strong trust in Lee."},{"label":"Crossing begins","value":"Thursday, September 4, at White’s Ford near Leesburg","note":"National Park Service pages use both “White’s Ford” and “White’s Ferry” for the September 4 crossing near Leesburg. This guide uses “White’s Ford,” the name in Confederate official reports. Units continued entering Maryland through the weekend."},{"label":"Army across the river","value":"By September 7","note":"The National Park Service timeline states that all units were in Maryland by September 7. The army then concentrated around Frederick before Lee issued Special Orders No. 191 on September 9."},{"label":"Lee and Davis","value":"Lee moved before receiving a reply to his September 3 letter","note":"The episode interprets this as evidence of Lee’s confidence in Davis’s approval and the trust between them, not as proof that Lee intended to evade presidential authority."},{"label":"No episode battle losses","value":"No senior leader is killed or mortally wounded in the events covered","note":"The crossing and strategic decisions precede the campaign’s battles at Harpers Ferry, South Mountain, Antietam, and Shepherdstown."},{"label":"Recommended book","value":"“Confederate Tide Rising” by Joseph L. Harsh","note":"The full subtitle is “Robert E. Lee and the Making of Southern Strategy, 1861–1862.” The official episode page and podcast book list identify it as the recommendation."},{"label":"Transcript normalizations","value":"Gideon Welles, Heros von Borcke, John W. Stevens, Hood’s Texas Brigade, and John A. Harman","note":"The automated transcript produces “Wells,” “Eros Von Borka,” “Walford,” and other phonetic forms. The quoted soldier was John W. Stevens of the 5th Texas in Hood’s Texas Brigade, and Jackson’s chief quartermaster was Maj. John A. Harman."}],"maps":[{"title":"Opening movements of the Maryland Campaign","caption":"After the Second Manassas and Chantilly operations, Lee shifted the Army of Northern Virginia north and west through the Dranesville–Leesburg corridor. The first units crossed at White’s Ford on September 4 and the army concentrated toward Frederick as the Army of the Potomac began moving from Washington. Locations and routes are generalized. This map is schematic and not to scale.","source":"National Park Service, U.S. Army Center of Military History, Robert Knox Sneden campaign map, and episode transcript; see sources below.","image":"/images/ep181-campaign-opening.svg","alt":"Schematic regional map of Confederate movement from Second Manassas and Chantilly through Leesburg and White’s Ford into Maryland toward Frederick, with the Federal pursuit from Washington."},{"title":"The crossing at White’s Ford","caption":"Confederate columns approached from Leesburg, waded across the shallow Potomac, crossed the Chesapeake and Ohio Canal corridor on the Maryland bank, and continued toward Poolesville and Frederick. The diagram shows relationships rather than exact roads, ford geometry, unit order, or timing. This map is schematic and not to scale.","source":"National Park Service Chesapeake and Ohio Canal and Antietam National Battlefield accounts, U.S. Army Center of Military History, and episode transcript; see sources below.","image":"/images/ep181-whites-ford.svg","alt":"Schematic local map of the Army of Northern Virginia approaching White’s Ford from Leesburg, crossing the Potomac and Chesapeake and Ohio Canal corridor, and moving into Maryland."},{"title":"Alfred Waud’s drawing of the Potomac crossing","caption":"Waud’s September 1862 field drawing shows Confederate troops crossing the Potomac before Antietam while United States scouts observe from the foreground. It is a participant-era visual record, not a surveyed map.","source":"Library of Congress Prints and Photographs Division; see sources below.","image":"/images/ep181-waud-potomac-crossing.jpg","alt":"Alfred Waud drawing of Confederate soldiers crossing the Potomac River before Antietam while United States scouts watch from the foreground."}],"moments":[{"time":"1:43","audioTime":103,"title":"Lee faces a post-victory decision","detail":"After the Seven Days and Second Manassas shifted the fighting from Richmond to Washington’s outskirts, Lee considers how to preserve the initiative."},{"time":"1:59","audioTime":119,"title":"An attack on Washington is rejected","detail":"The capital’s fortifications are too strong, and the Federal forces assembling there greatly outnumber the Army of Northern Virginia."},{"time":"2:17","audioTime":137,"title":"Lee’s other options are weighed","detail":"Retreating behind the Rappahannock or remaining in depleted northern Virginia would rest the army but return the initiative to the United States."},{"time":"3:01","audioTime":181,"title":"The choice becomes a strike across the Potomac","detail":"The episode identifies movement into Maryland as the course that could keep Federal forces reacting to Lee."},{"time":"3:08","audioTime":188,"title":"Lee writes Davis on September 3","detail":"From near Dranesville, Lee tells the Confederate president that this is the most favorable moment yet for the army to enter Maryland."},{"time":"4:06","audioTime":246,"title":"Logistical benefits are identified","detail":"Maryland’s harvest could supply food and forage while moving the war north gave Virginia farms a respite."},{"time":"4:31","audioTime":271,"title":"Confederate hopes for Maryland support are considered","detail":"Lee sees a possibility that residents of the slaveholding border state might support the Confederacy, although the episode calls a broad uprising remote."},{"time":"5:00","audioTime":300,"title":"Battle is presented as Lee’s chief purpose","detail":"The campaign seeks another battlefield victory on United States soil before superior Federal manpower and industry can dominate a longer war."},{"time":"6:31","audioTime":391,"title":"The Kentucky offensives form a wider context","detail":"As Bragg and Kirby Smith move in Kentucky, Lee prepares to enter Maryland and possibly threaten Pennsylvania."},{"time":"7:00","audioTime":420,"title":"Lee links victory to the midterm elections","detail":"A September 8 letter argues that another Confederate success could influence whether Northern voters supported continuing the war."},{"time":"8:01","audioTime":481,"title":"War and peace Democrats are distinguished","detail":"The episode explains the Democratic division between supporting military reunion and seeking an armistice and negotiated settlement."},{"time":"10:32","audioTime":632,"title":"European governments watch the elections","detail":"French and British policymakers consider whether Democratic gains might make the Lincoln administration more receptive to mediation."},{"time":"11:06","audioTime":666,"title":"Confederate victories revive recognition hopes","detail":"The summer’s military reverses for the United States strengthen intervention discussions in London and Paris."},{"time":"13:21","audioTime":801,"title":"Palmerston becomes the central British question","detail":"The prime minister, who had recently blocked a mediation proposal, appears more willing to consider action after Second Manassas."},{"time":"14:29","audioTime":869,"title":"British action waits on the invasion’s result","detail":"Palmerston and Russell plan an October cabinet discussion but agree that Lee’s success or failure should determine the next step."},{"time":"15:26","audioTime":926,"title":"The campaign’s stakes are summarized","detail":"The episode connects the invasion to battlefield victory, foreign intervention, elections, Northern war support, and emancipation."},{"time":"18:35","audioTime":1115,"title":"Lincoln’s emancipation decision is reviewed","detail":"The episode turns from the shift toward hard war to Lincoln’s July effort to make emancipation a national war policy."},{"time":"18:51","audioTime":1131,"title":"Border-state representatives reject compensation","detail":"Lincoln’s July 12 appeal for gradual compensated emancipation fails, clearing the way for a proclamation grounded in military authority."},{"time":"19:54","audioTime":1194,"title":"Lincoln tells Seward and Welles","detail":"During a July 13 carriage ride, Lincoln informs the secretaries of state and navy that he intends to issue an emancipation proclamation."},{"time":"20:46","audioTime":1246,"title":"The full cabinet hears the policy","detail":"Nine days later Lincoln presents the decision; Montgomery Blair objects while other cabinet members express varying support."},{"time":"21:38","audioTime":1298,"title":"Seward advises delay","detail":"Seward warns that immediate publication after military defeats could make emancipation look like a desperate act."},{"time":"22:32","audioTime":1352,"title":"The proclamation waits for military success","detail":"Lincoln accepts Seward’s timing argument, directly tying the unpublished policy to the outcome of the coming campaign."},{"time":"22:49","audioTime":1369,"title":"John W. Stevens remembers the river","detail":"The 5th Texas infantryman describes crowded water, competing regimental bands, jubilant soldiers, and his own foreboding as the brigade crossed."},{"time":"24:20","audioTime":1460,"title":"The army’s exhaustion is assessed","detail":"The veterans are hungry, ragged, and often shoeless after ten weeks of fighting and marching, but Lee will not relinquish the initiative."},{"time":"25:07","audioTime":1507,"title":"Lee moves without waiting for Davis’s reply","detail":"The hosts interpret the timing as confidence in presidential approval rooted in an established working relationship."},{"time":"27:52","audioTime":1672,"title":"Lee acknowledges critical shortages","detail":"His letter reports inadequate equipment, weak transportation, reduced animals, poor clothing, and thousands of men without shoes."},{"time":"29:35","audioTime":1775,"title":"Straggling drains the columns","detail":"Illness, exhaustion, objections to invasion, and unauthorized trips home remove thousands before the campaign’s major battles."},{"time":"30:35","audioTime":1835,"title":"Those remaining show high confidence","detail":"Accounts describe strong morale among the soldiers who reach the Potomac and trust in Lee after recent victories."},{"time":"30:58","audioTime":1858,"title":"The northward march and crossing dates are fixed","detail":"Lee shifts toward Leesburg on September 3; the first units cross on September 4, and the passage continues through the weekend."},{"time":"31:35","audioTime":1895,"title":"Heros von Borcke describes the spectacle","detail":"The Prussian-born officer on J. E. B. Stuart’s staff recalls cavalry stretching across the river as bands played “Maryland, My Maryland.”"},{"time":"32:48","audioTime":1968,"title":"Jackson’s quartermaster clears the ford","detail":"When wagons and mules clog the water, Maj. John A. Harman uses the language of an experienced mule driver to restore movement."},{"time":"34:27","audioTime":2067,"title":"The episode’s book recommendation is given","detail":"The hosts recommend Joseph L. Harsh’s “Confederate Tide Rising: Robert E. Lee and the Making of Southern Strategy, 1861–1862.”"}],"command":[{"side":"United States","color":"#315f8c","branches":[{"commander":"President Abraham Lincoln","command":"Commander in chief and national war policy","subordinates":"Made the decision to issue an emancipation proclamation under his war powers, then accepted William H. Seward’s advice to wait for military success before publication"},{"commander":"Maj. Gen. Henry W. Halleck","command":"General in chief, United States Army","subordinates":"Coordinated the armies from Washington while Federal forces reorganized after Second Manassas and Chantilly"},{"commander":"Maj. Gen. George B. McClellan","command":"Army of the Potomac and forces defending Washington","subordinates":"Absorbed units from John Pope’s discontinued Army of Virginia and began moving the reorganized field army out of Washington on September 5"},{"commander":"Secretaries William H. Seward and Gideon Welles","command":"State and Navy Departments","subordinates":"Heard Lincoln’s emancipation decision on July 13; Seward advised withholding the proclamation until it could follow a military success"}]},{"side":"Confederacy","color":"#9a3d32","branches":[{"commander":"President Jefferson Davis","command":"Confederate commander in chief","subordinates":"Received Lee’s September 3 statement of intent and supported the Maryland movement; Lee began the crossing before a reply arrived"},{"commander":"Gen. Robert E. Lee","command":"Army of Northern Virginia","subordinates":"Chose to retain the initiative by entering Maryland and seeking battle away from the Washington fortifications"},{"commander":"Maj. Gen. James Longstreet","command":"Right Wing, Army of Northern Virginia","subordinates":"Led one of Lee’s two principal infantry groupings during the movement from northern Virginia into Maryland"},{"commander":"Maj. Gen. Thomas J. “Stonewall” Jackson","command":"Left Wing, Army of Northern Virginia","subordinates":"Led the other principal infantry grouping; his staff and trains crossed amid the episode’s account of the wagon jam at the ford"},{"commander":"Maj. Gen. J. E. B. Stuart","command":"Cavalry Division","subordinates":"Screened Confederate movements; staff officer Maj. Heros von Borcke later described the cavalry crossing the Potomac"}]}],"people":[{"name":"Robert E. Lee","role":"Army of Northern Virginia commander who chose to enter Maryland and seek another decisive battle","side":"Confederacy","image":"/images/ep181-robert-e-lee.jpg"},{"name":"Abraham Lincoln","role":"United States president who delayed announcing emancipation until the policy could follow military success","side":"United States","image":"/images/ep181-abraham-lincoln.jpg"},{"name":"Jefferson Davis","role":"Confederate president whose support Lee expected when the army began crossing before a reply arrived","side":"Confederacy"},{"name":"George B. McClellan","role":"Army of the Potomac commander reorganizing Federal forces around Washington","side":"United States"},{"name":"William H. Seward","role":"Secretary of state who advised Lincoln to delay the emancipation announcement until after military success","side":"United States"},{"name":"Gideon Welles","role":"Secretary of the navy who recorded Lincoln’s explanation of emancipation as a military necessity","side":"United States"},{"name":"Montgomery Blair","role":"Postmaster general who warned that emancipation would damage Republicans in the 1862 elections","side":"United States"},{"name":"Thomas J. “Stonewall” Jackson","role":"Confederate wing commander whose men, staff, wagons, and animals crossed the Potomac","side":"Confederacy"},{"name":"Heros von Borcke","role":"Prussian-born officer on J. E. B. Stuart’s staff who left a vivid account of the river crossing","side":"Confederacy"},{"name":"John W. Stevens","role":"5th Texas Infantry private who remembered the music, excitement, and foreboding at the ford","side":"Confederacy"},{"name":"John A. Harman","role":"Jackson’s chief quartermaster, credited in the episode with clearing a wagon-and-mule jam in the river","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/ep181-campaign-opening.svg","alt":"Schematic regional map of the opening Confederate movement into Maryland and the Federal pursuit from Washington.","caption":"Lee moved from the Second Manassas–Chantilly area through the Leesburg corridor, crossed the Potomac beginning September 4, and concentrated toward Frederick. The Army of the Potomac began leaving Washington on September 5. Routes and locations are generalized.","source":"National Park Service, U.S. Army Center of Military History, Robert Knox Sneden campaign map, and episode transcript; see sources below."},{"image":"/images/ep181-whites-ford.svg","alt":"Schematic local map of Confederate columns wading across White’s Ford from Virginia into Maryland.","caption":"White’s Ford carried the Army of Northern Virginia from the Leesburg area across the Potomac and the Chesapeake and Ohio Canal corridor. The diagram is schematic and not to scale.","source":"National Park Service Chesapeake and Ohio Canal and Antietam National Battlefield accounts, U.S. Army Center of Military History, and episode transcript; see sources below."},{"image":"/images/ep181-waud-potomac-crossing.jpg","alt":"Alfred Waud drawing of Confederate troops crossing the Potomac before Antietam while United States scouts observe.","caption":"“Previous to Antietam. Rebels crossing the Potomac. Union scouts in foreground,” drawn by Alfred R. Waud in September 1862.","source":"Library of Congress Prints and Photographs Division; see sources below."},{"image":"/images/ep181-robert-e-lee.jpg","alt":"Civil War-era glass-negative portrait of Confederate general Robert E. Lee in uniform.","caption":"Robert E. Lee rejected an attack on Washington and chose a northward campaign intended to sustain the momentum created by recent Confederate victories.","source":"Library of Congress Prints and Photographs Division; see sources below."},{"image":"/images/ep181-abraham-lincoln.jpg","alt":"Alexander Gardner portrait of United States president Abraham Lincoln seated beside a table.","caption":"Abraham Lincoln had decided on an emancipation proclamation but was waiting for military success before making the policy public.","source":"Library of Congress, Alfred Whital Stern Collection of Lincolniana; see sources below."}],"sources":[{"label":"Official Civil War Podcast episode 181 page","url":"https://civilwarpodcast.org/2017/02/05/civil-war-podcast-episode-181/"},{"label":"Antietam National Battlefield: Antietam Campaign timeline","url":"https://www.nps.gov/anti/learn/historyculture/timeline.htm"},{"label":"National Park Service: Crossing Over","url":"https://www.nps.gov/articles/crossing-over.htm"},{"label":"Harpers Ferry National Historical Park: 1862 Battle of Harpers Ferry","url":"https://www.nps.gov/hafe/learn/historyculture/1862-battle-of-harpers-ferry.htm"},{"label":"U.S. Army Center of Military History: The Maryland and Fredericksburg Campaigns, 1862–1863","url":"https://history.army.mil/Portals/143/Images/Publications/Publication%20By%20Title%20Images/M%20Pdf/cmhPub_75-6.pdf"},{"label":"U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862","url":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf"},{"label":"Official Records, Series I, Volume XIX, Part II: Lee to Davis, September 3, 1862","url":"https://ehistory.osu.edu/books/official-records/028/0590"},{"label":"Official Records, Series I, Volume XIX, Part I: Maryland Campaign reports","url":"https://ehistory.osu.edu/books/official-records/027"},{"label":"National Archives: The Preliminary Emancipation Proclamation, 1862","url":"https://www.archives.gov/exhibits/american_originals_iv/sections/text_preliminary_emancipation.html"},{"label":"U.S. Department of State, Foreign Relations: recognition discussions after Manassas and Antietam","url":"https://history.state.gov/historicaldocuments/frus1862/d336"},{"label":"Primary map: Robert Knox Sneden, The Antietam Campaign, September 1862","url":"https://www.loc.gov/item/gvhs01.vhs00111/"},{"label":"Primary visual source: Alfred R. Waud, Rebels crossing the Potomac","url":"https://www.loc.gov/item/2004660339/"},{"label":"Library of Congress: Robert E. Lee portrait","url":"https://www.loc.gov/item/2018666540/"},{"label":"Library of Congress: Alexander Gardner portrait of Abraham Lincoln","url":"https://www.loc.gov/item/scsm000793/"},{"label":"Official podcast book-recommendations list","url":"https://civilwarpodcast.org/book-recommendations/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
