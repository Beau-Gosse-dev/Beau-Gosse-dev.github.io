,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Joseph B. Campbell"}],["$","p",null,{"children":"Battery B commander wounded while his Regular Army gunners defended their pieces near the turnpike"}]]}]]}],["$","article","James Stewart",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JS"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"James Stewart"}],["$","p",null,{"children":"Battery B lieutenant who continued directing the guns after Campbell was wounded"}]]}]]}],["$","article","John R. Jones",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JR"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"John R. Jones"}],["$","p",null,{"children":"Confederate division commander disabled by the concussion of a long-range Federal shell"}]]}]]}],["$","article","William E. Starke",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"William E. Starke"}],["$","p",null,{"children":"Succeeded Jones, led the division’s counterattack, and was mortally wounded"}]]}]]}],["$","article","Andrew J. Grigsby",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AJ"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"