2b:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep192-doubleday-advance.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep192-doubleday-advance.svg","alt":"Schematic map of Doubleday’s division advancing on both sides of the Hagerstown Turnpike.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Gibbon led the advance astride the turnpike while Phelps and Patrick supported and Battery B came into action near the Miller barn."}]]}],["$","figure","/images/ep192-hood-counterattack.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep192-hood-counterattack.svg","alt":"Schematic map of Hood’s counterattack through Miller’s Cornfield.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Wofford and Law drove north across the Cornfield front, but Federal infantry and Battery B stopped the attack near the field’s northern edge."}]]}],["$","figure","/images/ep192-confederate-dead-hagerstown-pike.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep192-confederate-dead-hagerstown-pike.jpg","alt":"Confederate dead beside a fence on the Hagerstown Pike after Antietam.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alexander Gardner’s September 1862 photograph records the aftermath along the road where Gibbon, Patrick, Wofford, and Battery B fought at close range."}]]}]]}]]}]
