33:["$","div","3rd Division, I Corps-Brig. Gen. George G. Meade",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division, I Corps"}],["$","span",null,{"children":"Brig. Gen. George G. Meade"}],["$","small",null,{"children":"Sent his remaining Pennsylvania Reserve brigades forward to resist Hood after Ricketts and Doubleday had been heavily engaged"}]]}]
