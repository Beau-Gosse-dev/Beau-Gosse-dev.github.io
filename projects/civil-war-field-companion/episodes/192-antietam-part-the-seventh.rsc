34:["$","div",null,{"children":[["$","h3",null,{"children":"A Confederate officer watches the approach"}],["$","p",null,{"children":"From in front of the West Woods, he sees the Federal double line advancing at a measured pace with bayonets fixed."}]]}]
35:["$","div","The Iron Brigade meets the Stonewall Brigade",{"className":"moment","children":[["$","$L32",null,{"seconds":697,"label":"11:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Iron Brigade meets the Stonewall Brigade"}],["$","p",null,{"children":"Andrew Grigsby’s Virginians rise from the clover west of the turnpike and deliver a destructive volley into Gibbon’s right flank."}]]}]]}]
36:["$","div","Grigsby withdraws into the West Woods",{"className":"moment","children":[["$","$L32",null,{"seconds":729,"label":"12:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grigsby withdraws into the West Woods"}],["$","p",null,{"children":"Federal numbers begin to tell, and the badly reduced Confederate line falls back to trees and rocky cover while another Federal brigade supports Gibbon’s right."}]]}]]}]
37:["$","div","The western Cornfield erupts",{"className":"moment","children":[["$","$L32",null,{"seconds":783,"label":"13:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The western Cornfield erupts"}],["$","p",null,{"children":"The 2nd and 6th Wisconsin reach the south edge of the corn and meet the concealed Confederate line described in Dawes’s opening account."}]]}]]}]
38:["$","div","Starke leads a counterattack",{"className":"moment","children":[["$","$L32",null,{"seconds":871,"label":"14:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Starke leads a counterattack"}],["$","p",null,{"children":"About 1,150 Confederates charge from the West Woods toward the turnpike and Cornfield, stopping the Federal advance in fighting sometimes conducted at about 30 yards."}]]}]]}]
39:["$","div","Starke falls mortally wounded",{"className":"moment","children":[["$","$L32",null,{"seconds":944,"label":"15:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Starke falls mortally wounded"}],["$","p",null,{"children":"Three bullets strike Starke. Grigsby becomes the division’s third commander in an hour and orders its remnants back into the West Woods."}]]}]]}]
3a:["$","div","McClellan believes Hooker is succeeding",{"className":"moment","children":[["$","$L32",null,{"seconds":1052,"label":"17:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan believes Hooker is succeeding"}],["$","p",null,{"children":"From the Pry house east of the creek, McClellan watches through a telescope and reportedly remarks that Hooker is driving the enemy."}]]}]]}]
3b:["$","div","The episode tests McClellan’s battle plan",{"className":"moment","children":[["$","$L32",null,{"seconds":1120,"label":"18:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode tests McClellan’s battle plan"}],["$","p",null,{"children":"The hosts argue that Hooker’s progress should have triggered pressure by Burnside and preparation by Sumner, but neither coordinated movement follows."}]]}]]}]
3c:["$","div","Lee transfers troops toward Jackson",{"className":"moment","children":[["$","$L32",null,{"seconds":1208,"label":"20:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee transfers troops toward Jackson"}],["$","p",null,{"children":"With the Federal left inactive, Lee sends George T. Anderson’s brigade and then John G. Walker’s division north while newly arrived divisions serve as reserves."}]]}]]}]
3d:["$","div","A. P. Hill starts from Harpers Ferry",{"className":"moment","children":[["$","$L32",null,{"seconds":1309,"label":"21:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"A. P. Hill starts from Harpers Ferry"}],["$","p",null,{"children":"Hill receives Lee’s 6:30 a.m. order, gets his Light Division on the road within an hour, and drives it toward Sharpsburg."}]]}]]}]
3e:["$","div","Jackson commits Hood’s last reserve",{"className":"moment","children":[["$","$L32",null,{"seconds":1412,"label":"23:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson commits Hood’s last reserve"}],["$","p",null,{"children":"The call reaches Hood’s division in the West Woods as Jackson attempts to prevent a breakthrough by Hooker’s I Corps."}]]}]]}]
3f:["$","div","Hood’s men abandon breakfast",{"className":"moment","children":[["$","$L32",null,{"seconds":1458,"label":"24:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood’s men abandon breakfast"}],["$","p",null,{"children":"The troops leave flour cakes cooking on ramrods, swallow what they can, and form for battle after days without a proper meal."}]]}]]}]
40:["$","div","Hood attacks with about 2,300 men",{"className":"moment","children":[["$","$L32",null,{"seconds":1503,"label":"25:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood attacks with about 2,300 men"}],["$","p",null,{"children":"Wofford’s Texas Brigade and Law’s brigade move out at about 7 a.m., relieve Lawton’s survivors, and advance across the front from the turnpike to the East Woods."}]]}]]}]
41:["$","div","A volley knocks the Federal line backward",{"className":"moment","children":[["$","$L32",null,{"seconds":1539,"label":"25:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"A volley knocks the Federal line backward"}],["$","p",null,{"children":"Hood’s opening fire strikes Gibbon’s men and the Confederates surge into the Cornfield, reversing the apparent course of the battle within minutes."}]]}]]}]
42:["$","div","Ricketts’s division breaks",{"className":"moment","children":[["$","$L32",null,{"seconds":1600,"label":"26:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ricketts’s division breaks"}],["$","p",null,{"children":"Law’s right wing drives through Ricketts’s depleted formations in the eastern Cornfield and East Woods; Ricketts doubts that 300 men remain with their colors."}]]}]]}]
43:["$","div","Hood warns Jackson",{"className":"moment","children":[["$","$L32",null,{"seconds":1640,"label":"27:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood warns Jackson"}],["$","p",null,{"children":"Hood reports that without reinforcement he will be forced back, but that he will continue forward as long as he can."}]]}]]}]
44:["$","div","Hooker finally calls Mansfield",{"className":"moment","children":[["$","$L32",null,{"seconds":1655,"label":"27:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker finally calls Mansfield"}],["$","p",null,{"children":"The XII Corps is summoned too late to preserve I Corps’s momentum, leaving Hooker to rely temporarily on Meade’s two remaining brigades."}]]}]]}]
45:["$","div","Hooker rides the white horse",{"className":"moment","children":[["$","$L32",null,{"seconds":1681,"label":"28:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker rides the white horse"}],["$","p",null,{"children":"The conspicuous I Corps commander moves among the troops and guns while Confederates of the 11th Mississippi try unsuccessfully to shoot him."}]]}]]}]
46:["$","div","Lawrence Daffan enters the counterattack",{"className":"moment","children":[["$","$L32",null,{"seconds":1718,"label":"28:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lawrence Daffan enters the counterattack"}],["$","p",null,{"children":"The 4th Texas veteran remembers passing Lawton’s dead Georgians, wheeling west to protect the brigade flank, and seeing the other Texas regiments enter the corn."}]]}]]}]
47:["$","div","Gibbon tends a gun under fire",{"className":"moment","children":[["$","$L32",null,{"seconds":1811,"label":"30:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gibbon tends a gun under fire"}],["$","p",null,{"children":"Battery B is under direct attack when Gibbon notices one piece firing too high, runs up its elevating screw, and restores its destructive close-range fire."}]]}]]}]
48:["$","div","Law flanks Meade’s Pennsylvanians",{"className":"moment","children":[["$","$L32",null,{"seconds":1922,"label":"32:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Law flanks Meade’s Pennsylvanians"}],["$","p",null,{"children":"Confederate fire wrecks two Federal regiments crossing the Miller pasture while the remaining two and nearby artillery fight back."}]]}]]}]
49:["$","div","The turnpike fight becomes point-blank",{"className":"moment","children":[["$","$L32",null,{"seconds":1958,"label":"32:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The turnpike fight becomes point-blank"}],["$","p",null,{"children":"Wofford’s men exchange fire with Gibbon and Marsena Patrick through smoke so thick that men can see little more than opposing flags."}]]}]]}]
4a:["$","div","J. H. Dingle falls with the colors",{"className":"moment","children":[["$","$L32",null,{"seconds":1991,"label":"33:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"J. H. Dingle falls with the colors"}],["$","p",null,{"children":"After three earlier color bearers are lost, the Hampton Legion major takes the flag to the turnpike fence and is killed instantly."}]]}]]}]
4b:["$","div","Infantrymen work Battery B",{"className":"moment","children":[["$","$L32",null,{"seconds":2020,"label":"33:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Infantrymen work Battery B"}],["$","p",null,{"children":"Casualties reduce the gun crews so severely that infantry volunteers serve the pieces, which fire double canister into Hood’s approaching line."}]]}]]}]
4c:["$","div","The 1st Texas outruns its support",{"className":"moment","children":[["$","$L32",null,{"seconds":2075,"label":"34:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 1st Texas outruns its support"}],["$","p",null,{"children":"The regiment charges ahead of Wofford’s flanks and reaches the northern edge of the Cornfield, where Meade’s troops fire from a fence line."}]]}]]}]
4d:["$","div","The 1st Texas is shattered",{"className":"moment","children":[["$","$L32",null,{"seconds":2114,"label":"35:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 1st Texas is shattered"}],["$","p",null,{"children":"The episode counts 186 casualties among 226 men in roughly 20 minutes, more than 82 percent, with eight color bearers shot down and the regiment’s flag lost."}]]}]]}]
4e:["$","div","Both initial commands are spent",{"className":"moment","children":[["$","$L32",null,{"seconds":2148,"label":"35:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both initial commands are spent"}],["$","p",null,{"children":"By about 7:30 a.m. Hooker and Jackson have committed nearly every available brigade, yet the front remains close to its position at daybreak."}]]}]]}]
4f:["$","div","I Corps losses are assessed",{"className":"moment","children":[["$","$L32",null,{"seconds":2190,"label":"36:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"I Corps losses are assessed"}],["$","p",null,{"children":"The episode gives Hooker about 2,600 casualties, roughly 30 percent, and says the corps is effectively finished fighting for the day."}]]}]]}]
50:["$","div","Jackson’s divisions are assessed",{"className":"moment","children":[["$","$L32",null,{"seconds":2229,"label":"37:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s divisions are assessed"}],["$","p",null,{"children":"The episode estimates about 3,000 Confederate casualties and describes exceptionally heavy command losses in Lawton’s, Jones’s, and Hood’s divisions."}]]}]]}]
51:["$","div","The book recommendation closes the episode",{"className":"moment","children":[["$","$L32",null,{"seconds":2322,"label":"38:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"The book recommendation closes the episode"}],["$","p",null,{"children":"The hosts recommend the Time-Life volume “Voices of the Civil War: Antietam” for its participant accounts and rich visual material."}]]}]]}]
52:["$","strong",null,{"children":"XII Corps"}]
53:["$","span",null,{"children":"Maj. Gen. Joseph K. F. Mansfield"}]
54:["$","small",null,{"children":"Advanced to relieve the exhausted I Corps after Hooker’s delayed request for assistance"}]
55:["$","section","Confederacy",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Shifted George T. Anderson’s brigade and John G. Walker’s division from the quiet right toward Jackson and ordered A. P. Hill forward from Harpers Ferry"}]]}],["$","div","Confederate left wing-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate left wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Committed Hood’s last available division reserve after the divisions of Lawton and Jones were badly damaged"}]]}],["$","div","Jackson’s division-Brig. Gen. John R. Jones / Brig. Gen. William E. Starke / Col. Andrew J. Grigsby",{"className":"command-entry","children":[["$","strong",null,{"children":"Jackson’s division"}],["$","span",null,{"children":"Brig. Gen. John R. Jones / Brig. Gen. William E. Starke / Col. Andrew J. Grigsby"}],["$","small",null,{"children":"Jones was disabled by artillery concussion, Starke was mortally wounded leading the counterattack, and Grigsby became the division’s third commander in about an hour"}]]}],["$","div","Stonewall Brigade-Col. Andrew J. Grigsby",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Col. Andrew J. Grigsby"}],["$","small",null,{"children":"Opposed Gibbon west of the turnpike, then assumed division command and withdrew the shattered formation into the West Woods"}]]}],["$","div","Ewell’s division-Brig. Gen. Alexander R. Lawton",{"className":"command-entry","children":[["$","strong",null,{"children":"Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Alexander R. Lawton"}],["$","small",null,{"children":"His battered division held south of the Cornfield until Lawton was wounded and Hood’s fresh troops passed through to counterattack"}]]}],["$","div","Hood’s division-Brig. Gen. John Bell Hood",{"className":"command-entry","children":[["$","strong",null,{"children":"Hood’s division"}],["$","span",null,{"children":"Brig. Gen. John Bell Hood"}],["$","small",null,{"children":"Sent roughly 2,300 men forward from the West Woods at about 7 a.m. and drove Hooker’s first line north through the Cornfield"}]]}],["$","div","Texas Brigade, Hood’s division-Col. William T. Wofford",{"className":"command-entry","children":[["$","strong",null,{"children":"Texas Brigade, Hood’s division"}],["$","span",null,{"children":"Col. William T. Wofford"}],["$","small",null,{"children":"Advanced on Hood’s left through the western Cornfield and along the Hagerstown Turnpike against Gibbon, Patrick, and Battery B"}]]}],["$","div","Law’s brigade, Hood’s division-Col. Evander M. Law",{"className":"command-entry","children":[["$","strong",null,{"children":"Law’s brigade, Hood’s division"}],["$","span",null,{"children":"Col. Evander M. Law"}],["$","small",null,{"children":"Advanced on Hood’s right through the eastern Cornfield toward the East Woods, breaking Ricketts’s remnants and striking Meade’s troops"}]]}],["$","div","Cavalry and horse artillery on Nicodemus Heights-Brig. Gen. J. E. B. Stuart / Maj. John Pelham",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry and horse artillery on Nicodemus Heights"}],["$","span",null,{"children":"Brig. Gen. J. E. B. Stuart / Maj. John Pelham"}],["$","small",null,{"children":"Maintained artillery pressure on Hooker’s right and tied down Federal batteries near the Poffenberger farm"}]]}],["$","div","Artillery battalion near the Dunker Church-Col. Stephen D. Lee",{"className":"command-entry","children":["$L62","$L63","$L64"]}]]]}]
