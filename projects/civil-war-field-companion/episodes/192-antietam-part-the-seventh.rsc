1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",192," · ","September 17, 1862"," · ","The northern Antietam battlefield near Sharpsburg, Maryland, from the Joseph Poffenberger farm and North Woods south along the Hagerstown Turnpike through Miller’s Cornfield to the West Woods and Dunker Church plateau"]}],["$","h1",null,{"children":"ANTIETAM (Part the Seventh)"}],["$","span",null,{"className":"result-label","children":"Abner Doubleday’s United States division advanced astride the Hagerstown Turnpike, where John Gibbon’s brigade and Battery B fought at close range against John R. Jones’s division. After Jones was disabled and William E. Starke was mortally wounded leading a counterattack, Andrew J. Grigsby withdrew the shattered Confederates into the West Woods. At about 7 a.m., John Bell Hood committed his two brigades, drove Hooker’s front line back through Miller’s Cornfield, and wrecked the remnants of James B. Ricketts’s division. Federal infantry and Battery B stopped Hood’s advance near the north edge of the Cornfield. By about 7:30 a.m. Hooker’s I Corps and Jackson’s original force were both spent, and neither side held a decisive advantage; Hooker then depended on Mansfield’s arriving XII Corps"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5608674518.mp3?updated=1695499467","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Doubleday’s attack and Hood’s counterattack, about 5:30–7:30 a.m."}],["$","small",null,{"children":"The episode continues the opening phase of Antietam west of the sector covered in episode 191, then follows Hood’s attack across the full Cornfield front and assesses the exhaustion of Hooker’s and Jackson’s initial forces."}]]}],["$","div","Doubleday’s formation",{"children":[["$","span",null,{"children":"Doubleday’s formation"}],["$","strong",null,{"children":"Gibbon leading; Phelps and Patrick supporting; Hofmann in reserve"}],["$","small",null,{"children":"The Antietam Battlefield Board tablets place Gibbon’s brigade in front when Doubleday’s division moved from the Poffenberger farm at about 5:30 a.m."}]]}],["$","div","Iron Brigade",{"children":[["$","span",null,{"children":"Iron Brigade"}],["$","strong",null,{"children":"2nd, 6th, and 7th Wisconsin and 19th Indiana"}],["$","small",null,{"children":"John Gibbon’s western brigade had recently earned its hard-fighting reputation. The episode describes Antietam as its third battle."}]]}],["$","div","Confederate artillery",{"children":[["$","span",null,{"children":"Confederate artillery"}],["$","strong",null,{"children":"Pelham on Nicodemus Heights and S. D. Lee near the Dunker Church"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}],"$L27","$undefined","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e"]}]]}]
32:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"The crossfire forced Hooker to divert four batteries toward his exposed right. The episode argues that the Confederates achieved local artillery superiority despite the Army of the Potomac’s larger artillery arm."}]
f:["$","div","Long-range Federal guns",{"children":[["$","span",null,{"children":"Long-range Federal guns"}],["$","strong",null,{"children":"20-pounder Parrott rifles east of Antietam Creek"}],["$","small",null,{"children":"The heavy rifles joined the counterbattery fire at long range. A shell from that direction disabled Confederate division commander John R. Jones, and S. D. Lee later called the ground near the church an “artillery hell.”"}]]}]
10:["$","div","Gibbon’s advance",{"children":[["$","span",null,{"children":"Gibbon’s advance"}],["$","strong",null,{"children":"Two regiments on each side of the Hagerstown Turnpike"}],["$","small",null,{"children":"The 2nd and 6th Wisconsin entered the western Cornfield east of the road. The 7th Wisconsin and 19th Indiana deployed westward after Confederate fire struck the brigade’s right flank."}]]}]
11:["$","div","Battery B, 4th U.S. Artillery",{"children":[["$","span",null,{"children":"Battery B, 4th U.S. Artillery"}],["$","strong",null,{"children":"Six guns beside the turnpike near the Miller barn"}],["$","small",null,{"children":"Gibbon’s former Regular Army battery advanced in direct support. Capt. Joseph B. Campbell and Lt. James Stewart commanded it during the battle."}]]}]
12:["$","div","First close-range fight",{"children":[["$","span",null,{"children":"First close-range fight"}],["$","strong",null,{"children":"Gibbon against Grigsby’s Virginians"}],["$","small",null,{"children":"Confederates rose from cover west and south of the turnpike and fired into Gibbon’s line. After losing more than half its strength in the episode’s account, Grigsby’s command fell back into the West Woods."}]]}]
13:["$","div","Federal foothold",{"children":[["$","span",null,{"children":"Federal foothold"}],["$","strong",null,{"children":"Northern West Woods"}],["$","small",null,{"children":"Patrick’s brigade moved west of the turnpike to support Gibbon and Battery B, helping Doubleday’s division gain a temporary foothold in the northern part of the woods."}]]}]
14:["$","div","Starke’s counterattack",{"children":[["$","span",null,{"children":"Starke’s counterattack"}],["$","strong",null,{"children":"About 1,150 Confederates"}],["$","small",null,{"children":"After replacing the disabled John R. Jones, William E. Starke led the division’s remaining brigades out of the West Woods toward the turnpike and Cornfield. Parts of the opposing lines fought at roughly 30 yards."}]]}]
15:["$","div","Third division commander",{"children":[["$","span",null,{"children":"Third division commander"}],["$","strong",null,{"children":"Andrew J. Grigsby"}],["$","small",null,{"children":"Starke was hit three times and mortally wounded. Grigsby then took over the division, its third commander in about an hour, and withdrew the battered troops into the West Woods."}]]}]
16:["$","div","McClellan’s observation point",{"children":[["$","span",null,{"children":"McClellan’s observation point"}],["$","strong",null,{"children":"The Philip Pry house east of Antietam Creek"}],["$","small",null,{"children":"McClellan and Fitz John Porter watched the distant northern battle through telescopes. At about 7 a.m. McClellan reportedly believed Hooker was driving the Confederates."}]]}]
17:["$","div","Unused early opportunity",{"children":[["$","span",null,{"children":"Unused early opportunity"}],["$","strong",null,{"children":"No simultaneous attack by Burnside or Sumner"}],["$","small",null,{"children":"The episode argues that McClellan did not exploit Hooker’s apparent progress. Burnside was told only to prepare, and Sumner’s II Corps remained east of the creek awaiting orders."}]]}]
18:["$","div","Lee shifts reinforcements",{"children":[["$","span",null,{"children":"Lee shifts reinforcements"}],["$","strong",null,{"children":"George T. Anderson’s brigade and John G. Walker’s division"}],["$","small",null,{"children":"Seeing no immediate Federal attack at the lower bridge, Lee ordered troops from his right toward Jackson. The newly arrived divisions of Lafayette McLaws and Richard H. Anderson gave Lee additional reserves."}]]}]
19:["$","div","March-to-the-guns contrast",{"children":[["$","span",null,{"children":"March-to-the-guns contrast"}],["$","strong",null,{"children":"A. P. Hill moved urgently; Darius Couch did not"}],["$","small",null,{"children":"The episode contrasts Hill’s forced march from Harpers Ferry after a 6:30 a.m. order with Couch’s slower return from Pleasant Valley. This is command analysis, not action within the episode’s immediate battlefield sector."}]]}]
1a:["$","div","Hood called forward",{"children":[["$","span",null,{"children":"Hood called forward"}],["$","strong",null,{"children":"About 2,300 men in two brigades"}],["$","small",null,{"children":"Hood’s men had been pulled into reserve to cook their first hot meal in days. They abandoned half-baked flour cakes and moved out of the West Woods when Jackson requested help."}]]}]
1b:["$","div","Hood’s formation",{"children":[["$","span",null,{"children":"Hood’s formation"}],["$","strong",null,{"children":"Wofford on the left and Law on the right"}],["$","small",null,{"children":"William T. Wofford led the Texas Brigade toward the turnpike and western Cornfield. Evander M. Law’s brigade extended the attack eastward toward the East Woods."}]]}]
1c:["$","div","Initial effect",{"children":[["$","span",null,{"children":"Initial effect"}],["$","strong",null,{"children":"Hooker’s first line driven into and through the Cornfield"}],["$","small",null,{"children":"Hood allowed Lawton’s survivors to pass through his line, then opened with a heavy volley and advanced. Rufus Dawes said the fire struck the 6th Wisconsin like a scythe."}]]}]
1d:["$","div","Ricketts’s division",{"children":[["$","span",null,{"children":"Ricketts’s division"}],["$","strong",null,{"children":"Almost 40 percent casualties; perhaps 300 still with the colors"}],["$","small",null,{"children":"Ricketts estimated that only about 300 of the 3,150 men who began the attack remained with their colors after Hood’s advance, with additional losses to straggling and flight."}]]}]
1e:["$","div","Hooker calls XII Corps",{"children":[["$","span",null,{"children":"Hooker calls XII Corps"}],["$","strong",null,{"children":"After Hood’s counterattack was underway"}],["$","small",null,{"children":"Mansfield’s corps was too late to sustain I Corps’s initial momentum but arrived in time to keep the northern attack from ending with I Corps’s defeat."}]]}]
1f:["$","div","Battery B’s defense",{"children":[["$","span",null,{"children":"Battery B’s defense"}],["$","strong",null,{"children":"Double-shotted canister at close range"}],["$","small",null,{"children":"Infantry volunteers replaced fallen cannoneers. Gibbon personally corrected the elevation of one gun, and the battery helped stop repeated efforts to take the pieces."}]]}]
20:["$","div","1st Texas loss",{"children":[["$","span",null,{"children":"1st Texas loss"}],["$","strong",null,{"children":"186 casualties among 226 engaged, more than 82 percent"}],["$","small",null,{"children":"The regiment surged ahead of the rest of Wofford’s brigade and reached the north edge of the Cornfield. National Park Service interpretation identifies its loss as 82 percent; nine color bearers fell and the Lone Star flag was lost."}]]}]
21:["$","div","I Corps loss",{"children":[["$","span",null,{"children":"I Corps loss"}],["$","strong",null,{"children":"About 2,600 casualties, roughly 30 percent"}],["$","small",null,{"children":"The episode says more than three-quarters of these losses fell on the divisions of Ricketts and Doubleday. I Corps was effectively finished as an attacking force for the day."}]]}]
22:["$","div","Jackson’s opening-force loss",{"children":[["$","span",null,{"children":"Jackson’s opening-force loss"}],["$","strong",null,{"children":"About 3,000 casualties in the episode’s estimate"}],["$","small",null,{"children":"The episode estimates that Lawton’s division lost nearly half its strength, John R. Jones’s division about 40 percent, and Hood’s division about 60 percent. These figures summarize commands engaged in the opening phase, not the entire Confederate army."}]]}]
23:["$","div","Immediate outcome",{"children":[["$","span",null,{"children":"Immediate outcome"}],["$","strong",null,{"children":"Both opening forces spent; little ground gained"}],["$","small",null,{"children":"By about 7:30 a.m. Federal troops held part of the northern West Woods and some of Hood’s men held part of the East Woods, but the opposing fronts otherwise stood near their daybreak positions."}]]}]
24:["$","div","Senior leader losses in scope",{"children":[["$","span",null,{"children":"Senior leader losses in scope"}],["$","strong",null,{"children":"Starke mortally wounded; Lawton, Bragg, and Campbell wounded"}],["$","small",null,{"children":"John R. Jones was also disabled by artillery concussion. Field officers killed included Alois O. Bachman of the 19th Indiana and Matt Dale of the 1st Texas."}]]}]
25:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Voices of the Civil War: Antietam” by the Editors of Time-Life Books"}],["$","small",null,{"children":"The hosts recommend the volume for its first-person accounts, maps, sketches, photographs, and images of artifacts."}]]}]
26:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Dunker Church, Gibbon, Nicodemus Heights, Grigsby, Starke, Marsena Patrick, George T. Anderson, Wofford, Law, Rufus Dawes, Philip A. Work, and Lawrence A. Daffan"}],["$","small",null,{"children":"The automated transcript produces forms including “Dunkard,” “Gibbons,” “Nicodemus,” “Grigsby,” “Stark,” “Marcena,” “Tyg,” “Woffords,” “Loss,” and “Daffin.” This guide uses standard historical spellings while retaining Dunker Church, the name used by the National Park Service."}]]}]
27:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
28:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Doubleday advances astride the turnpike, about 5:30–7 a.m.",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep192-doubleday-advance.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Doubleday advances astride the turnpike, about 5:30–7 a.m. at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep192-doubleday-advance.svg","alt":"Schematic map of Doubleday’s division advancing south from the North Woods on both sides of the Hagerstown Turnpike against Grigsby and Starke, with Battery B near the Miller barn.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Doubleday advances astride the turnpike, about 5:30–7 a.m."}],["$","span",null,{"children":"Gibbon led Doubleday’s division from the North Woods with the 2nd and 6th Wisconsin east of the Hagerstown Turnpike and the 7th Wisconsin and 19th Indiana west of it. Phelps supported the left while Patrick crossed west to support Gibbon and Battery B. Grigsby’s Virginians fired from a rocky ledge and the West Woods before Starke led the division’s remaining brigades forward. Positions and movements are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep192-doubleday-advance.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam Battlefield Board tablets, Gibbon’s and Patrick’s Official Reports, Antietam National Battlefield order of battle, U.S. Army Center of Military History staff ride guide, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Hood’s counterattack, about 7–7:30 a.m.",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep192-hood-counterattack.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Hood’s counterattack, about 7–7:30 a.m. at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep192-hood-counterattack.svg","alt":"Schematic tactical map showing Hood’s division advancing north through Miller’s Cornfield against Federal infantry and Battery B, with the 1st Texas reaching the Cornfield’s north edge.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Hood’s counterattack, about 7–7:30 a.m."}],["$","span",null,{"children":"Hood sent Wofford’s Texas Brigade and Law’s brigade north from the Dunker Church and West Woods on a broad front. The attack drove Gibbon, Patrick, Ricketts, and parts of Meade’s division backward. Battery B fired canister beside the turnpike. The 1st Texas surged ahead to the Cornfield’s north fence, where Federal fire shattered it, and Hood’s advance stalled. Positions and movements are generalized and compressed. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep192-hood-counterattack.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ","$L2f"]}],"$L30"]}],"$undefined"]}]]}],"$L31"]}]]}]
29:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The 6th Wisconsin loses officers in the corn",{"className":"moment","children":[["$","$L32",null,{"seconds":40,"label":"0:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 6th Wisconsin loses officers in the corn"}],["$","p",null,{"children":"Rufus Dawes’s recollection opens with Capt. Edwin A. Brown killed while giving an order, Lieut. John Bode killed, Lieut. John Ticknor wounded, and Lieut. Col. Edward S. Bragg shot as the regiment advances."}]]}]]}],["$","div","The opposing lines rise at the Cornfield fence",{"className":"moment","children":[["$","$L32",null,{"seconds":140,"label":"2:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The opposing lines rise at the Cornfield fence"}],["$","p",null,{"children":"Dawes describes Gibbon’s troops reaching the south edge of the corn and exchanging a simultaneous close-range volley with Confederates in the pasture beyond."}]]}]]}],["$","div","Philip Work reports the 1st Texas’s destruction",{"className":"moment","children":[["$","$L32",null,{"seconds":185,"label":"3:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Philip Work reports the 1st Texas’s destruction"}],["$","p",null,{"children":"The regiment’s right and left wings report that nearly every man has been hit, and Maj. Matt Dale is killed while speaking with Work."}]]}]]}],["$","div","The 1st Texas falls back without its flags",{"className":"moment","children":[["$","$L32",null,{"seconds":257,"label":"4:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 1st Texas falls back without its flags"}],["$","p",null,{"children":"Work directs the surviving wings to withdraw while an attempt to recover the regiment’s fallen colors fails in the face of advancing Federal infantry."}]]}]]}],["$","div","The opening battle is recapped",{"className":"moment","children":[["$","$L32",null,{"seconds":333,"label":"5:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The opening battle is recapped"}],["$","p",null,{"children":"The hosts place Hooker’s I Corps against Jackson north of Sharpsburg and distinguish Ricketts’s eastern attack from Doubleday’s simultaneous attack along the turnpike."}]]}]]}],["$","div","Gibbon’s brigade leads Doubleday forward",{"className":"moment","children":[["$","$L32",null,{"seconds":455,"label":"7:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gibbon’s brigade leads Doubleday forward"}],["$","p",null,{"children":"The Wisconsin and Indiana regiments of the recently named Iron Brigade emerge from the North Woods at the head of the Federal advance."}]]}]]}],["$","div","Pelham and S. D. Lee create a crossfire",{"className":"moment","children":[["$","$L32",null,{"seconds":480,"label":"8:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pelham and S. D. Lee create a crossfire"}],["$","p",null,{"children":"Confederate artillery on Nicodemus Heights and near the Dunker Church strikes Doubleday’s movement while Federal batteries answer from the north and east of Antietam Creek."}]]}]]}],["$","div","A Federal shell disables John R. Jones",{"className":"moment","children":[["$","$L32",null,{"seconds":578,"label":"9:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"A Federal shell disables John R. Jones"}],["$","p",null,{"children":"A bursting long-range shell stuns the Confederate division commander, and Brig. Gen. William E. Starke replaces him."}]]}]]}],["$","div","The Iron Brigade splits around the turnpike",{"className":"moment","children":[["$","$L32",null,{"seconds":627,"label":"10:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Iron Brigade splits around the turnpike"}],["$","p",null,{"children":"Part of Gibbon’s line enters the orchard and Cornfield east of the road while the rest advances through clover to the west; Battery B unlimbers near the Miller barn."}]]}]]}],["$","div","A Confederate officer watches the approach",{"className":"moment","children":["$L33","$L34"]}],"$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51"]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Observed the northern fight from the Philip Pry house but did not launch simultaneous attacks by Burnside and Sumner during Hooker’s apparent progress"}]]}],["$","div","I Corps and northern wing-Maj. Gen. Joseph Hooker",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps and northern wing"}],["$","span",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","small",null,{"children":"Directed I Corps’s attack, moved reserves and guns forward in person, and called for Mansfield’s XII Corps after Hood counterattacked"}]]}],["$","div","1st Division, I Corps-Brig. Gen. Abner Doubleday",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, I Corps"}],["$","span",null,{"children":"Brig. Gen. Abner Doubleday"}],["$","small",null,{"children":"Advanced with Gibbon leading, Phelps and Patrick supporting, and Hofmann held in reserve near the Poffenberger batteries"}]]}],["$","div","4th Brigade, Doubleday’s division-Brig. Gen. John Gibbon",{"className":"command-entry","children":[["$","strong",null,{"children":"4th Brigade, Doubleday’s division"}],["$","span",null,{"children":"Brig. Gen. John Gibbon"}],["$","small",null,{"children":"Led the Iron Brigade astride the Hagerstown Turnpike and helped direct Battery B in the close-range fight"}]]}],["$","div","1st Brigade, Doubleday’s division-Col. Walter Phelps Jr.",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Doubleday’s division"}],["$","span",null,{"children":"Col. Walter Phelps Jr."}],["$","small",null,{"children":"Followed Gibbon and moved up on the division’s left east of the Hagerstown Turnpike"}]]}],["$","div","3rd Brigade, Doubleday’s division-Brig. Gen. Marsena R. Patrick",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Brigade, Doubleday’s division"}],["$","span",null,{"children":"Brig. Gen. Marsena R. Patrick"}],["$","small",null,{"children":"Crossed west of the turnpike to support Gibbon’s right and Battery B, helping secure a temporary foothold in the West Woods"}]]}],["$","div","2nd Brigade, Doubleday’s division-Lt. Col. J. William Hofmann",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade, Doubleday’s division"}],["$","span",null,{"children":"Lt. Col. J. William Hofmann"}],["$","small",null,{"children":"Commanded the brigade retained near the Poffenberger farm to guard the batteries facing Nicodemus Heights"}]]}],["$","div","Battery B, 4th U.S. Artillery-Capt. Joseph B. Campbell / Lt. James Stewart",{"className":"command-entry","children":[["$","strong",null,{"children":"Battery B, 4th U.S. Artillery"}],["$","span",null,{"children":"Capt. Joseph B. Campbell / Lt. James Stewart"}],["$","small",null,{"children":"Supported Gibbon near the Miller barn and turnpike; Stewart continued after Campbell was wounded and infantry volunteers filled depleted gun crews"}]]}],["$","div","3rd Division, I Corps-Brig. Gen. George G. Meade",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division, I Corps"}],["$","span",null,{"children":"Brig. Gen. George G. Meade"}],["$","small",null,{"children":"Sent his remaining Pennsylvania Reserve brigades forward to resist Hood after Ricketts and Doubleday had been heavily engaged"}]]}],["$","div","XII Corps-Maj. Gen. Joseph K. F. Mansfield",{"className":"command-entry","children":["$L52","$L53","$L54"]}]]]}],"$L55"]}],"$L56","$L57"]}]
2b:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. William E. Starke",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. William E. Starke"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of Jackson’s division after John R. Jones was disabled","."]}]," ","Hit by three bullets and mortally wounded while leading the division’s counterattack from the West Woods; Col. Andrew J. Grigsby assumed command."]}]]}],["$","article","Brig. Gen. Alexander R. Lawton",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Alexander R. Lawton"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of Ewell’s division","."]}]," ","Seriously wounded during the opening Cornfield battle before Hood’s division relieved the surviving front line."]}]]}],["$","article","Lt. Col. Alois O. Bachman",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Lt. Col. Alois O. Bachman"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the 19th Indiana, Gibbon’s brigade","."]}]," ","Mortally wounded during the close fight west of the Hagerstown Turnpike; Gibbon’s report praised his gallantry."]}]]}],["$","article","Lt. Col. Edward S. Bragg",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Lt. Col. Edward S. Bragg"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the 6th Wisconsin, Gibbon’s brigade","."]}]," ","Wounded during the advance through the western Cornfield; Maj. Rufus R. Dawes succeeded him in command."]}]]}],["$","article","Capt. Joseph B. Campbell",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Capt. Joseph B. Campbell"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of Battery B, 4th U.S. Artillery","."]}]," ","Shot through the shoulder while serving his guns; Lt. James Stewart and a depleted crew continued the battery’s defense."]}]]}],["$","article","Maj. Matt Dale",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Maj. Matt Dale"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the right wing of the 1st Texas","."]}]," ","Killed while reporting the destruction of his wing to Lt. Col. Philip A. Work during the regiment’s advance."]}]]}],["$","article","Maj. J. H. Dingle",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Maj. J. H. Dingle"}],["$","p",null,{"children":[["$","strong",null,{"children":["Field officer of the Hampton Legion","."]}]," ","Killed at the Hagerstown Turnpike fence while carrying the regiment’s colors after three earlier color bearers had fallen."]}]]}]]}]]}]
2c:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep192-doubleday-advance.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep192-doubleday-advance.svg","alt":"Schematic map of Doubleday’s division advancing on both sides of the Hagerstown Turnpike.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Gibbon led the advance astride the turnpike while Phelps and Patrick supported and Battery B came into action near the Miller barn."}]]}],["$","figure","/images/ep192-hood-counterattack.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep192-hood-counterattack.svg","alt":"Schematic map of Hood’s counterattack through Miller’s Cornfield.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Wofford and Law drove north across the Cornfield front, but Federal infantry and Battery B stopped the attack near the field’s northern edge."}]]}],["$","figure","/images/ep192-confederate-dead-hagerstown-pike.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep192-confederate-dead-hagerstown-pike.jpg","alt":"Confederate dead beside a fence on the Hagerstown Pike after Antietam.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alexander Gardner’s September 1862 photograph records the aftermath along the road where Gibbon, Patrick, Wofford, and Battery B fought at close range."}]]}]]}]]}]
