35:["$","section","Confederacy",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Shifted George T. Anderson’s brigade and John G. Walker’s division from the quiet right toward Jackson and ordered A. P. Hill forward from Harpers Ferry"}]]}],["$","div","Confederate left wing-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate left wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Committed Hood’s last available division reserve after the divisions of Lawton and Jones were badly damaged"}]]}],["$","div","Jackson’s division-Brig. Gen. John R. Jones / Brig. Gen. William E. Starke / Col. Andrew J. Grigsby",{"className":"command-entry","children":[["$","strong",null,{"children":"Jackson’s division"}],["$","span",null,{"children":"Brig. Gen. John R. Jones / Brig. Gen. William E. Starke / Col. Andrew J. Grigsby"}],["$","small",null,{"children":"Jones was disabled by artillery concussion, Starke was mortally wounded leading the counterattack, and Grigsby became the division’s third commander in about an hour"}]]}],["$","div","Stonewall Brigade-Col. Andrew J. Grigsby",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Col. Andrew J. Grigsby"}],["$","small",null,{"children":"Opposed Gibbon west of the turnpike, then assumed division command and withdrew the shattered formation into the West Woods"}]]}],["$","div","Ewell’s division-Brig. Gen. Alexander R. Lawton",{"className":"command-entry","children":[["$","strong",null,{"children":"Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Alexander R. Lawton"}],["$","small",null,{"children":"His battered division held south of the Cornfield until Lawton was wounded and Hood’s fresh troops passed through to counterattack"}]]}],["$","div","Hood’s division-Brig. Gen. John Bell Hood",{"className":"command-entry","children":[["$","strong",null,{"children":"Hood’s division"}],["$","span",null,{"children":"Brig. Gen. John Bell Hood"}],["$","small",null,{"children":"Sent roughly 2,300 men forward from the West Woods at about 7 a.m. and drove Hooker’s first line north through the Cornfield"}]]}],["$","div","Texas Brigade, Hood’s division-Col. William T. Wofford",{"className":"command-entry","children":[["$","strong",null,{"children":"Texas Brigade, Hood’s division"}],["$","span",null,{"children":"Col. William T. Wofford"}],["$","small",null,{"children":"Advanced on Hood’s left through the western Cornfield and along the Hagerstown Turnpike against Gibbon, Patrick, and Battery B"}]]}],["$","div","Law’s brigade, Hood’s division-Col. Evander M. Law",{"className":"command-entry","children":[["$","strong",null,{"children":"Law’s brigade, Hood’s division"}],["$","span",null,{"children":"Col. Evander M. Law"}],["$","small",null,{"children":"Advanced on Hood’s right through the eastern Cornfield toward the East Woods, breaking Ricketts’s remnants and striking Meade’s troops"}]]}],["$","div","Cavalry and horse artillery on Nicodemus Heights-Brig. Gen. J. E. B. Stuart / Maj. John Pelham",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry and horse artillery on Nicodemus Heights"}],["$","span",null,{"children":"Brig. Gen. J. E. B. Stuart / Maj. John Pelham"}],["$","small",null,{"children":"Maintained artillery pressure on Hooker’s right and tied down Federal batteries near the Poffenberger farm"}]]}],["$","div","Artillery battalion near the Dunker Church-Col. Stephen D. Lee",{"className":"command-entry","children":["$L41","$L42","$L43"]}]]]}]
