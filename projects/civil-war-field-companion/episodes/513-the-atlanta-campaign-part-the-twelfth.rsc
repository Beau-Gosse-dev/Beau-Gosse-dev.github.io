11:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L18",null,{"guide":{"date":"May 20–June 4, 1864","place":"Etowah River, New Hope Church, Pickett’s Mill, and Acworth, Georgia","result":"Sherman bypassed Allatoona, suffered tactical defeats near Dallas, then regained the railroad closer to Atlanta","facts":[{"label":"New Hope Church","value":"About 1,500 U.S. casualties; fewer than 500 Confederate"},{"label":"Pickett’s Mill","value":"More than 1,500 U.S. casualties; about 450 Confederate"},{"label":"Allatoona Pass occupied","value":"June 1"},{"label":"Federal return to railroad","value":"Nearly complete by June 4"}],"maps":[{"title":"The Dallas movement","caption":"The campaign map shows Cassville, the Etowah River, Allatoona Pass, Dallas, New Hope Church, Acworth, and the Western and Atlantic Railroad.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of the Atlanta campaign from Cassville to Kennesaw Mountain"},{"title":"Dallas, New Hope Church, and Pickett’s Mill today","caption":"Sherman crossed west of Allatoona, moved through Dallas and New Hope Church, then shifted northeast through Pickett’s Mill toward Acworth.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-85.00%2C33.84%2C-84.60%2C34.10&layer=mapnik&marker=33.971%2C-84.771"},{"title":"Field fortifications used in the campaign","caption":"A wartime view of earth-and-timber works. Similar fieldworks shaped the fighting around New Hope Church and Pickett’s Mill.","source":"https://www.loc.gov/item/2018670937/","image":"/images/atlanta-fortifications.jpg","alt":"Civil War earthwork fortifications built with soil and timber"}],"moments":[{"time":"2:05","audioTime":125,"title":"Johnston abandoned Cassville","detail":"The Army of Tennessee crossed the Etowah River, destroyed nearby bridges, and moved toward Allatoona Pass."},{"time":"3:33","audioTime":213,"title":"U.S. morale rose after the retreat","detail":"In less than three weeks, Sherman had forced Johnston about halfway from Dalton toward Atlanta without a general battle."},{"time":"4:07","audioTime":247,"title":"Sherman rested north of the Etowah","detail":"Thomas camped near Cassville, McPherson at Kingston, and Schofield near Cass Station while supplies accumulated."},{"time":"5:55","audioTime":355,"title":"Allatoona Pass offered a strong defense","detail":"The railroad cut passed through high ground more than 80 feet deep in places. Johnston expected a direct U.S. advance."},{"time":"7:02","audioTime":422,"title":"Sherman chose to bypass Allatoona","detail":"He planned to cross west of the pass and move about 15 miles south to Dallas, away from his railroad supply line."},{"time":"8:22","audioTime":502,"title":"The U.S. armies prepared for an off-railroad movement","detail":"They built up wagon supplies, evacuated sick and wounded men, and repaired the railroad behind them."},{"time":"9:42","audioTime":582,"title":"Three armies began a wide wheel west","detail":"McPherson crossed near Kingston, Thomas at Gillam’s Bridge, and Hooker and Schofield farther upstream."},{"time":"11:03","audioTime":663,"title":"Confederate cavalry detected the maneuver","detail":"Johnston sent Hardee and Polk southwest toward Dallas while Hood temporarily remained at Allatoona."},{"time":"13:03","audioTime":783,"title":"Wheeler confirmed the Etowah crossing","detail":"On May 24, Confederate cavalry reported most U.S. infantry south of the river. Johnston then ordered Hood toward Dallas."},{"time":"13:25","audioTime":805,"title":"Johnston formed a new line","detail":"By May 25, the Confederates extended from south of Dallas northeast to New Hope Church."},{"time":"15:10","audioTime":910,"title":"The U.S. march was slow","detail":"Poor roads, woods, heat, humidity, limited water, and Confederate cavalry delayed the columns."},{"time":"15:52","audioTime":952,"title":"Hooker reached New Hope Church","detail":"The XX Corps found Alexander P. Stewart’s fortified division with 16 artillery pieces on a low ridge."},{"time":"17:39","audioTime":1059,"title":"Hooker attacked around 4 p.m.","detail":"Three divisions advanced in columns of brigades through woods and underbrush. Confederate fire stopped the leading brigade of each column."},{"time":"19:03","audioTime":1143,"title":"The New Hope Church attack failed","detail":"Hooker lost about 1,500 men. Confederate losses were probably below 500."},{"time":"20:42","audioTime":1242,"title":"The armies formed parallel lines","detail":"On May 26, McPherson held the U.S. right at Dallas, Thomas the center near New Hope Church, and Schofield the left."},{"time":"22:00","audioTime":1320,"title":"Howard attempted to turn the Confederate right","detail":"A IV Corps division marched northeast on May 27, but Confederate scouts detected the movement and Johnston extended his line."},{"time":"23:09","audioTime":1389,"title":"The attack began near Pickett’s Mill","detail":"At about 4:45 p.m., U.S. troops advanced across rough ground and met Patrick Cleburne’s division on a ridge."},{"time":"23:46","audioTime":1426,"title":"Cleburne repulsed the attack","detail":"The leading U.S. brigade lost about 500 men in minutes. Additional units also failed to break the Confederate line."},{"time":"24:28","audioTime":1468,"title":"Pickett’s Mill produced heavy losses","detail":"U.S. casualties exceeded 1,500. Cleburne reported 398 infantry casualties, and cavalry losses raised the Confederate total to about 450."},{"time":"25:49","audioTime":1549,"title":"Hood’s counterstroke was canceled","detail":"On May 28, Hood approached the exposed U.S. left but withdrew after learning the line had been pulled back and fortified."},{"time":"27:21","audioTime":1641,"title":"Sherman could not continue south","detail":"His scattered line, muddy roads, ration shortages, and distance from the railroad made a drive to the Chattahoochee impractical."},{"time":"29:00","audioTime":1740,"title":"The U.S. armies shifted back toward the railroad","detail":"McPherson moved northeast first, closing gaps so Thomas and Schofield could follow. Cavalry moved to seize Allatoona Pass."},{"time":"30:24","audioTime":1824,"title":"The U.S. line reunited","detail":"By June 1, McPherson reached New Hope Church and U.S. cavalry occupied undefended Allatoona Pass."},{"time":"31:01","audioTime":1861,"title":"Acworth fell and the railroad was regained","detail":"U.S. infantry entered Acworth on June 1. By June 4, almost all of Sherman’s armies were back on the railroad."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed the Dallas movement"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Palmer’s XIV Corps, Howard’s IV Corps, and Hooker’s XX Corps"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Held the U.S. right at Dallas"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"Held the U.S. left"},{"commander":"Oliver O. Howard","command":"IV Corps","subordinates":"Directed the Pickett’s Mill flank movement"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Shifted from Allatoona toward Dallas"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Alexander P. Stewart at New Hope Church"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Patrick Cleburne at Pickett’s Mill"},{"commander":"Leonidas Polk","command":"Polk’s Corps","subordinates":"Moved toward Dallas with Hardee"},{"commander":"Joseph Wheeler","command":"Cavalry Corps","subordinates":"Tracked the U.S. river crossing and flank movement"}]}],"people":[{"name":"William T. Sherman","role":"Bypassed Allatoona and later returned the armies to the railroad","side":"United States"},{"name":"Joseph E. Johnston","role":"Matched Sherman’s movement with interior lines and built a new defensive position","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"Joseph Hooker","role":"Commanded the failed U.S. attack at New Hope Church","side":"United States"},{"name":"Oliver O. Howard","role":"Directed the flank movement and attack at Pickett’s Mill","side":"United States"},{"name":"Patrick R. Cleburne","role":"Commanded the Confederate division that defeated the Pickett’s Mill attack","side":"Confederacy"},{"name":"Alexander P. Stewart","role":"Commanded the Confederate division that stopped Hooker at New Hope Church","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of the Atlanta campaign","caption":"The campaign map shows the off-railroad movement and return toward Acworth.","source":"https://www.loc.gov/item/2008628278/"},{"image":"/images/atlanta-fortifications.jpg","alt":"Civil War field fortifications made from earth and timber","caption":"Prepared fieldworks determined the results at New Hope Church and Pickett’s Mill.","source":"https://www.loc.gov/item/2018670937/"}],"sources":[{"label":"Official Episode 513 page","url":"https://civilwarpodcast.org/2025/12/07/civil-war-podcast-episode-513/"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"Library of Congress Atlanta fortifications photograph","url":"https://www.loc.gov/item/2018670937/"}]}}]}]
