19:["$","div","Hooker attacked around 4 p.m.",{"className":"moment","children":[["$","$L16",null,{"seconds":1059,"label":"17:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker attacked around 4 p.m."}],["$","p",null,{"children":"Three divisions advanced in columns of brigades through woods and underbrush. Confederate fire stopped the leading brigade of each column."}]]}]]}]
1a:["$","div","The New Hope Church attack failed",{"className":"moment","children":[["$","$L16",null,{"seconds":1143,"label":"19:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The New Hope Church attack failed"}],["$","p",null,{"children":"Hooker lost about 1,500 men. Confederate losses were probably below 500."}]]}]]}]
1b:["$","div","The armies formed parallel lines",{"className":"moment","children":[["$","$L16",null,{"seconds":1242,"label":"20:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies formed parallel lines"}],["$","p",null,{"children":"On May 26, McPherson held the U.S. right at Dallas, Thomas the center near New Hope Church, and Schofield the left."}]]}]]}]
1c:["$","div","Howard attempted to turn the Confederate right",{"className":"moment","children":[["$","$L16",null,{"seconds":1320,"label":"22:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Howard attempted to turn the Confederate right"}],["$","p",null,{"children":"A IV Corps division marched northeast on May 27, but Confederate scouts detected the movement and Johnston extended his line."}]]}]]}]
1d:["$","div","The attack began near Pickett’s Mill",{"className":"moment","children":[["$","$L16",null,{"seconds":1389,"label":"23:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack began near Pickett’s Mill"}],["$","p",null,{"children":"At about 4:45 p.m., U.S. troops advanced across rough ground and met Patrick Cleburne’s division on a ridge."}]]}]]}]
1e:["$","div","Cleburne repulsed the attack",{"className":"moment","children":[["$","$L16",null,{"seconds":1426,"label":"23:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cleburne repulsed the attack"}],["$","p",null,{"children":"The leading U.S. brigade lost about 500 men in minutes. Additional units also failed to break the Confederate line."}]]}]]}]
1f:["$","div","Pickett’s Mill produced heavy losses",{"className":"moment","children":[["$","$L16",null,{"seconds":1468,"label":"24:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pickett’s Mill produced heavy losses"}],["$","p",null,{"children":"U.S. casualties exceeded 1,500. Cleburne reported 398 infantry casualties, and cavalry losses raised the Confederate total to about 450."}]]}]]}]
