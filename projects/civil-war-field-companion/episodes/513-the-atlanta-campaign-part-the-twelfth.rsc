11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Johnston abandoned Cassville",{"className":"moment","children":[["$","$L16",null,{"seconds":125,"label":"2:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston abandoned Cassville"}],["$","p",null,{"children":"The Army of Tennessee crossed the Etowah River, destroyed nearby bridges, and moved toward Allatoona Pass."}]]}]]}],["$","div","U.S. morale rose after the retreat",{"className":"moment","children":[["$","$L16",null,{"seconds":213,"label":"3:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. morale rose after the retreat"}],["$","p",null,{"children":"In less than three weeks, Sherman had forced Johnston about halfway from Dalton toward Atlanta without a general battle."}]]}]]}],["$","div","Sherman rested north of the Etowah",{"className":"moment","children":[["$","$L16",null,{"seconds":247,"label":"4:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman rested north of the Etowah"}],["$","p",null,{"children":"Thomas camped near Cassville, McPherson at Kingston, and Schofield near Cass Station while supplies accumulated."}]]}]]}],["$","div","Allatoona Pass offered a strong defense",{"className":"moment","children":[["$","$L16",null,{"seconds":355,"label":"5:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Allatoona Pass offered a strong defense"}],["$","p",null,{"children":"The railroad cut passed through high ground more than 80 feet deep in places. Johnston expected a direct U.S. advance."}]]}]]}],["$","div","Sherman chose to bypass Allatoona",{"className":"moment","children":[["$","$L16",null,{"seconds":422,"label":"7:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman chose to bypass Allatoona"}],["$","p",null,{"children":"He planned to cross west of the pass and move a