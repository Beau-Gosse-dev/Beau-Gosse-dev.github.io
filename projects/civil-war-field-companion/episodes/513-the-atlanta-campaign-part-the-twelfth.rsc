21:["$","div","Sherman could not continue south",{"className":"moment","children":[["$","$L16",null,{"seconds":1641,"label":"27:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman could not continue south"}],["$","p",null,{"children":"His scattered line, muddy roads, ration shortages, and distance from the railroad made a drive to the Chattahoochee impractical."}]]}]]}]
