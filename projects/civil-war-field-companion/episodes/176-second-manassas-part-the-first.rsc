1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",176," · ","August 28, 1862"," · ","Thoroughfare Gap in the Bull Run Mountains and the Brawner Farm–Groveton area along the Warrenton Turnpike, northern Virginia"]}],["$","h1",null,{"children":"SECOND MANASSAS (Part the First)"}],["$","span",null,{"className":"result-label","children":"Two different results shaped the day. Longstreet forced the lightly held passage at Thoroughfare Gap and continued toward Jackson. At Brawner Farm, Jackson’s evening attack on Rufus King’s division ended in a tactical stalemate, but it fixed Pope’s attention on Jackson and led Pope to concentrate for battle on August 29"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8690296995.mp3?updated=1695419352","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Thursday, August 28: Thoroughfare Gap and Brawner Farm"}],["$","small",null,{"children":"The episode begins after Jackson’s August 27 destruction of the Manassas Junction depot and ends with the night movements that preceded the main fighting on August 29."}]]}],["$","div","Names for the evening fight",{"children":[["$","span",null,{"children":"Names for the evening fight"}],["$","strong",null,{"children":"Brawner Farm, Groveton, or the engagement near Gainesville"}],["$","small",null,{"children":"The National Park Service identifies these as names for the opening action of Second Manassas. The farm was west of Groveton and north of the Warrenton Turnpike."}]]}],["$","div","Jackson’s position",{"children":[["$","span",null,{"children":"Jackson’s position"}],["$","strong",null,{"children":"Stony Ridge and the unfinished railroad north of the turnpike"}],["$","small",null,{"children":"Jackson concentrated Taliaferro’s, Ewell’s, and A. P. Hill’s divisions near the old First Manassas battlefield and used woods and the railroad cuts and fills for concealment and cover."}]]}],["$","div","Pope’s changing concentration point",{"children":[["$","span",null,{"children":"Pope’s changing concentration point"}],["$","strong",null,{"children":"Manassas Junction, then Centreville, then Groveton"}],["$","small",null,{"children":"Pope first sought Jackson at Manassas Junction, redirected columns toward Centreville after reports that Jackson was moving there, and changed his plan again after learning of the Brawner Farm fight."}]]}],["$","div","Thoroughfare Gap",{"children":[["$","span",null,{"children":"Thoroughfare Gap"}],["$","strong",null,{"children":"Ricketts delayed but did not stop Longstreet"}],["$","small",null,{"children":"G. T. Anderson reached the eastern end of the gap about 3 p.m. Ricketts resisted until Evander Law’s flanking movement over Mother Leathercoat Mountain threatened the Federal position near sunset."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}],"$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
2c:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Forces at the gap",{"children":[["$","span",null,{"children":"Forces at the gap"}],["$","strong",null,{"children":"Ricketts’s division against elements of Longstreet’s wing"}],["$","small",null,{"children":"Anderson and Henry Benning contested the pass while Law moved around the northern flank. Longstreet also sent Cadmus Wilcox toward Hopewell Gap. Ricketts withdrew toward Gainesville."}]]}]
f:["$","div","Thoroughfare Gap casualties",{"children":[["$","span",null,{"children":"Thoroughfare Gap casualties"}],["$","strong",null,{"children":"About 90 United States and no more than 25 Confederate"}],["$","small",null,{"children":"These National Park Service estimates apply to the limited fighting at the gap, not to the larger Brawner Farm action."}]]}]
10:["$","div","McDowell’s column",{"children":[["$","span",null,{"children":"McDowell’s column"}],["$","strong",null,{"children":"Reynolds followed by King on the Warrenton Turnpike"}],["$","small",null,{"children":"Reynolds turned south toward Manassas Junction after a short skirmish with Jackson’s screen. King’s four-brigade division then approached Groveton from Gainesville."}]]}]
11:["$","div","King’s marching order",{"children":[["$","span",null,{"children":"King’s marching order"}],["$","strong",null,{"children":"Hatch, Gibbon, Doubleday, and Patrick"}],["$","small",null,{"children":"The episode places Hatch at the head of the eastbound column, Gibbon behind him, Doubleday next, and Patrick at the rear. The division extended for more than a mile along the turnpike."}]]}]
12:["$","div","Division command failure",{"children":[["$","span",null,{"children":"Division command failure"}],["$","strong",null,{"children":"Rufus King was incapacitated by a seizure at about 6 p.m."}],["$","small",null,{"children":"King’s brigade commanders were initially unaware that he could not direct the division. Gibbon took the principal initiative once Confederate artillery opened."}]]}]
13:["$","div","Opening at Brawner Farm",{"children":[["$","span",null,{"children":"Opening at Brawner Farm"}],["$","strong",null,{"children":"Jackson attacked King’s passing column near sunset"}],["$","small",null,{"children":"Confederate artillery fired from north of the turnpike. Taliaferro’s troops and parts of Ewell’s division then advanced from the Stony Ridge area."}]]}]
14:["$","div","Black Hat Brigade",{"children":[["$","span",null,{"children":"Black Hat Brigade"}],["$","strong",null,{"children":"2nd, 6th, and 7th Wisconsin; 19th Indiana; Battery B"}],["$","small",null,{"children":"Gibbon imposed regular-army drill and distinctive black Hardee hats. The brigade’s performance at Brawner Farm began the combat record associated with the later name Iron Brigade."}]]}]
15:["$","div","Doubleday’s reinforcement",{"children":[["$","span",null,{"children":"Doubleday’s reinforcement"}],["$","strong",null,{"children":"56th Pennsylvania and 76th New York joined Gibbon"}],["$","small",null,{"children":"The two regiments filled a threatened part of the Federal line. Hatch and Patrick did not commit their full brigades to the main fight."}]]}]
16:["$","div","Close-range firefight",{"children":[["$","span",null,{"children":"Close-range firefight"}],["$","strong",null,{"children":"Opposing lines exchanged volleys at roughly 75 to 100 yards"}],["$","small",null,{"children":"The fight continued through fading light and darkness. Open fields, fence lines, smoke, and limited cover produced high losses on both sides."}]]}]
17:["$","div","Jackson’s deployment",{"children":[["$","span",null,{"children":"Jackson’s deployment"}],["$","strong",null,{"children":"A superior force entered the fight in separate increments"}],["$","small",null,{"children":"The Stonewall Brigade made the first principal infantry attack. Lawton, Trimble, and other formations extended or reinforced the Confederate line, but darkness and disrupted command prevented Jackson from using his full strength together."}]]}]
18:["$","div","Confederate command casualties",{"children":[["$","span",null,{"children":"Confederate command casualties"}],["$","strong",null,{"children":"Ewell and Taliaferro were seriously wounded"}],["$","small",null,{"children":"Richard S. Ewell’s left leg was amputated the next day. William B. Taliaferro was struck by three bullets. Alexander R. Lawton and William E. Starke assumed their division commands."}]]}]
19:["$","div","Regimental leaders killed",{"children":[["$","span",null,{"children":"Regimental leaders killed"}],["$","strong",null,{"children":"Lawson Botts and John F. Neff"}],["$","small",null,{"children":"The commanders of the 2nd and 33rd Virginia Infantry were killed in the August 28 fighting. The automated transcript notes two Stonewall Brigade regimental commanders killed but does not give their names."}]]}]
1a:["$","div","Brawner Farm forces and losses",{"children":[["$","span",null,{"children":"Brawner Farm forces and losses"}],["$","strong",null,{"children":"About 7,000 engaged; nearly one-third became casualties"}],["$","small",null,{"children":"NPS summaries give roughly 1,100 to 1,150 United States and about 1,250 Confederate casualties. The episode rounds the losses to about 1,300 on each side."}]]}]
1b:["$","div","Stonewall Brigade losses",{"children":[["$","span",null,{"children":"Stonewall Brigade losses"}],["$","strong",null,{"children":"Roughly one-third to two-fifths of the brigade"}],["$","small",null,{"children":"NPS accounts use different starting strengths and totals. One summary records 635 present and 350 remaining; another widely cited count gives 340 casualties from about 800."}]]}]
1c:["$","div","Lawton’s 26th Georgia",{"children":[["$","span",null,{"children":"Lawton’s 26th Georgia"}],["$","strong",null,{"children":"A 72 percent casualty rate in the episode’s account"}],["$","small",null,{"children":"The episode also describes one company of the 21st Georgia losing 40 of 45 men. These regimental and company figures are subsets of the broader Confederate total."}]]}]
1d:["$","div","Tactical result at Brawner Farm",{"children":[["$","span",null,{"children":"Tactical result at Brawner Farm"}],["$","strong",null,{"children":"Stalemate after dark"}],["$","small",null,{"children":"The Federal line held against Jackson’s attacks. Gibbon and Doubleday then withdrew in order to the turnpike, and the exhausted Confederates did not pursue."}]]}]
1e:["$","div","Operational effect",{"children":[["$","span",null,{"children":"Operational effect"}],["$","strong",null,{"children":"Pope concentrated against Jackson while Longstreet approached"}],["$","small",null,{"children":"Pope treated the fight as proof that Jackson was isolated and vulnerable. Longstreet’s successful passage of the mountains meant that the Confederate wings would reunite on August 29."}]]}]
1f:["$","div","Night movement",{"children":[["$","span",null,{"children":"Night movement"}],["$","strong",null,{"children":"King’s division withdrew toward Manassas Junction at about 1 a.m."}],["$","small",null,{"children":"King and his brigade commanders chose not to remain exposed to a renewed attack. Pope’s latest concentration orders did not reach them in time to prevent the movement."}]]}]
20:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Civil War Infantry Tactics: Training, Combat, and Small-Unit Effectiveness” by Earl J. Hess"}],["$","small",null,{"children":"The episode connects the recommendation to the close-order infantry fighting at Brawner Farm."}]]}]
21:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Brawner, Groveton, Taliaferro, Ewell, Hardee hats, and Irvin McDowell"}],["$","small",null,{"children":"The automated transcript produces “Bronner,” “Grofton,” “Tolliver,” “Yule,” “hardy hats,” and “Urban McDowell.” It also renders Georgians in Trimble’s brigade as “Persians.”"}]]}]
22:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
23:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The August 28 operational setting",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep176-august-28-operational.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The August 28 operational setting at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep176-august-28-operational.svg","alt":"Schematic map showing Longstreet moving through Thoroughfare Gap, Jackson near Brawner Farm, and Federal columns moving toward Manassas Junction and Centreville on August 28, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The August 28 operational setting"}],["$","span",null,{"children":"Longstreet moved east through Thoroughfare Gap while Jackson waited near Stony Ridge. McDowell’s troops moved through Gainesville: Reynolds turned south toward Manassas Junction, while King continued east toward Centreville and came under attack at Brawner Farm. Routes and positions are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep176-august-28-operational.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Brawner Farm troop positions",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep176-brawner-farm-tactical.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Brawner Farm troop positions at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep176-brawner-farm-tactical.svg","alt":"Schematic tactical map of Confederate attacks and the Federal line around Brawner Farm during the evening of August 28, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Brawner Farm troop positions"}],["$","span",null,{"children":"Gibbon deployed north of the Warrenton Turnpike, with two of Doubleday’s regiments reinforcing the line. Taliaferro’s and Ewell’s brigades advanced from the north and west. Hatch remained near Groveton and Patrick stayed south of the turnpike. Formation bars and arrows show generalized relationships, not exact routes, strengths, frontages, or minute-by-minute positions. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep176-brawner-farm-tactical.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service Civil War Series, Brawner Farm Cultural Landscape Report, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Contemporary sketch of the Brawner Farm approach",{"className":"reference-map","children":["$L2a","$L2b"]}]]}]]}]
24:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The August 27 depot raid is reviewed",{"className":"moment","children":[["$","$L2c",null,{"seconds":289,"label":"4:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"The August 27 depot raid is reviewed"}],["$","p",null,{"children":"The episode begins with Jackson leaving the destroyed Federal supply depot at Manassas Junction."}]]}]]}],["$","div","Jackson moves toward the old battlefield",{"className":"moment","children":[["$","$L2c",null,{"seconds":312,"label":"5:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson moves toward the old battlefield"}],["$","p",null,{"children":"His three divisions head about seven miles north to await Lee and Longstreet near the First Manassas field."}]]}]]}],["$","div","Stony Ridge becomes Jackson’s concealed position",{"className":"moment","children":[["$","$L2c",null,{"seconds":353,"label":"5:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stony Ridge becomes Jackson’s concealed position"}],["$","p",null,{"children":"The wooded ridge and unfinished railroad north of the turnpike provide cover and a position from which to strike passing columns."}]]}]]}],["$","div","Pope directs columns toward Manassas Junction",{"className":"moment","children":[["$","$L2c",null,{"seconds":385,"label":"6:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pope directs columns toward Manassas Junction"}],["$","p",null,{"children":"McDowell’s III Corps advances east on the Warrenton Turnpike, unaware of Jackson’s full strength near its route."}]]}]]}],["$","div","Buford reports Confederates behind McDowell",{"className":"moment","children":[["$","$L2c",null,{"seconds":441,"label":"7:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buford reports Confederates behind McDowell"}],["$","p",null,{"children":"McDowell sends James B. Ricketts’s division back toward Thoroughfare Gap after cavalry reports Longstreet’s approach."}]]}]]}],["$","div","Longstreet reaches Thoroughfare Gap",{"className":"moment","children":[["$","$L2c",null,{"seconds":468,"label":"7:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet reaches Thoroughfare Gap"}],["$","p",null,{"children":"The head of Longstreet’s column encounters Ricketts’s infantry and Federal cavalry guarding the eastern side of the pass."}]]}]]}],["$","div","Ricketts delays the passage",{"className":"moment","children":[["$","$L2c",null,{"seconds":480,"label":"8:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ricketts delays the passage"}],["$","p",null,{"children":"Federal resistance lasts several hours before Confederate troops climb the slopes and threaten the position’s flank."}]]}]]}],["$","div","The missed opportunity at the gap is assessed",{"className":"moment","children":[["$","$L2c",null,{"seconds":493,"label":"8:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"The missed opportunity at the gap is assessed"}],["$","p",null,{"children":"Using John Hennessy’s analysis, the episode argues that Pope did not place enough force at the pass to keep Lee’s wings separated."}]]}]]}],["$","div","The Thoroughfare Gap firing ends",{"className":"moment","children":[["$","$L2c",null,{"seconds":548,"label":"9:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Thoroughfare Gap firing ends"}],["$","p",null,{"children":"As Ricketts withdraws, Lee and Longstreet hear the separate battle beginning to the east and continue toward Jackson."}]]}]]}],["$","div","Jackson has chosen to open the eastern fight",{"className":"moment","children":[["$","$L2c",null,{"seconds":584,"label":"9:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson has chosen to open the eastern fight"}],["$","p",null,{"children":"The episode shifts from Lee and Longstreet at the gap to Jackson observing McDowell’s passing columns from concealment."}]]}]]}],["$","div","Jackson’s screen fires on Reynolds",{"className":"moment","children":[["$","$L2c",null,{"seconds":602,"label":"10:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s screen fires on Reynolds"}],"$L2d"]}]]}],"$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45"]}]]}]
25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"Changed the army’s concentration from Manassas Junction to Centreville and then toward Groveton after the Brawner Farm action"}]]}],["$","div","III Corps, Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Divisions of Rufus King, James B. Ricketts, and John F. Reynolds; sent Ricketts toward Thoroughfare Gap after Buford reported Longstreet’s approach"}]]}],["$","div","Division at Thoroughfare Gap",{"className":"command-entry","children":[["$","strong",null,{"children":"Division at Thoroughfare Gap"}],["$","span",null,{"children":"Brig. Gen. James B. Ricketts"}],["$","small",null,{"children":"Infantry and artillery held the eastern approaches until Confederate flanking movements threatened both sides of the position"}]]}],["$","div","1st Division, III Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, III Corps"}],["$","span",null,{"children":"Brig. Gen. Rufus King"}],["$","small",null,{"children":"Brigades of John P. Hatch, Abner Doubleday, Marsena R. Patrick, and John Gibbon; a seizure prevented King from directing the evening battle"}]]}],["$","div","4th Brigade, King’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"4th Brigade, King’s division"}],["$","span",null,{"children":"Brig. Gen. John Gibbon"}],["$","small",null,{"children":"2nd, 6th, and 7th Wisconsin; 19th Indiana; Battery B, 4th U.S. Artillery; formed the principal Federal line north of the turnpike"}]]}],["$","div","2nd Brigade, King’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade, King’s division"}],["$","span",null,{"children":"Brig. Gen. Abner Doubleday"}],["$","small",null,{"children":"Sent the 56th Pennsylvania and 76th New York to reinforce Gibbon during the close-range fight"}]]}],["$","div","1st and 3rd Brigades, King’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"1st and 3rd Brigades, King’s division"}],["$","span",null,{"children":"Brig. Gens. John P. Hatch and Marsena R. Patrick"}],["$","small",null,{"children":"Hatch halted near Groveton; Patrick’s rear brigade sought cover south of the turnpike and neither full brigade joined the main line"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Moved Longstreet’s wing through the Bull Run Mountains to reunite with Jackson’s wing near Manassas"}]]}],["$","div","Right Wing, Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing, Army of Northern Virginia"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Directed the passage of Thoroughfare Gap; G. T. Anderson and Henry Benning contested the pass while Evander Law turned the northern flank and Cadmus Wilcox moved toward Hopewell Gap"}]]}],["$","div","Left Wing, Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing, Army of Northern Virginia"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],"$L46"]}],"$L47","$L48","$L49","$L4a"]]}]]}],"$L4b","$L4c"]}]
26:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Lt. Col. Lawson Botts",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Lt. Col. Lawson Botts"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 2nd Virginia Infantry, Stonewall Brigade","."]}]," ","Killed while commanding his regiment in the Brawner Farm fighting on August 28. He was one of the two Stonewall Brigade regimental commanders whose deaths the episode mentions without naming."]}]]}],["$","article","Col. John F. Neff",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. John F. Neff"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 33rd Virginia Infantry, Stonewall Brigade","."]}]," ","Killed near the Brawner Farm line on August 28. He was found after the firing close to the point where his regiment had advanced."]}]]}]]}]]}]
27:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep176-august-28-operational.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep176-august-28-operational.svg","alt":"Schematic operational map of Thoroughfare Gap, Brawner Farm, Manassas Junction, and Centreville on August 28, 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Longstreet passed the Bull Run Mountains while Jackson struck King’s eastbound division near Brawner Farm. Routes and positions are generalized, and the map is not to scale."}]]}],["$","figure","/images/ep176-brawner-farm-tactical.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep176-brawner-farm-tactical.svg","alt":"Schematic map of the Brawner Farm firing lines and supporting formations.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Gibbon’s brigade and two of Doubleday’s regiments formed north of the turnpike as Taliaferro’s and Ewell’s formations advanced. Positions are generalized, and the map is not to scale."}]]}],["$","figure","/images/ep176-brawner-march-sketch.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep176-brawner-march-sketch.jpg","alt":"Civil War-era field sketch of infantry and artillery moving across open ground near Groveton.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A wartime sketch reproduced by the National Park Service shows troops moving across the open landscape near Groveton and Brawner Farm."}]]}],["$","figure","/images/ep176-thoroughfare-gap-sketch.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep176-thoroughfare-gap-sketch.jpg","alt":"Historical illustration of Confederate infantry passing through the steep-sided Thoroughfare Gap.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A historical illustration reproduced by the National Park Service depicts Confederate troops moving through Thoroughfare Gap. Ricketts’s withdrawal left the pass open to Longstreet."}]]}],["$","figure","/images/ep176-john-gibbon.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep176-john-gibbon.jpg","alt":"Three-exposure glass-negative portrait of United States general John Gibbon in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"John Gibbon deployed his well-drilled Midwestern brigade against what he first believed was an isolated Confederate battery."}]]}],["$","figure","/images/ep176-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep176-stonewall-jackson.jpg","alt":"Civil War-era glass-negative portrait of Confederate general Thomas J. Stonewall Jackson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson ordered the Brawner Farm attack while waiting for Lee and Longstreet to reach him from the west."}]]}]]}]]}]
