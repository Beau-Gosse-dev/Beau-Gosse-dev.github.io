. Lee"}],["$","p",null,{"children":"Army of Northern Virginia commander moving Longstreet’s wing to reunite with Jackson"}]]}]]}],["$","article","James Longstreet",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"James Longstreet"}],["$","p",null,{"children":"Confederate right-wing commander whose troops forced passage through Thoroughfare Gap"}]]}]]}],["$","article","Irvin McDowell",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"IM"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Irvin McDowell"}],["$","p",null,{"children":"III Corps commander who detached Ricketts toward Thoroughfare Gap and directed King’s movement on the turnpike"}]]}]]}],["$","article","Rufus King",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"RK"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Rufus King"}],["$","p",null,{"children":"United States division commander incapacitated by a seizure as his four brigades approached Groveton"}]]}]]}],["$","article","James B. Ricketts",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"James B. Ricketts"}],["$","p",null,{"children":"United States division commander who delayed Longstreet at Thoroughfare Gap before withdrawing"}]]}]]}],["$","article","John Buford",{"className":"person-c