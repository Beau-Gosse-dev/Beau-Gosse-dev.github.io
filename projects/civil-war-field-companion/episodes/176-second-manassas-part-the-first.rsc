2b:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Contemporary sketch of the Brawner Farm approach"}],["$","span",null,{"children":"This participant-era drawing shows a military column and artillery moving across the open landscape near Groveton. The National Park Service reproduces it with a Library of Congress credit. It is a historical view rather than a surveyed troop-position map."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep176-brawner-march-sketch.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress, reproduced by the National Park Service; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
2d:["$","p",null,{"children":"A brief skirmish does not reveal the full Confederate position, and Reynolds continues before turning toward Manassas Junction."}]
2e:["$","div","King is redirected toward Centreville",{"className":"moment","children":[["$","$L2c",null,{"seconds":638,"label":"10:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"King is redirected toward Centreville"}],["$","p",null,{"children":"At about 5 p.m., McDowell receives Pope’s new order and turns King’s division east along the turnpike."}]]}]]}]
2f:["$","div","King cannot exercise command",{"className":"moment","children":[["$","$L2c",null,{"seconds":668,"label":"11:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"King cannot exercise command"}],["$","p",null,{"children":"After McDowell rides away, King suffers another seizure and the division’s brigade commanders do not know why he is absent."}]]}]]}]
30:["$","div","The division’s marching order is identified",{"className":"moment","children":[["$","$L2c",null,{"seconds":719,"label":"11:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"The division’s marching order is identified"}],["$","p",null,{"children":"Hatch leads, followed by Gibbon, Doubleday, and Patrick on a column extending more than a mile."}]]}]]}]
31:["$","div","John Gibbon and his brigade are introduced",{"className":"moment","children":[["$","$L2c",null,{"seconds":738,"label":"12:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"John Gibbon and his brigade are introduced"}],["$","p",null,{"children":"The episode reviews Gibbon’s regular-army background, the brigade’s Midwestern regiments, its drill, and its black Hardee hats."}]]}]]}]
32:["$","div","King’s division passes Jackson’s front",{"className":"moment","children":[["$","$L2c",null,{"seconds":805,"label":"13:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"King’s division passes Jackson’s front"}],["$","p",null,{"children":"Near 6 p.m., the eastbound Federal column below Stony Ridge presents Jackson with a target."}]]}]]}]
33:["$","div","Jackson orders the attack",{"className":"moment","children":[["$","$L2c",null,{"seconds":814,"label":"13:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson orders the attack"}],["$","p",null,{"children":"The quoted order “Bring out your men, gentlemen” begins the movement against King’s column."}]]}]]}]
34:["$","div","Confederate artillery opens",{"className":"moment","children":[["$","$L2c",null,{"seconds":895,"label":"14:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate artillery opens"}],["$","p",null,{"children":"After the advertisement break, the narrative resumes with Taliaferro’s and Ewell’s troops advancing across the Brawner fields."}]]}]]}]
35:["$","div","Gibbon takes the initiative",{"className":"moment","children":[["$","$L2c",null,{"seconds":930,"label":"15:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gibbon takes the initiative"}],["$","p",null,{"children":"He brings up artillery and sends the 2nd Wisconsin north of the turnpike to drive off what appears to be an exposed battery."}]]}]]}]
36:["$","div","The 2nd Wisconsin meets the Stonewall Brigade",{"className":"moment","children":[["$","$L2c",null,{"seconds":959,"label":"15:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 2nd Wisconsin meets the Stonewall Brigade"}],["$","p",null,{"children":"About 450 Federals and roughly 800 Virginians exchange fire at approximately 80 yards while Gibbon deploys the rest of his brigade."}]]}]]}]
37:["$","div","Doubleday reinforces Gibbon",{"className":"moment","children":[["$","$L2c",null,{"seconds":987,"label":"16:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Doubleday reinforces Gibbon"}],["$","p",null,{"children":"With King still absent, Doubleday is the only other brigade commander to send regiments into the main Federal line."}]]}]]}]
38:["$","div","The firing line extends for nearly half a mile",{"className":"moment","children":[["$","$L2c",null,{"seconds":1004,"label":"16:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The firing line extends for nearly half a mile"}],["$","p",null,{"children":"The 19th Indiana, three Wisconsin regiments, and Doubleday’s reinforcements face Virginians, Georgians, North Carolinians, and Alabamians."}]]}]]}]
39:["$","div","Jackson’s use of force is evaluated",{"className":"moment","children":[["$","$L2c",null,{"seconds":1064,"label":"17:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s use of force is evaluated"}],["$","p",null,{"children":"The episode argues that he does not translate his overall numerical advantage into a coordinated tactical attack."}]]}]]}]
3a:["$","div","The general assault is repulsed",{"className":"moment","children":[["$","$L2c",null,{"seconds":1086,"label":"18:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The general assault is repulsed"}],["$","p",null,{"children":"At about 7:30 p.m., Confederate units advance separately in near-darkness and stop about 30 yards from the Federal line."}]]}]]}]
3b:["$","div","Senior Confederate losses are counted",{"className":"moment","children":[["$","$L2c",null,{"seconds":1100,"label":"18:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Senior Confederate losses are counted"}],["$","p",null,{"children":"Taliaferro and Ewell are wounded, two Stonewall Brigade regimental commanders are killed, and Ewell’s leg is amputated the next day."}]]}]]}]
3c:["$","div","Georgia losses illustrate the intensity",{"className":"moment","children":[["$","$L2c",null,{"seconds":1118,"label":"18:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Georgia losses illustrate the intensity"}],["$","p",null,{"children":"The episode gives 40 casualties from 45 men in one 21st Georgia company and a 72 percent casualty rate for the 26th Georgia."}]]}]]}]
3d:["$","div","Jackson’s last flanking effort fails",{"className":"moment","children":[["$","$L2c",null,{"seconds":1129,"label":"18:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s last flanking effort fails"}],["$","p",null,{"children":"Another brigade moves toward the Federal left but makes no further progress as darkness limits control and visibility."}]]}]]}]
3e:["$","div","The fight ends in stalemate",{"className":"moment","children":[["$","$L2c",null,{"seconds":1142,"label":"19:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The fight ends in stalemate"}],["$","p",null,{"children":"The musketry declines after dark with neither side having broken the other’s line."}]]}]]}]
3f:["$","div","Losses are estimated",{"className":"moment","children":[["$","$L2c",null,{"seconds":1162,"label":"19:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Losses are estimated"}],["$","p",null,{"children":"The episode rounds the casualties to about 1,300 on each side and concludes that Jackson missed the chance to destroy King’s isolated division."}]]}]]}]
40:["$","div","Jackson credits the Federal defense",{"className":"moment","children":[["$","$L2c",null,{"seconds":1197,"label":"19:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson credits the Federal defense"}],["$","p",null,{"children":"His report states that the Federals maintained their position with determined resistance."}]]}]]}]
41:["$","div","King’s officers decide to withdraw",{"className":"moment","children":[["$","$L2c",null,{"seconds":1204,"label":"20:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"King’s officers decide to withdraw"}],["$","p",null,{"children":"They choose to move toward Manassas Junction rather than remain for another attack in the morning."}]]}]]}]
