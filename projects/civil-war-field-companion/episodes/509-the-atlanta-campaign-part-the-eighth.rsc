11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The Red River campaign disrupted Grant’s plan",{"className":"moment","children":[["$","$L16",null,{"seconds":93,"label":"1:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Red River campaign disrupted Grant’s plan"}],["$","p",null,{"children":"Nathaniel Banks retained veteran XVI and XVII Corps troops after his defeat at Mansfield and the difficult retreat down the Red River."}]]}]]}],["$","div","Sherman learned the borrowed troops would not return",{"className":"moment","children":[["$","$L16",null,{"seconds":286,"label":"4:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman learned the borrowed troops would not return"}],["$","p",null,{"children":"On April 22, Grant confirmed that the Army of the Tennessee would begin the Georgia campaign without the divisions in Louisiana."}]]}]]}],["$","div","McPherson’s expected strength fell to seven divisions",{"className":"moment","children":[["$","$L16",null,{"seconds":330,"label":"5:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson’s expected strength fell to seven divisions"}],["$","p",null,{"children":"Sherman estimated about 35,000 men and considered the force too small for an independent movement far from the main armies."}]]}]]}],["$","div","Sherman canceled the direct march on Rome",{"className":"moment","children":[["$","$L16",null,{"seconds":373,"label":"6:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman canceled the direct march on Rome"}],["$","p",null,{"children":"On April 23, he ordered McPherson toward Lebanon and Summerville, leaving open either a later move on Rome or a turn toward Snake Creek Gap."}]]}]]}],["$","div","Two furloughed XVII Corps divisions were also delayed",{"className":"moment","children":[["$","$L16",null,{"seconds":455,"label":"7:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two furloughed XVII Corps divisions were also delayed"}],["$","p",null,{"children":"Administrative problems kept them from reaching Cairo, Illinois, in time for the campaign."}]]}]]}],["$","div","McPherson’s force fell to five divisions",{"className":"moment","children":[["$","$L16",null,{"seconds":481,"label":"8:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson’s force fell to five divisions"}],["$","p",null,{"children":"By April 27, only about 24,000 men were available for the opening movement."}]]}]]}],["$","div","Sherman adopted a third plan",{"className":"moment","children":[["$","$L16",null,{"seconds":501,"label":"8:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman adopted a third plan"}],["$","p",null,{"children":"McPherson would move through Chattanooga, LaFayette, Villanow, and Snake Creek Gap to cut the railroad near Resaca."}]]}]]}],["$","div","Taylor’s Ridge screened the flanking column",{"className":"moment","children":[["$","$L16",null,{"seconds":534,"label":"8:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taylor’s Ridge screened the flanking column"}],["$","p",null,{"children":"The ridge hid McPherson from Confederate observers but had enough gaps to maintain contact with Thomas west of Rocky Face Ridge."}]]}]]}],["$","div","The revised plan followed Thomas’s earlier proposal",{"className":"moment","children":[["$","$L16",null,{"seconds":575,"label":"9:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"The revised plan followed Thomas’s earlier proposal"}],["$","p",null,{"children":"George H. Thomas had suggested using Snake Creek Gap after U.S. scouts found it unobstructed and unfortified."}]]}]]}],["$","div","Sherman assigned the smaller army to the gap",{"className":"moment","children":[["$","$L16",null,{"seconds":644,"label":"10:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman assigned the smaller army to the gap"}],["$","p",null,{"children":"He kept Thomas’s larger Army of the Cumberland as the main force and used McPherson as the army group’s right wing."}]]}]]}],["$","div","The railroad was the operational objective",{"className":"moment","children":["$L17","$L18"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]]}]
