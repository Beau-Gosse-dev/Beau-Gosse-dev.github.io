18:["$","div",null,{"children":[["$","h3",null,{"children":"The railroad was the operational objective"}],["$","p",null,{"children":"If McPherson cut the line at Resaca, Thomas and Schofield could press Johnston south from Dalton toward a blocked retreat route."}]]}]
19:["$","div","Johnston used intelligence to prepare a defense",{"className":"moment","children":[["$","$L16",null,{"seconds":742,"label":"12:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston used intelligence to prepare a defense"}],["$","p",null,{"children":"Outnumbered, he sought to identify Sherman’s main movement early enough to concentrate at the threatened point."}]]}]]}]
1a:["$","div","Confederate intelligence was generally accurate",{"className":"moment","children":[["$","$L16",null,{"seconds":802,"label":"13:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate intelligence was generally accurate"}],["$","p",null,{"children":"Scouts, cavalry patrols, and spies tracked U.S. formations in Tennessee and Alabama, especially Thomas’s army near Chattanooga."}]]}]]}]
1b:["$","div","Johnston expected the main attack near Dalton",{"className":"moment","children":[["$","$L16",null,{"seconds":857,"label":"14:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston expected the main attack near Dalton"}],["$","p",null,{"children":"He anticipated pressure at Mill Creek Gap, northern Rocky Face Ridge, and Crow Valley."}]]}]]}]
1c:["$","div","Johnston expected McPherson to move toward Rome or Alabama",{"className":"moment","children":[["$","$L16",null,{"seconds":890,"label":"14:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston expected McPherson to move toward Rome or Alabama"}],["$","p",null,{"children":"This assumption caused Confederate headquarters to discount the possibility of a move through Snake Creek Gap toward Resaca."}]]}]]}]
1d:["$","div","Johnston prepared his long left flank",{"className":"moment","children":[["$","$L16",null,{"seconds":943,"label":"15:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston prepared his long left flank"}],["$","p",null,{"children":"He shifted cavalry near Rome and Resaca, accelerated work on Rome’s defenses, and posted James Cantey’s infantry there."}]]}]]}]
1e:["$","div","The U.S. armies reached their opening positions",{"className":"moment","children":[["$","$L16",null,{"seconds":1132,"label":"18:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. armies reached their opening positions"}],["$","p",null,{"children":"By May 7, XX Corps stood west of Dug Gap, IV Corps faced northern Rocky Face Ridge, and XXIII Corps faced Crow Valley."}]]}]]}]
1f:["$","div","Johnston built a strong Dalton line",{"className":"moment","children":[["$","$L16",null,{"seconds":1238,"label":"20:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston built a strong Dalton line"}],["$","p",null,{"children":"Hood held Rocky Face Ridge and Crow Valley with additional divisions from Hardee; Hardee kept two divisions in reserve near Dalton."}]]}]]}]
20:["$","div","The Confederate left lacked reconnaissance",{"className":"moment","children":[["$","$L16",null,{"seconds":1335,"label":"22:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate left lacked reconnaissance"}],["$","p",null,{"children":"Wheeler concentrated cavalry near Dalton instead of maintaining strong scouting coverage southwest toward Snake Creek Gap."}]]}]]}]
21:["$","div","Richmond ordered major reinforcements to Georgia",{"className":"moment","children":[["$","$L16",null,{"seconds":1477,"label":"24:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richmond ordered major reinforcements to Georgia"}],["$","p",null,{"children":"On May 4, Davis and Bragg ordered Leonidas Polk to send William W. Loring’s division and join Johnston with as many troops as possible."}]]}]]}]
