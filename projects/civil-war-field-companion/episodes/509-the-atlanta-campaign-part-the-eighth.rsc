12:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L19",null,{"guide":{"date":"April 20–May 7, 1864","place":"Chattanooga, northern Alabama, Dalton, and northwest Georgia","result":"Sherman reduced McPherson’s assignment to a close flanking march through Snake Creek Gap, while Johnston concentrated his main defenses around Dalton and requested reinforcements from Polk","facts":[{"label":"McPherson’s planned strength","value":"9 divisions"},{"label":"McPherson’s available strength","value":"5 divisions; about 24,000 men"},{"label":"Sherman’s armies positioned","value":"By May 7, 1864"},{"label":"Polk’s available reinforcement","value":"More than 20,000 men"}],"maps":[{"title":"The opening concentration in north Georgia","caption":"The campaign map shows Chattanooga, the Tennessee River, LaFayette, Taylor’s Ridge, Dalton, Rocky Face Ridge, Snake Creek Gap, Resaca, and Rome.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of the opening routes of the Atlanta campaign"},{"title":"Chattanooga, Dalton, Resaca, and Rome today","caption":"Sherman’s revised plan kept McPherson near Thomas by routing him from Chattanooga through LaFayette and Villanow to Snake Creek Gap instead of sending him directly toward Rome.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-86.10%2C33.95%2C-84.65%2C35.20&layer=mapnik&marker=34.769%2C-84.971"},{"title":"The Western and Atlantic Railroad","caption":"The railroad connected Chattanooga, Dalton, Resaca, and Atlanta. Sherman intended McPherson to cut it behind Johnston’s army.","source":"https://www.loc.gov/item/2018670923/","image":"/images/atlanta-railroad-depot.jpg","alt":"Civil War era railroad depot and tracks in Atlanta"}],"moments":[{"time":"1:33","audioTime":93,"title":"The Red River campaign disrupted Grant’s plan","detail":"Nathaniel Banks retained veteran XVI and XVII Corps troops after his defeat at Mansfield and the difficult retreat down the Red River."},{"time":"4:46","audioTime":286,"title":"Sherman learned the borrowed troops would not return","detail":"On April 22, Grant confirmed that the Army of the Tennessee would begin the Georgia campaign without the divisions in Louisiana."},{"time":"5:30","audioTime":330,"title":"McPherson’s expected strength fell to seven divisions","detail":"Sherman estimated about 35,000 men and considered the force too small for an independent movement far from the main armies."},{"time":"6:13","audioTime":373,"title":"Sherman canceled the direct march on Rome","detail":"On April 23, he ordered McPherson toward Lebanon and Summerville, leaving open either a later move on Rome or a turn toward Snake Creek Gap."},{"time":"7:35","audioTime":455,"title":"Two furloughed XVII Corps divisions were also delayed","detail":"Administrative problems kept them from reaching Cairo, Illinois, in time for the campaign."},{"time":"8:01","audioTime":481,"title":"McPherson’s force fell to five divisions","detail":"By April 27, only about 24,000 men were available for the opening movement."},{"time":"8:21","audioTime":501,"title":"Sherman adopted a third plan","detail":"McPherson would move through Chattanooga, LaFayette, Villanow, and Snake Creek Gap to cut the railroad near Resaca."},{"time":"8:54","audioTime":534,"title":"Taylor’s Ridge screened the flanking column","detail":"The ridge hid McPherson from Confederate observers but had enough gaps to maintain contact with Thomas west of Rocky Face Ridge."},{"time":"9:35","audioTime":575,"title":"The revised plan followed Thomas’s earlier proposal","detail":"George H. Thomas had suggested using Snake Creek Gap after U.S. scouts found it unobstructed and unfortified."},{"time":"10:44","audioTime":644,"title":"Sherman assigned the smaller army to the gap","detail":"He kept Thomas’s larger Army of the Cumberland as the main force and used McPherson as the army group’s right wing."},{"time":"11:11","audioTime":671,"title":"The railroad was the operational objective","detail":"If McPherson cut the line at Resaca, Thomas and Schofield could press Johnston south from Dalton toward a blocked retreat route."},{"time":"12:22","audioTime":742,"title":"Johnston used intelligence to prepare a defense","detail":"Outnumbered, he sought to identify Sherman’s main movement early enough to concentrate at the threatened point."},{"time":"13:22","audioTime":802,"title":"Confederate intelligence was generally accurate","detail":"Scouts, cavalry patrols, and spies tracked U.S. formations in Tennessee and Alabama, especially Thomas’s army near Chattanooga."},{"time":"14:17","audioTime":857,"title":"Johnston expected the main attack near Dalton","detail":"He anticipated pressure at Mill Creek Gap, northern Rocky Face Ridge, and Crow Valley."},{"time":"14:50","audioTime":890,"title":"Johnston expected McPherson to move toward Rome or Alabama","detail":"This assumption caused Confederate headquarters to discount the possibility of a move through Snake Creek Gap toward Resaca."},{"time":"15:43","audioTime":943,"title":"Johnston prepared his long left flank","detail":"He shifted cavalry near Rome and Resaca, accelerated work on Rome’s defenses, and posted James Cantey’s infantry there."},{"time":"18:52","audioTime":1132,"title":"The U.S. armies reached their opening positions","detail":"By May 7, XX Corps stood west of Dug Gap, IV Corps faced northern Rocky Face Ridge, and XXIII Corps faced Crow Valley."},{"time":"20:38","audioTime":1238,"title":"Johnston built a strong Dalton line","detail":"Hood held Rocky Face Ridge and Crow Valley with additional divisions from Hardee; Hardee kept two divisions in reserve near Dalton."},{"time":"22:15","audioTime":1335,"title":"The Confederate left lacked reconnaissance","detail":"Wheeler concentrated cavalry near Dalton instead of maintaining strong scouting coverage southwest toward Snake Creek Gap."},{"time":"24:37","audioTime":1477,"title":"Richmond ordered major reinforcements to Georgia","detail":"On May 4, Davis and Bragg ordered Leonidas Polk to send William W. Loring’s division and join Johnston with as many troops as possible."},{"time":"25:34","audioTime":1534,"title":"Polk began concentrating more than 20,000 men","detail":"Three infantry divisions and one cavalry division started moving toward Blue Mountain, Alabama, before later receiving orders for Rome."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"Ulysses S. Grant","command":"General-in-Chief","subordinates":"Coordinated the 1864 campaigns"},{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Revised the opening plan as McPherson’s strength declined"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"IV, XIV, and XX Corps around Rocky Face Ridge"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Five divisions assigned to Snake Creek Gap"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"XXIII Corps in front of Crow Valley"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Hood, Hardee, and Wheeler at Dalton"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Stewart, Stevenson, Hindman, plus two divisions detached from Hardee"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Cleburne and Walker held in reserve near Dalton"},{"commander":"Joseph Wheeler","command":"Cavalry Corps","subordinates":"Concentrated at Tunnel Hill and Crow Valley"},{"commander":"Leonidas Polk","command":"Department of Alabama, Mississippi, and East Louisiana","subordinates":"Ordered to reinforce Johnston"}]}],"people":[{"name":"William T. Sherman","role":"Revised the opening plan three times as the Army of the Tennessee lost expected divisions","side":"United States"},{"name":"George H. Thomas","role":"Proposed the Snake Creek Gap movement that Sherman ultimately adopted","side":"United States"},{"name":"James B. McPherson","role":"Commanded the reduced flanking force assigned to cut the railroad near Resaca","side":"United States"},{"name":"Joseph E. Johnston","role":"Concentrated against a direct threat to Dalton and expected McPherson to move toward Rome","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"John B. Hood","role":"Received the main Confederate defensive assignment at Rocky Face Ridge and Crow Valley","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"Leonidas Polk","role":"Prepared more than 20,000 reinforcements for north Georgia","side":"Confederacy"},{"name":"Nathaniel P. Banks","role":"Retained troops in Louisiana after the failed Red River expedition, reducing McPherson’s strength","side":"United States"}],"losses":[],"gallery":[{"image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of the opening Atlanta campaign routes","caption":"The map shows the three U.S. armies approaching Dalton and McPherson’s long route toward Snake Creek Gap.","source":"https://www.loc.gov/item/2008628278/"},{"image":"/images/atlanta-railroad-depot.jpg","alt":"Civil War era railroad depot and tracks","caption":"The Western and Atlantic Railroad supplied Johnston and provided his direct route toward Atlanta.","source":"https://www.loc.gov/item/2018670923/"},{"image":"/images/joseph-e-johnston.jpg","alt":"Portrait of Joseph E. Johnston","caption":"Johnston expected Sherman’s principal attack against the northern part of his Dalton position.","source":"https://www.loc.gov/item/2018666539/"}],"sources":[{"label":"Official Episode 509 page","url":"https://civilwarpodcast.org/2025/10/26/civil-war-podcast-episode-509/"},{"label":"National Park Service Rocky Face Ridge summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=GA007"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"}]}}]}]
