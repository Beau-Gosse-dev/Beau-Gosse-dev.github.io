34:["$","div","VI Corps takes the summit",{"className":"moment","children":[["$","$L30",null,{"seconds":1162,"label":"19:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"VI Corps takes the summit"}],["$","p",null,{"children":"By about 6:45 p.m., the last makeshift Confederate resistance dissolves and Crampton’s Gap is in Federal hands."}]]}]]}]
35:["$","div","The cost of Crampton’s Gap is counted",{"className":"moment","children":[["$","$L30",null,{"seconds":1251,"label":"20:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cost of Crampton’s Gap is counted"}],["$","p",null,{"children":"The episode gives 533 Federal casualties and Confederate losses near 1,000, including more than 600 prisoners."}]]}]]}]
36:["$","div","McLaws and Stuart meet the fugitives",{"className":"moment","children":[["$","$L30",null,{"seconds":1295,"label":"21:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"McLaws and Stuart meet the fugitives"}],["$","p",null,{"children":"They ride into Pleasant Valley and organize a new line south of the gap to protect the trapped Harpers Ferry command."}]]}]]}]
37:["$","div","Three brigades reinforce Pleasant Valley",{"className":"moment","children":[["$","$L30",null,{"seconds":1383,"label":"23:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Three brigades reinforce Pleasant Valley"}],["$","p",null,{"children":"Kershaw, Barksdale, and Wilcox join the remnants from Crampton’s Gap and wait for Franklin’s expected morning advance."}]]}]]}]
38:["$","div","Lee hears the northern gaps cannot be held",{"className":"moment","children":[["$","$L30",null,{"seconds":1422,"label":"23:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee hears the northern gaps cannot be held"}],["$","p",null,{"children":"At Boonsboro, Hill and Longstreet report that Federal control of the flanks makes Turner’s Gap untenable at daylight."}]]}]]}]
39:["$","div","Lee orders a retreat toward Shepherdstown",{"className":"moment","children":[["$","$L30",null,{"seconds":1505,"label":"25:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee orders a retreat toward Shepherdstown"}],["$","p",null,{"children":"He decides to abandon the offensive and move through Sharpsburg to the Potomac before the divided army is defeated in detail."}]]}]]}]
3a:["$","div","The 8 p.m. withdrawal message goes to McLaws",{"className":"moment","children":[["$","$L30",null,{"seconds":1564,"label":"26:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 8 p.m. withdrawal message goes to McLaws"}],["$","p",null,{"children":"Lee says the day has gone against the army and orders the Harpers Ferry detachments to abandon their positions and rejoin him."}]]}]]}]
3b:["$","div","The South Mountain retreat starts",{"className":"moment","children":[["$","$L30",null,{"seconds":1623,"label":"27:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The South Mountain retreat starts"}],["$","p",null,{"children":"Confederate units leave between 10 p.m. and 4 a.m.; darkness, exhaustion, and straggling disorder the movement through Boonsboro."}]]}]]}]
3c:["$","div","Federal pickets find the gaps empty",{"className":"moment","children":[["$","$L30",null,{"seconds":1745,"label":"29:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal pickets find the gaps empty"}],["$","p",null,{"children":"McClellan organizes pursuit and tells Washington that the Confederates disappeared during the night."}]]}]]}]
3d:["$","div","Lee has stopped short of the Potomac",{"className":"moment","children":[["$","$L30",null,{"seconds":1832,"label":"30:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee has stopped short of the Potomac"}],["$","p",null,{"children":"He halts near Keedysville to cover McLaws, then moves Hill and Longstreet toward stronger ground behind Antietam Creek."}]]}]]}]
3e:["$","div","The Sharpsburg line begins to form",{"className":"moment","children":[["$","$L30",null,{"seconds":1963,"label":"32:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Sharpsburg line begins to form"}],["$","p",null,{"children":"Hill and Longstreet take the high ground west of Antietam Creek while Lee waits for McLaws and still considers withdrawal."}]]}]]}]
3f:["$","div","Harpers Ferry surrenders",{"className":"moment","children":[["$","$L30",null,{"seconds":2034,"label":"33:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Harpers Ferry surrenders"}],["$","p",null,{"children":"The garrison’s capitulation opens the route by which McLaws and Jackson’s other forces can rejoin Lee."}]]}]]}]
40:["$","div","Franklin declines to attack",{"className":"moment","children":[["$","$L30",null,{"seconds":2103,"label":"35:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Franklin declines to attack"}],["$","p",null,{"children":"At 11 a.m. he reports the Pleasant Valley line too strong, and the opportunity to strike McLaws while isolated passes."}]]}]]}]
41:["$","div","Jackson’s message changes Lee’s outlook",{"className":"moment","children":[["$","$L30",null,{"seconds":2121,"label":"35:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s message changes Lee’s outlook"}],["$","p",null,{"children":"News that Harpers Ferry is about to fall raises the prospect of reuniting the army and continuing the campaign from Sharpsburg."}]]}]]}]
42:["$","div","Jackson confirms the surrender",{"className":"moment","children":[["$","$L30",null,{"seconds":2199,"label":"36:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson confirms the surrender"}],["$","p",null,{"children":"At about noon Lee learns that most of Jackson’s force will march north while A. P. Hill remains temporarily to handle the captured garrison."}]]}]]}]
43:["$","div","Lee calls off the retreat",{"className":"moment","children":[["$","$L30",null,{"seconds":2281,"label":"38:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee calls off the retreat"}],["$","p",null,{"children":"The Confederate commander commits to the Antietam Creek position and begins gathering the divided army near Sharpsburg."}]]}]]}]
44:["$","div","The first Antietam recommendation",{"className":"moment","children":[["$","$L30",null,{"seconds":2351,"label":"39:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first Antietam recommendation"}],["$","p",null,{"children":"The hosts recommend Norman S. Stevens’s concise Osprey overview, “Antietam 1862: The Civil War’s Bloodiest Day.”"}]]}]]}]
45:["$","span",null,{"children":"Col. Thomas T. Munford"}]
46:["$","small",null,{"children":"Senior officer at the gap; combined his horsemen with Parham’s infantry behind the Mountain Church Road stone wall"}]
