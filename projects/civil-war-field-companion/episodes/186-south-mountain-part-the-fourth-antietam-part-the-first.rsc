48:["$","div","Cobb’s Brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Cobb’s Brigade"}],["$","span",null,{"children":"Brig. Gen. Howell Cobb"}],["$","small",null,{"children":"Georgia and North Carolina regiments sent from the Harpers Ferry operation; reached the eastern slope while the original defense was breaking"}]]}]
49:["$","div","Harpers Ferry operation",{"className":"command-entry","children":[["$","strong",null,{"children":"Harpers Ferry operation"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Coordinated McLaws, John G. Walker, and A. P. Hill around the garrison; confirmed its surrender and directed most of his force toward Sharpsburg"}]]}]
4a:["$","div","South Mountain withdrawal and first Sharpsburg line",{"className":"command-entry","children":[["$","strong",null,{"children":"South Mountain withdrawal and first Sharpsburg line"}],["$","span",null,{"children":"Maj. Gen. James Longstreet and Maj. Gen. D. H. Hill"}],["$","small",null,{"children":"Reported Turner’s Gap untenable, withdrew through Boonsboro, and formed on the high ground west of Antietam Creek"}]]}]
