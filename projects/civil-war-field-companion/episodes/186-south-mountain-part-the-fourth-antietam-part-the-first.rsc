1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",186," · ","September 14–15, 1862"," · ","Crampton’s Gap and Pleasant Valley near Burkittsville, Maryland; South Mountain through Boonsboro and Keedysville to the Antietam Creek line outside Sharpsburg; and Harpers Ferry"]}],["$","h1",null,{"children":"SOUTH MOUNTAIN (Part the Fourth) / ANTIETAM (Part the First)"}],["$","span",null,{"className":"result-label","children":"Decisive United States tactical victory at Crampton’s Gap and a United States victory at South Mountain, but without the immediate operational exploitation McClellan intended. Confederate resistance delayed VI Corps, Harpers Ferry surrendered on September 15, and Robert E. Lee halted his withdrawal to begin assembling the Army of Northern Virginia behind Antietam Creek near Sharpsburg"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6385491502.mp3?updated=1695462501","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Crampton’s Gap, the Confederate withdrawal from South Mountain, and Lee’s first position at Sharpsburg"}],["$","small",null,{"children":"The episode completes the September 14 battle by following William B. Franklin’s VI Corps at Crampton’s Gap, then traces the campaign through noon on September 15. It ends before the armies are fully concentrated and before the Battle of Antietam begins."}]]}],["$","div","Crampton’s Gap date",{"children":[["$","span",null,{"children":"Crampton’s Gap date"}],["$","strong",null,{"children":"Sunday, September 14, 1862"}],["$","small",null,{"children":"Crampton’s Gap was the southern sector of the Battle of South Mountain, about six miles south of Turner’s Gap."}]]}],["$","div","Federal objective",{"children":[["$","span",null,{"children":"Federal objective"}],["$","strong",null,{"children":"Cross South Mountain, enter Pleasant Valley, and relieve Harpers Ferry"}],["$","small",null,{"children":"McClellan also expected Franklin’s movement to separate Lee’s forces near Boonsboro from McLaws and the other Confederate commands around Harpers Ferry."}]]}],["$","div","VI Corps strength",{"children":[["$","span",null,{"children":"VI Corps strength"}],["$","strong",null,{"children":"Nearly 13,000 men in Franklin’s two divisions"}],["$","small",null,{"children":"The National Park Service rounds the corps to about 12,000. Henry W. Slocum’s division made the principal assault; William F. Smith’s division supported the operation."}]]}],["$","div","Morning delay",{"children":[["$","span",null,{"children":"Morning delay"}],["$","strong",null,{"children":"Franklin halted about one hour for IV Corps reinforcements"}],["$","small",null,{"children":"The delay came despite McClellan’s instruction not to wait for those troops. The corps then paused again outside Burkittsville while the Confederate defense was reinforced."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}],"$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c"]}]]}]
30:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Two threatened passes",{"children":[["$","span",null,{"children":"Two threatened passes"}],["$","strong",null,{"children":"Crampton’s Gap and Brownsville Pass"}],["$","small",null,{"children":"Brig. Gen. Paul J. Semmes expected the main Federal effort at Brownsville Pass and kept three regiments there. Crampton’s Gap received Mahone’s brigade under Col. William A. Parham and cavalry under Col. Thomas T. Munford."}]]}]
f:["$","div","Initial Crampton’s Gap defense",{"children":[["$","span",null,{"children":"Initial Crampton’s Gap defense"}],["$","strong",null,{"children":"About 800 cavalry and infantry"}],["$","small",null,{"children":"The episode gives Parham 520 men in four Virginia regiments, one of which was detached, and places Munford’s cavalry with him. The thin line formed behind a stone wall along Mountain Church Road west of Burkittsville."}]]}]
10:["$","div","Defensive frontage",{"children":[["$","span",null,{"children":"Defensive frontage"}],["$","strong",null,{"children":"Some Confederate soldiers stood eight feet apart"}],["$","small",null,{"children":"The line was too long for the available troops. Its stone wall offered strong cover, but Slocum’s much larger formation could overlap both flanks."}]]}]
11:["$","div","Confederate reinforcement",{"children":[["$","span",null,{"children":"Confederate reinforcement"}],["$","strong",null,{"children":"Howell Cobb’s brigade, about 1,300 men"}],["$","small",null,{"children":"Lafayette McLaws sent Cobb from the Harpers Ferry operation with an order to hold the gap. The 10th Georgia from Semmes’s brigade was also directed toward the threatened sector."}]]}]
12:["$","div","Contact near Burkittsville",{"children":[["$","span",null,{"children":"Contact near Burkittsville"}],["$","strong",null,{"children":"About noon"}],["$","small",null,{"children":"Federal skirmishers drove Munford’s horsemen through Burkittsville and met the stronger cavalry-and-infantry line behind the stone wall at the mountain’s eastern base."}]]}]
13:["$","div","Assault begins",{"children":[["$","span",null,{"children":"Assault begins"}],["$","strong",null,{"children":"About 4 p.m."}],["$","small",null,{"children":"Slocum formed his division for attack beginning around 3 p.m. The lead regiments moved against the wall an hour later after repeated urgent messages from McClellan."}]]}]
14:["$","div","Initial Federal method",{"children":[["$","span",null,{"children":"Initial Federal method"}],["$","strong",null,{"children":"Massed fire and separate charges failed to move the wall line"}],["$","small",null,{"children":"The lead regiments took cover behind a rail fence with little protection. Confederate fire inflicted heavy losses while Slocum’s brigades entered the action gradually."}]]}]
15:["$","div","United charge",{"children":[["$","span",null,{"children":"United charge"}],["$","strong",null,{"children":"About 5:30 p.m."}],["$","small",null,{"children":"With bayonets fixed, the Federal line surged across the fields, broke the Mountain Church Road position, and pursued the defenders up the mountain."}]]}]
16:["$","div","Cobb’s arrival",{"children":[["$","span",null,{"children":"Cobb’s arrival"}],["$","strong",null,{"children":"Too late to establish a coherent second line"}],["$","small",null,{"children":"Cobb’s brigade met Parham’s and Munford’s retreating men while it was still deploying on the eastern slope. The partly formed line checked the pursuit only briefly."}]]}]
17:["$","div","Gap secured",{"children":[["$","span",null,{"children":"Gap secured"}],["$","strong",null,{"children":"About 6:45 p.m."}],["$","small",null,{"children":"Slocum’s soldiers drove the remaining Confederate groups from the summit and held Crampton’s Gap at dark."}]]}]
18:["$","div","United States losses at Crampton’s Gap",{"children":[["$","span",null,{"children":"United States losses at Crampton’s Gap"}],["$","strong",null,{"children":"533 killed, wounded, or missing"}],["$","small",null,{"children":"The transcript gives 113 killed, 418 wounded, and 2 missing. Franklin’s official report and the Army of the Potomac casualty table give 115 killed, 416 wounded, and 2 missing; the total is the same."}]]}]
19:["$","div","Confederate losses at Crampton’s Gap",{"children":[["$","span",null,{"children":"Confederate losses at Crampton’s Gap"}],["$","strong",null,{"children":"Roughly 900 to 1,000, most of them captured or missing"}],["$","small",null,{"children":"The episode says losses neared 1,000 and more than 600 were prisoners. Returns are incomplete and later totals vary, but all show a severe defeat for the small defending force."}]]}]
1a:["$","div","Pleasant Valley line",{"children":[["$","span",null,{"children":"Pleasant Valley line"}],["$","strong",null,{"children":"McLaws blocked the valley about one mile south of the gap"}],["$","small",null,{"children":"Kershaw’s and Barksdale’s brigades came off Maryland Heights and joined Wilcox, the remnants of Cobb, Semmes, and Parham, and other available troops. Harpers Ferry still blocked McLaws from withdrawing south."}]]}]
1b:["$","div","Lee’s first decision",{"children":[["$","span",null,{"children":"Lee’s first decision"}],["$","strong",null,{"children":"Abandon the Maryland Campaign and cross at Shepherdstown"}],["$","small",null,{"children":"After hearing Hill and Longstreet’s reports from the northern gaps, Lee ordered a retreat through Sharpsburg. At 8 p.m. he told McLaws that the day had gone against the army and directed the Harpers Ferry detachments to rejoin him."}]]}]
1c:["$","div","Withdrawal from South Mountain",{"children":[["$","span",null,{"children":"Withdrawal from South Mountain"}],["$","strong",null,{"children":"10 p.m. September 14 to 4 a.m. September 15"}],["$","small",null,{"children":"Hill’s and Longstreet’s commands withdrew in darkness. Exhausted stragglers fell behind and many were collected by the Federal pursuit."}]]}]
1d:["$","div","Lee halts near Keedysville",{"children":[["$","span",null,{"children":"Lee halts near Keedysville"}],["$","strong",null,{"children":"To avoid abandoning McLaws in Pleasant Valley"}],["$","small",null,{"children":"The automated transcript repeatedly says “Kittiesville.” The Maryland place is Keedysville. Lee’s temporary halt placed Hill and Longstreet on the flank of any Federal advance south from Crampton’s Gap."}]]}]
1e:["$","div","New defensive position",{"children":[["$","span",null,{"children":"New defensive position"}],["$","strong",null,{"children":"High ground west of Antietam Creek near Sharpsburg"}],["$","small",null,{"children":"Keedysville offered poor ground for a stand. Lee shifted Hill and Longstreet farther west while still expecting to retreat after McLaws escaped."}]]}]
1f:["$","div","Harpers Ferry surrender",{"children":[["$","span",null,{"children":"Harpers Ferry surrender"}],["$","strong",null,{"children":"Morning of September 15"}],["$","small",null,{"children":"Confederate bombardment stopped around 8:30 a.m., and United States white flags appeared about 9 a.m. Jackson captured more than 12,500 soldiers, 13,000 small arms, and 47 artillery pieces according to the National Park Service."}]]}]
20:["$","div","Franklin does not attack in Pleasant Valley",{"children":[["$","span",null,{"children":"Franklin does not attack in Pleasant Valley"}],["$","strong",null,{"children":"He reported the Confederate position too strong at 11 a.m."}],["$","small",null,{"children":"The fall of Harpers Ferry removed the relief objective. Franklin’s limited activity allowed McLaws to leave Pleasant Valley and rejoin Lee."}]]}]
21:["$","div","Lee reverses course",{"children":[["$","span",null,{"children":"Lee reverses course"}],["$","strong",null,{"children":"The retreat is called off after Jackson’s success"}],["$","small",null,{"children":"Jackson’s messages convinced Lee that the army could reunite at Sharpsburg. Lee strengthened the Antietam line and prepared to receive McClellan instead of continuing immediately to the Potomac."}]]}]
22:["$","div","South Mountain consequence",{"children":[["$","span",null,{"children":"South Mountain consequence"}],["$","strong",null,{"children":"United States battlefield success bought the Confederates time"}],["$","small",null,{"children":"Federal forces captured the passes, but the day-long defense delayed pursuit long enough for Jackson to complete the Harpers Ferry operation and for Lee to begin reconcentrating."}]]}]
23:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Antietam 1862: The Civil War’s Bloodiest Day”"}],["$","small",null,{"children":"The episode and official podcast book list identify Norman S. Stevens’s Osprey Campaign volume as the recommendation."}]]}]
24:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Burkittsville, Paul J. Semmes, Lafayette McLaws, William A. Parham, Thomas T. Munford, Howell Cobb, Keedysville, and Harpers Ferry"}],["$","small",null,{"children":"The automated transcript uses forms including “Brooketsville,” “Sims,” “McClellan” for McLaws, “Kittiesville,” and other phonetic renderings. This guide uses the historical spellings."}]]}]
25:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
26:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The assault on Crampton’s Gap",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep186-cramptons-gap-assault.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The assault on Crampton’s Gap at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep186-cramptons-gap-assault.svg","alt":"Schematic tactical map of Slocum’s United States division attacking west from Burkittsville against Parham and Munford at the Mountain Church Road stone wall, then pursuing Cobb’s reinforcements through Crampton’s Gap.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The assault on Crampton’s Gap"}],["$","span",null,{"children":"Franklin’s VI Corps approached from the east through Burkittsville. Slocum’s division struck the thin Confederate line behind the Mountain Church Road stone wall, broke it in a united charge around 5:30 p.m., and pursued Parham, Munford, and Cobb to and through the summit. Brownsville Pass and exact unit geometry are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep186-cramptons-gap-assault.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Official Records, Robert Knox Sneden map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","From South Mountain to Antietam Creek",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep186-retreat-to-antietam.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From South Mountain to Antietam Creek at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep186-retreat-to-antietam.svg","alt":"Schematic operational map showing the Confederate withdrawal from South Mountain through Boonsboro, Lee’s halt near Keedysville and movement to Sharpsburg, McLaws in Pleasant Valley, and Jackson at Harpers Ferry.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From South Mountain to Antietam Creek"}],["$","span",null,{"children":"During the night of September 14–15, Hill and Longstreet left the northern South Mountain gaps through Boonsboro. Lee paused near Keedysville to cover McLaws, then selected the high ground west of Antietam Creek near Sharpsburg. The Harpers Ferry surrender opened McLaws’s escape route and allowed Jackson’s forces to begin rejoining Lee. Routes, distances, and positions are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep186-retreat-to-antietam.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2d"]}]]}],"$undefined"]}]]}],"$L2e","$L2f"]}]]}]
27:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Franklin’s missing result becomes the question",{"className":"moment","children":[["$","$L30",null,{"seconds":386,"label":"6:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Franklin’s missing result becomes the question"}],["$","p",null,{"children":"McClellan has reported success at the northern gaps but does not yet know what VI Corps accomplished six miles south at Crampton’s Gap."}]]}]]}],["$","div","VI Corps receives the campaign’s key assignment",{"className":"moment","children":[["$","$L30",null,{"seconds":405,"label":"6:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"VI Corps receives the campaign’s key assignment"}],["$","p",null,{"children":"Franklin is to cross South Mountain, enter Pleasant Valley, split Lee’s dispersed commands, and lift the siege of Harpers Ferry."}]]}]]}],["$","div","The march begins, then pauses",{"className":"moment","children":[["$","$L30",null,{"seconds":489,"label":"8:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The march begins, then pauses"}],["$","p",null,{"children":"Franklin starts early but halts about an hour for supporting troops even though McClellan ordered him not to wait."}]]}]]}],["$","div","Semmes divides the small defense",{"className":"moment","children":[["$","$L30",null,{"seconds":567,"label":"9:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Semmes divides the small defense"}],["$","p",null,{"children":"He keeps three regiments at Brownsville Pass and sends Mahone’s brigade, under Parham, to Crampton’s Gap."}]]}]]}],["$","div","Federal skirmishers reach Burkittsville",{"className":"moment","children":[["$","$L30",null,{"seconds":675,"label":"11:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal skirmishers reach Burkittsville"}],["$","p",null,{"children":"Munford’s cavalry falls back through the village to the stronger position behind the Mountain Church Road stone wall."}]]}]]}],["$","div","Franklin establishes headquarters",{"className":"moment","children":[["$","$L30",null,{"seconds":700,"label":"11:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Franklin establishes headquarters"}],["$","p",null,{"children":"The corps rests while skirmishing increases, giving the Confederates time to reinforce despite another urgent message from McClellan."}]]}]]}],["$","div","McLaws sends Howell Cobb",{"className":"moment","children":[["$","$L30",null,{"seconds":777,"label":"12:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"McLaws sends Howell Cobb"}],["$","p",null,{"children":"Cobb’s brigade is ordered toward Brownsville so it can support either threatened pass, but it will reach Crampton’s Gap during the collapse."}]]}]]}],["$","div","Munford forms the wall line",{"className":"moment","children":[["$","$L30",null,{"seconds":822,"label":"13:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Munford forms the wall line"}],["$","p",null,{"children":"Roughly 800 cavalry and infantry defend a long front west of Burkittsville; some soldiers stand eight feet apart."}]]}]]}],["$","div","Slocum deploys for attack",{"className":"moment","children":[["$","$L30",null,{"seconds":864,"label":"14:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Slocum deploys for attack"}],["$","p",null,{"children":"His three brigades form one behind another, concentrating enough combat power to break the thin Confederate position."}]]}]]}],["$","div","The battle begins",{"className":"moment","children":[["$","$L30",null,{"seconds":889,"label":"14:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battle begins"}],["$","p",null,{"children":"At about 4 p.m., Slocum’s lead regiments advance toward the stone wall and halt behind a rail fence under heavy fire."}]]}]]}],["$","div","Franklin doubts the pass can be taken",{"className":"moment","children":[["$","$L30",null,{"seconds":987,"label":"16:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Franklin doubts the pass can be taken"}],["$","p",null,{"children":"At 5:20 p.m., he reports that the enemy appears too strong, even as Slocum’s brigade commanders prepare a united charge."}]]}]]}],"$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44"]}]]}]
28:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Directed Franklin to force Crampton’s Gap and relieve Harpers Ferry; organized the September 15 pursuit through the abandoned northern gaps"}]]}],["$","div","VI Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"VI Corps"}],["$","span",null,{"children":"Maj. Gen. William B. Franklin"}],["$","small",null,{"children":"Divisions of Henry W. Slocum and William F. Smith, plus supporting troops from IV Corps; moved slowly on both September 14 and 15 despite urgent operational objectives"}]]}],["$","div","1st Division, VI Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, VI Corps"}],["$","span",null,{"children":"Maj. Gen. Henry W. Slocum"}],["$","small",null,{"children":"Brigades of Joseph J. Bartlett, John Newton, and Alfred T. A. Torbert; formed the assault column that broke the Mountain Church Road line and carried the gap"}]]}],["$","div","2nd Brigade, Slocum’s Division",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade, Slocum’s Division"}],["$","span",null,{"children":"Col. Joseph J. Bartlett"}],["$","small",null,{"children":"5th Maine, 16th and 27th New York, and 96th Pennsylvania; led the advance and joined the united charge about 5:30 p.m."}]]}],["$","div","2nd Division, VI Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, VI Corps"}],["$","span",null,{"children":"Maj. Gen. William F. Smith"}],["$","small",null,{"children":"Supported Slocum’s attack and entered Pleasant Valley after the pass was taken; the episode centers on Slocum’s division"}]]}],["$","div","Harpers Ferry garrison",{"className":"command-entry","children":[["$","strong",null,{"children":"Harpers Ferry garrison"}],["$","span",null,{"children":"Col. Dixon S. Miles"}],["$","small",null,{"children":"About 14,000 soldiers at Harpers Ferry and Martinsburg before the siege; agreed to surrender on September 15 and was mortally wounded after white flags appeared"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Ordered withdrawal from South Mountain, halted near Keedysville to cover McLaws, and formed a new line near Sharpsburg after learning Harpers Ferry would fall"}]]}],["$","div","McLaws’s Division and Pleasant Valley defense",{"className":"command-entry","children":[["$","strong",null,{"children":"McLaws’s Division and Pleasant Valley defense"}],["$","span",null,{"children":"Maj. Gen. Lafayette McLaws"}],["$","small",null,{"children":"Oversaw the Maryland Heights operation; sent Cobb toward Crampton’s Gap and formed Kershaw, Barksdale, Wilcox, and remnants across Pleasant Valley after the breakthrough"}]]}],["$","div","Southern South Mountain sector",{"className":"command-entry","children":[["$","strong",null,{"children":"Southern South Mountain sector"}],["$","span",null,{"children":"Brig. Gen. Paul J. Semmes"}],["$","small",null,{"children":"Divided his available regiments between Brownsville Pass and Crampton’s Gap, expecting the main Federal effort at Brownsville"}]]}],["$","div","Cavalry at Crampton’s Gap",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry at Crampton’s Gap"}],"$L45","$L46"]}],"$L47","$L48","$L49","$L4a"]]}]]}],"$L4b","$L4c"]}]
29:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. Roderick N. Matheson",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. Roderick N. Matheson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 32nd New York Infantry, Newton’s Brigade","."]}]," ","Mortally wounded while leading his regiment at Crampton’s Gap on September 14; died of the wound afterward"]}]]}],["$","article","Lt. Col. Jefferson M. Lamar",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Lt. Col. Jefferson M. Lamar"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Cobb’s Legion Infantry","."]}]," ","Mortally wounded and captured during the Confederate collapse at Crampton’s Gap on September 14; died in Burkittsville on September 15"]}]]}],["$","article","Col. Dixon S. Miles",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. Dixon S. Miles"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Harpers Ferry garrison","."]}]," ","Mortally wounded by a Confederate shell shortly after white flags appeared on September 15; Brig. Gen. Julius White completed the surrender arrangements"]}]]}]]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep186-cramptons-gap-assault.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep186-cramptons-gap-assault.svg","alt":"Schematic map of Slocum’s assault from Burkittsville through the Mountain Church Road line to Crampton’s Gap.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"VI Corps used overwhelming numbers to break the thin stone-wall defense and pursue the Confederates to the summit during the last hours of daylight."}]]}],["$","figure","/images/ep186-retreat-to-antietam.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep186-retreat-to-antietam.svg","alt":"Schematic map of Lee’s withdrawal from South Mountain and concentration behind Antietam Creek.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Lee first intended to cross the Potomac, paused to protect McLaws, and then used the news from Harpers Ferry to reverse course and assemble near Sharpsburg."}]]}],["$","figure","/images/ep186-sneden-cramptons-gap-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep186-sneden-cramptons-gap-map.jpg","alt":"Robert Knox Sneden’s hand-drawn color map of Crampton’s Gap and Burkittsville.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Robert Knox Sneden’s wartime map records the roads, mountain, settlements, and troop positions at Crampton’s Gap."}]]}],["$","figure","/images/ep186-franklin-slocum-officers.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep186-franklin-slocum-officers.jpg","alt":"Civil War group photograph of Franklin, Slocum, Bartlett, Barry, Newton, other officers, and an African American child.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Photographed at Cumberland Landing in May 1862: Joseph J. Bartlett sits at left, Henry W. Slocum second from left, William B. Franklin center, William F. Barry second from right, and John Newton at right."}]]}],["$","figure","/images/ep186-william-franklin.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep186-william-franklin.jpg","alt":"Civil War-era glass-negative portrait of United States major general William B. Franklin in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"William B. Franklin commanded VI Corps. His troops won decisively at Crampton’s Gap, but delays on September 14 and 15 prevented the intended relief of Harpers Ferry."}]]}],["$","figure","/images/ep186-augustus-thompson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep186-augustus-thompson.jpg","alt":"Civil War-era portrait of Confederate captain Augustus C. Thompson in uniform holding a sword.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Capt. Augustus C. Thompson of the 16th Georgia was wounded and captured at Crampton’s Gap. His portrait connects the large operational story to one of the men caught in Cobb’s costly reinforcement."}]]}]]}]]}]
