"}],["$","small",null,{"children":"Nathan Kimball, George Wagner, and Charles Harker"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Loring’s Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Loring’s Corps"}],["$","span",null,{"children":"William W. Loring"}],["$","small",null,{"children":"Winfield S. Featherston and Edward C. Walthall on Big Kennesaw"}]]}],["$","div","Brigade, Loring’s Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Loring’s Corps"}],["$","span",null,{"children":"Thomas M. Scott"}],["$","small",null,{"children":"Defended against Leggett’s division"}]]}],["$","div","Brigade, Walthall’s Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Walthall’s Division"}],["$","span",null,{"children":"William W. Quarles"}],["$","small",null,{"children":"Defended against Gresham’s division"}]]}],["$","div","Hardee’s Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Hardee’s Corps"}],["$","span",null,{"children":"William J. Hardee"}],["$","small",null,{"children":"Patrick R. Cleburne’s division"}]]}],["$","div","Cleburne’s Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Cleburne’s Division"}],["$","span",null,{"children":"Patrick R. Cleburne"}],["$","small",null,{"children":"Hiram Granbury, Daniel Govan, Mark Lowrey, and Lucius Polk"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","George H. Thomas",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"childr