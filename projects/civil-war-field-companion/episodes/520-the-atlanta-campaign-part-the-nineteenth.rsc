ldren":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"June 27, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Big Kennesaw Mountain and the IV Corps sector, Georgia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"U.S. demonstrations against Big Kennesaw failed to enter the Confederate works; Thomas prepared Newton’s division for the main assault"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"June 27, 1864","place":"Big Kennesaw Mountain and the IV Corps sector, Georgia","result":"U.S. demonstrations against Big Kennesaw failed to enter the Confederate works; Thomas prepared Newton’s division for the main assault","facts":[{"label":"Northern U.S. forces","value":"Elements of the XV, XVI, and XVII Corps"},{"label":"Purpose","value":"Hold Confederate troops in place while attacks developed farther south"},{"label":"McPherson’s reported losses","value":"Fewer than 1,000 across his front"},{"label":"Thomas’s main assault force","value":"Newton’s division, IV Corps"},{"label":"U.S. bombardment","value":"Seven IV Corps batteries opened at 8 a.m."},{"label":"Confederate line","value":"Cleburne’s division between Dallas Road and Cheatham Hill"}],"maps":[{"title":"Troop movements at Kennesaw Mountain","caption":"The National Park Service map shows U.S. demonstrations against Big and Little Kennesaw and the attacks at Pigeon Hill and farther south.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm","image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map of troop movements at Kennesaw Mountain on June 27, 1864"},{"title":"Confederate positions across the mountain","caption":"This wartime drawing shows Confederate artillery positions on Pigeon Hill, Little Kennesaw, and Big Kennesaw, where U.S. skirmishers pressed the northern line.","source":"https://www.loc.gov/item/2004660525/","image":"/images/kennesaw-battlefield-drawing.jpg","alt":"1864 drawing of Confederate artillery positions across Kennesaw Mountain"},{"title":"Big Kennesaw and Pigeon Hill today","caption":"The northern demonstrations moved against Big Kennesaw while Logan’s XV Corps attacked near Pigeon Hill to the south.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.65%2C33.96%2C-84.55%2C34.04&layer=mapnik&marker=33.985%2C-84.578"}],"moments":[{"time":"1:16","audioTime":76,"title":"The episode resumes after Logan’s attack","detail":"By noon, the XV Corps attack at Pigeon Hill had ended. Other units continued to press the Confederate line on Big Kennesaw."},{"time":"1:44","audioTime":104,"title":"McPherson used a heavy skirmish line","detail":"Sherman and McPherson wanted the XV, XVI, and XVII Corps troops to keep Confederate units from moving south as reinforcements."},{"time":"2:12","audioTime":132,"title":"Leggett and Gresham advanced on Big Kennesaw","detail":"Skirmishers from Mortimer Leggett’s and Walter Gresham’s XVII Corps divisions moved against Loring’s Confederate corps on the northern slope."},{"time":"2:52","audioTime":172,"title":"Leggett’s men drove in the Confederate skirmishers","detail":"Louisiana skirmishers withdrew to Thomas M. Scott’s main line. Confederate fire then stopped the U.S. advance close to the works."},{"time":"3:39","audioTime":219,"title":"Leggett’s line remained pinned down","detail":"The U.S. soldiers stayed under artillery and small-arms fire for several hours before they withdrew."},{"time":"4:26","audioTime":266,"title":"Gresham’s skirmishers were also stopped","detail":"Men of William W. Quarles’s brigade, including the 1st Alabama skirmishers led by Samuel Knox, stopped the attack."},{"time":"5:23","audioTime":323,"title":"Gresham blamed the mountain slope","detail":"The steep, rough ground broke up the U.S. skirmish line before it could reach the main Confederate position."},{"time":"6:08","audioTime":368,"title":"Dodge sent three Illinois regiments forward","detail":"The 9th and 66th Illinois from Thomas Sweeny’s division and the 64th Illinois from James Veatch’s division advanced against Big Kennesaw."},{"time":"6:31","audioTime":391,"title":"The XVI Corps advance stopped near the crest","detail":"The skirmishers drove Confederate pickets back but could not cross the steep, rocky slope and enter the works."},{"time":"7:38","audioTime":458,"title":"McPherson reported fewer than 1,000 casualties","detail":"Many of the losses occurred among soldiers pinned down for hours at Pigeon Hill and on Kennesaw Mountain."},{"time":"9:55","audioTime":595,"title":"The episode shifts to George H. Thomas","detail":"Thomas commanded more than 50,000 men in the Army of the Cumberland and was responsible for Sherman’s main assault."},{"time":"11:28","audioTime":688,"title":"Thomas doubted the attack would succeed","detail":"Postwar accounts state that Thomas and David Stanley opposed the plan, but Thomas carried out Sherman’s order."},{"time":"13:42","audioTime":822,"title":"IV Corps officers could not see the works clearly","detail":"Joseph Fullerton recorded that dense woods and uneven ground concealed the Confederate position until attackers were very close."},{"time":"14:47","audioTime":887,"title":"The 125th Ohio joined the forward skirmish line","detail":"Harker’s men were awakened at 3 a.m. and moved forward knowing they would lead part of the assault."},{"time":"15:29","audioTime":929,"title":"Newton received orders for a three-brigade attack","detail":"Kimball formed on the left, Wagner in the center, and Harker on the right. Howard ordered Harker and Kimball to use columns."},{"time":"16:42","audioTime":1002,"title":"Harker and Kimball objected to column formations","detail":"Columns presented a narrow front and concentrated men under enemy fire. Howard refused to change the order."},{"time":"17:12","audioTime":1032,"title":"A forward brigade already screened Newton","detail":"William Grose’s brigade from Stanley’s division held a skirmish line a few hundred yards from the Confederate works."},{"time":"17:24","audioTime":1044,"title":"Seven U.S. batteries opened fire","detail":"At 8 a.m., IV Corps artillery began the bombardment that preceded Newton’s infantry attack."},{"time":"17:43","audioTime":1063,"title":"Cleburne’s four brigades held the target line","detail":"Hiram Granbury, Daniel Govan, Mark Lowrey, and Lucius Polk held the ridge from right to left, supported by Confederate artillery."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Ordered the June 27 attacks"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"XV, XVI, and XVII Corps on the northern part of the field"},{"commander":"Grenville M. Dodge","command":"XVI Corps","subordinates":"Thomas Sweeny and James Veatch"},{"commander":"Francis P. Blair Jr.","command":"XVII Corps","subordinates":"Mortimer Leggett and Walter Gresham"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Oliver O. Howard’s IV Corps"},{"commander":"Oliver O. Howard","command":"IV Corps","subordinates":"John Newton’s division"},{"commander":"John Newton","command":"2nd Division, IV Corps","subordinates":"Nathan Kimball, George Wagner, and Charles Harker"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"William W. Loring","command":"Loring’s Corps","subordinates":"Winfield S. Featherston and Edward C. Walthall on Big Kennesaw"},{"commander":"Thomas M. Scott","command":"Brigade, Loring’s Corps","subordinates":"Defended against Leggett’s division"},{"commander":"William W. Quarles","command":"Brigade, Walthall’s Division","subordinates":"Defended against Gresham’s division"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Patrick R. Cleburne’s division"},{"commander":"Patrick R. Cleburne","command":"Cleburne’s Division","subordinates":"Hiram Granbury, Daniel Govan, Mark Lowrey, and Lucius Polk"}]}],"people":[{"name":"George H. Thomas","role":"Commanded the Army of the Cumberland and prepared the main U.S. assault despite opposing it","side":"United States"},{"name":"James B. McPherson","role":"Directed the U.S. attacks and demonstrations north of Thomas’s sector","side":"United States"},{"name":"Mortimer D. Leggett","role":"Sent a heavy skirmish line against Big Kennesaw","side":"United States"},{"name":"Walter Q. Gresham","role":"Sent a second XVII Corps skirmish line up the northern slope","side":"United States"},{"name":"John Newton","role":"Commanded the IV Corps division selected for Thomas’s main attack","side":"United States"},{"name":"Patrick R. Cleburne","role":"Commanded the Confederate division facing Newton","side":"Confederacy"},{"name":"William W. Quarles","role":"Commanded the Alabama brigade that stopped Gresham’s skirmishers","side":"Confederacy"},{"name":"Joseph Fullerton","role":"IV Corps staff officer whose diary describes the concealed Confederate position","side":"United States"}],"losses":[],"gallery":[{"image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map showing U.S. attacks and Confederate positions at Kennesaw Mountain","caption":"The U.S. demonstrations against Big Kennesaw supported the attacks near Pigeon Hill and Cheatham Hill.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"image":"/images/kennesaw-battlefield-drawing.jpg","alt":"Theodore R. Davis drawing of Confederate artillery positions at Kennesaw Mountain","caption":"A wartime drawing of Confederate artillery positions across the mountain.","source":"https://www.loc.gov/item/2004660525/"}],"sources":[{"label":"Official Episode 520 page","url":"https://civilwarpodcast.org/2026/02/08/civil-war-podcast-episode-520/"},{"label":"National Park Service battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ga015"},{"label":"National Park Service troop movements map","url":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"label":"National Park Service Union order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/union-order-of-battle.htm"},{"label":"National Park Service Confederate order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/confederate-order-of-battle.htm"},{"label":"Library of Congress Kennesaw battlefield drawing","url":"https://www.loc.gov/item/2004660525/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
