12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode resumes after Logan’s attack",{"className":"moment","children":[["$","$L17",null,{"seconds":76,"label":"1:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode resumes after Logan’s attack"}],["$","p",null,{"children":"By noon, the XV Corps attack at Pigeon Hill had ended. Other units continued to press the Confederate line on Big Kennesaw."}]]}]]}],["$","div","McPherson used a heavy skirmish line",{"className":"moment","children":[["$","$L17",null,{"seconds":104,"label":"1:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson used a heavy skirmish line"}],["$","p",null,{"children":"Sherman and McPherson wanted the XV, XVI, and XVII Corps troops to keep Confederate units from moving south as reinforcements."}]]}]]}],["$","div","Leggett and Gresham advanced on Big Kennesaw",{"className":"moment","children":[["$","$L17",null,{"seconds":132,"label":"2:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Leggett and Gresham advanced on Big Kennesaw"}],["$","p",null,{"children":"Skirmishers from Mortimer Leggett’s and Walter Gresham’s XVII Corps divisions moved against Loring’s Confederate corps on the northern slope."}]]}]]}],["$","div","Leggett’s men drove in the Confederate skirmishers",{"className":"moment","children":[["$","$L17",null,{"seconds":172,"label":"2:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Leggett’s men drove in the Confederate skirmishers"}],["$","p",null,{"children":"Louisiana skirmishers withdrew to Thomas M. Scott’s main line. Confederate fire then stopped the U.S. advance close to the works."}]]}]]}],["$","div","Leggett’s line remained pinned down",{"className":"moment","children":[["$","$L17",null,{"seconds":219,"label":"3:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Leggett’s line remained pinned down"}],["$","p",null,{"children":"The U.S. soldiers stayed under artillery and small-arms fire for several hours before they withdrew."}]]}]]}],["$","div","Gresham’s skirmishers were also stopped",{"className":"moment","children":[["$","$L17",null,{"seconds":266,"label":"4:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gresham’s skirmishers were also stopped"}],["$","p",null,{"children":"Men of William W. Quarles’s brigade, including the 1st Alabama skirmishers led by Samuel Knox, stopped the attack."}]]}]]}],["$","div","Gresham blamed the mountain slope",{"className":"moment","children":[["$","$L17",null,{"seconds":323,"label":"5:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gresham blamed the mountain slope"}],["$","p",null,{"children":"The steep, rough ground broke up the U.S. skirmish line before it could reach the main Confederate position."}]]}]]}],["$","div","Dodge sent three Illinois regiments forward",{"className":"moment","children":[["$","$L17",null,{"seconds":368,"label":"6:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Dodge sent three Illinois regiments forward"}],["$","p",null,{"children":"The 9th and 66th Illinois from Thomas Sweeny’s division and the 64th Illinois from James Veatch’s division advanced against Big Kennesaw."}]]}]]}],["$","div","The XVI Corps advance stopped near the crest",{"className":"moment","children":[["$","$L17",null,{"seconds":391,"label":"6:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"The XVI Corps advance stopped near the crest"}],["$","p",null,{"children":"The skirmishers drove Confederate pickets back but could not cross the steep, rocky slope and enter the works."}]]}]]}],["$","div","McPherson reported fewer than 1,000 casualties",{"className":"moment","children":[["$","$L17",null,{"seconds":458,"label":"7:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson reported fewer than 1,000 casualties"}],["$","p",null,{"children":"Many of the losses occurred among soldiers pinned down for hours at Pigeon Hill and on Kennesaw Mountain."}]]}]]}],["$","div","The episode shifts to George H. Thomas",{"className":"moment","children":[["$","$L17",null,{"seconds":595,"label":"9:55"}],"$L18"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}]]}]
