11:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L19",null,{"guide":{"date":"June 27–July 1, 1864","place":"Kennesaw Mountain and the Sandtown Road, Georgia","result":"U.S. troops recovered their wounded and prepared a large movement around the Confederate left","facts":[{"label":"U.S. casualties on June 27","value":"About 3,000 killed, wounded, or missing"},{"label":"Confederate casualties on June 27","value":"About 700"},{"label":"Supplies ordered","value":"Ten days of food and forage"},{"label":"Flanking route","value":"Sandtown Road toward Nickajack Creek and the railroad at Fulton"},{"label":"Movement began","value":"6 a.m., July 1"}],"maps":[{"title":"Kennesaw Mountain battlefield","caption":"The 1864 drawing identifies Pigeon Hill, Little and Big Kennesaw, Confederate artillery, and the U.S. position. The wounded lay between the lines after the June 27 attacks.","source":"https://www.loc.gov/item/2004660525/","image":"/images/kennesaw-battlefield-drawing.jpg","alt":"1864 drawing of the Kennesaw Mountain battlefield and Confederate artillery positions"},{"title":"Troop movements on June 27","caption":"The National Park Service map shows the main U.S. attacks in blue, the Confederate line in red, and Schofield’s advance around the southern end of the position.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm","image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map of troop movements at Kennesaw Mountain on June 27, 1864"},{"title":"Planned movement around the Confederate left","caption":"The campaign map shows the Kennesaw lines, Sandtown Road area, Nickajack Creek, Smyrna, the railroad, and the Chattahoochee River.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-4.jpg","alt":"U.S. Army campaign map showing Kennesaw Mountain and routes south toward the Chattahoochee"},{"title":"Kennesaw Mountain and the Sandtown Road corridor today","caption":"Schofield’s advanced position south of Kennesaw gave Sherman room to shift McPherson south and threaten the railroad behind Johnston.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.79%2C33.74%2C-84.43%2C34.08&layer=mapnik&marker=33.9579%2C-84.6047"}],"moments":[{"time":"1:17","audioTime":77,"title":"The June 27 assaults had failed","detail":"XV, IV, and XIV Corps had not broken the Confederate lines. Schofield’s movement along the Sandtown Road provided the basis for a new plan."},{"time":"2:05","audioTime":125,"title":"Sherman decided to reinforce the flanking movement","detail":"He believed a strong move around the Confederate left would force Johnston to abandon Kennesaw or fight outside the works."},{"time":"2:23","audioTime":143,"title":"The armies paused while Sherman accumulated supplies","detail":"The movement would temporarily leave the railroad, so U.S. forces needed several days to prepare wagons and forage."},{"time":"2:38","audioTime":158,"title":"Medical teams treated the U.S. wounded","detail":"Field hospitals received wounded men throughout the day. Some injured soldiers remained between the lines or entered Confederate works for treatment."},{"time":"4:28","audioTime":268,"title":"John Baltzly surrendered at the Confederate parapet","detail":"The 52nd Ohio sergeant had been stranded near the works and could not move without being exposed to fire."},{"time":"4:52","audioTime":292,"title":"Confederate soldiers helped Lansing Dawdy","detail":"After five hours near the works, the wounded 86th Illinois adjutant signaled for help and was carried to a Confederate field hospital."},{"time":"5:18","audioTime":318,"title":"James Jennings was wounded while assisting Newton Bostwick","detail":"The 1st Tennessee sergeant was shot in the neck while helping the wounded 17-year-old U.S. soldier across the parapet. Both survived."},{"time":"6:00","audioTime":360,"title":"Major John Yager died between the lines","detail":"Confederate soldiers judged it too dangerous to reach the wounded 121st Ohio officer. He died during the night."},{"time":"6:31","audioTime":391,"title":"U.S. soldiers searched after dark","detail":"Small groups crawled among the dead to find survivors. Henry Scott was recovered but died the next day."},{"time":"7:14","audioTime":434,"title":"The episode gives the casualty totals","detail":"U.S. losses were about 3,000 killed, wounded, and missing. Confederate losses were about 700."},{"time":"8:14","audioTime":494,"title":"Sherman planned the next operation","detail":"Schofield would extend south, McPherson would leave the U.S. left and join him, and Thomas would cover the vacated sectors."},{"time":"9:37","audioTime":577,"title":"The three armies collected ten days of supplies","detail":"The order included forage for animals. Wounded men were moved to a new hospital at Rome, Georgia."},{"time":"10:49","audioTime":649,"title":"Sherman explained the plan to Washington","detail":"He expected to reach the railroad at Fulton and force Johnston south of the Chattahoochee. Grant told him to proceed as he thought best."},{"time":"11:44","audioTime":704,"title":"Schofield prepared to lead the movement","detail":"XXIII Corps was to move beyond Nickajack Creek and enlarge the U.S. position south of Kennesaw."},{"time":"12:15","audioTime":735,"title":"A signal officer saw Atlanta","detail":"On June 30, an officer climbed a tree south of Olley’s Creek and reported seeing the city and locomotive smoke."},{"time":"14:26","audioTime":866,"title":"Schofield considered a Confederate holdout at Kennesaw","detail":"Sherman replied that he could move below Johnston, cross the Chattahoochee, and cut the railroads without attacking the works."},{"time":"15:51","audioTime":951,"title":"Johnston could not spare cavalry for a major raid","detail":"Joseph Wheeler proposed attacking Sherman’s railroad, but Johnston needed cavalry on the army’s flanks and received no reinforcements from other theaters."},{"time":"17:28","audioTime":1048,"title":"Sherman issued final orders","detail":"Schofield would secure the ground between Olley’s and Nickajack creeks, McPherson would shift south, and Thomas would hold the remaining line."},{"time":"19:33","audioTime":1173,"title":"Speed depended on wagon supplies","detail":"Sherman directed all movements to be rapid because the armies could operate away from the railroad only as long as their carried supplies lasted."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Prepared the flanking operation"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Would hold the Kennesaw front and cover vacated sectors"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"XXIII Corps spearheaded the movement south"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Would shift south from the U.S. left"},{"commander":"George Stoneman and Edward McCook","command":"U.S. cavalry divisions","subordinates":"Covered the western flank"},{"commander":"Kenner Garrard","command":"U.S. cavalry division","subordinates":"Covered roads from Allatoona toward Marietta"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Held the Kennesaw position"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Defended the Confederate right"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Defended the center and left"},{"commander":"William W. Loring","command":"Loring’s Corps","subordinates":"Held the northern sector"},{"commander":"Joseph Wheeler","command":"Cavalry Corps","subordinates":"Proposed a raid against the U.S. railroad"}]}],"people":[{"name":"Lansing Dawdy","role":"86th Illinois adjutant carried into Confederate lines for treatment","side":"United States"},{"name":"Newton Bostwick","role":"17-year-old 52nd Ohio soldier wounded near the Confederate parapet","side":"United States"},{"name":"James Jennings","role":"1st Tennessee sergeant wounded while helping Bostwick","side":"Confederacy"},{"name":"John Yager","role":"121st Ohio major who died after being wounded close to the Confederate works","side":"United States"},{"name":"John M. Schofield","role":"Commanded the advanced U.S. force on the Sandtown Road","side":"United States"},{"name":"Joseph Wheeler","role":"Proposed a cavalry raid against Sherman’s railroad supply line","side":"Confederacy","image":"/images/joseph-wheeler.jpg","source":"https://www.loc.gov/item/2018666551/"},{"name":"Joseph E. Johnston","role":"Could not spare Wheeler’s cavalry or obtain reinforcements from elsewhere","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"}],"losses":[{"name":"John Yager","side":"United States","role":"Major, 121st Ohio Infantry","outcome":"Wounded near the Confederate works on June 27 and died that night"}],"gallery":[{"image":"/images/kennesaw-battlefield-drawing.jpg","alt":"Theodore R. Davis drawing of the Confederate position at Kennesaw Mountain","caption":"The Confederate position across Kennesaw. Many wounded U.S. soldiers remained between the lines after the June 27 assaults.","source":"https://www.loc.gov/item/2004660525/"},{"image":"/images/atlanta-fortifications.jpg","alt":"Confederate earthwork fortifications photographed near Atlanta","caption":"Confederate earthworks near Atlanta show why Sherman chose to maneuver rather than repeat a direct attack.","source":"https://www.loc.gov/item/2018670937/"}],"sources":[{"label":"Official Episode 526 page","url":"https://civilwarpodcast.org/2026/04/26/civil-war-podcast-episode-526/"},{"label":"National Park Service battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ga015"},{"label":"Library of Congress Kennesaw battlefield drawing","url":"https://www.loc.gov/item/2004660525/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"}]}}]}]
