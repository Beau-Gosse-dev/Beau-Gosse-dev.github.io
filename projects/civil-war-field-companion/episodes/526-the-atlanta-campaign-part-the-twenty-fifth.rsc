1a:["$","div",null,{"children":[["$","h3",null,{"children":"Sherman planned the next operation"}],["$","p",null,{"children":"Schofield would extend south, McPherson would leave the U.S. left and join him, and Thomas would cover the vacated sectors."}]]}]
1b:["$","div","The three armies collected ten days of supplies",{"className":"moment","children":[["$","$L18",null,{"seconds":577,"label":"9:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"The three armies collected ten days of supplies"}],["$","p",null,{"children":"The order included forage for animals. Wounded men were moved to a new hospital at Rome, Georgia."}]]}]]}]
1c:["$","div","Sherman explained the plan to Washington",{"className":"moment","children":[["$","$L18",null,{"seconds":649,"label":"10:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman explained the plan to Washington"}],["$","p",null,{"children":"He expected to reach the railroad at Fulton and force Johnston south of the Chattahoochee. Grant told him to proceed as he thought best."}]]}]]}]
1d:["$","div","Schofield prepared to lead the movement",{"className":"moment","children":[["$","$L18",null,{"seconds":704,"label":"11:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schofield prepared to lead the movement"}],["$","p",null,{"children":"XXIII Corps was to move beyond Nickajack Creek and enlarge the U.S. position south of Kennesaw."}]]}]]}]
1e:["$","div","A signal officer saw Atlanta",{"className":"moment","children":[["$","$L18",null,{"seconds":735,"label":"12:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"A signal officer saw Atlanta"}],["$","p",null,{"children":"On June 30, an officer climbed a tree south of Olley’s Creek and reported seeing the city and locomotive smoke."}]]}]]}]
1f:["$","div","Schofield considered a Confederate holdout at Kennesaw",{"className":"moment","children":[["$","$L18",null,{"seconds":866,"label":"14:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schofield considered a Confederate holdout at Kennesaw"}],["$","p",null,{"children":"Sherman replied that he could move below Johnston, cross the Chattahoochee, and cut the railroads without attacking the works."}]]}]]}]
20:["$","div","Johnston could not spare cavalry for a major raid",{"className":"moment","children":[["$","$L18",null,{"seconds":951,"label":"15:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston could not spare cavalry for a major raid"}],["$","p",null,{"children":"Joseph Wheeler proposed attacking Sherman’s railroad, but Johnston needed cavalry on the army’s flanks and received no reinforcements from other theaters."}]]}]]}]
21:["$","div","Sherman issued final orders",{"className":"moment","children":[["$","$L18",null,{"seconds":1048,"label":"17:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman issued final orders"}],["$","p",null,{"children":"Schofield would secure the ground between Olley’s and Nickajack creeks, McPherson would shift south, and Thomas would hold the remaining line."}]]}]]}]
22:["$","div","Speed depended on wagon supplies",{"className":"moment","children":[["$","$L18",null,{"seconds":1173,"label":"19:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Speed depended on wagon supplies"}],["$","p",null,{"children":"Sherman directed all movements to be rapid because the armies could operate away from the railroad only as long as their carried supplies lasted."}]]}]]}]
