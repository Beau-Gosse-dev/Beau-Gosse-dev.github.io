11:["$","figure","Kennesaw Mountain and the Sandtown Road corridor today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-84.79%2C33.74%2C-84.43%2C34.08&layer=mapnik&marker=33.9579%2C-84.6047","title":"Kennesaw Mountain and the Sandtown Road corridor today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Kennesaw Mountain and the Sandtown Road corridor today"}],["$","span",null,{"children":"Schofield’s advanced position south of Kennesaw gave Sherman room to shift McPherson south and threaten the railroad behind Johnston."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:3:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The June 27 assaults had failed",{"className":"moment","children":[["$","$L18",null,{"seconds":77,"label":"1:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The June 27 assaults had failed"}],["$","p",null,{"children":"XV, IV, and XIV Corps had not broken the Confederate lines. Schofield’s movement along the Sandtown Road provided the basis for a new plan."}]]}]]}],["$","div","Sherman decided to reinforce the flanking movement",{"className":"moment","children":[["$","$L18",null,{"seconds":125,"label":"2:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman decided to reinforce the flanking movement"}],["$","p",null,{"children":"He believed a strong move around the Confederate left would force Johnston to abandon Kennesaw or fight outside the works."}]]}]]}],["$","div","The armies paused while Sherman accumulated supplies",{"className":"moment","children":[["$","$L18",null,{"seconds":143,"label":"2:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies paused while Sherman accumulated supplies"}],["$","p",null,{"children":"The movement would temporarily leave the railroad, so U.S. forces needed several days to prepare wagons and forage."}]]}]]}],["$","div","Medical teams treated the U.S. wounded",{"className":"moment","children":[["$","$L18",null,{"seconds":158,"label":"2:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Medical teams treated the U.S. wounded"}],["$","p",null,{"children":"Field hospitals received wounded men throughout the day. Some injured soldiers remained between the lines or entered Confederate works for treatment."}]]}]]}],["$","div","John Baltzly surrendered at the Confederate parapet",{"className":"moment","children":[["$","$L18",null,{"seconds":268,"label":"4:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"John Baltzly surrendered at the Confederate parapet"}],["$","p",null,{"children":"The 52nd Ohio sergeant had been stranded near the works and could not move without being exposed to fire."}]]}]]}],["$","div","Confederate soldiers helped Lansing Dawdy",{"className":"moment","children":[["$","$L18",null,{"seconds":292,"label":"4:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate soldiers helped Lansing Dawdy"}],["$","p",null,{"children":"After five hours near the works, the wounded 86th Illinois adjutant signaled for help and was carried to a Confederate field hospital."}]]}]]}],["$","div","James Jennings was wounded while assisting Newton Bostwick",{"className":"moment","children":[["$","$L18",null,{"seconds":318,"label":"5:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"James Jennings was wounded while assisting Newton Bostwick"}],["$","p",null,{"children":"The 1st Tennessee sergeant was shot in the neck while helping the wounded 17-year-old U.S. soldier across the parapet. Both survived."}]]}]]}],["$","div","Major John Yager died between the lines",{"className":"moment","children":[["$","$L18",null,{"seconds":360,"label":"6:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Major John Yager died between the lines"}],["$","p",null,{"children":"Confederate soldiers judged it too dangerous to reach the wounded 121st Ohio officer. He died during the night."}]]}]]}],["$","div","U.S. soldiers searched after dark",{"className":"moment","children":[["$","$L18",null,{"seconds":391,"label":"6:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. soldiers searched after dark"}],["$","p",null,{"children":"Small groups crawled among the dead to find survivors. Henry Scott was recovered but died the next day."}]]}]]}],["$","div","The episode gives the casualty totals",{"className":"moment","children":[["$","$L18",null,{"seconds":434,"label":"7:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode gives the casualty totals"}],["$","p",null,{"children":"U.S. losses were about 3,000 killed, wounded, and missing. Confederate losses were about 700."}]]}]]}],["$","div","Sherman planned the next operation",{"className":"moment","children":["$L19","$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]]}]
