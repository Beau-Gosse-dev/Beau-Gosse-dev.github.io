1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",95," · ","July 1821–February 25, 1862"," · ","Tennessee and Mississippi; Fort Donelson, Dover, and Nashville, Tennessee"]}],["$","h1",null,{"children":"POSTSCRIPT: FORREST'S BREAKOUT"}],["$","span",null,{"className":"result-label","children":"Nathan Bedford Forrest rose from a Tennessee and Mississippi businessman and slave trader to lieutenant colonel of Confederate cavalry. At Fort Donelson, his cavalry helped open Forge Road during the Confederate attack on February 15, 1862. The senior commanders then ordered the troops back into their defenses. Before the surrender on February 16, Forrest led roughly 500 mounted men out on the old Charlotte Road, crossed flooded Lick Creek, and reached Nashville on February 18"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4253099890.mp3?updated=1695076185","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Forrest born",{"children":[["$","span",null,{"children":"Forrest born"}],["$","strong",null,{"children":"July 1821, Bedford County, Tennessee"}],"$undefined"]}],["$","div","Entered Confederate service",{"children":[["$","span",null,{"children":"Entered Confederate service"}],["$","strong",null,{"children":"June 1861, age 39"}],"$undefined"]}],["$","div","Arrived at Fort Donelson",{"children":[["$","span",null,{"children":"Arrived at Fort Donelson"}],["$","strong",null,{"children":"February 10, 1862, with 500 cavalrymen"}],"$undefined"]}],["$","div","Main breakout attack",{"children":[["$","span",null,{"children":"Main breakout attack"}],["$","strong",null,{"children":"February 15, 1862"}],"$undefined"]}],["$","div","Forrest left the fort",{"children":[["$","span",null,{"children":"Forrest left the fort"}],["$","strong",null,{"children":"About 4 a.m., February 16"}],"$undefined"]}],["$","div","Mounted column stated in episode",{"children":[["$","span",null,{"children":"Mounted column stated in episode"}],["$","strong",null,{"children":"About 500 men"}],"$undefined"]}],["$","div","Reached Nashville",{"children":[["$","span",null,{"children":"Reached Nashville"}],["$","strong",null,{"children":"February 18, 1862"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Battle Flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Le",null,{"flow":{"id":"fort-donelson-breakout","title":"Battle Flow","eyebrow":"Interactive battlefield timeline","subtitle":"Fort Donelson · February 15–16, 1862","description":"Step through the Confederate breakout, the United States counterattacks, and Forrest’s escape on a geographic reference map. Documented locations are distinguished from approximate unit footprints and routes.","mapNote":"Modern geography comes from OpenStreetMap. Historic roads, earthworks, unit centers, and the escape track are reconstructed from National Park Service, Library of Congress, U.S. Army, and American Battlefield Trust sources. They show general relationships, not exact frontage.","map":{"center":[-87.852,36.4805],"zoom":13,"minZoom":11,"maxZoom":16,"bounds":[[-87.902,36.449],[-87.792,36.516]],"basemap":{"label":"Modern reference","tiles":["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],"attribution":"© OpenStreetMap contributors"},"layers":[{"id":"confederate-earthworks","label":"Confederate earthworks","kind":"earthwork","coordinates":[[-87.8636,36.4932],[-87.8596,36.4867],[-87.8581,36.4787],[-87.852,36.4733],[-87.8445,36.4675],[-87.8384,36.4688],[-87.8334,36.4755]],"source":"nps-park-map","confidence":"approximate"},{"id":"forge-road-1862","label":"Forge Road, 1862 corridor","kind":"historic-road","coordinates":[[-87.895,36.461],[-87.875,36.462],[-87.855,36.466],[-87.83935,36.47706]],"source":"nps-forge-road","confidence":"approximate"},{"id":"old-charlotte-road","label":"Old Charlotte Road escape corridor","kind":"escape-route","coordinates":[[-87.83935,36.47706],[-87.8305,36.4805],[-87.8215,36.4802],[-87.8145,36.4768],[-87.802,36.483]],"source":"nps-park-map","confidence":"approximate"},{"id":"lick-creek-crossing","label":"Lick Creek / Cumberland overflow crossing","kind":"water-crossing","coordinates":[[-87.816,36.4785],[-87.8145,36.4768],[-87.813,36.475]],"source":"forrest-report","confidence":"contested"}],"landmarks":[{"id":"fort-donelson","label":"Fort Donelson","kind":"fort","position":[-87.86071,36.48816]},{"id":"dover","label":"Dover","kind":"town","position":[-87.83836,36.48783]},{"id":"forge-road","label":"Forge Road","kind":"headquarters","position":[-87.83935,36.47706]},{"id":"lick-creek","label":"Lick Creek crossing · approx.","kind":"crossing","position":[-87.8145,36.4768]}],"referenceMap":{"label":"NPS battlefield reference map","image":"/images/fort-donelson-park-map.jpg","sourceUrl":"https://www.nps.gov/fodo/planyourvisit/maps.htm","note":"This NPS map is supplied as a separate reference because it is not a georeferenced raster. Keeping it separate avoids implying false precision by stretching it over the modern basemap."}},"frames":[{"id":"assemble","date":"Saturday, February 15","time":"About 4–6 a.m.","title":"The breakout force assembles","summary":"Pillow and Bushrod Johnson mass troops against Grant’s right. Forrest’s cavalry forms on their Cumberland River flank while Buckner remains nearer the Confederate center. The attack is meant to open the roads toward Nashville.","audioTime":808,"audioLabel":"13:28","confidence":"Documented sequence · approximate footprints","confidenceTone":"approximate","evidence":"Episode transcript; NPS battle history; NPS Forge Road; American Battlefield Trust morning map","units":[{"id":"smith","label":"C. F. Smith","side":"union","position":[-87.8745,36.4875]},{"id":"wallace","label":"Lew Wallace","side":"union","position":[-87.875,36.4745]},{"id":"mcclernand","label":"McClernand","side":"union","position":[-87.882,36.4618]},{"id":"buckner","label":"Buckner","side":"confederate","position":[-87.8515,36.475]},{"id":"pillow-johnson","label":"Pillow & Johnson","side":"confederate","position":[-87.846,36.4625]},{"id":"forrest","label":"Forrest cavalry","side":"confederate","position":[-87.8375,36.457]}],"movements":[],"callout":{"position":[-87.848,36.4595],"label":"Breakout columns form"}},{"id":"morning-attack","date":"Saturday, February 15","time":"Daybreak–10:30 a.m.","title":"The Confederate left strikes Grant’s right","summary":"Pillow and Johnson attack McClernand along the Charlotte and Forge roads. Forrest supports the left flank on marshy ground nearer the river. The outnumbered United States right gives ground under repeated pressure.","audioTime":808,"audioLabel":"13:28","confidence":"Documented movement · simplified frontage","confidenceTone":"documented","evidence":"NPS Forge Road; American Battlefield Trust 7–10:30 a.m. map; episode transcript","units":["$1:props:children:1:props:children:3:props:children:props:flow:frames:0:units:0","$1:props:children:1:props:children:3:props:children:props:flow:frames:0:units:1",{"id":"mcclernand","label":"McClernand","side":"union","position":[-87.887,36.463]},"$1:props:children:1:props:children:3:props:children:props:flow:frames:0:units:3",{"id":"pillow-johnson","label":"Pillow & Johnson","side":"confederate","position":[-87.862,36.4625]},{"id":"forrest","label":"Forrest cavalry","side":"confederate","position":[-87.853,36.4555]}],"movements":[{"id":"pillow-advance","side":"confederate","coordinates":[[-87.846,36.4625],[-87.854,36.463],[-87.862,36.4625],[-87.872,36.462]]},{"id":"forrest-advance","side":"confederate","coordinates":[[-87.8375,36.457],[-87.844,36.4555],[-87.853,36.4555],[-87.864,36.458]]},{"id":"mcclernand-back","side":"union","coordinates":[[-87.882,36.4618],[-87.887,36.463],[-87.892,36.466]],"dashed":true}],"callout":{"position":[-87.872,36.4595],"label":"U.S. right forced back"}},{"id":"road-open","date":"Saturday, February 15","time":"Late morning–early afternoon","title":"Forge Road opens; the wider corridor remains contested","summary":"The Confederate advance bends McClernand’s line west toward Wynn’s Ferry Road. Forrest charges exposed batteries and infantry. By about 10:45 a.m. Forge Road is open, but United States forces remain close enough to contest an organized retreat through the wider road network.","audioTime":859,"audioLabel":"14:19","confidence":"Road opening documented · exact gap disputed","confidenceTone":"contested","evidence":"NPS campaign history; NPS Forge Road; American Battlefield Trust morning map; episode transcript","units":["$1:props:children:1:props:children:3:props:children:props:flow:frames:0:units:0",{"id":"wallace","label":"Lew Wallace","side":"union","position":[-87.881,36.475]},{"id":"mcclernand","label":"McClernand reforming","side":"union","position":[-87.893,36.467]},{"id":"buckner","label":"Buckner","side":"confederate","position":[-87.859,36.469]},{"id":"pillow-johnson","label":"Pillow & Johnson","side":"confederate","position":[-87.875,36.462]},{"id":"forrest","label":"Forrest cavalry","side":"confederate","position":[-87.878,36.454]}],"movements":[{"id":"confederate-pressure","side":"confederate","coordinates":[[-87.862,36.4625],[-87.868,36.462],[-87.875,36.462],[-87.884,36.464]]},{"id":"forrest-charges","side":"confederate","coordinates":[[-87.853,36.4555],[-87.866,36.4545],[-87.878,36.454]]},{"id":"route-open","side":"neutral","coordinates":[[-87.83935,36.47706],[-87.85,36.469],[-87.864,36.464]],"dashed":true}],"callout":{"position":[-87.863,36.465],"label":"Forge Road briefly open"}},{"id":"withdrawal","date":"Saturday, February 15","time":"Early–mid afternoon","title":"The attack is called back","summary":"Pillow orders the exhausted attackers back toward their entrenchments. The hard-won corridor is not used. Grant returns to the field, recognizes that the Confederate right has been weakened, and orders attacks on both ends of his line.","audioTime":895,"audioLabel":"14:55","confidence":"Decision documented · timing approximate","confidenceTone":"approximate","evidence":"NPS battle history; U.S. Army campaign history; episode transcript","units":["$1:props:children:1:props:children:3:props:children:props:flow:frames:0:units:0",{"id":"wallace","label":"Lew Wallace","side":"union","position":[-87.879,36.474]},{"id":"mcclernand","label":"McClernand","side":"union","position":[-87.889,36.464]},{"id":"buckner","label":"Buckner","side":"confederate","position":[-87.852,36.473]},{"id":"pillow-johnson","label":"Pillow & Johnson","side":"confederate","position":[-87.856,36.466]},{"id":"forrest","label":"Forrest cavalry","side":"confederate","position":[-87.849,36.459]}],"movements":[{"id":"confederate-return","side":"confederate","coordinates":[[-87.875,36.462],[-87.866,36.463],[-87.856,36.466]],"dashed":true},{"id":"forrest-return","side":"confederate","coordinates":[[-87.878,36.454],[-87.863,36.456],[-87.849,36.459]],"dashed":true}],"callout":{"position":[-87.856,36.4685],"label":"Confederates return to the works"}},{"id":"counterattack","date":"Saturday, February 15","time":"About 3–5 p.m.","title":"Grant closes the corridor","summary":"Lew Wallace and McClernand advance on the United States right and retake most of the morning’s lost ground, closing Charlotte Road. At the opposite end, C. F. Smith storms lightly held rifle pits and gains part of the Confederate outer works before dark.","audioTime":895,"audioLabel":"14:55","confidence":"Documented movement · approximate unit centers","confidenceTone":"documented","evidence":"NPS battle history; NPS historic resource study; American Battlefield Trust 1–5 p.m. map","units":[{"id":"smith","label":"C. F. Smith","side":"union","position":[-87.866,36.486]},{"id":"wallace","label":"Lew Wallace","side":"union","position":[-87.867,36.469]},{"id":"mcclernand","label":"McClernand","side":"union","position":[-87.875,36.462]},"$1:props:children:1:props:children:3:props:children:props:flow:frames:0:units:3",{"id":"pillow-johnson","label":"Pillow & Johnson","side":"confederate","position":[-87.852,36.466]},{"id":"forrest","label":"Forrest cavalry","side":"confederate","position":[-87.845,36.459]}],"movements":[{"id":"smith-assault","side":"union","coordinates":[[-87.8745,36.4875],[-87.87,36.487],[-87.866,36.486],[-87.862,36.484]]},{"id":"wallace-return","side":"union","coordinates":[[-87.879,36.474],[-87.873,36.471],[-87.867,36.469],[-87.861,36.468]]},{"id":"mcclernand-return","side":"union","coordinates":[[-87.889,36.464],[-87.882,36.463],[-87.875,36.462],[-87.867,36.463]]}],"callout":{"position":[-87.862,36.4645],"label":"Charlotte Road closed again"}},{"id":"night-council","date":"Night of February 15–16","time":"After dark","title":"A contested route in the dark","summary":"At headquarters in Dover, Floyd, Pillow, and Buckner debate escape and surrender. Reports say United States troops cover the roads. Forrest argues that fires seen ahead belong to wounded men, not a new battle line, and insists the old Charlotte Road remains passable.","audioTime":973,"audioLabel":"16:13","confidence":"Council documented · road coverage contested","confidenceTone":"contested","evidence":"Episode transcript; NPS battle history; Official Records material reproduced by NPS","units":[{"id":"smith","label":"C. F. Smith","side":"union","position":[-87.866,36.486],"subdued":true},{"id":"wallace","label":"Lew Wallace","side":"union","position":[-87.867,36.469],"subdued":true},{"id":"mcclernand","label":"McClernand","side":"union","position":[-87.875,36.462],"subdued":true},{"id":"garrison","label":"Confederate garrison","side":"confederate","position":[-87.852,36.476]},{"id":"council","label":"Council at Dover","side":"confederate","position":[-87.83836,36.48783]},{"id":"forrest","label":"Forrest scouts route","side":"confederate","position":[-87.829,36.482]}],"movements":[{"id":"scout-route","side":"neutral","coordinates":[[-87.83836,36.48783],[-87.83,36.482],[-87.8215,36.4802]],"dashed":true}],"callout":{"position":[-87.822,36.4805],"label":"Fires misread as a new battle line"},"camera":{"center":[-87.842,36.478],"zoom":13}},{"id":"column-departs","date":"Sunday, February 16","time":"About 4 a.m.","title":"Forrest’s mounted column leaves","summary":"About 400 cavalrymen assemble; roughly 100 more mounted soldiers join them. Forrest leads the column out on the old Charlotte Road. Scouts mistake a fence in the mist for United States infantry, but Forrest and his brother Jeffrey ride ahead and find the way clear.","audioTime":1255,"audioLabel":"20:55","confidence":"Departure documented · exact track approximate","confidenceTone":"approximate","evidence":"Episode transcript; NPS battlefield map; American Battlefield Trust battle summary","units":[{"id":"smith","label":"C. F. Smith","side":"union","position":[-87.866,36.486],"subdued":true},{"id":"wallace","label":"Lew Wallace","side":"union","position":[-87.867,36.469],"subdued":true},{"id":"mcclernand","label":"McClernand","side":"union","position":[-87.875,36.462],"subdued":true},{"id":"garrison","label":"Garrison","side":"confederate","position":[-87.852,36.476],"subdued":true},{"id":"forrest-column","label":"Forrest · about 500 mounted","side":"confederate","position":[-87.827,36.4805]}],"movements":[{"id":"column-route","side":"confederate","coordinates":[[-87.83836,36.48783],[-87.833,36.483],[-87.827,36.4805],[-87.8215,36.4802]]}],"callout":{"position":[-87.8215,36.4802],"label":"Fence line checked; road clear"},"camera":{"center":[-87.837,36.48],"zoom":13.2}},{"id":"lick-creek","date":"Sunday, February 16","time":"Before dawn–early morning","title":"The column crosses the flooded overflow","summary":"The column reaches the crossing east of Dover without a shot. Forrest tests the icy backwater, reported in the episode as saddle-skirt deep, and the mounted men cross quickly. Modern NPS interpretation identifies Lick Creek; Forrest’s report calls it a deep Cumberland River slough.","audioTime":1338,"audioLabel":"22:18","confidence":"Crossing documented · ford location approximate","confidenceTone":"approximate","evidence":"Episode transcript; Forrest’s Official Records report; NPS battlefield map and battle history","units":[{"id":"smith","label":"C. F. Smith","side":"union","position":[-87.866,36.486],"subdued":true},{"id":"wallace","label":"Lew Wallace","side":"union","position":[-87.867,36.469],"subdued":true},{"id":"mcclernand","label":"McClernand","side":"union","position":[-87.875,36.462],"subdued":true},{"id":"garrison","label":"Garrison awaits surrender","side":"confederate","position":[-87.852,36.476],"subdued":true},{"id":"rear-guard","label":"Rear guard","side":"confederate","position":[-87.818,36.478]},{"id":"forrest-column","label":"Forrest column","side":"confederate","position":[-87.808,36.48]}],"movements":[{"id":"ford-crossing","side":"confederate","coordinates":[[-87.827,36.4805],[-87.8215,36.4802],[-87.8145,36.4768],[-87.808,36.48]]},{"id":"toward-nashville","side":"neutral","coordinates":[[-87.808,36.48],[-87.801,36.483],[-87.794,36.488]],"dashed":true}],"callout":{"position":[-87.8145,36.4768],"label":"Lick Creek / overflow crossing (approx.)"},"camera":{"center":[-87.823,36.48],"zoom":13.3}}],"sources":[{"id":"episode-transcript","label":"Episode 95 transcript and audio","url":"https://civilwarpodcast.libsyn.com/95-postscript-forrests-breakout"},{"id":"nps-battle","label":"National Park Service: The Battle of Fort Donelson","url":"https://www.nps.gov/fodo/planyourvisit/thebattleforfortdonelson.htm"},{"id":"nps-forge-road","label":"National Park Service: Forge Road","url":"https://www.nps.gov/places/forge-road.htm"},{"id":"nps-park-map","label":"National Park Service: Fort Donelson battlefield map","url":"https://www.nps.gov/fodo/planyourvisit/maps.htm"},{"id":"loc-plan","label":"Library of Congress: Plan of Fort Donelson and its outworks","url":"https://www.loc.gov/item/2007627485/"},{"id":"abt-map","label":"American Battlefield Trust: Fort Donelson, February 15","url":"https://www.battlefields.org/learn/maps/fort-donelson-feb-15-1862"},{"id":"army-western-theater","label":"U.S. Army: The Civil War in the Western Theater, 1862","url":"https://history.army.mil/portals/143/Images/Publications/catalog/75-7.pdf"},{"id":"forrest-report","label":"Official Records: Nathan Bedford Forrest’s report","url":"https://ehistory.osu.edu/books/official-records/007/0383"},{"id":"nps-study","label":"NPS Historic Resource Study: Fort Donelson","url":"https://www.govinfo.gov/content/pkg/GOVPUB-I29-PURL-gpo235492/pdf/GOVPUB-I