1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",95," · ","July 1821–February 25, 1862"," · ","Tennessee and Mississippi; Fort Donelson, Dover, and Nashville, Tennessee"]}],["$","h1",null,{"children":"POSTSCRIPT: FORREST'S BREAKOUT"}],["$","span",null,{"className":"result-label","children":"Nathan Bedford Forrest rose from a Tennessee and Mississippi businessman and slave trader to lieutenant colonel of Confederate cavalry. At Fort Donelson, his cavalry helped open Forge Road during the Confederate attack on February 15, 1862. The senior commanders then ordered the troops back into their defenses. Before the surrender on February 16, Forrest led roughly 500 mounted men out on the old Charlotte Road, crossed flooded Lick Creek, and reached Nashville on February 18"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4253099890.mp3?updated=1695076185","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"c