1a:["$","div",null,{"children":[["$","h3",null,{"children":"The main breakout began on February 15"}],["$","p",null,{"children":"Forrest’s cavalry supported the left of the Confederate attack. Pillow’s troops drove back McClernand’s division and exposed part of Forge Road."}]]}]
1b:["$","div","Forrest captured U.S. artillery",{"className":"moment","children":[["$","$L18",null,{"seconds":859,"label":"14:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forrest captured U.S. artillery"}],["$","p",null,{"children":"Forrest charged Battery E of the 2nd Illinois Light Artillery, struck the 11th Illinois Infantry, and later captured guns from Battery D of the 1st Illinois Light Artillery."}]]}]]}]
1c:["$","div","Confederate commanders gave up the opened road",{"className":"moment","children":[["$","$L18",null,{"seconds":895,"label":"14:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate commanders gave up the opened road"}],["$","p",null,{"children":"Although the morning attack cleared an escape route, Pillow ordered the troops back into the defenses. Grant then ordered counterattacks by C. F. Smith and Lew Wallace."}]]}]]}]
1d:["$","div","Forrest rejected surrender",{"className":"moment","children":[["$","$L18",null,{"seconds":973,"label":"16:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forrest rejected surrender"}],["$","p",null,{"children":"At the night council, Forrest argued that the old Charlotte Road remained open. Floyd and Buckner relied on reports that U.S. troops blocked the roads and decided the infantry could not cross the flooded creek in freezing weather."}]]}]]}]
1e:["$","div","Forrest received permission to leave",{"className":"moment","children":[["$","$L18",null,{"seconds":1082,"label":"18:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forrest received permission to leave"}],["$","p",null,{"children":"After Buckner assumed command and accepted that the garrison would surrender, Forrest obtained permission to take out his cavalry before a flag of truce was raised."}]]}]]}]
1f:["$","div","About 500 mounted men assembled",{"className":"moment","children":[["$","$L18",null,{"seconds":1255,"label":"20:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"About 500 mounted men assembled"}],["$","p",null,{"children":"Forrest gathered about 400 cavalrymen by 4 a.m. on February 16. Approximately 100 additional soldiers found horses and joined the column."}]]}]]}]
20:["$","div","A fence was mistaken for U.S. infantry",{"className":"moment","children":[["$","$L18",null,{"seconds":1287,"label":"21:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"A fence was mistaken for U.S. infantry"}],["$","p",null,{"children":"Scouts reported a battle line ahead. Forrest and his brother Jeffrey checked the report and found a fence in the mist and darkness, then confirmed with wounded U.S. soldiers that no large force had passed."}]]}]]}]
21:["$","div","The column crossed Lick Creek",{"className":"moment","children":[["$","$L18",null,{"seconds":1338,"label":"22:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The column crossed Lick Creek"}],["$","p",null,{"children":"The mounted column reached the ford without being fired on. Forrest tested the icy, flooded creek himself, and the men crossed water reported to be about saddle-skirt deep."}]]}]]}]
22:["$","div","Forrest reached Nashville",{"className":"moment","children":[["$","$L18",null,{"seconds":1394,"label":"23:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forrest reached Nashville"}],["$","p",null,{"children":"The column arrived on February 18. Forrest took charge of removing Confederate supplies after John B. Floyd left the city."}]]}]]}]
23:["$","div","U.S. troops occupied Nashville",{"className":"moment","children":[["$","$L18",null,{"seconds":1510,"label":"25:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops occupied Nashville"}],["$","p",null,{"children":"Don Carlos Buell reached Nashville on February 25 and found that troops sent to reinforce Grant had already occupied the city. Nashville became the first Confederate state capital captured by U.S. forces."}]]}]]}]
