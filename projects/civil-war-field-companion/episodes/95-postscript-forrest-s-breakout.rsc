"figcaption",null,{"children":[["$","strong",null,{"children":"The breakout and Forrest’s escape"}],["$","span",null,{"children":"Red arrows show the February 15 Confederate attack that briefly opened Forge Road. Blue arrows show the U.S. counterattacks. The dashed gold route shows Forrest leaving before dawn on February 16 and crossing flooded Lick Creek."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/fort-donelson-breakout-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/fodo/planyourvisit/thebattleforfortdonelson.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Fort Donelson battlefield and roads today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/fort-donelson-park-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Fort Donelson battlefield and roads today at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/fort-donelson-park-map.jpg","alt":"National Park Service map of Fort Donelson National Battlefield and the road toward Forrest’s Lick Creek crossing","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Fort Donelson battlefield and roads today"}],["$","span",null,{"children":"The National Park Service map identifies the fort, Dover, Forge Road, the surviving earthworks, and the direction of Forrest’s Lick Creek crossing."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/fort-donelson-park-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ","$L15"]}],"$L16"]}],"$undefined"]}]]}],"$L17"]}]]}]
10:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Forrest was born in Tennessee",{"className":"moment","children":[["$","$L18",null,{"seconds":236,"label":"3:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forrest was born in Tennessee"}],["$","p",null,{"children":"Nathan Bedford Forrest was born in July 1821 in Bedford County, Tennessee. His family moved to northeastern Mississippi in 1834, and his father died three years later."}]]}]]}],["$","div","Forrest moved to Memphis and traded enslaved people",{"className":"moment","children":[["$","$L18",null,{"seconds":363,"label":"6:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forrest moved to Memphis and traded enslaved people"}],["$","p",null,{"children":"By 1851 Forrest had married, started a family, and moved to Memphis. He became a slave trader, invested in real estate and cotton plantations, and accumulated substantial wealth."}]]}]]}],["$","div","Forrest enlisted as a private",{"className":"moment","children":[["$","$L18",null,{"seconds":422,"label":"7:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forrest enlisted as a private"}],["$","p",null,{"children":"After Tennessee seceded, the 39-year-old Forrest joined Josiah White’s Tennessee Mounted Rifles in June 1861. Memphis residents then petitioned Governor Isham Harris to commission him."}]]}]]}],["$","div","Forrest raised and equipped mounted troops",{"className":"moment","children":[["$","$L18",null,{"seconds":452,"label":"7:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forrest raised and equipped mounted troops"}],["$","p",null,{"children":"The governor authorized Forrest to raise mounted rangers. Forrest used personal funds to buy pistols, saddles, and other equipment and became a lieutenant colonel in August."}]]}]]}],["$","div","Forrest won his first engagement at Sacramento",{"className":"moment","children":[["$","$L18",null,{"seconds":495,"label":"8:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forrest won his first engagement at Sacramento"}],["$","p",null,{"children":"In December 1861, Forrest divided about 200 men into three elements and attacked a larger U.S. detachment from the front and both flanks near Sacramento, Kentucky."}]]}]]}],["$","div","Forrest was ordered to Fort Donelson",{"className":"moment","children":[["$","$L18",null,{"seconds":559,"label":"9:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forrest was ordered to Fort Donelson"}],["$","p",null,{"children":"After Fort Henry fell, Forrest reached the Cumberland River opposite Fort Donelson on February 10 with about 500 cavalrymen and completed the crossing the next morning."}]]}]]}],["$","div","Pillow placed Forrest over the cavalry",{"className":"moment","children":[["$","$L18",null,{"seconds":601,"label":"10:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pillow placed Forrest over the cavalry"}],["$","p",null,{"children":"Gideon Pillow gave Forrest command of the mounted troops and sent him to scout the roads between Forts Henry and Donelson."}]]}]]}],["$","div","Forrest delayed McClernand’s advance",{"className":"moment","children":[["$","$L18",null,{"seconds":663,"label":"11:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forrest delayed McClernand’s advance"}],["$","p",null,{"children":"On February 12, Forrest ambushed U.S. cavalry on the lower road with two companies armed with Maynard carbines. He withdrew after Simon Buckner declined to reinforce him."}]]}]]}],["$","div","The first breakout attempt was canceled",{"className":"moment","children":[["$","$L18",null,{"seconds":758,"label":"12:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first breakout attempt was canceled"}],["$","p",null,{"children":"Forrest formed his men for a planned attack on February 14, but Pillow stopped the movement. Confederate river batteries later forced the U.S. gunboats to withdraw."}]]}]]}],["$","div","The main breakout began on February 15",{"className":"moment","children":["$L19","$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}]
