1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",95," · ","July 1821–February 25, 1862"," · ","Tennessee and Mississippi; Fort Donelson, Dover, and Nashville, Tennessee"]}],["$","h1",null,{"children":"POSTSCRIPT: FORREST'S BREAKOUT"}],["$","span",null,{"className":"result-label","children":"Nathan Bedford Forrest rose from a Tennessee and Mississippi businessman and slave trader to lieutenant colonel of Confederate cavalry. At Fort Donelson, his cavalry helped open Forge Road during the Confederate attack on February 15, 1862. The senior commanders then ordered the troops back into their defenses. Before the surrender on February 16, Forrest led roughly 500 mounted men out on the old Charlotte Road, crossed flooded Lick Creek, and reached Nashville on February 18"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Featured action"}],["$","strong",null,{"children":"February 15–16, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Fort Donelson and Lick Creek, near Dover, Tennessee"}]]}],[["$","div",null,{"children":[["$","span",null,{"children":"Outcome"}],["$","strong",null,{"children":"United States victory; the garrison surrendered while Forrest’s column escaped."}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Forrest’s escaping column"}],["$","strong",null,{"children":"About 500 mounted men"}],["$","small",null,{"children":"The episode’s count for Forrest’s column, not the full Confederate force. The episode also covers his earlier life and the journey to Nashville."}],["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/",{"href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":["Source: ","Episode 95 — official podcast website"]}]]}]]}]]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Entire Battle of Fort Donelson · February 13–16, 1862"}],["$","table",null,{"children":[["$","caption",null,{"children":"Estimated soldiers and casualties by side"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":