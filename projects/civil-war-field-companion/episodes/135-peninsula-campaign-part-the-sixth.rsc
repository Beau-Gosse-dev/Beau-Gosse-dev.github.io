d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",135," · ","May 18–30, 1862"," · ","White House Landing, the Chickahominy River approaches east and northeast of Richmond, and Hanover Court House, Virginia"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN (Part the Sixth)"}],["$","span",null,{"className":"result-label","children":"McClellan kept White House Landing as his base and advanced along the Richmond and York River Railroad, leaving three corps north of the Chickahominy and two south of it. Lincoln suspended McDowell’s expected march from Fredericksburg after Jackson’s victories in the Shenandoah Valley. Porter defeated Branch at Hanover Court House on May 27, but the intended junction with McDowell did not occur. Johnston then abandoned a proposed attack near Mechanicsville and prepared to strike the more isolated United States wing near Seven Pines and Fair Oaks on May 31"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"May 18–30, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"White House Landing, the Chickahominy River approaches east and northeast of Richmond, and Hanover Court House, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"McClellan kept White House Landing as his base and advanced along the Richmond and York River Railroad, leaving three corps north of the Chickahominy and two south of it. Lincoln suspended McDowell’s expected march from Fredericksburg after Jackson’s victories in the Shenandoah Valley. Porter defeated Branch at Hanover Court House on May 27, but the intended junction with McDowell did not occur. Johnston then abandoned a proposed attack near Mechanicsville and prepared to strike the more isolated United States wing near Seven Pines and Fair Oaks on May 31"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],"$Lf","$L10"]}],"$L11"]}],"$undefined"]}],"$L12","$L13",false,false,"$L14",false,"$L15","$L16","$L17","$L18"]}]]}]
