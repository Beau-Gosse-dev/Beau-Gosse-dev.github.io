1a:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","McClellan’s approach to Richmond",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep135-richmond-approaches.svg","target":"_blank","rel":"noreferrer","aria-label":"Open McClellan’s approach to Richmond at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-richmond-approaches.svg","alt":"Schematic map of McClellan’s railroad approach from White House Landing, the alternative James River route, and McDowell’s expected route from Fredericksburg","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"McClellan’s approach to Richmond"}],["$","span",null,{"children":"This schematic shows the actual supply line from White House Landing along the Richmond and York River Railroad and the alternative James River approach discussed in the episode. It also locates Fredericksburg, Hanover Court House, Richmond, and the Chickahominy crossings. Distances and river courses are simplified."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep135-richmond-approaches.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Hanover Court House, May 27, 1862",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep135-hanover-court-house.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Hanover Court House, May 27, 1862 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-hanover-court-house.svg","alt":"Schematic tactical map of the May 27 Battle of Hanover Court House showing Porter’s advance and Branch’s attack near Peake’s Crossing","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Hanover Court House, May 27, 1862"}],["$","span",null,{"children":"Porter moved north from Mechanicsville to clear the roads and railroads between McClellan and the expected reinforcements from Fredericksburg. Branch attacked the rear of the United States column near Peake’s Crossing and was driven from the field after Morell concentrated infantry and artillery. The diagram is schematic and does not claim exact unit frontage."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep135-hanover-court-house.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/gvhs01.vhs00213/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
1b:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The James River is open to Drewry’s Bluff",{"className":"moment","children":[["$","$L20",null,{"seconds":69,"label":"1:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The James River is open to Drewry’s Bluff"}],["$","p",null,{"children":"The naval attack of May 15 failed to pass Drewry’s Bluff, but United States control below the obstruction created a possible new base for operations against Richmond."}]]}]]}],["$","div","Lincoln favors a shift toward the James",{"className":"moment","children":[["$","$L20",null,{"seconds":125,"label":"2:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln favors a shift toward the James"}],["$","p",null,{"children":"Lincoln saw the operational opportunity, but McClellan retained the supply line through White House Landing and the railroad."}]]}]]}],["$","div","White House Landing becomes the main base",{"className":"moment","children":[["$","$L20",null,{"seconds":136,"label":"2:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"White House Landing becomes the main base"}],["$","p",null,{"children":"McClellan moved up the Pamunkey, established a large depot at White House Landing, and used the Richmond and York River Railroad as his axis toward Richmond."}]]}]]}],["$","div","McClellan keeps the eastern approach",{"className":"moment","children":[["$","$L20",null,{"seconds":191,"label":"3:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan keeps the eastern approach"}],["$","p",null,{"children":"An advance from the east required the army to operate on both sides of the Chickahominy. A James River base could have kept more of the army south of that obstacle."}]]}]]}],["$","div","McDowell must march overland",{"className":"moment","children":[["$","$L20",null,{"seconds":245,"label":"4:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"McDowell must march overland"}],["$","p",null,{"children":"Lincoln required McDowell’s expected reinforcements to move south from Fredericksburg rather than travel by water to White House Landing."}]]}]]}],["$","div","The episode disputes McClellan’s later explanation",{"className":"moment","children":[["$","$L20",null,{"seconds":318,"label":"5:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode disputes McClellan’s later explanation"}],["$","p",null,{"children":"The hosts note that McClellan had selected the White House and railroad line before he knew McDowell would approach from the north. They interpret access to the railroad for siege artillery as an important reason for the choice."}]]}]]}],["$","div","The five-corps deployment takes shape",{"className":"moment","children":[["$","$L20",null,{"seconds":448,"label":"7:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The five-corps deployment takes shape"}],["$","p",null,{"children":"Sumner, Franklin, and Porter extended northwest on the north side of the Chickahominy. Keyes and Heintzelman formed the left wing south of the river."}]]}]]}],["$","div","The dispositions are complete",{"className":"moment","children":[["$","$L20",null,{"seconds":519,"label":"8:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The dispositions are complete"}],["$","p",null,{"children":"By May 24, Porter’s extreme right was near Mechanicsville and Keyes’s advance was near Seven Pines, each about six miles from Richmond."}]]}]]}],["$","div","McDowell is diverted again",{"className":"moment","children":[["$","$L20",null,{"seconds":536,"label":"8:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"McDowell is diverted again"}],["$","p",null,{"children":"Jackson’s operations in the Shenandoah Valley led Lincoln and Stanton to suspend the reinforcement movement toward McClellan."}]]}]]}],["$","div","McClellan protests the diversion",{"className":"moment","children":[["$","$L20",null,{"seconds":580,"label":"9:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan protests the diversion"}],["$","p",null,{"children":"McClellan told Stanton that the decisive issue was the expected battle before Richmond. McDowell also objected to the change."}]]}]]}],"$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c"]}]]}]
1c:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Commander, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Army of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Directed the advance from White House Landing and placed five corps on both sides of the Chickahominy"}]]}],["$","div","Commander, II Corps; north of the Chickahominy",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, II Corps; north of the Chickahominy"}],["$","span",null,{"children":"Edwin V. Sumner"}],["$","small",null,{"children":"Israel B. Richardson and John Sedgwick; the nearest large reserve to the exposed Fair Oaks sector"}]]}],["$","div","Commander, III Corps; south of the Chickahominy",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, III Corps; south of the Chickahominy"}],["$","span",null,{"children":"Samuel P. Heintzelman"}],["$","small",null,{"children":"Joseph Hooker and Philip Kearny; deployed behind and south of Keyes’s advance"}]]}],["$","div","Commander, IV Corps; south of the Chickahominy",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, IV Corps; south of the Chickahominy"}],["$","span",null,{"children":"Erasmus D. Keyes"}],["$","small",null,{"children":"Silas Casey in the forward position and Darius N. Couch in support along the Williamsburg Road"}]]}],["$","div","Commander, V Corps; right wing and Hanover expedition",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, V Corps; right wing and Hanover expedition"}],["$","span",null,{"children":"Fitz John Porter"}],["$","small",null,{"children":"George W. Morell’s division and George Sykes’s division; Morell and attached troops fought at Hanover Court House"}]]}],["$","div","Commander, VI Corps; north of the Chickahominy",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, VI Corps; north of the Chickahominy"}],["$","span",null,{"children":"William B. Franklin"}],["$","small",null,{"children":"William F. Smith and Henry W. Slocum; held the center-right portion of the northern wing"}]]}],["$","div","Commander, Department of the Rappahannock",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Department of the Rappahannock"}],["$","span",null,{"children":"Irvin McDowell"}],["$","small",null,{"children":"Expected to march south from Fredericksburg but diverted toward operations against Jackson before joining McClellan"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","President and commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander in chief"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Exercised national authority at Richmond and pressed Johnston to state where he intended to defend the capital"}]]}],["$","div","Military adviser to the president",{"className":"command-entry","children":[["$","strong",null,{"children":"Military adviser to the president"}],["$","span",null,{"children":"Robert E. Lee"}],["$","small",null,{"children":"Advised Davis on Richmond’s defense; he did not yet command Johnston’s field army"}]]}],["$","div","Commander, Confederate field army defending Richmond",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Confederate field army defending Richmond"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"James Longstreet, Gustavus W. Smith, D. H. Hill, Benjamin Huger, and John B. Magruder commanded the principal divisions available around Richmond"}]]}],"$L2d"]]}]]}],"$L2e","$L2f"]}]
1d:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep135-white-house-supply-vessels.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-white-house-supply-vessels.jpg","alt":"Supply vessels anchored at White House Landing on the Pamunkey River in 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Supply vessels at White House Landing. McClellan made this Pamunkey River depot the base for the advance along the Richmond and York River Railroad."}]]}],["$","figure","/images/ep135-grapevine-bridge.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-grapevine-bridge.jpg","alt":"Soldiers beside the Grapevine Bridge over the Chickahominy River in 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The 5th New Hampshire Infantry built the Grapevine Bridge on May 27–28. The photograph documents the improvised crossings on which communication between McClellan’s two wings depended."}]]}],["$","figure","/images/ep135-fitz-john-porter.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-fitz-john-porter.jpg","alt":"Fitz John Porter in United States Army uniform during the Civil War era","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Fitz John Porter commanded V Corps and the expedition to Hanover Court House. The battle cleared the immediate route north but did not produce the planned junction with McDowell."}]]}],["$","figure","/images/ep135-joseph-e-johnston.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-joseph-e-johnston.jpg","alt":"Portrait of Confederate general Joseph E. Johnston in civilian dress","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Joseph E. Johnston abandoned his proposed attack near Mechanicsville after learning that McDowell was not approaching Richmond and chose instead to attack the isolated United States wing south of the Chickahominy."}]]}]]}]]}]
