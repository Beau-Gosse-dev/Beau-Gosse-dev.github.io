1f:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
21:["$","div","The Chickahominy becomes a major obstacle",{"className":"moment","children":[["$","$L20",null,{"seconds":629,"label":"10:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Chickahominy becomes a major obstacle"}],["$","p",null,{"children":"A narrow stream in dry weather could spread across broad marshes and wooded bottomlands after rain. The episode states that the river reached its highest level in twenty years in late May."}]]}]]}]
22:["$","div","Engineers build eleven crossings",{"className":"moment","children":[["$","$L20",null,{"seconds":658,"label":"10:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Engineers build eleven crossings"}],["$","p",null,{"children":"The army worked on bridges from Bottom’s Bridge to Mechanicsville. Long timber and corduroy approaches were necessary across saturated ground."}]]}]]}]
23:["$","div","Porter moves toward Hanover Court House",{"className":"moment","children":[["$","$L20",null,{"seconds":689,"label":"11:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Porter moves toward Hanover Court House"}],["$","p",null,{"children":"On May 27, McClellan sent a reinforced V Corps division north to clear the route for McDowell and damage the Virginia Central Railroad."}]]}]]}]
24:["$","div","Morell advances behind Berdan’s skirmishers",{"className":"moment","children":[["$","$L20",null,{"seconds":726,"label":"12:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Morell advances behind Berdan’s skirmishers"}],["$","p",null,{"children":"George W. Morell’s division moved with Hiram Berdan’s sharpshooters and supporting artillery against Lawrence O’B. Branch’s North Carolina brigade."}]]}]]}]
25:["$","div","Branch attacks the United States rear",{"className":"moment","children":[["$","$L20",null,{"seconds":748,"label":"12:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Branch attacks the United States rear"}],["$","p",null,{"children":"The Confederate attack broke the 25th New York and disabled a battery, but the 14th New York helped stop the advance."}]]}]]}]
26:["$","div","Morell’s force counterattacks",{"className":"moment","children":[["$","$L20",null,{"seconds":768,"label":"12:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Morell’s force counterattacks"}],["$","p",null,{"children":"The 9th Massachusetts and 62nd Pennsylvania joined the counterattack, and Branch’s outnumbered command withdrew."}]]}]]}]
27:["$","div","The episode reports the Hanover losses",{"className":"moment","children":[["$","$L20",null,{"seconds":788,"label":"13:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode reports the Hanover losses"}],["$","p",null,{"children":"It gives 355 United States killed and wounded, about 200 Confederate killed and wounded, and about 500 Confederates captured. The NPS estimate is 355 United States and 746 Confederate casualties in all categories."}]]}]]}]
28:["$","div","The movement alarms Johnston",{"className":"moment","children":[["$","$L20",null,{"seconds":800,"label":"13:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The movement alarms Johnston"}],["$","p",null,{"children":"Porter’s advance and a deceptive movement by McDowell convinced Johnston that a large reinforcement column might soon join McClellan."}]]}]]}]
29:["$","div","Johnston plans to attack near Mechanicsville",{"className":"moment","children":[["$","$L20",null,{"seconds":900,"label":"15:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston plans to attack near Mechanicsville"}],["$","p",null,{"children":"Believing a junction with McDowell was imminent, Johnston planned to strike the United States right on May 29."}]]}]]}]
2a:["$","div","Johnston changes the objective",{"className":"moment","children":[["$","$L20",null,{"seconds":927,"label":"15:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston changes the objective"}],["$","p",null,{"children":"On the night of May 28, Johnston learned that McDowell was returning toward Fredericksburg. He shifted his planned attack to the two United States corps south of the Chickahominy."}]]}]]}]
2b:["$","div","Reconnaissance finds the left wing exposed",{"className":"moment","children":[["$","$L20",null,{"seconds":968,"label":"16:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Reconnaissance finds the left wing exposed"}],["$","p",null,{"children":"On May 30, Confederate scouts found Casey’s IV Corps division near Seven Pines and Fair Oaks with an especially thin right flank and difficult terrain between it and Sumner’s II Corps."}]]}]]}]
2c:["$","div","Johnston orders the May 31 attack",{"className":"moment","children":[["$","$L20",null,{"seconds":1043,"label":"17:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston orders the May 31 attack"}],["$","p",null,{"children":"Johnston decided to attack Keyes and Heintzelman before the flooded river and unfinished crossings allowed McClellan to reinforce them from the north bank."}]]}]]}]
2d:["$","div","Brigade commander at Hanover Court House",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade commander at Hanover Court House"}],["$","span",null,{"children":"Lawrence O’B. Branch"}],["$","small",null,{"children":"Commanded North Carolina regiments detached north of Richmond and attacked Porter’s column near Peake’s Crossing"}]]}]
2e:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
2f:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","George B. McClellan",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George B. McClellan"}],["$","p",null,{"children":"Selected White House Landing and the railroad as his supply axis and deployed the Army of the Potomac on both sides of the Chickahominy"}]]}]]}],["$","article","Fitz John Porter",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-fitz-john-porter.jpg","alt":"Portrait of Fitz John Porter","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Fitz John Porter"}],["$","p",null,{"children":"Commanded V Corps on the army’s right and led the May 27 expedition that defeated Branch near Hanover Court House"}]]}]]}],["$","article","George W. Morell",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GW"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George W. Morell"}],["$","p",null,{"children":"Commanded the V Corps division that supplied most of the United States infantry at Hanover Court House"}]]}]]}],["$","article","Hiram Berdan",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"HB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Hiram Berdan"}],["$","p",null,{"children":"Commanded the sharpshooters who screened Morell’s advance; the transcript renders his surname as “Bearden”"}]]}]]}],["$","article","Irvin McDowell",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"IM"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Irvin McDowell"}],["$","p",null,{"children":"Was ordered toward McClellan from Fredericksburg, then diverted before the expected junction occurred"}]]}]]}],["$","article","Erasmus D. Keyes",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"ED"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Erasmus D. Keyes"}],["$","p",null,{"children":"Commanded IV Corps and the forward United States positions south of the Chickahominy near Seven Pines and Fair Oaks"}]]}]]}],["$","article","Silas Casey",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"SC"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Silas Casey"}],["$","p",null,{"children":"Commanded the exposed forward division of Keyes’s IV Corps near Seven Pines"}]]}]]}],["$","article","Joseph E. Johnston",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-joseph-e-johnston.jpg","alt":"Portrait of Joseph E. Johnston","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Joseph E. Johnston"}],["$","p",null,{"children":"Commanded the Confederate field army, first planned to attack near Mechanicsville, and then redirected the offensive against the United States left wing"}]]}]]}],["$","article","Lawrence O’B. Branch",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"LO"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Lawrence O’B. Branch"}],["$","p",null,{"children":"Commanded the outnumbered Confederate brigade defeated by Porter at Hanover Court House"}]]}]]}],"$L35","$L36"]}]
