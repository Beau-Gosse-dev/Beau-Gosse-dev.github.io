1c:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep135-white-house-supply-vessels.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-white-house-supply-vessels.jpg","alt":"Supply vessels anchored at White House Landing on the Pamunkey River in 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Supply vessels at White House Landing. McClellan made this Pamunkey River depot the base for the advance along the Richmond and York River Railroad."}]]}],["$","figure","/images/ep135-grapevine-bridge.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-grapevine-bridge.jpg","alt":"Soldiers beside the Grapevine Bridge over the Chickahominy River in 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The 5th New Hampshire Infantry built the Grapevine Bridge on May 27–28. The photograph documents the improvised crossings on which communication between McClellan’s two wings depended."}]]}],["$","figure","/images/ep135-fitz-john-porter.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-fitz-john-porter.jpg","alt":"Fitz John Porter in United States Army uniform during the Civil War era","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Fitz John Porter commanded V Corps and the expedition to Hanover Court House. The battle cleared the immediate route north but did not produce the planned junction with McDowell."}]]}],["$","figure","/images/ep135-joseph-e-johnston.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep135-joseph-e-johnston.jpg","alt":"Portrait of Confederate general Joseph E. Johnston in civilian dress","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Joseph E. Johnston abandoned his proposed attack near Mechanicsville after learning that McDowell was not approaching Richmond and chose instead to attack the isolated United States wing south of the Chickahominy."}]]}]]}]]}]
