11:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2015/12/13/civil-war-podcast-episode-135/",{"href":"https://civilwarpodcast.org/2015/12/13/civil-war-podcast-episode-135/","target":"_blank","rel":"noreferrer","children":["Source: ","The Civil War Podcast: episode 135 page"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va013",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va013","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Hanover Court House battle summary"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/",{"href":"https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Civil War campaign summary"]}],["$","a","https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm",{"href":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Jackson’s 1862 Shenandoah Valley Campaign"]}],["$","a","https://ehistory.osu.edu/books/official-records/012/0033",{"href":"https://ehistory.osu.edu/books/official-records/012/0033","target":"_blank","rel":"noreferrer","children":[" · ","Official Records: McClellan’s report and orders for the Hanover expedition"]}],["$","a","https://ehistory.osu.edu/books/official-records/014/0194",{"href":"https://ehistory.osu.edu/books/official-records/014/0194","target":"_blank","rel":"noreferrer","children":[" · ","Official Records: May 27 correspondence concerning McDowell and Porter"]}],["$","a","https://ehistory.osu.edu/books/official-records/018/0897",{"href":"https://ehistory.osu.edu/books/official-records/018/0897","target":"_blank","rel":"noreferrer","children":[" · ","Official Records: Johnston orders Branch to Hanover Court House"]}],["$","a","https://www.archives.gov/research/alic/reference/military/civil-war-armies-records.html",{"href":"https://www.archives.gov/research/alic/reference/military/civil-war-armies-records.html","target":"_blank","rel":"noreferrer","children":[" · ","National Archives: Official Records of the Union and Confederate Armies"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00213/",{"href":"https://www.loc.gov/item/gvhs01.vhs00213/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Robert Knox Sneden map of Hanover Court House"]}],["$","a","https://blogs.loc.gov/maps/2018/06/places-in-civil-war-history-maps-of-the-peninsula-campaign-part-2/",{"href":"https://blogs.loc.gov/maps/2018/06/places-in-civil-war-history-maps-of-the-peninsula-campaign-part-2/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: maps of the Peninsula Campaign, part 2"]}],["$","a","https://www.loc.gov/item/2018666164/",{"href":"https://www.loc.gov/item/2018666164/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: White House Landing supply vessels"]}],["$","a","https://www.loc.gov/item/2018666171/",{"href":"https://www.loc.gov/item/2018666171/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Grapevine Bridge over the Chickahominy"]}],["$","a","https://www.loc.gov/item/2018667594/",{"href":"https://www.loc.gov/item/2018667594/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Fitz John Porter portrait"]}],"$L19"]}]
