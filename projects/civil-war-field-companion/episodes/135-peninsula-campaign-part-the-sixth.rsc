e:["$","span",null,{"children":"United States deployment by May 24"}]
f:["$","strong",null,{"children":"Three corps north of the Chickahominy; two corps south"}]
10:["$","small",null,{"children":"Porter’s V, Franklin’s VI, and Sumner’s II Corps were north of the river. Keyes’s IV and Heintzelman’s III Corps were south of it."}]
11:["$","div","Frontage north of the river",{"children":[["$","span",null,{"children":"Frontage north of the river"}],["$","strong",null,{"children":"About 10 miles"}],["$","small",null,{"children":"The northern wing extended toward Mechanicsville while also covering the railroad and White House Landing."}]]}]
12:["$","div","Chickahominy crossings",{"children":[["$","span",null,{"children":"Chickahominy crossings"}],["$","strong",null,{"children":"11 bridges across a 12-mile reach"}],["$","small",null,{"children":"The episode places the bridges between Bottom’s Bridge and Mechanicsville. Flooded bottomlands required long corduroy approaches beyond the river channel."}]]}]
13:["$","div","Hanover Court House",{"children":[["$","span",null,{"children":"Hanover Court House"}],["$","strong",null,{"children":"May 27, 1862 — United States victory"}],["$","small",null,{"children":"Porter’s force cleared the route toward McDowell and damaged the Virginia Central Railroad, but McDowell did not join McClellan."}]]}]
14:["$","div","Hanover Court House casualties",{"children":[["$","span",null,{"children":"Hanover Court House casualties"}],["$","strong",null,{"children":"NPS estimate: 355 United States and 746 Confederate"}],["$","small",null,{"children":"The episode gives 355 United States killed and wounded, about 200 Confederate killed and wounded, and about 500 Confederates captured. These figures describe similar totals but do not reconcile exactly."}]]}]
15:["$","div","Johnston’s first attack plan",{"children":[["$","span",null,{"children":"Johnston’s first attack plan"}],["$","strong",null,{"children":"Strike the United States right near Mechanicsville on May 29"}],"$undefined"]}]
16:["$","div","Johnston’s revised attack plan",{"children":[["$","span",null,{"children":"Johnston’s revised attack plan"}],["$","strong",null,{"children":"Strike IV and III Corps south of the Chickahominy on May 31"}],["$","small",null,{"children":"Johnston changed the objective after learning that McDowell was not continuing toward Richmond."}]]}]
17:["$","div","Senior commanders killed or mortally wounded",{"children":[["$","span",null,{"children":"Senior commanders killed or mortally wounded"}],["$","strong",null,{"children":"None identified in the events covered"}],["$","small",null,{"children":"The episode reports losses at Hanover Court House but does not identify a senior commander killed or mortally wounded there."}]]}]
18:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"The Civil War: An Illustrated History by Geoffrey C. Ward, with Ric Burns and Ken Burns"}],"$undefined"]}]
