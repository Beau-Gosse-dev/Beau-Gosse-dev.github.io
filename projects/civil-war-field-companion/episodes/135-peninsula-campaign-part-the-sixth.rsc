1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",135," · ","May 18–30, 1862"," · ","White House Landing, the Chickahominy River approaches east and northeast of Richmond, and Hanover Court House, Virginia"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN (Part the Sixth)"}],["$","span",null,{"className":"result-label","children":"McClellan kept White House Landing as his base and advanced along the Richmond and York River Railroad, leaving three corps north of the Chickahominy and two south of it. Lincoln suspended McDowell’s expected march from Fredericksburg after Jackson’s victories in the Shenandoah Valley. Porter defeated Branch at Hanover Court House on May 27, but the intended junction with McDowell did not occur. Johnston then abandoned a proposed attack near Mechanicsville and prepared to strike the more isolated United States wing near Seven Pines and Fair Oaks on May 31"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9341430668.mp3?updated=1695220075","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Army of the Potomac base",{"children":[["$","span",null,{"children":"Army of the Potomac base"}],["$","strong",null,{"children":"White House Landing on the Pamunkey River"}],["$","small",null,{"children":"The nearby Richmond and York River Railroad connected the supply base to McClellan’s advance toward Richmond."}]]}],["$","div","Chosen approach",{"children":[["$","span",null,{"children":"Chosen approach"}],["$","strong",null,{"children":"From the east along the railroad"}],["$","small",null,{"children":"The episode argues that moving heavy siege artillery by rail influenced McClellan’s choice. That motive is an interpretation; McClellan later emphasized the expected junction with McDowell."}]]}],["$","div","Alternative approach",{"children":[["$","span",null,{"children":"Alternative approach"}],["$","strong",null,{"children":"Shift the army to the James River and approach Richmond from the south"}],["$","small",null,{"children":"Lincoln and Confederate leaders recognized this possibility after United States naval forces gained access to the James as far as Drewry’s Bluff."}]]}],["$","div","Expected reinforcements",{"children":[["$","span",null,{"children":"Expected reinforcements"}],["$","strong",null,{"children":"About 40,000 under Irvin McDowell and James Shields"}],["$","small",null,{"children":"The episode’s estimate combines the forces expected to move from the Fredericksburg direction."}]]}],["$","div","Reinforcement order",{"children":[["$","span",null,{"children":"Reinforcement order"}],["$","strong",null,{"children":"Suspended May 24"}],["$","small",null,{"children":"Lincoln redirected McDowell because Jackson’s Valley Campaign threatened United States forces and raised renewed concern for Washington."}]]}],["$","div","United States deployment by May 24",{"children":["$Le","$Lf","$L10"]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18"]}],"$L19","$undefined","$L1a",false,"$L1b",false,"$L1c","$L1d","$L1e"]}]]}]
