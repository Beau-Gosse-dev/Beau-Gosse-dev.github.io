1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",191," · ","September 17, 1862"," · ","The northern Antietam battlefield near Sharpsburg, Maryland, from the Joseph Poffenberger farm and Miller’s Cornfield south to the Dunker Church plateau, with the East and West Woods on either flank"]}],["$","h1",null,{"children":"ANTIETAM (Part the Sixth)"}],["$","span",null,{"className":"result-label","children":"Soon after daybreak, Joseph Hooker opened the Battle of Antietam by sending the United States I Corps south toward the Dunker Church. James B. Ricketts’s division attacked through the Cornfield and East Woods in separate brigade actions. Alexander Lawton’s Confederates, supported by Stephen D. Lee’s artillery and a counterattack by Harry T. Hays’s Louisiana brigade, stopped the advance. By about 7 a.m. the fighting in the eastern Cornfield and East Woods had reached a costly stalemate; Abner Doubleday’s simultaneous attack along the Hagerstown Turnpike continues in the next episode"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1277834509.mp3?updated=1695499441","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The opening action at Antietam, from daybreak to about 7 a.m."}],["$","small",null,{"children":"The episode follows Hooker’s plan, the opening artillery exchange, and Ricketts’s attack through the eastern Cornfield and East Woods. Doubleday’s attack on the I Corps right is introduced but reserved for the next episode."}]]}],["$","div","Hooker’s objective",{"children":[["$","span",null,{"children":"Hooker’s objective"}],["$","strong",null,{"children":"The Dunker Church plateau"}],["$","small",null,{"children":"Hooker planned to attack south along the Hagerstown Turnpike and believed possession of the plateau would begin to roll up the Confederate left."}]]}],["$","div","United States opening force",{"children":[["$","span",null,{"children":"United States opening force"}],["$","strong",null,{"children":"About 8,600 men in I Corps in the episode’s estimate"}],["$","small",null,{"children":"Hooker’s three divisions opened the northern attack before Mansfield’s XII Corps could provide effective support."}]]}],["$","div","I Corps deployment",{"children":[["$","span",null,{"children":"I Corps deployment"}],["$","strong",null,{"children":"Doubleday right, Ricketts left, Meade supporting the center"}],["$","small",null,{"children":"Truman Seymour’s brigade of Meade’s Pennsylvania Reserves already held a lodgement in the East Woods after the September 16 skirmish."}]]}],["$","div","Hooker’s expanded responsibility",{"children":[["$","span",null,{"children":"Hooker’s expanded responsibility"}],["$","strong",null,{"children":"A semi-independent two-corps wing"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],"$L23","$undefined","$L24",false,"$L25","$L26","$L27","$L28","$L29"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","small",null,{"children":"McClellan expected Hooker to coordinate I Corps and Mansfield’s XII Corps on the northern battlefield, but Hooker planned his own corps attack before sending Mansfield a general order to support it."}]
f:["$","div","Coordination failure",{"children":[["$","span",null,{"children":"Coordination failure"}],["$","strong",null,{"children":"I Corps was engaged before XII Corps received useful direction"}],["$","small",null,{"children":"Mansfield had commanded XII Corps for only two days. The episode says his roughly 10,000 troops required an hour or more to assemble and enter the fight."}]]}]
10:["$","div","Confederate opening force",{"children":[["$","span",null,{"children":"Confederate opening force"}],["$","strong",null,{"children":"About 7,700 men under Jackson in the episode’s estimate"}],["$","small",null,{"children":"The force included most of Alexander Lawton’s and John R. Jones’s divisions, with John Bell Hood’s two brigades initially in reserve."}]]}]
11:["$","div","Confederate front",{"children":[["$","span",null,{"children":"Confederate front"}],["$","strong",null,{"children":"About three-quarters of a mile facing north"}],["$","small",null,{"children":"Lawton’s division covered the ground south of the Cornfield and across the Smoketown Road toward the Mumma farm; Jones’s division occupied the West Woods sector north of the Dunker Church."}]]}]
12:["$","div","Mumma farmhouse",{"children":[["$","span",null,{"children":"Mumma farmhouse"}],["$","strong",null,{"children":"Burned by Confederate troops before the main attack"}],["$","small",null,{"children":"The Confederates destroyed the house so United States sharpshooters could not use it as a strongpoint. Its smoke became a conspicuous landmark over the eastern battlefield."}]]}]
13:["$","div","Dunker Church artillery",{"children":[["$","span",null,{"children":"Dunker Church artillery"}],["$","strong",null,{"children":"Four batteries under Col. Stephen D. Lee"}],["$","small",null,{"children":"Lee’s artillery battalion occupied the open plateau east of the church and fired north and northeast into the approaches used by I Corps."}]]}]
14:["$","div","Nicodemus Heights",{"children":[["$","span",null,{"children":"Nicodemus Heights"}],["$","strong",null,{"children":"Fourteen guns under Stuart and Pelham in the episode’s account"}],["$","small",null,{"children":"The high ground west of the Hagerstown Turnpike allowed Confederate artillery to strike the right flank of the Federal advance. Early’s brigade protected the position."}]]}]
15:["$","div","Opening fire",{"children":[["$","span",null,{"children":"Opening fire"}],["$","strong",null,{"children":"Artillery engaged soon after 5 a.m."}],["$","small",null,{"children":"A. W. Garber later claimed the opening shot for his battery on Nicodemus Heights. The episode treats that claim cautiously and describes Confederate and Federal batteries opening as visibility improved."}]]}]
16:["$","div","East Woods renewal",{"children":[["$","span",null,{"children":"East Woods renewal"}],["$","strong",null,{"children":"Seymour’s Pennsylvania Reserves advanced at first light"}],["$","small",null,{"children":"Three regiments pushed to the southern edge of the woods and fired on James A. Walker’s Confederates along the Mumma farm, renewing the fight that darkness had interrupted."}]]}]
17:["$","div","Ricketts’s lead brigade",{"children":[["$","span",null,{"children":"Ricketts’s lead brigade"}],["$","strong",null,{"children":"About 1,100 men under Abram Duryea"}],["$","small",null,{"children":"Duryea’s New York and Pennsylvania regiments entered the head-high corn at about 6 a.m. without the close support Ricketts intended."}]]}]
18:["$","div","Confederate first line",{"children":[["$","span",null,{"children":"Confederate first line"}],["$","strong",null,{"children":"Douglass’s Georgians south of the Cornfield"}],["$","small",null,{"children":"Marcellus Douglass ordered his men to lie down in the rolling pasture and wait. They rose and fired when Duryea’s troops emerged from the southern edge of the corn."}]]}]
19:["$","div","Converging Confederate fire",{"children":[["$","span",null,{"children":"Converging Confederate fire"}],["$","strong",null,{"children":"Douglass in front and Walker from the east"}],["$","small",null,{"children":"Walker shifted part of Trimble’s brigade across the Smoketown Road to a rocky ledge. The episode says only about 40 of the 12th Georgia’s 100 men remained unhurt after the exchange."}]]}]
1a:["$","div","Ricketts’s broken sequence",{"children":[["$","span",null,{"children":"Ricketts’s broken sequence"}],["$","strong",null,{"children":"Three brigades attacked piecemeal"}],["$","small",null,{"children":"George Hartsuff’s brigade was delayed after Hartsuff was wounded by a shell fragment, while William Christian abandoned command of the other supporting brigade. Richard Coulter and Peter Lyle brought those formations forward separately."}]]}]
1b:["$","div","Duryea’s loss",{"children":[["$","span",null,{"children":"Duryea’s loss"}],["$","strong",null,{"children":"Nearly one-third of the brigade in about 30 minutes"}],["$","small",null,{"children":"Low ammunition and mounting pressure forced Duryea back through the Cornfield. The brigade withdrew in order but did not fight again that day."}]]}]
1c:["$","div","Hays’s counterattack",{"children":[["$","span",null,{"children":"Hays’s counterattack"}],["$","strong",null,{"children":"Louisiana troops struck Coulter’s brigade near the Cornfield"}],["$","small",null,{"children":"The Louisiana brigade and parts of Douglass’s brigade drove the Federals toward the corn and East Woods before artillery and infantry fire forced the Confederates back."}]]}]
1d:["$","div","12th Massachusetts",{"children":[["$","span",null,{"children":"12th Massachusetts"}],["$","strong",null,{"children":"224 killed or wounded of 334 engaged, about 67 percent"}],["$","small",null,{"children":"The National Park Service identifies this as the highest percentage loss of any United States regiment at Antietam. The episode describes only 32 men initially remaining with the colors when the regiment withdrew."}]]}]
1e:["$","div","Louisiana brigade",{"children":[["$","span",null,{"children":"Louisiana brigade"}],["$","strong",null,{"children":"323 casualties among about 550 men, about 59 percent"}],["$","small",null,{"children":"The episode rounds the brigade’s loss to 61 percent. National Park Service figures list 323 men shot down and every regimental commander hit during about 30 minutes of fighting."}]]}]
1f:["$","div","Immediate outcome",{"children":[["$","span",null,{"children":"Immediate outcome"}],["$","strong",null,{"children":"A stalemate in the eastern Cornfield and East Woods"}],["$","small",null,{"children":"By about 7 a.m. Ricketts’s division and Lawton’s front-line brigades were badly damaged. Stephen D. Lee’s guns had helped disrupt the Federal advance, and neither side had secured a decisive advantage in this sector."}]]}]
20:["$","div","Senior leader casualties in scope",{"children":[["$","span",null,{"children":"Senior leader casualties in scope"}],["$","strong",null,{"children":"Col. Marcellus Douglass killed; Brig. Gen. George L. Hartsuff wounded"}],["$","small",null,{"children":"Douglass was killed while commanding Lawton’s brigade south of the Cornfield. Hartsuff’s wound delayed his brigade until Col. Richard Coulter assumed command."}]]}]
21:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The Bloodiest Day: The Battle of Antietam” by Ronald H. Bailey"}],["$","small",null,{"children":"The volume belongs to the illustrated Time-Life Civil War series and was recommended as an accessible introduction, especially for younger or newer readers."}]]}]
22:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Ewell, Poffenberger, Mumma, Hartsuff, Hays, Douglass, Dunker Church, J. E. B. Stuart, A. W. Garber, and John Carroll Delaney"}],["$","small",null,{"children":"The automated transcript produces phonetic forms including “Yule,” “Poffenberg,” “Mama,” “Hartseff,” “Hayes,” “Douglas,” “Dunkirk Church,” “Jeb Stewart,” “A. W. Gerber,” and “John Delancey.” This guide uses the standard historical spellings."}]]}]
23:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
24:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The northern battlefield at daybreak",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep191-daybreak-deployment.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The northern battlefield at daybreak at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep191-daybreak-deployment.svg","alt":"Schematic map of the northern Antietam battlefield at daybreak, showing Hooker’s First Corps north of Miller’s Cornfield, Confederate infantry south of the Cornfield and in the West Woods, and artillery on Nicodemus Heights and by the Dunker Church.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The northern battlefield at daybreak"}],["$","span",null,{"children":"Hooker arranged I Corps with Doubleday on the right, Ricketts on the left, and most of Meade’s division in support; Seymour already occupied part of the East Woods. Across the front, Jackson placed Jones near the West Woods and Lawton south and east of the Cornfield, with Hood in reserve. Confederate batteries held the Dunker Church plateau and Nicodemus Heights. Positions and terrain are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep191-daybreak-deployment.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield Cornfield Trail, U.S. Army Center of Military History staff ride guide, Official Records, Antietam Battlefield Board atlas, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Ricketts’s piecemeal attack, about 6–7 a.m.",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep191-ricketts-attack.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Ricketts’s piecemeal attack, about 6–7 a.m. at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep191-ricketts-attack.svg","alt":"Schematic tactical map showing Duryea, Coulter, and Lyle advancing separately through the Cornfield and East Woods while Douglass and Walker fire from the south and east and Hays counterattacks north.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Ricketts’s piecemeal attack, about 6–7 a.m."}],["$","span",null,{"children":"Duryea advanced through the Cornfield first and met Douglass’s Georgians at its southern edge. Walker shifted west from the Mumma farm to add converging fire. Hartsuff’s brigade, led forward by Coulter after Hartsuff was wounded, and Christian’s brigade, reorganized under Lyle, arrived separately. Hays’s Louisiana brigade counterattacked into the eastern Cornfield. Movements are generalized and compressed. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep191-ricketts-attack.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ","$L2a"]}],"$L2b"]}],"$undefined"]}]]}],"$L2c"]}]]}]
25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Directed Hooker’s I Corps to attack the Confederate left and sent Mansfield’s XII Corps to support it"}]]}],["$","div","I Corps and northern wing-Maj. Gen. Joseph Hooker",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps and northern wing"}],["$","span",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","small",null,{"children":"Selected the Dunker Church plateau as the objective and ordered his three divisions forward at daybreak"}]]}],["$","div","1st Division, I Corps-Brig. Gen. Abner Doubleday",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, I Corps"}],["$","span",null,{"children":"Brig. Gen. Abner Doubleday"}],["$","small",null,{"children":"Advanced on the corps right along the Hagerstown Turnpike; John Gibbon’s brigade led the movement discussed next episode"}]]}],["$","div","2nd Division, I Corps-Brig. Gen. James B. Ricketts",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, I Corps"}],["$","span",null,{"children":"Brig. Gen. James B. Ricketts"}],["$","small",null,{"children":"Sent Duryea, Hartsuff, and Christian forward through the Cornfield and East Woods, but the brigades entered separately"}]]}],["$","div","1st Brigade, Ricketts’s division-Brig. Gen. Abram Duryea",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Ricketts’s division"}],["$","span",null,{"children":"Brig. Gen. Abram Duryea"}],["$","small",null,{"children":"Led the first major Federal infantry advance through the Cornfield and withdrew after severe losses and low ammunition"}]]}],["$","div","3rd Brigade, Ricketts’s division-Brig. Gen. George L. Hartsuff / Col. Richard Coulter",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Brigade, Ricketts’s division"}],["$","span",null,{"children":"Brig. Gen. George L. Hartsuff / Col. Richard Coulter"}],["$","small",null,{"children":"Coulter assumed command after a shell fragment wounded Hartsuff and brought the delayed brigade into the fight"}]]}],["$","div","2nd Brigade, Ricketts’s division-Col. William A. Christian / Col. Peter Lyle",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade, Ricketts’s division"}],["$","span",null,{"children":"Col. William A. Christian / Col. Peter Lyle"}],["$","small",null,{"children":"Lyle took command after Christian fled and finally advanced through the East Woods at about 7 a.m."}]]}],["$","div","3rd Division, I Corps, Pennsylvania Reserves-Brig. Gen. George G. Meade",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division, I Corps, Pennsylvania Reserves"}],"$L2d","$L2e"]}],"$L2f"]]}],"$L30"]}],"$L31"]]]}]
26:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. Marcellus Douglass",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Marcellus Douglass"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of Lawton’s brigade, Ewell’s division","."]}]," ","Killed while directing his Georgians in the fighting south of the Cornfield; the National Park Service account says rifle fire wounded him before an artillery shell killed him."]}]]}],["$","article","Brig. Gen. George L. Hartsuff",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brig. Gen. George L. Hartsuff"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of 3rd Brigade, Ricketts’s division, I Corps","."]}]," ","Wounded by a shell fragment before his brigade entered the main fight; Col. Richard Coulter assumed command and led it forward."]}]]}]]}]]}]
