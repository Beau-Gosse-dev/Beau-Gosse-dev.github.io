22:["$","div","3rd Division, I Corps, Pennsylvania Reserves-Brig. Gen. George G. Meade",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division, I Corps, Pennsylvania Reserves"}],["$","span",null,{"children":"Brig. Gen. George G. Meade"}],["$","small",null,{"children":"Supported the center while Truman Seymour’s brigade renewed the fight from its overnight position in the East Woods"}]]}]
