30:["$","div","Nicodemus Heights threatens Hooker’s flank",{"className":"moment","children":[["$","$L2e",null,{"seconds":1157,"label":"19:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nicodemus Heights threatens Hooker’s flank"}],["$","p",null,{"children":"Stuart and Pelham place 14 guns on the commanding ridge, supported by Early’s infantry brigade."}]]}]]}]
