3c:["$","div","Douglass is killed",{"className":"moment","children":[["$","$L2e",null,{"seconds":1991,"label":"33:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Douglass is killed"}],["$","p",null,{"children":"The Confederate colonel falls while every regimental commander in Hays’s brigade is also down."}]]}]]}]
3d:["$","div","Lyle’s brigade finally enters",{"className":"moment","children":[["$","$L2e",null,{"seconds":2020,"label":"33:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lyle’s brigade finally enters"}],["$","p",null,{"children":"At about 7 a.m., Peter Lyle leads Christian’s former brigade through the East Woods and relieves Coulter’s shattered formations."}]]}]]}]
