f:["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","United States opening force",{"children":[["$","th",null,{"scope":"row","children":"United States opening force"}],["$","td",null,{"children":["About 8,600 men in I Corps in the episode’s estimate",["$","small",null,{"style":{"display":"block"},"children":"Hooker’s three divisions opened the northern attack before Mansfield’s XII Corps could provide effective support."}]]}]]}],["$","tr","Confederate opening force",{"children":[["$","th",null,{"scope":"row","children":"Confederate opening force"}],["$","td",null,{"children":["About 7,700 men under Jackson in the episode’s estimate",["$","small",null,{"style":{"display":"block"},"children":"The force included most of Alexander Lawton’s and John R. Jones’s divisions, with John Bell Hood’s two brigades initially in reserve."}]]}]]}],["$","tr","Ricketts’s lead brigade",{"children":[["$","th",null,{"scope":"row","children":"Ricketts’s lead brigade"}],["$","td",null,{"children":["About 1,100 men under Abram Duryea",["$","small",null,{"style":{"display":"block"},"children":"Duryea’s New York and Pennsylvania regiments entered the head-high corn at about 6 a.m. without the close support Ricketts intended."}]]}]]}],["$","tr","12th Massachusetts",{"children":[["$","th",null,{"scope":"row","children":"12th Massachusetts"}],["$","td",null,{"children":["224 killed or wounded of 334 engaged, about 67 percent",["$","small",null,{"style":{"display":"block"},"children":"The National Park Service identifies this as the highest percentage loss of any United States regiment at Antietam. The episode describes only 32 men initially remaining with the colors when the regiment withdrew."}]]}]]}],["$","tr","Louisiana brigade",{"children":[["$","th",null,{"scope":"row","children":"Louisiana brigade"}],["$","td",null,{"children":["323 casualties among about 550 men, about 59 percent",["$","small",null,{"style":{"display":"block"},"children":"The episode rounds the brigade’s loss to 61 percent. National Park Service figures list 323 men shot down and every regimental commander hit during about 30 minutes of fighting."}]]}]]}]]}]]}]
10:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2017/04/16/civil-war-podcast-episode-191/",{"href":"https://civilwarpodcast.org/2017/04/16/civil-war-podcast-episode-191/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 191 page"]}],["$","a","https://home.nps.gov/anti/planyourvisit/cornfield-trail-guide.htm",{"href":"https://home.nps.gov/anti/planyourvisit/cornfield-trail-guide.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Cornfield Trail introduction and map"]}],["$","a","https://home.nps.gov/anti/planyourvisit/cornfield-trail-guide-stop-1.htm",{"href":"https://home.nps.gov/anti/planyourvisit/cornfield-trail-guide-stop-1.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Cornfield action timeline"]}],["$","a","https://home.nps.gov/anti/planyourvisit/cornfield-trail-guide-stop-2.htm",{"href":"https://home.nps.gov/anti/planyourvisit/cornfield-trail-guide-stop-2.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Confederate battle line and Douglass"]}],["$","a","https://home.nps.gov/anti/planyourvisit/cornfield-trail-guide-stop-3.htm",{"href":"https://home.nps.gov/anti/planyourvisit/cornfield-trail-guide-stop-3.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Confederate counterattacks and Hays’s losses"]}],["$","a","https://www.nps.gov/places/the-east-woods.htm",{"href":"https://www.nps.gov/places/the-east-woods.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: East Woods"]}],["$","a","https://home.nps.gov/anti/planyourvisit/cornfield-trail-guide-stop-6.htm",{"href":"https://home.nps.gov/anti/planyourvisit/cornfield-trail-guide-stop-6.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: 12th Massachusetts at the Cornfield"]}],["$","a","https://www.nps.gov/anti/learn/historyculture/casualties.htm",{"href":"https://www.nps.gov/anti/learn/historyculture/casualties.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: casualties by battlefield sector"]}],["$","a","https://home.nps.gov/anti/learn/historyculture/6generals.htm",{"href":"https://home.nps.gov/anti/learn/historyculture/6generals.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: generals killed and wounded"]}],["$","a","https://history.army.mil/Portals/143/Images/Publications/Staff%20Rides/PNG/cmhPub_35-3-1.pdf",{"href":"https://history.army.mil/Portals/143/Images/Publications/Staff%20Rides/PNG/cmhPub_35-3-1.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Antietam staff ride guide"]}],["$","a","https://ehistory.osu.edu/books/official-records/027",{"href":"https://ehistory.osu.edu/books/official-records/027","target":"_blank","rel":"noreferrer","children":[" · ","Official Records, Series I, Volume XIX, Part I"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=49",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=49","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: James B. Ricketts’s official report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=179",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=179","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: James A. Walker’s official report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=180",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=180","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Harry T. Hays’s official report"]}],"$L1a","$L1b","$L1c","$L1d","$L1e"]}]
