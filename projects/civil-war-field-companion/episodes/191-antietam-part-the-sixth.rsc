3a:["$","div","The 12th Massachusetts is devastated",{"className":"moment","children":[["$","$L2e",null,{"seconds":1935,"label":"32:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 12th Massachusetts is devastated"}],["$","p",null,{"children":"The episode counts 224 casualties and a 67 percent loss rate after the regiment’s fight against Hays and Douglass."}]]}]]}]
