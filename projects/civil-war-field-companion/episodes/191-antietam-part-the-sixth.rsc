33:["$","div","Ricketts and Doubleday form for attack",{"className":"moment","children":[["$","$L2e",null,{"seconds":1405,"label":"23:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ricketts and Doubleday form for attack"}],["$","p",null,{"children":"Duryea leads Ricketts’s left-wing advance while Gibbon’s brigade spearheads Doubleday’s movement on the right."}]]}]]}]
