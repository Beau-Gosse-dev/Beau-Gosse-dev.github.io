24:["$","section","Confederacy",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Held the army’s left at Sharpsburg under Jackson and accepted battle against the larger Army of the Potomac"}]]}],["$","div","Confederate left wing-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate left wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Controlled the northern defense, including Ewell’s and Jackson’s divisions, Hood’s reserve, and Stuart on the flank"}]]}],["$","div","Ewell’s division-Brig. Gen. Alexander R. Lawton",{"className":"command-entry","children":[["$","strong",null,{"children":"Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Alexander R. Lawton"}],["$","small",null,{"children":"Deployed the brigades of Lawton, Trimble, Hays, and Early across the eastern front and in reserve"}]]}],["$","div","Jackson’s division-Brig. Gen. John R. Jones",{"className":"command-entry","children":[["$","strong",null,{"children":"Jackson’s division"}],["$","span",null,{"children":"Brig. Gen. John R. Jones"}],["$","small",null,{"children":"Held the West Woods sector north of the Dunker Church at the beginning of the battle"}]]}],["$","div","Lawton’s brigade-Col. Marcellus Douglass",{"className":"command-entry","children":[["$","strong",null,{"children":"Lawton’s brigade"}],["$","span",null,{"children":"Col. Marcellus Douglass"}],["$","small",null,{"children":"Commanded the Georgians south of the Cornfield and was killed during the fight against Ricketts’s division"}]]}],["$","div","Trimble’s brigade-Col. James A. Walker",{"className":"command-entry","children":[["$","strong",null,{"children":"Trimble’s brigade"}],["$","span",null,{"children":"Col. James A. Walker"}],["$","small",null,{"children":"Defended the Mumma farm line and shifted part of the brigade west to fire into Duryea’s flank"}]]}],["$","div","Louisiana brigade-Brig. Gen. Harry T. Hays",{"className":"command-entry","children":[["$","strong",null,{"children":"Louisiana brigade"}],["$","span",null,{"children":"Brig. Gen. Harry T. Hays"}],["$","small",null,{"children":"Counterattacked toward the eastern Cornfield and suffered the loss of every regimental commander"}]]}],["$","div","Hood’s division-Brig. Gen. John Bell Hood",{"className":"command-entry","children":[["$","strong",null,{"children":"Hood’s division"}],["$","span",null,{"children":"Brig. Gen. John Bell Hood"}],["$","small",null,{"children":"Waited in the West Woods reserve after his exhausted brigades withdrew from the night picket line"}]]}],["$","div","Artillery battalion-Col. Stephen D. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Artillery battalion"}],["$","span",null,{"children":"Col. Stephen D. Lee"}],["$","small",null,{"children":"Massed four batteries on the plateau east of the Dunker Church and fired into the Federal approach"}]]}],["$","div","Cavalry and horse artillery on Nicodemus Heights-Brig. Gen. J. E. B. Stuart / Capt. John Pelham",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry and horse artillery on Nicodemus Heights"}],["$","span",null,{"children":"Brig. Gen. J. E. B. Stuart / Capt. John Pelham"}],["$","small",null,{"children":"Placed flank fire on Hooker’s advance; Jubal Early’s infantry brigade protected the commanding ridge"}]]}]]]}]
