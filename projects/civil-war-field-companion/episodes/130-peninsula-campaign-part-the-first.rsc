ode=va009","target":"_blank","rel":"noreferrer","children":["National Park Service: Yorktown battle summary"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/york/learn/historyculture/unionunits01.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/york/learn/historyculture/unionunits01.htm","target":"_blank","rel":"noreferrer","children":["National Park Service: Union units at Yorktown, compiled from the Official Records"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/99446374/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/99446374/","target":"_blank","rel":"noreferrer","children":["Library of Congress: The siege of Yorktown, April 1862"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/gvhs01.vhs00210/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/gvhs01.vhs00210/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Robert Knox Sneden map of the April 16 assault at Lee’s Mill"," ","$L38"]}]}],"$L39","$L3a","$L3b"]}]]}]
