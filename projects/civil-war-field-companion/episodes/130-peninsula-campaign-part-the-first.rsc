20:["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep130-siege-of-yorktown-1862.jpg","alt":"Contemporary 1862 bird’s-eye map of the United States siege of Yorktown","width":1600,"height":1200,"loading":"lazy"}]
21:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Contemporary view of the Yorktown siege"}],["$","span",null,{"children":"Charles Worret’s 1862 bird’s-eye map identifies United States batteries, camps, headquarters, naval positions, and the Confederate defenses at Yorktown. It is a contemporary pictorial view rather than a survey-accurate operational map."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep130-siege-of-yorktown-1862.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99446374/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
23:["$","$L22",null,{"seconds":840,"label":"14:00"}]
24:["$","div",null,{"children":[["$","h3",null,{"children":"The Peninsula’s geography defines the campaign"}],["$","p",null,{"children":"Fort Monroe stood at the southeastern end of the land between the navigable York River on the north and James River on the south. Richmond lay northwest up the Peninsula."}]]}]
25:["$","div","CSS Virginia limits naval support",{"className":"moment","children":[["$","$L22",null,{"seconds":875,"label":"14:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"CSS Virginia limits naval support"}],["$","p",null,{"children":"Although USS Monitor had fought Virginia to a draw in Hampton Roads, the Confederate ironclad still threatened another sortie. The Navy would not guarantee the James River flank while Virginia remained at Norfolk."}]]}]]}]
26:["$","div","McClellan intends to establish a base at West Point",{"className":"moment","children":[["$","$L22",null,{"seconds":935,"label":"15:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan intends to establish a base at West Point"}],["$","p",null,{"children":"The plan called for a rapid advance past Yorktown to West Point at the head of the York River, where the army could use both water transport and the railroad toward Richmond."}]]}]]}]
27:["$","div","Magruder has prepared a cross-Peninsula defense",{"className":"moment","children":[["$","$L22",null,{"seconds":965,"label":"16:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Magruder has prepared a cross-Peninsula defense"}],["$","p",null,{"children":"About 11,000 Confederates initially defended works anchored at Yorktown and extending along the Warwick River. Dams flooded low ground, and artillery and infantry covered the limited crossings."}]]}]]}]
28:["$","div","Two United States columns advance on April 4",{"className":"moment","children":[["$","$L22",null,{"seconds":1056,"label":"17:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two United States columns advance on April 4"}],["$","p",null,{"children":"Heintzelman’s III Corps moved toward Yorktown. Keyes’s IV Corps took the left-hand route intended to pass south of Yorktown and turn the Confederate position."}]]}]]}]
29:["$","div","Maps and roads fail the advance",{"className":"moment","children":[["$","$L22",null,{"seconds":1100,"label":"18:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Maps and roads fail the advance"}],["$","p",null,{"children":"Existing maps did not adequately show the streams and swamps, while heavy rain turned sandy roads into mud that impeded wagons and artillery."}]]}]]}]
2a:["$","div","III Corps reaches the Yorktown defenses",{"className":"moment","children":[["$","$L22",null,{"seconds":1128,"label":"18:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"III Corps reaches the Yorktown defenses"}],["$","p",null,{"children":"On the afternoon of April 5, Heintzelman’s column approached Yorktown and received artillery and musket fire. McClellan expected Keyes to outflank this position from the south."}]]}]]}]
2b:["$","div","The Warwick River blocks IV Corps",{"className":"moment","children":[["$","$L22",null,{"seconds":1150,"label":"19:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Warwick River blocks IV Corps"}],["$","p",null,{"children":"Keyes found that the Warwick cut across his route rather than running parallel to it as the maps indicated. Confederate dams widened the obstacle, and defended crossings prevented a quick passage near Lee’s Mill."}]]}]]}]
2c:["$","div","McClellan chooses a siege",{"className":"moment","children":[["$","$L22",null,{"seconds":1213,"label":"20:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan chooses a siege"}],["$","p",null,{"children":"After Keyes reported that an assault would cause very heavy losses, McClellan abandoned the rapid breakthrough on which his operational timetable depended and ordered siege preparations."}]]}]]}]
2d:["$","div","McDowell’s I Corps is withheld",{"className":"moment","children":[["$","$L22",null,{"seconds":1232,"label":"20:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"McDowell’s I Corps is withheld"}],["$","p",null,{"children":"McClellan learned that I Corps would remain near Washington rather than join him on the Peninsula. He treated the decision as a deliberate effort to damage the campaign, although the episode notes that he still had a large numerical advantage on April 5."}]]}]]}]
2e:["$","div","Magruder uses demonstrations to exaggerate his strength",{"className":"moment","children":[["$","$L22",null,{"seconds":1352,"label":"22:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Magruder uses demonstrations to exaggerate his strength"}],["$","p",null,{"children":"Bands, artillery, and repeated troop movements in exposed areas created the appearance of continuous reinforcements. The displays reinforced McClellan’s tendency to overestimate the defenders."}]]}]]}]
2f:["$","div","McClellan reports a possible 100,000 Confederates",{"className":"moment","children":[["$","$L22",null,{"seconds":1396,"label":"23:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan reports a possible 100,000 Confederates"}],["$","p",null,{"children":"On April 7 he told Lincoln that the enemy might number at least 100,000. Lincoln questioned the estimate and continued to urge an attack."}]]}]]}]
30:["$","div","The April 16 crossing at Dam No. 1 is not reinforced",{"className":"moment","children":[["$","$L22",null,{"seconds":1445,"label":"24:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"The April 16 crossing at Dam No. 1 is not reinforced"}],["$","p",null,{"children":"Vermont troops crossed the flooded Warwick and briefly gained part of the Confederate position. Without sufficient reinforcement, they were driven back by a counterattack."}]]}]]}]
31:["$","div","Johnston concentrates the main Confederate army",{"className":"moment","children":[["$","$L22",null,{"seconds":1502,"label":"25:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston concentrates the main Confederate army"}],["$","p",null,{"children":"By mid-April, Joseph E. Johnston had assumed overall command on the Peninsula and reinforcements joined Magruder. The episode dates Johnston’s arrival to April 17; the National Park Service dates the consolidation of Magruder’s force under Johnston to April 12."}]]}]]}]
32:["$","div","The siege train nears readiness",{"className":"moment","children":[["$","$L22",null,{"seconds":1524,"label":"25:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The siege train nears readiness"}],["$","p",null,{"children":"By May 3 the Army of the Potomac had prepared heavy guns and mortars intended to overwhelm the Yorktown defenses. Johnston concluded that the position could not withstand the bombardment."}]]}]]}]
33:["$","div","The Confederates evacuate Yorktown",{"className":"moment","children":[["$","$L22",null,{"seconds":1552,"label":"25:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederates evacuate Yorktown"}],["$","p",null,{"children":"During the night of May 3–4, Johnston’s army left the Warwick line and retreated toward Williamsburg under cover of its own artillery fire."}]]}]]}]
34:["$","div","Yorktown falls, but the delay changes the campaign",{"className":"moment","children":[["$","$L22",null,{"seconds":1577,"label":"26:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Yorktown falls, but the delay changes the campaign"}],["$","p",null,{"children":"United States forces gained the position without the planned bombardment. The delay allowed Johnston to transfer the main Confederate army from northern Virginia to the route between McClellan and Richmond."}]]}]]}]
35:["$","div","Army of the Peninsula; later right wing under Johnston",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Peninsula; later right wing under Johnston"}],["$","span",null,{"children":"John B. Magruder"}],["$","small",null,{"children":"Built and defended the Yorktown–Warwick position, used demonstrations to conceal his initial weakness, and continued as a wing commander after Johnston assumed overall command"}]]}]
36:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
37:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","George B. McClellan",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep130-george-mcclellan-1861.jpg","alt":"Portrait of George B. McClellan","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George B. McClellan"}],["$","p",null,{"children":"Moved the Army of the Potomac to Fort Monroe, halted at the Warwick line, and chose siege operations at Yorktown"}]]}]]}],["$","article","Abraham Lincoln",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Abraham Lincoln"}],["$","p",null,{"children":"Approved the Peninsula movement with conditions, retained forces for Washington, and urged McClellan to attack the Warwick line"}]]}]]}],["$","article","Edwin M. Stanton",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"EM"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Edwin M. Stanton"}],["$","p",null,{"children":"Administered the War Department and participated in the decision to withhold McDowell’s I Corps"}]]}]]}],["$","article","Samuel P. Heintzelman",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"SP"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Samuel P. Heintzelman"}],["$","p",null,{"children":"Commanded III Corps on the direct approach to Yorktown"}]]}]]}],["$","article","Erasmus D. Keyes",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"ED"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Erasmus D. Keyes"}],["$","p",null,{"children":"Commanded IV Corps on the intended flanking route and reported that the Warwick position could not be assaulted without heavy loss"}]]}]]}],["$","article","Fitz John Porter",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"FJ"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Fitz John Porter"}],["$","p",null,{"children":"Directed siege operations and participated in aerial observation of the Confederate position"}]]}]]}],["$","article","William F. Smith",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WF"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"William F. Smith"}],["$","p",null,{"children":"Commanded the IV Corps division whose Vermont Brigade crossed at Dam No. 1 on April 16"}]]}]]}],["$","article","Allan Pinkerton",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AP"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Allan Pinkerton"}],["$","p",null,{"children":"Directed McClellan’s intelligence service, whose inflated estimates reinforced the army commander’s assumptions about Confederate strength"}]]}]]}],["$","article","Joseph E. Johnston",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Joseph E. Johnston"}],["$","p",null,{"children":"Assumed overall Confederate command on the Peninsula, reinforced the Warwick line, and evacuated it before the siege bombardment"}]]}]]}],["$","article","John B. Magruder",{"className":"person-card","children":["$L3c","$L3d"]}],"$L3e"]}]
