1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",130," · ","March 17–May 4, 1862"," · ","Alexandria and Chesapeake Bay; Fort Monroe and Hampton Roads; the Virginia Peninsula between the York and James Rivers; Yorktown, the Warwick River line, Lee’s Mill, Dam No. 1, and the road toward Williamsburg"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN (Part the First)"}],["$","span",null,{"className":"result-label","children":"The Army of the Potomac completed its large water movement to Fort Monroe but did not make the rapid advance on Richmond that McClellan intended. Magruder’s smaller Confederate force used earthworks, flooded waterways, deception, and later reinforcements to stop the April 4–5 advance along the Warwick line. McClellan chose siege operations rather than an immediate general assault. Johnston reinforced the position, then evacuated Yorktown during the night of May 3–4 before the United States siege artillery opened. The Confederates surrendered the Yorktown position but gained nearly a month to concentrate between McClellan and Richmond; the National Park Service classifies the Yorktown result as indecisive"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1593215228.mp3?updated=1695211821","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Campaign opening",{"children":[["$","span",null,{"children":"Campaign opening"}],["$","strong",null,{"children":"First embarkations March 17; land advance April 4"}],["$","small",null,{"children":"McClellan left Alexandria on April 1 and reached Fort Monroe on April 2. The transcript correctly places his embarkation on April 2, although his official report dates his departure to April 1."}]]}],["$","div","Water route",{"children":[["$","span",null,{"children":"Water route"}],["$","strong",null,{"children":"About 200 miles from Alexandria to Fort Monroe"}],"$undefined"]}],["$","div","Transport fleet",{"children":[["$","span",null,{"children":"Transport fleet"}],["$","strong",null,{"children":"389 vessels"}],["$","small",null,{"children":"McClellan’s official report lists 113 steamers, 188 schooners, and 88 barges used during the movement."}]]}],["$","div","Army transported",{"children":[["$","span",null,{"children":"Army transported"}],["$","strong",null,{"children":"121,500 soldiers and 14,592 animals"}],["$","small",null,{"children":"McClellan also reported 1,224 wagons and ambulances, 44 artillery batteries, telegraph material, pontoon trains, and equipment. The episode rounds these quantities."}]]}],["$","div","Original operational objective",{"children":[["$","span",null,{"children":"Original operational objective"}],["$","strong",null,{"children":"West Point, then Richmond"}],["$","small",null,{"children":"McClellan intended to open a supply base at West Point, where the Richmond and York River Railroad met the navigable York River."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18"]}],"$L19","$L1a","$L1b","$L1c",false,"$L1d","$L1e","$L1f"]}]]}]
22:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","James River restriction",{"children":[["$","span",null,{"children":"James River restriction"}],["$","strong",null,{"children":"CSS Virginia remained an operational threat"}],["$","small",null,{"children":"The Navy could not guarantee use of the James River while the Confederate ironclad remained at Norfolk, so McClellan based his supply line on the York River side of the Peninsula."}]]}]
f:["$","div","Confederate force at the outset",{"children":[["$","span",null,{"children":"Confederate force at the outset"}],["$","strong",null,{"children":"About 11,000 under John B. Magruder"}],["$","small",null,{"children":"The National Park Service gives approximately 11,000 initially available for the line. The episode says 12,000 once and the automated transcript later misrenders the same figure as 1,200."}]]}]
10:["$","div","Warwick defense",{"children":[["$","span",null,{"children":"Warwick defense"}],["$","strong",null,{"children":"Earthworks, dams, flooded lowlands, and guarded crossings"}],["$","small",null,{"children":"The line was anchored at Yorktown and extended across the Peninsula by following the Warwick River toward the James."}]]}]
11:["$","div","United States force on April 5",{"children":[["$","span",null,{"children":"United States force on April 5"}],["$","strong",null,{"children":"About 58,000–60,000 in the advance"}],["$","small",null,{"children":"The episode uses both figures: about 60,000 had landed when the advance began, and about 58,000 faced the Yorktown–Warwick line after contact."}]]}]
12:["$","div","McClellan’s initial enemy estimate",{"children":[["$","span",null,{"children":"McClellan’s initial enemy estimate"}],["$","strong",null,{"children":"About 15,000 near Yorktown"}],["$","small",null,{"children":"After the advance stopped, Magruder’s demonstrations and faulty intelligence contributed to much larger estimates. McClellan told Lincoln on April 7 that he might face at least 100,000."}]]}]
13:["$","div","Dam No. 1 action",{"children":[["$","span",null,{"children":"Dam No. 1 action"}],["$","strong",null,{"children":"April 16, 1862"}],["$","small",null,{"children":"Troops from the Vermont Brigade crossed the Warwick and briefly entered the Confederate works before withdrawing under counterattack without sufficient reinforcement."}]]}]
14:["$","div","Casualty estimates",{"children":[["$","span",null,{"children":"Casualty estimates"}],["$","strong",null,{"children":"Scope-dependent"}],["$","small",null,{"children":"The National Park Service battle summary estimates 482 casualties across the Yorktown operations and describes about 309 casualties in the April 16 action. Different accounts separate the siege and Dam No. 1 losses differently."}]]}]
15:["$","div","Siege artillery",{"children":[["$","span",null,{"children":"Siege artillery"}],["$","strong",null,{"children":"101 siege guns and more than 40 siege mortars"}],["$","small",null,{"children":"These National Park Service figures describe the siege arsenal. The episode says 114 large siege pieces were nearly in place by May 3 and also mentions more than 300 field guns; totals differ by date and by whether mortars are counted with guns."}]]}]
16:["$","div","Planned bombardment",{"children":[["$","span",null,{"children":"Planned bombardment"}],["$","strong",null,{"children":"Early May, preempted by evacuation"}],["$","small",null,{"children":"The episode says May 5. The National Park Service battle summary says McClellan planned to begin at dawn on May 4. Johnston withdrew during the night of May 3–4, so the discrepancy did not affect the outcome."}]]}]
17:["$","div","Senior commanders killed or mortally wounded",{"children":[["$","span",null,{"children":"Senior commanders killed or mortally wounded"}],["$","strong",null,{"children":"None in the operations covered here"}],"$undefined"]}]
18:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"The Peninsula Campaign of 1862: A Military Analysis by Kevin Dougherty with J. Michael Moore"}],["$","small",null,{"children":"The automated transcript renders the first author’s surname as “Docherty.”"}]]}]
19:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
1a:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","From Alexandria to the Virginia Peninsula",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep130-peninsula-route.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From Alexandria to the Virginia Peninsula at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep130-peninsula-route.svg","alt":"Schematic map of the Army of the Potomac water movement from Alexandria to Fort Monroe and planned advance up the Virginia Peninsula toward Richmond","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From Alexandria to the Virginia Peninsula"}],["$","span",null,{"children":"The Army of the Potomac traveled by water from Alexandria to Fort Monroe, then planned to march northwest between the York and James Rivers through Yorktown and Williamsburg to a new base at West Point and onward to Richmond. CSS Virginia restricted naval support on the James. This schematic is not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep130-peninsula-route.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo72995/pdf/GOVPUB-D114-PURL-gpo72995.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The Warwick line and the halted advance",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep130-warwick-line.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The Warwick line and the halted advance at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep130-warwick-line.svg","alt":"Schematic map of the Confederate Warwick line, the United States Third and Fourth Corps advances, Dam Number 1, and the Confederate withdrawal toward Williamsburg","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Warwick line and the halted advance"}],["$","span",null,{"children":"Heintzelman’s III Corps moved toward Yorktown while Keyes’s IV Corps moved toward Lee’s Mill. The unexpected course and flooded crossings of the Warwick River blocked the intended flanking movement. The map also marks the April 16 crossing at Dam No. 1 and the Confederate withdrawal toward Williamsburg. Positions are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep130-warwick-line.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/york/learn/historyculture/yorktown-in-the-civil-war.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Contemporary view of the Yorktown siege",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep130-siege-of-yorktown-1862.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Contemporary view of the Yorktown siege at full size","children":"$L20"}]}],"$L21"]}]]}]]}]
1b:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode opens with the Army of the Potomac in motion",{"className":"moment","children":[["$","$L22",null,{"seconds":70,"label":"1:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode opens with the Army of the Potomac in motion"}],["$","p",null,{"children":"More than 100,000 soldiers were moving by transport down Chesapeake Bay to Fort Monroe, the United States-held base at the tip of the Virginia Peninsula."}]]}]]}],["$","div","Faulty intelligence magnifies Confederate strength",{"className":"moment","children":[["$","$L22",null,{"seconds":267,"label":"4:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Faulty intelligence magnifies Confederate strength"}],["$","p",null,{"children":"McClellan’s own assumptions and estimates supplied through Allan Pinkerton reinforced one another. The episode contrasts his claim of 150,000 Confederates near Manassas with an actual force of no more than about 42,000."}]]}]]}],["$","div","Political pressure shapes McClellan’s caution",{"className":"moment","children":[["$","$L22",null,{"seconds":375,"label":"6:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Political pressure shapes McClellan’s caution"}],["$","p",null,{"children":"The Joint Committee on the Conduct of the War demanded energetic operations and had Brigadier General Charles P. Stone imprisoned after Ball’s Bluff. McClellan treated the committee and Secretary Stanton as political enemies and became still more reluctant to risk defeat."}]]}]]}],["$","div","McClellan’s waterborne plan replaces a direct advance",{"className":"moment","children":[["$","$L22",null,{"seconds":480,"label":"8:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan’s waterborne plan replaces a direct advance"}],["$","p",null,{"children":"Rather than attack the Centreville–Manassas position from Washington, McClellan proposed moving by water and approaching Richmond from the east."}]]}]]}],["$","div","Johnston’s withdrawal invalidates Urbanna",{"className":"moment","children":[["$","$L22",null,{"seconds":526,"label":"8:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston’s withdrawal invalidates Urbanna"}],["$","p",null,{"children":"Johnston’s move to the Rappahannock placed his army close enough to contest a landing at Urbanna. McClellan retained the amphibious concept but changed the landing point to Fort Monroe."}]]}]]}],["$","div","Embarkation begins at Alexandria",{"className":"moment","children":[["$","$L22",null,{"seconds":580,"label":"9:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Embarkation begins at Alexandria"}],["$","p",null,{"children":"On March 17 the first Army of the Potomac units began the approximately 200-mile water journey to Fort Monroe aboard a fleet assembled for the earlier Urbanna plan."}]]}]]}],["$","div","McClellan addresses “my army”",{"className":"moment","children":[["$","$L22",null,{"seconds":674,"label":"11:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan addresses “my army”"}],["$","p",null,{"children":"McClellan used printed addresses and personal contact to reinforce his bond with the soldiers. Before the campaign he told them that the time for action had arrived and promised to seek success with the least possible loss."}]]}]]}],["$","div","The transport operation reaches full scale",{"className":"moment","children":[["$","$L22",null,{"seconds":802,"label":"13:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The transport operation reaches full scale"}],["$","p",null,{"children":"Over roughly three weeks, 389 vessels carried 121,500 soldiers, 14,592 animals, 1,224 wagons and ambulances, 44 artillery batteries, and the equipment required to sustain a field army."}]]}]]}],["$","div","The Peninsula’s geography defines the campaign",{"className":"moment","children":["$L23","$L24"]}],"$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34"]}]]}]
1c:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","President and constitutional commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and constitutional commander in chief"}],["$","span",null,{"children":"Abraham Lincoln"}],["$","small",null,{"children":"Approved the Peninsula movement subject to Washington’s security and pressed McClellan to act against the Yorktown–Warwick line"}]]}],["$","div","Secretary of War",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of War"}],["$","span",null,{"children":"Edwin M. Stanton"}],["$","small",null,{"children":"Directed War Department policy, transmitted orders, and joined Lincoln in withholding McDowell’s I Corps for the defense of Washington"}]]}],["$","div","Commander, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Army of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Directed the water movement, the April 4 advance, and the siege of Yorktown"}]]}],["$","div","III Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of the Potomac"}],["$","span",null,{"children":"Samuel P. Heintzelman"}],["$","small",null,{"children":"Led the right-hand column toward Yorktown; the corps included divisions under Charles S. Hamilton and Joseph Hooker during the opening advance"}]]}],["$","div","IV Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"IV Corps, Army of the Potomac"}],["$","span",null,{"children":"Erasmus D. Keyes"}],["$","small",null,{"children":"Led the left-hand column toward Lee’s Mill; divisions under Darius N. Couch and William F. Smith encountered the Warwick River defenses"}]]}],["$","div","Director of siege operations at Yorktown",{"className":"command-entry","children":[["$","strong",null,{"children":"Director of siege operations at Yorktown"}],["$","span",null,{"children":"Fitz John Porter"}],["$","small",null,{"children":"Supervised the construction and preparation of the United States siege works and heavy batteries"}]]}],["$","div","Division commander, IV Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander, IV Corps"}],["$","span",null,{"children":"William F. Smith"}],["$","small",null,{"children":"His division faced the Warwick near Dam No. 1; William T. H. Brooks’s Vermont Brigade made the April 16 crossing"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","President and commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander in chief"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Exercised national authority over the defense of Richmond and accepted Lee’s recommendation to reinforce the Peninsula"}]]}],["$","div","Military adviser to President Davis",{"className":"command-entry","children":[["$","strong",null,{"children":"Military adviser to President Davis"}],["$","span",null,{"children":"Robert E. Lee"}],["$","small",null,{"children":"Advocated reinforcing Magruder’s line rather than immediately abandoning the lower Peninsula defenses"}]]}],["$","div","Department and Army of Northern Virginia; overall command on the Peninsula by mid-April",{"className":"command-entry","children":[["$","strong",null,{"children":"Department and Army of Northern Virginia; overall command on the Peninsula by mid-April"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"Concentrated the principal Confederate field army behind the Warwick line and ordered the withdrawal toward Williamsburg"}]]}],"$L35"]]}]]}],"$L36","$L37"]}]
1d:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep130-siege-of-yorktown-1862.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep130-siege-of-yorktown-1862.jpg","alt":"Color bird’s-eye view of the United States siege of Yorktown in April 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Charles Worret’s contemporary view depicts United States batteries, camps, naval positions, and the Confederate works around Yorktown. Its value is documentary and visual; it is not a scale map."}]]}],["$","figure","/images/ep130-magruder-headquarters-yorktown.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep130-magruder-headquarters-yorktown.jpg","alt":"Stereographic photograph of John B. Magruder’s former headquarters at Yorktown","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"George N. Barnard photographed Magruder’s Yorktown headquarters in June 1862, after the Confederate evacuation. The Library of Congress identifies it as a site associated with the Peninsula Campaign."}]]}],["$","figure","/images/ep130-yorktown-confederate-fortification.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep130-yorktown-confederate-fortification.jpg","alt":"Large gun in a Confederate fortification at Yorktown photographed after the evacuation","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Barnard’s June 1862 photograph records one of the heavy guns and earthworks left at Yorktown. Johnston withdrew rather than expose the defenses to McClellan’s prepared siege artillery."}]]}],["$","figure","/images/ep130-george-mcclellan-1861.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep130-george-mcclellan-1861.jpg","alt":"Major General George B. McClellan standing in uniform in 1861","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"McClellan organized and moved the Army of the Potomac on an unprecedented scale, but his decision to besiege Yorktown forfeited the rapid timetable on which his campaign plan depended."}]]}]]}]]}]
