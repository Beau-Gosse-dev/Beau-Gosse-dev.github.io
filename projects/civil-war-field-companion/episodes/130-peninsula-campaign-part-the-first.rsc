24:["$","div","Department and Army of Northern Virginia; overall command on the Peninsula by mid-April-Joseph E. Johnston",{"className":"command-entry","children":[["$","strong",null,{"children":"Department and Army of Northern Virginia; overall command on the Peninsula by mid-April"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"Concentrated the principal Confederate field army behind the Warwick line and ordered the withdrawal toward Williamsburg"}]]}]
25:["$","div","Army of the Peninsula; later right wing under Johnston-John B. Magruder",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Peninsula; later right wing under Johnston"}],["$","span",null,{"children":"John B. Magruder"}],["$","small",null,{"children":"Built and defended the Yorktown–Warwick position, used demonstrations to conceal his initial weakness, and continued as a wing commander after Johnston assumed overall command"}]]}]
