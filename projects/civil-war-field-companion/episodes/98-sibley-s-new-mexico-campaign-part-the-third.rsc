12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Fort Craig remained in U.S. hands",{"className":"moment","children":[["$","$L17",null,{"seconds":66,"label":"1:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fort Craig remained in U.S. hands"}],["$","p",null,{"children":"The Confederate victory at Valverde did not capture the fort or its supplies. Canby still had a strong force behind the fortifications."}]]}]]}],["$","div","Sibley decided to continue north",{"className":"moment","children":[["$","$L17",null,{"seconds":168,"label":"2:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sibley decided to continue north"}],["$","p",null,{"children":"With only about five days of provisions and no way to assault or besiege Fort Craig, the Confederates chose to move toward Albuquerque and Santa Fe."}]]}]]}],["$","div","Canby stayed at Fort Craig",{"className":"moment","children":[["$","$L17",null,{"seconds":269,"label":"4:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canby stayed at Fort Craig"}],["$","p",null,{"children":"Canby kept a strong force astride the Confederate line of communications and protected the fort’s supplies instead of immediately pursuing Sibley."}]]}]]}],["$","div","Canby ordered the northern depots emptied",{"className":"moment","children":[["$","$L17",null,{"seconds":297,"label":"4:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canby ordered the northern depots emptied"}],["$","p",null,{"children":"Couriers told officers at Albuquerque and Santa Fe to move supplies to Fort Union and burn what they could not carry."}]]}]]}],["$","div","Pyron reached Albuquerque",{"className":"moment","children":[["$","$L17",null,{"seconds":354,"label":"5:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pyron reached Albuquerque"}],["$","p",null,{"children":"Charles Pyron took 200 men ahead of the main column. He entered Albuquerque on March 2, one day after U.S. troops removed or burned most federal stores."}]]}]]}],["$","div","U.S. troops evacuated Santa Fe",{"className":"moment","children":[["$","$L17",null,{"seconds":424,"label":"7:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops evacuated Santa Fe"}],["$","p",null,{"children":"The quartermaster loaded 120 wagons and moved the supplies, garrison, and territorial government toward Fort Union on March 4. Stores left behind were destroyed."}]]}]]}],["$","div","Confederates entered Santa Fe",{"className":"moment","children":[["$","$L17",null,{"seconds":496,"label":"8:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates entered Santa Fe"}],["$","p",null,{"children":"The advance entered on March 10. Pyron arrived three days later and raised the Confederate flag over the Palace of the Governors."}]]}]]}],["$","div","Scurry moved toward the Santa Fe Trail",{"className":"moment","children":[["$","$L17",null,{"seconds":525,"label":"8:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Scurry moved toward the Santa Fe Trail"}],["$","p",null,{"children":"The 4th Texas and part of the 7th Texas bypassed Santa Fe and moved northeast toward the road to Fort Union. Sibley and Green remained at Albuquerque."}]]}]]}],["$","div","Fort Union held the main federal supply depot",{"className":"moment","children":[["$","$L17",null,{"seconds":603,"label":"10:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fort Union held the main federal supply depot"}],["$","p",null,{"children":"The post stood where the Mountain and Cimarron branches of the Santa Fe Trail joined. Supplies reached it over a route of more than 700 miles from Missouri and Kansas."}]]}]]}],["$","div","Gabriel Paul prepared Fort Union",{"className":"moment","children":[["$","$L17",null,{"seconds":647,"label":"10:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gabriel Paul prepared Fort Union"}],["$","p",null,{"children":"Colonel Gabriel R. Paul assumed command of troops and depots outside Canby’s immediate control and received orders to hold Fort Union at any cost."}]]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}]]}]
