18:["$","div","Reinforcements started from California and Colorado",{"className":"moment","children":[["$","$L17",null,{"seconds":700,"label":"11:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Reinforcements started from California and Colorado"}],["$","p",null,{"children":"James H. Carleton organized a California column at Fort Yuma. The 1st Colorado Volunteers received orders to march south from Denver."}]]}]]}]
19:["$","div","The 1st Colorado began its march",{"className":"moment","children":[["$","$L17",null,{"seconds":934,"label":"15:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 1st Colorado began its march"}],["$","p",null,{"children":"John P. Slough’s regiment left Camp Weld on February 22 and covered more than 300 miles to Fort Union in 13 days."}]]}]]}]
1a:["$","div","The Coloradans made a forced march",{"className":"moment","children":[["$","$L17",null,{"seconds":1047,"label":"17:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Coloradans made a forced march"}],["$","p",null,{"children":"After learning that Albuquerque and Santa Fe had fallen, the regiment covered 92 miles in its final 36 hours and reached Fort Union on March 10."}]]}]]}]
1b:["$","div","Slough took command from Paul",{"className":"moment","children":[["$","$L17",null,{"seconds":1284,"label":"21:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Slough took command from Paul"}],["$","p",null,{"children":"Slough’s volunteer commission predated Paul’s colonelcy, making Slough the senior officer despite Paul’s greater regular-army experience."}]]}]]}]
1c:["$","div","Slough advanced from Fort Union",{"className":"moment","children":[["$","$L17",null,{"seconds":1377,"label":"22:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Slough advanced from Fort Union"}],["$","p",null,{"children":"Against Paul’s interpretation of Canby’s orders, Slough left a small garrison and marched about 1,350 Colorado, regular, and New Mexico troops west on March 22."}]]}]]}]
1d:["$","div","Pyron moved east with about 400 men",{"className":"moment","children":[["$","$L17",null,{"seconds":1445,"label":"24:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pyron moved east with about 400 men"}],["$","p",null,{"children":"Unaware that the Colorado regiment had reached Fort Union, Pyron expected to meet only part of the post’s old garrison."}]]}]]}]
1e:["$","div","Chivington entered Apache Canyon",{"className":"moment","children":[["$","$L17",null,{"seconds":1506,"label":"25:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Chivington entered Apache Canyon"}],["$","p",null,{"children":"On March 26, Chivington’s 418-man advance guard captured a Confederate scouting party and then encountered Pyron’s guns and mounted troops."}]]}]]}]
1f:["$","div","U.S. troops flanked the first Confederate position",{"className":"moment","children":[["$","$L17",null,{"seconds":1564,"label":"26:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops flanked the first Confederate position"}],["$","p",null,{"children":"Chivington sent infantry and dismounted cavalry onto the wooded slopes. Their fire forced Pyron to withdraw about a mile and a half."}]]}]]}]
20:["$","div","Pyron formed a second defensive line",{"className":"moment","children":[["$","$L17",null,{"seconds":1601,"label":"26:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pyron formed a second defensive line"}],["$","p",null,{"children":"The Confederates destroyed a log bridge, placed guns on the road, and put skirmishers on the slopes. Chivington again sent troops around both flanks."}]]}]]}]
21:["$","div","Colorado cavalry broke the second position",{"className":"moment","children":[["$","$L17",null,{"seconds":1632,"label":"27:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Colorado cavalry broke the second position"}],["$","p",null,{"children":"A mounted charge down the road reached the Confederate line. Pyron withdrew toward Johnson’s Ranch, and Chivington ended the pursuit near dark."}]]}]]}]
22:["$","div","Apache Canyon ended in a U.S. victory",{"className":"moment","children":[["$","$L17",null,{"seconds":1718,"label":"28:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Apache Canyon ended in a U.S. victory"}],["$","p",null,{"children":"The U.S. force captured about 70 Confederates. Both sides arranged a truce to recover casualties, and Chivington withdrew to Pigeon’s Ranch."}]]}]]}]
23:["$","div","Scurry reinforced Pyron",{"className":"moment","children":[["$","$L17",null,{"seconds":1755,"label":"29:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Scurry reinforced Pyron"}],["$","p",null,{"children":"William R. Scurry marched through the night with the 4th Texas and part of the 7th Texas, reached Johnson’s Ranch early on March 27, and took command of about 1,000 men."}]]}]]}]
24:["$","div","Both main forces prepared to fight",{"className":"moment","children":[["$","$L17",null,{"seconds":1795,"label":"29:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both main forces prepared to fight"}],["$","p",null,{"children":"Scurry left his wagon train at Johnson’s Ranch and advanced on March 28. Slough had joined Chivington at Kozlowski’s Ranch and planned to meet him in Glorieta Pass."}]]}]]}]
