e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The campaign area today"}],["$","span",null,{"children":"After Valverde, the Confederates moved north through Albuquerque and Santa Fe. Fort Union stood northeast of Santa Fe; Apache Canyon and Glorieta Pass were on the Santa Fe Trail between them."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
