13:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","J. E. B. Stuart",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"J. E. B. Stuart"}],["$","p",null,{"children":[["$","strong",null,{"children":["Cavalry Corps commander, Army of Northern Virginia","."]}]," ","Shot in the abdomen at Yellow Tavern on May 11 and died in Richmond at 7:38 p.m. on May 12"]}]]}],["$","article","Henry Clay Pate",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Henry Clay Pate"}],["$","p",null,{"children":[["$","strong",null,{"children":["Colonel, 5th Virginia Cavalry","."]}]," ","Killed during the first phase while Lomax’s brigade defended the Telegraph Road position"]}]]}]]}]]}]
14:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/yellow-tavern-tactical-map.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/yellow-tavern-tactical-map.svg","alt":"Schematic of the two phases of the Battle of Yellow Tavern","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The first U.S. attack forced Lomax back; the final attack broke the combined Confederate line and mortally wounded Stuart."}]]}],["$","figure","/images/jeb-stuart.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/jeb-stuart.jpg","alt":"Civil War portrait of J. E. B. Stuart in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Stuart reached Yellow Tavern ahead of Sheridan but had only about 3,000 exhausted cavalrymen immediately available."}]]}],["$","figure","/images/philip-sheridan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/philip-sheridan.jpg","alt":"Portrait of Philip H. Sheridan","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Sheridan used his numerical advantage to bring up three divisions for the 4 p.m. attack."}]]}],["$","figure","/images/jeb-stuart-grave.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/jeb-stuart-grave.jpg","alt":"Temporary marker at J. E. B. Stuart’s grave in Hollywood Cemetery","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Stuart died in Richmond on May 12 and was buried at Hollywood Cemetery."}]]}]]}]]}]
