19:["$","div",null,{"children":[["$","h3",null,{"children":"Ten thousand U.S. cavalrymen resumed the advance"}],["$","p",null,{"children":"Sheridan left John I. Gregg’s 2,000-man brigade to guard the rear while the main force rode south on May 11."}]]}]
1a:["$","div","Gordon attacked the U.S. rear guard",{"className":"moment","children":[["$","$L17",null,{"seconds":723,"label":"12:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gordon attacked the U.S. rear guard"}],["$","p",null,{"children":"Confederate cavalry crossed at a nearby ford and began a running fight. Henry Davies’s U.S. brigade also damaged the Richmond, Fredericksburg and Potomac Railroad near Ashland."}]]}]]}]
1b:["$","div","The opposing columns converged on Yellow Tavern",{"className":"moment","children":[["$","$L17",null,{"seconds":771,"label":"12:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The opposing columns converged on Yellow Tavern"}],["$","p",null,{"children":"Sheridan used Mountain Road while Stuart came down Telegraph Road. The roads met at an abandoned inn north of Richmond."}]]}]]}]
1c:["$","div","Lomax blocked the crossroads",{"className":"moment","children":[["$","$L17",null,{"seconds":806,"label":"13:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lomax blocked the crossroads"}],["$","p",null,{"children":"His brigade reached Yellow Tavern around 8 a.m. and formed along Telegraph Road. Stuart had arrived ahead of the U.S. column."}]]}]]}]
1d:["$","div","Wickham formed a second wing on the ridge",{"className":"moment","children":[["$","$L17",null,{"seconds":858,"label":"14:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wickham formed a second wing on the ridge"}],["$","p",null,{"children":"Lomax faced west near the junction while Wickham stood about half a mile north, facing south above Turner’s Run and positioned to fire into an advancing U.S. flank."}]]}]]}]
1e:["$","div","Stuart had about 3,000 troops immediately available",{"className":"moment","children":[["$","$L17",null,{"seconds":887,"label":"14:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart had about 3,000 troops immediately available"}],["$","p",null,{"children":"The odds were worse than three to one. Stuart expected the Richmond garrison to join the battle and help close Sheridan’s route of withdrawal."}]]}]]}]
1f:["$","div","Merritt opened the battle",{"className":"moment","children":[["$","$L17",null,{"seconds":953,"label":"15:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Merritt opened the battle"}],["$","p",null,{"children":"Wesley Merritt’s division dismounted, crossed a cornfield, and attacked with seven-shot Spencer carbines. The first assault captured about two hundred Confederates and drove Lomax north."}]]}]]}]
20:["$","div","U.S. scouts reached Richmond’s outer works",{"className":"moment","children":[["$","$L17",null,{"seconds":1014,"label":"16:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. scouts reached Richmond’s outer works"}],["$","p",null,{"children":"Two regiments found the works unmanned and heard alarm bells in the city. They saw no large force preparing to march against Sheridan."}]]}]]}]
21:["$","div","Stuart asked Richmond for an infantry attack",{"className":"moment","children":[["$","$L17",null,{"seconds":1139,"label":"18:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart asked Richmond for an infantry attack"}],["$","p",null,{"children":"Braxton Bragg reported that 4,000 reservists and government clerks held the city while three veteran brigades came from Petersburg. Stuart requested that Eppa Hunton’s brigade strike Sheridan’s flank."}]]}]]}]
22:["$","div","Sheridan attacked again at 4 p.m.",{"className":"moment","children":[["$","$L17",null,{"seconds":1209,"label":"20:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sheridan attacked again at 4 p.m."}],["$","p",null,{"children":"Three U.S. divisions moved against Fitzhugh Lee’s two brigades during a thunderstorm. The Confederate infantry Stuart expected had not arrived."}]]}]]}]
23:["$","div","The Confederate line broke within thirty minutes",{"className":"moment","children":[["$","$L17",null,{"seconds":1251,"label":"20:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate line broke within thirty minutes"}],["$","p",null,{"children":"Most units fought dismounted, but mounted U.S. attacks penetrated the position. Fitzhugh Lee withdrew the survivors across the Chickahominy River."}]]}]]}]
24:["$","div","John A. Huff mortally wounded Stuart",{"className":"moment","children":[["$","$L17",null,{"seconds":1280,"label":"21:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"John A. Huff mortally wounded Stuart"}],["$","p",null,{"children":"The 5th Michigan Cavalry private shot Stuart in the abdomen while the general tried to rally the center of his line. Fitzhugh Lee assumed command."}]]}]]}]
25:["$","div","Stuart was taken to Richmond",{"className":"moment","children":[["$","$L17",null,{"seconds":1337,"label":"22:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart was taken to Richmond"}],["$","p",null,{"children":"An ambulance made a six-hour trip to the home of Stuart’s brother-in-law, Dr. Charles Brewer. Stuart died there at 7:38 p.m. on May 12 before his wife arrived."}]]}]]}]
26:["$","div","Sheridan tried to pass east of Richmond",{"className":"moment","children":[["$","$L17",null,{"seconds":1433,"label":"23:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sheridan tried to pass east of Richmond"}],["$","p",null,{"children":"Flooded water and the city defenses forced the U.S. cavalry toward the damaged Meadow Bridges over the Chickahominy River."}]]}]]}]
27:["$","div","Confederate forces converged at Meadow Bridges",{"className":"moment","children":[["$","$L17",null,{"seconds":1491,"label":"24:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate forces converged at Meadow Bridges"}],["$","p",null,{"children":"Fitzhugh Lee held the far bank, Gordon attacked from the west, and Archibald Gracie’s infantry advanced from Richmond while U.S. troops crossed the railroad bridge and repaired the road bridges."}]]}]]}]
28:["$","div","The U.S. cavalry cleared the crossings",{"className":"moment","children":[["$","$L17",null,{"seconds":1563,"label":"26:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. cavalry cleared the crossings"}],["$","p",null,{"children":"By about 4 p.m. on May 12 the Meadow Bridges were repaired and Confederate forces had withdrawn. Sheridan crossed and moved toward Haxall’s Landing on the James."}]]}]]}]
29:["$","div","Sheridan reached the James River",{"className":"moment","children":[["$","$L17",null,{"seconds":1581,"label":"26:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sheridan reached the James River"}],["$","p",null,{"children":"The cavalry encamped at Haxall’s Landing on May 14, contacted U.S. gunboats, and reported the raid’s results to Grant."}]]}]]}]
2a:["$","div","The raid cost about 1,200 casualties",{"className":"moment","children":[["$","$L17",null,{"seconds":1612,"label":"26:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"The raid cost about 1,200 casualties"}],["$","p",null,{"children":"The episode estimates roughly six hundred casualties on each side. It also caused major supply losses, temporary railroad damage, and the death of Stuart."}]]}]]}]
