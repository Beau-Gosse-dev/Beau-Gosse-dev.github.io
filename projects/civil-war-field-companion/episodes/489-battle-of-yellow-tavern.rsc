e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Troop positions at Yellow Tavern"}],["$","span",null,{"children":"The schematic shows Lomax blocking Telegraph Road, Wickham positioned north on the ridge, the second Confederate line across the road, and Custer’s mounted attack. It is based on the National Park Service battlefield account; positions are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/yellow-tavern-tactical-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/frsp/planyourvisit/yell-tav.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
f:["$","figure","The raid from Spotsylvania toward Richmond",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The raid from Spotsylvania toward Richmond at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of the 1864 Virginia campaign between Spotsylvania and Richmond","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The raid from Spotsylvania toward Richmond"}],["$","span",null,{"children":"Sheridan left the Spotsylvania fighting, crossed the North and South Anna rivers, damaged the Virginia Central and Richmond, Fredericksburg and Potomac railroads, and approached Richmond from the north."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
10:["$","figure","Yellow Tavern and Richmond today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.62%2C37.51%2C-77.28%2C37.82&layer=mapnik&marker=37.6770%2C-77.4587","title":"Yellow Tavern and Richmond today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Yellow Tavern and Richmond today"}],["$","span",null,{"children":"The battlefield was at the Telegraph and Mountain Road junction north of Richmond. Interstate 295 now cuts across the former Confederate position, and modern development covers most of the field."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Grant’s supporting operations were ending",{"className":"moment","children":[["$","$L17",null,{"seconds":83,"label":"1:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant’s supporting operations were ending"}],["$","p",null,{"children":"The episode follows the Confederate victory at New Market, which released about 2,500 troops for Lee. Butler and Sheridan still threatened Richmond from opposite directions."}]]}]]}],["$","div","Sheridan received permission to seek Stuart",{"className":"moment","children":[["$","$L17",null,{"seconds":222,"label":"3:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sheridan received permission to seek Stuart"}],["$","p",null,{"children":"After arguing with George Meade about cavalry performance, Sheridan said he could defeat J. E. B. Stuart. Grant supported the proposal and Meade issued the order."}]]}]]}],["$","div","The cavalry corps departed May 9",{"className":"moment","children":[["$","$L17",null,{"seconds":288,"label":"4:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cavalry corps departed May 9"}],["$","p",null,{"children":"Sheridan’s force left the Spotsylvania area at daybreak in a thirteen-mile column of about 12,000 men and 32 guns."}]]}]]}],["$","div","Stuart kept four brigades with Lee’s army",{"className":"moment","children":[["$","$L17",null,{"seconds":348,"label":"5:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart kept four brigades with Lee’s army"}],["$","p",null,{"children":"He pursued with Fitzhugh Lee’s two brigades and later James B. Gordon’s brigade. The remaining cavalry stayed near Lee in case Grant moved around another flank."}]]}]]}],["$","div","Stuart tried to catch the column at the North Anna",{"className":"moment","children":[["$","$L17",null,{"seconds":440,"label":"7:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart tried to catch the column at the North Anna"}],["$","p",null,{"children":"He sent Wickham directly behind Sheridan while taking Gordon and Lomax upstream. Sheridan guarded the crossing and moved the full column safely south of the river."}]]}]]}],["$","div","U.S. cavalry destroyed the Beaver Dam depot",{"className":"moment","children":[["$","$L17",null,{"seconds":481,"label":"8:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. cavalry destroyed the Beaver Dam depot"}],["$","p",null,{"children":"The raid destroyed two locomotives, about one hundred railcars, medical stores, and roughly 1.5 million rations, and released between three hundred and four hundred U.S. prisoners."}]]}]]}],["$","div","Stuart divided his pursuit",{"className":"moment","children":[["$","$L17",null,{"seconds":515,"label":"8:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart divided his pursuit"}],["$","p",null,{"children":"Gordon stayed behind Sheridan while Stuart and Fitzhugh Lee moved southeast to Telegraph Road, attempting to pass the U.S. column before it reached Richmond."}]]}]]}],["$","div","The Confederate march continued through exhaustion",{"className":"moment","children":[["$","$L17",null,{"seconds":570,"label":"9:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate march continued through exhaustion"}],["$","p",null,{"children":"Stuart’s troopers halted near Taylorsville after thirty-two hours in the saddle, rested six hours, and resumed the march at 3 a.m. on May 11."}]]}]]}],["$","div","Sheridan stopped to rest at Ground Squirrel Bridge",{"className":"moment","children":[["$","$L17",null,{"seconds":617,"label":"10:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sheridan stopped to rest at Ground Squirrel Bridge"}],["$","p",null,{"children":"His objective was to fight Stuart rather than win a race to Richmond. The U.S. cavalry bivouacked south of the South Anna River on May 10."}]]}]]}],["$","div","Ten thousand U.S. cavalrymen resumed the advance",{"className":"moment","children":["$L18","$L19"]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","Cavalry Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry Corps, Army of the Potomac"}],["$","span",null,{"children":"Philip H. Sheridan"}],["$","small",null,{"children":"David McM. Gregg, Wesley Merritt, and James H. Wilson’s divisions"}]]}],["$","div","1st Cavalry Division",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Cavalry Division"}],["$","span",null,{"children":"Wesley Merritt"}],["$","small",null,{"children":"Led the first attack at Yellow Tavern; George A. Custer’s brigade made the decisive mounted charge"}]]}],["$","div","2nd Cavalry Division",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Cavalry Division"}],["$","span",null,{"children":"David McM. Gregg"}],["$","small",null,{"children":"John I. Gregg’s brigade guarded the rear against Gordon"}]]}],["$","div","3rd Cavalry Division",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Cavalry Division"}],["$","span",null,{"children":"James H. Wilson"}],["$","small",null,{"children":"Moved with Sheridan’s main column and joined the final attack"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Cavalry Corps, Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry Corps, Army of Northern Virginia"}],["$","span",null,{"children":"J. E. B. Stuart"}],["$","small",null,{"children":"Directed the pursuit and the Yellow Tavern defense until mortally wounded"}]]}],["$","div","Cavalry division",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry division"}],["$","span",null,{"children":"Fitzhugh Lee"}],["$","small",null,{"children":"William C. Wickham and Lunsford L. Lomax’s brigades; assumed command after Stuart fell"}]]}],["$","div","Cavalry brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry brigade"}],["$","span",null,{"children":"James B. Gordon"}],["$","small",null,{"children":"Attacked Sheridan’s rear guard and later approached the Meadow Bridges"}]]}],["$","div","Military adviser and Richmond defense coordinator",{"className":"command-entry","children":[["$","strong",null,{"children":"Military adviser and Richmond defense coordinator"}],["$","span",null,{"children":"Braxton Bragg"}],["$","small",null,{"children":"4,000 reservists and clerks in the city with veteran infantry arriving from Petersburg"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Philip H. Sheridan",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/philip-sheridan.jpg","alt":"Portrait of Philip H. Sheridan","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Philip H. Sheridan"}],["$","p",null,{"children":"Led the 12,000-man raid and concentrated three divisions against Stuart at Yellow Tavern"}]]}]]}],["$","article","George A. Custer",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/sheridan-generals.jpg","alt":"Portrait of George A. Custer","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George A. Custer"}],["$","p",null,{"c