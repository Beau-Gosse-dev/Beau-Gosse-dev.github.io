12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode introduces Wheeler’s three public careers",{"className":"moment","children":[["$","$L17",null,{"seconds":189,"label":"3:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode introduces Wheeler’s three public careers"}],["$","p",null,{"children":"He served as a Confederate cavalry general, later represented Alabama in Congress, and returned to U.S. Army service during the Spanish-American War."}]]}]]}],["$","div","Wheeler was born in Augusta",{"className":"moment","children":[["$","$L17",null,{"seconds":218,"label":"3:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wheeler was born in Augusta"}],["$","p",null,{"children":"Joseph Wheeler was born on September 10, 1836. After his mother died, his father moved the family to Connecticut."}]]}]]}],["$","div","He entered West Point in 1854",{"className":"moment","children":[["$","$L17",null,{"seconds":362,"label":"6:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"He entered West Point in 1854"}],["$","p",null,{"children":"Wheeler graduated in 1859, ranking 19th in a class of 22, and entered the 1st U.S. Dragoons."}]]}]]}],["$","div","His first assignments were in the mounted service",{"className":"moment","children":[["$","$L17",null,{"seconds":480,"label":"8:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"His first assignments were in the mounted service"}],["$","p",null,{"children":"Wheeler trained at Carlisle Barracks, transferred to the Mounted Rifles, and served at Fort Craig and other posts in New Mexico Territory."}]]}]]}],["$","div","Wheeler chose Georgia after secession",{"className":"moment","children":[["$","$L17",null,{"seconds":689,"label":"11:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wheeler chose Georgia after secession"}],["$","p",null,{"children":"Despite northern family ties and schooling, he resigned his U.S. Army commission on February 27, 1861, after Georgia left the Union."}]]}]]}],["$","div","He joined the Confederate Army",{"className":"moment","children":[["$","$L17",null,{"seconds":764,"label":"12:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"He joined the Confederate Army"}],["$","p",null,{"children":"Wheeler began as an artillery lieutenant at Pensacola and became colonel of the 19th Alabama Infantry in September 1861."}]]}]]}],["$","div","The 19th Alabama fought at Shiloh",{"className":"moment","children":[["$","$L17",null,{"seconds":884,"label":"14:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 19th Alabama fought at Shiloh"}],["$","p",null,{"children":"Wheeler led repeated attacks on April 6, held ground on April 7, and commanded part of the retreat to Corinth."}]]}]]}],["$","div","Bragg transferred Wheeler to cavalry command",{"className":"moment","children":[["$","$L17",null,{"seconds":1073,"label":"17:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg transferred Wheeler to cavalry command"}],["$","p",null,{"children":"In July 1862, Wheeler received a cavalry brigade. His close-support work earned Bragg’s confidence while his relationship with Nathan Bedford Forrest remained difficult."}]]}]]}],["$","div","Wheeler became the army’s chief of cavalry",{"className":"moment","children":[["$","$L17",null,{"seconds":1204,"label":"20:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wheeler became the army’s chief of cavalry"}],["$","p",null,{"children":"He was appointed brigadier general effective October 30, 1862, and became a major general on January 22, 1863, at age 26."}]]}]]}],["$","div","He operated around Stones River",{"className":"moment","children":[["$","$L17",null,{"seconds":1220,"label":"20:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"He operated around Stones River"}],["$","p",null,{"children":"Wheeler delayed the U.S. advance, rode around the Union army with about 2,000 cavalrymen, and later raided toward the Cumberland River."}]]}]]}],["$","div","He covered the retreat from Chattanooga",{"className":"moment","children":["$L18","$L19"]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}]
