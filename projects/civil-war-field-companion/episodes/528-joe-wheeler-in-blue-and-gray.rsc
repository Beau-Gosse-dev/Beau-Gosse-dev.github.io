1a:["$","div","His cavalry served throughout the Atlanta campaign",{"className":"moment","children":[["$","$L17",null,{"seconds":1331,"label":"22:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"His cavalry served throughout the Atlanta campaign"}],["$","p",null,{"children":"Wheeler screened Johnston’s army, defeated U.S. cavalry raids, and captured Major General George Stoneman."}]]}]]}]
1b:["$","div","The August raid failed to stop Sherman’s supply line",{"className":"moment","children":[["$","$L17",null,{"seconds":1366,"label":"22:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"The August raid failed to stop Sherman’s supply line"}],["$","p",null,{"children":"Wheeler captured Dalton but caused limited railroad damage. His absence deprived Hood of cavalry intelligence before the defeat at Jonesboro."}]]}]]}]
