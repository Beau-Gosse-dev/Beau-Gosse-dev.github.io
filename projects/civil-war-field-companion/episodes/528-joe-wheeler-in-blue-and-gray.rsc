nce-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"September 10, 1836–January 25, 1906"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"United States, Cuba, and the Philippines"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Joseph Wheeler served as a Confederate cavalry commander, a U.S. congressman, and a U.S. Army general"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"September 10, 1836–January 25, 1906","place":"United States, Cuba, and the Philippines","result":"Joseph Wheeler served as a Confederate cavalry commander, a U.S. congressman, and a U.S. Army general","facts":[{"label":"Born","value":"September 10, 1836, Augusta, Georgia"},{"label":"West Point class","value":"1859; 19th of 22 cadets"},{"label":"Confederate promotion","value":"Major general at age 26"},{"label":"Congressional service","value":"Elected from Alabama and served most years from 1881 to 1900"},{"label":"U.S. Army return","value":"Major general of volunteers in 1898; regular-army brigadier general in 1900"},{"label":"Died","value":"January 25, 1906, Brooklyn, New York"}],"maps":[{"title":"Wheeler’s early life and U.S. Army service","caption":"Wheeler was born in Augusta, raised partly in Connecticut, attended West Point, trained at Carlisle Barracks, and served at Fort Craig in New Mexico Territory.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-109.5%2C28.0%2C-68.0%2C44.5&layer=mapnik&marker=33.4735%2C-82.0105"},{"title":"Civil War service in the western theater","caption":"Wheeler served from Shiloh and the Kentucky campaign through Stones River, Chattanooga, the Atlanta campaign, the March to the Sea, and the Carolinas campaign.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-90.8%2C30.8%2C-77.5%2C38.2&layer=mapnik&marker=34.7615%2C-84.95"},{"title":"Atlanta campaign operations","caption":"Wheeler’s cavalry screened the Army of Tennessee during its withdrawals toward Atlanta. His later raid carried his command into northern Georgia, Tennessee, and Alabama.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of U.S. and Confederate movements during the Atlanta campaign"},{"title":"Pond Spring, Alabama","caption":"After the Civil War, Wheeler lived at Pond Spring near Courtland in northern Alabama. The property is now operated by the Alabama Historical Commission.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-87.52%2C34.48%2C-87.04%2C34.93&layer=mapnik&marker=34.6681%2C-87.3095"}],"moments":[{"time":"3:09","audioTime":189,"title":"The episode introduces Wheeler’s three public careers","detail":"He served as a Confederate cavalry general, later represented Alabama in Congress, and returned to U.S. Army service during the Spanish-American War."},{"time":"3:38","audioTime":218,"title":"Wheeler was born in Augusta","detail":"Joseph Wheeler was born on September 10, 1836. After his mother died, his father moved the family to Connecticut."},{"time":"6:02","audioTime":362,"title":"He entered West Point in 1854","detail":"Wheeler graduated in 1859, ranking 19th in a class of 22, and entered the 1st U.S. Dragoons."},{"time":"8:00","audioTime":480,"title":"His first assignments were in the mounted service","detail":"Wheeler trained at Carlisle Barracks, transferred to the Mounted Rifles, and served at Fort Craig and other posts in New Mexico Territory."},{"time":"11:29","audioTime":689,"title":"Wheeler chose Georgia after secession","detail":"Despite northern family ties and schooling, he resigned his U.S. Army commission on February 27, 1861, after Georgia left the Union."},{"time":"12:44","audioTime":764,"title":"He joined the Confederate Army","detail":"Wheeler began as an artillery lieutenant at Pensacola and became colonel of the 19th Alabama Infantry in September 1861."},{"time":"14:44","audioTime":884,"title":"The 19th Alabama fought at Shiloh","detail":"Wheeler led repeated attacks on April 6, held ground on April 7, and commanded part of the retreat to Corinth."},{"time":"17:53","audioTime":1073,"title":"Bragg transferred Wheeler to cavalry command","detail":"In July 1862, Wheeler received a cavalry brigade. His close-support work earned Bragg’s confidence while his relationship with Nathan Bedford Forrest remained difficult."},{"time":"20:04","audioTime":1204,"title":"Wheeler became the army’s chief of cavalry","detail":"He was appointed brigadier general effective October 30, 1862, and became a major general on January 22, 1863, at age 26."},{"time":"20:20","audioTime":1220,"title":"He operated around Stones River","detail":"Wheeler delayed the U.S. advance, rode around the Union army with about 2,000 cavalrymen, and later raided toward the Cumberland River."},{"time":"21:43","audioTime":1303,"title":"He covered the retreat from Chattanooga","detail":"Wheeler and Patrick Cleburne stopped the U.S. pursuit at Ringgold Gap, where Wheeler was wounded in the foot."},{"time":"22:11","audioTime":1331,"title":"His cavalry served throughout the Atlanta campaign","detail":"Wheeler screened Johnston’s army, defeated U.S. cavalry raids, and captured Major General George Stoneman."},{"time":"22:46","audioTime":1366,"title":"The August raid failed to stop Sherman’s supply line","detail":"Wheeler captured Dalton but caused limited railroad damage. His absence deprived Hood of cavalry intelligence before the defeat at Jonesboro."},{"time":"24:27","audioTime":1467,"title":"Wheeler opposed Sherman in Georgia and the Carolinas","detail":"His cavalry fought during the March to the Sea, won at Aiken, and served under Wade Hampton at Bentonville."},{"time":"25:51","audioTime":1551,"title":"Wheeler was captured after Johnston’s surrender","detail":"He tried to join Jefferson Davis but was captured near Conyers, Georgia, on May 9, 1865, and was paroled on June 8."},{"time":"26:37","audioTime":1597,"title":"He entered postwar politics","detail":"Wheeler became a planter and lawyer near Courtland, Alabama. He won a congressional seat, lost it after an election contest, returned in a special election, and later won eight more terms."},{"time":"28:29","audioTime":1709,"title":"Wheeler returned to U.S. service in 1898","detail":"President William McKinley appointed him major general of volunteers. Wheeler commanded the cavalry division in Cuba during the campaign against Santiago."},{"time":"29:31","audioTime":1771,"title":"He ordered the attack at Las Guasimas","detail":"Wheeler attacked before all U.S. troops had landed. The action cost U.S. forces 17 killed and 52 wounded before Spanish troops withdrew."},{"time":"31:27","audioTime":1887,"title":"He served in the Philippines","detail":"Wheeler commanded a brigade under Arthur MacArthur and received a regular-army commission as brigadier general."},{"time":"32:25","audioTime":1945,"title":"He retired from the army in 1900","detail":"After returning from the Philippines, Wheeler resigned from Congress, commanded the Department of the Lakes, and retired in September."},{"time":"33:23","audioTime":2003,"title":"Wheeler died in 1906","detail":"He died in Brooklyn on January 25 at age 69 and was buried in Arlington National Cemetery."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William McKinley","command":"President of the United States","subordinates":"Appointed Wheeler major general of volunteers in 1898"},{"commander":"William R. Shafter","command":"V Corps in Cuba","subordinates":"Joseph Wheeler’s cavalry division"},{"commander":"Joseph Wheeler","command":"Cavalry Division, V Corps","subordinates":"Included the Rough Riders and two Black regular cavalry regiments"},{"commander":"Arthur MacArthur Jr.","command":"2nd Division in the Philippines","subordinates":"Wheeler’s 1st Brigade"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Braxton Bragg","command":"Army of Tennessee","subordinates":"Promoted Wheeler and relied on his cavalry"},{"commander":"Joseph Wheeler","command":"Cavalry Corps, Army of Tennessee","subordinates":"Screened the army and conducted raids"},{"commander":"Nathan Bedford Forrest","command":"Independent cavalry commands","subordinates":"Worked uneasily with Wheeler"},{"commander":"Joseph E. Johnston","command":"Army of Tennessee and later Carolinas command","subordinates":"Wheeler’s cavalry served under him in 1864 and 1865"},{"commander":"John B. Hood","command":"Army of Tennessee","subordinates":"Operated without Wheeler during critical phases of the Atlanta campaign"},{"commander":"Wade Hampton","command":"Cavalry in the Carolinas","subordinates":"Commanded Wheeler at Bentonville"}]}],"people":[{"name":"Joseph Wheeler","role":"Confederate cavalry commander, Alabama congressman, and U.S. Army general","side":"Confederacy","image":"/images/joseph-wheeler.jpg","source":"https://www.loc.gov/item/2018666551/"},{"name":"Braxton Bragg","role":"Promoted Wheeler from artillery and infantry assignments into senior cavalry command","side":"Confederacy"},{"personId":"nathan-bedford-forrest","role":"Confederate cavalry commander with a difficult working relationship with Wheeler"},{"name":"George Stoneman","role":"U.S. cavalry general captured by Wheeler’s forces during the Atlanta campaign","side":"United States"},{"name":"William McKinley","role":"President who appointed Wheeler major general of volunteers in 1898","side":"United States"},{"name":"William R. Shafter","role":"V Corps commander in Cuba and Wheeler’s immediate superior","side":"United States"},{"name":"Annie Wheeler","role":"Wheeler’s daughter, who served as a nurse in Cuba and accompanied him to the Philippines","side":"United States"},{"name":"Joseph Wheeler Jr.","role":"West Point graduate who served as his father’s aide in Cuba and the Philippines","side":"United States"}],"losses":[],"gallery":[{"image":"/images/joseph-wheeler.jpg","alt":"Civil War portrait of Confederate Major General Joseph Wheeler","caption":"Joseph Wheeler photographed during the Civil War.","source":"https://www.loc.gov/item/2018666551/"},{"image":"/images/wheeler-veterans-reunion.jpg","alt":"Joseph Wheeler and Bennett H. Young on horseback at a Confederate veterans reunion","caption":"Joseph Wheeler and Bennett H. Young at a United Confederate Veterans reunion in Louisville, Kentucky.","source":"https://www.loc.gov/item/2018651895/"}],"sources":[{"label":"Official Episode 528 page","url":"https://civilwarpodcast.org/2026/05/24/civil-war-podcast-episode-528/"},{"label":"Library of Congress Joseph Wheeler portrait","url":"https://www.loc.gov/item/2018666551/"},{"label":"Library of Congress veterans reunion photograph","url":"https://www.loc.gov/item/2018651895/"},{"label":"Alabama Historical Commission: Pond Spring","url":"https://ahc.alabama.gov/properties/pondspring/pondspring.aspx"},{"label":"U.S. Army Center of Military History: Santiago campaign","url":"https://history.army.mil/portals/143/Images/Publications/catalog/70-5.pdf"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
