1d:["$","div","Wheeler was captured after Johnston’s surrender",{"className":"moment","children":[["$","$L17",null,{"seconds":1551,"label":"25:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wheeler was captured after Johnston’s surrender"}],["$","p",null,{"children":"He tried to join Jefferson Davis but was captured near Conyers, Georgia, on May 9, 1865, and was paroled on June 8."}]]}]]}]
