1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",204," · ","September 22, 1862–January 1, 1863, with consequences through December 6, 1865"," · ","Washington, D.C.; the United States home front; Fredericksburg, Virginia; and the Confederate states and portions of states designated in the final Emancipation Proclamation"]}],["$","h1",null,{"children":"EMANCIPATION PROCLAMATION (Part the Fourth)"}],["$","span",null,{"className":"result-label","children":"Abraham Lincoln kept the promise made in the preliminary proclamation and issued the final Emancipation Proclamation on January 1, 1863. Acting as commander in chief during an armed rebellion, he declared enslaved people in designated Confederate territory free, committed the executive government, Army, and Navy to recognize and maintain that freedom, and opened United States military service to Black men. The order did not abolish slavery throughout the country: it omitted the loyal slave states, Tennessee, and specified portions of Louisiana and Virginia. Its reach expanded as United States forces advanced, while nationwide abolition ultimately required the Thirteenth Amendment"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7066293676.mp3?updated=1695588979","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The hundred-day interval and the final proclamation"}],["$","small",null,{"children":"The episode begins with reaction to the September 22 preliminary proclamation, follows politics and military events through the end of 1862, reconstructs the January 1 signing, and assesses the final document’s language, reach, and constitutional basis."}]]}],["$","div","Preliminary warning",{"children":[["$","span",null,{"children":"Preliminary warning"}],["$","strong",null,{"children":"September 22, 1862"}],["$","small",null,{"children":"Lincoln announced that enslaved people in any state or designated part of a state still in rebellion on January 1, 1863, would then be declared free."}]]}],["$","div","Public notice period",{"children":[["$","span",null,{"children":"Public notice period"}],["$","strong",null,{"children":"One hundred days"}],["$","small",null,{"children":"The final proclamation expressly referred to the full hundred-day period between the preliminary announcement and the January 1 order."}]]}],["$","div","Final proclamation",{"children":[["$","span",null,{"children":"Final proclamation"}],["$","strong",null,{"children":"Issued and signed January 1, 1863"}],["$","small",null,{"children":"No Confederate state returned to the United States within the deadline established by the preliminary proclamation."}]]}],["$","div","Authority Lincoln invoked",{"children":["$Le","$Lf","$L10"]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e"]}],"$L2f","$undefined","$L30","$L31","$L32",false,"$L33","$L34","$L35"]}]]}]
38:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","span",null,{"children":"Authority Lincoln invoked"}]
f:["$","strong",null,{"children":"Commander-in-chief power during an actual armed rebellion"}]
10:["$","small",null,{"children":"The document described emancipation in the designated areas as a fit and necessary war measure for suppressing the rebellion."}]
11:["$","div","Core legal declaration",{"children":[["$","span",null,{"children":"Core legal declaration"}],["$","strong",null,{"children":"Enslaved people in designated areas “are, and henceforward shall be free”"}],["$","small",null,{"children":"The order was not a promise of freedom after the war. It declared a present legal status on January 1, even where Confederate control delayed practical enforcement."}]]}]
12:["$","div","Ten Confederate states designated",{"children":[["$","span",null,{"children":"Ten Confederate states designated"}],["$","strong",null,{"children":"Eight in full and portions of Louisiana and Virginia"}],["$","small",null,{"children":"Arkansas, Texas, Mississippi, Alabama, Florida, Georgia, South Carolina, and North Carolina were named without internal exceptions. Louisiana and Virginia were named with specified exemptions."}]]}]
13:["$","div","Louisiana exceptions",{"children":[["$","span",null,{"children":"Louisiana exceptions"}],["$","strong",null,{"children":"Thirteen parishes, including New Orleans"}],["$","small",null,{"children":"The excepted parishes were St. Bernard, Plaquemines, Jefferson, St. John, St. Charles, St. James, Ascension, Assumption, Terrebonne, Lafourche, St. Mary, St. Martin, and Orleans."}]]}]
14:["$","div","Virginia exceptions",{"children":[["$","span",null,{"children":"Virginia exceptions"}],["$","strong",null,{"children":"The 48 counties designated as West Virginia and seven additional named counties"}],["$","small",null,{"children":"The proclamation also excepted Berkley, Accomac, Northampton, Elizabeth City, York, Princess Anne, and Norfolk Counties, including the cities of Norfolk and Portsmouth. The document used the historical spelling “Berkley.”"}]]}]
15:["$","div","Loyal slave states omitted",{"children":[["$","span",null,{"children":"Loyal slave states omitted"}],["$","strong",null,{"children":"Delaware, Maryland, Kentucky, and Missouri"}],["$","small",null,{"children":"Because these states were not in rebellion, Lincoln did not apply a commander-in-chief war measure to slavery within them."}]]}]
16:["$","div","Tennessee’s status",{"children":[["$","span",null,{"children":"Tennessee’s status"}],["$","strong",null,{"children":"Not designated in the final proclamation"}],["$","small",null,{"children":"Tennessee was a Confederate state, but the final document omitted it rather than naming specific exempted districts."}]]}]
17:["$","div","District of Columbia",{"children":[["$","span",null,{"children":"District of Columbia"}],["$","strong",null,{"children":"Slavery had already ended there by federal statute"}],["$","small",null,{"children":"Congress passed and Lincoln signed compensated emancipation for the District on April 16, 1862, so the final proclamation was not the source of freedom there."}]]}]
18:["$","div","Population directly covered",{"children":[["$","span",null,{"children":"Population directly covered"}],["$","strong",null,{"children":"Approximately 3.1 million enslaved people"}],["$","small",null,{"children":"The national enslaved population in 1860 was nearly four million. The proclamation’s legal coverage was narrower than that national total."}]]}]
19:["$","div","Recognition and enforcement",{"children":[["$","span",null,{"children":"Recognition and enforcement"}],["$","strong",null,{"children":"The executive government, Army, and Navy would maintain freedom"}],["$","small",null,{"children":"The order supplied federal policy and legal protection. In places still controlled by the Confederacy, the practical domain of freedom expanded as United States authority advanced and as enslaved people secured their own freedom."}]]}]
1a:["$","div","Black military service",{"children":[["$","span",null,{"children":"Black military service"}],["$","strong",null,{"children":"Men of suitable condition could enter United States service"}],["$","small",null,{"children":"The proclamation specified garrisoning forts, positions, stations, and other places and manning vessels. By the end of the war, more than 185,000 Black soldiers and sailors had served the United States."}]]}]
1b:["$","div","Conduct and labor clauses",{"children":[["$","span",null,{"children":"Conduct and labor clauses"}],["$","strong",null,{"children":"Avoid violence except in self-defense; work for reasonable wages when allowed"}],["$","small",null,{"children":"These instructions appeared alongside the declaration of freedom and the military-enlistment provision."}]]}]
1c:["$","div","Moral claim in the legal text",{"children":[["$","span",null,{"children":"Moral claim in the legal text"}],["$","strong",null,{"children":"An act of justice warranted by the Constitution upon military necessity"}],["$","small",null,{"children":"The final paragraph joined a moral description of emancipation to the constitutional and military basis Lincoln believed could sustain executive action."}]]}]
1d:["$","div","Change from the preliminary version",{"children":[["$","span",null,{"children":"Change from the preliminary version"}],["$","strong",null,{"children":"No compensation or colonization language in the final proclamation"}],["$","small",null,{"children":"The September document had continued proposals for compensated state abolition and consensual colonization. The January document omitted both and added explicit Black military service."}]]}]
1e:["$","div","Final drafting",{"children":[["$","span",null,{"children":"Final drafting"}],["$","strong",null,{"children":"Cabinet members reviewed copies on December 30–31, 1862"}],["$","small",null,{"children":"Lincoln solicited suggestions. The final language incorporated limited revisions while remaining a presidential order issued under his authority."}]]}]
1f:["$","div","Signing-day correction",{"children":[["$","span",null,{"children":"Signing-day correction"}],["$","strong",null,{"children":"“Set my hand,” not “set my name”"}],["$","small",null,{"children":"Lincoln noticed that an early engrossed copy used a formula he did not ordinarily use. The State Department prepared a corrected copy for formal signature."}]]}]
20:["$","div","New Year’s reception",{"children":[["$","span",null,{"children":"New Year’s reception"}],["$","strong",null,{"children":"Began at 11 a.m. at the White House"}],["$","small",null,{"children":"Lincoln greeted officials and members of the public for hours before retiring upstairs to sign the corrected proclamation in the afternoon."}]]}]
21:["$","div","The trembling hand",{"children":[["$","span",null,{"children":"The trembling hand"}],["$","strong",null,{"children":"Physical fatigue, not a change of mind"}],["$","small",null,{"children":"Lincoln later explained that hours of handshaking made his arm tremble. He paused because he did not want the signature to be read as evidence of hesitation."}]]}]
22:["$","div","Official attestation",{"children":[["$","span",null,{"children":"Official attestation"}],["$","strong",null,{"children":"Secretary of State William H. Seward"}],["$","small",null,{"children":"The engrossed proclamation bears Lincoln’s signature, Seward’s attestation, and the seal of the United States."}]]}]
23:["$","div","Surviving records",{"children":[["$","span",null,{"children":"Surviving records"}],["$","strong",null,{"children":"The official five-page proclamation is at the National Archives"}],["$","small",null,{"children":"A lithographic facsimile preserves Lincoln’s final handwritten draft. The original manuscript draft was destroyed in the Chicago fire of 1871."}]]}]
24:["$","div","1862 House elections",{"children":[["$","span",null,{"children":"1862 House elections"}],["$","strong",null,{"children":"Democrats gained, but Republicans and Unionists retained control"}],["$","small",null,{"children":"The House Historian lists the incoming 38th Congress with 85 Republicans, 72 Democrats, 16 Unconditional Unionists, and 11 members in other categories. Party labels and coalition accounting explain why contemporary and later summaries give different net-change figures."}]]}]
25:["$","div","Incoming Senate",{"children":[["$","span",null,{"children":"Incoming Senate"}],["$","strong",null,{"children":"33 Republicans, 10 Democrats, and 9 Unionists"}],["$","small",null,{"children":"Official Senate party-division data for the 38th Congress show a clear Republican plurality reinforced by Unionist senators."}]]}]
26:["$","div","Army of the Potomac command change",{"children":[["$","span",null,{"children":"Army of the Potomac command change"}],["$","strong",null,{"children":"McClellan relieved; Burnside took command in November 1862"}],["$","small",null,{"children":"Lincoln ordered the change on November 5. The order reached the army on November 7, the date used in the episode."}]]}]
27:["$","div","Fredericksburg",{"children":[["$","span",null,{"children":"Fredericksburg"}],["$","strong",null,{"children":"Confederate victory, December 11–15, 1862"}],["$","small",null,{"children":"Burnside’s failed assaults produced about 12,600 United States casualties and renewed public anxiety shortly before the proclamation deadline."}]]}]
28:["$","div","West Virginia statehood condition",{"children":[["$","span",null,{"children":"West Virginia statehood condition"}],["$","strong",null,{"children":"Gradual emancipation required"}],["$","small",null,{"children":"Congress conditioned admission on the Willey Amendment. Lincoln signed the admission bill on December 31, 1862; statehood followed on June 20, 1863, after constitutional revision."}]]}]
29:["$","div","Judicial context",{"children":[["$","span",null,{"children":"Judicial context"}],["$","strong",null,{"children":"Chief Justice Roger B. Taney had written the Dred Scott majority opinion"}],["$","small",null,{"children":"The 1857 decision denied federal citizenship to African Americans and held that Congress lacked power to prohibit slavery in the territories, contributing to Lincoln’s concern over the security of presidential emancipation."}]]}]
2a:["$","div","Permanent nationwide abolition",{"children":[["$","span",null,{"children":"Permanent nationwide abolition"}],["$","strong",null,{"children":"Thirteenth Amendment"}],["$","small",null,{"children":"Congress passed it on January 31, 1865, and the states ratified it on December 6, 1865. It abolished slavery throughout the United States except as punishment for crime after conviction."}]]}]
2b:["$","div","Douglass’s assessment",{"children":[["$","span",null,{"children":"Douglass’s assessment"}],["$","strong",null,{"children":"A decisive beginning, not the end of the struggle"}],["$","small",null,{"children":"In October 1862 Frederick Douglass called the preliminary proclamation the first chapter of a new history while warning that sustained work and sacrifice would still be necessary."}]]}]
2c:["$","div","“Bill of lading” criticism",{"children":[["$","span",null,{"children":"“Bill of lading” criticism"}],["$","strong",null,{"children":"Richard Hofstadter, 1948"}],["$","small",null,{"children":"The transcript says “Hofstetter.” The historian’s name was Richard Hofstadter. His criticism compared the proclamation’s legal prose unfavorably with Lincoln’s later ceremonial addresses."}]]}]
2d:["$","div","Lincoln’s December formulation",{"children":[["$","span",null,{"children":"Lincoln’s December formulation"}],["$","strong",null,{"children":"Freedom for the enslaved and security for the free were linked"}],["$","small",null,{"children":"In his December 1, 1862, annual message, Lincoln argued that giving freedom to enslaved people would also assure freedom to those already free."}]]}]
2e:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Abraham Lincoln: Redeemer President” by Allen C. Guelzo"}],["$","small",null,{"children":"The transcript’s automated spelling “Galzo” is incorrect. The official episode page and book-recommendations list give Allen C. Guelzo."}]]}]
2f:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
30:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The final proclamation: scope and force",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep204-proclamation-scope.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The final proclamation: scope and force at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep204-proclamation-scope.svg","alt":"Three-column diagram showing areas covered by the final Emancipation Proclamation, places left unchanged, the role of United States military enforcement, and the later Thirteenth Amendment.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The final proclamation: scope and force"}],["$","span",null,{"children":"The proclamation designated ten Confederate states, but covered eight in full and only portions of Louisiana and Virginia. It omitted the loyal slave states and Tennessee, tied implementation to executive and military authority, and did not substitute for nationwide constitutional abolition."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep204-proclamation-scope.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Archives transcript of the final Emancipation Proclamation, National Archives Thirteenth Amendment record, and Library of Congress; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$30:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Lincoln’s final handwritten draft",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep204-final-proclamation-draft.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Lincoln’s final handwritten draft at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep204-final-proclamation-draft.jpg","alt":"First page of a facsimile of Abraham Lincoln’s handwritten final draft of the Emancipation Proclamation.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Lincoln’s final handwritten draft"}],["$","span",null,{"children":"This first page of a lithographic facsimile preserves Lincoln’s final handwritten draft, including two printed passages pasted into the manuscript. The handwritten original was destroyed in the Chicago fire of 1871; the official engrossed proclamation survives at the National Archives."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep204-final-proclamation-draft.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$30:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Abraham Lincoln Papers, Library of Congress; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$30:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","A period image of Lincoln writing the proclamation",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep204-lincoln-writing-proclamation.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open A period image of Lincoln writing the proclamation at full size","children":"$L36"}]}],"$L37"]}]]}]]}]
31:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode resumes on September 22, 1862",{"className":"moment","children":[["$","$L38",null,{"seconds":104,"label":"1:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode resumes on September 22, 1862"}],["$","p",null,{"children":"Five days after Antietam, Lincoln had issued the preliminary proclamation and announced a January 1 deadline for states still in rebellion."}]]}]]}],["$","div","Emancipation is placed in a larger policy progression",{"className":"moment","children":[["$","$L38",null,{"seconds":119,"label":"1:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Emancipation is placed in a larger policy progression"}],["$","p",null,{"children":"The preliminary order followed congressional legislation, administration decisions, changing public opinion, military conditions, and the action of freedom seekers reaching United States lines."}]]}]]}],["$","div","Douglass’s wartime logic returns",{"className":"moment","children":[["$","$L38",null,{"seconds":174,"label":"2:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Douglass’s wartime logic returns"}],["$","p",null,{"children":"The episode recalls Frederick Douglass’s argument that secession and war had set in motion a process that could destroy slavery."}]]}]]}],["$","div","Douglass welcomes the preliminary proclamation",{"className":"moment","children":[["$","$L38",null,{"seconds":200,"label":"3:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Douglass welcomes the preliminary proclamation"}],["$","p",null,{"children":"He treated it as an extraordinary presidential act and the opening of a new national history, while his full October 1862 argument warned that the work was only beginning."}]]}]]}],["$","div","Praise meets immediate condemnation",{"className":"moment","children":[["$","$L38",null,{"seconds":220,"label":"3:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Praise meets immediate condemnation"}],["$","p",null,{"children":"Republicans and antislavery Northerners celebrated the decision, while Democratic opponents and hostile British newspapers predicted political, military, and racial catastrophe."}]]}]]}],["$","div","Predicted collapse does not occur",{"className":"moment","children":[["$","$L38",null,{"seconds":267,"label":"4:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Predicted collapse does not occur"}],["$","p",null,{"children":"There was no general racial uprising in the South and no mass desertion from United States armies in response to the preliminary proclamation."}]]}]]}],["$","div","Military opinion is described as mixed but pragmatic",{"className":"moment","children":[["$","$L38",null,{"seconds":282,"label":"4:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Military opinion is described as mixed but pragmatic"}],["$","p",null,{"children":"Some soldiers objected, but many accepted emancipation as a means of weakening the Confederacy and shortening the war."}]]}]]}],["$","div","The hundred days remain uncertain",{"className":"moment","children":[["$","$L38",null,{"seconds":297,"label":"4:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The hundred days remain uncertain"}],["$","p",null,{"children":"Supporters feared that political pressure or military reverses might cause Lincoln to retreat before January 1."}]]}]]}],["$","div","Democrats campaign against emancipation",{"className":"moment","children":[["$","$L38",null,{"seconds":327,"label":"5:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Democrats campaign against emancipation"}],["$","p",null,{"children":"The 1862 state and congressional elections became an important test of opposition to the administration’s war and emancipation policies."}]]}]]}],["$","div","Democrats make visible gains",{"className":"moment","children":[["$","$L38",null,{"seconds":339,"label":"5:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Democrats make visible gains"}],["$","p",null,{"children":"They won the governorships of New York and New Jersey, gained legislative strength, and added many House seats."}]]}]]}],"$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51","$L52","$L53","$L54","$L55","$L56","$L57","$L58","$L59","$L5a","$L5b","$L5c","$L5d","$L5e","$L5f","$L60","$L61","$L62","$L63","$L64","$L65","$L66","$L67","$L68"]}]]}]
32:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States civilian authority",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States civilian authority"}],[["$","div","Chief executive-President Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief executive"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Issued the proclamation, determined its geographic reach, approved its final text, and directed the executive government to recognize and maintain freedom"}]]}],["$","div","Department of State-Secretary of State William H. Seward",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of State"}],["$","span",null,{"children":"Secretary of State William H. Seward"}],["$","small",null,{"children":"Oversaw preparation of the corrected engrossed copy, attested the final proclamation, and caused the United States seal to be affixed"}]]}],["$","div","War Department-Secretary of War Edwin M. Stanton",{"className":"command-entry","children":[["$","strong",null,{"children":"War Department"}],["$","span",null,{"children":"Secretary of War Edwin M. Stanton"}],["$","small",null,{"children":"Administered Army implementation under the proclamation and the expanding recruitment of Black soldiers"}]]}],["$","div","Navy Department-Secretary of the Navy Gideon Welles",{"className":"command-entry","children":[["$","strong",null,{"children":"Navy Department"}],["$","span",null,{"children":"Secretary of the Navy Gideon Welles"}],["$","small",null,{"children":"Administered naval recognition of freedom and the reception of Black men into United States naval service"}]]}]]]}],["$","section","United States military chain of command",{"className":"command-column #47704f","children":[["$","h3",null,{"children":"United States military chain of command"}],[["$","div","Commander in Chief of the Army and Navy-President Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in Chief of the Army and Navy"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Claimed wartime authority for the proclamation and bound military and naval authorities to recognize and maintain the freedom it declared"}]]}],["$","div","General in Chief of the Army-Maj. Gen. Henry W. Halleck",{"className":"command-entry","children":[["$","strong",null,{"children":"General in Chief of the Army"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Senior professional Army officer beneath the president and War Department during the final proclamation period"}]]}],["$","div","Army of the Potomac through November 7, 1862-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac through November 7, 1862"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Relieved after failing to pursue Lee aggressively following Antietam; his removal occurred during the hundred-day interval"}]]}],["$","div","Army of the Potomac from November 7, 1862-Maj. Gen. Ambrose E. Burnside",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac from November 7, 1862"}],["$","span",null,{"children":"Maj. Gen. Ambrose E. Burnside"}],["$","small",null,{"children":"Succeeded McClellan and commanded the army in its December defeat at Fredericksburg"}]]}]]]}],["$","section","Confederate national and eastern-theater authority",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederate national and eastern-theater authority"}],[["$","div","Confederate chief executive and commander in chief-President Jefferson Davis",{"className":"command-entry","children":["$L69","$L6a","$L6b"]}],"$L6c"]]}]]}],"$L6d","$L6e"]}]
33:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep204-proclamation-scope.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep204-proclamation-scope.svg","alt":"Diagram comparing territory covered and omitted by the final proclamation with its military enforcement and the Thirteenth Amendment.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The final proclamation was geographically limited but legally operative: it declared freedom in designated rebel territory and committed United States civil and military authority to maintain it."}]]}],["$","figure","/images/ep204-final-proclamation-draft.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep204-final-proclamation-draft.jpg","alt":"First page of the facsimile preserving Lincoln’s handwritten final draft of the Emancipation Proclamation.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A lithographic copy preserves the appearance of Lincoln’s final handwritten draft. The actual official engrossed proclamation is a separate five-page record held by the National Archives."}]]}],["$","figure","/images/ep204-lincoln-writing-proclamation.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep204-lincoln-writing-proclamation.jpg","alt":"A symbolic color lithograph from 1863 showing Lincoln writing the proclamation in a room filled with political emblems.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Contextual image: David Gilmour Blythe’s fanciful scene was issued as a color lithograph in 1863. It is not an eyewitness depiction of the quiet signing in Lincoln’s second-floor White House office."}]]}],["$","figure","/images/ep204-arrival-in-camp.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep204-arrival-in-camp.jpg","alt":"An 1863 period drawing showing an African American family arriving by wagon at a United States military camp.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Contextual image: this 1863 period drawing, titled “An arrival in Camp—under the Proclamation of Emancipation,” represents African American movement toward United States lines. It is an illustrative scene, not a record of a specific arrival discussed in the episode."}]]}]]}]]}]
