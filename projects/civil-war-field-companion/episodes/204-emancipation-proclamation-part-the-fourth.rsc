31:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States civilian authority",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States civilian authority"}],[["$","div","Chief executive-President Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief executive"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Issued the proclamation, determined its geographic reach, approved its final text, and directed the executive government to recognize and maintain freedom"}]]}],["$","div","Department of State-Secretary of State William H. Seward",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of State"}],["$","span",null,{"children":"Secretary of State William H. Seward"}],["$","small",null,{"children":"Oversaw preparation of the corrected engrossed copy, attested the final proclamation, and caused the United States seal to be affixed"}]]}],["$","div","War Department-Secretary of War Edwin M. Stanton",{"className":"command-entry","children":[["$","strong",null,{"children":"War Department"