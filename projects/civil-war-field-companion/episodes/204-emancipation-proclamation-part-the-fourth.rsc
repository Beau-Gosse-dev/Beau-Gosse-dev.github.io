32:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep204-proclamation-scope.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep204-proclamation-scope.svg","alt":"Diagram comparing territory covered and omitted by the final proclamation with its military enforcement and the Thirteenth Amendment.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The final proclamation was geographically limited but legally operative: it declared freedom in designated rebel territory and committed United States civil and military authority to maintain it."}]]}],["$","figure","/images/ep204-final-proclamation-draft.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep204-final-proclamation-draft.jpg","alt":"First page of the facsimile preserving Lincoln’s handwritten final draft of the Emancipation Proclamation.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A lithographic copy preserves the appearance of Lincoln’s final handwritten draft. The actual official engrossed proclamation is a separate five-page record held by the National Archives."}]]}],["$","figure","/images/ep204-lincoln-writing-proclamation.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep204-lincoln-writing-proclamation.jpg","alt":"A symbolic color lithograph from 1863 showing Lincoln writing the proclamation in a room filled with political emblems.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Contextual image: David Gilmour Blythe’s fanciful scene was issued as a color lithograph in 1863. It is not an eyewitness depiction of the quiet signing in Lincoln’s second-floor White House office."}]]}],["$","figure","/images/ep204-arrival-in-camp.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep204-arrival-in-camp.jpg","alt":"An 1863 period drawing showing an African American family arriving by wagon at a United States military camp.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Contextual image: this 1863 period drawing, titled “An arrival in Camp—under the Proclamation of Emancipation,” represents African American movement toward United States lines. It is an illustrative scene, not a record of a specific arrival discussed in the episode."}]]}]]}]]}]
