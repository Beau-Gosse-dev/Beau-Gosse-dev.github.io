e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Camden Expedition in Arkansas"}],["$","span",null,{"children":"The route ran from Little Rock into southwestern Arkansas. The final operations centered on Camden, the wagon-train battlefields, and Steele’s retreat through Jenkins’ Ferry."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
f:["$","figure","Retreat route and Jenkins’ Ferry positions",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/camden-expedition-retreat-map.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Retreat route and Jenkins’ Ferry positions at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/camden-expedition-retreat-map.svg","alt":"Schematic map of Steele’s retreat and the battle of Jenkins’ Ferry","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Retreat route and Jenkins’ Ferry positions"}],["$","span",null,{"children":"After losing the Marks’ Mills supply train, Steele left Camden, crossed the Ouachita River, and marched toward Jenkins’ Ferry. His infantry defended the west bank of the flooded Saline River while the army crossed."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/camden-expedition-retreat-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://npgallery.nps.gov/GetAsset/d1199979-6b82-44ff-bf64-200b6b16dea0","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
