1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",474," · ","April 16–May 3, 1864"," · ","Camden, Poison Spring, Marks’ Mills, Jenkins’ Ferry, and Little Rock, Arkansas"]}],["$","h1",null,{"children":"RED RIVER CAMPAIGN (Part the Eighth)"}],["$","span",null,{"className":"result-label","children":"Steele occupied Camden but could not supply his 15,000-man force. Confederate troops destroyed or captured Union wagon trains at Poison Spring and Marks’ Mills, and Confederate soldiers murdered many Black Union troops at Poison Spring. Steele evacuated Camden on April 26. At Jenkins’ Ferry on April 30, his infantry used flooded ground, abatis, and breastworks to defeat repeated Confederate attacks while the army crossed the Saline River. Steele reached Little Rock on May 3. The Arkansas column never joined Banks, and the Camden Expedition failed"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6499804913.mp3?updated=1731288448","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Steele reached Camden",{"children":[["$","span",null,{"children":"Steele reached Camden"}],["$","strong",null,{"children":"April 16, 1864"}],"$undefined"]}],["$","div","Poison Spring",{"children":[["$","span",null,{"children":"Poison Spring"}],["$","strong",null,{"children":"April 18, 1864"}],"$undefined"]}],["$","div","Marks’ Mills",{"children":[["$","span",null,{"children":"Marks’ Mills"}],["$","strong",null,{"children":"April 25, 1864"}],"$undefined"]}],["$","div","Camden evacuated",{"children":[["$","span",null,{"children":"Camden evacuated"}],["$","strong",null,{"children":"Night of April 26–27"}],"$undefined"]}],["$","div","Jenkins’ Ferry",{"children":[["$","span",null,{"children":"Jenkins’ Ferry"}],["$","strong",null,{"children":"April 30, 1864"}],"$undefined"]}],["$","div","Steele reached Little Rock",{"children":[["$","span",null,{"children":"Steele reached Little Rock"}],["$","strong",null,{"children":"May 3, 1864"}],"$undefined"]}],["$","div","Campaign losses stated in episode",{"children":[["$","span",null,{"children":"Campaign losses stated in episode"}],["$","strong",null,{"children":"U.S. 2,750; Confederate about 2,300"}],"$undefined"]}],["$","div","Union transport losses",{"children":[["$","span",null,{"children":"Union transport losses"}],["$","strong",null,{"children":"More than 600 wagons and 9 cannon"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$