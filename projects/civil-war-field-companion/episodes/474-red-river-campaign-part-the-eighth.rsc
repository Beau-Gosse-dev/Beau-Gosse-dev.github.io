18:["$","div","Fagan moved against the supply column",{"className":"moment","children":[["$","$L17",null,{"seconds":561,"label":"9:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fagan moved against the supply column"}],["$","p",null,{"children":"Learning that 240 wagons were approaching from Pine Bluff, he made a forced march to Marks’ Mills."}]]}]]}]
19:["$","div","The Union column camped without pickets",{"className":"moment","children":[["$","$L17",null,{"seconds":639,"label":"10:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Union column camped without pickets"}],["$","p",null,{"children":"Francis Drake’s escort included about 1,440 soldiers and at least 300 civilians and freedom seekers."}]]}]]}]
1a:["$","div","Marks’ Mills began on April 25",{"className":"moment","children":[["$","$L17",null,{"seconds":659,"label":"10:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Marks’ Mills began on April 25"}],["$","p",null,{"children":"Fagan attacked from the front and flank. Shelby’s arriving brigade helped overwhelm the Union infantry."}]]}]]}]
1b:["$","div","The Union force surrendered",{"className":"moment","children":[["$","$L17",null,{"seconds":685,"label":"11:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Union force surrendered"}],["$","p",null,{"children":"Drake was wounded. The episode reports about 1,300 Union casualties, most of them captured, and the loss of the supply train."}]]}]]}]
1c:["$","div","Steele decided to abandon Camden",{"className":"moment","children":[["$","$L17",null,{"seconds":719,"label":"11:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Steele decided to abandon Camden"}],["$","p",null,{"children":"Without the food carried in the captured wagons, he could not sustain 15,000 men and 9,000 horses and mules."}]]}]]}]
1d:["$","div","The evacuation began after dark",{"className":"moment","children":[["$","$L17",null,{"seconds":828,"label":"13:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"The evacuation began after dark"}],["$","p",null,{"children":"Steele crossed the Ouachita River on the night of April 26 and removed the pontoon bridge. Confederates entered Camden the next morning."}]]}]]}]
1e:["$","div","Steele marched toward Jenkins’ Ferry",{"className":"moment","children":[["$","$L17",null,{"seconds":895,"label":"14:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Steele marched toward Jenkins’ Ferry"}],["$","p",null,{"children":"He chose that route to avoid the Moro Bottoms. Soldiers discarded equipment and personal property to move faster."}]]}]]}]
1f:["$","div","High water blocked the Saline River",{"className":"moment","children":[["$","$L17",null,{"seconds":945,"label":"15:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"High water blocked the Saline River"}],["$","p",null,{"children":"Steele reached Jenkins’ Ferry on April 29 and built a pontoon bridge. Wagons and artillery began crossing late that afternoon."}]]}]]}]
20:["$","div","Marmaduke engaged the rear guard",{"className":"moment","children":[["$","$L17",null,{"seconds":975,"label":"16:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Marmaduke engaged the rear guard"}],["$","p",null,{"children":"Confederate cavalry began skirmishing early on April 30 while infantry came up behind it."}]]}]]}]
21:["$","div","Terrain restricted the battlefield",{"className":"moment","children":[["$","$L17",null,{"seconds":993,"label":"16:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Terrain restricted the battlefield"}],["$","p",null,{"children":"Bluffs, a bayou, woods, flooded fields, and standing water left little room to deploy. U.S. troops built breastworks and abatis near the ferry road."}]]}]]}]
22:["$","div","Price ordered frontal attacks",{"className":"moment","children":[["$","$L17",null,{"seconds":1045,"label":"17:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Price ordered frontal attacks"}],["$","p",null,{"children":"Churchill’s and Marmaduke’s troops advanced in separate, poorly coordinated assaults across about a quarter mile of flooded open ground."}]]}]]}]
23:["$","div","Union fire defeated the first attacks",{"className":"moment","children":[["$","$L17",null,{"seconds":1098,"label":"18:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Union fire defeated the first attacks"}],["$","p",null,{"children":"Most of Steele’s infantry was still west of the river, not merely a small rear guard. Musketry and artillery stopped Churchill and Parsons."}]]}]]}]
24:["$","div","Walker’s division attacked",{"className":"moment","children":[["$","$L17",null,{"seconds":1119,"label":"18:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Walker’s division attacked"}],["$","p",null,{"children":"Kirby Smith committed another division after the earlier assaults failed. All three of Walker’s brigade commanders were wounded; Horace Randal and William Scurry were mortally wounded."}]]}]]}]
25:["$","div","Steele completed the crossing",{"className":"moment","children":[["$","$L17",null,{"seconds":1150,"label":"19:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Steele completed the crossing"}],["$","p",null,{"children":"After the final Confederate attack withdrew, the Union infantry crossed the Saline and removed the pontoon bridge."}]]}]]}]
26:["$","div","The retreating army ran out of food",{"className":"moment","children":[["$","$L17",null,{"seconds":1184,"label":"19:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The retreating army ran out of food"}],["$","p",null,{"children":"Hunger and exhaustion continued until the head of the column met supply wagons at Benton on May 2."}]]}]]}]
27:["$","div","Steele reached Little Rock",{"className":"moment","children":[["$","$L17",null,{"seconds":1210,"label":"20:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Steele reached Little Rock"}],["$","p",null,{"children":"The army returned safely on May 3. Kirby Smith could not cross the Saline without a pontoon bridge and ended the pursuit."}]]}]]}]
28:["$","div","The campaign had heavy losses",{"className":"moment","children":[["$","$L17",null,{"seconds":1248,"label":"20:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign had heavy losses"}],["$","p",null,{"children":"The episode reports 800–1,000 Confederate casualties at Jenkins’ Ferry, roughly 2,300 Confederate and 2,750 U.S. losses in the Arkansas campaign, and more than 600 Union wagons lost."}]]}]]}]
29:["$","div","Randal and Scurry died",{"className":"moment","children":[["$","$L17",null,{"seconds":1288,"label":"21:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Randal and Scurry died"}],["$","p",null,{"children":"Both brigade commanders died from their Jenkins’ Ferry wounds on April 30 and were buried at Tulip."}]]}]]}]
