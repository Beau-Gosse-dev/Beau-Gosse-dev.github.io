d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",474," · ","April 16–May 3, 1864"," · ","Camden, Poison Spring, Marks’ Mills, Jenkins’ Ferry, and Little Rock, Arkansas"]}],["$","h1",null,{"children":"RED RIVER CAMPAIGN (Part the Eighth)"}],["$","span",null,{"className":"result-label","children":"Steele occupied Camden but could not supply his 15,000-man force. Confederate troops destroyed or captured Union wagon trains at Poison Spring and Marks’ Mills, and Confederate soldiers murdered many Black Union troops at Poison Spring. Steele evacuated Camden on April 26. At Jenkins’ Ferry on April 30, his infantry used flooded ground, abatis, and breastworks to defeat repeated Confederate attacks while the army crossed the Saline River. Steele reached Little Rock on May 3. The Arkansas column never joined Banks, and the Camden Expedition failed"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 16–May 3, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Camden, Poison Spring, Marks’ Mills, Jenkins’ Ferry, and Little Rock, Arkansas"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Steele occupied Camden but could not supply his 15,000-man force. Confederate troops destroyed or captured Union wagon trains at Poison Spring and Marks’ Mills, and Confederate soldiers murdered many Black Union troops at Poison Spring. Steele evacuated Camden on April 26. At Jenkins’ Ferry on April 30, his infantry used flooded ground, abatis, and breastworks to defeat repeated Confederate attacks while the army crossed the Saline River. Steele reached Little Rock on May 3. The Arkansas column never joined Banks, and the Camden Expedition failed"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"April 16–May 3, 1864","place":"Camden, Poison Spring, Marks’ Mills, Jenkins’ Ferry, and Little Rock, Arkansas","result":"Steele occupied Camden but could not supply his 15,000-man force. Confederate troops destroyed or captured Union wagon trains at Poison Spring and Marks’ Mills, and Confederate soldiers murdered many Black Union troops at Poison Spring. Steele evacuated Camden on April 26. At Jenkins’ Ferry on April 30, his infantry used flooded ground, abatis, and breastworks to defeat repeated Confederate attacks while the army crossed the Saline River. Steele reached Little Rock on May 3. The Arkansas column never joined Banks, and the Camden Expedition failed","facts":[{"label":"Steele reached Camden","value":"April 16, 1864"},{"label":"Poison Spring","value":"April 18, 1864"},{"label":"Marks’ Mills","value":"April 25, 1864"},{"label":"Camden evacuated","value":"Night of April 26–27"},{"label":"Jenkins’ Ferry","value":"April 30, 1864"},{"label":"Steele reached Little Rock","value":"May 3, 1864"},{"label":"Campaign losses stated in episode","value":"U.S. 2,750; Confederate about 2,300"},{"label":"Union transport losses","value":"More than 600 wagons and 9 cannon"}],"maps":[{"title":"The Camden Expedition in Arkansas","caption":"The route ran from Little Rock into southwestern Arkansas. The final operations centered on Camden, the wagon-train battlefields, and Steele’s retreat through Jenkins’ Ferry.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-93.45%2C33.40%2C-91.75%2C35.10&layer=mapnik&marker=33.5846%2C-92.8343"},{"title":"Retreat route and Jenkins’ Ferry positions","caption":"After losing the Marks’ Mills supply train, Steele left Camden, crossed the Ouachita River, and marched toward Jenkins’ Ferry. His infantry defended the west bank of the flooded Saline River while the army crossed.","source":"https://npgallery.nps.gov/GetAsset/d1199979-6b82-44ff-bf64-200b6b16dea0","image":"/images/camden-expedition-retreat-map.svg","alt":"Schematic map of Steele’s retreat and the battle of Jenkins’ Ferry"},{"title":"The Red River campaign theater","caption":"The period map shows the Red River corridor and the region in which Steele’s Arkansas column was supposed to converge with Banks near Shreveport.","source":"https://www.loc.gov/item/2008626486/","image":"/images/red-river-campaign-1864-map.jpg","alt":"Historical map of the Red River campaign region in Louisiana and Arkansas"}],"moments":[{"time":"1:18","audioTime":78,"title":"Both parts of the Red River plan were failing","detail":"Banks had retreated after Mansfield and Pleasant Hill. Steele had turned toward Camden because supply shortages prevented him from continuing toward Shreveport."},{"time":"2:29","audioTime":149,"title":"Kirby Smith moved infantry into Arkansas","detail":"He took most of Richard Taylor’s infantry north to join Sterling Price and John Marmaduke against Steele."},{"time":"3:05","audioTime":185,"title":"Steele reached Camden","detail":"He entered the fortified town on April 16 with about 15,000 men but urgently needed food and forage."},{"time":"3:24","audioTime":204,"title":"A foraging train left Camden","detail":"On April 17, Steele sent 198 wagons, two cannon, and 200 men of the 1st Kansas Colored Cavalry into the countryside."},{"time":"4:14","audioTime":254,"title":"The escort grew to about 1,000 men","detail":"Additional infantry, cavalry, and two mountain howitzers joined the column on April 18."},{"time":"4:46","audioTime":286,"title":"Marmaduke prepared an ambush","detail":"About 3,100 Confederate cavalrymen positioned themselves at Poison Spring."},{"time":"5:03","audioTime":303,"title":"The Confederate attack split the escort","detail":"James Williams arranged his troops around the long wagon train. Confederate forces struck its front and right flank."},{"time":"6:08","audioTime":368,"title":"The wagon train was lost","detail":"Confederates captured all 198 wagons and four cannon. The episode gives 301 U.S. casualties, including 182 from the 1st Kansas Colored, and 115 Confederate casualties."},{"time":"6:38","audioTime":398,"title":"Black Union soldiers were murdered","detail":"Confederate accounts confirm that many soldiers refused surrender from Black troops and killed wounded or captured men after the fighting."},{"time":"7:17","audioTime":437,"title":"Steele questioned Banks’s reports","detail":"Banks claimed victories in Louisiana while also reporting a retreat. Steele concluded that Confederate concentration made a march south impossible."},{"time":"8:41","audioTime":521,"title":"Kirby Smith took field command","detail":"He reached the Camden area on April 19 and ordered Fagan and Shelby between Steele and Little Rock while other divisions threatened Camden."},{"time":"9:21","audioTime":561,"title":"Fagan moved against the supply column","detail":"Learning that 240 wagons were approaching from Pine Bluff, he made a forced march to Marks’ Mills."},{"time":"10:39","audioTime":639,"title":"The Union column camped without pickets","detail":"Francis Drake’s escort included about 1,440 soldiers and at least 300 civilians and freedom seekers."},{"time":"10:59","audioTime":659,"title":"Marks’ Mills began on April 25","detail":"Fagan attacked from the front and flank. Shelby’s arriving brigade helped overwhelm the Union infantry."},{"time":"11:25","audioTime":685,"title":"The Union force surrendered","detail":"Drake was wounded. The episode reports about 1,300 Union casualties, most of them captured, and the loss of the supply train."},{"time":"11:59","audioTime":719,"title":"Steele decided to abandon Camden","detail":"Without the food carried in the captured wagons, he could not sustain 15,000 men and 9,000 horses and mules."},{"time":"13:48","audioTime":828,"title":"The evacuation began after dark","detail":"Steele crossed the Ouachita River on the night of April 26 and removed the pontoon bridge. Confederates entered Camden the next morning."},{"time":"14:55","audioTime":895,"title":"Steele marched toward Jenkins’ Ferry","detail":"He chose that route to avoid the Moro Bottoms. Soldiers discarded equipment and personal property to move faster."},{"time":"15:45","audioTime":945,"title":"High water blocked the Saline River","detail":"Steele reached Jenkins’ Ferry on April 29 and built a pontoon bridge. Wagons and artillery began crossing late that afternoon."},{"time":"16:15","audioTime":975,"title":"Marmaduke engaged the rear guard","detail":"Confederate cavalry began skirmishing early on April 30 while infantry came up behind it."},{"time":"16:33","audioTime":993,"title":"Terrain restricted the battlefield","detail":"Bluffs, a bayou, woods, flooded fields, and standing water left little room to deploy. U.S. troops built breastworks and abatis near the ferry road."},{"time":"17:25","audioTime":1045,"title":"Price ordered frontal attacks","detail":"Churchill’s and Marmaduke’s troops advanced in separate, poorly coordinated assaults across about a quarter mile of flooded open ground."},{"time":"18:18","audioTime":1098,"title":"Union fire defeated the first attacks","detail":"Most of Steele’s infantry was still west of the river, not merely a small rear guard. Musketry and artillery stopped Churchill and Parsons."},{"time":"18:39","audioTime":1119,"title":"Walker’s division attacked","detail":"Kirby Smith committed another division after the earlier assaults failed. All three of Walker’s brigade commanders were wounded; Horace Randal and William Scurry were mortally wounded."},{"time":"19:10","audioTime":1150,"title":"Steele completed the crossing","detail":"After the final Confederate attack withdrew, the Union infantry crossed the Saline and removed the pontoon bridge."},{"time":"19:44","audioTime":1184,"title":"The retreating army ran out of food","detail":"Hunger and exhaustion continued until the head of the column met supply wagons at Benton on May 2."},{"time":"20:10","audioTime":1210,"title":"Steele reached Little Rock","detail":"The army returned safely on May 3. Kirby Smith could not cross the Saline without a pontoon bridge and ended the pursuit."},{"time":"20:48","audioTime":1248,"title":"The campaign had heavy losses","detail":"The episode reports 800–1,000 Confederate casualties at Jenkins’ Ferry, roughly 2,300 Confederate and 2,750 U.S. losses in the Arkansas campaign, and more than 600 Union wagons lost."},{"time":"21:28","audioTime":1288,"title":"Randal and Scurry died","detail":"Both brigade commanders died from their Jenkins’ Ferry wounds on April 30 and were buried at Tulip."}],"command":[{"side":"United States","color":"#315f8c","branches":[{"commander":"Frederick Steele","command":"Department of Arkansas","subordinates":"About 15,000 men at Camden; ordered the retreat to Little Rock"},{"commander":"James M. Williams","command":"Poison Spring wagon escort","subordinates":"About 1,000 men, including the 1st Kansas Colored"},{"commander":"Francis M. Drake","command":"Marks’ Mills wagon escort","subordinates":"Three infantry regiments and attached cavalry"}]},{"side":"Confederacy","color":"#9a3d32","branches":[{"commander":"E. Kirby Smith","command":"Trans-Mississippi Department","subordinates":"Took direct control of operations against Steele"},{"commander":"Sterling Price","command":"District of Arkansas","subordinates":"Directed field forces with Smith at Jenkins’ Ferry"},{"commander":"John S. Marmaduke","command":"Cavalry division","subordinates":"Attacked at Poison Spring and pursued Steele"},{"commander":"James F. Fagan","command":"Cavalry division","subordinates":"Captured the Marks’ Mills supply train"},{"commander":"Thomas J. Churchill, Mosby M. Parsons, and John G. Walker","command":"Infantry divisions","subordinates":"Conducted the Confederate assaults at Jenkins’ Ferry"}]}],"people":[{"name":"Frederick Steele","role":"Abandoned Camden and returned his army to Little Rock","side":"United States"},{"name":"James M. Williams","role":"Commanded the Union escort defeated at Poison Spring","side":"United States"},{"name":"Francis M. Drake","role":"Commanded the Union escort captured at Marks’ Mills","side":"United States"},{"name":"E. Kirby Smith","role":"Concentrated Confederate infantry in Arkansas and ordered the Jenkins’ Ferry attacks","side":"Confederacy"},{"name":"Sterling Price","role":"Senior Arkansas commander during the operations against Steele","side":"Confederacy"},{"name":"John S. Marmaduke","role":"Commanded the Poison Spring ambush and part of the pursuit","side":"Confederacy"},{"name":"James F. Fagan","role":"Commanded the Confederate victory at Marks’ Mills","side":"Confederacy"}],"losses":[{"name":"Horace Randal","side":"Confederacy","role":"Brigadier general commanding a brigade in Walker’s division","outcome":"Mortally wounded at Jenkins’ Ferry and died on April 30, 1864."},{"name":"William Read Scurry","side":"Confederacy","role":"Brigadier general commanding a Texas brigade in Walker’s division","outcome":"Mortally wounded at Jenkins’ Ferry and died on April 30, 1864."}],"gallery":[{"image":"/images/poison-spring-battlefield.jpg","alt":"Present-day view of Poison Spring battlefield in Arkansas","caption":"The April 18 attack destroyed Steele’s foraging train. Confederate soldiers killed many wounded and captured Black Union troops after the battle.","source":"https://commons.wikimedia.org/wiki/File:Poison_Spring_Battlefield_Arkansas.jpg"},{"image":"/images/marks-mills-battlefield.jpg","alt":"Present-day view of Marks’ Mills battlefield in Arkansas","caption":"The capture of the Marks’ Mills supply train on April 25 forced Steele to leave Camden.","source":"https://commons.wikimedia.org/wiki/File:Marks_Mills_Battlefield_Arkansas.jpg"}],"sources":[{"label":"Civil War Podcast episode 474","url":"https://civilwarpodcast.org/2024/11/10/civil-war-podcast-episode-474/"},{"label":"National Park Service: Marks’ Mills battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ar015"},{"label":"National Park Service: Arkansas Civil War operations","url":"https://www.nps.gov/civilwar/arkansas.htm"},{"label":"National Park Service: Jenkins’ Ferry historic documentation","url":"https://npgallery.nps.gov/GetAsset/d1199979-6b82-44ff-bf64-200b6b16dea0"},{"label":"Arkansas Heritage: Camden Expedition landmarks","url":"https://www.arkansasheritage.com/arkansas-preservation/properties/national-historic-landmarks"},{"label":"Library of Congress: Louisiana and Arkansas map","url":"https://www.loc.gov/item/99447188/"}]}}]}],"$L10",false,"$L11","$L12","$L13","$L14","$L15","$L16"]}]]}]
