11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Both parts of the Red River plan were failing",{"className":"moment","children":[["$","$L17",null,{"seconds":78,"label":"1:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both parts of the Red River plan were failing"}],["$","p",null,{"children":"Banks had retreated after Mansfield and Pleasant Hill. Steele had turned toward Camden because supply shortages prevented him from continuing toward Shreveport."}]]}]]}],["$","div","Kirby Smith moved infantry into Arkansas",{"className":"moment","children":[["$","$L17",null,{"seconds":149,"label":"2:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kirby Smith moved infantry into Arkansas"}],["$","p",null,{"children":"He took most of Richard Taylor’s infantry north to join Sterling Price and John Marmaduke against Steele."}]]}]]}],["$","div","Steele reached Camden",{"className":"moment","children":[["$","$L17",null,{"seconds":185,"label":"3:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Steele reached Camden"}],["$","p",null,{"children":"He entered the fortified town on April 16 with about 15,000 men but urgently needed food and forage."}]]}]]}],["$","div","A foraging train left Camden",{"className":"moment","children":[["$","$L17",null,{"seconds":204,"label":"3:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"A foraging train left Camden"}],["$","p",null,{"children":"On April 17, Steele sent 198 wagons, two cannon, and 200 men of the 1st Kansas Colored Cavalry into the countryside."}]]}]]}],["$","div","The escort grew to about 1,000 men",{"className":"moment","children":[["$","$L17",null,{"seconds":254,"label":"4:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The escort grew to about 1,000 men"}],["$","p",null,{"children":"Additional infantry, cavalry, and two mountain howitzers joined the column on April 18."}]]}]]}],["$","div","Marmaduke prepared an ambush",{"className":"moment","children":[["$","$L17",null,{"seconds":286,"label":"4:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Marmaduke prepared an ambush"}],["$","p",null,{"children":"About 3,100 Confederate cavalrymen positioned themselves at Poison Spring."}]]}]]}],["$","div","The Confederate attack split the escort",{"className":"moment","children":[["$","$L17",null,{"seconds":303,"label":"5:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate attack split the escort"}],["$","p",null,{"children":"James Williams arranged his troops around the long wagon train. Confederate forces struck its front and right flank."}]]}]]}],["$","div","The wagon train was lost",{"className":"moment","children":[["$","$L17",null,{"seconds":368,"label":"6:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The wagon train was lost"}],["$","p",null,{"children":"Confederates captured all 198 wagons and four cannon. The episode gives 301 U.S. casualties, including 182 from the 1st Kansas Colored, and 115 Confederate casualties."}]]}]]}],["$","div","Black Union soldiers were murdered",{"className":"moment","children":[["$","$L17",null,{"seconds":398,"label":"6:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Black Union soldiers were murdered"}],["$","p",null,{"children":"Confederate accounts confirm that many soldiers refused surrender from Black troops and killed wounded or captured men after the fighting."}]]}]]}],["$","div","Steele questioned Banks’s reports",{"className":"moment","children":[["$","$L17",null,{"seconds":437,"label":"7:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Steele questioned Banks’s reports"}],["$","p",null,{"children":"Banks claimed victories in Louisiana while also reporting a retreat. Steele concluded that Confederate concentration made a march south impossible."}]]}]]}],["$","div","Kirby Smith took field command",{"className":"moment","children":[["$","$L17",null,{"seconds":521,"label":"8:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kirby Smith took field command"}],["$","p",null,{"children":"He reached the Camden area on April 19 and ordered Fagan and Shelby between Steele and Little Rock while other divisions threatened Camden."}]]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
