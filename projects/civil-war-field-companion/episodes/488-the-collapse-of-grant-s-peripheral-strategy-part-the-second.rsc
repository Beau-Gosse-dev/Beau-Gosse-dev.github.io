f:["$","figure","New Market in the Shenandoah Valley today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-78.83%2C38.55%2C-78.52%2C38.83&layer=mapnik&marker=38.6576%2C-78.6714","title":"New Market in the Shenandoah Valley today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"New Market in the Shenandoah Valley today"}],["$","span",null,{"children":"The battlefield lies between the North Fork of the Shenandoah River and Smith Creek, along the Valley Turnpike south of Mount Jackson. These waterways limited both armies’ room to maneuver."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
10:["$","figure","The wider 1864 Virginia campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The wider 1864 Virginia campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of the 1864 campaign in Virginia","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The wider 1864 Virginia campaign"}],["$","span",null,{"children":"Sigel’s force advanced south through the Shenandoah Valley while Crook and Averell operated against the Virginia and Tennessee Railroad farther southwest. Their withdrawals allowed Breckinridge to move east by rail toward Lee."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Crook returned to West Virginia after Cloyd’s Mountain",{"className":"moment","children":[["$","$L17",null,{"seconds":99,"label":"1:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crook returned to West Virginia after Cloyd’s Mountain"}],["$","p",null,{"children":"His column reached Union on May 14. Averell’s cavalry arrived the next day after abandoning its own objectives in southwestern Virginia."}]]}]]}],["$","div","Averell began his raid from Charleston",{"className":"moment","children":[["$","$L17",null,{"seconds":127,"label":"2:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Averell began his raid from Charleston"}],["$","p",null,{"children":"The cavalry crossed difficult mountain country and reached Jeffersonville on May 8. Reports exaggerated the Confederate force protecting the Saltville salt works."}]]}]]}],["$","div","Averell turned from Saltville and was stopped near Wytheville",{"className":"moment","children":[["$","$L17",null,{"seconds":172,"label":"2:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Averell turned from Saltville and was stopped near Wytheville"}],["$","p",null,{"children":"William E. Jones and John Hunt Morgan attacked with about 4,500 Confederates and repeatedly forced the U.S. cavalry back during a four-hour fight."}]]}]]}],["$","div","Averell reached the railroad after Crook",{"className":"moment","children":[["$","$L17",null,{"seconds":232,"label":"3:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Averell reached the railroad after Crook"}],["$","p",null,{"children":"At Dublin Depot he found damage already caused by Crook. He destroyed several miles of track near Christiansburg but did not continue east toward Lynchburg as Crook directed."}]]}]]}],["$","div","Crook reported substantial tactical results",{"className":"moment","children":[["$","$L17",null,{"seconds":312,"label":"5:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crook reported substantial tactical results"}],["$","p",null,{"children":"His force destroyed the Dublin bridge, eighteen miles of railroad, depots, and stores, captured ten guns and about three hundred prisoners, and defeated the Confederate force at Cloyd’s Mountain."}]]}]]}],["$","div","The raids no longer supported Grant’s main campaign",{"className":"moment","children":[["$","$L17",null,{"seconds":402,"label":"6:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"The raids no longer supported Grant’s main campaign"}],["$","p",null,{"children":"By May 11 both western columns were withdrawing. They were no longer threatening Confederate infrastructure or preventing troops from moving to Lee."}]]}]]}],["$","div","False reports influenced Crook’s withdrawal",{"className":"moment","children":[["$","$L17",null,{"seconds":442,"label":"7:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"False reports influenced Crook’s withdrawal"}],["$","p",null,{"children":"Captured dispatches incorrectly said Grant had been defeated and was retreating. Crook expected reinforcements from Lee to arrive by railroad and chose not to continue."}]]}]]}],["$","div","Sigel advanced up the Shenandoah Valley",{"className":"moment","children":[["$","$L17",null,{"seconds":520,"label":"8:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sigel advanced up the Shenandoah Valley"}],["$","p",null,{"children":"His force of nearly 9,000 used the Valley Turnpike. The campaign threatened the region’s food production and the railroad facilities at Staunton."}]]}]]}],["$","div","Sigel left Cedar Creek on May 11",{"className":"moment","children":[["$","$L17",null,{"seconds":629,"label":"10:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sigel left Cedar Creek on May 11"}],["$","p",null,{"children":"Captured messages at Woodstock told him that Breckinridge was approaching with roughly 4,000 to 4,500 troops. John D. Imboden’s cavalry and local home guards delayed the advance."}]]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","Department of West Virginia and Shenandoah Valley column",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of West Virginia and Shenandoah Valley column"}],["$","span",null,{"children":"Franz Sigel"}],["$","small",null,{"children":"Julius Stahel’s cavalry and August Moor’s advance force"}]]}],["$","div","Cavalry division and senior officer at New Market",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry division and senior officer at New Market"}],["$","span",null,{"children":"Julius Stahel"}],["$","small",null,{"children":"Took over Moor’s position before Sigel arrived"}]]}],["$","div","Advance force",{"className":"command-entry","children":[["$","strong",null,{"children":"Advance force"}],["$","span",null,{"children":"August Moor"}],["$","small",null,{"children":"Three infantry regiments, about 1,000 cavalry, and an artillery battery"}]]}],["$","div","Kanawha infantry column",{"className":"command-entry","children":[["$","strong",null,{"children":"Kanawha infantry column"}],["$","span",null,{"children":"George Crook"}],["$","small",null,{"children":"Withdrew to West Virginia after the victory at Cloyd’s Mountain"}]]}],["$","div","Cavalry raid",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry raid"}],["$","span",null,{"children":"William W. Averell"}],["$","small",null,{"children":"Turned away from Saltville and Wytheville and abandoned the advance toward Lynchburg"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Department of Western Virginia field force",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Western Virginia field force"}],["$","span",null,{"children":"John C. Breckinridge"}],["$","small",null,{"children":"Echols’s and Wharton’s brigades, Imboden’s cavalry, local troops, artillery, and the VMI cadets"}]]}],["$","div","Infantry brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Infantry brigade"}],["$","span",null,{"children":"John Echols"}],["$","small",null,{"children":"Advanced on the Confederate left toward Bushong’s Hill"}]]}],["$","div","Infantry brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Infantry brigade"}],["$","span",null,{"children":"Gabriel C. Wharton"}],["$","small",null,{"children":"Advanced with Echols in the main Confederate line"}]]}],["$","div","Cavalry brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry brigade"}],["$","span",null,{"children":"John D. Imboden"}],["$","small",null,{"children":"Screened the approach, covered the Confederate right, and moved artillery east of Smith Creek"}]]}],["$","div","VMI Cadet Battalion",{"className":"command-entry","children":[["$","strong",null,{"children":"VMI Cadet Battalion"}],["$","span",null,{"children":"Scott Shipp"}],["$","small",null,{"children":"Led the cadets into the gap in Breckinridge’s center and was wounded"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Franz Sigel",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/franz-sigel.jpg","alt":"Portrait of Franz Sigel","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Franz Sigel"}],["$","p",null,{"children":"Failed to concentrate his larger force and ordered the retreat after his counterattack collapsed"}]]}]]}],["$","article","August Moor",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AM"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],"$L2a","$L2b"]}]]}],"$L2c","$L2d","$L2e","$L2f","$L30","$L31"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Ten VMI cadets",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Ten VMI cadets"}],["$","p",null,{"children":[["$","strong",null,{"children":["Cadet Battalion, Virginia Military Institute","."]}]," ","Killed or mortally wounded during the advance across the New Market battlefield; another 45 cadets were wounded in the episode’s count"]}]]}],["$","article","Thomas Garland Jefferson",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas Garland Jefferson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Private, Company B, VMI Cadet Battalion","."]}]," ","Mortally wounded on May 15 and died at New Market on May 18 at age seventeen"]}]]}]]}]]}]
14:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/new-market-battlefield-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/new-market-battlefield-map.jpg","alt":"Detailed survey map of New Market battlefield","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The map records the successive lines and times of movement from Shirley’s Hill through New Market to Bushong’s Hill."}]]}],["$","figure","/images/new-market-battlefield-photo.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/new-market-battlefield-photo.jpg","alt":"Late nineteenth-century photograph of the New Market battlefield","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The view shows the open ground crossed by the Confederate line and the VMI cadets, with Massanutten Mountain in the distance."}]]}],["$","figure","/images/franz-sigel.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/franz-sigel.jpg","alt":"Portrait of Major General Franz Sigel","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Sigel had the larger overall force but separated his lines and failed to bring nearly one third of his troops into action."}]]}],["$","figure","/images/vmi-cadet-nicholas-bayard.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/vmi-cadet-nicholas-bayard.jpg","alt":"Portrait of VMI cadet Nicholas James Bayard","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Bayard fought with the VMI Cadet Battalion at New Market. The battalion served as Breckinridge’s final reserve."}]]}]]}]]}]
