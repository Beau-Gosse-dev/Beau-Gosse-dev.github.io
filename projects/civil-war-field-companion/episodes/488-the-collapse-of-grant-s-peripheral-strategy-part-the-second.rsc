11:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2025/03/31/civil-war-podcast-episode-488/",{"href":"https://civilwarpodcast.org/2025/03/31/civil-war-podcast-episode-488/","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast, episode 488"]}],["$","a","https://www.nps.gov/articles/000/battle-of-new-market.htm",{"href":"https://www.nps.gov/articles/000/battle-of-new-market.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of New Market"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va110",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va110","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: New Market battle detail"]}],["$","a","https://www.nps.gov/people/thomas-garland-jefferson.htm",{"href":"https://www.nps.gov/people/thomas-garland-jefferson.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Thomas Garland Jefferson"]}],["$","a","https://www.loc.gov/item/99448860/",{"href":"https://www.loc.gov/item/99448860/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: New Market battlefield map"]}],["$","a","https://www.loc.gov/item/2019631455/",{"href":"https://www.loc.gov/item/2019631455/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: New Market battlefield photograph"]}],["$","a","https://www.loc.gov/item/2022630671/",{"href":"https://www.loc.gov/item/2022630671/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Nicholas James Bayard, VMI cadet"]}]]}]
