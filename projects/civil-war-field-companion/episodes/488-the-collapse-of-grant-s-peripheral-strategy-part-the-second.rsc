18:["$","div","A reconnaissance advanced twenty miles to New Market",{"className":"moment","children":[["$","$L17",null,{"seconds":674,"label":"11:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"A reconnaissance advanced twenty miles to New Market"}],["$","p",null,{"children":"August Moor led 2,350 troops unfamiliar to him and reached the town on May 14 after pushing back Imboden’s cavalry."}]]}]]}]
19:["$","div","Breckinridge’s infantry arrived south of New Market",{"className":"moment","children":[["$","$L17",null,{"seconds":745,"label":"12:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Breckinridge’s infantry arrived south of New Market"}],["$","p",null,{"children":"U.S. patrols reported the concentration around 7 a.m. on May 15. Julius Stahel took command of the 3,350 U.S. troops then at New Market while Sigel approached."}]]}]]}]
1a:["$","div","Sigel marched from Woodstock",{"className":"moment","children":[["$","$L17",null,{"seconds":791,"label":"13:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sigel marched from Woodstock"}],["$","p",null,{"children":"He left at 5 a.m. on May 15 with the rest of the column but had not concentrated every unit before the main battle began."}]]}]]}]
1b:["$","div","Breckinridge assembled a mixed force",{"className":"moment","children":[["$","$L17",null,{"seconds":875,"label":"14:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Breckinridge assembled a mixed force"}],["$","p",null,{"children":"His command included Echols’s and Wharton’s infantry, Imboden’s cavalry, home guards, engineers, eighteen guns, and 227 cadets from the Virginia Military Institute."}]]}]]}]
1c:["$","div","Breckinridge decided to attack",{"className":"moment","children":[["$","$L17",null,{"seconds":942,"label":"15:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Breckinridge decided to attack"}],["$","p",null,{"children":"The North Fork of the Shenandoah and Smith Creek protected his flanks. He concluded that his smaller force could advance without being easily enveloped."}]]}]]}]
1d:["$","div","Confederate countermarching exaggerated troop strength",{"className":"moment","children":[["$","$L17",null,{"seconds":962,"label":"16:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate countermarching exaggerated troop strength"}],["$","p",null,{"children":"Units moved repeatedly on Shirley’s Hill to appear more numerous. U.S. estimates rose as high as 20,000, increasing uncertainty in Sigel’s headquarters."}]]}]]}]
1e:["$","div","Sigel formed two disconnected lines",{"className":"moment","children":[["$","$L17",null,{"seconds":1033,"label":"17:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sigel formed two disconnected lines"}],["$","p",null,{"children":"He placed one line on Bushong’s Hill and another about one thousand yards forward. Some units were still following earlier orders to concentrate at Mount Jackson."}]]}]]}]
1f:["$","div","Confederate artillery struck the U.S. cavalry flank",{"className":"moment","children":[["$","$L17",null,{"seconds":1092,"label":"18:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate artillery struck the U.S. cavalry flank"}],["$","p",null,{"children":"Imboden placed guns east of Smith Creek while Breckinridge advanced his infantry and moved the main artillery forward from hill to hill."}]]}]]}]
20:["$","div","The first U.S. line withdrew",{"className":"moment","children":[["$","$L17",null,{"seconds":1162,"label":"19:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first U.S. line withdrew"}],["$","p",null,{"children":"Echols and Wharton overlapped it on both flanks and followed closely toward Bushong’s Hill. Terrain, smoke, and the rapid advance opened a gap in the Confederate center."}]]}]]}]
21:["$","div","Breckinridge committed the VMI cadets",{"className":"moment","children":[["$","$L17",null,{"seconds":1238,"label":"20:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Breckinridge committed the VMI cadets"}],["$","p",null,{"children":"The cadet battalion was his last available reserve. He ordered it into the gap opposite Stahel’s cavalry to prevent the Confederate line from being divided."}]]}]]}]
22:["$","div","The cadets entered the main battle line",{"className":"moment","children":[["$","$L17",null,{"seconds":1346,"label":"22:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cadets entered the main battle line"}],["$","p",null,{"children":"Musket and artillery fire caused immediate casualties, but the battalion maintained formation and closed the gap near the Bushong orchard."}]]}]]}]
23:["$","div","Sigel ordered an understrength counterattack",{"className":"moment","children":[["$","$L17",null,{"seconds":1469,"label":"24:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sigel ordered an understrength counterattack"}],["$","p",null,{"children":"About 1,700 U.S. soldiers attacked between 2,600 and 2,800 Confederates. The failed charge disrupted Sigel’s line and gave Breckinridge the opportunity to advance again."}]]}]]}]
24:["$","div","The Confederate advance captured five guns",{"className":"moment","children":[["$","$L17",null,{"seconds":1528,"label":"25:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate advance captured five guns"}],["$","p",null,{"children":"VMI cadets took one twelve-pounder Napoleon and other Confederate units captured four additional pieces as U.S. artillery tried to withdraw."}]]}]]}]
25:["$","div","Sigel ordered a general retreat",{"className":"moment","children":[["$","$L17",null,{"seconds":1567,"label":"26:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sigel ordered a general retreat"}],["$","p",null,{"children":"Imboden did not seize the single bridge over the swollen river, allowing the U.S. force to cross beginning around 4:30 p.m."}]]}]]}]
26:["$","div","The U.S. column retreated thirty-two miles",{"className":"moment","children":[["$","$L17",null,{"seconds":1587,"label":"26:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. column retreated thirty-two miles"}],["$","p",null,{"children":"The withdrawal continued through Mount Jackson to Strasburg and ended the following day."}]]}]]}]
27:["$","div","New Market cost more than 1,300 casualties",{"className":"moment","children":[["$","$L17",null,{"seconds":1640,"label":"27:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"New Market cost more than 1,300 casualties"}],["$","p",null,{"children":"The episode counts 841 U.S. casualties and at least 520 Confederate casualties. Nearly one third of Sigel’s full force never entered the battle."}]]}]]}]
28:["$","div","The VMI battalion suffered fifty-five casualties",{"className":"moment","children":[["$","$L17",null,{"seconds":1684,"label":"28:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The VMI battalion suffered fifty-five casualties"}],["$","p",null,{"children":"Ten cadets were killed and forty-five wounded in the episode’s count, about one quarter of the battalion that entered the fight."}]]}]]}]
29:["$","div","Breckinridge sent troops to Lee",{"className":"moment","children":[["$","$L17",null,{"seconds":1755,"label":"29:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Breckinridge sent troops to Lee"}],["$","p",null,{"children":"With Crook, Averell, and Sigel withdrawing, Breckinridge placed about 2,500 men from Echols’s and Wharton’s brigades on trains at Staunton on May 19."}]]}]]}]
