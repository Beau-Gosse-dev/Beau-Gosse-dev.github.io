32:["$","figure","Jedediah Hotchkiss’s map of the Port Republic battlefield",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep153-hotchkiss-port-republic-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Jedediah Hotchkiss’s map of the Port Republic battlefield at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-hotchkiss-port-republic-map.jpg","alt":"Jedediah Hotchkiss topographic map of the Port Republic battlefield and surrounding river crossings.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jedediah Hotchkiss’s map of the Port Republic battlefield"}],["$","span",null,{"children":"Hotchkiss prepared this topographic map from his wartime knowledge and later field work. It is labeled for the June 9 battle and does not plot Carroll’s June 8 raid, but it is a valuable historical source for the rivers, roads, farms, and surrounding heights. Readers should not treat its battle markings as a map of this episode’s morning action."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep153-hotchkiss-port-republic-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Geography and Map Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
34:["$","div","Samuel S. Carroll is introduced",{"className":"moment","children":[["$","$L33",null,{"seconds":702,"label":"11:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Samuel S. Carroll is introduced"}],["$","p",null,{"children":"The twenty-nine-year-old West Point graduate and colonel of the 8th Ohio had a reputation as an energetic officer who pushed himself and his troops hard."}]]}]]}]
35:["$","div","The bridge instructions begin to conflict",{"className":"moment","children":[["$","$L33",null,{"seconds":739,"label":"12:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The bridge instructions begin to conflict"}],["$","p",null,{"children":"The episode says Shields first directed Carroll to save the bridge, then transmitted an order to burn it, followed by an instruction to hold it at all hazards."}]]}]]}]
36:["$","div","Carroll drives through the rain",{"className":"moment","children":[["$","$L33",null,{"seconds":764,"label":"12:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Carroll drives through the rain"}],["$","p",null,{"children":"On June 7 he halted six miles short of Port Republic for a three-hour rest while scouts reported weak pickets and exposed Confederate trains."}]]}]]}]
37:["$","div","The flying column starts at 4:00 a.m.",{"className":"moment","children":[["$","$L33",null,{"seconds":806,"label":"13:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"The flying column starts at 4:00 a.m."}],["$","p",null,{"children":"Carroll led with 150 troopers, accompanied by Capt. Miles Keogh and four guns from Robinson’s Ohio battery. Four infantry regiments followed without baggage."}]]}]]}]
38:["$","div","The head of the column reaches the village approach",{"className":"moment","children":[["$","$L33",null,{"seconds":882,"label":"14:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"The head of the column reaches the village approach"}],["$","p",null,{"children":"At about 6:00 a.m., Carroll halted one mile away and used fog and absent Confederate patrols to inspect the position."}]]}]]}]
39:["$","div","Ashby’s absence matters",{"className":"moment","children":[["$","$L33",null,{"seconds":902,"label":"15:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ashby’s absence matters"}],["$","p",null,{"children":"The episode notes that Confederate cavalry remained disorganized after Turner Ashby’s June 6 death. Hotchkiss later wrote that most of the local cavalry screen fled toward Brown’s Gap."}]]}]]}]
3a:["$","div","A quiet Sunday morning masks the danger",{"className":"moment","children":[["$","$L33",null,{"seconds":961,"label":"16:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"A quiet Sunday morning masks the danger"}],["$","p",null,{"children":"Jackson expected worship services and a tour of the lines. Most Confederates rested, while Taliaferro formed his brigade for inspection and McGuire treated patients in the Methodist church."}]]}]]}]
3b:["$","div","Robinson’s battery is divided",{"className":"moment","children":[["$","$L33",null,{"seconds":1094,"label":"18:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Robinson’s battery is divided"}],["$","p",null,{"children":"Two guns remained on Yost Hill with a view toward the North River bridge. Two were assigned to enter Port Republic with the cavalry."}]]}]]}]
3c:["$","div","Federal guns announce the raid too soon",{"className":"moment","children":[["$","$L33",null,{"seconds":1138,"label":"18:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal guns announce the raid too soon"}],["$","p",null,{"children":"Carroll ordered fire before the mounted force was ready to cross. A shot struck the Methodist church steeple and alarmed the village."}]]}]]}]
3d:["$","div","McGuire encounters Jackson in the street",{"className":"moment","children":[["$","$L33",null,{"seconds":1184,"label":"19:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"McGuire encounters Jackson in the street"}],["$","p",null,{"children":"While McGuire tried to stop ambulance drivers from abandoning patients, Jackson and his staff hurried from Madison Hall toward the North River bridge."}]]}]]}]
3e:["$","div","Jackson discounts the first warnings",{"className":"moment","children":[["$","$L33",null,{"seconds":1208,"label":"20:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson discounts the first warnings"}],["$","p",null,{"children":"Confused cavalry reports did not convince him. The sound of Robinson’s guns finally established that a Federal force was entering the village."}]]}]]}]
3f:["$","div","The cavalry crosses the South River",{"className":"moment","children":[["$","$L33",null,{"seconds":1253,"label":"20:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cavalry crosses the South River"}],["$","p",null,{"children":"The troopers used the middle ford and reached Main Street only minutes after Jackson and most of his staff passed through."}]]}]]}]
40:["$","div","Carroll splits the mounted force",{"className":"moment","children":[["$","$L33",null,{"seconds":1283,"label":"21:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Carroll splits the mounted force"}],["$","p",null,{"children":"About two-thirds rode toward the Confederate trains while the remainder moved to secure the town end of the covered bridge."}]]}]]}]
41:["$","div","Gilday’s gun covers the bridge",{"className":"moment","children":[["$","$L33",null,{"seconds":1298,"label":"21:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gilday’s gun covers the bridge"}],["$","p",null,{"children":"One Federal gun went to the crossing and another unlimbered on Main Street near the Methodist church."}]]}]]}]
42:["$","div","Firebrands are extinguished",{"className":"moment","children":[["$","$L33",null,{"seconds":1383,"label":"23:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Firebrands are extinguished"}],["$","p",null,{"children":"Federal troopers had a nearby blacksmith’s fire and began carrying brands toward the bridge, but an officer stopped them. The identity and governing order remain disputed."}]]}]]}]
43:["$","div","Gilday nearly fires on Jackson",{"className":"moment","children":[["$","$L33",null,{"seconds":1422,"label":"23:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gilday nearly fires on Jackson"}],["$","p",null,{"children":"Jackson had crossed to the north bank and gestured toward the Federal gun, apparently believing it Confederate. Robinson initially prevented Gilday from firing; permission came too late."}]]}]]}]
44:["$","div","Jackson sounds the alarm",{"className":"moment","children":[["$","$L33",null,{"seconds":1494,"label":"24:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson sounds the alarm"}],["$","p",null,{"children":"Witnesses described unusual agitation as Jackson ordered artillery hitched and the long roll beaten."}]]}]]}]
45:["$","div","The 37th Virginia advances",{"className":"moment","children":[["$","$L33",null,{"seconds":1525,"label":"25:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 37th Virginia advances"}],["$","p",null,{"children":"Taliaferro’s 37th Virginia, already assembled for inspection, double-timed toward the bluff and charged the bridge under fire."}]]}]]}]
46:["$","div","Gilday loads double canister",{"className":"moment","children":[["$","$L33",null,{"seconds":1581,"label":"26:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gilday loads double canister"}],["$","p",null,{"children":"With most of the gun crew gone, Gilday and two men ran the piece onto the bridge. His angled final shot caused limited casualties and did not stop the charge."}]]}]]}]
47:["$","div","The struggle shifts toward the trains",{"className":"moment","children":[["$","$L33",null,{"seconds":1644,"label":"27:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The struggle shifts toward the trains"}],["$","p",null,{"children":"As the wagon park began to stampede, Moore’s small 2nd Virginia detachment took cover behind a stone wall along the cavalry’s route."}]]}]]}]
48:["$","div","Moore’s ambush checks the cavalry",{"className":"moment","children":[["$","$L33",null,{"seconds":1730,"label":"28:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Moore’s ambush checks the cavalry"}],["$","p",null,{"children":"Two volleys from the concealed detachment forced the head of the Federal column back, protecting the exposed train long enough for artillery to recover."}]]}]]}]
49:["$","div","A single howitzer reinforces the defense",{"className":"moment","children":[["$","$L33",null,{"seconds":1784,"label":"29:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"A single howitzer reinforces the defense"}],["$","p",null,{"children":"The first Charlottesville Artillery shot passed high, but it helped stop another mounted advance. More of Carrington’s guns then arrived."}]]}]]}]
4a:["$","div","Confederate artillery controls Main Street",{"className":"moment","children":[["$","$L33",null,{"seconds":1818,"label":"30:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate artillery controls Main Street"}],["$","p",null,{"children":"Five guns were placed to rake the street, and a few rounds persuaded Carroll to abandon the village."}]]}]]}]
4b:["$","div","Carroll withdraws",{"className":"moment","children":[["$","$L33",null,{"seconds":1844,"label":"30:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Carroll withdraws"}],["$","p",null,{"children":"Confederate infantry and artillery cleared the town, forced the guns from Yost Hill, and drove the exhausted infantry back along the South Fork road."}]]}]]}]
4c:["$","div","Jackson survives the operational crisis",{"className":"moment","children":[["$","$L33",null,{"seconds":1868,"label":"31:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson survives the operational crisis"}],["$","p",null,{"children":"The bridge remained intact and the Federal raid failed. Jackson had nevertheless come close to being separated from his trains and escape route."}]]}]]}]
4d:["$","div","Cross Keys is deferred",{"className":"moment","children":[["$","$L33",null,{"seconds":1928,"label":"32:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cross Keys is deferred"}],["$","p",null,{"children":"The hosts announce that Ewell’s fight against Frémont at Cross Keys and Jackson’s June 9 battle against Shields’s lead brigades will be covered next time."}]]}]]}]
4e:["$","div","The book recommendation",{"className":"moment","children":[["$","$L33",null,{"seconds":1948,"label":"32:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The book recommendation"}],["$","p",null,{"children":"The hosts recommend Robert K. Krick’s “Conquering the Valley: Stonewall Jackson at Port Republic.”"}]]}]]}]
4f:["$","div","37th Virginia Infantry",{"className":"command-entry","children":[["$","strong",null,{"children":"37th Virginia Infantry"}],["$","span",null,{"children":"Col. Samuel V. Fulkerson"}],["$","small",null,{"children":"Led the regiment toward the bridge as Jackson ordered it to fire and charge"}]]}]
50:["$","div","Small detachment of the 2nd Virginia Infantry",{"className":"command-entry","children":[["$","strong",null,{"children":"Small detachment of the 2nd Virginia Infantry"}],["$","span",null,{"children":"Capt. Samuel J. C. Moore"}],["$","small",null,{"children":"Roughly two dozen men guarded an upper South River ford and used a stone wall to block the cavalry’s drive toward the trains"}]]}]
51:["$","div","Charlottesville Artillery",{"className":"command-entry","children":[["$","strong",null,{"children":"Charlottesville Artillery"}],["$","span",null,{"children":"Capt. James McD. Carrington"}],["$","small",null,{"children":"Rallied the new battery after five guns initially joined the wagon panic; its fire helped clear Main Street and the eastern approach"}]]}]
52:["$","div","Rockbridge Artillery",{"className":"command-entry","children":[["$","strong",null,{"children":"Rockbridge Artillery"}],["$","span",null,{"children":"Capt. William T. Poague"}],["$","small",null,{"children":"Camped on the heights near the bridge and received Jackson’s urgent order to hitch the guns"}]]}]
53:["$","div","Chief medical officer",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief medical officer"}],["$","span",null,{"children":"Dr. Hunter McGuire"}],["$","small",null,{"children":"Tried to keep ambulance drivers at the Methodist church with the sick and wounded while the raid entered town"}]]}]
54:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
55:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Thomas J. “Stonewall” Jackson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-stonewall-jackson.jpg","alt":"Portrait of Thomas J. “Stonewall” Jackson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Confederate commander whose bridge strategy created an opportunity to fight separate Federal columns but whose exposed headquarters, trains, and crossing nearly produced disaster"}]]}]]}],["$","article","Samuel S. Carroll",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-samuel-carroll.jpg","alt":"Portrait of Samuel S. Carroll","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Samuel S. Carroll"}],["$","p",null,{"children":"United States brigade commander who led the fast mounted and artillery advance into Port Republic"}]]}]]}],["$","article","Richard S. Ewell",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-richard-ewell.jpg","alt":"Portrait of Richard S. Ewell","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Richard S. Ewell"}],["$","p",null,{"children":"Confederate division commander posted at Cross Keys to block Frémont while Jackson held the bridge area"}]]}]]}],["$","article","John C. Frémont",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-john-fremont.jpg","alt":"Portrait of John C. Frémont","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John C. Frémont"}],["$","p",null,{"children":"Mountain Department commander approaching Cross Keys from the west with the larger Federal column"}]]}]]}],["$","article","Turner Ashby",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-turner-ashby.jpg","alt":"Portrait of Turner Ashby","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Turner Ashby"}],["$","p",null,{"children":"Confederate cavalry commander killed on June 6; the episode connects his absence to the poor cavalry screen east of Port Republic"}]]}]]}],["$","article","James Shields",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JS"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"James Shields"}],["$","p",null,{"children":"United States division commander whose main body followed Carroll south through the muddy Page Valley"}]]}]]}],["$","article","Irvin McDowell",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"IM"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Irvin McDowell"}],["$","p",null,{"children":"Department commander who reluctantly allowed Shields to continue the effort to cut Jackson off"}]]}]]}],["$","article","William B. Taliaferro",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"William B. Taliaferro"}],["$","p",null,{"children":"Confederate brigade commander whose assembled regiments supplied the first infantry counterattack"}]]}]]}],["$","article","Samuel V. Fulkerson",{"className":"person-card","children":["$L5d","$L5e"]}],"$L5f","$L60","$L61","$L62","$L63","$L64","$L65","$L66"]}]
56:["$","figure","/images/ep153-turner-ashby.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-turner-ashby.jpg","alt":"Engraved portrait of Confederate cavalry commander Turner Ashby.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Ashby had been killed on June 6. The episode treats the shaken and poorly controlled cavalry screen after his death as an important reason Carroll reached the South River unobserved."}]]}]
