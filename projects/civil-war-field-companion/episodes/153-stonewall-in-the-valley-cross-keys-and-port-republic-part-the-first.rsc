1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",153," · ","June 7–8, 1862"," · ","Port Republic and Cross Keys in Rockingham County, Virginia, at the confluence of the North and South rivers near the southern end of Massanutten Mountain; the episode follows Samuel S. Carroll’s advance along the South Fork and his June 8 raid into Port Republic"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: CROSS KEYS & PORT REPUBLIC (Part the First)"}],["$","span",null,{"className":"result-label","children":"Confederate tactical recovery at Port Republic on the morning of June 8. Carroll’s small mounted advance surprised the village, reached the North River bridge, and threatened Jackson’s headquarters and trains. Confederate infantry and artillery drove it back before its infantry support could secure the crossing. Jackson retained the bridge and kept Frémont and Shields separated. The Battle of Cross Keys later that day and the Battle of Port Republic on June 9 are announced but not narrated in this episode"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1468210951.mp3?updated=1695325869","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Jackson’s dispositions and Carroll’s Port Republic raid, June 7–8, 1862"}],["$","small",null,{"children":"Despite the title, this installment stops before narrating the Battle of Cross Keys. It also does not cover the main Battle of Port Republic fought on June 9."}]]}],["$","div","Immediate result",{"children":[["$","span",null,{"children":"Immediate result"}],["$","strong",null,{"children":"Carroll was driven from Port Republic; Jackson retained the North River bridge"}],["$","small",null,{"children":"This was a sharp preliminary action, not the June 9 battle. The surviving bridge remained available for Jackson to shift troops between the two Federal columns."}]]}],["$","div","Strategic setting",{"children":[["$","span",null,{"children":"Strategic setting"}],["$","strong",null,{"children":"Frémont approached from the west while Shields moved south through the Page Valley"}],["$","small",null,{"children":"Massanutten Mountain and the rivers kept the Federal commands on separate approaches. Jackson chose Port Republic because he could use the remaining bridge to operate on interior lines."}]]}],["$","div","Campaign effect",{"children":[["$","span",null,{"children":"Campaign effect"}],["$","strong",null,{"children":"Jackson had already diverted United States troops from the Richmond campaign"}],["$","small",null,{"children":"The episode argues that Jackson had fulfilled the Confederate strategic purpose before he chose to turn on his pursuers."}]]}],["$","div","Port Republic geography",{"children":["$Le","$Lf","$L10"]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}],"$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30"]}]]}]
33:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","span",null,{"children":"Port Republic geography"}]
f:["$","strong",null,{"children":"A village of roughly fifty buildings on ground between the North and South rivers"}]
10:["$","small",null,{"children":"The rivers joined at the eastern edge of the village to form the South Fork of the Shenandoah. Contemporary descriptions differ in whether they call the ground a peninsula or an island."}]
11:["$","div","The fourth bridge",{"children":[["$","span",null,{"children":"The fourth bridge"}],["$","strong",null,{"children":"The covered bridge across the North River was the last practical local link between the Federal columns"}],["$","small",null,{"children":"Jackson had caused three bridges farther down the South Fork to be burned. He left the Port Republic bridge intact because it gave him the option to shift his own army and then destroy the span."}]]}]
12:["$","div","Confederate dispositions",{"children":[["$","span",null,{"children":"Confederate dispositions"}],["$","strong",null,{"children":"About 7,000 near Port Republic and about 5,000 under Ewell at Cross Keys in the episode"}],["$","small",null,{"children":"The National Park Service describes Ewell’s Cross Keys force as about 6,000. Strength figures vary with timing, attachments, and the number considered present for duty."}]]}]
13:["$","div","Jackson’s intended sequence",{"children":[["$","span",null,{"children":"Jackson’s intended sequence"}],["$","strong",null,{"children":"Hold Frémont with Ewell, counterattack, then cross and destroy the bridge"}],["$","small",null,{"children":"Jackson expected Shields’s main body to be delayed by rain and mud. He retained the option to leave through Brown’s Gap or turn against Shields after dealing with Frémont."}]]}]
14:["$","div","Critical vulnerability",{"children":[["$","span",null,{"children":"Critical vulnerability"}],["$","strong",null,{"children":"The bridge was unguarded and the South River fords were lightly watched"}],["$","small",null,{"children":"Jackson’s army camped north of the North River while its large supply train stood near headquarters in Port Republic. Loss of the bridge could have separated the army from its wagons and Brown’s Gap route."}]]}]
15:["$","div","Jackson’s condition",{"children":[["$","span",null,{"children":"Jackson’s condition"}],["$","strong",null,{"children":"Severe accumulated fatigue probably impaired his judgment"}],["$","small",null,{"children":"This is an interpretation supported in the episode by staff observations and Jackson’s sustained lack of sleep. The exact effect of exhaustion on any individual decision cannot be measured."}]]}]
16:["$","div","Carroll’s assignment",{"children":[["$","span",null,{"children":"Carroll’s assignment"}],["$","strong",null,{"children":"A fast advance intended to reach key crossings and threaten Jackson’s route and trains"}],["$","small",null,{"children":"Carroll led the Fourth Brigade of Shields’s division. The episode follows the flying column rather than the division’s entire movement."}]]}]
17:["$","div","Flying column",{"children":[["$","span",null,{"children":"Flying column"}],["$","strong",null,{"children":"About 150 cavalry, four guns, and infantry marching without baggage"}],["$","small",null,{"children":"The cavalry came from the 1st Virginia (Union) Cavalry, later designated the 1st West Virginia Cavalry. Robinson’s Ohio battery supplied the guns. The 7th Indiana, 1st Virginia (Union) Infantry, 84th Pennsylvania, and 110th Pennsylvania followed in that order in the episode."}]]}]
18:["$","div","Bridge-order conflict",{"children":[["$","span",null,{"children":"Bridge-order conflict"}],["$","strong",null,{"children":"Save, burn, and hold instructions appear in the surviving record and later recollections"}],["$","small",null,{"children":"The episode reconstructs a sequence in which Carroll was first told to save the bridge, then burn it, then hold it. Shields’s June 8 message says Carroll was sent to burn it, while other surviving orders point in different directions. Which instruction governed at the decisive moment remains disputed."}]]}]
19:["$","div","Approach conditions",{"children":[["$","span",null,{"children":"Approach conditions"}],["$","strong",null,{"children":"Heavy rain, deep mud, exhaustion, and failing shoes"}],["$","small",null,{"children":"Carroll halted about six miles short of Port Republic for three hours. The head of his column reached a point about one mile from the village around 6:00 a.m. on June 8."}]]}]
1a:["$","div","Reconnaissance failure",{"children":[["$","span",null,{"children":"Reconnaissance failure"}],["$","strong",null,{"children":"Federal scouts reached the village approaches without effective Confederate interference"}],["$","small",null,{"children":"The episode attributes the open South River road to careless or absent pickets and to disorganization after Turner Ashby’s death two days earlier."}]]}]
1b:["$","div","Surprise achieved",{"children":[["$","span",null,{"children":"Surprise achieved"}],["$","strong",null,{"children":"Carroll opened fire and entered Port Republic at about 8:30 a.m."}],["$","small",null,{"children":"The advance crossed a South River ford. Two guns remained on Yost Hill while two accompanied the cavalry into the village."}]]}]
1c:["$","div","Premature artillery fire",{"children":[["$","span",null,{"children":"Premature artillery fire"}],["$","strong",null,{"children":"Carroll’s guns warned the Confederates before the cavalry crossed"}],["$","small",null,{"children":"The episode says a shot struck the Methodist church steeple and sent debris down near ambulances. The fire gave Jackson and his staff time to move from Madison Hall toward the North River bridge."}]]}]
1d:["$","div","Federal deployment in town",{"children":[["$","span",null,{"children":"Federal deployment in town"}],["$","strong",null,{"children":"Two-thirds of the cavalry rode toward the trains; one-third moved to the bridge"}],["$","small",null,{"children":"One gun covered the bridge under Sgt. James Gilday. A second gun was placed on Main Street near the Methodist church."}]]}]
1e:["$","div","Bridge not burned",{"children":[["$","span",null,{"children":"Bridge not burned"}],["$","strong",null,{"children":"Federal soldiers had fire available but extinguished brands instead of firing the span"}],["$","small",null,{"children":"Later participants disagreed about the orders and responsibility. The episode reports that at least two men identified Carroll as the officer who stopped the attempt."}]]}]
1f:["$","div","Jackson’s near miss",{"children":[["$","span",null,{"children":"Jackson’s near miss"}],["$","strong",null,{"children":"Gilday briefly aimed at Jackson after mistaking him for a confused Confederate officer"}],["$","small",null,{"children":"Capt. Lucius Robinson initially identified the mounted figure as Federal and withheld permission to fire. By the time Carroll authorized the shot, Jackson had moved beyond the gun’s easy aim."}]]}]
20:["$","div","Bridge counterattack",{"children":[["$","span",null,{"children":"Bridge counterattack"}],["$","strong",null,{"children":"The 37th Virginia charged toward and across the covered bridge"}],["$","small",null,{"children":"Taliaferro’s brigade had been forming for inspection. Jackson met the 37th Virginia and sent it forward; the 10th Virginia followed and fired toward the Federal guns on Yost Hill."}]]}]
21:["$","div","Gilday’s last shot",{"children":[["$","span",null,{"children":"Gilday’s last shot"}],["$","strong",null,{"children":"Double canister fired obliquely from a gun on the bridge"}],["$","small",null,{"children":"The episode says Gilday aimed partly to damage the bridge timbers rather than directly down the enclosed span. It gives Confederate losses from that charge as one killed and two wounded."}]]}]
22:["$","div","Defense of the trains",{"children":[["$","span",null,{"children":"Defense of the trains"}],["$","strong",null,{"children":"Capt. Samuel J. C. Moore’s small infantry detachment checked the cavalry on Main Street"}],["$","small",null,{"children":"Moore placed roughly two dozen men behind a stone wall at a bend. Carrington’s inexperienced Charlottesville Artillery then recovered from its initial panic and brought guns into action."}]]}]
23:["$","div","Federal withdrawal",{"children":[["$","span",null,{"children":"Federal withdrawal"}],["$","strong",null,{"children":"Confederate fire cleared the village, Yost Hill, and the road beyond"}],["$","small",null,{"children":"Carroll withdrew across the South River. The episode says one gun became entangled and was abandoned; official accounts report two Federal guns lost in the raid."}]]}]
24:["$","div","Raid casualties",{"children":[["$","span",null,{"children":"Raid casualties"}],["$","strong",null,{"children":"No complete, uncontested loss return is supplied in the episode"}],["$","small",null,{"children":"The episode gives one Confederate killed and two wounded during the bridge charge. Later compiled accounts give broader June 8 losses, but they do not always separate the raid cleanly from the operations that followed. June 9 Port Republic casualty totals do not belong to this episode’s action."}]]}]
25:["$","div","Important leader loss",{"children":[["$","span",null,{"children":"Important leader loss"}],["$","strong",null,{"children":"Turner Ashby had been killed near Harrisonburg on June 6"}],["$","small",null,{"children":"Ashby was not a casualty of the Port Republic raid. His recent death is operationally relevant because Jackson’s cavalry screen was disorganized. No senior commander was killed or mortally wounded in the June 8 raid itself."}]]}]
26:["$","div","What follows",{"children":[["$","span",null,{"children":"What follows"}],["$","strong",null,{"children":"Ewell fought Frémont at Cross Keys later on June 8"}],["$","small",null,{"children":"The episode closes by deferring the Battle of Cross Keys and the June 9 Battle of Port Republic to the next installment."}]]}]
27:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Ewell, Frémont, Massanutten, Taliaferro, Fulkerson, McGuire, Poague, Keogh, Yost Hill, fords, and caissons"}],["$","small",null,{"children":"The automated transcript repeatedly renders these as “Yule,” “Fremont,” “Massanet,” “Tolliver,” “Folkerson,” “Maguire,” “Pogue,” “Keough,” “Yoast,” “forts,” and “kasons.” The guide uses standard historical spellings."}]]}]
28:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“Conquering the Valley: Stonewall Jackson at Port Republic” by Robert K. Krick"}],"$undefined"]}]
29:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
2a:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Two approaching columns, one surviving bridge",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep153-operational-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Two approaching columns, one surviving bridge at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-operational-context.svg","alt":"Schematic operational map showing Frémont approaching Ewell at Cross Keys, Shields approaching from the Page Valley, and Jackson at the Port Republic bridge.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Two approaching columns, one surviving bridge"}],["$","span",null,{"children":"Frémont approached Ewell at Cross Keys from the west while Shields’s division moved south on the opposite side of Massanutten. Jackson held the remaining useful crossing at Port Republic and intended to fight the separated Federal commands in sequence. Routes, river courses, troop positions, distances, and strength labels are approximate. This operational map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep153-operational-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Carroll’s surprise raid into Port Republic",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep153-port-republic-raid.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Carroll’s surprise raid into Port Republic at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-port-republic-raid.svg","alt":"Schematic tactical map showing Carroll’s cavalry entering Port Republic, reaching the North River bridge and Confederate trains, and retreating under counterattack.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Carroll’s surprise raid into Port Republic"}],["$","span",null,{"children":"Carroll’s cavalry and two guns crossed the middle ford, entered the village, and split toward the Confederate trains and the North River bridge. The 37th Virginia charged from the north while Moore’s small detachment and Carrington’s guns checked the thrust toward the wagons. River bends, fords, streets, structures, unit footprints, and arrow timing are approximate. This is a schematic phase map, not a surveyed reconstruction."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep153-port-republic-raid.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Official Records, National Park Service campaign narrative, episode transcript, and participant accounts; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L31"]}]]}],"$undefined"]}]]}],"$L32"]}]]}]
2b:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The campaign resumes at Port Republic",{"className":"moment","children":[["$","$L33",null,{"seconds":70,"label":"1:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign resumes at Port Republic"}],["$","p",null,{"children":"The hosts review Jackson’s escape through Strasburg and locate the Valley Army at Port Republic in early June 1862."}]]}]]}],["$","div","Jackson chooses to turn on his pursuers",{"className":"moment","children":[["$","$L33",null,{"seconds":103,"label":"1:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson chooses to turn on his pursuers"}],["$","p",null,{"children":"Although he could withdraw farther south or cross the Blue Ridge toward Richmond, Jackson prepared to use his central position against Frémont and Shields."}]]}]]}],["$","div","The campaign becomes a contest over bridges",{"className":"moment","children":[["$","$L33",null,{"seconds":161,"label":"2:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign becomes a contest over bridges"}],["$","p",null,{"children":"Jackson needed to keep the two Federal columns separated. Three bridges across the South Fork had been destroyed, leaving the crossing at Port Republic as the decisive local link."}]]}]]}],["$","div","The river confluence is explained",{"className":"moment","children":[["$","$L33",null,{"seconds":237,"label":"3:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The river confluence is explained"}],["$","p",null,{"children":"The village stood where the North and South rivers joined to form the South Fork of the Shenandoah. A covered bridge crossed the North River."}]]}]]}],["$","div","Jackson divides the Valley Army",{"className":"moment","children":[["$","$L33",null,{"seconds":296,"label":"4:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson divides the Valley Army"}],["$","p",null,{"children":"The episode places about 7,000 men near Port Republic under Jackson and roughly 5,000 under Ewell four miles north at Cross Keys."}]]}]]}],["$","div","Frémont is the expected first target",{"className":"moment","children":[["$","$L33",null,{"seconds":319,"label":"5:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Frémont is the expected first target"}],["$","p",null,{"children":"Jackson planned for Ewell to receive Frémont’s attack, then expected to counterattack before shifting across the bridge toward Shields."}]]}]]}],["$","div","The plan’s exposed hinge",{"className":"moment","children":[["$","$L33",null,{"seconds":380,"label":"6:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The plan’s exposed hinge"}],["$","p",null,{"children":"The bridge itself had no guard, the South River fords were lightly watched, and the supply train stood visibly near headquarters."}]]}]]}],["$","div","Exhaustion clouds Jackson’s judgment",{"className":"moment","children":[["$","$L33",null,{"seconds":462,"label":"7:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Exhaustion clouds Jackson’s judgment"}],["$","p",null,{"children":"The episode connects his neglect of Shields’s approach to confidence in the muddy roads and to accumulated physical exhaustion after weeks of short or sleepless nights."}]]}]]}],["$","div","Carroll’s force strikes the village",{"className":"moment","children":[["$","$L33",null,{"seconds":565,"label":"9:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Carroll’s force strikes the village"}],["$","p",null,{"children":"At about 8:30 a.m. on June 8, approximately 150 Federal cavalry and four guns reached Port Republic and triggered the episode’s central action."}]]}]]}],["$","div","Shields sends a flying column",{"className":"moment","children":[["$","$L33",null,{"seconds":593,"label":"9:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shields sends a flying column"}],["$","p",null,{"children":"The episode returns to Shields’s pursuit and Carroll’s special assignment to move rapidly ahead of the division toward the South Fork crossings."}]]}]]}],"$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e"]}]]}]
2c:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Department of the Rappahannock",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Rappahannock"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Higher departmental commander; authorized Shields to continue the pursuit on the east side of Massanutten while Frémont pressed from the west"}]]}],["$","div","First Division, Department of the Rappahannock",{"className":"command-entry","children":[["$","strong",null,{"children":"First Division, Department of the Rappahannock"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"Division stretched along the muddy Page Valley road; sent Carroll’s Fourth Brigade ahead toward Port Republic and the South Fork crossings"}]]}],["$","div","Fourth Brigade and June 8 flying column",{"className":"command-entry","children":[["$","strong",null,{"children":"Fourth Brigade and June 8 flying column"}],["$","span",null,{"children":"Col. Samuel S. Carroll"}],["$","small",null,{"children":"Led about 150 cavalry and four guns at the head of the advance; infantry elements of the 7th Indiana, 1st Virginia (Union), 84th Pennsylvania, and 110th Pennsylvania followed"}]]}],["$","div","Ohio artillery battery attached to Carroll",{"className":"command-entry","children":[["$","strong",null,{"children":"Ohio artillery battery attached to Carroll"}],["$","span",null,{"children":"Capt. Lucius N. Robinson"}],["$","small",null,{"children":"Four guns accompanied the flying column; two remained on Yost Hill and two entered the village with the cavalry"}]]}],["$","div","Federal gun at the North River bridge",{"className":"command-entry","children":[["$","strong",null,{"children":"Federal gun at the North River bridge"}],["$","span",null,{"children":"Sgt. James Gilday"}],["$","small",null,{"children":"Covered the crossing, nearly fired on Jackson, and discharged double canister before abandoning the piece"}]]}],["$","div","Staff officer accompanying the mounted advance",{"className":"command-entry","children":[["$","strong",null,{"children":"Staff officer accompanying the mounted advance"}],["$","span",null,{"children":"Capt. Miles Keogh"}],["$","small",null,{"children":"Reconnoitered the village approach with Carroll; later served with the 7th Cavalry and was killed at the Little Bighorn in 1876"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Valley District and combined Valley Army",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District and combined Valley Army"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Kept headquarters at Madison Hall in Port Republic; about 7,000 men camped north of the North River within supporting distance"}]]}],["$","div","Division at Cross Keys",{"className":"command-entry","children":[["$","strong",null,{"children":"Division at Cross Keys"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Held the western approach about four miles north of Port Republic with about 5,000 in the episode’s accounting; faced Frémont later on June 8"}]]}],["$","div","Brigade north of the North River",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade north of the North River"}],["$","span",null,{"children":"Brig. Gen. William B. Taliaferro"}],["$","small",null,{"children":"Had his men assemble for inspection; the 37th Virginia and 10th Virginia became the first organized infantry response to the raid"}]]}],"$L4f","$L50","$L51","$L52","$L53"]]}]]}],"$L54","$L55"]}]
2d:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Turner Ashby",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Turner Ashby"}],["$","p",null,{"children":[["$","strong",null,{"children":["Valley Army cavalry commander","."]}]," ","Killed near Harrisonburg on June 6, two days before Carroll’s raid. This is a contextual leader loss, not a casualty of the Port Republic action; no senior commander was killed or mortally wounded in the raid itself."]}]]}]]}]]}]
2e:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep153-operational-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-operational-context.svg","alt":"Schematic map of the separate Federal approaches to Cross Keys and Port Republic.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Massanutten Mountain and the destroyed South Fork bridges kept Frémont and Shields on separate approaches. The diagram is explicitly schematic and does not claim surveyed troop positions."}]]}],["$","figure","/images/ep153-port-republic-raid.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-port-republic-raid.svg","alt":"Schematic tactical map of Carroll’s raid into Port Republic and the Confederate counterattack.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The tactical diagram separates the initial ford crossing, the split toward the bridge and trains, and the Confederate response. Its river bends, roads, structures, and unit footprints are approximate."}]]}],["$","figure","/images/ep153-hotchkiss-port-republic-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-hotchkiss-port-republic-map.jpg","alt":"Historical topographic map of Port Republic by Jedediah Hotchkiss.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hotchkiss’s map preserves the historical terrain framework around Port Republic. It maps the June 9 battlefield, not the June 8 raid, so the guide uses it only for geographic context."}]]}],["$","figure","/images/ep153-samuel-carroll.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-samuel-carroll.jpg","alt":"Civil War-era photographic portrait of United States officer Samuel S. Carroll.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Carroll led the small force that penetrated Port Republic. His temporary success exposed the weakness in Jackson’s arrangements but could not be held without timely infantry support."}]]}],["$","figure","/images/ep153-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-stonewall-jackson.jpg","alt":"Photograph from life of Confederate general Thomas J. Stonewall Jackson.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson kept the Port Republic bridge intact to preserve tactical options. The same decision made the unguarded span the critical objective when Carroll arrived unexpectedly."}]]}],["$","figure","/images/ep153-richard-ewell.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-richard-ewell.jpg","alt":"Civil War-era photographic portrait of Confederate general Richard S. Ewell.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Ewell held the Cross Keys position about four miles away. His battle with Frémont later on June 8 is the major action occurring offstage while this episode focuses on Port Republic."}]]}],["$","figure","/images/ep153-john-fremont.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep153-john-fremont.jpg","alt":"Civil War-era photographic portrait of United States general John C. Frémont.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Frémont approached from the western side of Massanutten. Jackson’s operational problem was to prevent his force from joining Shields at Port Republic."}]]}],"$L56"]}]]}]
