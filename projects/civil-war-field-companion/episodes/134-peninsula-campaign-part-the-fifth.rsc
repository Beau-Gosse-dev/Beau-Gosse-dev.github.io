3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"#134 PENINSULA CAMPAIGN (Part the Fifth) · Field Companion"}],["$","meta","1",{"name":"description","content":"In which we look at the First Battle of Drewry's Bluff on May 15, 1862 and also discuss the slow but steady march of the Army of the Potomac up the Peninsula as it closes in on Richmond."}],["$","meta","2",{"property":"og:title","content":"#134 PENINSULA CAMPAIGN (Part the Fifth) · Field Companion"}],["$","meta","3",{"property":"og:description","content":"In which we look at the First Battle of Drewry's Bluff on May 15, 1862 and also discuss the slow but steady march of the Army of the Potomac up the Peninsula as it closes in on Richmond."}],["$","meta","4",{"name":"twitter:card","content":"summary"}],["$","meta","5",{"name":"twitter:title","content":"#134 PENINSULA CAMPAIGN (Part the Fifth) · Field Companion"}],["$","meta","6",{"name":"twitter:description","content":"In which we look at the First Battle of Drewry's Bluff on May 15, 1862 and also discuss the slow but steady march of the Army of the Potomac up the Peninsula as it closes in on Richmond."}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["episodes","134-peninsula-campaign-part-the-fifth"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"episodes","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"children":["$","$Lb",null,{"children":["$","$Lc",null,{"children":[["$","$L8",null,{"providerId":"page:/episodes/134-peninsula-campaign-part-the-fifth","segmentMap":{"children":["__PAGE__"]},"children":["$","$L9",null,{"id":"page:/episodes/134-peninsula-campaign-part-the-fifth"}]}],null]}]}]}]}]}]}]}],null,null]
