1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",134," · ","May 3–24, 1862"," · ","Eltham’s Landing and West Point on the York River; Fort Monroe, Hampton Roads, Norfolk, and Craney Island; the James River at Drewry’s Bluff below Richmond; White House Landing on the Pamunkey River; and the Chickahominy approaches east and northeast of Richmond, Virginia"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN (Part the Fifth)"}],["$","span",null,{"className":"result-label","children":"The engagement at Eltham’s Landing did not interrupt Joseph E. Johnston’s withdrawal toward Richmond. A separate United States operation directed from Fort Monroe occupied Norfolk and forced the Confederates to destroy CSS Virginia. The opened James River then allowed Commander John Rodgers’s five-vessel flotilla to approach Richmond, but Confederate artillery, infantry, naval personnel, and river obstructions repulsed it at Drewry’s Bluff on May 15. McClellan meanwhile established a major supply base at White House Landing and deployed the Army of the Potomac on both sides of the Chickahominy while expecting Irvin McDowell’s force to approach from Fredericksburg. The Peninsula Campaign remained unresolved at the end of the episode"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2784508383.mp3?updated=1695220040","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Eltham’s Landing",{"children":[["$","span",null,{"children":"Eltham’s Landing"}],["$","strong",null,{"children":"May 7, 1862 — indecisive"}],["$","small",null,{"children":"The National Park Service estimates 234 casualties: 186 United States and 48 Confederate. Other published totals differ, so this guide uses the NPS battlefield database consistently."}]]}],["$","div","Lincoln at Fort Monroe",{"children":[["$","span",null,{"children":"Lincoln at Fort Monroe"}],["$","strong",null,{"children":"May 6–11, 1862"}],["$","small",null,{"children":"Secretary of War Edwin M. Stanton and Treasury Secretary Salmon P. Chase accompanied the president."}]]}],["$","div","Norfolk operation",{"children":[["$","span",null,{"children":"Norfolk operation"}],["$","strong",null,{"children":"About 5,000 soldiers landed May 10"}],["$","small",null,{"children":"Major General John E. Wool commanded the landing and advance. Confederate Major General Benjamin Huger evacuated Norfolk and Portsmouth and ordered destruction at the Gosport Navy Yard."}]]}],["$","div","CSS Virginia",{"children":[["$","span",null,{"children":"CSS Virginia"}],["$","strong",null,{"children":"Destroyed off Craney Island, May 11"}],["$","small",null,{"children":"The deep-draft ironclad could neither remain at Norfolk nor pass the shoals required to reach the upper James. Flag Officer Josiah Tattnall ordered her run aground and burned; her magazine exploded before dawn."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a"]}],"$L1b","$L1c","$L1d","$L1e",false,"$L1f","$L20","$L21"]}]]}]
24:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","James River flotilla",{"children":[["$","span",null,{"children":"James River flotilla"}],["$","strong",null,{"children":"Five vessels under Commander John Rodgers"}],["$","small",null,{"children":"USS Galena and USS Monitor were accompanied by USS Aroostook, USS Port Royal, and the experimental revenue cutter Naugatuck."}]]}]
f:["$","div","Drewry’s Bluff",{"children":[["$","span",null,{"children":"Drewry’s Bluff"}],["$","strong",null,{"children":"May 15, 1862 — Confederate victory"}],["$","small",null,{"children":"The position, also called Fort Darling, stood approximately seven to eight river miles below Richmond. The river narrowed and turned beneath a bluff about 90 feet high."}]]}]
10:["$","div","River barrier",{"children":[["$","span",null,{"children":"River barrier"}],["$","strong",null,{"children":"Sunken vessels, piles, stone-filled cribs, and debris"}],["$","small",null,{"children":"CSS Jamestown was among the vessels sunk in the channel. The obstruction prevented the deeper-draft United States ships from passing while the fort remained active."}]]}]
11:["$","div","Drewry’s Bluff casualties",{"children":[["$","span",null,{"children":"Drewry’s Bluff casualties"}],["$","strong",null,{"children":"39–42 in the cited official summaries"}],["$","small",null,{"children":"The NPS battle database gives 24 United States and 15 Confederate casualties. A separate NPS park account gives at least 14 United States dead and 13 wounded across the force, plus 7 Confederate dead and 8 wounded. The Naval History and Heritage Command gives 13 dead and 11 wounded aboard Galena alone and 41 total for both sides. The transcript’s 13 dead and 11 wounded applies to Galena, not necessarily the entire flotilla."}]]}]
12:["$","div","USS Galena",{"children":[["$","span",null,{"children":"USS Galena"}],["$","strong",null,{"children":"Armor penetrated under concentrated fire"}],["$","small",null,{"children":"Naval History and Heritage Command accounts also differ on exact hit and casualty totals. They agree that Galena absorbed most of the fire, exhausted much of her ammunition, and proved that her armor was penetrable."}]]}]
13:["$","div","Medal of Honor",{"children":[["$","span",null,{"children":"Medal of Honor"}],["$","strong",null,{"children":"Corporal John F. Mackie, U.S. Marine Corps"}],["$","small",null,{"children":"Mackie received the Medal of Honor for his conduct aboard Galena during the May 15 action and became the first Marine to receive the decoration."}]]}]
14:["$","div","White House Landing",{"children":[["$","span",null,{"children":"White House Landing"}],["$","strong",null,{"children":"Army of the Potomac’s principal supply base"}],["$","small",null,{"children":"The Pamunkey River and the Richmond and York River Railroad connected water transport to the army’s westward advance."}]]}]
15:["$","div","Military railroad equipment",{"children":[["$","span",null,{"children":"Military railroad equipment"}],["$","strong",null,{"children":"Five locomotives and 80 cars initially ordered forward"}],["$","small",null,{"children":"The Army Transportation Corps history quotes General Manager Daniel C. McCallum’s 1866 report. A sixth locomotive was added in June."}]]}]
16:["$","div","Expected reinforcement",{"children":[["$","span",null,{"children":"Expected reinforcement"}],["$","strong",null,{"children":"McDowell’s I Corps advancing from Fredericksburg"}],["$","small",null,{"children":"McClellan wanted the troops sent by water to White House Landing. Lincoln ordered an overland approach that would keep the force between Washington and the Confederate army."}]]}]
17:["$","div","Army reorganization",{"children":[["$","span",null,{"children":"Army reorganization"}],["$","strong",null,{"children":"Five corps of two divisions each"}],["$","small",null,{"children":"On May 18 McClellan created the V and VI Corps under Fitz John Porter and William B. Franklin, joining the existing II, III, and IV Corps."}]]}]
18:["$","div","Position by May 24",{"children":[["$","span",null,{"children":"Position by May 24"}],["$","strong",null,{"children":"Three corps north and two corps south of the Chickahominy"}],["$","small",null,{"children":"Sumner, Franklin, and Porter extended the right toward Mechanicsville. Keyes and Heintzelman formed the left toward Seven Pines and the Williamsburg Road. The river made rapid mutual support difficult after heavy rain."}]]}]
19:["$","div","Senior commanders killed or mortally wounded",{"children":[["$","span",null,{"children":"Senior commanders killed or mortally wounded"}],["$","strong",null,{"children":"None in the operations covered by this episode"}],"$undefined"]}]
1a:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"Ships of the Civil War, 1861–1865: An Illustrated Guide to the Fighting Vessels of the Union and the Confederacy by Kevin J. Dougherty"}],"$undefined"]}]
1b:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
1c:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","From Eltham’s Landing to the Chickahominy",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep134-peninsula-operations.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From Eltham’s Landing to the Chickahominy at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep134-peninsula-operations.svg","alt":"Operational schematic of the May 1862 movements from Fort Monroe, Norfolk, and Eltham’s Landing to White House Landing, Drewry’s Bluff, and Richmond","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From Eltham’s Landing to the Chickahominy"}],["$","span",null,{"children":"This schematic follows the May 6–24 operations: Franklin’s landing near West Point, Johnston’s withdrawal toward Richmond, the United States occupation of Norfolk, the destruction of CSS Virginia, Rodgers’s advance up the James, and McClellan’s supply movement through White House Landing. The final symbols show the Army of the Potomac divided by the Chickahominy. Locations and routes are approximate and the map is not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep134-peninsula-operations.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo72995/pdf/GOVPUB-D114-PURL-gpo72995.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1c:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The river defense at Drewry’s Bluff",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep134-drewrys-bluff.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The river defense at Drewry’s Bluff at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep134-drewrys-bluff.svg","alt":"Tactical schematic of Confederate batteries and river obstructions at Drewry’s Bluff facing USS Galena, USS Monitor, Naugatuck, Aroostook, and Port Royal","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The river defense at Drewry’s Bluff"}],["$","span",null,{"children":"The James narrowed and turned beneath a roughly 90-foot bluff. Confederate guns above the river, infantry along the banks, naval guns and personnel, and a barrier of sunken vessels and other obstructions stopped Rodgers’s flotilla. Galena anchored nearest the barrier and received most of the Confederate fire; Monitor’s guns could not elevate enough to engage the high position effectively. Positions are schematic and approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep134-drewrys-bluff.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1c:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/places/drewry-s-bluff.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1c:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Contemporary map of the Peninsula and Richmond",{"className":"reference-map","children":["$L22","$L23"]}]]}]]}]
1d:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode resumes after Williamsburg",{"className":"moment","children":[["$","$L24",null,{"seconds":68,"label":"1:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode resumes after Williamsburg"}],["$","p",null,{"children":"Johnston’s army was withdrawing from Yorktown and Williamsburg toward Richmond. Longstreet’s rear guard had delayed the United States pursuit at Williamsburg on May 5."}]]}]]}],["$","div","Franklin lands near Eltham",{"className":"moment","children":[["$","$L24",null,{"seconds":147,"label":"2:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Franklin lands near Eltham"}],["$","p",null,{"children":"McClellan sent William B. Franklin’s division up the York River to threaten the Confederate retreat route. The troops landed too late to cut Johnston’s army off."}]]}]]}],["$","div","Hood’s Texans enter the Eltham’s Landing fight",{"className":"moment","children":[["$","$L24",null,{"seconds":224,"label":"3:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood’s Texans enter the Eltham’s Landing fight"}],["$","p",null,{"children":"Elements of John Bell Hood’s Texas Brigade engaged Franklin’s troops on May 7 while the main Confederate army continued its withdrawal."}]]}]]}],["$","div","A separate operation begins at Fort Monroe",{"className":"moment","children":[["$","$L24",null,{"seconds":256,"label":"4:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"A separate operation begins at Fort Monroe"}],["$","p",null,{"children":"While McClellan pursued Johnston, President Abraham Lincoln arrived at Fort Monroe to assess operations and press for more active use of United States army and naval forces."}]]}]]}],["$","div","CSS Virginia restricts use of the James",{"className":"moment","children":[["$","$L24",null,{"seconds":318,"label":"5:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"CSS Virginia restricts use of the James"}],["$","p",null,{"children":"The Confederate ironclad based at Norfolk remained a threat in Hampton Roads and prevented the United States Navy from treating the James River as a secure route toward Richmond."}]]}]]}],["$","div","Lincoln directs an operation against Norfolk",{"className":"moment","children":[["$","$L24",null,{"seconds":420,"label":"7:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln directs an operation against Norfolk"}],["$","p",null,{"children":"The occupation of Norfolk would remove Virginia’s base. The Fort Monroe garrison remained outside McClellan’s command and operated under Major General John E. Wool."}]]}]]}],["$","div","Lincoln, Stanton, and Chase inspect the landing area",{"className":"moment","children":[["$","$L24",null,{"seconds":484,"label":"8:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln, Stanton, and Chase inspect the landing area"}],["$","p",null,{"children":"The president and the two cabinet secretaries used small vessels to examine the south side of Hampton Roads before Wool’s landing."}]]}]]}],["$","div","Wool lands on May 10",{"className":"moment","children":[["$","$L24",null,{"seconds":505,"label":"8:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wool lands on May 10"}],["$","p",null,{"children":"Approximately 5,000 United States soldiers came ashore and began marching toward Norfolk. Treasury Secretary Chase accompanied Wool while Lincoln helped direct movement across Hampton Roads."}]]}]]}],["$","div","Norfolk is surrendered after the Confederate evacuation",{"className":"moment","children":[["$","$L24",null,{"seconds":562,"label":"9:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Norfolk is surrendered after the Confederate evacuation"}],["$","p",null,{"children":"Benjamin Huger’s garrison had withdrawn, and demolition parties damaged the Gosport Navy Yard. Norfolk’s mayor, William W. Lamb, met Wool’s force outside the city."}]]}]]}],["$","div","Tattnall tries to save CSS Virginia",{"className":"moment","children":["$L25","$L26"]}],"$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a"]}]]}]
1e:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","President and constitutional commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and constitutional commander in chief"}],["$","span",null,{"children":"Abraham Lincoln"}],["$","small",null,{"children":"Directed the Norfolk operation during his Fort Monroe visit and determined that McDowell would approach Richmond overland from Fredericksburg"}]]}],["$","div","Major general commanding the Department of Virginia and Fort Monroe",{"className":"command-entry","children":[["$","strong",null,{"children":"Major general commanding the Department of Virginia and Fort Monroe"}],["$","span",null,{"children":"John E. Wool"}],["$","small",null,{"children":"Led approximately 5,000 soldiers ashore on May 10 and occupied Norfolk after the Confederate evacuation; his command was separate from McClellan’s Army of the Potomac"}]]}],["$","div","Secretary of the Navy",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of the Navy"}],["$","span",null,{"children":"Gideon Welles"}],["$","small",null,{"children":"Exercised civilian authority over naval operations; Flag Officer Louis M. Goldsborough commanded the North Atlantic Blockading Squadron and Commander John Rodgers led the James River flotilla"}]]}],["$","div","Major general commanding the Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Major general commanding the Army of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Directed the advance from West Point and White House Landing toward Richmond and reorganized the field army into five corps"}]]}],["$","div","II Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps, Army of the Potomac"}],["$","span",null,{"children":"Edwin V. Sumner"}],["$","small",null,{"children":"Held part of the right wing north of the Chickahominy"}]]}],["$","div","III Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of the Potomac"}],["$","span",null,{"children":"Samuel P. Heintzelman"}],["$","small",null,{"children":"Formed part of the left wing south of the Chickahominy"}]]}],["$","div","IV Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"IV Corps, Army of the Potomac"}],["$","span",null,{"children":"Erasmus D. Keyes"}],["$","small",null,{"children":"Advanced along the Williamsburg Road toward Seven Pines"}]]}],["$","div","V and VI Corps, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"V and VI Corps, Army of the Potomac"}],["$","span",null,{"children":"Fitz John Porter and William B. Franklin"}],["$","small",null,{"children":"Commanded the two corps created on May 18; both formed part of the northern wing extending toward Mechanicsville"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","President and commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander in chief"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Consulted his cabinet and military adviser Robert E. Lee as Richmond faced threats from the James River and the Army of the Potomac"}]]}],["$","div","General commanding the field army defending Richmond",{"className":"command-entry","children":[["$","strong",null,{"children":"General commanding the field army defending Richmond"}],["$","span",null,{"children":"Joseph E. Johnston"}],"$L3b"]}],"$L3c","$L3d","$L3e"]]}]]}],"$L3f","$L40"]}]
1f:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep134-galena-shot-damage.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep134-galena-shot-damage.jpg","alt":"USS Galena with sailors on deck and visible damage to the iron armor after Drewry’s Bluff","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"James F. Gibson photographed USS Galena in July 1862 after the fighting at Drewry’s Bluff. The image records damage along the ship’s armored side."}]]}],["$","figure","/images/ep134-white-house-landing.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep134-white-house-landing.jpg","alt":"United States supply vessels anchored at White House Landing on the Pamunkey River in 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Supply vessels at White House Landing. McClellan used the Pamunkey and the Richmond and York River Railroad to sustain the army’s approach to Richmond."}]]}],["$","figure","/images/ep134-drewrys-bluff-columbiad.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep134-drewrys-bluff-columbiad.jpg","alt":"A large Columbiad gun inside Fort Darling at Drewry’s Bluff","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A Columbiad at Fort Darling on Drewry’s Bluff. The photograph was made later in the war, after the May 1862 position had been expanded, and should not be read as an exact view of the first battle’s gun layout."}]]}]]}]]}]
