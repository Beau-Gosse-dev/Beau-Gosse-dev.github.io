22:["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep134-peninsula-map-1862.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Contemporary map of the Peninsula and Richmond at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep134-peninsula-map-1862.jpg","alt":"A. J. Johnson 1862 map of the Virginia Peninsula, Richmond, and the James, Chickahominy, Pamunkey, and York Rivers","width":1600,"height":1200,"loading":"lazy"}]}]}]
23:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Contemporary map of the Peninsula and Richmond"}],["$","span",null,{"children":"A. J. Johnson’s 1862 map shows the James, Chickahominy, Pamunkey, and York river corridors; Norfolk and Fort Monroe; White House; the Richmond and York River Railroad; and the approaches to Richmond. It is useful for regional orientation but does not show every May 1862 troop position precisely."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep134-peninsula-map-1862.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1c:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448355/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1c:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
25:["$","$L24",null,{"seconds":605,"label":"10:05"}]
26:["$","div",null,{"children":[["$","h3",null,{"children":"Tattnall tries to save CSS Virginia"}],["$","p",null,{"children":"Flag Officer Josiah Tattnall intended to move the ironclad into the James, but Virginia’s draft and the river shoals made the escape dependent on substantial lightening and favorable water."}]]}]
27:["$","div","Virginia is grounded and burned",{"className":"moment","children":[["$","$L24",null,{"seconds":684,"label":"11:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia is grounded and burned"}],["$","p",null,{"children":"After the pilots concluded that the ship still could not clear the bar, her crew ran her ashore near Craney Island, evacuated, and set her on fire."}]]}]]}]
28:["$","div","Virginia’s magazine explodes",{"className":"moment","children":[["$","$L24",null,{"seconds":693,"label":"11:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia’s magazine explodes"}],["$","p",null,{"children":"Before dawn on May 11, fire reached the magazine and destroyed the ironclad. The James River was now open to a United States naval advance as far as the remaining defenses allowed."}]]}]]}]
29:["$","div","Rodgers receives orders to move up the James",{"className":"moment","children":[["$","$L24",null,{"seconds":770,"label":"12:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rodgers receives orders to move up the James"}],["$","p",null,{"children":"Flag Officer Louis M. Goldsborough sent Commander John Rodgers upstream with a force that ultimately comprised Galena, Monitor, Naugatuck, Aroostook, and Port Royal."}]]}]]}]
2a:["$","div","Richmond faces threats by land and water",{"className":"moment","children":[["$","$L24",null,{"seconds":801,"label":"13:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richmond faces threats by land and water"}],["$","p",null,{"children":"Johnston’s withdrawal brought McClellan’s army closer from the east while the destruction of Virginia allowed United States warships to approach on the James."}]]}]]}]
2b:["$","div","Davis consults Lee about Richmond’s defense",{"className":"moment","children":[["$","$L24",null,{"seconds":877,"label":"14:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis consults Lee about Richmond’s defense"}],["$","p",null,{"children":"On May 14 President Jefferson Davis and his cabinet considered the consequences of losing the capital. Military adviser Robert E. Lee argued that Richmond should be held."}]]}]]}]
2c:["$","div","The flotilla reaches Drewry’s Bluff",{"className":"moment","children":[["$","$L24",null,{"seconds":936,"label":"15:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The flotilla reaches Drewry’s Bluff"}],["$","p",null,{"children":"At 6:30 a.m. on May 15, Rodgers’s ships came in sight of Fort Darling, approximately seven to eight river miles below Richmond."}]]}]]}]
2d:["$","div","Terrain gives the defenders a strong position",{"className":"moment","children":[["$","$L24",null,{"seconds":971,"label":"16:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Terrain gives the defenders a strong position"}],["$","p",null,{"children":"A sharp bend and narrow channel confined the vessels below a bluff about 90 feet high. Confederate heavy guns commanded the river from above."}]]}]]}]
2e:["$","div","Obstructions close the channel",{"className":"moment","children":[["$","$L24",null,{"seconds":990,"label":"16:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Obstructions close the channel"}],["$","p",null,{"children":"Sunken vessels and constructed barriers blocked passage. The James River Squadron added CSS Jamestown to the obstruction and positioned naval guns and ships behind it."}]]}]]}]
2f:["$","div","Army and navy personnel man the Confederate defense",{"className":"moment","children":[["$","$L24",null,{"seconds":1032,"label":"17:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Army and navy personnel man the Confederate defense"}],["$","p",null,{"children":"Augustus Drewry’s Southside Heavy Artillery, naval personnel from the James River Squadron and the destroyed Virginia, and Confederate infantry occupied the bluff and riverbanks."}]]}]]}]
30:["$","div","Galena anchors nearest the barrier",{"className":"moment","children":[["$","$L24",null,{"seconds":1090,"label":"18:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Galena anchors nearest the barrier"}],["$","p",null,{"children":"Rodgers placed Galena broadside to the channel so her guns could bear on the fort. Confederate fire struck the ship as she took position."}]]}]]}]
31:["$","div","Monitor cannot engage the high batteries effectively",{"className":"moment","children":[["$","$L24",null,{"seconds":1110,"label":"18:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor cannot engage the high batteries effectively"}],["$","p",null,{"children":"Monitor’s guns could not elevate sufficiently against the position above the river. She withdrew downstream with Aroostook and Port Royal while Galena and Naugatuck continued the principal exchange."}]]}]]}]
32:["$","div","Galena’s armor fails under fire",{"className":"moment","children":[["$","$L24",null,{"seconds":1182,"label":"19:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Galena’s armor fails under fire"}],["$","p",null,{"children":"Repeated Confederate hits penetrated Galena’s interlocking iron armor. Exact hit and casualty totals differ among official summaries, but all describe serious damage and heavy losses aboard the ship."}]]}]]}]
33:["$","div","John F. Mackie serves the guns",{"className":"moment","children":[["$","$L24",null,{"seconds":1205,"label":"20:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"John F. Mackie serves the guns"}],["$","p",null,{"children":"Marine Corporal Mackie helped keep Galena’s guns in action under fire. He later became the first Marine to receive the Medal of Honor."}]]}]]}]
34:["$","div","The flotilla withdraws",{"className":"moment","children":[["$","$L24",null,{"seconds":1240,"label":"20:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"The flotilla withdraws"}],["$","p",null,{"children":"Rodgers broke off the action as ammunition ran low. The Confederate defense kept the United States ships below Richmond and secured a tactical victory."}]]}]]}]
35:["$","div","McClellan continues toward Richmond",{"className":"moment","children":[["$","$L24",null,{"seconds":1278,"label":"21:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan continues toward Richmond"}],["$","p",null,{"children":"The Army of the Potomac moved from West Point toward White House Landing while Johnston’s army took positions closer to the Confederate capital."}]]}]]}]
36:["$","div","White House Landing becomes the main supply base",{"className":"moment","children":[["$","$L24",null,{"seconds":1356,"label":"22:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"White House Landing becomes the main supply base"}],["$","p",null,{"children":"McClellan used the Pamunkey River landing and the Richmond and York River Railroad to connect waterborne supplies with the westward-moving army."}]]}]]}]
37:["$","div","McDowell is expected from Fredericksburg",{"className":"moment","children":[["$","$L24",null,{"seconds":1394,"label":"23:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"McDowell is expected from Fredericksburg"}],["$","p",null,{"children":"Washington indicated that most of McDowell’s I Corps and additional troops under James Shields would move toward McClellan. Lincoln required the reinforcement to travel overland rather than by water."}]]}]]}]
38:["$","div","McClellan organizes five corps",{"className":"moment","children":[["$","$L24",null,{"seconds":1461,"label":"24:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan organizes five corps"}],["$","p",null,{"children":"The army now had II Corps under Edwin V. Sumner, III Corps under Samuel P. Heintzelman, IV Corps under Erasmus D. Keyes, V Corps under Fitz John Porter, and VI Corps under William B. Franklin."}]]}]]}]
39:["$","div","Three corps extend the right north of the Chickahominy",{"className":"moment","children":[["$","$L24",null,{"seconds":1486,"label":"24:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Three corps extend the right north of the Chickahominy"}],["$","p",null,{"children":"Sumner, Franklin, and Porter held the northern wing, protecting the White House supply line and reaching toward Mechanicsville to facilitate the expected junction with McDowell."}]]}]]}]
3a:["$","div","Two corps form the left south of the river",{"className":"moment","children":[["$","$L24",null,{"seconds":1511,"label":"25:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two corps form the left south of the river"}],["$","p",null,{"children":"Keyes advanced toward Seven Pines on the Williamsburg Road, with Heintzelman farther to the rear. By May 24 the Army of the Potomac was deployed on both sides of the Chickahominy."}]]}]]}]
3b:["$","small",null,{"children":"Continued the withdrawal from the Peninsula and positioned the army east of Richmond near the Chickahominy"}]
3c:["$","div","Major general commanding the Department of Norfolk",{"className":"command-entry","children":[["$","strong",null,{"children":"Major general commanding the Department of Norfolk"}],["$","span",null,{"children":"Benjamin Huger"}],["$","small",null,{"children":"Evacuated the Norfolk-Portsmouth position and ordered military property at the Gosport Navy Yard destroyed before Wool’s arrival"}]]}]
3d:["$","div","Flag officer commanding CSS Virginia and Confederate naval forces in Hampton Roads",{"className":"command-entry","children":[["$","strong",null,{"children":"Flag officer commanding CSS Virginia and Confederate naval forces in Hampton Roads"}],["$","span",null,{"children":"Josiah Tattnall"}],["$","small",null,{"children":"Ordered Virginia destroyed when evacuation of Norfolk left the deep-draft ironclad without a viable base or route to the upper James"}]]}]
3e:["$","div","Commander supervising the naval defense at Drewry’s Bluff",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander supervising the naval defense at Drewry’s Bluff"}],["$","span",null,{"children":"Ebenezer Farrand"}],["$","small",null,{"children":"Worked with Captain Augustus Drewry’s artillery, John R. Tucker’s James River Squadron, former Virginia personnel, and infantry along the riverbanks"}]]}]
