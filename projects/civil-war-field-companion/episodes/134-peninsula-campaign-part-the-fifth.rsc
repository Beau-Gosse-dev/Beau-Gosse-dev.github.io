40:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Abraham Lincoln",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Abraham Lincoln"}],["$","p",null,{"children":"Used his May visit to Fort Monroe to press army-navy cooperation, help select the Norfolk landing area, and direct the occupation that removed CSS Virginia’s base"}]]}]]}],["$","article","John E. Wool",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John E. Wool"}],["$","p",null,{"children":"Commanded Fort Monroe and led the independent United States column that occupied Norfolk"}]]}]]}],["$","article","George B. McClellan",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George B. McClellan"}],["$","p",null,{"children":"Commanded the Army of the Potomac, established the White House supply base, and deployed five corps on both sides of the Chickahominy"}]]}]]}],["$","article","William B. Franklin",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"William B. Franklin"}],["$","p",null,{"children":"Commanded the division landed at Eltham’s Landing and later took command of the newly created VI Corps"}]]}]]}],