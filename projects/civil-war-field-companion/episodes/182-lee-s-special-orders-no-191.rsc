3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"#182 LEE'S SPECIAL ORDERS No. 191 · Field Companion"}],["$","meta","1",{"name":"description","content":"In which we look at the movements of the Robert E. Lee's Army of Northern Virginia after it crossed over the Potomac River into Maryland. We also discuss the reaction of George B. McClellan's Army of the Potomac to the Confederate invasion of Maryland. And we talk about Lee's Special Orders No. 191."}],["$","meta","2",{"property":"og:title","content":"#182 LEE'S SPECIAL ORDERS No. 191 · Field Companion"}],["$","meta","3",{"property":"og:description","content":"In which we look at the movements of the Robert E. Lee's Army of Northern Virginia after it crossed over the Potomac River into Maryland. We also discuss the reaction of George B. McClellan's Army of the Potomac to the Confederate invasion of Maryland. And we talk about Lee's Special Orders No. 191."}],["$","meta","4",{"name":"twitter:card","content":"summary"}],["$","meta","5",{"name":"twitter:title","content":"#182 LEE'S SPECIAL ORDERS No. 191 · Field Companion"}],["$","meta","6",{"name":"twitter:description","content":"In which we look at the movements of the Robert E. Lee's Army of Northern Virginia after it crossed over the Potomac River into Maryland. We also discuss the reaction of George B. McClellan's Army of the Potomac to the Confederate invasion of Maryland. And we talk about Lee's Special Orders No. 191."}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["episodes","182-lee-s-special-orders-no-191"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"episodes","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"font