d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",182," · ","September 4–13, 1862"," · ","The Potomac crossings and the Maryland campaign corridor from Washington and Frederick west across South Mountain to Hagerstown, Martinsburg, and Harpers Ferry"]}],["$","h1",null,{"children":"LEE'S SPECIAL ORDERS No. 191"}],["$","span",null,{"className":"result-label","children":"Operational turning point. Special Orders No. 191 divided the Army of Northern Virginia to clear the United States garrisons at Martinsburg and Harpers Ferry, but the detachments fell behind Lee’s timetable while the Army of the Potomac advanced faster than he expected. By noon on September 13, a lost copy of the order had reached George B. McClellan at Frederick"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"September 4–13, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"The Potomac crossings and the Maryland campaign corridor from Washington and Frederick west across South Mountain to Hagerstown, Martinsburg, and Harpers Ferry"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Operational turning point. Special Orders No. 191 divided the Army of Northern Virginia to clear the United States garrisons at Martinsburg and Harpers Ferry, but the detachments fell behind Lee’s timetable while the Army of the Potomac advanced faster than he expected. By noon on September 13, a lost copy of the order had reached George B. McClellan at Frederick"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"September 4–13, 1862","place":"The Potomac crossings and the Maryland campaign corridor from Washington and Frederick west across South Mountain to Hagerstown, Martinsburg, and Harpers Ferry","result":"Operational turning point. Special Orders No. 191 divided the Army of Northern Virginia to clear the United States garrisons at Martinsburg and Harpers Ferry, but the detachments fell behind Lee’s timetable while the Army of the Potomac advanced faster than he expected. By noon on September 13, a lost copy of the order had reached George B. McClellan at Frederick","facts":[{"label":"Episode scope","value":"Lee’s September 4–13 Maryland movements, McClellan’s pursuit, and the plan contained in Special Orders No. 191","note":"The episode ends when McClellan receives the lost copy. The consequences of that discovery are reserved for the next episode."},{"label":"Confederate crossing","value":"The Army of Northern Virginia began crossing the Potomac on September 4","note":"The movement into Maryland continued through the weekend; the army was assembled near Frederick by September 7."},{"label":"Confederate strength","value":"Uncertain; historians’ estimates cited in the episode range from 50,000 to 75,000","note":"The hosts use about 65,000 as a plausible starting figure after applying Lee’s later statement that straggling reduced his Antietam strength by roughly one-third. This is an estimate, not a contemporary return."},{"label":"Condition of Lee’s army","value":"Veteran and confident, but exhausted and poorly supplied","note":"The episode emphasizes inadequate food, clothing, and shoes. Straggling and desertion sharply reduced the force that reached Antietam."},{"label":"Lee’s command structure","value":"Jackson and Longstreet led the two principal infantry wings","note":"D. H. Hill, Lafayette McLaws, and Richard H. Anderson had just arrived from Richmond and initially reported directly to Lee; J. E. B. Stuart’s cavalry also reported to army headquarters."},{"label":"Command friction","value":"A. P. Hill and John Bell Hood entered Maryland under arrest","note":"Jackson had relieved Hill during a dispute over march discipline. Hood’s arrest grew from a dispute with Nathan “Shanks” Evans over captured ambulances. Both remained near their commands."},{"label":"Lee’s injury","value":"A broken bone in his right hand and a severe sprain in his left","note":"Lee was injured while trying to control his horse, Traveller, and entered Maryland in an ambulance because he could not hold the reins."},{"label":"McClellan restored","value":"Placed over the forces around Washington on September 2","note":"Units from John Pope’s Army of Virginia were merged into the Army of the Potomac. The episode stresses the rapid improvement in morale after McClellan’s return."},{"label":"Lee’s central assumption","value":"McClellan would need three or four weeks before undertaking an offensive","note":"Lee judged both the commander and the reorganized Federal army too cautious and disordered to react quickly. The Army of the Potomac began moving from Washington on September 5."},{"label":"Federal warning","value":"A Sugarloaf Mountain signal station confirmed the crossing on September 4","note":"The station, about ten miles south of Frederick, helped confirm the direction of Lee’s movement."},{"label":"Army of the Potomac advance","value":"Three wings spread northwest from Washington like a trident","note":"Burnside’s right guarded against a move on Baltimore, Sumner’s center approached Frederick, and Franklin’s left kept nearer the Potomac. Pleasonton’s cavalry screened the advance."},{"label":"Lee’s campaign objective","value":"Move west from Frederick and draw the United States army away from Washington","note":"Crossing the Catoctin and South Mountain ranges would place Lee in the Cumberland Valley, threaten Pennsylvania, and reopen communications through the Shenandoah Valley."},{"label":"Obstacle in the lower valley","value":"United States garrisons remained at Martinsburg and Harpers Ferry","note":"The episode gives about 3,000 men under Julius White at Martinsburg and 10,000 under Dixon S. Miles at Harpers Ferry. Lee had expected both posts to be evacuated."},{"label":"Order issued","value":"Headquarters, Army of Northern Virginia, September 9, 1862","note":"After consulting Jackson and Longstreet, Lee dictated the plan to assistant adjutant general Robert H. Chilton, who prepared and distributed copies as Special Orders No. 191."},{"label":"Jackson’s assignment","value":"Capture Martinsburg, then move toward Harpers Ferry","note":"Jackson’s three divisions were to march through Middletown and Sharpsburg, cross the Potomac, and clear the Baltimore and Ohio Railroad approaches."},{"label":"Longstreet’s assignment","value":"Halt at Boonsboro with the reserve supply and baggage trains","note":"Lee later sent Longstreet north to Hagerstown after reports of flour there and of Pennsylvania militia approaching from Chambersburg."},{"label":"McLaws’s assignment","value":"Seize Maryland Heights and help capture Harpers Ferry","note":"Lafayette McLaws commanded his own division and Richard H. Anderson’s, roughly 15,000 men in the episode’s account."},{"label":"Walker’s assignment","value":"Recross the Potomac, occupy Loudoun Heights, and cooperate against Harpers Ferry","note":"John G. Walker’s division approached the garrison from south of the Potomac while McLaws moved against it from the north and east."},{"label":"D. H. Hill and Stuart","value":"Hill guarded the rear; Stuart screened the army and watched the Federal advance","note":"Stuart was also to provide cavalry detachments to the principal marching columns and bring up stragglers."},{"label":"Planned reunion","value":"Boonsboro or Hagerstown after the valley garrisons surrendered","note":"Lee expected the operation to take only a few days. Jackson, McLaws, and Walker were then to rejoin the main body."},{"label":"Plan already changing","value":"Jackson went by Williamsport and Longstreet continued to Hagerstown","note":"Jackson marched from Frederick on September 10, halted after crossing the mountains, and turned northwest the next day. These movements spread the army more widely than the written plan indicated."},{"label":"Martinsburg cleared","value":"Julius White’s command escaped to Harpers Ferry on September 12","note":"The evacuation removed the Martinsburg post but strengthened Dixon Miles’s Harpers Ferry garrison by about 3,000 men."},{"label":"Harpers Ferry surrounded","value":"Confederate columns occupied the surrounding heights by late September 13","note":"Jackson reached Bolivar Heights from the west, McLaws secured Maryland Heights after fighting, and Walker occupied Loudoun Heights. The garrison had not surrendered."},{"label":"Federal pace","value":"The Army of the Potomac reached Frederick on September 12–13","note":"Lee had written on September 8 that the enemy appeared to be concentrating around Washington, but Federal cavalry was already skirmishing and the army was moving rapidly northwest."},{"label":"The lost copy","value":"Delivered to McClellan at Frederick around noon on September 13","note":"The National Park Service identifies the finders as members of Company F, 27th Indiana. The copy was intended for D. H. Hill; how it was lost remains uncertain."},{"label":"Episode recommendation","value":"Winter 2016 issue of The Civil War Monitor","note":"The recommended feature is Stephen W. Sears’s examination of the “Lost Order.”"},{"label":"Transcript normalizations","value":"Second Manassas, McLaws, Boonsboro, Pleasonton, and Loudoun Heights","note":"The automated transcript produces forms including “2nd Bonacis,” “McClaws,” “Boomsboro,” “Pleasanton,” and “Loudon Heights.”"}],"maps":[{"title":"Invasion of Maryland and the Federal response","caption":"Lee’s army crossed the Potomac west of Washington, concentrated near Frederick, and then moved west across the Catoctin and South Mountain ranges. McClellan advanced from Washington in three wings, covering Baltimore, Frederick, and the Potomac corridor. Routes and geography are generalized; this map is schematic and not to scale.","source":"U.S. Army Center of Military History, National Park Service, Ezra A. Carman campaign maps, and episode transcript; see sources below.","image":"/images/ep182-maryland-campaign-context.svg","alt":"Schematic map of the Confederate invasion route into Maryland and the three-wing United States advance from Washington toward Frederick in early September 1862."},{"title":"Special Orders No. 191 in motion","caption":"The order sent Jackson toward Martinsburg, McLaws toward Maryland Heights, Walker toward Loudoun Heights, Longstreet and the trains toward Boonsboro, and D. H. Hill into the rear guard. Solid routes show the major movements described through September 13; gray dashed lines show covering duties, and the key states the planned reunion. Routes, terrain, and positions are generalized; this map is schematic and not to scale.","source":"U.S. Army Center of Military History, National Park Service, Ezra A. Carman campaign maps, Special Orders No. 191, and episode transcript; see sources below.","image":"/images/ep182-special-orders-movements.svg","alt":"Schematic operational map showing the Confederate columns created by Special Orders No. 191 and their movements from Frederick toward Hagerstown, Martinsburg, and Harpers Ferry."},{"title":"The surviving lost-order detail","caption":"This Library of Congress exhibition image reproduces the portion of the lost copy containing paragraphs IV and V: Longstreet’s halt at Boonsboro and McLaws’s movement toward Maryland Heights. It is a documentary artifact, not a facsimile of every page of the order.","source":"Library of Congress, George Brinton McClellan Papers; see sources below.","image":"/images/ep182-special-orders-191.jpg","alt":"Handwritten detail of Special Orders No. 191 showing the assignments of Longstreet and McLaws."}],"moments":[{"time":"1:10","audioTime":70,"title":"Lee’s army begins crossing the Potomac","detail":"The episode opens its narrative on September 4 with the Army of Northern Virginia entering western Maryland."},{"time":"2:06","audioTime":126,"title":"The uncertainty over Confederate strength is explained","detail":"The hosts distinguish estimates ranging from 50,000 to 75,000 from the incomplete Confederate returns."},{"time":"3:19","audioTime":199,"title":"Exhaustion becomes the army’s limiting factor","detail":"Veteran soldiers enter the campaign with high morale but without the food, clothing, shoes, and endurance required for sustained marching."},{"time":"4:31","audioTime":271,"title":"Lee’s field organization is outlined","detail":"Jackson and Longstreet lead the principal wings while newly arrived divisions and Stuart’s cavalry remain directly under Lee."},{"time":"5:36","audioTime":336,"title":"A. P. Hill and Hood are under arrest","detail":"Two important Confederate division commanders march near their commands while personal and disciplinary disputes remain unresolved."},{"time":"6:49","audioTime":409,"title":"Lee’s injured hands force him into an ambulance","detail":"A riding accident leaves Lee unable to hold Traveller’s reins as the army enters Maryland."},{"time":"8:14","audioTime":494,"title":"McClellan returns to command","detail":"Lee learns that Lincoln has placed McClellan over the Federal forces regrouping around Washington."},{"time":"9:36","audioTime":576,"title":"Lee counts on a three-to-four-week window","detail":"He expects McClellan and the reorganized United States army to remain near Washington rather than begin an immediate pursuit."},{"time":"11:57","audioTime":717,"title":"Sugarloaf Mountain confirms the Confederate crossing","detail":"A United States signal station reports on September 4 that Confederate troops are crossing the Potomac."},{"time":"13:47","audioTime":827,"title":"The Army of the Potomac moves in three wings","detail":"Burnside takes the right, Sumner the center, and Franklin the left while Pleasonton’s cavalry screens the advance."},{"time":"15:37","audioTime":937,"title":"Lee’s army concentrates near Frederick","detail":"By September 7 the Confederate army is across the Potomac and positioned to threaten Washington and Baltimore before turning west."},{"time":"17:40","audioTime":1060,"title":"The lower-valley garrisons block Lee’s communications","detail":"United States troops remain at Martinsburg and Harpers Ferry instead of evacuating as Lee had expected."},{"time":"19:30","audioTime":1170,"title":"Lee explains the valley operation","detail":"On September 9 he meets with Jackson and Longstreet and describes how the army will remove the two Federal garrisons."},{"time":"20:00","audioTime":1200,"title":"Jackson receives the Martinsburg assignment","detail":"His three divisions are to cross the mountains, recross the Potomac, capture Martinsburg, and then move toward Harpers Ferry."},{"time":"20:12","audioTime":1212,"title":"McLaws is directed toward Maryland Heights","detail":"McLaws, with Richard Anderson’s division added, is to turn south at Middletown and dominate Harpers Ferry from the north."},{"time":"20:36","audioTime":1236,"title":"Walker is sent to Loudoun Heights","detail":"Walker’s division must recross the Potomac and cooperate with the other columns against the garrison."},{"time":"21:11","audioTime":1271,"title":"Hill and Stuart receive covering assignments","detail":"D. H. Hill forms the rear guard while Stuart screens the routes, gathers stragglers, and watches McClellan."},{"time":"21:45","audioTime":1305,"title":"Jackson and Longstreet question the separation","detail":"Both lieutenants object to aspects of the plan; Longstreet initially persuades Lee to stop the main body at Boonsboro rather than Hagerstown."},{"time":"22:25","audioTime":1345,"title":"The plan becomes Special Orders No. 191","detail":"Lee dictates the operation to his staff, and copies are prepared for the commanders named in it."},{"time":"23:16","audioTime":1396,"title":"The timetable rests on faulty intelligence","detail":"Lee believes time is on his side, but Stuart’s reports have not revealed how rapidly the Federal army is moving."},{"time":"25:03","audioTime":1503,"title":"Jackson starts west from Frederick","detail":"The September 10 march crosses the Catoctin and South Mountain ranges, but Jackson halts outside Boonsboro after thirteen miles."},{"time":"25:27","audioTime":1527,"title":"Jackson turns toward Williamsport","detail":"Instead of continuing toward Sharpsburg, his column turns northwest and fords the Potomac to approach Martinsburg from the north and west."},{"time":"26:13","audioTime":1573,"title":"Longstreet continues to Hagerstown","detail":"Lee changes the Boonsboro halt after receiving reports about flour and a possible Pennsylvania militia threat."},{"time":"27:18","audioTime":1638,"title":"The Martinsburg garrison escapes","detail":"White’s men join the Harpers Ferry garrison, forcing Jackson to continue south rather than reunite with Lee."},{"time":"27:52","audioTime":1672,"title":"The Harpers Ferry columns fall behind schedule","detail":"McLaws and Walker do not secure Maryland and Loudoun Heights until September 13, while Jackson approaches Bolivar Heights from the west."},{"time":"29:20","audioTime":1760,"title":"The United States army reaches Frederick","detail":"Federal advance elements enter on September 12; the main army arrives the next morning and pushes west toward South Mountain."},{"time":"30:07","audioTime":1807,"title":"McClellan receives the lost order","detail":"At about noon on September 13, the Confederate operational order is unexpectedly handed to the Army of the Potomac commander."},{"time":"30:39","audioTime":1839,"title":"The episode recommends Stephen Sears on the Lost Order","detail":"The hosts recommend the Winter 2016 issue of The Civil War Monitor for a closer investigation of Special Orders No. 191."}],"command":[{"side":"United States","color":"#315f8c","branches":[{"commander":"Maj. Gen. George B. McClellan","command":"Army of the Potomac","subordinates":"Reorganized the field army around Washington and advanced northwest in three wings while maintaining coverage of the capital and Baltimore"},{"commander":"Maj. Gen. Ambrose E. Burnside","command":"Right Wing","subordinates":"I Corps under Joseph Hooker and IX Corps under Jesse L. Reno; moved north before turning west, covering the Baltimore approach"},{"commander":"Maj. Gen. Edwin V. Sumner","command":"Center Wing","subordinates":"II Corps and XII Corps; advanced northwest on the central route toward Frederick"},{"commander":"Maj. Gen. William B. Franklin","command":"Left Wing","subordinates":"VI Corps and Darius N. Couch’s division; advanced nearer the Potomac on the army’s left"},{"commander":"Brig. Gen. Alfred Pleasonton","command":"Cavalry Division","subordinates":"Screened the advance and skirmished with Confederate cavalry while the army searched for Lee’s columns"},{"commander":"Brig. Gen. George Sykes","command":"Division of U.S. Regulars, V Corps","subordinates":"Moved at the rear as a general reserve"},{"commander":"Col. Dixon S. Miles and Col. Julius White","command":"Harpers Ferry and Martinsburg garrisons","subordinates":"Miles held Harpers Ferry; White evacuated Martinsburg and joined Miles on September 12"}]},{"side":"Confederacy","color":"#9a3d32","branches":[{"commander":"Gen. Robert E. Lee","command":"Army of Northern Virginia","subordinates":"Designed the valley operation, moved with Longstreet, and expected the separated columns to reunite after the garrisons fell"},{"commander":"Maj. Gen. Thomas J. “Stonewall” Jackson","command":"Jackson’s command","subordinates":"Divisions under John R. Jones, Alexander R. Lawton, and A. P. Hill; assigned to capture Martinsburg and approach Harpers Ferry from the west"},{"commander":"Maj. Gen. James Longstreet","command":"Longstreet’s command and army trains","subordinates":"Ordered to halt at Boonsboro, then redirected north to Hagerstown; Lee accompanied this column"},{"commander":"Maj. Gen. Lafayette McLaws","command":"McLaws’s and Richard H. Anderson’s divisions","subordinates":"Ordered through Middletown toward Maryland Heights to operate against Harpers Ferry from the north and east"},{"commander":"Brig. Gen. John G. Walker","command":"Walker’s division","subordinates":"Ordered across the Potomac to Loudoun Heights to cooperate in the capture of Harpers Ferry"},{"commander":"Maj. Gen. D. H. Hill","command":"Hill’s division","subordinates":"Detached from Jackson and assigned as rear guard behind the main body at Boonsboro"},{"commander":"Maj. Gen. J. E. B. Stuart","command":"Cavalry Division","subordinates":"Screened the army’s route, detached squadrons to marching columns, gathered stragglers, and watched the Federal advance"},{"commander":"Lt. Col. Robert H. Chilton","command":"Assistant adjutant general, army headquarters","subordinates":"Reduced Lee’s plan to writing and supervised copies of Special Orders No. 191"}]}],"people":[{"name":"Robert E. Lee","role":"Army of Northern Virginia commander who issued Special Orders No. 191","side":"Confederacy","image":"/images/ep182-robert-e-lee.jpg"},{"name":"George B. McClellan","role":"Army of the Potomac commander who organized the pursuit and received the lost order","side":"United States","image":"/images/ep182-george-mcclellan.jpg"},{"name":"Thomas J. “Stonewall” Jackson","role":"Confederate wing commander assigned to capture Martinsburg and then move on Harpers Ferry","side":"Confederacy"},{"name":"James Longstreet","role":"Confederate wing commander ordered to accompany the trains through Boonsboro","side":"Confederacy"},{"name":"Lafayette McLaws","role":"Confederate commander assigned to seize Maryland Heights with two divisions","side":"Confederacy"},{"name":"John G. Walker","role":"Confederate division commander assigned to occupy Loudoun Heights","side":"Confederacy"},{"name":"D. H. Hill","role":"Confederate division commander assigned to the rear guard; the lost copy was intended for him","side":"Confederacy"},{"name":"J. E. B. Stuart","role":"Confederate cavalry commander responsible for screening Lee’s army and reporting the Federal advance","side":"Confederacy"},{"name":"Robert H. Chilton","role":"Lee’s assistant adjutant general who wrote and distributed Special Orders No. 191","side":"Confederacy"},{"name":"Ambrose E. Burnside","role":"Commander of the Army of the Potomac’s right wing during the advance from Washington","side":"United States"},{"name":"Edwin V. Sumner","role":"Commander of the Army of the Potomac’s center wing advancing toward Frederick","side":"United States"},{"name":"William B. Franklin","role":"Commander of the Army of the Potomac’s left wing along the Potomac corridor","side":"United States"},{"name":"Alfred Pleasonton","role":"United States cavalry commander screening McClellan’s advance","side":"United States"},{"name":"Dixon S. Miles","role":"United States commander of the Harpers Ferry garrison","side":"United States"},{"name":"Julius White","role":"United States commander who evacuated Martinsburg and reinforced Harpers Ferry","side":"United States"}],"losses":[],"gallery":[{"image":"/images/ep182-maryland-campaign-context.svg","alt":"Schematic map of the Confederate invasion and the United States response in Maryland during early September 1862.","caption":"Lee moved north of the Potomac and then west from Frederick; McClellan’s three wings advanced from Washington across a broad front. Routes and distances are generalized.","source":"U.S. Army Center of Military History, National Park Service, Ezra A. Carman campaign maps, and episode transcript; see sources below."},{"image":"/images/ep182-special-orders-movements.svg","alt":"Schematic map of the major Confederate movements ordered in Special Orders No. 191.","caption":"The Harpers Ferry operation separated Lee’s army across western Maryland and the lower Shenandoah Valley while McClellan approached Frederick. This map is schematic and not to scale.","source":"U.S. Army Center of Military History, National Park Service, Ezra A. Carman campaign maps, Special Orders No. 191, and episode transcript; see sources below."},{"image":"/images/ep182-special-orders-191.jpg","alt":"Handwritten detail of Special Orders No. 191 showing paragraphs IV and V.","caption":"The surviving lost-order detail assigns Longstreet to Boonsboro and McLaws to Maryland Heights. The original is preserved in the George Brinton McClellan Papers.","source":"Library of Congress Manuscript Division, George Brinton McClellan Papers; see sources below."},{"image":"/images/ep182-robert-e-lee.jpg","alt":"Civil War-era glass-negative portrait of Confederate general Robert E. Lee.","caption":"Robert E. Lee issued Special Orders No. 191 on September 9 while the Army of Northern Virginia was near Frederick.","source":"Library of Congress Prints and Photographs Division; see sources below."},{"image":"/images/ep182-george-mcclellan.jpg","alt":"Civil War-era full-length portrait of United States major general George B. McClellan in uniform.","caption":"George B. McClellan reorganized the Federal pursuit and received the lost copy at Frederick on September 13.","source":"Library of Congress Prints and Photographs Division; see sources below."}],"sources":[{"label":"Official Civil War Podcast episode 182 page","url":"https://civilwarpodcast.org/2017/02/12/civil-war-podcast-episode-182/"},{"label":"National Park Service: Special Orders No. 191","url":"https://www.nps.gov/mono/learn/historyculture/so191.htm"},{"label":"National Park Service: An Invitation to Battle — Special Orders 191","url":"https://www.nps.gov/mono/learn/historyculture/an-invitation-to-battle.htm"},{"label":"National Park Service: Antietam campaign timeline","url":"https://www.nps.gov/anti/learn/historyculture/timeline.htm"},{"label":"U.S. Army Center of Military History: The Maryland and Fredericksburg Campaigns, 1862–1863","url":"https://history.army.mil/portals/143/Images/Publications/catalog/35-3-1.pdf"},{"label":"Official Records of the Union and Confederate Armies, Series I, Volume XIX, Part II","url":"https://ehistory.osu.edu/books/official-records/027"},{"label":"Library of Congress: Special Order No. 191 exhibition transcription and image","url":"https://www.loc.gov/exhibits/lincoln/ext/transcribe-143.html"},{"label":"Library of Congress: George Brinton McClellan Papers collection","url":"https://www.loc.gov/collections/george-brinton-mcclellan-papers/about-this-collection/"},{"label":"Primary map series: Ezra A. Carman’s Theatre of Operations, Maryland Campaign","url":"https://www.loc.gov/item/2009584566/"},{"label":"Primary map: Robert Knox Sneden’s Antietam Campaign","url":"https://www.loc.gov/item/gvhs01.vhs00111/"},{"label":"Library of Congress: Robert E. Lee portrait","url":"https://www.loc.gov/item/2018666540/"},{"label":"Library of Congress: George B. McClellan portrait","url":"https://www.loc.gov/item/2016649613/"},{"label":"Primary source: McClellan to Abraham Lincoln, September 13, 1862","url":"https://www.loc.gov/resource/mal.1840800/"},{"label":"Primary source: Silas Colgrove’s account of finding Lee’s lost dispatch","url":"https://ehistory.osu.edu/books/battles/vol2/603"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
