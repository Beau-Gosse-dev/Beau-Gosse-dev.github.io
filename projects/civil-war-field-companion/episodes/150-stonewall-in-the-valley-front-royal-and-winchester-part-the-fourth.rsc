2f:["$","figure","Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep150-hotchkiss-valley-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-hotchkiss-valley-map.jpg","alt":"Jedediah Hotchkiss’s 1862 manuscript map of the Shenandoah Valley from Winchester to Staunton.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley"}],["$","span",null,{"children":"Hotchkiss’s large manuscript map records the Valley’s roads, rivers, ridges, settlements, and landowners from Winchester to Staunton. It is a primary cartographic source, not a dated battle map; it provides geographic context for the roads used in the advance and retreat."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep150-hotchkiss-valley-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99446754/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
30:["$","div","Cavalry under Banks-Brig. Gen. John P. Hatch",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry under Banks"}],["$","span",null,{"children":"Brig. Gen. John P. Hatch"}],["$","small",null,{"children":"Approximately 1,500 mounted troops in the episode’s accounting; attended the midnight council and accompanied the withdrawal but had limited value in the fixed infantry defense"}]]}]
31:["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Overall commander, Valley force-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Overall commander, Valley force"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Directed the converging approach on Winchester, ordered Winder onto the western ridge, committed Taylor against Bowers Hill, and sought a cavalry pursuit"}]]}],["$","div","Division commander, eastern approach-Maj. Gen. Richard S. Ewell",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander, eastern approach"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Advanced along the Front Royal Road, opened the fight against Camp Hill, and shifted forces toward Donnelly’s flank and withdrawal route"}]]}],["$","div","Brigade, Ewell’s division-Brig. Gen. Isaac R. Trimble",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Isaac R. Trimble"}],["$","small",null,{"children":"21st North Carolina, 21st Georgia, 15th Alabama, and 16th Mississippi; the two 21st regiments led the unsuccessful initial attack in the fog"}]]}],["$","div","1st Maryland Infantry, Confederate States-Col. Bradley T. Johnson",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Maryland Infantry, Confederate States"}],["$","span",null,{"children":"Col. Bradley T. Johnson"}],["$","small",null,{"children":"Moved toward the far United States left during the lull, helping threaten Donnelly’s flank and line of retreat"}]]}],["$","div","Stonewall Brigade, Jackson’s division-Brig. Gen. Charles S. Winder",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade, Jackson’s division"}],["$","span",null,{"children":"Brig. Gen. Charles S. Winder"}],["$","small",null,{"children":"Occupied the first ridge west of the Valley Turnpike and held under fire from Gordon’s stronger Bowers Hill position until Taylor attacked"}]]}],["$","div","Louisiana Brigade, Ewell’s division-Brig. Gen. Richard Taylor",{"className":"command-entry","children":[["$","strong",null,{"children":"Louisiana Brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Richard Taylor"}],["$","small",null,{"children":"Moved from reserve against the Federal right and delivered the decisive attack on Bowers Hill about 7:30 a.m."}]]}],["$","div","Chief of artillery-Col. Stapleton Crutchfield",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief of artillery"}],["$","span",null,{"children":"Col. Stapleton Crutchfield"}],["$","small",null,{"children":"Directed Jackson’s artillery on the western sector, including batteries supporting Winder and Taylor near the Valley Turnpike"}]]}],["$","div","Valley cavalry-Col. Turner Ashby",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley cavalry"}],["$","span",null,{"children":"Col. Turner Ashby"}],["$","small",null,{"children":"Expected to support the pursuit north of Winchester; disorganization and discipline failures left much of the cavalry ineffective at the decisive moment"}]]}]]]}]
32:["$","section",null,{"className":"other-people","aria-label":"Other people","children":[["$","h3",null,{"className":"subsection-title","children":"Other people"}],"$undefined",["$","ul",null,{"className":"other-people-list","children":[["$","li","Abraham Lincoln",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-abraham-lincoln.jpg","alt":"Portrait of Abraham Lincoln","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h4",null,{"children":"Abraham Lincoln"}],["$","p",null,{"children":"President who suspended McDowell’s movement toward Richmond and attempted to trap Jackson with converging forces from east and west"}]]}]]}]}],["$","li","Edwin M. Stanton",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-edwin-stanton.jpg","alt":"Portrait of Edwin M. Stanton","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h4",null,{"children":"Edwin M. Stanton"}],["$","p",null,{"children":"Secretary of war who gathered reports, mobilized reinforcements, and transmitted orders during the Valley crisis"}]]}]]}]}],["$","li","Nathaniel P. Banks",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-nathaniel-banks.jpg","alt":"Portrait of Nathaniel P. Banks","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h4",null,{"children":"Nathaniel P. Banks"}],["$","p",null,{"children":"United States department commander who made a delaying stand south of Winchester and then preserved much of his remaining command by retreating north"}]]}]]}]}],["$","li","Alpheus S. Williams",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","div",null,{"className":"portrait-placeholder","aria-label":"No portrait available for Alpheus S. Williams","children":["$","span",null,{"children":"AS"}]}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h4",null,{"children":"Alpheus S. Williams"}],["$","p",null,{"children":"Division commander who controlled the two Federal infantry brigades and ordered Donnelly’s withdrawal after Gordon’s right collapsed"}]]}]]}]}],["$","li","George H. Gordon",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","div",null,{"className":"portrait-placeholder","aria-label":"No portrait available for George H. Gordon","children":["$","span",null,{"children":"GH"}]}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h4",null,{"children":"George H. Gordon"}],["$","p",null,{"children":"Commander of the Federal brigade holding the Bowers Hill sector west of the Valley Turnpike"}]]}]]}]}],["$","li","Dudley Donnelly",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","div",null,{"className":"portrait-placeholder","aria-label":"No portrait available for Dudley Donnelly","children":["$","span",null,{"children":"DD"}]}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h4",null,{"children":"Dudley Donnelly"}],["$","p",null,{"children":"Commander of the Federal brigade that repulsed Ewell’s first attacks near Camp Hill and then withdrew through Winchester"}]]}]]}]}],["$","li","John P. Hatch",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","div",null,{"className":"portrait-placeholder","aria-label":"No portrait available for John P. Hatch","children":"$L40"}],"$L41"]}]}],"$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b"]}]]}]
33:["$","figcaption",null,{"children":"Winder’s Stonewall Brigade seized the first ridge west of the Valley Turnpike but required Taylor’s support to dislodge the stronger Federal line beyond."}]
