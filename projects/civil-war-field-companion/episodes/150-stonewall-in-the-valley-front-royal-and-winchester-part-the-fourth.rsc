6c:["$","article","Isaac R. Trimble",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"IR"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Isaac R. Trimble"}],["$","p",null,{"children":"Ewell brigade commander whose 21st North Carolina and 21st Georgia led the repulsed opening attack near Camp Hill"}]]}]]}]
6d:["$","article","Turner Ashby",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"TA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Turner Ashby"}],["$","p",null,{"children":"Confederate cavalry commander whose mounted arm was not effectively organized for the pursuit north of Winchester"}]]}]]}]
