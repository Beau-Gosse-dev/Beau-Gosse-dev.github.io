67:["$","article","Wilder Dwight",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WD"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Wilder Dwight"}],["$","p",null,{"children":"Major of the 2nd Massachusetts whose opening eyewitness account describes the collapse on Bowers Hill, retreat into Winchester, and capture"}]]}]]}]
68:["$","article","Thomas J. “Stonewall” Jackson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-stonewall-jackson.jpg","alt":"Portrait of Thomas J. “Stonewall” Jackson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Overall Confederate commander who attacked at daylight, committed Taylor against Bowers Hill, captured Winchester, and drove Banks toward the Potomac"}]]}]]}]
69:["$","article","Richard S. Ewell",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-richard-ewell.jpg","alt":"Portrait of Richard S. Ewell","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Richard S. Ewell"}],["$","p",null,{"children":"Division commander who approached on the Front Royal Road, attacked the Federal left, and then threatened its flank and retreat"}]]}]]}]
6a:["$","article","Richard Taylor",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-richard-taylor.jpg","alt":"Portrait of Richard Taylor","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Richard Taylor"}],["$","p",null,{"children":"Louisiana brigade commander whose disciplined flank attack broke the Federal right on Bowers Hill"}]]}]]}]
