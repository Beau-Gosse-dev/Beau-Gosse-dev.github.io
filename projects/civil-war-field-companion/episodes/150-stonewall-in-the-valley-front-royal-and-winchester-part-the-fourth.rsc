1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",150," · ","May 24–25, 1862"," · ","Washington, D.C., and northern Virginia; the battlefield south of Winchester from Bowers Hill across the Valley Turnpike to Camp Hill and the Front Royal Road, followed by the United States retreat through Winchester toward Martinsburg and the Potomac River"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: FRONT ROYAL & WINCHESTER (Part the Fourth)"}],["$","span",null,{"className":"result-label","children":"Decisive Confederate victory at the First Battle of Winchester. Jackson and Ewell attacked Banks’s exhausted command at daylight on May 25. The initial Confederate attack against Camp Hill failed, but Richard Taylor’s Louisiana Brigade turned the United States right on Bowers Hill and forced both Federal brigades to withdraw through Winchester. Banks preserved much of his mobile force by retreating north, while disorganized and misplaced Confederate cavalry failed to convert victory into destruction. Jackson cleared the northern Valley and disrupted the planned reinforcement of McClellan near Richmond; Lincoln responded by redirecting forces under McDowell and Frémont in an attempt to trap Jackson"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9596907152.mp3?updated=1695307590","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Washington’s reaction on May 24 and the First Battle of Winchester on May 25, 1862"}],["$","small",null,{"children":"The opening eyewitness readings describe the fighting and retreat before the episode begins its chronological account. The pursuit toward the Potomac closes this installment; the attempt to trap Jackson belongs to the next episode."}]]}],["$","div","Battle result",{"children":[["$","span",null,{"children":"Battle result"}],["$","strong",null,{"children":"Decisive Confederate victory"}],["$","small",null,{"children":"Banks abandoned Winchester and continued north toward the Potomac. The Confederate victory was operationally important but incomplete because the United States command escaped."}]]}],["$","div","Strategic consequence",{"children":[["$","span",null,{"children":"Strategic consequence"}],["$","strong",null,{"children":"McDowell’s movement toward Richmond was suspended"}],["$","small",null,{"children":"Lincoln redirected part of McDowell’s force west and ordered Frémont east. These movements were intended to close behind Jackson, but they also prevented McDowell from joining McClellan before Richmond as planned."}]]}],["$","div","Lincoln’s response",{"children":[["$","span",null,{"children":"Lincoln’s response"}],"$Le","$Lf"]}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}],"$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e"]}]]}]
31:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","strong",null,{"children":"An attempted envelopment, not a simple flight from danger"}]
f:["$","small",null,{"children":"The episode rejects the familiar description of Lincoln as panicked. His May 24 orders show an aggressive effort to use Frémont and McDowell as converging forces in Jackson’s rear, although concern for Harpers Ferry, the Baltimore and Ohio Railroad, and Washington was real."}]
10:["$","div","McDowell order",{"children":[["$","span",null,{"children":"McDowell order"}],["$","strong",null,{"children":"Move 20,000 men toward the Shenandoah Valley"}],["$","small",null,{"children":"This halted the planned southward cooperation with McClellan. The episode presents the decision as Jackson’s greatest strategic effect during this phase of the Valley Campaign."}]]}]
11:["$","div","Frémont order",{"children":[["$","span",null,{"children":"Frémont order"}],["$","strong",null,{"children":"Advance east from the Mountain Department toward the Valley"}],["$","small",null,{"children":"Lincoln expected Frémont and McDowell to become the two sides of a trap behind Jackson. Terrain, distance, roads, timing, and divided command made coordination difficult."}]]}]
12:["$","div","“Commissary Banks”",{"children":[["$","span",null,{"children":"“Commissary Banks”"}],["$","strong",null,{"children":"A nickname built around captured United States supplies"}],["$","small",null,{"children":"The episode argues that Confederate enthusiasm reflected chronic supply shortages as much as the scale of Banks’s losses. It cites a United States quartermaster report of no more than 106 vehicles lost during the retreat from Strasburg to Williamsport and says at least 500 wagons escaped."}]]}]
13:["$","div","Confederate numbers",{"children":[["$","span",null,{"children":"Confederate numbers"}],["$","strong",null,{"children":"Uncertain; Jackson believed about 11,000 were within striking distance"}],["$","small",null,{"children":"Heavy straggling makes the number actually present on May 25 difficult to establish. The NPS narrative uses close to 16,000 for Jackson’s available force, while the episode’s lower figure concerns men believed to be within immediate reach. These are different measures and should not be merged."}]]}]
14:["$","div","United States numbers",{"children":[["$","span",null,{"children":"United States numbers"}],["$","strong",null,{"children":"Probably about 4,400 infantry plus roughly 1,500 cavalry in the episode’s estimate"}],["$","small",null,{"children":"Banks’s same-day report said fewer than 4,000 were engaged, while NPS accounts use approximately 5,000 or 6,500 depending on scope. The episode excludes Hatch’s cavalry from its estimate of troops useful in a stand-up infantry fight."}]]}]
15:["$","div","Federal purpose",{"children":[["$","span",null,{"children":"Federal purpose"}],["$","strong",null,{"children":"Delay the Confederates while trains and troops moved north"}],["$","small",null,{"children":"Banks, Alpheus Williams, and John Hatch agreed at a midnight council to offer battle despite expecting defeat. Winchester lay directly behind the defensive line, making withdrawal through town hazardous."}]]}]
16:["$","div","Terrain",{"children":[["$","span",null,{"children":"Terrain"}],["$","strong",null,{"children":"A roughly 2.5-mile defensive front north of Abram’s Creek"}],["$","small",null,{"children":"Gordon’s brigade held the western sector near Bowers Hill and the Valley Turnpike. Donnelly’s brigade held the eastern sector near Camp Hill and the Front Royal Road."}]]}]
17:["$","div","Opening conditions",{"children":[["$","span",null,{"children":"Opening conditions"}],["$","strong",null,{"children":"Dense fog at daylight after little rest"}],["$","small",null,{"children":"Jackson’s men began filing into position about 4:00 a.m. after roughly two hours of rest. The fog restricted visibility and delayed or disrupted observation on both sectors."}]]}]
18:["$","div","Ewell’s instruction",{"children":[["$","span",null,{"children":"Ewell’s instruction"}],["$","strong",null,{"children":"Attack at daylight"}],["$","small",null,{"children":"The episode describes Jackson’s dispatch as a single sheet containing a sketch map of the positions and the written order. Ewell approached from the southeast along the Front Royal Road while Jackson advanced on the Valley Turnpike."}]]}]
19:["$","div","Camp Hill attack",{"children":[["$","span",null,{"children":"Camp Hill attack"}],["$","strong",null,{"children":"Repulsed"}],["$","small",null,{"children":"The 21st North Carolina and 21st Georgia advanced first through the fog. Donnelly’s infantry stopped the attack, including a second effort described in the episode as a bayonet charge. Ewell then shifted troops toward the exposed Federal flank and line of retreat."}]]}]
1a:["$","div","Bowers Hill",{"children":[["$","span",null,{"children":"Bowers Hill"}],["$","strong",null,{"children":"The decisive sector west of the Valley Turnpike"}],["$","small",null,{"children":"Winder occupied an initial ridge but encountered a stronger United States position beyond it. Gordon’s line and artillery held until Taylor’s Louisiana Brigade moved against the western flank."}]]}]
1b:["$","div","Decisive attack",{"children":[["$","span",null,{"children":"Decisive attack"}],["$","strong",null,{"children":"Taylor’s Louisiana Brigade advanced about 7:30 a.m."}],["$","small",null,{"children":"Taylor moved around the United States right, then attacked Bowers Hill. The 29th Pennsylvania and 27th Indiana broke; the 2nd Massachusetts and 3rd Wisconsin then withdrew as Gordon’s position became untenable."}]]}]
1c:["$","div","Federal withdrawal",{"children":[["$","span",null,{"children":"Federal withdrawal"}],["$","strong",null,{"children":"Both brigades retired through Winchester"}],["$","small",null,{"children":"Once the right collapsed, Williams ordered Donnelly to withdraw from the eastern sector. The episode says the battle was effectively over by about 9:30 a.m."}]]}]
1d:["$","div","Civilians in Winchester",{"children":[["$","span",null,{"children":"Civilians in Winchester"}],["$","strong",null,{"children":"Rejoicing is well documented; firing on retreating soldiers is reported but its extent is uncertain"}],["$","small",null,{"children":"Contemporary accounts describe civilians greeting Confederate troops. Numerous Federal reports also accused townspeople of firing from streets or buildings, but the guide does not treat every allegation or the number of participants as established."}]]}]
1e:["$","div","Confederate cavalry failure",{"children":[["$","span",null,{"children":"Confederate cavalry failure"}],["$","strong",null,{"children":"Banks’s retreating force was not destroyed"}],["$","small",null,{"children":"The episode attributes the failure to command confusion among Ewell’s mounted troops and poor discipline and organization in Turner Ashby’s command. Jackson later regretted that his cavalry was not in position for the pursuit."}]]}]
1f:["$","div","Retreat distance",{"children":[["$","span",null,{"children":"Retreat distance"}],["$","strong",null,{"children":"About 22 miles from Winchester to Martinsburg, then onward to the Potomac"}],["$","small",null,{"children":"Banks reported reaching Martinsburg at 2:40 p.m. on May 25 with his trains ahead. The episode says the force then covered roughly another dozen miles toward Williamsport."}]]}]
20:["$","div","Retreat timing discrepancy",{"children":[["$","span",null,{"children":"Retreat timing discrepancy"}],["$","strong",null,{"children":"The transcript’s “Tuesday at 2 a.m.” crossing is not supported by the cited official account"}],["$","small",null,{"children":"The episode audio appears to place the Potomac crossing early Tuesday, May 27. The NPS narrative places it that evening, and Banks’s May 25 dispatch said the trains were already in advance toward the river. The guide flags the audio date rather than silently adopting it."}]]}]
21:["$","div","United States casualties",{"children":[["$","span",null,{"children":"United States casualties"}],["$","strong",null,{"children":"71 killed, 243 wounded, and 1,714 missing for May 23–25"}],["$","small",null,{"children":"Banks’s reports combined losses at Front Royal, the May 24 retreat, Winchester, and the subsequent withdrawal. The NPS battle database gives 2,019 United States casualties for Winchester I, while the detailed NPS narrative repeats the 2,028 three-day total. These figures use different scopes."}]]}]
22:["$","div","Confederate casualties",{"children":[["$","span",null,{"children":"Confederate casualties"}],["$","strong",null,{"children":"68 killed, 329 wounded, and 3 missing for May 23–25"}],["$","small",null,{"children":"Jackson’s reported total covers the three days rather than Winchester alone. The NPS battle database gives 400 Confederate casualties for Winchester I, nearly the same number but not explicitly the same accounting."}]]}]
23:["$","div","Tactical assessment",{"children":[["$","span",null,{"children":"Tactical assessment"}],["$","strong",null,{"children":"Successful flank attack after limited coordination"}],["$","small",null,{"children":"The episode criticizes Jackson and Ewell for failing to combine multiple brigades simultaneously and for underestimating fatigue. The victory rested on maneuver, numerical advantage, and Taylor’s decisive attack more than on coordinated tactical control across the field."}]]}]
24:["$","div","Important leader losses",{"children":[["$","span",null,{"children":"Important leader losses"}],["$","strong",null,{"children":"No senior commander was killed or mortally wounded"}],["$","small",null,{"children":"Maj. Wilder Dwight of the 2nd Massachusetts was captured during the retreat through Winchester but survived this battle. The opening account identifies Rockbridge Artillery private Robert T. McKim as killed; he was not a command-level casualty."}]]}]
25:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Ewell, Irvin McDowell, Frémont, Strasburg, caissons, and Valley Turnpike"}],["$","small",null,{"children":"The automated transcript repeatedly renders these as “Yule,” “Urban McDowell,” “Fremont,” “Strasbourg,” “Kasons,” and “term pite.” The guide uses standard historical spellings. “Bob McKim” in the opening account is identified as Robert T. McKim."}]]}]
26:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“The Shenandoah Valley Campaign of 1862,” edited by Gary W. Gallagher"}],"$undefined"]}]
27:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
28:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","May 24: Lincoln redirects the campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep150-lincoln-trap-operation.svg","target":"_blank","rel":"noreferrer","aria-label":"Open May 24: Lincoln redirects the campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-lincoln-trap-operation.svg","alt":"Schematic operational map showing Jackson at Winchester, Frémont ordered east, McDowell redirected west from Fredericksburg, and the suspended United States movement toward Richmond.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"May 24: Lincoln redirects the campaign"}],["$","span",null,{"children":"Jackson’s advance toward Winchester threatened the northern Valley while McDowell and Shields were preparing to move south from Fredericksburg toward McClellan near Richmond. Lincoln suspended that junction, ordered 20,000 of McDowell’s men west, and directed Frémont east from the mountains in an attempted convergence behind Jackson. This operational map is schematic: routes, force locations, distances, and the proposed closing points are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep150-lincoln-trap-operation.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/resource/mal.4500047/?st=gallery","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","May 25: First Battle of Winchester",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep150-first-winchester-tactics.svg","target":"_blank","rel":"noreferrer","aria-label":"Open May 25: First Battle of Winchester at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-first-winchester-tactics.svg","alt":"Schematic tactical map of First Winchester showing Bowers Hill, Camp Hill, the United States defensive line, Confederate attacks, and the retreat through Winchester.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"May 25: First Battle of Winchester"}],["$","span",null,{"children":"Banks’s two brigades occupied high ground north of Abram’s Creek. Ewell’s first attack against Donnelly on Camp Hill failed. West of the Valley Turnpike, Winder reached an advanced ridge and Taylor’s Louisiana Brigade then turned Gordon’s right on Bowers Hill. The collapse forced both United States brigades through Winchester and north on the Martinsburg Road. This is a schematic phase map, not a surveyed plot; roads, terrain, unit positions, timing, and distances are simplified."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep150-first-winchester-tactics.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/articles/000/first-battle-of-winchester.htm","target":"_blank","rel":"noreferrer","children":["Map source ","$L2f"]}]]}],"$undefined"]}]]}],"$L30"]}]]}]
29:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Robert Barton recalls the artillery advance",{"className":"moment","children":[["$","$L31",null,{"seconds":0,"label":"0:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Robert Barton recalls the artillery advance"}],["$","p",null,{"children":"The opening reading follows Rockbridge Artillery private Robert T. Barton as the battery moved under shellfire south of Winchester. He describes clinging to a moving caisson and then finding Robert T. McKim dead beside the road."}]]}]]}],["$","div","Wilder Dwight sees the Federal right collapse",{"className":"moment","children":[["$","$L31",null,{"seconds":169,"label":"2:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wilder Dwight sees the Federal right collapse"}],["$","p",null,{"children":"Maj. Wilder Dwight of the 2nd Massachusetts saw the 27th Indiana and 29th Pennsylvania break as Confederates came around the right. He withdrew on foot, was cut off in Winchester, and became a prisoner."}]]}]]}],["$","div","The episode turns to May 25",{"className":"moment","children":[["$","$L31",null,{"seconds":310,"label":"5:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode turns to May 25"}],["$","p",null,{"children":"After the eyewitness readings, the hosts resume the Valley Campaign on the morning of the First Battle of Winchester."}]]}]]}],["$","div","The “Commissary Banks” story is qualified",{"className":"moment","children":[["$","$L31",null,{"seconds":353,"label":"5:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"The “Commissary Banks” story is qualified"}],["$","p",null,{"children":"The episode contrasts Confederate boasts about captured trains with the quartermaster’s report of no more than 106 vehicles lost during the two-day retreat, while at least 500 wagons escaped."}]]}]]}],["$","div","Washington assesses Jackson’s offensive",{"className":"moment","children":[["$","$L31",null,{"seconds":440,"label":"7:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Washington assesses Jackson’s offensive"}],["$","p",null,{"children":"Lincoln and Stanton received Banks’s report from Winchester and began assembling reinforcements while evaluating the danger to Harpers Ferry, the Baltimore and Ohio Railroad, and the capital."}]]}]]}],["$","div","Lincoln returns from McDowell’s camp",{"className":"moment","children":[["$","$L31",null,{"seconds":498,"label":"8:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln returns from McDowell’s camp"}],["$","p",null,{"children":"Lincoln had just reviewed the proposed advance from Fredericksburg toward Richmond with Irvin McDowell and James Shields when the news from Front Royal changed the strategic problem."}]]}]]}],["$","div","Lincoln sees an opportunity to trap Jackson",{"className":"moment","children":[["$","$L31",null,{"seconds":582,"label":"9:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln sees an opportunity to trap Jackson"}],["$","p",null,{"children":"The president reasoned that a deeper Confederate advance down the Valley could expose Jackson’s rear to converging United States columns."}]]}]]}],["$","div","McDowell is redirected",{"className":"moment","children":[["$","$L31",null,{"seconds":614,"label":"10:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"McDowell is redirected"}],["$","p",null,{"children":"Lincoln suspended McDowell’s movement toward McClellan and ordered 20,000 men west toward the Shenandoah Valley."}]]}]]}],["$","div","Frémont is ordered east",{"className":"moment","children":[["$","$L31",null,{"seconds":628,"label":"10:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Frémont is ordered east"}],["$","p",null,{"children":"John C. Frémont was to move from the Mountain Department toward the Valley, forming the western side of the attempted envelopment."}]]}]]}],["$","div","Lincoln informs McClellan",{"className":"moment","children":[["$","$L31",null,{"seconds":648,"label":"10:48"}],"$L32"]}],"$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49"]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","National strategic direction",{"className":"command-entry","children":[["$","strong",null,{"children":"National strategic direction"}],["$","span",null,{"children":"President Abraham Lincoln / Secretary Edwin M. Stanton"}],["$","small",null,{"children":"Suspended McDowell’s move toward McClellan, directed reinforcements toward the Valley, and attempted to coordinate McDowell and Frémont behind Jackson"}]]}],["$","div","Department of the Rappahannock",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Rappahannock"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Ordered to put 20,000 men in motion toward the Shenandoah instead of continuing the planned advance from Fredericksburg toward Richmond"}]]}],["$","div","Mountain Department",{"className":"command-entry","children":[["$","strong",null,{"children":"Mountain Department"}],["$","span",null,{"children":"Maj. Gen. John C. Frémont"}],["$","small",null,{"children":"Ordered to advance east toward the Valley as the western arm of the proposed convergence behind Jackson"}]]}],["$","div","Department of the Shenandoah",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Shenandoah"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Overall commander at Winchester; chose to make a delaying stand, then directed the retreat north toward Martinsburg and the Potomac"}]]}],["$","div","Infantry division under Banks",{"className":"command-entry","children":[["$","strong",null,{"children":"Infantry division under Banks"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Controlled Gordon’s and Donnelly’s brigades; ordered the eastern brigade to withdraw after the western position collapsed"}]]}],["$","div","Western brigade, Bowers Hill sector",{"className":"command-entry","children":[["$","strong",null,{"children":"Western brigade, Bowers Hill sector"}],["$","span",null,{"children":"Col. George H. Gordon"}],["$","small",null,{"children":"2nd Massachusetts, 3rd Wisconsin, 27th Indiana, and 29th Pennsylvania; faced Winder and Taylor west of the Valley Turnpike"}]]}],["$","div","Eastern brigade, Camp Hill sector",{"className":"command-entry","children":[["$","strong",null,{"children":"Eastern brigade, Camp Hill sector"}],["$","span",null,{"children":"Col. Dudley Donnelly"}],["$","small",null,{"children":"5th Connecticut, 28th New York, and 46th Pennsylvania, supported by the 10th Maine skirmish line and United States artillery; faced Ewell on the Front Royal Road"}]]}],["$","div","Cavalry under Banks",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry under Banks"}],["$","span",null,{"children":"Brig. Gen. John P. Hatch"}],["$","small",null,{"children":"Approximately 1,500 mounted troops in the episode’s accounting; attended the midnight council and accompanied the withdrawal but had limited value in the fixed infantry defense"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Overall commander, Valley force",{"className":"command-entry","children":[["$","strong",null,{"children":"Overall commander, Valley force"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Directed the converging approach on Winchester, ordered Winder onto the western ridge, committed Taylor against Bowers Hill, and sought a cavalry pursuit"}]]}],["$","div","Division commander, eastern approach",{"className":"command-entry","children":["$L4a","$L4b","$L4c"]}],"$L4d","$L4e","$L4f","$L50","$L51","$L52"]]}]]}],"$L53","$L54"]}]
2b:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Maj. Wilder Dwight",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Wilder Dwight"}],["$","p",null,{"children":[["$","strong",null,{"children":["Major, 2nd Massachusetts Infantry, Gordon’s brigade","."]}]," ","Cut off and captured during the retreat through Winchester; he survived this battle. No senior commander on either side was killed or mortally wounded at First Winchester."]}]]}]]}]]}]
2c:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep150-hotchkiss-valley-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-hotchkiss-valley-map.jpg","alt":"Jedediah Hotchkiss’s large 1862 manuscript map of the Shenandoah Valley.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hotchkiss’s primary-source map shows Winchester, the Valley road network, waterways, ridges, settlements, and the broader geographic corridor through which both armies moved. It is not a battle-phase map."}]]}],["$","figure","/images/ep150-abraham-lincoln.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-abraham-lincoln.jpg","alt":"Abraham Lincoln seated for a photographic portrait in May 1861.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Lincoln answered the Valley crisis by suspending McDowell’s junction with McClellan and attempting to place converging United States forces behind Jackson."}]]}],["$","figure","/images/ep150-edwin-stanton.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-edwin-stanton.jpg","alt":"Wartime photographic portrait of Secretary of War Edwin M. Stanton.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Stanton coordinated information and reinforcements from the War Department as Banks retreated and Lincoln revised the campaign."}]]}],["$","figure","/images/ep150-nathaniel-banks.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-nathaniel-banks.jpg","alt":"Civil War-era photographic portrait of United States general Nathaniel P. Banks in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Banks chose to fight south of Winchester long enough to cover his trains, then withdrew through the town and continued toward the Potomac."}]]}],["$","figure","/images/ep150-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-stonewall-jackson.jpg","alt":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson won decisively at Winchester and achieved the strategic diversion he sought, but the absence of an effective cavalry pursuit allowed Banks’s field force to escape."}]]}],["$","figure","/images/ep150-richard-ewell.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-richard-ewell.jpg","alt":"Wartime photographic portrait of Confederate general Richard S. Ewell in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Ewell approached from the southeast and attacked Donnelly near Camp Hill. His first efforts failed, after which his troops threatened the Federal flank and withdrawal route."}]]}],["$","figure","/images/ep150-richard-taylor.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-richard-taylor.jpg","alt":"Civil War-era photographic portrait of Confederate general Richard Taylor in civilian dress.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Taylor’s Louisiana Brigade delivered the battle’s decisive attack, turning Gordon’s right and breaking the Bowers Hill position."}]]}],["$","figure","/images/ep150-charles-winder.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-charles-winder.jpg","alt":"Engraved portrait of Confederate brigadier general Charles S. Winder in uniform.","width":1280,"height":820,"loading":"lazy"}],"$L55"]}],"$L56","$L57"]}]]}]
