30:["$","figure","Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep150-hotchkiss-valley-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-hotchkiss-valley-map.jpg","alt":"Jedediah Hotchkiss’s 1862 manuscript map of the Shenandoah Valley from Winchester to Staunton.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley"}],["$","span",null,{"children":"Hotchkiss’s large manuscript map records the Valley’s roads, rivers, ridges, settlements, and landowners from Winchester to Staunton. It is a primary cartographic source, not a dated battle map; it provides geographic context for the roads used in the advance and retreat."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep150-hotchkiss-valley-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99446754/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
32:["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln informs McClellan"}],["$","p",null,{"children":"In the May 24 telegram quoted by the episode, Lincoln explained that Banks’s critical position had compelled him to suspend McDowell’s movement and send Frémont and part of McDowell’s force into Jackson’s rear."}]]}]
33:["$","div","The focus returns to Winchester",{"className":"moment","children":[["$","$L31",null,{"seconds":695,"label":"11:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"The focus returns to Winchester"}],["$","p",null,{"children":"Jackson prepared to fight on Sunday, May 25, before Banks could complete the movement of his army and trains toward the Potomac."}]]}]]}]
34:["$","div","Confederates deploy in fog",{"className":"moment","children":[["$","$L31",null,{"seconds":703,"label":"11:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates deploy in fog"}],["$","p",null,{"children":"At about 4:00 a.m., after roughly two hours of rest, Jackson’s tired troops moved into position southwest of Winchester under heavy fog."}]]}]]}]
35:["$","div","Ewell receives a sketch map and order",{"className":"moment","children":[["$","$L31",null,{"seconds":723,"label":"12:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell receives a sketch map and order"}],["$","p",null,{"children":"About a mile southeast of town, Ewell read Jackson’s dispatch showing the relative position near the Valley Turnpike and directing him to attack at daylight."}]]}]]}]
36:["$","div","Confederate strength remains uncertain",{"className":"moment","children":[["$","$L31",null,{"seconds":743,"label":"12:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate strength remains uncertain"}],["$","p",null,{"children":"Jackson believed close to 11,000 troops were within striking distance, but heavy overnight straggling prevents a reliable count of the men actually ready to fight."}]]}]]}]
37:["$","div","Banks chooses to make a stand",{"className":"moment","children":[["$","$L31",null,{"seconds":798,"label":"13:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks chooses to make a stand"}],["$","p",null,{"children":"Banks, Williams, and Hatch had agreed at midnight that the army should resist long enough to protect the northward movement, even though they expected the position to be defeated."}]]}]]}]
38:["$","div","Two Federal brigades cover Winchester",{"className":"moment","children":[["$","$L31",null,{"seconds":835,"label":"13:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two Federal brigades cover Winchester"}],["$","p",null,{"children":"Gordon’s four regiments held the western sector facing Jackson. Nearly two miles east, Donnelly’s three-regiment line covered the Front Royal Road against Ewell."}]]}]]}]
39:["$","div","Ewell attacks Camp Hill",{"className":"moment","children":[["$","$L31",null,{"seconds":868,"label":"14:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell attacks Camp Hill"}],["$","p",null,{"children":"The 21st North Carolina and 21st Georgia advanced through the fog against Donnelly. Federal fire repulsed the first approach and a renewed bayonet attack."}]]}]]}]
3a:["$","div","Ewell shifts toward the flank",{"className":"moment","children":[["$","$L31",null,{"seconds":910,"label":"15:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell shifts toward the flank"}],["$","p",null,{"children":"During a lull of nearly thirty minutes, Ewell moved the Confederate 1st Maryland and Trimble’s brigade toward the extreme Federal left, threatening Donnelly’s withdrawal route."}]]}]]}]
3b:["$","div","Winder occupies the first ridge",{"className":"moment","children":[["$","$L31",null,{"seconds":938,"label":"15:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Winder occupies the first ridge"}],["$","p",null,{"children":"Jackson ordered Charles Winder to take the height in front. The Stonewall Brigade reached it with little opposition, then came under heavy fire from Gordon’s stronger position beyond."}]]}]]}]
3c:["$","div","Gordon’s line holds Bowers Hill",{"className":"moment","children":[["$","$L31",null,{"seconds":979,"label":"16:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gordon’s line holds Bowers Hill"}],["$","p",null,{"children":"The episode places the 2nd Massachusetts in the center, the 29th Pennsylvania and 27th Indiana on the right, and the 3rd Wisconsin on the left of the western Federal sector."}]]}]]}]
3d:["$","div","Taylor is sent to carry the hill",{"className":"moment","children":[["$","$L31",null,{"seconds":1002,"label":"16:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taylor is sent to carry the hill"}],["$","p",null,{"children":"After Winder requested support, Jackson directed Richard Taylor’s Louisiana Brigade against the position anchoring the Federal right."}]]}]]}]
3e:["$","div","Taylor restores order under artillery fire",{"className":"moment","children":[["$","$L31",null,{"seconds":1030,"label":"17:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taylor restores order under artillery fire"}],["$","p",null,{"children":"Taylor’s sharp rebuke stopped his men from ducking and bunching under shells. Jackson then quietly reproved Taylor’s profanity before the brigade formed for its assault."}]]}]]}]
3f:["$","div","The Louisiana Brigade advances",{"className":"moment","children":[["$","$L31",null,{"seconds":1080,"label":"18:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Louisiana Brigade advances"}],["$","p",null,{"children":"At about 7:30 a.m., Taylor led the brigade in line toward the exposed western flank of the Bowers Hill position."}]]}]]}]
40:["$","div","The United States right breaks",{"className":"moment","children":[["$","$L31",null,{"seconds":1118,"label":"18:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The United States right breaks"}],["$","p",null,{"children":"Taylor’s attack overwhelmed the 29th Pennsylvania and 27th Indiana. Their collapse forced the 2nd Massachusetts and 3rd Wisconsin to withdraw."}]]}]]}]
41:["$","div","Williams orders a general withdrawal",{"className":"moment","children":[["$","$L31",null,{"seconds":1132,"label":"18:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Williams orders a general withdrawal"}],["$","p",null,{"children":"With Gordon’s sector collapsing, Williams instructed Donnelly to retire. The two brigades moved through Winchester, and the episode places the effective end of the battle around 9:30 a.m."}]]}]]}]
42:["$","div","The retreat passes through Winchester",{"className":"moment","children":[["$","$L31",null,{"seconds":1155,"label":"19:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The retreat passes through Winchester"}],["$","p",null,{"children":"Reports accused some residents of firing at Federal soldiers, while other civilians entered the streets to welcome Confederate troops. The exact scale of armed civilian participation remains uncertain."}]]}]]}]
43:["$","div","Confederate cavalry fails to close the victory",{"className":"moment","children":[["$","$L31",null,{"seconds":1204,"label":"20:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate cavalry fails to close the victory"}],["$","p",null,{"children":"Jackson wanted a mounted pursuit, but command confusion and poor organization left the cavalry unable to overtake and destroy Banks’s retreating column."}]]}]]}]
44:["$","div","Banks retreats toward the Potomac",{"className":"moment","children":[["$","$L31",null,{"seconds":1231,"label":"20:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks retreats toward the Potomac"}],["$","p",null,{"children":"The defeated command marched about 22 miles to Martinsburg and continued toward the river crossing near Williamsport. Banks’s same-day dispatch reported arrival at Martinsburg at 2:40 p.m."}]]}]]}]
45:["$","div","Casualty totals cover three days",{"className":"moment","children":[["$","$L31",null,{"seconds":1253,"label":"20:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Casualty totals cover three days"}],["$","p",null,{"children":"The episode gives 2,028 United States casualties and 400 Confederate casualties for May 23–25, warning that the official returns combine Front Royal, the retreat, Winchester, and the continued withdrawal."}]]}]]}]
46:["$","div","The episode separates tactics from maneuver",{"className":"moment","children":[["$","$L31",null,{"seconds":1287,"label":"21:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode separates tactics from maneuver"}],["$","p",null,{"children":"Jackson is criticized for piecemeal brigade employment and insufficient allowance for fatigue, while his ability to place troops for battle receives credit for making the victory possible."}]]}]]}]
47:["$","div","The operational success is decisive",{"className":"moment","children":[["$","$L31",null,{"seconds":1325,"label":"22:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"The operational success is decisive"}],["$","p",null,{"children":"Jackson captured Winchester, drove Banks across the Potomac, and compelled Lincoln to divert troops that otherwise were intended to reinforce McClellan near Richmond."}]]}]]}]
48:["$","div","The episode recommends Gallagher’s collection",{"className":"moment","children":[["$","$L31",null,{"seconds":1385,"label":"23:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode recommends Gallagher’s collection"}],["$","p",null,{"children":"The recommended book is “The Shenandoah Valley Campaign of 1862,” edited by Gary W. Gallagher, a collection of interpretive essays and a bibliographic essay."}]]}]]}]
49:["$","div","The podcast marks episode 150",{"className":"moment","children":[["$","$L31",null,{"seconds":1499,"label":"24:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"The podcast marks episode 150"}],["$","p",null,{"children":"The hosts note that the first 149 regular episodes totaled 80 hours and 50 minutes and reflect on the program’s growth since its November 2012 launch."}]]}]]}]
4a:["$","strong",null,{"children":"Division commander, eastern approach"}]
4b:["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}]
4c:["$","small",null,{"children":"Advanced along the Front Royal Road, opened the fight against Camp Hill, and shifted forces toward Donnelly’s flank and withdrawal route"}]
4d:["$","div","Brigade, Ewell’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Isaac R. Trimble"}],["$","small",null,{"children":"21st North Carolina, 21st Georgia, 15th Alabama, and 16th Mississippi; the two 21st regiments led the unsuccessful initial attack in the fog"}]]}]
4e:["$","div","1st Maryland Infantry, Confederate States",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Maryland Infantry, Confederate States"}],["$","span",null,{"children":"Col. Bradley T. Johnson"}],["$","small",null,{"children":"Moved toward the far United States left during the lull, helping threaten Donnelly’s flank and line of retreat"}]]}]
4f:["$","div","Stonewall Brigade, Jackson’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade, Jackson’s division"}],["$","span",null,{"children":"Brig. Gen. Charles S. Winder"}],["$","small",null,{"children":"Occupied the first ridge west of the Valley Turnpike and held under fire from Gordon’s stronger Bowers Hill position until Taylor attacked"}]]}]
50:["$","div","Louisiana Brigade, Ewell’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Louisiana Brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Richard Taylor"}],["$","small",null,{"children":"Moved from reserve against the Federal right and delivered the decisive attack on Bowers Hill about 7:30 a.m."}]]}]
51:["$","div","Chief of artillery",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief of artillery"}],["$","span",null,{"children":"Col. Stapleton Crutchfield"}],["$","small",null,{"children":"Directed Jackson’s artillery on the western sector, including batteries supporting Winder and Taylor near the Valley Turnpike"}]]}]
52:["$","div","Valley cavalry",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley cavalry"}],["$","span",null,{"children":"Col. Turner Ashby"}],["$","small",null,{"children":"Expected to support the pursuit north of Winchester; disorganization and discipline failures left much of the cavalry ineffective at the decisive moment"}]]}]
53:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
54:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Abraham Lincoln",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-abraham-lincoln.jpg","alt":"Portrait of Abraham Lincoln","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Abraham Lincoln"}],["$","p",null,{"children":"President who suspended McDowell’s movement toward Richmond and attempted to trap Jackson with converging forces from east and west"}]]}]]}],["$","article","Edwin M. Stanton",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-edwin-stanton.jpg","alt":"Portrait of Edwin M. Stanton","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Edwin M. Stanton"}],["$","p",null,{"children":"Secretary of war who gathered reports, mobilized reinforcements, and transmitted orders during the Valley crisis"}]]}]]}],["$","article","Nathaniel P. Banks",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-nathaniel-banks.jpg","alt":"Portrait of Nathaniel P. Banks","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Nathaniel P. Banks"}],["$","p",null,{"children":"United States department commander who made a delaying stand south of Winchester and then preserved much of his remaining command by retreating north"}]]}]]}],["$","article","Alpheus S. Williams",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AS"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Alpheus S. Williams"}],["$","p",null,{"children":"Division commander who controlled the two Federal infantry brigades and ordered Donnelly’s withdrawal after Gordon’s right collapsed"}]]}]]}],["$","article","George H. Gordon",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George H. Gordon"}],["$","p",null,{"children":"Commander of the Federal brigade holding the Bowers Hill sector west of the Valley Turnpike"}]]}]]}],["$","article","Dudley Donnelly",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"DD"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Dudley Donnelly"}],["$","p",null,{"children":"Commander of the Federal brigade that repulsed Ewell’s first attacks near Camp Hill and then withdrew through Winchester"}]]}]]}],["$","article","John P. Hatch",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JP"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John P. Hatch"}],["$","p",null,{"children":"Banks’s cavalry commander who attended the midnight council and accompanied the northward retreat"}]]}]]}],["$","article","Irvin McDowell",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-irvin-mcdowell.jpg","alt":"Portrait of Irvin McDowell","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Irvin McDowell"}],["$","p",null,{"children":"Department commander whose planned movement toward Richmond was suspended so that 20,000 men could be sent toward the Shenandoah"}]]}]]}],["$","article","John C. Frémont",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":"$L65"}],"$L66"]}],"$L67","$L68","$L69","$L6a","$L6b","$L6c","$L6d","$L6e"]}]
55:["$","figcaption",null,{"children":"Winder’s Stonewall Brigade seized the first ridge west of the Valley Turnpike but required Taylor’s support to dislodge the stronger Federal line beyond."}]
56:["$","figure","/images/ep150-lincoln-trap-operation.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-lincoln-trap-operation.svg","alt":"Schematic map of Lincoln’s attempted convergence against Jackson and the suspended movement toward Richmond.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The operational schematic separates the intended Richmond movement from Lincoln’s revised May 24 orders toward the Shenandoah Valley."}]]}]
57:["$","figure","/images/ep150-first-winchester-tactics.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep150-first-winchester-tactics.svg","alt":"Schematic phase map of the First Battle of Winchester.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The tactical schematic shows the repulse near Camp Hill, the decisive attack on Bowers Hill, and the Federal retreat through Winchester."}]]}]
