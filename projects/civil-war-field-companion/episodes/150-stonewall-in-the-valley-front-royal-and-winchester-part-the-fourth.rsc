0:{"page:/episodes/150-stonewall-in-the-valley-front-royal-and-winchester-part-the-fourth":"$L1","layout:/":"$L2","route:/episodes/150-stonewall-in-the-valley-front-royal-and-winchester-part-the-fourth":"$L3","__route":"route:/episodes/150-stonewall-in-the-valley-front-royal-and-winchester-part-the-fourth","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","__bfcacheSegmentIdentities":{"layout:/":"[\"layout\",\"layout:/\",\"root-boundary:/\",\"\"]","page:/episodes/150-stonewall-in-the-valley-front-royal-and-winchester-part-the-fourth":"[\"page\",\"page:/episodes/:slug\",\"root-boundary:/\",\"[\\\"episodes\\\",\\\"slug|150-stonewall-in-the-valley-front-royal-and-winchester-part-the-fourth|d\\\"]\"]"},"__srcPage":["episodes","[slug]","page"],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:640e88f6fbbce9f5","deploymentVersion":"5ab768e1-03ec-4f7d-a1a9-1a831aff438d","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
