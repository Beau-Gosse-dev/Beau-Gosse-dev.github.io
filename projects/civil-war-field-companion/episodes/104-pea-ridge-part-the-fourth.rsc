10:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.libsyn.com/104-pea-ridge-part-the-fourth",{"href":"https://civilwarpodcast.libsyn.com/104-pea-ridge-part-the-fourth","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 104"]}],["$","a","https://www.nps.gov/peri/planyourvisit/stop-7-elkhorn-tavern.htm",{"href":"https://www.nps.gov/peri/planyourvisit/stop-7-elkhorn-tavern.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Elkhorn Tavern"]}],["$","a","https://www.nps.gov/peri/planyourvisit/stop-7-east-overlook-day-2.htm",{"href":"https://www.nps.gov/peri/planyourvisit/stop-7-east-overlook-day-2.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: East Overlook, day two"]}],["$","a","https://www.nps.gov/peri/planyourvisit/stop-10-federal-artillery-day-2.htm",{"href":"https://www.nps.gov/peri/planyourvisit/stop-10-federal-artillery-day-2.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Federal artillery, day two"]}],["$","a","https://www.nps.gov/peri/planyourvisit/the-outcome.htm",{"href":"https://www.nps.gov/peri/planyourvisit/the-outcome.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: The outcome"]}],["$","a","https://www.nps.gov/peri/learn/historyculture/order-of-battle.htm",{"href":"https://www.nps.gov/peri/learn/historyculture/order-of-battle.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Pea Ridge order of battle"]}],["$","a","https://www.loc.gov/item/99447263/",{"href":"https://www.loc.gov/item/99447263/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Pea Ridge battlefield map"]}],["$","a","https://www.loc.gov/item/2013645343/",{"href":"https://www.loc.gov/item/2013645343/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Battle of Pea Ridge print"]}]]}]
