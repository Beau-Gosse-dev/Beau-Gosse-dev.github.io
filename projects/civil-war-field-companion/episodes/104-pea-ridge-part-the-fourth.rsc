"}],["$","small",null,{"children":"Grenville Dodge and William Vandever; bore most of the March 7 Elkhorn fighting"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of the West-Earl Van Dorn",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the West"}],["$","span",null,{"children":"Earl Van Dorn"}],["$","small",null,{"children":"Directed the right at Elkhorn Tavern and ordered the retreat"}]]}],["$","div","Missouri State Guard-Sterling Price",{"className":"command-entry","children":[["$","strong",null,{"children":"Missouri State Guard"}],["$","span",null,{"children":"Sterling Price"}],["$","small",null,{"children":"Directed the Confederate left despite being wounded"}]]}],["$","div","Wagon-train guard-Martin E. Green",{"className":"command-entry","children":[["$","strong",null,{"children":"Wagon-train guard"}],["$","span",null,{"children":"Martin E. Green"}],["$","small",null,{"children":"Led about 3,000 men and the train away by the detour"}]]}],["$","div","Indian Territory brigade-Albert Pike",{"className":"command-entry","children":[["$","strong",null,{"children":"Indian Territory brigade"}],["$","span",null,{"children":"Albert Pike"}],["$","small",null,{"children":"With part of the retreat north of Elkhorn Tavern"}]]}],["$","div","McCulloch’s Division-Benjamin McCulloch",{"className":"command-entry","children":[["$","strong",null,{"children":"McCulloch’s Division"}],["$","span",null,{"children":"Benjamin McCulloch"}],["$","small",null,{"children":"Killed at Leetown on March 7; most of the division did not rejoin Van Dorn"}]]}]]]}]]}],["$","section",null,{"className":"other-people","aria-label":"Other people","children":[["$","h3",null,{"className":"subsection-title","children":"Other people"}],"$undefined",["$","ul",null,{"className":"other-people-list","children":[["$","li","Samuel R. Curtis",{"children":["$","article",null,{"className