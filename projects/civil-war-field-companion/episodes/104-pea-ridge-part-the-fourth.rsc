1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",104," · ","March 7–8, 1862, with campaign consequences through July 1862"," · ","Elkhorn Tavern and the Telegraph Road at Pea Ridge, Arkansas; retreat routes to Van Buren; later movements to Corinth and Helena"]}],["$","h1",null,{"children":"PEA RIDGE (Part the Fourth)"}],["$","span",null,{"className":"result-label","children":"United States victory. Van Dorn captured Elkhorn Tavern late on March 7 but could not break Curtis’s army. On March 8, Curtis attacked with all four divisions while the Confederate ammunition train remained hours away. Van Dorn retreated, and Confederate forces did not regain control of northern Arkansas or Missouri"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8388476120.mp3?updated=1695129177","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","United States strength on March 8",{"children":[["$","span",null,{"children":"United States strength on March 8"}],["$","strong",null,{"children":"About 10,000 men in a line nearly one mile long"}],"$undefined"]}],["$","div","United States casualties",{"children":[["$","span",null,{"children":"United States casualties"}],["$","strong",null,{"children":"1,384; more than half in Carr’s division"}],"$undefined"]}],["$","div","Estimated Confederate casualties",{"children":[["$","span",null,{"children":"Estimated Confederate casualties"}],["$","strong",null,{"children":"About 2,000 in the battle, plus additional losses during the marches"}],"$undefined"]}],["$","div","Confederate supply train",{"children":[["$","span",null,{"children":"Confederate supply train"}],["$","strong",null,{"children":"Five or six hours from the battlefield when the March 8 attack began"}],"$undefined"]}],["$","div","Van Buren from Pea Ridge",{"children":[["$","span",null,{"children":"Van Buren from Pea Ridge"}],["$","strong",null,{"children":"About 90 miles directly, but farther by the available retreat routes"}],"$undefined"]}],["$","div","Territory secured",{"children":[["$","span",null,{"children":"Territory secured"}],["$","strong",null,{"children":"Northern Arkansas and Missouri remained under United States control"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}],"$undefined",["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Elkhorn Tavern today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interac