3e:["$","section","Confederacy",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Reinforced the threatened right, remained in position through September 18, and withdrew across the Potomac after dark"}]]}],["$","div","Confederate left wing-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate left wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Assessed a movement around the Federal right but abandoned it because Federal artillery and the Potomac closed the route"}]]}],["$","div","Cavalry and mixed force on the Confederate left-Maj. Gen. J. E. B. Stuart",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry and mixed force on the Confederate left"}],["$","span",null,{"children":"Maj. Gen. J. E. B. Stuart"}],["$","small",null,{"children":"Prepared the attempted flank movement and canceled it after Federal artillery suppressed his batteries"}]]}],["$","div","Light Division-Maj. Gen. A. P. Hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Light Division"}],["$","span",null,{"children":"Maj. Gen. A. P. Hill"}],["$","small",null,{"children":"Marched from Harpers Ferry and directed the counterattack that broke the Ninth Corps left"}]]}],["$","div","South Carolina brigade, Light Division-Brig. Gen. Maxcy Gregg",{"className":"command-entry","children":[["$","strong",null,{"children":"South Carolina brigade, Light Division"}],["$","span",null,{"children":"Brig. Gen. Maxcy Gregg"}],["$","small",null,{"children":"Attacked the 16th Connecticut and 4th Rhode Island in Otto’s 40-acre cornfield"}]]}],["$","div