f:["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Battle casualties",{"children":[["$","th",null,{"scope":"row","children":"Battle casualties"}],["$","td",null,{"children":["Nearly 23,000 killed, wounded, or missing",["$","small",null,{"style":{"display":"block"},"children":"Exact totals vary. Antietam National Battlefield uses an overall estimate of 22,720 and about 3,200 casualties in the final-attack sector."}]]}]]}],["$","tr","Confederate wounded left behind",{"children":[["$","th",null,{"scope":"row","children":"Confederate wounded left behind"}],["$","td",null,{"children":["About 2,000 in the episode",["$","small",null,{"style":{"display":"block"},"children":"Lee’s army evacuated those it could but left the most severely wounded in Maryland and near Shepherdstown, sometimes with Confederate surgeons who remained to care for them."}]]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2017/06/11/civil-war-podcast-episode-199/",{"href":"https://civilwarpodcast.org/2017/06/11/civil-war-podcast-episode-199/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 199 page"]}],["$","a","https://www.nps.gov/places/the-final-attack.htm",{"href":"https://www.nps.gov/places/the-final-attack.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Final Attack overview"]}],["$","a","https://www.nps.gov/anti/planyourvisit/final-attack-trail-stop-5.htm",{"href":"https://www.nps.gov/anti/planyourvisit/final-attack-trail-stop-5.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Final Attack Trail stop 5, Caught in the Corn"]}],["$","a","https://www.nps.gov/anti/planyourvisit/final-attack-trail-stop-7.htm",{"href":"https://www.nps.gov/anti/planyourvisit/final-attack-trail-stop-7.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Final Attack Trail stop 7"]}],["$","a","https://www.nps.gov/anti/learn/historyculture/the-otto-farm.htm",{"href":"https://www.nps.gov/anti/learn/historyculture/the-otto-farm.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Otto Farm"]}],["$","a","https://www.nps.gov/anti/learn/historyculture/casualties.htm",{"href":"https://www.nps.gov/anti/learn/historyculture/casualties.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: casualty estimates"]}],["$","a","https://www.nps.gov/anti/learn/historyculture/6generals.htm",{"href":"https://www.nps.gov/anti/learn/historyculture/6generals.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: six generals killed or mortally wounded"]}],["$","a","https://www.nps.gov/anti/learn/historyculture/timeline2.htm",{"href":"https://www.nps.gov/anti/learn/historyculture/timeline2.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Maryland Campaign timeline, part 2"]}],["$","a","https://www.nps.gov/articles/antietam-lead-up-to-and-after.htm",{"href":"https://www.nps.gov/articles/antietam-lead-up-to-and-after.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: lead-up and aftermath"]}],["$","a","https://www.nps.gov/articles/medicine-and-medical-practices.htm",{"href":"https://www.nps.gov/articles/medicine-and-medical-practices.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: medicine and medical practices"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a"]}]]}]
