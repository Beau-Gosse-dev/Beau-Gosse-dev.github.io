d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",199," · ","September 17–22, 1862"," · ","The southern and northern ends of the Antietam battlefield around Sharpsburg, Maryland; field hospitals across the Antietam Valley; and the roads through Middletown to Frederick, Maryland, and across the Potomac at Boteler’s Ford near Shepherdstown, Virginia"]}],["$","h1",null,{"children":"ANTIETAM (Part the Fourteenth)"}],["$","span",null,{"className":"result-label","children":"A. P. Hill’s Light Division struck the exposed left flank of the Ninth Corps late on September 17. The 8th and 16th Connecticut, 4th Rhode Island, and supporting Ohio regiments were driven back, Isaac Rodman was mortally wounded, and Lawrence O’Bryan Branch was killed. Jacob Cox withdrew the Ninth Corps to defensible ground above the Lower Bridge, which remained in Federal hands. On the Confederate left, concentrated Federal artillery stopped Jackson and Stuart from turning the Federal right. Fighting ended near sunset. Neither army renewed the battle on September 18; Lee withdrew across the Potomac that night. Nearly 23,000 soldiers were casualties, and the Union strategic victory gave Lincoln the opportunity to announce the Preliminary Emancipation Proclamation on September 22"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"September 17–22, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"The southern and northern ends of the Antietam battlefield around Sharpsburg, Maryland; field hospitals across the Antietam Valley; and the roads through Middletown to Frederick, Maryland, and across the Potomac at Boteler’s Ford near Shepherdstown, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"A. P. Hill’s Light Division struck the exposed left flank of the Ninth Corps late on September 17. The 8th and 16th Connecticut, 4th Rhode Island, and supporting Ohio regiments were driven back, Isaac Rodman was mortally wounded, and Lawrence O’Bryan Branch was killed. Jacob Cox withdrew the Ninth Corps to defensible ground above the Lower Bridge, which remained in Federal hands. On the Confederate left, concentrated Federal artillery stopped Jackson and Stuart from turning the Federal right. Fighting ended near sunset. Neither army renewed the battle on September 18; Lee withdrew across the Potomac that night. Nearly 23,000 soldiers were casualties, and the Union strategic victory gave Lincoln the opportunity to announce the Preliminary Emancipation Proclamation on September 22"}]]}]]}],false,"$Lf","$undefined"]}],"$L10","$L11","$L12",false,"$L13","$L14","$L15","$L16","$L17","$L18"]}]]}]
