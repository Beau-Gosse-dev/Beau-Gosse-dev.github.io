1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",199," · ","September 17–22, 1862"," · ","The southern and northern ends of the Antietam battlefield around Sharpsburg, Maryland; field hospitals across the Antietam Valley; and the roads through Middletown to Frederick, Maryland, and across the Potomac at Boteler’s Ford near Shepherdstown, Virginia"]}],["$","h1",null,{"children":"ANTIETAM (Part the Fourteenth)"}],["$","span",null,{"className":"result-label","children":"A. P. Hill’s Light Division struck the exposed left flank of the Ninth Corps late on September 17. The 8th and 16th Connecticut, 4th Rhode Island, and supporting Ohio regiments were driven back, Isaac Rodman was mortally wounded, and Lawrence O’Bryan Branch was killed. Jacob Cox withdrew the Ninth Corps to defensible ground above the Lower Bridge, which remained in Federal hands. On the Confederate left, concentrated Federal artillery stopped Jackson and Stuart from turning the Federal right. Fighting ended near sunset. Neither army renewed the battle on September 18; Lee withdrew across the Potomac that night. Nearly 23,000 soldiers were casualties, and the Union strategic victory gave Lincoln the opportunity to announce the Preliminary Emancipation Proclamation on September 22"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8314725404.mp3?updated=1695499621","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The final fighting on September 17 and the immediate aftermath through September 20"}],["$","small",null,{"children":"The episode begins with A. P. Hill’s counterattack, follows the close of combat and medical response, and ends with the Confederate withdrawal, limited Federal pursuit, and the battle’s strategic consequences."}]]}],["$","div","Hill’s forced march",{"children":[["$","span",null,{"children":"Hill’s forced march"}],["$","strong",null,{"children":"About 15–17 miles from Harpers Ferry"}],["$","small",null,{"children":"NPS interpretation describes roughly 3,500 men leaving Harpers Ferry at 7:00 a.m.; three brigades, about 2,500 men, reached the decisive sector in time to attack. The episode estimates about 2,000 initially available after straggling and trailing brigades reduced the first wave."}]]}],["$","div","Hill’s tactical advantage",{"children":[["$","span",null,{"children":"Hill’s tactical advantage"}],["$","strong",null,{"children":"Position, surprise, and veteran troops"}],["$","small",null,{"children":"The Light Division entered south of the Ninth Corps and struck its open left flank rather than attacking the Federal line frontally."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32"]}],"$L33","$undefined","$L34",false,"$L35","$L36","$L37","$L38","$L39"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Exposed Federal flank",{"children":[["$","span",null,{"children":"Exposed Federal flank"}],["$","strong",null,{"children":"Harland’s 8th and 16th Connecticut and 4th Rhode Island"}],["$","small",null,{"children":"These regiments formed the left of Rodman’s division and the entire Army of the Potomac. Difficult terrain and uneven movement separated the 8th Connecticut from the other two regiments."}]]}]
f:["$","div","16th Connecticut experience",{"children":[["$","span",null,{"children":"16th Connecticut experience"}],["$","strong",null,{"children":"Less than one month in Federal service"}],["$","small",null,{"children":"The regiment mustered on August 24, reached Washington on September 1, and joined the Army of the Potomac only days before fighting at Antietam."}]]}]
10:["$","div","Rodman mortally wounded",{"children":[["$","span",null,{"children":"Rodman mortally wounded"}],["$","strong",null,{"children":"Shot through the chest while reacting to Hill’s arrival"}],["$","small",null,{"children":"Brig. Gen. Isaac P. Rodman was carried from the field and died on September 30, 1862."}]]}]
11:["$","div","8th Connecticut advance",{"children":[["$","span",null,{"children":"8th Connecticut advance"}],["$","strong",null,{"children":"Several hundred yards ahead of the rest of Harland’s brigade"}],["$","small",null,{"children":"The regiment advanced with Fairchild’s brigade, captured a Confederate battery near the Harpers Ferry Road, and then lost about half its men when attacked in flank."}]]}]
12:["$","div","Otto’s 40-acre cornfield",{"children":[["$","span",null,{"children":"Otto’s 40-acre cornfield"}],["$","strong",null,{"children":"Head-high corn and broken ground concealed the attackers"}],["$","small",null,{"children":"The 16th Connecticut and 4th Rhode Island could not see Gregg’s South Carolinians approaching from the south and west. Smoke, crops, and some Confederate clothing taken at Harpers Ferry added to the identification problem."}]]}]
13:["$","div","Gregg’s attack",{"children":[["$","span",null,{"children":"Gregg’s attack"}],["$","strong",null,{"children":"Surprise fire from two directions"}],["$","small",null,{"children":"Maxcy Gregg’s veteran South Carolinians struck the inexperienced 16th Connecticut and the 4th Rhode Island in and around the cornfield."}]]}]
14:["$","div","Federal left collapses",{"children":[["$","span",null,{"children":"Federal left collapses"}],["$","strong",null,{"children":"About 4:30 p.m. in the episode"}],["$","small",null,{"children":"The 16th Connecticut routed, the 4th Rhode Island withdrew, and the retreat exposed the supporting Ohio regiments and troops farther north."}]]}]
15:["$","div","Cox orders a withdrawal",{"children":[["$","span",null,{"children":"Cox orders a withdrawal"}],["$","strong",null,{"children":"The Ninth Corps gives up its gains near Sharpsburg"}],["$","small",null,{"children":"Cox pulled back the troops near town because Hill’s attack had broken the corps left and threatened to separate or envelop the forward formations."}]]}]
16:["$","div","Three Confederate brigades engaged",{"children":[["$","span",null,{"children":"Three Confederate brigades engaged"}],["$","strong",null,{"children":"Gregg, Archer, and Branch"}],["$","small",null,{"children":"NPS interpretation places Gregg against the 16th Connecticut and 4th Rhode Island, Archer between Gregg and Branch, and Branch moving north against the 8th Connecticut and Fairchild."}]]}]
17:["$","div","Ohio support line",{"children":[["$","span",null,{"children":"Ohio support line"}],["$","strong",null,{"children":"Scammon’s Kanawha brigade changes front"}],["$","small",null,{"children":"The 12th, 23rd, and 30th Ohio confronted Hill’s attack. They helped prevent a complete collapse but could not restore the advance toward Sharpsburg."}]]}]
18:["$","div","Lawrence O’Bryan Branch killed",{"children":[["$","span",null,{"children":"Lawrence O’Bryan Branch killed"}],["$","strong",null,{"children":"Shot in the head while leading his North Carolina brigade"}],["$","small",null,{"children":"Branch died during the final Confederate counterattack and was one of six general officers killed or mortally wounded at Antietam."}]]}]
19:["$","div","Six general officers lost",{"children":[["$","span",null,{"children":"Six general officers lost"}],["$","strong",null,{"children":"Three United States and three Confederate"}],["$","small",null,{"children":"Joseph K. F. Mansfield, Israel B. Richardson, and Isaac P. Rodman were the Federal fatalities; William E. Starke, George B. Anderson, and Lawrence O’Bryan Branch were the Confederate fatalities."}]]}]
1a:["$","div","Confederate artillery at the final attack",{"children":[["$","span",null,{"children":"Confederate artillery at the final attack"}],["$","strong",null,{"children":"More than forty guns in the episode"}],["$","small",null,{"children":"Lee and his officers concentrated pieces from numerous batteries south of Sharpsburg. Their crossfire supported Hill and helped force Federal batteries west of the creek to withdraw."}]]}]
1b:["$","div","Ninth Corps final position",{"children":[["$","span",null,{"children":"Ninth Corps final position"}],["$","strong",null,{"children":"Curved ridge above the Lower Bridge"}],["$","small",null,{"children":"Cox’s line held the west-bank bridgehead. Sturgis and Fairchild were on the left, Scammon in the center, and Willcox on the right."}]]}]
1c:["$","div","Jackson’s northern counterattack plan",{"children":[["$","span",null,{"children":"Jackson’s northern counterattack plan"}],["$","strong",null,{"children":"Turn the Federal right between the army and the Potomac"}],["$","small",null,{"children":"Jackson assigned Stuart a small mixed force of cavalry, artillery, and infantry. The movement was abandoned when the strength of the Federal artillery and the extension of the Federal line made the route untenable."}]]}]
1d:["$","div","Federal artillery on the right",{"children":[["$","span",null,{"children":"Federal artillery on the right"}],["$","strong",null,{"children":"A concentrated line near the Joseph Poffenberger farm"}],["$","small",null,{"children":"Federal batteries under the I Corps sector suppressed the Confederate guns in about fifteen minutes in the episode’s account and stopped Stuart’s movement before it developed."}]]}]
1e:["$","div","Unused Federal reserve",{"children":[["$","span",null,{"children":"Unused Federal reserve"}],["$","strong",null,{"children":"Most of Fitz John Porter’s V Corps remained uncommitted"}],["$","small",null,{"children":"McClellan and Porter retained the infantry near headquarters because they regarded it as the army’s only reliable reserve while both flanks appeared threatened."}]]}]
1f:["$","div","McClellan’s order to Burnside",{"children":[["$","span",null,{"children":"McClellan’s order to Burnside"}],["$","strong",null,{"children":"Hold the ground and especially the bridge"}],["$","small",null,{"children":"A courier reported that the Ninth Corps needed men and guns. McClellan sent Miller’s battery but no infantry reinforcement."}]]}]
20:["$","div","Close of combat",{"children":[["$","span",null,{"children":"Close of combat"}],["$","strong",null,{"children":"Firing declined near sunset, about 5:30 p.m."}],["$","small",null,{"children":"The Ninth Corps retained the Lower Bridge and a west-bank foothold; Hill’s tired brigades did not attempt to drive the corps across Antietam Creek."}]]}]
21:["$","div","Battle casualties",{"children":[["$","span",null,{"children":"Battle casualties"}],["$","strong",null,{"children":"Nearly 23,000 killed, wounded, or missing"}],["$","small",null,{"children":"Exact totals vary. Antietam National Battlefield uses an overall estimate of 22,720 and about 3,200 casualties in the final-attack sector."}]]}]
22:["$","div","Deaths after the battle",{"children":[["$","span",null,{"children":"Deaths after the battle"}],["$","strong",null,{"children":"Many wounded soldiers died later"}],["$","small",null,{"children":"The episode estimates that 6,300–6,500 men were killed outright or died of wounds. This combines immediate deaths with later mortality and is distinct from the total casualty count."}]]}]
23:["$","div","Letterman ambulance system",{"children":[["$","span",null,{"children":"Letterman ambulance system"}],["$","strong",null,{"children":"Organized transport and trained personnel"}],["$","small",null,{"children":"The Army of the Potomac’s new ambulance corps assigned vehicles and trained crews to collect wounded men and move them through aid stations, field hospitals, and permanent hospitals."}]]}]
24:["$","div","Field hospitals",{"children":[["$","span",null,{"children":"Field hospitals"}],["$","strong",null,{"children":"At least 71 Federal hospitals in the episode"}],["$","small",null,{"children":"Houses, churches, barns, and sheds across the Antietam Valley held wounded soldiers. NPS educational material describes the Smith barn as one of about seventy-five field hospitals in the area."}]]}]
25:["$","div","Medical supply shortage",{"children":[["$","span",null,{"children":"Medical supply shortage"}],["$","strong",null,{"children":"Army supplies arrived several days after the battle"}],["$","small",null,{"children":"Rail damage, transportation priorities, and the speed of the campaign delayed official supplies. Surgeons relied on what they carried and what civilians and relief organizations supplied."}]]}]
26:["$","div","Clara Barton",{"children":[["$","span",null,{"children":"Clara Barton"}],["$","strong",null,{"children":"Brought bandages, food, and lanterns to the northern battlefield"}],["$","small",null,{"children":"Barton arrived near the Poffenberger farm around noon on September 17 and worked with wounded soldiers and surgeons through the battle."}]]}]
27:["$","div","U.S. Sanitary Commission",{"children":[["$","span",null,{"children":"U.S. Sanitary Commission"}],["$","strong",null,{"children":"Independent transportation brought relief supplies on September 18"}],["$","small",null,{"children":"The civilian commission’s wagons helped bridge the interval before the Army Medical Department’s larger supply shipments reached the hospitals."}]]}]
28:["$","div","Evacuation to Frederick",{"children":[["$","span",null,{"children":"Evacuation to Frederick"}],["$","strong",null,{"children":"About twenty miles through Middletown"}],["$","small",null,{"children":"Beginning September 20, ambulances and walking wounded moved east across South Mountain. By September 25, about 600 soldiers considered too badly wounded to travel remained in two battlefield tent hospitals."}]]}]
29:["$","div","Frederick hospital network",{"children":[["$","span",null,{"children":"Frederick hospital network"}],["$","strong",null,{"children":"The existing barracks plus six temporary hospitals"}],["$","small",null,{"children":"Churches, public buildings, and tents expanded capacity. More than half the patients were eventually transferred to Washington, Baltimore, or Philadelphia."}]]}]
2a:["$","div","Confederate wounded left behind",{"children":[["$","span",null,{"children":"Confederate wounded left behind"}],["$","strong",null,{"children":"About 2,000 in the episode"}],["$","small",null,{"children":"Lee’s army evacuated those it could but left the most severely wounded in Maryland and near Shepherdstown, sometimes with Confederate surgeons who remained to care for them."}]]}]
2b:["$","div","September 18",{"children":[["$","span",null,{"children":"September 18"}],["$","strong",null,{"children":"Neither army renewed the battle"}],["$","small",null,{"children":"Franklin proposed another attack on the Confederate left, but McClellan declined. Lee began withdrawing across the Potomac after dark."}]]}]
2c:["$","div","September 19–20",{"children":[["$","span",null,{"children":"September 19–20"}],["$","strong",null,{"children":"Limited pursuit followed by the Battle of Shepherdstown"}],["$","small",null,{"children":"V Corps troops crossed the Potomac on September 19. A larger crossing on September 20 was repulsed by A. P. Hill’s division."}]]}]
2d:["$","div","Strategic result",{"children":[["$","span",null,{"children":"Strategic result"}],["$","strong",null,{"children":"Lee’s Maryland invasion ended"}],["$","small",null,{"children":"The battlefield result was tactically inconclusive, but Lee’s withdrawal allowed the United States to claim a strategic victory."}]]}]
2e:["$","div","Emancipation consequence",{"children":[["$","span",null,{"children":"Emancipation consequence"}],["$","strong",null,{"children":"Preliminary Emancipation Proclamation announced September 22"}],["$","small",null,{"children":"Lincoln used the end of Lee’s invasion as the military result he had awaited before announcing the proclamation."}]]}]
2f:["$","div","Federal force utilization",{"children":[["$","span",null,{"children":"Federal force utilization"}],["$","strong",null,{"children":"About one-third of McClellan’s available army did not fire a shot in the episode’s estimate"}],["$","small",null,{"children":"The episode contrasts the heavy losses in I, II, XII, and IX Corps with the limited engagement of V and VI Corps formations."}]]}]
30:["$","div","Recommended books",{"children":[["$","span",null,{"children":"Recommended books"}],["$","strong",null,{"children":"Two Gary W. Gallagher essay collections"}],["$","small",null,{"children":"The episode recommends “Antietam: Essays on the 1862 Maryland Campaign” and “The Antietam Campaign.”"}]]}]
31:["$","div","Calixa Lavallée",{"children":[["$","span",null,{"children":"Calixa Lavallée"}],["$","strong",null,{"children":"4th Rhode Island musician and later composer of the music for “O Canada”"}],["$","small",null,{"children":"The bonus segment identifies the Quebec-born soldier as wounded during Hill’s counterattack. His surname is properly spelled Lavallée."}]]}]
32:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Harland, Maxcy Gregg, Kanawha, Poffenberger, Pleasonton, Pry House, and Calixa Lavallée"}],["$","small",null,{"children":"The automated transcript produces forms including “Harlan,” “Maxi Gregg,” “Canaw,” “Paffenberger,” “Pleasanton,” “pry house,” and “Kai Douglas.” This guide uses the historical forms; “Kai Douglas” is normalized to Henry Kyd Douglas."}]]}]
33:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
34:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","A. P. Hill strikes the Ninth Corps left",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep199-hill-counterattack.svg","target":"_blank","rel":"noreferrer","aria-label":"Open A. P. Hill strikes the Ninth Corps left at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep199-hill-counterattack.svg","alt":"Schematic map of A. P. Hill’s brigades attacking the exposed Ninth Corps left around Otto’s 40-acre cornfield and the Harpers Ferry Road.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"A. P. Hill strikes the Ninth Corps left"}],["$","span",null,{"children":"Harland’s 8th Connecticut had moved ahead toward the Harpers Ferry Road, leaving the 16th Connecticut and 4th Rhode Island in Otto’s 40-acre cornfield. Gregg attacked from the south, Archer moved between Gregg and Branch, and Branch drove north against the 8th Connecticut and Fairchild. Scammon’s Ohio regiments changed front as Cox withdrew the Ninth Corps toward the Lower Bridge. Sequential actions are combined, positions are generalized, and the map is not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep199-hill-counterattack.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield Final Attack Trail, Cox’s and Harland’s official reports, Antietam Battlefield Board atlas, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$34:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Close of battle and immediate aftermath",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep199-close-and-aftermath.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Close of battle and immediate aftermath at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep199-close-and-aftermath.svg","alt":"Context map showing the final positions at Antietam, the Confederate withdrawal through Shepherdstown, and the Federal medical evacuation route to Frederick.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Close of battle and immediate aftermath"}],["$","span",null,{"children":"The Ninth Corps held the Lower Bridge while Federal artillery near the Joseph Poffenberger farm stopped the proposed Confederate movement around the Federal right. On September 18 Lee remained near Sharpsburg, then withdrew through Shepherdstown after dark. Wounded soldiers moved from battlefield hospitals through Middletown to Frederick beginning September 20. This context map covers different times and is schematic, with routes and positions generalized."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep199-close-and-aftermath.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$34:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield timeline and medical interpretation, Jackson’s official report, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L3a"]}]]}],"$undefined"]}]]}],"$L3b"]}]]}]
35:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Retained V Corps as a reserve, sent artillery but no infantry to Burnside, declined Franklin’s September 18 proposal, and did not prevent Lee’s withdrawal"}]]}],["$","div","V Corps-Maj. Gen. Fitz John Porter",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"Kept most of his infantry near the center as the army reserve; elements crossed the Potomac during the September 19–20 pursuit"}]]}],["$","div","Ninth Corps and Army of the Potomac left wing-Maj. Gen. Ambrose E. Burnside",{"className":"command-entry","children":[["$","strong",null,{"children":"Ninth Corps and Army of the Potomac left wing"}],["$","span",null,{"children":"Maj. Gen. Ambrose E. Burnside"}],["$","small",null,{"children":"Requested reinforcements while the corps held its bridgehead west of Antietam Creek"}]]}],["$","div","Immediate command of the Ninth Corps-Brig. Gen. Jacob D. Cox",{"className":"command-entry","children":[["$","strong",null,{"children":"Immediate command of the Ninth Corps"}],["$","span",null,{"children":"Brig. Gen. Jacob D. Cox"}],["$","small",null,{"children":"Ordered the advance near Sharpsburg withdrawn and formed a defensive line above the Lower Bridge"}]]}],["$","div","3rd Division, Ninth Corps-Brig. Gen. Isaac P. Rodman",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division, Ninth Corps"}],["$","span",null,{"children":"Brig. Gen. Isaac P. Rodman"}],["$","small",null,{"children":"Tried to change front against Hill’s arrival and was mortally wounded while riding toward the threatened flank"}]]}],["$","div","2nd Brigade, Rodman’s division-Col. Edward Harland",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade, Rodman’s division"}],["$","span",null,{"children":"Col. Edward Harland"}],["$","small",null,{"children":"Commanded the 8th and 16th Connecticut and 4th Rhode Island; attempted to restore the separated brigade after his horse was shot"}]]}],["$","div","Kanawha Division-Col. Eliakim P. Scammon",{"className":"command-entry","children":[["$","strong",null,{"children":"Kanawha Division"}],["$","span",null,{"children":"Col. Eliakim P. Scammon"}],["$","small",null,{"children":"Used the 12th, 23rd, and 30th Ohio to change front and oppose Hill’s counterattack before withdrawing into Cox’s final line"}]]}],["$","div","I Corps after Hooker was wounded-Brig. Gen. George G. Meade",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps after Hooker was wounded"}],["$","span",null,{"children":"Brig. Gen. George G. Meade"}],["$","small",null,{"children":"Controlled the northern Federal sector where concentrated artillery made Jackson’s proposed flank movement impracticable"}]]}],"$L3c","$L3d"]]}],"$L3e"]}],"$L3f"]]]}]
36:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Maj. Gen. Joseph K. F. Mansfield",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. Joseph K. F. Mansfield"}],["$","p",null,{"children":[["$","strong",null,{"children":["XII Corps commander","."]}]," ","Mortally wounded in the chest near the East Woods during the morning fighting and died on September 18, 1862."]}]]}],["$","article","Maj. Gen. Israel B. Richardson",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. Israel B. Richardson"}],["$","p",null,{"children":[["$","strong",null,{"children":["1st Division, II Corps commander","."]}]," ","Mortally wounded by a shell fragment after the Sunken Road breakthrough and died on November 3, 1862."]}]]}],["$","article","Brig. Gen. Isaac P. Rodman",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brig. Gen. Isaac P. Rodman"}],["$","p",null,{"children":[["$","strong",null,{"children":["3rd Division, Ninth Corps commander","."]}]," ","Mortally wounded through the chest while changing front against Hill’s counterattack and died on September 30, 1862."]}]]}],["$","article","Brig. Gen. William E. Starke",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. William E. Starke"}],["$","p",null,{"children":[["$","strong",null,{"children":["Stonewall Division commander","."]}]," ","Wounded three times while leading a morning counterattack and died within the hour."]}]]}],["$","article","Brig. Gen. George B. Anderson",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. George B. Anderson"}],["$","p",null,{"children":[["$","strong",null,{"children":["North Carolina brigade commander in the Sunken Road","."]}]," ","Mortally wounded in the foot, underwent amputation after infection, and died on October 16, 1862."]}]]}],["$","article","Brig. Gen. Lawrence O’Bryan Branch",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Lawrence O’Bryan Branch"}],["$","p",null,{"children":[["$","strong",null,{"children":["North Carolina brigade commander, Light Division","."]}]," ","Shot in the head and killed while leading his brigade in A. P. Hill’s late-afternoon counterattack."]}]]}]]}]]}]
