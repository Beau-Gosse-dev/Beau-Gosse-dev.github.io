1a:["$","div",null,{"children":[["$","h3",null,{"children":"Peabody formed a final defensive line"}],["$","p",null,{"children":"He placed the remaining 25th Missouri and 12th Michigan with Woodyard’s men on a low ridge about half a mile from camp."}]]}]
1b:["$","div","The Confederate attack reached Peabody",{"className":"moment","children":[["$","$L19",null,{"seconds":1221,"label":"20:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate attack reached Peabody"}],["$","p",null,{"children":"At about 7:30, the United States line stopped the first assault but was soon threatened on both open flanks."}]]}]]}]
