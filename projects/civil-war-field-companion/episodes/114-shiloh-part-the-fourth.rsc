d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",114," · ","April 6, 1862, about 5–9 a.m."," · ","Fraley Field, the Corinth Road, Peabody’s ridge, Spain Field, and Prentiss’s camps at Shiloh"]}],["$","h1",null,{"children":"SHILOH (Part the Fourth)"}],["$","span",null,{"className":"result-label","children":"Peabody’s unauthorized patrol delayed the Confederate advance long enough to alert the forward camps. Hardee’s first line began moving at about 6:30 a.m. Wood and Shaver overran Peabody’s brigade, while Gladden and Chalmers broke Miller’s brigade at Spain Field. Prentiss’s division was routed before 9 a.m., but the resistance delayed and disorganized the attackers. Johnston incorrectly concluded that he had already turned Grant’s left and shifted reserves westward"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}