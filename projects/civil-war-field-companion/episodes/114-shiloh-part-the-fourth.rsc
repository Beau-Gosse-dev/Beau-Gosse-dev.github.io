1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",114," · ","April 6, 1862, about 5–9 a.m."," · ","Fraley Field, the Corinth Road, Peabody’s ridge, Spain Field, and Prentiss’s camps at Shiloh"]}],["$","h1",null,{"children":"SHILOH (Part the Fourth)"}],["$","span",null,{"className":"result-label","children":"Peabody’s unauthorized patrol delayed the Confederate advance long enough to alert the forward camps. Hardee’s first line began moving at about 6:30 a.m. Wood and Shaver overran Peabody’s brigade, while Gladden and Chalmers broke Miller’s brigade at Spain Field. Prentiss’s division was routed before 9 a.m., but the resistance delayed and disorganized the attackers. Johnston incorrectly concluded that he had already turned Grant’s left and shifted reserves westward"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6585947676.mp3?updated=1695140563","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","First contact",{"children":[["$","span",null,{"children":"First contact"}],["$","strong",null,{"children":"About 5 a.m. in Fraley Field"}],"$undefined"]}],["$","div","Initial forces",{"children":[["$","span",null,{"children":"Initial forces"}],["$","strong",null,{"children":"Powell about 400; Hardcastle about 280"}],"$undefined"]}],["$","div","Confederate general advance",{"children":[["$","span",null,{"children":"Confederate general advance"}],["$","strong",null,{"children":"About 6:30 a.m."}],"$undefined"]}],["$","div","Hardee’s first line",{"children":[["$","span",null,{"children":"Hardee’s first line"}],["$","strong",null,{"children":"More than 9,000 men in 22 regiments and two battalions"}],"$undefined"]}],["$","div","Peabody’s final line",{"children":[["$","span",null,{"children":"Peabody’s final line"}],["$","strong",null,{"children":"About 400 yards long on a low ridge"}],"$undefined"]}],["$","div","Prentiss’s division",{"children":[["$","span",null,{"children":"Prentiss’s division"}],["$","strong",null,{"children":"Two brigades; routed before 9 a.m."}],"$undefined"]}],["$","div","United States warning",{"children":[["$","span",null,{"children":"United States warning"}],["$","strong",null,{"children":"The patrol found the army roughly a mile before it reached the camps"}],"$undefined"]}],["$","div","Command error",{"children":[["$","span",null,{"children":"Command error"}],["$","strong",null,{"children":"Johnston mistook the defeat of Prentiss for a successful turn of Grant’s entire left"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"