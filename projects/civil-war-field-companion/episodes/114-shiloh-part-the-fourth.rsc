":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Hardee’s first line",{"children":[["$","th",null,{"scope":"row","children":"Hardee’s first line"}],["$","td",null,{"children":["More than 9,000 men in 22 regiments and two battalions","$undefined"]}]]}]]}]]}],"$Lf"]}],"$undefined"]}],"$L10","$L11","$L12",false,"$L13","$L14","$L15","$L16","$L17","$L18"]}]]}]
