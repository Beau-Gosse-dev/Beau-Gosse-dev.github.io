f:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.libsyn.com/114-shiloh-part-the-fourth",{"href":"https://civilwarpodcast.libsyn.com/114-shiloh-part-the-fourth","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 114"]}],["$","a","https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm",{"href":"https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of Shiloh"]}],["$","a","https://www.nps.gov/shil/learn/historyculture/monument-detail.htm?id=I",{"href":"https://www.nps.gov/shil/learn/historyculture/monument-detail.htm?id=I","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Prentiss’s 6th Division"]}],["$","a","https://www.nps.gov/shil/learn/historyculture/monument-detail.htm?id=O",{"href":"https://www.nps.gov/shil/learn/historyculture/monument-detail.htm?id=O","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Hardee’s 3rd Corps"]}],["$","a","https://www.loc.gov/item/85690890/",{"href":"https://www.loc.gov/item/85690890/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Shiloh battlefield map"]}],["$","a","https://www.loc.gov/pictures/item/2017646904/",{"href":"https://www.loc.gov/pictures/item/2017646904/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Shiloh battlefield photograph"]}]]}]
