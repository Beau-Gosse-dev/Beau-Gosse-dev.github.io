13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The battle continued in Fraley Field",{"className":"moment","children":[["$","$L19",null,{"seconds":418,"label":"6:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battle continued in Fraley Field"}],["$","p",null,{"children":"Powell’s 400 men and Hardcastle’s 280 Mississippians exchanged volleys in the darkness and first light."}]]}]]}],["$","div","Johnston heard the opening fire",{"className":"moment","children":[["$","$L19",null,{"seconds":510,"label":"8:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston heard the opening fire"}],["$","p",null,{"children":"At about 5:30, he ended Beauregard’s renewed argument for withdrawal and ordered the attack to begin."}]]}]]}],["$","div","Johnston divided command",{"className":"moment","children":[["$","$L19",null,{"seconds":575,"label":"9:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston divided command"}],["$","p",null,{"children":"He went forward to direct the firing line and left Beauregard in the rear to move reinforcements toward the fighting."}]]}]]}],["$","div","Hardee’s advance was delayed another hour",{"className":"moment","children":[["$","$L19",null,{"seconds":728,"label":"12:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hardee’s advance was delayed another hour"}],["$","p",null,{"children":"The start time had not been specified clearly, and orders moved slowly through an inexperienced command structure."}]]}]]}],["$","div","Powell began withdrawing",{"className":"moment","children":[["$","$L19",null,{"seconds":837,"label":"13:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Powell began withdrawing"}],["$","p",null,{"children":"After seeing Confederate cavalry moving toward his flank, Powell pulled back from Fraley Field."}]]}]]}],["$","div","Peabody sounded the long roll",{"className":"moment","children":[["$","$L19",null,{"seconds":865,"label":"14:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Peabody sounded the long roll"}],["$","p",null,{"children":"He alerted his brigade and sent five companies of the 21st Missouri under David Moore to reinforce Powell."}]]}]]}],["$","div","Prentiss blamed Peabody for starting the engagement",{"className":"moment","children":[["$","$L19",null,{"seconds":879,"label":"14:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Prentiss blamed Peabody for starting the engagement"}],["$","p",null,{"children":"Prentiss had not authorized the patrol and initially treated the fighting as an unwanted action rather than warning of a general attack."}]]}]]}],["$","div","Moore advanced toward the Confederates",{"className":"moment","children":[["$","$L19",null,{"seconds":988,"label":"16:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Moore advanced toward the Confederates"}],["$","p",null,{"children":"He combined his companies with Powell’s patrol, crossed toward the Corinth Road, and met the advancing Confederate line."}]]}]]}],["$","div","Moore was wounded",{"className":"moment","children":[["$","$L19",null,{"seconds":1037,"label":"17:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Moore was wounded"}],["$","p",null,{"children":"After about half an hour of volleys, Moore was shot in the leg. Powell resumed command and withdrew the original patrol."}]]}]]}],["$","div","Hardee’s line moved at about 6:30",{"className":"moment","children":[["$","$L19",null,{"seconds":1084,"label":"18:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hardee’s line moved at about 6:30"}],["$","p",null,{"children":"Extended regimental lines broke alignment in woods, thickets, ravines, and swampy ground."}]]}]]}],["$","div","Woodyard’s force fell back",{"className":"moment","children":[["$","$L19",null,{"seconds":1165,"label":"19:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Woodyard’s force fell back"}],["$","p",null,{"children":"After about an hour against Wood’s and Shaver’s brigades, the outnumbered United States troops withdrew toward camp."}]]}]]}],["$","div","Peabody formed a final defensive line",{"className":"moment","children":[["$","$L19",null,{"seconds":1206,"label":"20:06"}],"$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}]
