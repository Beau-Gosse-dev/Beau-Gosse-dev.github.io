1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",156," · ","July 27, 1861–June 1, 1862"," · ","Washington, D.C.; northern Virginia; Hampton Roads; and the Virginia Peninsula from Fort Monroe through Yorktown and Williamsburg to the Chickahominy River and the eastern approaches to Richmond"]}],["$","h1",null,{"children":"BACK TO THE PENINSULA..."}],["$","span",null,{"className":"result-label","children":"Campaign recap through the indecisive Battle of Seven Pines, also called Fair Oaks. The Army of the Potomac had advanced to Richmond’s outskirts but had not captured the Confederate capital. Joseph E. Johnston’s May 31 attack failed to destroy the two Federal corps south of the flooded Chickahominy, and Johnston was seriously wounded. Jefferson Davis placed Robert E. Lee in command of the Confederate field army on June 1. The Seven Days Battles are outside this episode’s scope"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8248882287.mp3?updated=1695325937","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"McClellan’s rise, campaign planning, and Peninsula advance through Seven Pines and Lee’s appointment"}],["$","small",null,{"children":"This is a chronological review before the podcast begins the Seven Days Battles. It covers several operations rather than one battlefield action."}]]}],["$","div","Starting point",{"children":[["$","span",null,{"children":"Starting point"}],["$","strong",null,{"children":"McClellan took command of the forces around Washington on July 27, 1861"}],["$","small",null,{"children":"He rebuilt the defeated force into the Army of the Potomac and became general-in-chief after Winfield Scott retired in November 1861."}]]}],["$","div","Lincoln’s pressure for movement",{"children":[["$","span",null,{"children":"Lincoln’s pressure for movement"}],["$","strong",null,{"children":"General War Order No. 1, issued January 27, 1862, called for a general movement on February 22"}],["$","small",null,{"children":"Lincoln’s January 31 Special War Order No. 1 separately directed the Army of the Potomac toward the Manassas area. McClellan answered with an alternative amphibious plan."}]]}],["$","div","Original campaign design",{"children":[["$","span",null,{"children":"Original campaign design"}],["$","strong",null,{"children":"Move by water to Urbanna, turn Johnston’s right, and approach Richmond before the Confederate army could respond"}],["$","small",null,{"children":"The plan depended on water transport, rapid movement, and leaving enough troops to secure Washington."}]]}],["$","div","Why Urbanna was abandoned",{"children":[["$","span",null,{"children":"Why Urbanna was abandoned"}],["$","strong",null,{"children":"Johnston evacuated the Manassas–Centreville position on March 9 and withdrew toward the Rappahannock"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}],"$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c"]}]]}]
2e:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"The retreat removed the fixed Confederate position that the Urbanna landing was meant to turn. The episode places the movement one day early; the guide uses the date in official campaign chronologies. McClellan shifted the landing point to Fort Monroe."}]
f:["$","div","Change in Federal command",{"children":[["$","span",null,{"children":"Change in Federal command"}],["$","strong",null,{"children":"Lincoln removed McClellan as general-in-chief on March 11 while leaving him in command of the Army of the Potomac"}],["$","small",null,{"children":"The president and Secretary of War Edwin M. Stanton temporarily handled the broader coordination of the armies."}]]}]
10:["$","div","Hampton Roads constraint",{"children":[["$","span",null,{"children":"Hampton Roads constraint"}],["$","strong",null,{"children":"CSS Virginia remained a threat after its March 9 duel with USS Monitor and complicated use of the James River"}],["$","small",null,{"children":"The episode treats the ironclad’s presence as a reason McClellan committed his advance to the York River line. Virginia was scuttled on May 11, after the campaign’s supply arrangements had already developed on the York and Pamunkey rivers."}]]}]
11:["$","div","Hampton Roads date correction",{"children":[["$","span",null,{"children":"Hampton Roads date correction"}],["$","strong",null,{"children":"CSS Virginia attacked the Federal wooden warships on March 8; USS Monitor fought Virginia on March 9"}],["$","small",null,{"children":"The audio says March 7 and “the very next day.” National Park Service and Naval History and Heritage Command records establish March 8–9."}]]}]
12:["$","div","Peninsula movement begins",{"children":[["$","span",null,{"children":"Peninsula movement begins"}],["$","strong",null,{"children":"The first Army of the Potomac troops sailed from Alexandria on March 17"}],["$","small",null,{"children":"An armada carried more than 100,000 soldiers to the Fort Monroe area over the following weeks. The number available at any one stage varied as formations arrived and other forces were retained outside the peninsula."}]]}]
13:["$","div","Washington-security dispute",{"children":[["$","span",null,{"children":"Washington-security dispute"}],["$","strong",null,{"children":"Lincoln withheld Irvin McDowell’s I Corps after concluding that McClellan had not left the promised covering force"}],["$","small",null,{"children":"The episode emphasizes the mistrust created by McClellan’s April 1 strength report. Exact counts depend on which garrisons and field formations are included."}]]}]
14:["$","div","Yorktown obstacle",{"children":[["$","span",null,{"children":"Yorktown obstacle"}],["$","strong",null,{"children":"Magruder’s line used Yorktown, earthworks, the Warwick River, dams, and flooded ground to block the peninsula"}],["$","small",null,{"children":"The National Park Service places Magruder’s initial force at roughly 11,000. Demonstrations and the defensive terrain helped convince McClellan that a deliberate siege was necessary."}]]}]
15:["$","div","Federal numerical advantage",{"children":[["$","span",null,{"children":"Federal numerical advantage"}],["$","strong",null,{"children":"McClellan had a large superiority when he reached the Warwick line but believed the defense was much stronger than it was"}],["$","small",null,{"children":"Strength estimates changed as Johnston reinforced Magruder. The episode’s “five to one” statement applies to the initial confrontation, not the entire month-long siege."}]]}]
16:["$","div","Siege of Yorktown",{"children":[["$","span",null,{"children":"Siege of Yorktown"}],["$","strong",null,{"children":"McClellan halted on April 5 and prepared heavy batteries instead of forcing an immediate passage"}],["$","small",null,{"children":"This delay allowed Johnston to transfer most of his field army to the peninsula. McClellan planned to open a major bombardment on May 5."}]]}]
17:["$","div","Confederate strategy dispute",{"children":[["$","span",null,{"children":"Confederate strategy dispute"}],["$","strong",null,{"children":"Johnston wanted to fall back toward Richmond; Davis ordered the Yorktown–Warwick line held"}],["$","small",null,{"children":"At a long April 14 conference, Davis, Lee, Secretary of War George W. Randolph, Johnston, Gustavus W. Smith, and James Longstreet debated the position. Johnston complied but continued preparing to retreat."}]]}]
18:["$","div","Yorktown evacuation",{"children":[["$","span",null,{"children":"Yorktown evacuation"}],["$","strong",null,{"children":"Johnston withdrew during the night of May 3–4 before McClellan’s bombardment began"}],["$","small",null,{"children":"Confederate artillery fire helped cover the retreat. Federal troops occupied the abandoned works on May 4."}]]}]
19:["$","div","Battle of Williamsburg",{"children":[["$","span",null,{"children":"Battle of Williamsburg"}],["$","strong",null,{"children":"A Confederate rear guard delayed the Federal pursuit on May 5, after which Johnston continued toward Richmond"}],["$","small",null,{"children":"National Park Service figures give approximately 2,300 United States and 1,600 Confederate casualties. The engagement did not stop the Confederate withdrawal."}]]}]
1a:["$","div","James River remains closed",{"children":[["$","span",null,{"children":"James River remains closed"}],["$","strong",null,{"children":"Federal gunboats were repulsed at Drewry’s Bluff on May 15"}],["$","small",null,{"children":"Norfolk had fallen and CSS Virginia had been scuttled, but the Confederate batteries and obstructions at Drewry’s Bluff prevented a naval advance to Richmond."}]]}]
1b:["$","div","Federal supply line",{"children":[["$","span",null,{"children":"Federal supply line"}],["$","strong",null,{"children":"White House Landing on the Pamunkey and the Richmond & York River Railroad supported the advance"}],["$","small",null,{"children":"Protecting this supply system influenced McClellan’s decision to keep a large part of his army north of the Chickahominy."}]]}]
1c:["$","div","McDowell does not join",{"children":[["$","span",null,{"children":"McDowell does not join"}],["$","strong",null,{"children":"Lincoln suspended McDowell’s march from Fredericksburg after Jackson’s victories in the Shenandoah Valley"}],["$","small",null,{"children":"By May 24 elements of McClellan’s army were about five miles from Richmond, but the expected reinforcement from the north was redirected toward the Valley crisis."}]]}]
1d:["$","div","Army divided by the Chickahominy",{"children":[["$","span",null,{"children":"Army divided by the Chickahominy"}],["$","strong",null,{"children":"Keyes’s IV Corps and Heintzelman’s III Corps stood south of the river while three corps were north of it before the battle"}],["$","small",null,{"children":"Heavy rain flooded the low ground and threatened the bridges. Johnston saw an opportunity to strike the two exposed corps before support crossed."}]]}]
1e:["$","div","Seven Pines attack",{"children":[["$","span",null,{"children":"Seven Pines attack"}],["$","strong",null,{"children":"Johnston ordered an attack for May 31, with D. H. Hill’s division bearing the main early fighting"}],["$","small",null,{"children":"The episode reconstructs a coordinated attack involving Longstreet on the left and Benjamin Huger on the right. Johnston issued incomplete oral and written instructions, and surviving accounts disagree over intended routes and responsibility for the resulting confusion."}]]}]
1f:["$","div","Federal reinforcement",{"children":[["$","span",null,{"children":"Federal reinforcement"}],["$","strong",null,{"children":"Edwin V. Sumner sent II Corps troops across the swollen Chickahominy to stabilize the Federal position"}],["$","small",null,{"children":"The crossing kept the Confederate attack from isolating and destroying the corps south of the river."}]]}]
20:["$","div","Battle result",{"children":[["$","span",null,{"children":"Battle result"}],["$","strong",null,{"children":"Indecisive after fighting on May 31 and June 1"}],["$","small",null,{"children":"Confederate attacks drove back parts of IV Corps but did not break the Federal army. National Park Service battle data estimates about 5,000 United States and 6,100 Confederate casualties; the episode gives roughly 5,000 Confederate casualties. Totals vary by compilation."}]]}]
21:["$","div","Command consequence",{"children":[["$","span",null,{"children":"Command consequence"}],["$","strong",null,{"children":"Johnston’s serious wounds removed him from command; Davis appointed Lee on June 1"}],["$","small",null,{"children":"Gustavus W. Smith briefly held command but was not retained. Lee inherited the army defending Richmond and immediately began preparing for the operations later known as the Seven Days Battles."}]]}]
22:["$","div","Important leader loss",{"children":[["$","span",null,{"children":"Important leader loss"}],["$","strong",null,{"children":"Brig. Gen. Robert H. Hatton was killed at Fair Oaks on May 31"}],["$","small",null,{"children":"Hatton commanded a Tennessee brigade in Gustavus W. Smith’s wing. Johnston was seriously wounded but survived; no army commander was killed or mortally wounded in the episode’s covered operations."}]]}]
23:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Valley Campaign, McDowell, Johnston, Magruder, Huger, Drewry’s Bluff, Chickahominy, Heintzelman, and Allan Pinkerton"}],["$","small",null,{"children":"The automated transcript renders several of these as “ballet campaign,” “MacDowell,” “Johnson,” “UJ,” “Drury,” “Chickahomony,” and other variants. The guide uses standard historical spellings."}]]}]
24:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“The Library of Congress Civil War Desk Reference,” edited by Margaret E. Wagner, Gary W. Gallagher, and Paul Finkelman"}],"$undefined"]}]
25:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
26:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","From Fort Monroe to Richmond’s outskirts",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep156-peninsula-campaign-overview.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From Fort Monroe to Richmond’s outskirts at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep156-peninsula-campaign-overview.svg","alt":"Schematic operational map of the Peninsula Campaign from Fort Monroe through Yorktown and Williamsburg to Richmond and the Chickahominy.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From Fort Monroe to Richmond’s outskirts"}],["$","span",null,{"children":"The Army of the Potomac moved by water from Alexandria to Fort Monroe, advanced against the Yorktown–Warwick line, and followed Johnston’s retreat through Williamsburg toward the Chickahominy. White House Landing and the railroad became the main supply system. Coastlines, rivers, roads, routes, and positions are simplified. This operational map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep156-peninsula-campaign-overview.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History, National Park Service, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The divided army and the May 31 attack",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep156-seven-pines-movements.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The divided army and the May 31 attack at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep156-seven-pines-movements.svg","alt":"Schematic troop-movement map showing the Federal army divided by the Chickahominy, Confederate attacks toward Seven Pines and Fair Oaks, and Sumner crossing to reinforce.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The divided army and the May 31 attack"}],["$","span",null,{"children":"Before Seven Pines, two Federal corps stood south of the flooded Chickahominy while three corps were north of it. D. H. Hill’s attack developed along the Williamsburg Road, other Confederate movements were delayed or confused, and Sumner crossed to reinforce the Federal position. The diagram follows the episode’s reconstruction; surviving orders and later accounts leave parts of Johnston’s intended deployment disputed. Roads, crossings, corps areas, and arrows are approximate. This phase map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep156-seven-pines-movements.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, Library of Congress map descriptions, U.S. Army Center of Military History, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2d"]}]]}],"$undefined"]}]]}]]}]]}]
27:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode returns to the Peninsula Campaign",{"className":"moment","children":[["$","$L2e",null,{"seconds":68,"label":"1:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode returns to the Peninsula Campaign"}],["$","p",null,{"children":"The hosts define the episode as a review through Fair Oaks before beginning the Seven Days Battles."}]]}]]}],["$","div","McClellan arrives after First Manassas",{"className":"moment","children":[["$","$L2e",null,{"seconds":86,"label":"1:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan arrives after First Manassas"}],["$","p",null,{"children":"McClellan takes over the defeated force around Washington in late July 1861 and begins organizing the Army of the Potomac."}]]}]]}],["$","div","McClellan becomes general-in-chief",{"className":"moment","children":[["$","$L2e",null,{"seconds":167,"label":"2:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan becomes general-in-chief"}],["$","p",null,{"children":"After Winfield Scott retires, Lincoln gives McClellan responsibility for the armies as well as the Army of the Potomac."}]]}]]}],["$","div","Lincoln orders a general movement",{"className":"moment","children":[["$","$L2e",null,{"seconds":536,"label":"8:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln orders a general movement"}],["$","p",null,{"children":"General War Order No. 1 sets February 22 as the date for coordinated Federal movement; a later special order addresses the Army of the Potomac directly."}]]}]]}],["$","div","McClellan submits his own plan",{"className":"moment","children":[["$","$L2e",null,{"seconds":574,"label":"9:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan submits his own plan"}],["$","p",null,{"children":"He argues against a direct assault at Manassas and proposes an amphibious movement against Richmond."}]]}]]}],["$","div","Urbanna is the original landing point",{"className":"moment","children":[["$","$L2e",null,{"seconds":614,"label":"10:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Urbanna is the original landing point"}],["$","p",null,{"children":"McClellan intends to land on the Rappahannock, turn Johnston’s position, and move rapidly toward Richmond."}]]}]]}],["$","div","Lincoln conditionally approves",{"className":"moment","children":[["$","$L2e",null,{"seconds":653,"label":"10:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln conditionally approves"}],["$","p",null,{"children":"On March 8 the president accepts the waterborne plan if enough troops remain to protect Washington."}]]}]]}],["$","div","Johnston leaves the Manassas line",{"className":"moment","children":[["$","$L2e",null,{"seconds":671,"label":"11:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston leaves the Manassas line"}],["$","p",null,{"children":"The Confederate withdrawal toward the Rappahannock removes the position that McClellan’s Urbanna plan was designed to turn."}]]}]]}],["$","div","McClellan loses the general-in-chief post",{"className":"moment","children":[["$","$L2e",null,{"seconds":727,"label":"12:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan loses the general-in-chief post"}],["$","p",null,{"children":"Lincoln relieves him of army-wide responsibility while leaving him in field command of the Army of the Potomac."}]]}]]}],["$","div","The landing shifts to Fort Monroe",{"className":"moment","children":[["$","$L2e",null,{"seconds":766,"label":"12:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"The landing shifts to Fort Monroe"}],["$","p",null,{"children":"The revised plan uses the peninsula between the York and James rivers as the approach to Richmond."}]]}]]}],["$","div","CSS Virginia affects the river choice",{"className":"moment","children":[["$","$L2e",null,{"seconds":789,"label":"13:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"CSS Virginia affects the river choice"}],["$","p",null,{"children":"The Confederate ironclad’s presence at Hampton Roads complicates reliance on the James River even after the March 9 duel with USS Monitor."}]]}]]}],"$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40"]}]]}]
28:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Approved the amphibious strategy with a Washington-security condition; removed McClellan as general-in-chief, withheld McDowell’s I Corps, and later redirected McDowell toward the Valley crisis"}]]}],["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Designed and conducted the Peninsula Campaign; exercised direct field command after March 11"}]]}],["$","div","II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps"}],["$","span",null,{"children":"Maj. Gen. Edwin V. Sumner"}],["$","small",null,{"children":"Initially north of the Chickahominy; sent Sedgwick’s division across during the May 31 crisis, followed by Richardson’s division"}]]}],["$","div","III Corps south of the Chickahominy",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps south of the Chickahominy"}],["$","span",null,{"children":"Maj. Gen. Samuel P. Heintzelman"}],["$","small",null,{"children":"Joseph Hooker and Philip Kearny divisions; reinforced the threatened Federal position at Seven Pines"}]]}],["$","div","IV Corps south of the Chickahominy",{"className":"command-entry","children":[["$","strong",null,{"children":"IV Corps south of the Chickahominy"}],["$","span",null,{"children":"Brig. Gen. Erasmus D. Keyes"}],["$","small",null,{"children":"Silas Casey and Darius Couch divisions held the most exposed Federal positions on the Williamsburg Road and around Seven Pines"}]]}],["$","div","V Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps"}],["$","span",null,{"children":"Brig. Gen. Fitz John Porter"}],["$","small",null,{"children":"Remained north of the Chickahominy protecting the line toward White House Landing before and during the opening of the battle"}]]}],["$","div","VI Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"VI Corps"}],["$","span",null,{"children":"Brig. Gen. William B. Franklin"}],["$","small",null,{"children":"Remained north of the Chickahominy as Johnston concentrated against the two corps south of the river"}]]}],["$","div","I Corps and Department of the Rappahannock",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps and Department of the Rappahannock"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"His corps was retained near Washington; a later movement from Fredericksburg toward McClellan was suspended during Jackson’s Valley Campaign"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief"}],["$","span",null,{"children":"President Jefferson Davis"}],["$","small",null,{"children":"Directed that the Yorktown line be held in April and appointed Robert E. Lee to field command on June 1 after Johnston was wounded"}]]}],["$","div","Confederate field army defending Richmond",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate field army defending Richmond"}],["$","span",null,{"children":"Gen. Joseph E. Johnston"}],["$","small",null,{"children":"Reinforced Magruder, withdrew from Yorktown toward Richmond, and ordered the May 31 attack at Seven Pines; seriously wounded late that day"}]]}],"$L41","$L42","$L43","$L44","$L45","$L46"]]}]]}],"$L47","$L48"]}]
29:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. Robert H. Hatton",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Robert H. Hatton"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of a Tennessee brigade in Gustavus W. Smith’s wing","."]}]," ","Killed at Fair Oaks on May 31, 1862. The National Park Service identifies Hatton as the Confederate general officer killed in the battle."]}]]}],["$","article","Gen. Joseph E. Johnston",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Gen. Joseph E. Johnston"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the Confederate army defending Richmond","."]}]," ","Seriously wounded late on May 31 by a rifle bullet and shell fragment. He survived, but the wounds removed him from command for several months and led directly to Lee’s appointment."]}]]}]]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep156-peninsula-campaign-overview.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep156-peninsula-campaign-overview.svg","alt":"Schematic overview map of the Peninsula Campaign through June 1, 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The broad movement ran from Fort Monroe through the Yorktown bottleneck and Williamsburg to Richmond’s eastern approaches. The map is schematic, not to scale, and does not claim exact daily routes."}]]}],["$","figure","/images/ep156-seven-pines-movements.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep156-seven-pines-movements.svg","alt":"Schematic map of the May 31 troop movements at Seven Pines and Fair Oaks.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The Chickahominy divided McClellan’s army. Confederate route confusion prevented the planned concentration, and Sumner crossed to reinforce. The diagram is schematic and reflects uncertainty in the surviving accounts."}]]}],["$","figure","/images/ep156-george-mcclellan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep156-george-mcclellan.jpg","alt":"Civil War-era photographic portrait of United States general George B. McClellan in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"McClellan built the Army of the Potomac and devised the amphibious approach to Richmond. His caution at Yorktown traded time for preparation and allowed Johnston to concentrate."}]]}],["$","figure","/images/ep156-magruder-headquarters-yorktown.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep156-magruder-headquarters-yorktown.jpg","alt":"June 1862 photograph of John B. Magruder’s former headquarters at Yorktown, Virginia.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"George N. Barnard photographed Magruder’s Yorktown headquarters after the Confederate evacuation. The Library of Congress dates the negative to June 1862 and identifies it as part of the Peninsula Campaign record."}]]}],["$","figure","/images/ep156-fair-oaks-before-battle.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep156-fair-oaks-before-battle.jpg","alt":"Alfred Waud drawing of the Fair Oaks area made shortly before the Confederate attack.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Waud drew this view a day or two before the May 31 attack. It is a contemporary landscape record, not a troop-position map."}]]}],["$","figure","/images/ep156-sumner-crossing-chickahominy.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep156-sumner-crossing-chickahominy.jpg","alt":"Alfred Waud drawing of Sumner’s troops crossing the Chickahominy toward Fair Oaks.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Waud’s May 31 drawing records II Corps crossing the Chickahominy toward Fair Oaks. The movement helped stabilize the Federal position south of the river."}]]}],["$","figure","/images/ep156-joseph-johnston.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep156-joseph-johnston.jpg","alt":"Civil War-era photographic portrait of Confederate general Joseph E. Johnston.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Johnston withdrew from Yorktown and attacked at Seven Pines. His serious wounds on May 31 ended his command of the campaign."}]]}],"$L49"]}]]}]
