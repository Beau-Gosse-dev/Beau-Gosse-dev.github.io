arch-battles-detail.htm?battleCode=MD001","target":"_blank","rel":"noreferrer","children":["National Park Service: Hancock battle summary"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm","target":"_blank","rel":"noreferrer","children":["National Park Service: Jackson’s 1862 campaign in the Shenandoah Valley"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://npshistory.com/publications/hafe/civil-war.pdf",{"children":["$","a",null,{"href":"https://npshistory.com/publications/hafe/civil-war.pdf","target":"_blank","rel":"noreferrer","children":["National Park Service historical handbook: Civil War in the Lower Shenandoah Valley"," ","$L44"]}]}],"$L45","$L46","$L47"]}]]}]
24:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
26:["$","h3",null,{"children":"The dam detail works under fire"}]
27:["$","p",null,{"children":"Federal artillery from Maryland forced the Confederates to conceal themselves by day. Work parties entered the cold water at night and eventually opened a breach after a militia diversion drew attention upstream."}]
28:["$","div","The canal damage proves temporary",{"className":"moment","children":[["$","$L25",null,{"seconds":1151,"label":"19:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The canal damage proves temporary"}],["$","p",null,{"children":"The episode reports that Federal workers repaired the breach within two days, limiting the practical result of the December operation."}]]}]]}]
29:["$","div","Loring finally concentrates at Winchester",{"className":"moment","children":[["$","$L25",null,{"seconds":1257,"label":"20:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Loring finally concentrates at Winchester"}],["$","p",null,{"children":"By December 26 all three of Loring’s brigades had arrived. The episode counts 7,500 regular troops, 2,200 militia, and 650 cavalry in Jackson’s enlarged command."}]]}]]}]
2a:["$","div","The expedition leaves Winchester",{"className":"moment","children":[["$","$L25",null,{"seconds":1301,"label":"21:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The expedition leaves Winchester"}],["$","p",null,{"children":"At 6 a.m. on January 1, 1862, Jackson’s column began moving toward an undisclosed destination. White hatbands were prescribed as a battlefield recognition measure."}]]}]]}]
2b:["$","div","Mild weather turns severe",{"className":"moment","children":[["$","$L25",null,{"seconds":1330,"label":"22:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mild weather turns severe"}],["$","p",null,{"children":"A cold front brought wind, snow, and sleet after troops had shed winter equipment. Wagons fell behind, leaving many men without overcoats, blankets, or timely rations."}]]}]]}]
2c:["$","div","The column halts at Unger’s Store",{"className":"moment","children":[["$","$L25",null,{"seconds":1424,"label":"23:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The column halts at Unger’s Store"}],["$","p",null,{"children":"The army covered only about eight miles on each of its first two days. Ice, a bogged column, delayed wagons, hunger, and exposure damaged its readiness before contact with the enemy."}]]}]]}]
2d:["$","div","Jackson turns toward Bath",{"className":"moment","children":[["$","$L25",null,{"seconds":1442,"label":"24:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson turns toward Bath"}],["$","p",null,{"children":"Instead of taking the westward road through Bloomery Gap toward Romney, Jackson continued north to remove the Bath garrison from the flank of his planned advance."}]]}]]}]
2e:["$","div","Loring protests the march",{"className":"moment","children":[["$","$L25",null,{"seconds":1517,"label":"25:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Loring protests the march"}],["$","p",null,{"children":"Loring objected to orders that kept his hungry troops moving in extreme conditions. The dispute exposed a widening break between Jackson and his principal subordinate."}]]}]]}]
2f:["$","div","Jackson confronts Garnett",{"className":"moment","children":[["$","$L25",null,{"seconds":1541,"label":"25:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson confronts Garnett"}],["$","p",null,{"children":"Richard B. Garnett halted the Stonewall Brigade so men who had gone as long as thirty hours without food could cook. Jackson ordered the movement continued and treated the halt as evidence that Garnett indulged his men."}]]}]]}]
30:["$","div","The first attack on Bath stalls",{"className":"moment","children":[["$","$L25",null,{"seconds":1627,"label":"27:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first attack on Bath stalls"}],["$","p",null,{"children":"Jackson sent militia around Warm Springs Mountain and ordered William Gilham toward town. Felled trees stopped the militia, Gilham pulled back after meeting skirmishers, and Loring countermanded a renewed advance."}]]}]]}]
31:["$","div","Jackson forces the entry into Bath",{"className":"moment","children":[["$","$L25",null,{"seconds":1746,"label":"29:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson forces the entry into Bath"}],["$","p",null,{"children":"After more delays on January 4, Jackson sent cavalry directly into Bath and followed. Federal infantry had already escaped west across the mountain or north across the Potomac."}]]}]]}]
32:["$","div","Hancock refuses surrender",{"className":"moment","children":[["$","$L25",null,{"seconds":1788,"label":"29:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock refuses surrender"}],["$","p",null,{"children":"Jackson sent a demand across the river, briefly bombarded the town after its rejection, and ordered work on an upstream bridge. He did not have a secure crossing."}]]}]]}]
33:["$","div","Jackson abandons the Hancock crossing",{"className":"moment","children":[["$","$L25",null,{"seconds":1815,"label":"30:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson abandons the Hancock crossing"}],["$","p",null,{"children":"On January 6 Jackson concluded that the reinforced garrison could not be taken without losses he was unwilling to accept. He turned back toward Unger’s Store and Romney."}]]}]]}]
34:["$","div","Ice disables the column",{"className":"moment","children":[["$","$L25",null,{"seconds":1849,"label":"30:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ice disables the column"}],["$","p",null,{"children":"Snow-covered ice produced repeated falls, frostbite, broken movement, and severe suffering among horses that had not been properly shod for winter roads."}]]}]]}]
35:["$","div","The army pauses at Unger’s Store",{"className":"moment","children":[["$","$L25",null,{"seconds":1927,"label":"32:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army pauses at Unger’s Store"}],["$","p",null,{"children":"By January 8 one brigade reported 500 sick and another 300. Jackson stopped for four days so the troops could recover and farriers could shoe the horses."}]]}]]}]
36:["$","div","Romney is reported abandoned",{"className":"moment","children":[["$","$L25",null,{"seconds":1955,"label":"32:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Romney is reported abandoned"}],["$","p",null,{"children":"On January 13 Confederate cavalry informed Jackson that the United States garrison had evacuated after overestimating his strength."}]]}]]}]
37:["$","div","The Stonewall Brigade reaches Romney",{"className":"moment","children":[["$","$L25",null,{"seconds":1974,"label":"32:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Stonewall Brigade reaches Romney"}],["$","p",null,{"children":"The brigade entered late on January 14 after another sleet-covered march. Loring’s brigades took as much as two more days to complete the movement."}]]}]]}]
38:["$","div","Jackson reports casualties and disperses the command",{"className":"moment","children":[["$","$L25",null,{"seconds":2025,"label":"33:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson reports casualties and disperses the command"}],["$","p",null,{"children":"Jackson reported four killed and 28 wounded, stationed Loring at Romney, assigned militia to Bath and Martinsburg, and returned with the Stonewall Brigade to Winchester."}]]}]]}]
39:["$","div","Loring’s officers petition",{"className":"moment","children":[["$","$L25",null,{"seconds":2082,"label":"34:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Loring’s officers petition"}],["$","p",null,{"children":"Eleven officers complained of the Romney position and the command’s condition. Loring endorsed their statement while a copy also went outside the normal chain of command to Jefferson Davis."}]]}]]}]
3a:["$","div","Benjamin orders Loring back",{"className":"moment","children":[["$","$L25",null,{"seconds":2209,"label":"36:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Benjamin orders Loring back"}],["$","p",null,{"children":"Citing intelligence that Loring might be cut off, the War Department ordered an immediate return to Winchester. Jackson obeyed the order."}]]}]]}]
3b:["$","div","Jackson asks to leave field command",{"className":"moment","children":[["$","$L25",null,{"seconds":2235,"label":"37:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson asks to leave field command"}],["$","p",null,{"children":"Jackson argued that political interference made effective command impossible. He requested assignment to VMI or, failing that, acceptance of his resignation."}]]}]]}]
3c:["$","div","Johnston tries to retain Jackson",{"className":"moment","children":[["$","$L25",null,{"seconds":2268,"label":"37:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston tries to retain Jackson"}],["$","p",null,{"children":"Joseph E. Johnston delayed forwarding the request and urged Jackson to reconsider, noting that the War Department had also bypassed Johnston’s authority."}]]}]]}]
3d:["$","div","The terms of reconciliation remain uncertain",{"className":"moment","children":[["$","$L25",null,{"seconds":2364,"label":"39:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The terms of reconciliation remain uncertain"}],["$","p",null,{"children":"Governor John Letcher negotiated with Benjamin and sent Alexander R. Boteler to Jackson. Neither man recorded the exact terms, and any promise of future noninterference is unconfirmed."}]]}]]}]
3e:["$","div","Jackson withdraws the resignation",{"className":"moment","children":[["$","$L25",null,{"seconds":2403,"label":"40:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson withdraws the resignation"}],["$","p",null,{"children":"Jackson authorized Letcher to withdraw it. The next day he filed charges against Loring, but Davis did not permit a court-martial; Loring was promoted and transferred."}]]}]]}]
3f:["$","span",null,{"children":"Benjamin F. Kelley"}]
40:["$","small",null,{"children":"Had occupied Romney before Jackson took command of the Valley District and identified it as an approach to Winchester"}]
41:["$","div","Field command at Bath, Hancock, and Romney",{"className":"command-entry","children":[["$","strong",null,{"children":"Field command at Bath, Hancock, and Romney"}],["$","span",null,{"children":"Frederick W. Lander"}],["$","small",null,{"children":"Withdrew the exposed Bath detachment, refused Jackson’s demand for Hancock, and evacuated Romney on January 10 before Jackson arrived"}]]}]
42:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
43:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Thomas J. “Stonewall” Jackson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep140-stonewall-jackson.jpg","alt":"Portrait of Thomas J. “Stonewall” Jackson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Commanded the Valley District, planned the Romney operation, and directed the winter march from Winchester through Bath to Romney"}]]}]]}],["$","article","William W. Loring",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WW"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"William W. Loring"}],["$","p",null,{"children":"Commanded the Army of the Northwest under Jackson; his resistance to orders and endorsement of the Romney petition led to a major command dispute"}]]}]]}],["$","article","Richard B. Garnett",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"RB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Richard B. Garnett"}],["$","p",null,{"children":"Commanded the Stonewall Brigade and clashed with Jackson after halting so hungry men could prepare food"}]]}]]}],["$","article","Turner Ashby",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"TA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Turner Ashby"}],["$","p",null,{"children":"Commanded Jackson’s cavalry screen and reported the United States evacuation of Romney"}]]}]]}],["$","article","William Gilham",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WG"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"William Gilham"}],["$","p",null,{"children":"Led one of Loring’s brigades; his delayed movement against Bath helped allow the Federal garrison to escape"}]]}]]}],["$","article","William B. Taliaferro",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"William B. Taliaferro"}],["$","p",null,{"children":"Led a brigade in Loring’s command and personally carried a copy of the Romney complaints to Jefferson Davis"}]]}]]}],["$","article","Judah P. Benjamin",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JP"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Judah P. Benjamin"}],["$","p",null,{"children":"Confederate secretary of war who approved reinforcements for Jackson and later ordered Loring’s withdrawal from Romney"}]]}]]}],["$","article","Joseph E. Johnston",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Joseph E. Johnston"}],["$","p",null,{"children":"Jackson’s immediate superior; approved the operation cautiously and later delayed Jackson’s resignation while urging reconsideration"}]]}]]}],["$","article","Frederick W. Lander",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"FW"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Frederick W. Lander"}],["$","p",null,{"children":"United States field commander who refused to surrender Hancock and withdrew from Romney before Jackson arrived"}]]}]]}],"$L48","$L49"]}]
