1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",140," · ","November 4, 1861–February 7, 1862 (Dam No. 5 operation, December 17–21; Romney Expedition, January 1–24; command dispute through February 7)"," · ","The lower Shenandoah Valley and upper Potomac region: Winchester, Dam No. 5 on the Chesapeake and Ohio Canal, Bath (present-day Berkeley Springs, West Virginia), Hancock, Maryland, Unger’s Store, Bloomery Gap, and Romney, Virginia (present-day West Virginia)"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: THE ROMNEY EXPEDITION"}],["$","span",null,{"className":"result-label","children":"Temporary Confederate operational success. Jackson drove the United States detachments out of Bath and induced the evacuation of Romney, but did not capture Hancock. His occupation disrupted the Baltimore and Ohio Railroad and Chesapeake and Ohio Canal corridor only temporarily. The decision to leave Loring at Romney produced a command crisis; Richmond ordered Loring back to Winchester, and United States troops reoccupied Romney on February 7"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8486687711.mp3?updated=1695220188","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Core operation",{"children":[["$","span",null,{"children":"Core operation"}],["$","strong",null,{"children":"January 1–24, 1862"}],["$","small",null,{"children":"Jackson left Winchester on January 1, occupied Bath on January 4 and Romney on January 14, then departed Romney for Winchester on January 23 and arrived the next day."}]]}],["$","div","Why Romney mattered",{"children":[["$","span",null,{"children":"Why Romney mattered"}],["$","strong",null,{"children":"A western approach to Winchester and a junction in the South Branch Potomac Valley"}],["$","small",null,{"children":"The Northwestern Turnpike connected Romney to Winchester. Other roads linked the town to the Staunton–Parkersburg route, while nearby Federal positions covered repaired sections of the Baltimore and Ohio Railroad."}]]}],["$","div","Jackson’s force on taking command",{"children":[["$","span",null,{"children":"Jackson’s force on taking command"}],["$","strong",null,{"children":"About 1,650 militia, 485 cavalry, and two artillery pieces"}],["$","small",null,{"children":"These are the episode’s figures for early November 1861. The militia was dispersed, short of ammunition, and often armed with converted flintlocks."}]]}],["$","div","Federal pressure described in the episode",{"children":[["$","span",null,{"children":"Federal pressure described in the episode"}],["$","strong",null,{"children":"Banks: 18,000; Rosecrans: more than 22,000; Kelley at Romney: 5,000"}],["$","small",null,{"children":"These figures describe separate regional commands, not a single force concentrated against Jackson. They are the estimates used by the episode."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}],"$L1e","$L1f","$L20","$L21",false,"$L22","$L23","$L24"]}]]}]
25:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Reinforcements",{"children":[["$","span",null,{"children":"Reinforcements"}],["$","strong",null,{"children":"Stonewall Brigade and three brigades from Loring’s Army of the Northwest"}],["$","small",null,{"children":"Loring retained immediate command of brigades led by Samuel R. Anderson, William Gilham, and William B. Taliaferro. Jackson’s former brigade was commanded by Richard B. Garnett."}]]}]
f:["$","div","Strength before the march",{"children":[["$","span",null,{"children":"Strength before the march"}],["$","strong",null,{"children":"Episode count: 7,500 regular Confederate troops, 2,200 militia, and 650 cavalry"}],["$","small",null,{"children":"The episode totals the assembled categories at about 10,350. Other accounts commonly describe roughly 9,000 men actually marching and about 11,000 in the wider command. The categories and effective strengths varied by date."}]]}]
10:["$","div","Dam No. 5 operation",{"children":[["$","span",null,{"children":"Dam No. 5 operation"}],["$","strong",null,{"children":"December 17–21, 1861; damage repaired within two days"}],["$","small",null,{"children":"Jackson tried to lower the Chesapeake and Ohio Canal by breaching the Potomac dam. His men worked at night under intermittent fire. The Official Records date the operation December 17–21; the episode says the column left before dawn on December 16."}]]}]
11:["$","div","March began",{"children":[["$","span",null,{"children":"March began"}],["$","strong",null,{"children":"6 a.m., January 1, 1862"}],["$","small",null,{"children":"The weather began mild, then turned to wind, sleet, snow, and falling temperatures. Men who had discarded or packed blankets and overcoats could not recover them because wagons lagged behind."}]]}]
12:["$","div","Route choice",{"children":[["$","span",null,{"children":"Route choice"}],["$","strong",null,{"children":"Winchester to Bath by rough roads, not directly to Romney"}],["$","small",null,{"children":"Jackson used an indirect route to conceal his objective and to remove the Federal post at Bath from the flank of a later move toward Romney."}]]}]
13:["$","div","Bath garrison",{"children":[["$","span",null,{"children":"Bath garrison"}],["$","strong",null,{"children":"About 1,400 United States troops in the episode"}],["$","small",null,{"children":"Jackson hoped to trap the garrison, cross the Potomac, destroy supplies at Hancock, and cut the telegraph. Delays and failed Confederate movements allowed the troops to escape west or across the river."}]]}]
14:["$","div","Bath occupied",{"children":[["$","span",null,{"children":"Bath occupied"}],["$","strong",null,{"children":"January 4, 1862"}],["$","small",null,{"children":"Gilham’s brigade did not press into town on January 3, and Loring countermanded Jackson’s renewed instruction. On January 4 Confederate cavalry and Jackson entered after the Federal infantry had withdrawn."}]]}]
15:["$","div","Hancock engagement",{"children":[["$","span",null,{"children":"Hancock engagement"}],["$","strong",null,{"children":"January 5–6; indecisive"}],["$","small",null,{"children":"Jackson demanded surrender, bombarded the town from the Virginia side, and explored a crossing. Frederick W. Lander refused. Jackson abandoned the effort after the garrison was reinforced and moved toward Romney."}]]}]
16:["$","div","Extreme-weather claim",{"children":[["$","span",null,{"children":"Extreme-weather claim"}],["$","strong",null,{"children":"The episode reports temperatures near −20°F on the return to Unger’s Store"}],["$","small",null,{"children":"The exact temperature is difficult to establish. What is not in doubt is the severe ice, snow, frostbite, sickness, and loss of mobility among men, horses, wagons, and artillery."}]]}]
17:["$","div","Romney evacuated",{"children":[["$","span",null,{"children":"Romney evacuated"}],["$","strong",null,{"children":"January 10; occupied by Jackson’s force on January 14"}],["$","small",null,{"children":"Lander withdrew the United States garrison before Jackson arrived. Confederate cavalry entered first; the Stonewall Brigade arrived on January 14, and parts of Loring’s command required up to two additional days."}]]}]
18:["$","div","Episode casualty total",{"children":[["$","span",null,{"children":"Episode casualty total"}],["$","strong",null,{"children":"Confederacy: 4 killed and 28 wounded"}],["$","small",null,{"children":"Jackson reported these totals for the expedition. No general or other senior commander was killed or mortally wounded in the operations covered by the episode."}]]}]
19:["$","div","Winter dispositions",{"children":[["$","span",null,{"children":"Winter dispositions"}],["$","strong",null,{"children":"Loring at Romney; militia at Bath and Martinsburg; Jackson and the Stonewall Brigade at Winchester"}],["$","small",null,{"children":"Jackson intended these separated posts to cover the frontier while keeping his most trusted brigade centrally placed as a reserve."}]]}]
1a:["$","div","Romney petition",{"children":[["$","span",null,{"children":"Romney petition"}],["$","strong",null,{"children":"Signed by 11 brigade and regimental officers on January 25"}],["$","small",null,{"children":"The petition described exposure, sickness, inadequate food and shelter, and the position at Romney as unfavorable. Loring endorsed it; Taliaferro carried a copy directly to Jefferson Davis while on leave."}]]}]
1b:["$","div","Richmond intervenes",{"children":[["$","span",null,{"children":"Richmond intervenes"}],["$","strong",null,{"children":"Loring ordered back to Winchester"}],["$","small",null,{"children":"Secretary of War Judah P. Benjamin transmitted the order without first resolving it through Jackson and Joseph E. Johnston. Jackson complied, then requested transfer to VMI or acceptance of his resignation."}]]}]
1c:["$","div","Resolution of the command crisis",{"children":[["$","span",null,{"children":"Resolution of the command crisis"}],["$","strong",null,{"children":"Jackson withdrew his resignation on February 6; charges against Loring did not proceed"}],["$","small",null,{"children":"Governor John Letcher and Congressman Alexander R. Boteler helped mediate. Jackson then charged Loring with neglect and conduct subversive of discipline. Loring was promoted and transferred rather than court-martialed."}]]}]
1d:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"Intimate Strategies of the Civil War: Military Commanders and Their Wives"}],["$","small",null,{"children":"Edited by Carol K. Bleser and Lesley J. Gordon. The automated transcript misspells both editors’ names."}]]}]
1e:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
1f:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The Romney Expedition route",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep140-romney-expedition-route.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The Romney Expedition route at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep140-romney-expedition-route.svg","alt":"Schematic map of the Romney Expedition route from Winchester to Bath, Hancock, and Romney","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Romney Expedition route"}],["$","span",null,{"children":"Jackson first raided Dam No. 5 from Winchester in December. On January 1 his enlarged command marched northwest to Unger’s Store, turned toward Bath rather than taking the direct road to Romney, and reached the Potomac opposite Hancock. It returned to Unger’s Store, then moved through Bloomery Gap to Romney after the United States evacuation. Jackson and the Stonewall Brigade later returned to Winchester. Geography and routes are schematic."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep140-romney-expedition-route.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/2006629775/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Bath and Hancock, January 3–6",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep140-bath-hancock-operations.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Bath and Hancock, January 3–6 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep140-bath-hancock-operations.svg","alt":"Schematic map of the Confederate advance at Bath and bombardment of Hancock in January 1862","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Bath and Hancock, January 3–6"}],["$","span",null,{"children":"Jackson directed militia around Warm Springs Mountain while Gilham advanced toward Bath. Both efforts stalled, and the Federal troops escaped west or north across the Potomac. Confederate artillery later fired from Orrick’s Hill toward Hancock. Jackson considered an upstream bridge but abandoned the crossing after the garrison was reinforced. Routes and positions are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep140-bath-hancock-operations.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=MD001","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
20:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Jackson assumes the Valley mission",{"className":"moment","children":[["$","$L25",null,{"seconds":183,"label":"3:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson assumes the Valley mission"}],["$","p",null,{"children":"The narrative resumes on November 5, 1861, as Jackson arrives at Winchester to command the Valley District and protect the Shenandoah Valley."}]]}]]}],["$","div","The valley’s strategic value",{"className":"moment","children":[["$","$L25",null,{"seconds":229,"label":"3:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"The valley’s strategic value"}],["$","p",null,{"children":"The lower valley pointed toward the Potomac and Washington, while its farms supplied the Confederacy and its mountain passes opened routes between the valley and Piedmont Virginia."}]]}]]}],["$","div","Jackson finds the district exposed",{"className":"moment","children":[["$","$L25",null,{"seconds":368,"label":"6:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson finds the district exposed"}],["$","p",null,{"children":"Banks held western Maryland, Rosecrans operated in western Virginia, and Kelley occupied Romney. Jackson had dispersed militia, a small cavalry force, and only two guns."}]]}]]}],["$","div","The Stonewall Brigade is sent west",{"className":"moment","children":[["$","$L25",null,{"seconds":519,"label":"8:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Stonewall Brigade is sent west"}],["$","p",null,{"children":"Secretary of War Judah P. Benjamin assigned Jackson his former brigade. Jackson intended to use it offensively rather than hold a static defensive line."}]]}]]}],["$","div","Jackson proposes an offensive",{"className":"moment","children":[["$","$L25",null,{"seconds":590,"label":"9:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson proposes an offensive"}],["$","p",null,{"children":"In a November 20 letter to Benjamin, Jackson argued that action in the valley could mislead Washington, support Joseph E. Johnston near Manassas, and eventually help recover northwestern Virginia."}]]}]]}],["$","div","Romney becomes the immediate objective",{"className":"moment","children":[["$","$L25",null,{"seconds":671,"label":"11:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Romney becomes the immediate objective"}],["$","p",null,{"children":"Jackson identified Romney as the key to his western flank and the South Branch Valley, as well as a point from which the Federals could advance on Winchester."}]]}]]}],["$","div","Johnston and Benjamin approve",{"className":"moment","children":[["$","$L25",null,{"seconds":763,"label":"12:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston and Benjamin approve"}],["$","p",null,{"children":"Jackson’s superiors approved a move against Romney but Johnston warned that the broader proposal sought more than the available force could probably accomplish."}]]}]]}],["$","div","Discontent in the Stonewall Brigade",{"className":"moment","children":[["$","$L25",null,{"seconds":876,"label":"14:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Discontent in the Stonewall Brigade"}],["$","p",null,{"children":"The brigade reached the Winchester area expecting access to home and family. Jackson instead restricted furloughs and movement while sickness spread during cold, wet weather."}]]}]]}],["$","div","Jackson targets Dam No. 5",{"className":"moment","children":[["$","$L25",null,{"seconds":990,"label":"16:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson targets Dam No. 5"}],["$","p",null,{"children":"With the Baltimore and Ohio Railroad damaged, the Chesapeake and Ohio Canal carried important coal traffic. Jackson marched to the Potomac to try to breach one of the canal’s regulating dams."}]]}]]}],["$","div","The dam detail works under fire",{"className":"moment","children":[["$","$L25",null,{"seconds":1082,"label":"18:02"}],["$","div",null,{"children":["$L26","$L27"]}]]}],"$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e"]}]]}]
21:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Department of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Northern Virginia"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"Jackson’s immediate superior; approved the Romney operation with reservations and later tried to prevent Jackson’s resignation"}]]}],["$","div","Valley District",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District"}],["$","span",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Directed the Stonewall Brigade, Loring’s Army of the Northwest, Valley militia, Turner Ashby’s cavalry, and attached artillery during the operation"}]]}],["$","div","Stonewall Brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Richard B. Garnett"}],["$","small",null,{"children":"2nd, 4th, 5th, 27th, and 33rd Virginia Infantry; the expedition deepened his conflict with Jackson over care of the troops and obedience to orders"}]]}],["$","div","Army of the Northwest, under Jackson for the expedition",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Northwest, under Jackson for the expedition"}],["$","span",null,{"children":"William W. Loring"}],["$","small",null,{"children":"Retained immediate control of three infantry brigades and attached batteries; repeatedly disputed Jackson’s orders and later endorsed the Romney petition"}]]}],["$","div","Loring’s three infantry brigades",{"className":"command-entry","children":[["$","strong",null,{"children":"Loring’s three infantry brigades"}],["$","span",null,{"children":"Samuel R. Anderson, William Gilham, and William B. Taliaferro"}],["$","small",null,{"children":"Gilham led the hesitant advance at Bath; Taliaferro’s brigade reached Winchester first and Taliaferro later carried complaints to Richmond"}]]}],["$","div","Valley cavalry",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley cavalry"}],["$","span",null,{"children":"Turner Ashby"}],["$","small",null,{"children":"Screened and scouted for Jackson, participated in the Bath and Hancock operations, and reported the Federal evacuation of Romney"}]]}]]]}],["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","General-in-Chief, United States Army",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-Chief, United States Army"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Exercised overall authority over the separate commands operating along the Potomac and in western Virginia"}]]}],["$","div","Division based along the upper Potomac in western Maryland",{"className":"command-entry","children":[["$","strong",null,{"children":"Division based along the upper Potomac in western Maryland"}],["$","span",null,{"children":"Nathaniel P. Banks"}],["$","small",null,{"children":"Held the northeastern approaches to the lower Shenandoah Valley; his troops also opposed the December operation at Dam No. 5"}]]}],["$","div","Department of Western Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Western Virginia"}],["$","span",null,{"children":"William S. Rosecrans"}],["$","small",null,{"children":"Commanded the larger Federal establishment beyond the Alleghenies described in the episode’s strategic opening"}]]}],["$","div","Department of Harper’s Ferry and Cumberland",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Harper’s Ferry and Cumberland"}],"$L3f","$L40"]}],"$L41"]]}]]}],"$L42","$L43"]}]
22:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep140-romney-expedition-route.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep140-romney-expedition-route.svg","alt":"Schematic route map of Jackson’s winter expedition from Winchester to Bath, Hancock, and Romney","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s indirect march removed the Bath outpost and led the Romney garrison to withdraw, but ice, sickness, and delayed supply trains reduced the command’s mobility."}]]}],["$","figure","/images/ep140-bath-hancock-operations.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep140-bath-hancock-operations.svg","alt":"Schematic operational map of Bath, Warm Springs Mountain, the Potomac, and Hancock","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Confederate delays at Bath allowed most Federal troops to escape. The Potomac and the reinforced Hancock garrison then stopped Jackson from extending the operation into Maryland."}]]}],["$","figure","/images/ep140-romney-road-guard.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep140-romney-road-guard.jpg","alt":"January 1862 drawing of United States soldiers and artillery guarding the road from Romney to Winchester","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"E. M. Bott’s January 1862 field drawing shows Captain James Wallace’s 4th Ohio detachment guarding the road from Romney toward Winchester under Benjamin F. Kelley’s command."}]]}],["$","figure","/images/ep140-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep140-stonewall-jackson.jpg","alt":"Photographic portrait of Confederate major general Thomas J. Stonewall Jackson","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s aggressive winter operation secured Romney only temporarily and nearly ended his Confederate service when Richmond reversed his dispositions."}]]}]]}]]}]
23:["$","details",null,{"className":"reference-sources","children":[["$","summary",null,{"children":"Sources and image credits"}],["$","ul",null,{"children":[["$","li","https://civilwarpodcast.org/2016/01/31/civil-war-podcast-episode-140/",{"children":["$","a",null,{"href":"https://civilwarpodcast.org/2016/01/31/civil-war-podcast-episode-140/","target":"_blank","rel":"noreferrer","children":["The Civil War Podcast: episode 140 page"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://civilwar.com/official-record/866-west-virginia/154507-388-series-i-volume-v-serial-5-west-virginia.html",{"children":["$","a",null,{"href":"https://civilwar.com/official-record/866-west-virginia/154507-388-series-i-volume-v-serial-5-west-virginia.html","target":"_blank","rel":"noreferrer","children":["Official Records, Series I, Volume V, page 388: summary of Valley District operations"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://civilwar.com/official-record/866-west-virginia/154508-389-series-i-volume-v-serial-5-west-virginia.html",{"children":["$","a",null,{"href":"https://civilwar.com/official-record/866-west-virginia/154508-389-series-i-volume-v-serial-5-west-virginia.html","target":"_blank","rel":"noreferrer","children":["Official Records, Series I, Volume V, page 389: Jackson’s report begins"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.civilwar.com/battles/866-official-record/series/volume/