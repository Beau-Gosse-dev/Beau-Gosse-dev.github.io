16:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
18:["$","div","U.S. troops destroyed the local railroads",{"className":"moment","children":[["$","$L17",null,{"seconds":764,"label":"12:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops destroyed the local railroads"}],["$","p",null,{"children":"Work parties burned ties and heated and twisted rails. At least eight miles of the Virginia Central Railroad and part of the Richmond, Fredericksburg and Potomac line were disabled."}]]}]]}]
19:["$","div","Grant believed Lee’s army was close to defeat",{"className":"moment","children":[["$","$L17",null,{"seconds":852,"label":"14:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant believed Lee’s army was close to defeat"}],["$","p",null,{"children":"Reports from prisoners and Lee’s use of earthworks led Grant to tell Halleck on May 26 that U.S. morale was higher and eventual success appeared assured."}]]}]]}]
1a:["$","div","The turning movement began",{"className":"moment","children":[["$","$L17",null,{"seconds":984,"label":"16:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The turning movement began"}],["$","p",null,{"children":"Supply wagons and artillery moved first. Torbert and Gregg’s cavalry divisions and David Russell’s VI Corps division led the march toward the Pamunkey."}]]}]]}]
1b:["$","div","U.S. forces secured Hanovertown",{"className":"moment","children":[["$","$L17",null,{"seconds":1022,"label":"17:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. forces secured Hanovertown"}],["$","p",null,{"children":"Cavalry drove away a small Confederate force, engineers built two pontoon bridges, and Sheridan was south of the Pamunkey by 9 a.m. on May 27."}]]}]]}]
1c:["$","div","The Army of the Potomac completed the crossing",{"className":"moment","children":[["$","$L17",null,{"seconds":1066,"label":"17:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Potomac completed the crossing"}],["$","p",null,{"children":"Most infantry crossed by noon on May 28. The last U.S. troops reached the south bank shortly after midnight on May 29."}]]}]]}]
1d:["$","div","Lee shifted toward Atlee Station",{"className":"moment","children":[["$","$L17",null,{"seconds":1081,"label":"18:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee shifted toward Atlee Station"}],["$","p",null,{"children":"Once he recognized the southeastern move, Lee withdrew roughly twelve miles. His new position left only about nine miles between the army and Richmond."}]]}]]}]
1e:["$","div","Lee sent Hampton to find the U.S. infantry",{"className":"moment","children":[["$","$L17",null,{"seconds":1243,"label":"20:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee sent Hampton to find the U.S. infantry"}],["$","p",null,{"children":"Hampton took four cavalry brigades, horse artillery, and three mounted-infantry regiments toward the Hanovertown crossings on May 28."}]]}]]}]
1f:["$","div","The reconnaissance forces met near Haw’s Shop",{"className":"moment","children":[["$","$L17",null,{"seconds":1279,"label":"21:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The reconnaissance forces met near Haw’s Shop"}],["$","p",null,{"children":"Hampton’s column encountered Henry Davies’s brigade, the lead of Gregg’s U.S. cavalry reconnaissance, about three-quarters of a mile from the road junction."}]]}]]}]
20:["$","div","Hampton formed a strong dismounted line",{"className":"moment","children":[["$","$L17",null,{"seconds":1340,"label":"22:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hampton formed a strong dismounted line"}],["$","p",null,{"children":"A stream and mill pond protected the flanks. Confederate cavalry and mounted infantry built a barricade across the road, forcing Gregg to attack directly."}]]}]]}]
21:["$","div","Gregg requested reinforcements",{"className":"moment","children":[["$","$L17",null,{"seconds":1387,"label":"23:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gregg requested reinforcements"}],["$","p",null,{"children":"Two U.S. brigades could not break the position. Repeating rifles produced heavy fire, but the dismounted battle remained unresolved for more than five hours."}]]}]]}]
22:["$","div","Custer’s brigade entered the battle",{"className":"moment","children":[["$","$L17",null,{"seconds":1464,"label":"24:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Custer’s brigade entered the battle"}],["$","p",null,{"children":"Meade refused Sheridan’s request for infantry, so Sheridan committed Custer’s available Michigan cavalry brigade to support Gregg."}]]}]]}]
23:["$","div","Hampton began withdrawing after completing his mission",{"className":"moment","children":[["$","$L17",null,{"seconds":1479,"label":"24:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hampton began withdrawing after completing his mission"}],["$","p",null,{"children":"Captured soldiers confirmed that V and VI Corps were across the Pamunkey. Hampton ordered his brigades to disengage."}]]}]]}]
24:["$","div","Custer struck Butler’s mounted infantry",{"className":"moment","children":[["$","$L17",null,{"seconds":1504,"label":"25:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Custer struck Butler’s mounted infantry"}],["$","p",null,{"children":"Inexperienced Confederates misread U.S. movement as a retreat and advanced. Custer’s fresh brigade counterattacked, captured at least eighty men, and pressed the main Confederate line."}]]}]]}]
25:["$","div","Both sides suffered several hundred casualties",{"className":"moment","children":[["$","$L17",null,{"seconds":1541,"label":"25:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both sides suffered several hundred casualties"}],["$","p",null,{"children":"The episode counts 297 casualties in Gregg and Custer’s commands and says Confederate losses were probably higher. The National Park Service estimates 744 total casualties."}]]}]]}]
26:["$","div","The battle supplied the missing intelligence",{"className":"moment","children":[["$","$L17",null,{"seconds":1580,"label":"26:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battle supplied the missing intelligence"}],["$","p",null,{"children":"Hampton confirmed the location of V and VI Corps. Sheridan learned the positions of Anderson and Ewell from Confederate prisoners."}]]}]]}]
