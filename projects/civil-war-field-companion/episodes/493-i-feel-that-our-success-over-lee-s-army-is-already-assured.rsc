f:["$","figure","The movement from North Anna to the Pamunkey",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The movement from North Anna to the Pamunkey at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland Campaign movement from North Anna toward Richmond","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The movement from North Anna to the Pamunkey"}],["$","span",null,{"children":"Grant withdrew north of the North Anna, moved east and southeast, and crossed the Pamunkey near Hanovertown. Lee used shorter interior roads toward Atlee Station and Totopotomoy Creek."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
10:["$","figure","Hanovertown, Haw’s Shop, and Richmond today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.62%2C37.53%2C-77.04%2C37.91&layer=mapnik&marker=37.6769%2C-77.3071","title":"Hanovertown, Haw’s Shop, and Richmond today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Hanovertown, Haw’s Shop, and Richmond today"}],["$","span",null,{"children":"Haw’s Shop stood between the Pamunkey crossings and the Totopotomoy line. The fight delayed U.S. reconnaissance while both armies moved into positions northeast of Richmond."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Lee held an inverted-V position at North Anna",{"className":"moment","children":[["$","$L17",null,{"seconds":78,"label":"1:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee held an inverted-V position at North Anna"}],["$","p",null,{"children":"The Confederate line met at Ox Ford and extended southwest and southeast. Grant’s two wings could not easily support one another across the river, while Lee could move troops inside the angle."}]]}]]}],["$","div","A later account claimed Lee intended to attack",{"className":"moment","children":[["$","$L17",null,{"seconds":232,"label":"3:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"A later account claimed Lee intended to attack"}],["$","p",null,{"children":"Charles Venable said Lee wanted Hill to strike Warren’s isolated V Corps but illness prevented close direction. The episode notes that no contemporary order or troop movement clearly supports the claim."}]]}]]}],["$","div","The Confederate posture remained defensive",{"className":"moment","children":[["$","$L17",null,{"seconds":360,"label":"6:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate posture remained defensive"}],["$","p",null,{"children":"Hill and Anderson made no preparation for a general assault. Ewell’s limited attack against Gibbon on May 24 avoided a larger engagement."}]]}]]}],["$","div","U.S. scouts mapped Lee’s position",{"className":"moment","children":[["$","$L17",null,{"seconds":427,"label":"7:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. scouts mapped Lee’s position"}],["$","p",null,{"children":"By noon on May 25, probes had established the shape of the Confederate line. Grant told Halleck that Lee was making a determined stand between the North and South Anna rivers."}]]}]]}],["$","div","Grant revised operations elsewhere in Virginia",{"className":"moment","children":[["$","$L17",null,{"seconds":473,"label":"7:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant revised operations elsewhere in Virginia"}],["$","p",null,{"children":"He planned to withdraw most of Smith’s troops from Bermuda Hundred and send them to the Pamunkey, while David Hunter renewed operations in the Shenandoah Valley."}]]}]]}],["$","div","Grant considered moving around either flank",{"className":"moment","children":[["$","$L17",null,{"seconds":586,"label":"9:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant considered moving around either flank"}],["$","p",null,{"children":"A western movement could cut the Virginia Central Railroad but would complicate supply. An eastern movement repeated the earlier turns but offered a safer route."}]]}]]}],["$","div","The council first selected a western movement",{"className":"moment","children":[["$","$L17",null,{"seconds":654,"label":"10:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"The council first selected a western movement"}],["$","p",null,{"children":"Grant, Warren, and Henry Hunt initially supported moving around Lee’s left. Grant reconsidered because the army could not maintain a dependable supply line on that route."}]]}]]}],["$","div","Grant ordered the army toward Hanovertown",{"className":"moment","children":[["$","$L17",null,{"seconds":688,"label":"11:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant ordered the army toward Hanovertown"}],["$","p",null,{"children":"He gave Meade detailed marching orders for a southeastern movement to the Pamunkey River, about fifteen miles east of Hanover Junction."}]]}]]}],["$","div","Wilson feinted against the Confederate left",{"className":"moment","children":[["$","$L17",null,{"seconds":732,"label":"12:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wilson feinted against the Confederate left"}],["$","p",null,{"children":"Dismounted cavalry and twelve guns created a noisy demonstration on May 26. Lee briefly believed the U.S. Army might move west."}]]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","General-in-chief",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Selected the southeastern turn and coordinated operations in eastern Virginia and the Shenandoah Valley"}]]}],["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"George G. Meade"}],["$","small",null,{"children":"Directed the four infantry corps and declined to release infantry for the cavalry fight"}]]}],["$","div","Cavalry Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry Corps"}],["$","span",null,{"children":"Philip H. Sheridan"}],["$","small",null,{"children":"Screened the march and reinforced Gregg with Custer"}]]}],["$","div","Second Cavalry Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Cavalry Division"}],["$","span",null,{"children":"David McM. Gregg"}],["$","small",null,{"children":"Henry E. Davies and J. Irvin Gregg brigades; led the main U.S. force at Haw’s Shop"}]]}],["$","div","First Brigade, First Cavalry Division",{"className":"command-entry","children":[["$","strong",null,{"children":"First Brigade, First Cavalry Division"}],["$","span",null,{"children":"George A. Custer"}],["$","small",null,{"children":"Michigan regiments that broke the withdrawing Confederate position"}]]}],["$","div","Third Cavalry Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Third Cavalry Division"}],["$","span",null,{"children":"James H. Wilson"}],["$","small",null,{"children":"Conducted the feint west of Lee’s North Anna line"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Robert E. Lee"}],["$","small",null,{"children":"Withdrew from North Anna toward Atlee Station after Grant moved southeast"}]]}],["$","div","Cavalry division and reconnaissance force",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry division and reconnaissance force"}],["$","span",null,{"children":"Wade Hampton"}],["$","small",null,{"children":"Four cavalry brigades, horse artillery, and Butler’s mounted infantry"}]]}],["$","div","Mounted-infantry brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Mounted-infantry brigade"}],["$","span",null,{"children":"Matthew C. Butler"}],["$","small",null,{"children":"Three South Carolina regiments led in the battle by Benjamin H. Rutledge"}]]}],["$","div","First Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"First Corps"}],["$","span",null,{"children":"Richard H. Anderson"}],["$","small",null,{"children":"Position identified by U.S. interrogation of captured Confederates"}]]}],["$","div","Second Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Corps"}],["$","span",null,{"children":"Richard S. Ewell"}],["$","small",null,{"children":"Position identified by U.S. interrogation of captured Confederates"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Ulysses S. Grant",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/