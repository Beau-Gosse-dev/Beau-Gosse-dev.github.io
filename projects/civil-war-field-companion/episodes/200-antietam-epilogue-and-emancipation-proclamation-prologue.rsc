3e:["$","div","The diplomatic discussion is limited to what can be established",{"className":"moment","children":[["$","$L32",null,{"seconds":905,"label":"15:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"The diplomatic discussion is limited to what can be established"}],["$","p",null,{"children":"The hosts identify Antietam as a definite setback for Confederate diplomacy while treating alternate outcomes as speculation."}]]}]]}]
3f:["$","div","The episode turns to emancipation",{"className":"moment","children":[["$","$L32",null,{"seconds":914,"label":"15:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode turns to emancipation"}],["$","p",null,{"children":"Antietam gives Lincoln a military result strong enough to announce a policy he had delayed since July."}]]}]]}]
40:["$","div","Strategic victory is distinguished from tactical result",{"className":"moment","children":[["$","$L32",null,{"seconds":953,"label":"15:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Strategic victory is distinguished from tactical result"}],["$","p",null,{"children":"Lee’s retreat ends the invasion and supports both the diplomatic and emancipation consequences discussed in the episode."}]]}]]}]
41:["$","div","Lincoln’s July draft is introduced",{"className":"moment","children":[["$","$L32",null,{"seconds":979,"label":"16:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln’s July draft is introduced"}],["$","p",null,{"children":"Lincoln had read an early emancipation proclamation to his cabinet on July 22."}]]}]]}]
42:["$","div","Seward advises delay",{"className":"moment","children":[["$","$L32",null,{"seconds":992,"label":"16:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Seward advises delay"}],["$","p",null,{"children":"The secretary of state warns that issuing the measure after Federal defeats could make it look like an act of desperation."}]]}]]}]
43:["$","div","Antietam supplies the awaited military occasion",{"className":"moment","children":[["$","$L32",null,{"seconds":1020,"label":"17:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Antietam supplies the awaited military occasion"}],["$","p",null,{"children":"Lee’s failed invasion and withdrawal allow Lincoln to present the new policy from a position of improved military strength."}]]}]]}]
44:["$","div","The Preliminary Emancipation Proclamation is issued",{"className":"moment","children":[["$","$L32",null,{"seconds":1053,"label":"17:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Preliminary Emancipation Proclamation is issued"}],["$","p",null,{"children":"On September 22 Lincoln announces that enslaved people in areas still in rebellion on January 1 will be recognized as free."}]]}]]}]
45:["$","div","The hundred-day interval begins",{"className":"moment","children":[["$","$L32",null,{"seconds":1073,"label":"17:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"The hundred-day interval begins"}],["$","p",null,{"children":"The preliminary announcement sets January 1, 1863, as the date for the final proclamation."}]]}]]}]
46:["$","div","Debate over meaning and intent is introduced",{"className":"moment","children":[["$","$L32",null,{"seconds":1110,"label":"18:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Debate over meaning and intent is introduced"}],["$","p",null,{"children":"The episode identifies the proclamation’s scope and Lincoln’s purpose as the subject of the next several installments."}]]}]]}]
47:["$","div","The narrative returns to military affairs",{"className":"moment","children":[["$","$L32",null,{"seconds":1130,"label":"18:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"The narrative returns to military affairs"}],["$","p",null,{"children":"The balance of the episode follows Lee and McClellan after the Confederate retreat."}]]}]]}]
48:["$","div","Lee still considers offensive action",{"className":"moment","children":[["$","$L32",null,{"seconds":1159,"label":"19:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee still considers offensive action"}],["$","p",null,{"children":"The Confederate commander remains interested in returning to Maryland despite the failed campaign."}]]}]]}]
49:["$","div","Lee writes Jefferson Davis",{"className":"moment","children":[["$","$L32",null,{"seconds":1172,"label":"19:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee writes Jefferson Davis"}],["$","p",null,{"children":"He considers an advance toward Hagerstown but concludes that the army’s reduced strength and condition make the risk unacceptable."}]]}]]}]
4a:["$","div","Confederate losses and straggling shape the pause",{"className":"moment","children":[["$","$L32",null,{"seconds":1219,"label":"20:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate losses and straggling shape the pause"}],["$","p",null,{"children":"Casualties, desertion, and continued straggling limit Lee’s ability to renew the invasion."}]]}]]}]
4b:["$","div","Lincoln’s frustration with McClellan increases",{"className":"moment","children":[["$","$L32",null,{"seconds":1243,"label":"20:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln’s frustration with McClellan increases"}],["$","p",null,{"children":"The Army of the Potomac needs refitting, but the president no longer trusts McClellan to regain the initiative promptly."}]]}]]}]
4c:["$","div","McClellan’s conflict with Washington is described",{"className":"moment","children":[["$","$L32",null,{"seconds":1265,"label":"21:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan’s conflict with Washington is described"}],["$","p",null,{"children":"Private hostility toward Edwin Stanton and Henry Halleck deepens the command dispute."}]]}]]}]
4d:["$","div","Lincoln weighs victory against missed opportunity",{"className":"moment","children":[["$","$L32",null,{"seconds":1291,"label":"21:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln weighs victory against missed opportunity"}],["$","p",null,{"children":"Antietam enabled the preliminary proclamation, but Lee’s army escaped and McClellan did not mount a vigorous immediate pursuit."}]]}]]}]
4e:["$","div","Lincoln visits the Army of the Potomac",{"className":"moment","children":[["$","$L32",null,{"seconds":1361,"label":"22:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln visits the Army of the Potomac"}],["$","p",null,{"children":"During an October 1–4 trip, he reaches Antietam on October 2, meets McClellan, reviews troops, tours battlefields, and visits wounded soldiers."}]]}]]}]
4f:["$","div","Halleck transmits an explicit directive",{"className":"moment","children":[["$","$L32",null,{"seconds":1391,"label":"23:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck transmits an explicit directive"}],["$","p",null,{"children":"Lincoln orders McClellan to cross the Potomac and give battle to Lee or drive the Confederate army south."}]]}]]}]
50:["$","div","Lincoln sends his October 13 strategic letter",{"className":"moment","children":[["$","$L32",null,{"seconds":1419,"label":"23:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln sends his October 13 strategic letter"}],["$","p",null,{"children":"He argues for an advance east of the Blue Ridge but states that the letter is not an order."}]]}]]}]
51:["$","div","The army finally begins crossing the Potomac",{"className":"moment","children":[["$","$L32",null,{"seconds":1448,"label":"24:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army finally begins crossing the Potomac"}],["$","p",null,{"children":"The transcript gives October 21; the National Park Service chronology places the Army of the Potomac’s general crossing on October 26."}]]}]]}]
52:["$","div","Lee divides his army",{"className":"moment","children":[["$","$L32",null,{"seconds":1455,"label":"24:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee divides his army"}],["$","p",null,{"children":"Jackson remains in the Shenandoah Valley while Longstreet moves east of the Blue Ridge toward Culpeper."}]]}]]}]
53:["$","div","McClellan gains the inside route toward Richmond",{"className":"moment","children":[["$","$L32",null,{"seconds":1469,"label":"24:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan gains the inside route toward Richmond"}],["$","p",null,{"children":"The Federal march through the Virginia Piedmont creates a temporary positional advantage but does not develop rapidly enough to trap Lee’s divided wings."}]]}]]}]
54:["$","div","Lincoln decides to replace McClellan",{"className":"moment","children":[["$","$L32",null,{"seconds":1492,"label":"24:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln decides to replace McClellan"}],["$","p",null,{"children":"The president concludes that the advance has again failed to convert an opportunity into decisive action."}]]}]]}]
55:["$","div","The removal order is issued",{"className":"moment","children":[["$","$L32",null,{"seconds":1504,"label":"25:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The removal order is issued"}],["$","p",null,{"children":"On November 5 McClellan is relieved from command of the Army of the Potomac."}]]}]]}]
56:["$","div","Burnside is named as successor",{"className":"moment","children":[["$","$L32",null,{"seconds":1515,"label":"25:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Burnside is named as successor"}],["$","p",null,{"children":"Ambrose E. Burnside receives command despite his earlier doubts about his fitness for the position."}]]}]]}]
57:["$","div","The book recommendation begins",{"className":"moment","children":[["$","$L32",null,{"seconds":1541,"label":"25:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The book recommendation begins"}],["$","p",null,{"children":"The hosts recommend Louis P. Masur’s study of the hundred days between the preliminary and final proclamations."}]]}]]}]
58:["$","span",null,{"children":"Maj. Gen. A. P. Hill"}]
59:["$","small",null,{"children":"Repulsed the V Corps crossing at Shepherdstown on September 20"}]
