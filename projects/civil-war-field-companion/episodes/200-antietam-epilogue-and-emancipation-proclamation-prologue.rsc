2c:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Commander in Chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in Chief"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Issued the Preliminary Emancipation Proclamation, directed McClellan to advance, and ordered the November change in army command"}]]}],["$","div","General in Chief of the United States Army",{"className":"command-entry","children":[["$","strong",null,{"children":"General in Chief of the United States Army"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Transmitted Lincoln’s October 6 directive and the November order replacing McClellan"}]]}],["$","div","Army of the Potomac through November 7",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac through November 7"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Rested and refitted the army after Antietam, crossed the Potomac in late October, and advanced into the Virginia Piedmont before being relieved"}]]}],["$","div","V Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"Commanded the principal uncommitted reserve at Antietam; corps elements pursued Lee at Shepherdstown"}]]}],["$","div","VI Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"VI Corps"}],["$","span",null,{"children":"Maj. Gen. William B. Franklin"}],["$","small",null,{"children":"Commanded a largely fresh corps whose limit