5b:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Abraham Lincoln",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep200-lincoln-mcclellan.jpg","alt":"Portrait of Abraham Lincoln","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Abraham Lincoln"}],["$","p",null,{"children":"President who linked Antietam’s strategic result to the preliminary proclamation and replaced McClellan after the delayed autumn advance"}]]}]]}],["$","article","George B. McClellan",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep200-lincoln-mcclellan.jpg","alt":"Portrait of George B. McClellan","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George B. McClellan"}],["$","p",null,{"children":"Army of the Potomac commander criticized for uncoordinated attacks at Antietam and slow movement afterward"}]]}]]}],["$","article","William H. Seward",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"William H. Seward"}],["$","p",null,{"children":"Secretary of state who advised Lincoln to delay announcing emancipation until after a favorable military result"}]]}]]}],["$","article","Henry W. Halleck",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"HW"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Henry W. Halleck"}],["$","p",nu