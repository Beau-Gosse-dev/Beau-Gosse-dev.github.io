1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",200," · ","September 17–November 5, 1862"," · ","Sharpsburg and the Potomac crossings in Maryland and Virginia; the Army of the Potomac’s camps and march into the Virginia Piedmont; Washington, D.C.; and the diplomatic context in London and Paris"]}],["$","h1",null,{"children":"ANTIETAM (Epilogue) & EMANCIPATION PROCLAMATION (Prologue)"}],["$","span",null,{"className":"result-label","children":"Lee’s withdrawal ended the Maryland Campaign without destroying either army. The United States treated Antietam as a strategic victory because the Confederate invasion had failed. The result weakened prospects for immediate European mediation and gave Abraham Lincoln the military occasion he had awaited to issue the Preliminary Emancipation Proclamation on September 22. McClellan then delayed a new advance until late October; Lincoln relieved him on November 5 and replaced him with Ambrose Burnside"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8362592976.mp3?updated=1695499641","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Antietam’s strategic consequences and the command crisis through November 5"}],["$","small",null,{"children":"The episode recaps the battle, explains its diplomatic and emancipation consequences, and follows Lincoln’s effort to make McClellan resume operations."}]]}],["$","div","Battle date",{"children":[["$","span",null,{"children":"Battle date"}],["$","strong",null,{"children":"September 17, 1862"}],["$","small",null,{"children":"Antietam was the bloodiest single day in American military history. National Park Service interpretation uses an estimate of 22,720 killed, wounded, or missing."}]]}],["$","div","Operational pattern",{"children":[["$","span",null,{"children":"Operational pattern"}],["$","strong",null,{"children":"Three major Federal attacks were not coordinated into one continuous offensive"}],["$","small",null,{"children":"Fighting moved from the Federal right in the morning, to the center around the Sunken Road, and then to the Ninth Corps on the Federal left."}]]}],["$","div","Federal reserve",{"children":[["$","span",null,{"children":"Federal reserve"}],["$","strong",null,{"children":"Most of V Corps and much of VI Corps remained uncommitted"}],["$","small",null,{"children":"The episode uses this unused strength to criticize McClellan. The degree to which another attack would have succeeded is an interpretive question, not a measurable fact."}]]}],["$","div","Lee’s September 18 decision",{"children":[["$","span",null,{"children":"Lee’s September 18 decision"}],["$","strong",null,{"children":"Remain near Sharpsburg for another day"}],["$","small",null,{"children":"Lee held the line while removing wounded men and preparing to cross the Potomac. McClellan did not renew the general battle."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}],"$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30"]}]]}]
32:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Confederate withdrawal",{"children":[["$","span",null,{"children":"Confederate withdrawal"}],["$","strong",null,{"children":"Began after dark on September 18"}],["$","small",null,{"children":"The Army of Northern Virginia completed its crossing into Virginia by late morning on September 19."}]]}]
f:["$","div","Shepherdstown",{"children":[["$","span",null,{"children":"Shepherdstown"}],["$","strong",null,{"children":"September 19–20, 1862"}],["$","small",null,{"children":"V Corps troops crossed the Potomac in a limited pursuit. A. P. Hill’s division drove the larger September 20 crossing back across the river."}]]}]
10:["$","div","Campaign result",{"children":[["$","span",null,{"children":"Campaign result"}],["$","strong",null,{"children":"Strategic United States victory; tactically inconclusive battle"}],["$","small",null,{"children":"Lee’s first invasion of the North ended, Maryland did not join the Confederacy, and Confederate troops returned to Virginia."}]]}]
11:["$","div","Diplomatic stakes",{"children":[["$","span",null,{"children":"Diplomatic stakes"}],["$","strong",null,{"children":"British leaders were considering mediation during September 1862"}],["$","small",null,{"children":"Foreign Secretary Earl Russell proposed mediation after news of the Confederate victory at Second Manassas. News of Lee’s retreat complicated that initiative."}]]}]
12:["$","div","Palmerston after Antietam",{"children":[["$","span",null,{"children":"Palmerston after Antietam"}],["$","strong",null,{"children":"He concluded that the Maryland battles had improved the North’s position"}],["$","small",null,{"children":"The British prime minister still regarded the war’s outcome as uncertain and waited for more decisive events."}]]}]
13:["$","div","Gladstone’s Newcastle speech",{"children":[["$","span",null,{"children":"Gladstone’s Newcastle speech"}],["$","strong",null,{"children":"October 7, 1862"}],["$","small",null,{"children":"Chancellor of the Exchequer William E. Gladstone publicly said Confederate leaders had made a nation. Other cabinet members distanced the government from that statement, and Britain continued its policy of neutrality."}]]}]
14:["$","div","Limits of the diplomatic claim",{"children":[["$","span",null,{"children":"Limits of the diplomatic claim"}],["$","strong",null,{"children":"Antietam reduced, but did not by itself end, European discussion of intervention"}],["$","small",null,{"children":"French mediation proposals and British debate continued later in 1862. The episode’s broader conclusion is sound only if understood as a setback to Confederate diplomacy rather than an immediate permanent closure of the issue."}]]}]
15:["$","div","Lincoln’s first draft",{"children":[["$","span",null,{"children":"Lincoln’s first draft"}],["$","strong",null,{"children":"Read to the cabinet on July 22, 1862"}],["$","small",null,{"children":"Lincoln proposed using his commander-in-chief authority to free enslaved people in territory held by states in rebellion."}]]}]
16:["$","div","Seward’s advice",{"children":[["$","span",null,{"children":"Seward’s advice"}],["$","strong",null,{"children":"Wait for a favorable military result"}],["$","small",null,{"children":"Secretary of State William H. Seward warned that publication after recent Federal defeats could look like an act of desperation. Lincoln postponed the announcement."}]]}]
17:["$","div","Preliminary proclamation",{"children":[["$","span",null,{"children":"Preliminary proclamation"}],["$","strong",null,{"children":"Issued September 22, 1862"}],["$","small",null,{"children":"Lincoln announced that enslaved people in states or designated parts of states still in rebellion on January 1, 1863, would be recognized as free."}]]}]
18:["$","div","What the preliminary document did",{"children":[["$","span",null,{"children":"What the preliminary document did"}],["$","strong",null,{"children":"Gave the rebelling states a January 1 deadline"}],["$","small",null,{"children":"It announced the policy that would govern the final proclamation; it did not immediately abolish slavery everywhere in the United States."}]]}]
19:["$","div","Geographic limits",{"children":[["$","span",null,{"children":"Geographic limits"}],["$","strong",null,{"children":"Areas still in rebellion, not loyal slave states"}],["$","small",null,{"children":"Maryland, Kentucky, Delaware, and Missouri were not targeted because they remained in the United States. The final proclamation also exempted specified Union-controlled areas."}]]}]
1a:["$","div","War aims",{"children":[["$","span",null,{"children":"War aims"}],["$","strong",null,{"children":"Preservation of the Union and emancipation became linked"}],["$","small",null,{"children":"The proclamation made freedom in rebellious territory an explicit Federal war policy and strengthened the legal basis for later Black military enlistment."}]]}]
1b:["$","div","Final proclamation",{"children":[["$","span",null,{"children":"Final proclamation"}],["$","strong",null,{"children":"Issued January 1, 1863"}],["$","small",null,{"children":"The episode correctly describes the hundred-day interval between the preliminary and final proclamations."}]]}]
1c:["$","div","Lee’s proposed renewed offensive",{"children":[["$","span",null,{"children":"Lee’s proposed renewed offensive"}],["$","strong",null,{"children":"Advance toward Hagerstown was considered and rejected"}],["$","small",null,{"children":"In a September 25 letter to Jefferson Davis, Lee wrote that diminished numbers and the army’s condition made the hazard of an immediate return to Maryland too great."}]]}]
1d:["$","div","Army of Northern Virginia after Antietam",{"children":[["$","span",null,{"children":"Army of Northern Virginia after Antietam"}],["$","strong",null,{"children":"Reduced by casualties, straggling, and supply problems"}],["$","small",null,{"children":"Lee rebuilt his army in the Shenandoah Valley while retaining an interest in renewed offensive action."}]]}]
1e:["$","div","Army of the Potomac after Antietam",{"children":[["$","span",null,{"children":"Army of the Potomac after Antietam"}],["$","strong",null,{"children":"Rested, reorganized, resupplied, and received replacements"}],["$","small",null,{"children":"These needs were real, but Lincoln and Halleck judged that McClellan’s pace surrendered the initiative."}]]}]
1f:["$","div","Lincoln’s army visit",{"children":[["$","span",null,{"children":"Lincoln’s army visit"}],["$","strong",null,{"children":"October 1–4, 1862; at Antietam October 2–4"}],["$","small",null,{"children":"Lincoln met McClellan, reviewed troops, visited wounded soldiers, and toured the South Mountain and Antietam battlefields."}]]}]
20:["$","div","October 6 directive",{"children":[["$","span",null,{"children":"October 6 directive"}],["$","strong",null,{"children":"Cross the Potomac and give battle or drive the enemy south"}],["$","small",null,{"children":"General-in-Chief Henry W. Halleck transmitted Lincoln’s instruction to McClellan after the president returned to Washington."}]]}]
21:["$","div","Lincoln’s October 13 letter",{"children":[["$","span",null,{"children":"Lincoln’s October 13 letter"}],["$","strong",null,{"children":"A strategic argument, explicitly not an order"}],["$","small",null,{"children":"Lincoln argued that an advance east of the Blue Ridge would threaten Lee’s communications and Richmond. He closed by stating that the letter was not an order."}]]}]
22:["$","div","Potomac crossing date",{"children":[["$","span",null,{"children":"Potomac crossing date"}],["$","strong",null,{"children":"October 26 in the National Park Service chronology"}],["$","small",null,{"children":"The transcript says the first troops crossed on October 21. The NPS Antietam timeline and McClellan’s official report place the army’s general crossing on October 26; this guide uses the documented date."}]]}]
23:["$","div","Advance into Virginia",{"children":[["$","span",null,{"children":"Advance into Virginia"}],["$","strong",null,{"children":"Through the Loudoun Valley east of the Blue Ridge"}],["$","small",null,{"children":"Lee divided his army, keeping Jackson in the Shenandoah Valley and moving Longstreet east of the Blue Ridge toward Culpeper to cover the route to Richmond."}]]}]
24:["$","div","McClellan relieved",{"children":[["$","span",null,{"children":"McClellan relieved"}],["$","strong",null,{"children":"Order issued November 5, 1862"}],["$","small",null,{"children":"Lincoln directed that McClellan be replaced by Ambrose E. Burnside. The order reached the army two days later."}]]}]
25:["$","div","Burnside’s position",{"children":[["$","span",null,{"children":"Burnside’s position"}],["$","strong",null,{"children":"He had twice declined the command before being ordered to accept it"}],["$","small",null,{"children":"Burnside doubted his ability to command so large an army but obeyed the November order."}]]}]
26:["$","div","Interpretation of McClellan",{"children":[["$","span",null,{"children":"Interpretation of McClellan"}],["$","strong",null,{"children":"The episode presents a strongly critical judgment"}],["$","small",null,{"children":"Its claims about timidity, moral responsibility, and tactical incompetence are the hosts’ interpretation. The observable record is that attacks were sequential, large reserves remained, no general attack occurred on September 18, and the new advance began only in late October."}]]}]
27:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Lincoln’s Hundred Days” by Louis P. Masur"}],["$","small",null,{"children":"The automated transcript renders the author’s surname as “Maeser.” The book’s correct title is “Lincoln’s Hundred Days: The Emancipation Proclamation and the War for the Union.”"}]]}]
28:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Harpers Ferry, Second Manassas, Culpeper, and Louis P. Masur"}],["$","small",null,{"children":"The transcript produces “Harper’s Ferry,” “Second Pole Run,” “Culpepper,” and “Louis P. Maeser.” This guide uses the standard historical forms and the author’s correct name."}]]}]
29:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
2a:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","From Antietam to the Virginia Piedmont",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep200-antietam-aftermath.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From Antietam to the Virginia Piedmont at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep200-antietam-aftermath.svg","alt":"Schematic map showing Lee’s September withdrawal through Shepherdstown and the late-October Federal advance into the Virginia Piedmont.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From Antietam to the Virginia Piedmont"}],["$","span",null,{"children":"Lee withdrew from Sharpsburg through Shepherdstown on September 18–19. McClellan remained north of the Potomac until the Army of the Potomac began crossing near Harpers Ferry and Berlin on October 26, then moved south through the Loudoun Valley. Lee kept Jackson west of the Blue Ridge and shifted Longstreet east toward Culpeper to cover Richmond. Routes and positions are generalized, and the map is not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep200-antietam-aftermath.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield timeline, McClellan’s official report, Lincoln’s October 13 letter, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Antietam’s immediate strategic consequences",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep200-strategic-consequences.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Antietam’s immediate strategic consequences at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep200-strategic-consequences.svg","alt":"Three-lane timeline linking Antietam to military, diplomatic, emancipation, and command developments from September 17 to November 5, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Antietam’s immediate strategic consequences"}],["$","span",null,{"children":"The end of Lee’s Maryland invasion produced three related developments: a United States claim of strategic victory, a setback to immediate British mediation, and Lincoln’s September 22 announcement of emancipation in areas that remained in rebellion on January 1. The command dispute continued until McClellan was relieved on November 5."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep200-strategic-consequences.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, Library of Congress, National Archives, U.S. Office of the Historian, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],"$L31"]}]]}]
2b:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The Battle of Antietam is recapped",{"className":"moment","children":[["$","$L32",null,{"seconds":197,"label":"3:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Battle of Antietam is recapped"}],["$","p",null,{"children":"The episode returns to the September 17 fighting around Sharpsburg and identifies it as the war’s bloodiest single day."}]]}]]}],["$","div","The northern and center battlefields are named",{"className":"moment","children":[["$","$L32",null,{"seconds":219,"label":"3:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The northern and center battlefields are named"}],["$","p",null,{"children":"The Cornfield, Dunker Church, and Sunken Road frame the repeated Federal attacks against Lee’s thin line."}]]}]]}],["$","div","Lee shifts troops between threatened sectors",{"className":"moment","children":[["$","$L32",null,{"seconds":250,"label":"4:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee shifts troops between threatened sectors"}],["$","p",null,{"children":"The recap emphasizes the Confederate commander’s use of interior lines to reinforce crises across the field."}]]}]]}],["$","div","The episode assesses McClellan’s tactics",{"className":"moment","children":[["$","$L32",null,{"seconds":290,"label":"4:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode assesses McClellan’s tactics"}],["$","p",null,{"children":"The hosts argue that sequential, uncoordinated attacks prevented Federal numerical superiority from becoming a decisive battlefield result."}]]}]]}],["$","div","Distance from the fighting becomes part of the critique",{"className":"moment","children":[["$","$L32",null,{"seconds":324,"label":"5:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Distance from the fighting becomes part of the critique"}],["$","p",null,{"children":"McClellan’s position east of Antietam Creek is used to support the episode’s interpretation that he did not sense the battle’s changing opportunities."}]]}]]}],["$","div","Unused Federal strength is emphasized",{"className":"moment","children":[["$","$L32",null,{"seconds":407,"label":"6:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Unused Federal strength is emphasized"}],["$","p",null,{"children":"The episode argues that another coordinated blow might have broken Lee’s line."}]]}]]}],["$","div","V Corps remains in reserve",{"className":"moment","children":[["$","$L32",null,{"seconds":422,"label":"7:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"V Corps remains in reserve"}],["$","p",null,{"children":"Most of Fitz John Porter’s corps is not committed to a general attack."}]]}]]}],["$","div","The casualty total is stated",{"className":"moment","children":[["$","$L32",null,{"seconds":440,"label":"7:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The casualty total is stated"}],["$","p",null,{"children":"The armies suffer nearly 23,000 killed, wounded, or missing during the one-day battle."}]]}]]}],["$","div","Lee remains on the field",{"className":"moment","children":[["$","$L32",null,{"seconds":464,"label":"7:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee remains on the field"}],["$","p",null,{"children":"The Army of Northern Virginia stays near Sharpsburg throughout September 18 despite its losses."}]]}]]}],["$","div","The Confederate withdrawal begins",{"className":"moment","children":[["$","$L32",null,{"seconds":472,"label":"7:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate withdrawal begins"}],["$","p",null,{"children":"Lee’s army crosses the Potomac during the night of September 18–19."}]]}]]}],["$","div","McClellan does not renew the battle",{"className":"moment","children":[["$","$L32",null,{"s