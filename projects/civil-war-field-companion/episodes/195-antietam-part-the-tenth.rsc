2a:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Directed the battle from the Pry House; ordered Sumner forward at 7:20 a.m. and Burnside to attack at 9:10 a.m."}]]}],["$","div","V Corps and army reserve-Maj. Gen. Fitz John Porter",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps and army reserve"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"Remained with McClellan near the Pry House while much of V Corps stayed east of Antietam Creek"}]]}],["$","div","II Corps-Maj. Gen. Edwin V. Sumner",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps"}],["$","span",null,{"children":"Maj. Gen. Edwin V. Sumner"}],["$","small",null,{"children":"Led Sedgwick to the West Woods while French moved toward the Sunken Road and Richardson initially remained east of the creek"}]]}],["$","div","XII Corps after Mansfield’s mortal wound-Brig. Gen. Alpheus S. Williams",{"className":"command-entry","children":[["$","strong",null,{"children":"XII Corps after Mansfield’s mortal wound"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Coordinated the surviving XII Corps units and artillery and observed Greene’s withdrawal"}]]}],["$","div","2nd Division, XII Corps-Brig. Gen. George S. Greene",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, XII Corps"}],["$","span",null,{"children":"Brig. Gen. George S. Greene"}],["$","small",null,{"children":"Repulsed Manning, advanced into the southern West Woods, requested support, and withdrew after attacks struck both flanks"}]]}],["$","div","1st Brigade, Greene’s division-Lt. Col. Hector Tyndale",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Greene’s division"}],["$","span",null,{"children":"Lt. Col. Hector Tyndale"}],["$","small",null,{"children":"28th Pennsylvania, 5th Ohio, 7th Ohio, and 66th Ohio; commanded Greene’s right during the first assault and advance"}]]}],["$","div","2nd Brigade, Greene’s division-Col. Henry J. Stainrook",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade, Greene’s division"}],["$","span",null,{"children":"Col. Henry J. Stainrook"}],["$","small",null,{"children":"111th Pennsylvania, 3rd Maryland, and 102nd New York in the episode’s advanced line"}]]}],["$","div","13th New Jersey, Williams’s division-Col. Ezra A. Carman",{"className":"command-entry","children":[["$","strong",null,{"children":"13th New Jersey, Williams’s division"}],["$","span",null,{"children":"Col. Ezra A. Carman"}],["$","small",null,{"children":"Reinforced Greene, warned that the right was exposed, and withdrew after Confederate fire struck the front and flank"}]]}],"$L32"]]}],"$L33"]}],"$L34"]]]}]
2b:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Maj. Gen. Joseph K. F. Mansfield",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. Joseph K. F. Mansfield"}],["$","p",null,{"children":[["$","strong",null,{"children":["XII Corps commander","."]}]," ","Mortally wounded earlier in the northern battle; his removal left Alpheus Williams in command of XII Corps during Greene’s fight around the church."]}]]}],["$","article","Lt. Col. Wilder Dwight",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Lt. Col. Wilder Dwight"}],["$","p",null,{"children":[["$","strong",null,{"children":["2nd Massachusetts Infantry","."]}]," ","Mortally wounded near the Hagerstown Turnpike on September 17; wrote a final postscript to his mother from the field and died September 19, 1862."]}]]}],["$","article","Col. William B. Goodrich",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. William B. Goodrich"}],["$","p",null,{"children":[["$","strong",null,{"children":["3rd Brigade, Greene’s division","."]}]," ","Killed earlier in the northern fighting while leading the detached brigade. Greene and Williams both listed his death in their Official Reports."]}]]}],["$","article","Lt. Col. Hector Tyndale",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Lt. Col. Hector Tyndale"}],["$","p",null,{"children":[["$","strong",null,{"children":["1st Brigade, Greene’s division","."]}]," ","Severely wounded near the close of the action after commanding Greene’s right brigade through the fight around the church."]}]]}],["$","article","Col. Van H. Manning",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Van H. Manning"}],["$","p",null,{"children":[["$","strong",null,{"children":["Walker’s brigade","."]}]," ","Severely wounded during the failed advance east of the West Woods and compelled to relinquish command to Colonel Edward D. Hall."]}]]}],["$","article","John Wesley Franks",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"John Wesley Franks"}],["$","p",null,{"children":[["$","strong",null,{"children":["7th South Carolina Infantry, Kershaw’s brigade","."]}]," ","Mortally wounded by Federal artillery on September 17 and died September 18, 1862; initially buried in an unmarked grave on the battlefield."]}]]}]]}]]}]
