1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",195," · ","September 17, 1862"," · ","The northern Antietam battlefield around the Dunker Church and the southern West Woods, west of the East Woods and astride the Hagerstown Turnpike near Sharpsburg, Maryland"]}],["$","h1",null,{"children":"ANTIETAM (Part the Tenth)"}],["$","span",null,{"className":"result-label","children":"At about 10 a.m., George S. Greene’s XII Corps division and supporting artillery stopped Van H. Manning’s attack east of the Dunker Church. Greene then advanced across the Hagerstown Turnpike and established a Federal line in the southern West Woods. He received the 13th New Jersey and Purnell’s Legion but incorrectly believed John Sedgwick’s division still protected his right. Confederate troops from Robert Ransom’s brigade attacked that exposed flank while John R. Cooke’s 27th North Carolina and 3rd Arkansas struck near the church. Greene’s line withdrew east, and Federal canister stopped the pursuit. The episode treats this action as the end of the sustained Federal effort against Lee’s left"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7463252797.mp3?updated=1695499533","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Command decisions and the closing fight around the Dunker Church"}],["$","small",null,{"children":"The first half compares Lee’s and McClellan’s battlefield control and recaps Sedgwick’s defeat. The second half follows Greene’s advance into and withdrawal from the West Woods."}]]}],["$","div","Confederate headquarters",{"children":[["$","span",null,{"children":"Confederate headquarters"}],["$","strong",null,{"children":"West of Sharpsburg near the Shepherdstown road"}],["$","small",null,{"children":"Lee left the headquarters area early and operated closer to the active sectors of his line. The episode contrasts this with McClellan’s position at the Pry House east of Antietam Creek."}]]}],["$","div","Lee’s reinforcement decision",{"children":[["$","span",null,{"children":"Lee’s reinforcement decision"}],["$","strong",null,{"children":"Troops moved from the Confederate right and reserve to Jackson’s left"}],["$","small",null,{"children":"John G. Walker’s division, George T. Anderson’s brigade, and much of Lafayette McLaws’s division moved north. Richard H. Anderson’s division went to D. H. Hill near the Sunken Road."}]]}],["$","div","McClellan’s command post",{"children":[["$","span",null,{"children":"McClellan’s command post"}],["$","strong",null,{"children":"The Pry House, east of Antietam Creek"}],["$","small",null,{"children":"McClellan and Fitz John Porter observed the distant battlefield from headquarters. Couriers and signal flags could not provide immediate knowledge of rapidly changing conditions."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}],"$L28","$undefined","$L29",false,"$L2a","$L2b","$L2c","$L2d","$L2e"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Sumner’s release",{"children":[["$","span",null,{"children":"Sumner’s release"}],["$","strong",null,{"children":"7:20 a.m."}],["$","small",null,{"children":"McClellan ordered II Corps toward the Federal right after the morning battle was already underway. Israel Richardson’s division was initially held east of the creek until replaced there."}]]}]
f:["$","div","Sedgwick recap",{"children":[["$","span",null,{"children":"Sedgwick recap"}],["$","strong",null,{"children":"More than 2,200 casualties in about twenty minutes"}],["$","small",null,{"children":"The episode summarizes the unsupported II Corps advance and Confederate flank attack covered in episode 194 before returning to the Dunker Church sector."}]]}]
10:["$","div","Greene’s active brigades",{"children":[["$","span",null,{"children":"Greene’s active brigades"}],["$","strong",null,{"children":"Hector Tyndale on the right; Henry J. Stainrook on the left"}],["$","small",null,{"children":"Greene’s third brigade had been detached earlier. The automated transcript renders both Greene and Stainrook inconsistently; this guide uses the historical spellings."}]]}]
11:["$","div","Manning’s assault",{"children":[["$","span",null,{"children":"Manning’s assault"}],["$","strong",null,{"children":"46th North Carolina, 30th Virginia, and 48th North Carolina"}],["$","small",null,{"children":"Colonel Van H. Manning led these regiments east from the West Woods and across the turnpike toward Greene’s line."}]]}]
12:["$","div","Federal engagement range",{"children":[["$","span",null,{"children":"Federal engagement range"}],["$","strong",null,{"children":"About 70 yards in the episode"}],["$","small",null,{"children":"Greene’s infantry waited until Manning’s line was close before firing. Captain John A. Tompkins’s First Rhode Island battery added canister."}]]}]
13:["$","div","30th Virginia loss",{"children":[["$","span",null,{"children":"30th Virginia loss"}],["$","strong",null,{"children":"160 of 230 men in the episode’s account"}],["$","small",null,{"children":"The regiment broke under concentrated infantry and artillery fire. Walker’s official report describes severe losses and says most of the regiment did not return to the battle as an organized unit."}]]}]
14:["$","div","Manning wounded",{"children":[["$","span",null,{"children":"Manning wounded"}],["$","strong",null,{"children":"Severely wounded and removed from command"}],["$","small",null,{"children":"Colonel Edward D. Hall of the 46th North Carolina succeeded Manning in command of Walker’s brigade."}]]}]
15:["$","div","Greene’s counteradvance",{"children":[["$","span",null,{"children":"Greene’s counteradvance"}],["$","strong",null,{"children":"Across the turnpike and about 200 yards into the West Woods"}],["$","small",null,{"children":"Federal troops passed the Dunker Church and occupied advanced ground along the southern edge of the woodlot."}]]}]
16:["$","div","Reinforcements for Greene",{"children":[["$","span",null,{"children":"Reinforcements for Greene"}],["$","strong",null,{"children":"13th New Jersey and Purnell’s Legion"}],["$","small",null,{"children":"These regiments came from the Cornfield and East Woods and extended Greene’s right. The episode places Greene’s force at about 1,350 men after their arrival."}]]}]
17:["$","div","Ezra A. Carman",{"children":[["$","span",null,{"children":"Ezra A. Carman"}],["$","strong",null,{"children":"Colonel of the 13th New Jersey and later Antietam historian"}],["$","small",null,{"children":"Carman later collected veteran testimony and prepared the Antietam Battlefield Board’s detailed maps and historical work."}]]}]
18:["$","div","Ammunition shortage",{"children":[["$","span",null,{"children":"Ammunition shortage"}],["$","strong",null,{"children":"5th and 7th Ohio withdrew from the advanced line"}],["$","small",null,{"children":"The 13th New Jersey and Purnell’s Legion moved into positions vacated when the Ohio regiments fell back across the turnpike."}]]}]
19:["$","div","Federal line in the woods",{"children":[["$","span",null,{"children":"Federal line in the woods"}],["$","strong",null,{"children":"13th New Jersey and Purnell’s Legion on the exposed right"}],["$","small",null,{"children":"The 28th Pennsylvania connected them to the 111th Pennsylvania, 3rd Maryland, and 102nd New York farther left."}]]}]
1a:["$","div","Critical command error",{"children":[["$","span",null,{"children":"Critical command error"}],["$","strong",null,{"children":"Greene believed Sedgwick protected his right"}],["$","small",null,{"children":"Sedgwick’s division had already been routed. Greene did not learn this until a member of Sumner’s staff told him that the division was gone."}]]}]
1b:["$","div","Northern flank attack",{"children":[["$","span",null,{"children":"Northern flank attack"}],["$","strong",null,{"children":"49th North Carolina from Ransom’s brigade"}],["$","small",null,{"children":"The regiment surprised Purnell’s Legion and struck the 13th New Jersey’s flank. The episode attributes the movement to “Matthew W. Ransom”; the brigade commander was Brigadier General Robert Ransom Jr."}]]}]
1c:["$","div","Southern attack",{"children":[["$","span",null,{"children":"Southern attack"}],["$","strong",null,{"children":"27th North Carolina and 3rd Arkansas under John R. Cooke"}],["$","small",null,{"children":"Cooke’s two regiments attacked a Federal two-gun section going into battery near the church as Greene’s infantry line began to give way."}]]}]
1d:["$","div","Captured artillery",{"children":[["$","span",null,{"children":"Captured artillery"}],["$","strong",null,{"children":"One Federal gun left near the church"}],["$","small",null,{"children":"Alpheus Williams’s official report states that one piece from a temporarily detached section of Knap’s battery had to be abandoned after men and horses were lost."}]]}]
1e:["$","div","Pursuit stopped",{"children":[["$","span",null,{"children":"Pursuit stopped"}],["$","strong",null,{"children":"Three or four Federal batteries fired canister"}],["$","small",null,{"children":"The artillery line east of the turnpike stopped Ransom’s and Cooke’s troops and forced them back toward the West Woods."}]]}]
1f:["$","div","Chronology differs among accounts",{"children":[["$","span",null,{"children":"Chronology differs among accounts"}],["$","strong",null,{"children":"The episode compresses Greene’s final withdrawal into the late-morning close"}],["$","small",null,{"children":"Greene reported holding the woods near the church for nearly two hours. The Battlefield Board tablet places Tyndale there until noon, while Williams’s report places the forced retirement at about 1:30 p.m."}]]}]
20:["$","div","Northern-field strength",{"children":[["$","span",null,{"children":"Northern-field strength"}],["$","strong",null,{"children":"About 23,000 Federal and just over 18,000 Confederate troops"}],["$","small",null,{"children":"These are the episode’s aggregate figures for the five-hour fight north of the Sunken Road, not the strength in Greene’s final position."}]]}]
21:["$","div","Northern-field casualties",{"children":[["$","span",null,{"children":"Northern-field casualties"}],["$","strong",null,{"children":"About 6,550 Federal and 7,300 Confederate"}],["$","small",null,{"children":"The episode totals nearly 14,000 killed, wounded, or missing in the northern fighting. NPS estimates for the Cornfield and West Woods are approximate and use somewhat different geographic groupings."}]]}]
22:["$","div","Highest division loss",{"children":[["$","span",null,{"children":"Highest division loss"}],["$","strong",null,{"children":"Sedgwick’s division lost about one man in three"}],["$","small",null,{"children":"The episode identifies Sedgwick’s II Corps division as the most heavily damaged Federal division in this portion of the battle."}]]}]
23:["$","div","Highest cited brigade rate",{"children":[["$","span",null,{"children":"Highest cited brigade rate"}],["$","strong",null,{"children":"William T. Wofford’s brigade lost about 64 percent"}],["$","small",null,{"children":"Wofford’s Texans and Georgians had fought earlier around the Cornfield and West Woods."}]]}]
24:["$","div","Wilder Dwight",{"children":[["$","span",null,{"children":"Wilder Dwight"}],["$","strong",null,{"children":"Mortally wounded; died September 19"}],["$","small",null,{"children":"The episode says Dwight died the next day. Contemporary biographical evidence places his death at midday on September 19, two days after he was wounded."}]]}]
25:["$","div","John Wesley Franks",{"children":[["$","span",null,{"children":"John Wesley Franks"}],["$","strong",null,{"children":"Mortally wounded; died September 18"}],["$","small",null,{"children":"The 7th South Carolina soldier was hit by Federal artillery and buried on the field by his brother-in-law John Lewis Wilhite."}]]}]
26:["$","div","Recommended work",{"children":[["$","span",null,{"children":"Recommended work"}],["$","strong",null,{"children":"Ezra A. Carman’s Maryland Campaign study, edited by Thomas G. Clemens"}],["$","small",null,{"children":"The episode recommends volume two of the three-volume edition for its coverage of the Battle of Antietam."}]]}]
27:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Greene, George T. Anderson, McLaws, Pry House, Stainrook, Purnell’s Legion, Carman, and Cooke"}],["$","small",null,{"children":"The automated transcript includes forms such as “Green,” “Tige Anderson,” “McClaws,” “Pernell,” “Carmen,” and “Cook.” This guide uses standard historical spellings."}]]}]
28:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
29:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Manning’s assault and Greene’s counteradvance",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep195-manning-assault.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Manning’s assault and Greene’s counteradvance at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep195-manning-assault.svg","alt":"Schematic map showing Manning’s three Confederate regiments charging east from the West Woods across the turnpike toward Greene’s two Federal brigades, followed by Greene’s counteradvance west.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Manning’s assault and Greene’s counteradvance"}],["$","span",null,{"children":"Van H. Manning led the 46th and 48th North Carolina and 30th Virginia east from the West Woods and across the Hagerstown Turnpike. Greene’s brigades waited until the Confederates were close, then infantry fire and canister from Tompkins’s battery broke the attack. Greene pursued across the turnpike, past the Dunker Church, and into the woods. Routes and positions are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep195-manning-assault.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"John G. Walker’s and George S. Greene’s Official Reports, Antietam Battlefield Board tablets and atlas, National Park Service Antietam material, and the episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Greene’s foothold attacked on both flanks",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep195-greene-envelopment.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Greene’s foothold attacked on both flanks at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep195-greene-envelopment.svg","alt":"Schematic map showing Greene’s Federal line in the southern West Woods struck on its right by the 49th North Carolina and near the Dunker Church by the 27th North Carolina and 3rd Arkansas.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Greene’s foothold attacked on both flanks"}],["$","span",null,{"children":"Greene’s reduced line extended through the southern West Woods with the 13th New Jersey and Purnell’s Legion on its exposed right. The 49th North Carolina attacked from the north while John R. Cooke’s 27th North Carolina and 3rd Arkansas attacked the Federal guns near the church from the south. Greene withdrew east, and Federal batteries stopped the pursuit with canister. Routes and positions are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep195-greene-envelopment.svg","target":"_blank","rel":"noreferrer","