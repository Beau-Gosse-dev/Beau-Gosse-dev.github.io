33:["$","section","Confederacy",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Shifted Walker, George T. Anderson, and McLaws north toward Jackson while sending Richard H. Anderson toward D. H. Hill"}]]}],["$","div","Confederate left wing-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate left wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Received reinforcements from the army’s right and reserve during the crisis around the West Woods"}]]}],["$","div","Walker’s division-Brig. Gen. John G. Walker",{"className":"command-entry","children":[["$","strong",null,{"children":"Walker’s division"}],["$","span",null,{"children":"Brig. Gen. John G. Walker"}],["$","small",null,{"children":"Moved from the Confederate right after 9 a.m. and committed his two brigades in and around the West Woods"}]]}],["$","div","Walker’s brigade-Col. Van H. Manning",{"className":"command-entry","children":[["$","strong",null,{"children":"Walker’s brigade"}],["$","span",null,{"children":"Col. Van H. Manning"}],["$","small",null,{"children":"Led the 46th and 48th North Carolina and 30th Virginia across the turnpike; wounded and succeeded by Col. Edward D. Hall"}]]}],["$","div","Ransom’s brigade, Walker’s division-Brig. Gen. Robert Ransom Jr.",{"className":"command-entry","children":[["$","strong",null,{"children":"Ransom’s brigade, Walker’s division"}],["$","span",null,{"children":"Brig. Gen. Robert Ransom Jr."}],["$","small",null,{"children":"Held the southern West Woods and sent the 49th North Carolina against Greene’s exposed right flank"}]]}],["$","div","49th North Carolina-Lt. Col. Leroy M. McAfee",{"className":"command-entry","children":[["$","strong",null,{"children":"49th North Carolina"}],["$","span",null,{"children":"Lt. Col. Leroy M. McAfee"}],["$","small",null,{"children":"Led the regiment that struck Purnell’s Legion and the 13th New Jersey from the north"}]]}],["$","div","27th North Carolina and 3rd Arkansas detachment-Col. John R. Cooke",{"className":"command-entry","children":[["$","strong",null,{"children":"27th North Carolina and 3rd Arkansas detachment"}],["$","span",null,{"children":"Col. John R. Cooke"}],["$","small",null,{"children":"Attacked the Federal two-gun section near the Dunker Church and joined the pursuit of Greene"}]]}],["$","div","McLaws’s division-Maj. Gen. Lafayette McLaws",{"className":"command-entry","children":[["$","strong",null,{"children":"McLaws’s division"}],["$","span",null,{"children":"Maj. Gen. Lafayette McLaws"}],["$","small",null,{"children":"Moved north from Harpers Ferry and reinforced the Confederate counterattack against Sedgwick"}]]}],["$","div","Anderson’s division-Maj. Gen. Richard H. Anderson",{"className":"command-entry","children":[["$","strong",null,{"children":"Anderson’s division"}],["$","span",null,{"children":"Maj. Gen. Richard H. Anderson"}],["$","small",null,{"children":"Moved toward the center of Lee’s line to support D. H. Hill along the Sunken Road"}]]}]]]}]
