1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",208," · ","August 29–30, 1862, with aftermath through September 29, 1862"," · ","The Old State Road corridor from Big Hill and Kingston through Mount Zion Church and Rogersville to Richmond, Madison County, Kentucky"]}],["$","h1",null,{"children":"BATTLE OF RICHMOND (KENTUCKY)"}],["$","span",null,{"className":"result-label","children":"Decisive Confederate victory. Edmund Kirby Smith’s veterans broke three United States positions on August 30, and John S. Scott’s cavalry blocked the road north, turning a retreat into a mass capture. The victory opened Lexington and Frankfort to Smith, but it did not produce the large, immediate recruiting surge Confederate leaders expected or decide the wider Kentucky campaign"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2300445688.mp3?updated=1695589065","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Kirby Smith’s advance and the Battle of Richmond, Kentucky"}],["$","small",null,{"children":"The narrative begins with the divided Confederate invasion, follows the August 29 approach and all three stages of the August 30 battle, and closes with the occupation of Lexington and Frankfort and William Nelson’s death."}]]}],["$","div","Battle dates",{"children":[["$","span",null,{"children":"Battle dates"}],["$","strong",null,{"children":"August 29–30, 1862"}],["$","small",null,{"children":"Cavalry and artillery skirmishing occurred on August 29. The decisive infantry battle took place on Saturday, August 30."}]]}],["$","div","Campaign",{"children":[["$","span",null,{"children":"Campaign"}],["$","strong",null,{"children":"Confederate Heartland Offensive"}],["$","small",null,{"children":"Kirby Smith advanced independently from East Tennessee while Braxton Bragg moved on a separate axis from Chattanooga toward central Kentucky."}]]}],["$","div","Strategic consequence",{"children":[["$","span",null,{"children":"Strategic consequence"}],["$","strong",null,{"children":"Buell’s Chattanooga advance was outflanked"}],["$","small",null,{"children":"Bragg’s northward movement forced Maj. Gen. Don Carlos Buell to turn the Army of the Ohio back toward Kentucky while Kirby Smith operated farther east."}]]}],["$","div","United States reorganization",{"children":[["$","span",null,{"children":"United States reorganization"}],["$","strong",null,{"children":"Maj. Gen. Horatio G. Wright took the reorganized Department of the Ohio"}],["$","small",null,{"children":"The department sent recently raised Indiana and Ohio regiments toward Lexington as the Confederate advance developed."}]]}],["$","div","Command change at Lexington",{"children":[["$","span",null,{"children":"Command change at Lexington"}],["$","strong",null,{"children":"Maj. Gen. William “Bull” Nelson replaced Lew Wallace on August 24"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}],"$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}]]}]
30:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"Wallace favored defending the Kentucky River crossings. Nelson instead pushed part of the force south to Richmond and placed other troops near Lancaster and Danville."}]
f:["$","div","A divided defense",{"children":[["$","span",null,{"children":"A divided defense"}],["$","strong",null,{"children":"Richmond, Lexington, Lancaster, and Danville"}],["$","small",null,{"children":"Nelson intended the western detachments to threaten Smith’s flank, but the dispersion left the two brigades at Richmond isolated when Smith concentrated against them."}]]}]
10:["$","div","Inexperienced regiments",{"children":[["$","span",null,{"children":"Inexperienced regiments"}],["$","strong",null,{"children":"Some had served only 10 to 25 days"}],["$","small",null,{"children":"Mahlon Manson reported that several regiments had not conducted battalion drill and did not know how to form a line of battle."}]]}]
11:["$","div","Forces described in the episode",{"children":[["$","span",null,{"children":"Forces described in the episode"}],["$","strong",null,{"children":"About 6,700 Confederates against about 7,500 United States troops"}],["$","small",null,{"children":"The episode estimates Smith’s force at 5,500 infantry and 1,200 cavalry and Manson’s at 6,500 infantry and 1,000 cavalry. Published totals vary with the units counted."}]]}]
12:["$","div","Central imbalance",{"children":[["$","span",null,{"children":"Central imbalance"}],["$","strong",null,{"children":"Confederate veterans against newly raised United States troops"}],["$","small",null,{"children":"The armies were broadly comparable in number, but Cleburne’s and Churchill’s infantry had substantially more field experience."}]]}]
13:["$","div","Big Hill warning",{"children":[["$","span",null,{"children":"Big Hill warning"}],["$","strong",null,{"children":"Scott routed a United States wagon escort on August 23"}],["$","small",null,{"children":"The Confederate cavalry captured a wagon train bound for Cumberland Gap, approached Richmond, and reported that raw troops guarded the route to Lexington."}]]}]
14:["$","div","Communication failure",{"children":[["$","span",null,{"children":"Communication failure"}],["$","strong",null,{"children":"No telegraph connected Richmond and Lexington"}],["$","small",null,{"children":"A cavalry report of Smith’s concentration took about sixteen hours to reach Nelson after he left Richmond for Lexington."}]]}]
15:["$","div","Orders left at Richmond",{"children":[["$","span",null,{"children":"Orders left at Richmond"}],["$","strong",null,{"children":"Manson was told to remain, not to join Nelson’s planned western concentration"}],["$","small",null,{"children":"Nelson later sent an order to avoid battle and move toward Lancaster, but it took about ten hours to arrive and reached Manson only after the first position had collapsed."}]]}]
16:["$","div","Hard Confederate approach",{"children":[["$","span",null,{"children":"Hard Confederate approach"}],["$","strong",null,{"children":"Three days through the Barrens in heat and drought"}],["$","small",null,{"children":"Smith’s infantry reached the Big Hill area after a punishing march and encountered more local hostility than the expected welcome as liberators."}]]}]
17:["$","div","August 29 position",{"children":[["$","span",null,{"children":"August 29 position"}],["$","strong",null,{"children":"White’s Farm, north of Mount Zion Church"}],["$","small",null,{"children":"After pushing back Scott’s cavalry and exchanging artillery fire, Manson camped astride the road about five and a half miles south of Richmond."}]]}]
18:["$","div","First stage",{"children":[["$","span",null,{"children":"First stage"}],["$","strong",null,{"children":"Mount Zion Church and White’s Farm"}],["$","small",null,{"children":"Cleburne attacked east of the road while Thomas H. McCray’s brigade of Churchill’s division used concealed ground west of the road to strike the thin United States right."}]]}]
19:["$","div","Manson’s critical redeployment",{"children":[["$","span",null,{"children":"Manson’s critical redeployment"}],["$","strong",null,{"children":"Seven companies shifted away from the United States right"}],["$","small",null,{"children":"Concerned about his left, Manson moved the 71st Indiana and most of the 69th Indiana east of the road, leaving only three companies to meet McCray’s attack in the west."}]]}]
1a:["$","div","A two-flank collapse",{"children":[["$","span",null,{"children":"A two-flank collapse"}],["$","strong",null,{"children":"McCray struck the right while Arkansas troops enfiladed the left"}],["$","small",null,{"children":"The terrain screened Churchill’s advance through a creek bottom, cornfield, and ravine. On the opposite flank, troops under Lucius E. Polk swung around the United States line."}]]}]
1b:["$","div","Cleburne wounded",{"children":[["$","span",null,{"children":"Cleburne wounded"}],["$","strong",null,{"children":"Shot through the left cheek and mouth"}],["$","small",null,{"children":"The wound damaged teeth and temporarily prevented him from speaking. Col. Preston Smith assumed command of Cleburne’s division during the pursuit."}]]}]
1c:["$","div","Cruft’s arrival",{"children":[["$","span",null,{"children":"Cruft’s arrival"}],["$","strong",null,{"children":"The 95th Ohio and 18th Kentucky entered a collapsing fight"}],["$","small",null,{"children":"The 18th Kentucky formed a temporary rallying line and helped prevent the first withdrawal from immediately becoming a rout."}]]}]
1d:["$","div","Second stage",{"children":[["$","span",null,{"children":"Second stage"}],["$","strong",null,{"children":"A new line roughly two miles to the rear"}],["$","small",null,{"children":"The 12th and 66th Indiana anchored Cruft west of the road while Manson rallied troops to the east. A close-range counterattack failed after McCray’s men rose from cover behind an overgrown fence."}]]}]
1e:["$","div","Third stage",{"children":[["$","span",null,{"children":"Third stage"}],["$","strong",null,{"children":"Richmond Cemetery and the southern edge of town"}],["$","small",null,{"children":"Nelson arrived and tried to steady a final line. After about an hour of Confederate rest, Churchill and Preston Smith attacked and broke it."}]]}]
1f:["$","div","Nelson wounded",{"children":[["$","span",null,{"children":"Nelson wounded"}],["$","strong",null,{"children":"Hit in the leg by two spent balls"}],["$","small",null,{"children":"He was helped back onto his horse, ordered a rear guard, and later escaped after hiding in a cornfield."}]]}]
20:["$","div","Scott closes the trap",{"children":[["$","span",null,{"children":"Scott closes the trap"}],["$","strong",null,{"children":"Confederate cavalry cut the Lexington road north of Richmond"}],["$","small",null,{"children":"The infantry was too exhausted to continue a rapid pursuit, but Scott’s earlier wide movement placed his cavalry across the retreat and led to mass surrenders."}]]}]
21:["$","div","United States losses in the NPS table",{"children":[["$","span",null,{"children":"United States losses in the NPS table"}],["$","strong",null,{"children":"206 killed, 844 wounded, 4,303 captured or missing"}],["$","small",null,{"children":"The total is 5,353. The episode rounds the last category to 4,300; other modern summaries use different estimated totals."}]]}]
22:["$","div","Confederate losses reported in the episode",{"children":[["$","span",null,{"children":"Confederate losses reported in the episode"}],["$","strong",null,{"children":"98 killed, 492 wounded, 8 missing"}],["$","small",null,{"children":"The total is 598, a small fraction of the United States loss and a measure of the victory’s lopsided character."}]]}]
23:["$","div","Immediate aftermath",{"children":[["$","span",null,{"children":"Immediate aftermath"}],["$","strong",null,{"children":"Lexington occupied September 2; Frankfort occupied September 4"}],["$","small",null,{"children":"Smith paused to rest his army and parole prisoners before continuing north. Frankfort was the only capital of a loyal state captured by a Confederate army."}]]}]
24:["$","div","Recruiting expectation",{"children":[["$","span",null,{"children":"Recruiting expectation"}],["$","strong",null,{"children":"The predicted mass uprising did not materialize"}],["$","small",null,{"children":"Crowds welcomed Smith in Lexington, but enthusiasm in occupied towns did not translate into the tens of thousands of new soldiers Confederate leaders had anticipated."}]]}]
25:["$","div","Nelson’s later death",{"children":[["$","span",null,{"children":"Nelson’s later death"}],["$","strong",null,{"children":"Shot by Brig. Gen. Jefferson C. Davis on September 29, 1862"}],["$","small",null,{"children":"The killing at Louisville’s Galt House followed a personal confrontation and was not a battlefield wound, although the episode presents it as a grim coda to Richmond."}]]}]
26:["$","div","Transcript corrections",{"children":[["$","span",null,{"children":"Transcript corrections"}],["$","strong",null,{"children":"Mahlon Manson; Charles Cruft; Patrick Cleburne; Thomas McCray; Frankfort"}],["$","small",null,{"children":"The automated transcript variously gives “Maylon” or “Malin” Manson, “Kraft,” “Cruff,” or “Croft” for Cruft, “Claiborne” for Cleburne, “McCrae” for McCray, and “Frankfurt” for Kentucky’s capital. “Fainted” should be “feinted,” and Smith rested—not arrested—his men on August 31."}]]}]
27:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"When the Ripe Pears Fell: The Battle of Richmond, Kentucky"}],["$","small",null,{"children":"D. Warren Lambert’s study was published by the Madison County Historical Society. The transcript incorrectly renders the title as “When the Right Pairs Fell.”"}]]}]
28:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
29:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Three stages of the Battle of Richmond",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep208-battle-of-richmond-map.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Three stages of the Battle of Richmond at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep208-battle-of-richmond-map.svg","alt":"North-up schematic map showing three United States defensive positions south of Richmond, Confederate attacks north along the Old State Road, and Scott’s cavalry circling to block the Lexington road.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Three stages of the Battle of Richmond"}],["$","span",null,{"children":"Schematic north-up map of the August 30 action along the Old State Road. Smith’s infantry drove the United States brigades from Mount Zion and White’s Farm to a second position near their former bivouac and then to Richmond Cemetery. Scott’s cavalry made a wide movement east and north of town to block the Lexington road. Distances and unit footprints are simplified."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep208-battle-of-richmond-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Custom diagram based on the National Park Service battle summary, the Kentucky Historical Society route marker, and the Official Records; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$29:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Kirby Smith is already advancing in Kentucky",{"className":"moment","children":[["$","$L30",null,{"seconds":70,"label":"1:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kirby Smith is already advancing in Kentucky"}],["$","p",null,{"children":"Bragg’s artillery and wagons delayed his own movement from Chattanooga, leaving two independent Confederate armies difficult to coordinate."}]]}]]}],["$","div","Bragg moves north and outflanks Buell",{"className":"moment","children":[["$","$L30",null,{"seconds":118,"label":"1:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg moves north and outflanks Buell"}],["$","p",null,{"children":"Bragg feinted toward Nashville and then followed the Louisville and Nashville Railroad into Kentucky, forcing Buell to abandon the direct advance on Chattanooga."}]]}]]}],["$","div","The Department of the Ohio reacts",{"className":"moment","children":[["$","$L30",null,{"seconds":147,"label":"2:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Department of the Ohio reacts"}],["$","p",null,{"children":"General in chief Henry Halleck reorganized the department under Horatio Wright as newly raised troops concentrated around Lexington."}]]}]]}],["$","div","Bull Nelson replaces Lew Wallace",{"className":"moment","children":[["$","$L30",null,{"seconds":175,"label":"2:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bull Nelson replaces Lew Wallace"}],["$","p",null,{"children":"Nelson arrived at Lexington on August 24, took command, and rejected Wallace’s plan to hold the Kentucky River line."}]]}]]}],["$","div","Nelson pushes troops south of the river",{"className":"moment","children":[["$","$L30",null,{"seconds":217,"label":"3:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nelson pushes troops south of the river"}],["$","p",null,{"children":"He sent part of the force to Richmond and placed other detachments near Lancaster and Danville, hoping to threaten Smith’s flank."}]]}]]}],["$","div","Two brigades form at Richmond",{"className":"moment","children":[["$","$L30",null,{"seconds":271,"label":"4:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two brigades form at Richmond"}],["$","p",null,{"children":"Eight regiments were organized under Mahlon Manson and Charles Cruft, with Manson commanding the force at Richmond."}]]}]]}],["$","div","Comparable numbers conceal unequal experience",{"className":"moment","children":[["$","$L30",null,{"seconds":328,"label":"5:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Comparable numbers conceal unequal experience"}],["$","p",null,{"children":"Smith had about 5,500 infantry and 1,200 cavalry; Manson about 6,500 infantry and 1,000 cavalry. Most of Smith’s men were veterans."}]]}]]}],["$","div","Scott’s cavalry opens the approach",{"className":"moment","children":[["$","$L30",null,{"seconds":370,"label":"6:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Scott’s cavalry opens the approach"}],["$","p",null,{"children":"The episode returns to the August 23 fight at Big Hill, where Confederate cavalry captured a supply train and routed its inexperienced escort."}]]}]]}],["$","div","A warning is delayed",{"className":"moment","children":[["$","$L30",null,{"seconds":430,"label":"7:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"A warning is delayed"}],["$","p",null,{"children":"Because Nelson had left Richmond and there was no telegraph to Lexington, news of Smith’s concentration took about sixteen hours to reach him."}]]}]]}],["$","div","Manson does not receive Nelson’s larger plan",{"className":"moment","children":[["$","$L30",null,{"seconds":501,"label":"8:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Manson does not receive Nelson’s larger plan"}],["$","p",null,{"children":"Nelson left Manson instructions to remain at Richmond rather than move west to join the intended concentration near Lancaster."}]]}]]}],["$","div","Smith learns that Richmond is blocked",{"className":"moment","children":["$L31","$L32"]}],"$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51","$L52","$L53"]}]]}]
2b:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States — Department and Army of Kentucky",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States — Department and Army of Kentucky"}],[["$","div","Department of the Ohio",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Ohio"}],["$","span",null,{"children":"Maj. Gen. Horatio G. Wright"}],["$","small",null,{"children":"Directed the emergency defense of the region and sent newly raised troops toward Lexington."}]]}],["$","div","Army of Kentucky",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Kentucky"}],["$","span",null,{"children":"Maj. Gen. William “Bull” Nelson"}],["$","small",null,{"children":"Superseded Lew Wallace at Lexington, dispersed the available force south of the Kentucky River, and took command of the final position at Richmond."}]]}],["$","div","1st Brigade; field commander at Richmond",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade; field commander at Richmond"}],["$","span",null,{"children":"Brig. Gen. Mahlon D. Manson"}],["$","small",null,{"children":"16th, 55th, 69th, and 71st Indiana Infantry with artillery; held the initial line near Mount Zion and commanded east of the road at the second line."}]]}],["$","div","2nd Brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade"}],["$","span",null,{"children":"Brig. Gen. Charles Cruft"}],["$","small",null,{"children":"12th and 66th Indiana, 18th Kentucky, and 95th Ohio Infantry with artillery; reinforced Manson and held west of the road at the second line."}]]}],["$","div","United States cavalry detachment",{"className":"command-entry","children":[["$","strong",null,{"children":"United States cavalry detachment"}],["$","span",null,{"children":"Lt. Col. Reuben Munday"}],["$","small",null,{"children":"Observed the Confederate concentration around Big Hill and was driven north during the August 29 approach."}]]}]]]}],["$","section","Confederacy — Army of Kentucky",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy — Army of Kentucky"}],[["$","div","Army of Kentucky",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Kentucky"}],["$","span",null,{"children":"Maj. Gen. Edmund Kirby Smith"}],["$","small",null,{"children":"Concentrated Cleburne and Churchill against Richmond, directed the three-stage attack, and sent Scott around the United States rear."}]]}],["$","div","Cleburne’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Cleburne’s division"}],["$","span",null,{"children":"Brig. Gen. Patrick R. Cleburne"}],["$","small",null,{"children":"Led the advance and the attack east of the road; Col. Benjamin J. Hill and Col. Preston Smith commanded his brigades. Preston Smith took divisional command after Cleburne was wounded."}]]}],["$","div","Churchill’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Churchill’s division"}],["$","span",null,{"children":"Brig. Gen. Thomas J. Churchill"}],["$","small",null,{"children":"Reinforced Cleburne and attacked west of the road; Col. Thomas H. McCray led the brigade that broke the United States right."}]]}],["$","div","13th and 15th Arkansas Infantry",{"className":"command-entry","children":[["$","strong",null,{"children":"13th and 15th Arkansas Infantry"}],["$","span",null,{"children":"Col. Lucius E. Polk"}],["$","small",null,{"children":"Maneuvered on the Confederate right and helped enfilade the United States left before being wounded."}]]}],["$","div","Cavalry brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry brigade"}],["$","span",null,{"children":"Col. John S. Scott"}],"$L54"]}]]]}]]}],"$L55","$L56"]}]
2c:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. Edward Fitzgerald",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Edward Fitzgerald"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 154th Tennessee Infantry","."]}]," ","Shot in the head and killed during the regiment’s advance against the first United States position near Mount Zion Church."]}]]}],["$","article","Brig. Gen. Patrick R. Cleburne",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Patrick R. Cleburne"}],["$","p",null,{"children":[["$","strong",null,{"children":["Division commander","."]}]," ","Wounded through the left cheek and mouth during the pursuit from the first position; survived and returned to command."]}]]}],["$","article","Col. Lucius E. Polk",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Lucius E. Polk"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 13th and 15th Arkansas Infantry","."]}]," ","Wounded during the first-stage fighting after his troops helped turn the United States left; survived."]}]]}],["$","article","Maj. Gen. William “Bull” Nelson",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. William “Bull” Nelson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Army of Kentucky","."]}]," ","Struck in the leg by two spent balls during the final stand and escaped. On September 29, 1862, Brig. Gen. Jefferson C. Davis fatally shot him in an unrelated confrontation at Louisville’s Galt House."]}]]}]]}]]}]
2d:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep208-battle-of-richmond-map.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep208-battle-of-richmond-map.svg","alt":"North-up schematic map of the three-stage Battle of Richmond and Scott’s cavalry movement to the Lexington road.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The battle moved steadily north. Three successive United States lines failed before Scott’s cavalry closed the road beyond Richmond and captured much of the retreating force."}]]}],["$","figure","/images/ep208-edmund-kirby-smith.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep208-edmund-kirby-smith.jpg","alt":"Wartime glass-negative portrait of Confederate Maj. Gen. Edmund Kirby Smith in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Edmund Kirby Smith commanded the independent Confederate Army of Kentucky. His victory at Richmond opened the route to Lexington and Frankfort."}]]}],["$","figure","/images/ep208-patrick-cleburne.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep208-patrick-cleburne.jpg","alt":"Engraved head-and-shoulders portrait of Confederate Maj. Gen. Patrick R. Cleburne facing left.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Patrick R. Cleburne led Smith’s advance and the initial attack. A bullet passed through his cheek and mouth as the first United States line collapsed."}]]}]]}]]}]
