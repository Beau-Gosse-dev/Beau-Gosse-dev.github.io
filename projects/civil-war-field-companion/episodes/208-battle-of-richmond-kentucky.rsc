2f:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
31:["$","$L30",null,{"seconds":521,"label":"8:41"}]
32:["$","div",null,{"children":[["$","h3",null,{"children":"Smith learns that Richmond is blocked"}],["$","p",null,{"children":"Scott reported a substantial United States force ahead. Smith ordered Cleburne and Churchill north after their hard march through the Barrens."}]]}]
33:["$","div","United States cavalry falls back on August 29",{"className":"moment","children":[["$","$L30",null,{"seconds":589,"label":"9:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States cavalry falls back on August 29"}],["$","p",null,{"children":"Manson learned that Reuben Munday’s detachment was being driven north with thousands of Confederates close behind."}]]}]]}]
34:["$","div","Manson advances to meet the threat",{"className":"moment","children":[["$","$L30",null,{"seconds":611,"label":"10:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Manson advances to meet the threat"}],["$","p",null,{"children":"He chose favorable hills south of his camp rather than wait to be attacked and moved his brigade forward while Cruft remained in reserve."}]]}]]}]
35:["$","div","The armies bivouac near Mount Zion",{"className":"moment","children":[["$","$L30",null,{"seconds":644,"label":"10:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies bivouac near Mount Zion"}],["$","p",null,{"children":"After skirmishing and artillery fire, Manson’s brigade camped at White’s Farm north of Mount Zion Church."}]]}]]}]
36:["$","div","The August 30 battle begins",{"className":"moment","children":[["$","$L30",null,{"seconds":723,"label":"12:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The August 30 battle begins"}],["$","p",null,{"children":"As Second Manassas reached its climax in Virginia, Smith ordered Patrick Cleburne to attack south of Richmond."}]]}]]}]
37:["$","div","Manson deploys astride the road",{"className":"moment","children":[["$","$L30",null,{"seconds":769,"label":"12:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Manson deploys astride the road"}],["$","p",null,{"children":"His brigade formed near Mount Zion Church, with the 55th and 16th Indiana on the left, the 69th on the right, artillery in the center, and the 71st in reserve."}]]}]]}]
38:["$","div","Smith waits for Churchill",{"className":"moment","children":[["$","$L30",null,{"seconds":830,"label":"13:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith waits for Churchill"}],["$","p",null,{"children":"Smith delayed Cleburne’s attack until Churchill could strike the United States right while Benjamin Hill’s brigade threatened the left."}]]}]]}]
39:["$","div","Manson strips his right",{"className":"moment","children":[["$","$L30",null,{"seconds":869,"label":"14:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Manson strips his right"}],["$","p",null,{"children":"Fearing an attack on his left, he shifted the 71st Indiana and seven companies of the 69th Indiana east of the road."}]]}]]}]
3a:["$","div","The 154th Tennessee advances",{"className":"moment","children":[["$","$L30",null,{"seconds":900,"label":"15:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 154th Tennessee advances"}],["$","p",null,{"children":"Cleburne moved the regiment forward on the Confederate right as the fight intensified across the first line."}]]}]]}]
3b:["$","div","Col. Edward Fitzgerald is killed",{"className":"moment","children":[["$","$L30",null,{"seconds":940,"label":"15:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Col. Edward Fitzgerald is killed"}],["$","p",null,{"children":"The commander of the 154th Tennessee was shot in the head during its advance and died on the field."}]]}]]}]
3c:["$","div","McCray strikes the exposed right",{"className":"moment","children":[["$","$L30",null,{"seconds":1011,"label":"16:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCray strikes the exposed right"}],["$","p",null,{"children":"Churchill’s men used a creek bottom, cornfield, and ravine to approach unseen before overwhelming the three remaining companies of the 69th Indiana."}]]}]]}]
3d:["$","div","The United States left is enfiladed",{"className":"moment","children":[["$","$L30",null,{"seconds":1025,"label":"17:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"The United States left is enfiladed"}],["$","p",null,{"children":"Arkansas troops under Lucius Polk swung around the opposite flank, placing effective fire along Manson’s line."}]]}]]}]
3e:["$","div","Cleburne is wounded",{"className":"moment","children":[["$","$L30",null,{"seconds":1042,"label":"17:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cleburne is wounded"}],["$","p",null,{"children":"A bullet passed through his cheek and mouth as he prepared to pursue; Preston Smith assumed divisional command."}]]}]]}]
3f:["$","div","The 18th Kentucky checks the pursuit",{"className":"moment","children":[["$","$L30",null,{"seconds":1114,"label":"18:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 18th Kentucky checks the pursuit"}],["$","p",null,{"children":"Cruft’s regiment formed a temporary rallying line for the broken 95th Ohio and Manson’s retreating units before suffering heavy losses and withdrawing."}]]}]]}]
40:["$","div","A second United States line forms",{"className":"moment","children":[["$","$L30",null,{"seconds":1152,"label":"19:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"A second United States line forms"}],["$","p",null,{"children":"The 12th and 66th Indiana anchored Cruft west of the road while Manson gathered men on the east side about two miles to the rear."}]]}]]}]
41:["$","div","Nelson’s order finally arrives",{"className":"moment","children":[["$","$L30",null,{"seconds":1171,"label":"19:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nelson’s order finally arrives"}],["$","p",null,{"children":"The courier brought instructions to avoid battle and march west to Lancaster after the first position had already been lost."}]]}]]}]
42:["$","div","The second stage begins",{"className":"moment","children":[["$","$L30",null,{"seconds":1223,"label":"20:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"The second stage begins"}],["$","p",null,{"children":"McCray advanced west of the road and Preston Smith east of it against the re-formed United States brigades."}]]}]]}]
43:["$","div","Cruft checks the first assault",{"className":"moment","children":[["$","$L30",null,{"seconds":1266,"label":"21:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cruft checks the first assault"}],["$","p",null,{"children":"Six guns firing canister and determined infantry volleys briefly stopped the Confederate advance."}]]}]]}]
44:["$","div","A counterattack fails at the fence",{"className":"moment","children":[["$","$L30",null,{"seconds":1287,"label":"21:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"A counterattack fails at the fence"}],["$","p",null,{"children":"McCray’s men rose from cover and fired at close range, driving the attackers back before the second United States line dissolved."}]]}]]}]
45:["$","div","The last line forms at Richmond",{"className":"moment","children":[["$","$L30",null,{"seconds":1318,"label":"21:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"The last line forms at Richmond"}],["$","p",null,{"children":"Manson and Cruft tried to rally their regiments on the southern outskirts as Nelson arrived from Lexington."}]]}]]}]
46:["$","div","Smith rests his infantry",{"className":"moment","children":[["$","$L30",null,{"seconds":1352,"label":"22:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith rests his infantry"}],["$","p",null,{"children":"After hours of fighting in severe heat, the Confederates paused for about an hour before the final assault."}]]}]]}]
47:["$","div","Scott circles behind Richmond",{"className":"moment","children":[["$","$L30",null,{"seconds":1373,"label":"22:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Scott circles behind Richmond"}],["$","p",null,{"children":"Smith sent the cavalry on a wide sweep to cut the expected retreat toward Lexington."}]]}]]}]
48:["$","div","Nelson is wounded",{"className":"moment","children":[["$","$L30",null,{"seconds":1397,"label":"23:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nelson is wounded"}],["$","p",null,{"children":"Two spent balls struck his leg as he attempted to steady the final line; the position soon broke in a general stampede."}]]}]]}]
49:["$","div","The cavalry trap closes",{"className":"moment","children":[["$","$L30",null,{"seconds":1455,"label":"24:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cavalry trap closes"}],["$","p",null,{"children":"Although exhausted Confederate infantry halted, Scott’s horsemen reached the Lexington road and intercepted the retreat."}]]}]]}]
4a:["$","div","Surrenders begin by the hundreds",{"className":"moment","children":[["$","$L30",null,{"seconds":1477,"label":"24:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Surrenders begin by the hundreds"}],["$","p",null,{"children":"Manson was captured after his horse was shot; Nelson, Cruft, and roughly 800 to 900 others escaped."}]]}]]}]
4b:["$","div","The scale of the defeat is counted",{"className":"moment","children":[["$","$L30",null,{"seconds":1522,"label":"25:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The scale of the defeat is counted"}],["$","p",null,{"children":"The episode gives 206 United States dead, 844 wounded, and about 4,300 missing, most of them prisoners."}]]}]]}]
4c:["$","div","Confederate losses are far lower",{"className":"moment","children":[["$","$L30",null,{"seconds":1547,"label":"25:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate losses are far lower"}],["$","p",null,{"children":"The episode reports 98 killed, 492 wounded, and 8 missing, leaving the route to Lexington open."}]]}]]}]
4d:["$","div","Smith enters Lexington",{"className":"moment","children":[["$","$L30",null,{"seconds":1576,"label":"26:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith enters Lexington"}],["$","p",null,{"children":"After resting his men and paroling prisoners on August 31, Smith occupied Lexington on September 2."}]]}]]}]
4e:["$","div","Frankfort falls",{"className":"moment","children":[["$","$L30",null,{"seconds":1593,"label":"26:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Frankfort falls"}],["$","p",null,{"children":"Confederate troops occupied Kentucky’s capital on September 4 while cavalry probed toward Louisville and infantry north toward Cincinnati."}]]}]]}]
4f:["$","div","Bragg is also on the march",{"className":"moment","children":[["$","$L30",null,{"seconds":1645,"label":"27:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg is also on the march"}],["$","p",null,{"children":"Smith’s success occurred while Bragg’s separate army advanced into Kentucky to carry out the other part of the Confederate plan."}]]}]]}]
50:["$","div","Nelson blames Manson and the recruits",{"className":"moment","children":[["$","$L30",null,{"seconds":1665,"label":"27:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nelson blames Manson and the recruits"}],["$","p",null,{"children":"The defeated commander alleged disobedience and publicly disparaged the new Indiana soldiers, provoking Gov. Oliver Morton."}]]}]]}]
51:["$","div","The dispute reaches Louisville",{"className":"moment","children":[["$","$L30",null,{"seconds":1701,"label":"28:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The dispute reaches Louisville"}],["$","p",null,{"children":"Morton and Brig. Gen. Jefferson C. Davis went to confront Nelson, whose earlier relationship with Davis was already hostile."}]]}]]}]
52:["$","div","Jefferson C. Davis shoots Nelson",{"className":"moment","children":[["$","$L30",null,{"seconds":1739,"label":"28:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jefferson C. Davis shoots Nelson"}],["$","p",null,{"children":"After Nelson struck him at the Galt House, Davis obtained a pistol and fatally shot Nelson on September 29."}]]}]]}]
53:["$","div","The episode recommends Lambert’s battle study",{"className":"moment","children":[["$","$L30",null,{"seconds":1761,"label":"29:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode recommends Lambert’s battle study"}],["$","p",null,{"children":"The title is When the Ripe Pears Fell: The Battle of Richmond, Kentucky, published by the Madison County Historical Society."}]]}]]}]
54:["$","small",null,{"children":"Screened the advance, fought the August 23 and 29 actions, and cut the Lexington road north of Richmond during the final rout."}]
