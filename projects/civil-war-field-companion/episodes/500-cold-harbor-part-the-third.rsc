18:["$","div","The breach was not reinforced",{"className":"moment","children":[["$","$L17",null,{"seconds":1045,"label":"17:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The breach was not reinforced"}],["$","p",null,{"children":"Gibbon was delayed, one supporting brigade did not arrive, and Birney’s reserve remained back. Confederate counterattacks retook the guns and closed the opening."}]]}]]}]
19:["$","div","II Corps lost nearly 3,000 men",{"className":"moment","children":[["$","$L17",null,{"seconds":1258,"label":"20:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"II Corps lost nearly 3,000 men"}],["$","p",null,{"children":"Hancock’s two attacking divisions suffered nearly 3,000 casualties in less than an hour."}]]}]]}]
1a:["$","div","Wright’s VI Corps attack stopped quickly",{"className":"moment","children":[["$","$L17",null,{"seconds":1344,"label":"22:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wright’s VI Corps attack stopped quickly"}],["$","p",null,{"children":"David Russell delayed for flank support, James Ricketts advanced into heavy fire, and Horatio Wright ended the effort before losses grew further."}]]}]]}]
1b:["$","div","Smith’s XVIII Corps attacked without a reserve",{"className":"moment","children":[["$","$L17",null,{"seconds":1444,"label":"24:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith’s XVIII Corps attacked without a reserve"}],["$","p",null,{"children":"William F. Smith sent George Martindale and William Brooks forward while a third division covered an extended front. Neither assault reached the main works."}]]}]]}]
1c:["$","div","Burnside and Warren advanced at 6 a.m.",{"className":"moment","children":[["$","$L17",null,{"seconds":1643,"label":"27:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Burnside and Warren advanced at 6 a.m."}],["$","p",null,{"children":"Burnside drove in Confederate pickets on the U.S. right but stopped before the main line to bring up more artillery. Warren committed only two brigades."}]]}]]}]
1d:["$","div","Early reports gave Meade an incorrect picture",{"className":"moment","children":[["$","$L17",null,{"seconds":1708,"label":"28:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early reports gave Meade an incorrect picture"}],["$","p",null,{"children":"Barlow’s temporary breakthrough and incomplete messages led Meade to believe a renewed general attack might still succeed."}]]}]]}]
1e:["$","div","Grant left the decision with Meade",{"className":"moment","children":[["$","$L17",null,{"seconds":1791,"label":"29:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant left the decision with Meade"}],["$","p",null,{"children":"At 7 a.m. Grant told Meade to stop when failure was certain but to reinforce any point where an assault succeeded."}]]}]]}]
1f:["$","div","Meade ordered the three southern corps to press again",{"className":"moment","children":[["$","$L17",null,{"seconds":1889,"label":"31:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade ordered the three southern corps to press again"}],["$","p",null,{"children":"Hancock advised against another assault, Smith refused to repeat his attack, and Wright’s subordinates increased their fire without making another full advance."}]]}]]}]
20:["$","div","Grant collected the corps commanders’ assessments",{"className":"moment","children":[["$","$L17",null,{"seconds":2104,"label":"35:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant collected the corps commanders’ assessments"}],["$","p",null,{"children":"His staff found that none of the commanders expected a renewed attack to produce a useful breakthrough."}]]}]]}]
21:["$","div","Grant suspended further attacks",{"className":"moment","children":[["$","$L17",null,{"seconds":2162,"label":"36:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant suspended further attacks"}],["$","p",null,{"children":"At 12:30 p.m. Grant authorized Meade to stop the advance. Meade then ordered the army to hold and entrench its current positions."}]]}]]}]
22:["$","div","The casualty total was about 7,000",{"className":"moment","children":[["$","$L17",null,{"seconds":2265,"label":"37:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The casualty total was about 7,000"}],["$","p",null,{"children":"The Army of the Potomac recorded losses for a broader period, but estimates place June 3 U.S. casualties near 7,000, most in the first hour."}]]}]]}]
23:["$","div","Confederate losses were much lower",{"className":"moment","children":[["$","$L17",null,{"seconds":2309,"label":"38:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate losses were much lower"}],["$","p",null,{"children":"The Confederate army lost fewer than 1,500 men, with only about 500 killed or wounded opposite the main U.S. attacks."}]]}]]}]
24:["$","div","Lee had no reserve for a counterattack",{"className":"moment","children":[["$","$L17",null,{"seconds":2385,"label":"39:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee had no reserve for a counterattack"}],["$","p",null,{"children":"Lee told Confederate postmaster general John H. Reagan that shortening or weakening his line would allow Grant either to turn or break it."}]]}]]}]
