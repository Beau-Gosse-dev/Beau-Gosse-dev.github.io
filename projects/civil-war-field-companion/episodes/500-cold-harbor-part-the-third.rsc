11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Early’s June 2 attack had failed",{"className":"moment","children":[["$","$L17",null,{"seconds":383,"label":"6:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early’s June 2 attack had failed"}],["$","p",null,{"children":"Jubal Early did not turn the U.S. right at Bethesda Church, leaving Grant free to continue the planned assault at Cold Harbor."}]]}]]}],["$","div","Lee strengthened the Cold Harbor line",{"className":"moment","children":[["$","$L17",null,{"seconds":437,"label":"7:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee strengthened the Cold Harbor line"}],["$","p",null,{"children":"Two divisions from A. P. Hill’s corps and John C. Breckinridge’s division reinforced the sector."}]]}]]}],["$","div","Confederates secured Turkey Hill",{"className":"moment","children":[["$","$L17",null,{"seconds":455,"label":"7:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates secured Turkey Hill"}],["$","p",null,{"children":"Breckinridge and Cadmus Wilcox drove Hancock’s troops from the hill, protecting the Confederate right near the Chickahominy River."}]]}]]}],["$","div","Engineers laid out new earthworks",{"className":"moment","children":[["$","$L17",null,{"seconds":520,"label":"8:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Engineers laid out new earthworks"}],["$","p",null,{"children":"After dark, Confederate officers selected firing lines, marked them with rope, and directed infantry working parties to dig."}]]}]]}],["$","div","Evander Law shortened a weak sector",{"className":"moment","children":[["$","$L17",null,{"seconds":577,"label":"9:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Evander Law shortened a weak sector"}],["$","p",null,{"children":"Law replaced an exposed right-angle position with a shorter line across its base and a better field of fire."}]]}]]}],["$","div","U.S. soldiers expected heavy losses",{"className":"moment","children":[["$","$L17",null,{"seconds":646,"label":"10:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. soldiers expected heavy losses"}],["$","p",null,{"children":"Across a gap of roughly 600 to 1,000 yards, soldiers watched the Confederate works improve and prepared identification slips for their bodies."}]]}]]}],["$","div","Rain and fog covered the battlefield",{"className":"moment","children":[["$","$L17",null,{"seconds":745,"label":"12:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rain and fog covered the battlefield"}],["$","p",null,{"children":"Overnight rain turned the ground to mud, and patchy fog remained in low areas before the attack."}]]}]]}],["$","div","The assault signal sounded",{"className":"moment","children":[["$","$L17",null,{"seconds":779,"label":"12:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"The assault signal sounded"}],["$","p",null,{"children":"At 4:30 a.m. on June 3, a gun from the 10th Massachusetts Battery signaled the attack. U.S. artillery fired for about ten minutes before the infantry advanced."}]]}]]}],["$","div","Prepared fire stopped most of the advance",{"className":"moment","children":[["$","$L17",null,{"seconds":814,"label":"13:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Prepared fire stopped most of the advance"}],["$","p",null,{"children":"Confederate infantry and artillery opened from earthworks. The curved U.S. line caused the attacking corps to separate and exposed them to crossfire."}]]}]]}],["$","div","Hancock’s II Corps attacked first",{"className":"moment","children":[["$","$L17",null,{"seconds":927,"label":"15:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock’s II Corps attacked first"}],["$","p",null,{"children":"Francis Barlow and John Gibbon led two divisions south of the Gaines Mill Road while David Birney remained in reserve."}]]}]]}],["$","div","Barlow broke into Breckinridge’s line",{"className":"moment","children":[["$","$L17",null,{"seconds":963,"label":"16:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Barlow broke into Breckinridge’s line"}],["$","p",null,{"children":"Nelson Miles and John R. Brooke struck a section whose defenders had left flooded trenches to sleep uphill. They captured about 425 men and eight guns."}]]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}]]}]
