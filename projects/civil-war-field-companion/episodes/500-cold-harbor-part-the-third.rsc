15:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L1d",null,{"guide":{"date":"June 2–7, 1864","place":"Cold Harbor, Hanover County, Virginia","result":"The June 3 U.S. assault failed against prepared Confederate earthworks; Grant ended the attacks by midday and later shifted the Army of the Potomac south across the James River","facts":[{"label":"Main assault began","value":"4:30 a.m., June 3"},{"label":"U.S. casualties on June 3","value":"About 7,000"},{"label":"Hancock’s II Corps casualties","value":"Nearly 3,000"},{"label":"Confederate casualties","value":"Fewer than 1,500"},{"label":"Confederates captured by Barlow","value":"About 425"},{"label":"Guns briefly captured","value":"8"},{"label":"Further attacks suspended","value":"12:30 p.m."},{"label":"Truce agreed","value":"Evening of June 7"}],"maps":[{"title":"Battle lines on June 1 and June 3","caption":"The historical map shows U.S. positions in blue and Confederate positions in red. Hancock attacked south of the Gaines Mill Road, Wright attacked in the center, Smith attacked north of the road, and Burnside operated on the U.S. right.","source":"https://www.loc.gov/item/gvhs01.vhs00233/","image":"/images/cold-harbor-june-1-3-map.jpg","alt":"Historical map of U.S. and Confederate positions at Cold Harbor on June 1 and June 3, 1864"},{"title":"Cold Harbor in the Richmond area","caption":"Cold Harbor lies east of Richmond and north of the Chickahominy River. Grant’s army approached from the north and east while Lee protected the routes to Richmond.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-77.62%2C37.45%2C-77.15%2C37.75&layer=mapnik&marker=37.5892%2C-77.2886"},{"title":"From the Rapidan to Cold Harbor","caption":"Cold Harbor was the final major battlefield of the Overland campaign north of the James River. The 1864 route map places it southeast of the Wilderness, Spotsylvania, and the North Anna.","source":"https://www.loc.gov/item/99448882/","image":"/images/overland-campaign-1864-map.jpg","alt":"1864 military map of the Overland campaign in eastern Virginia"}],"moments":[{"time":"6:23","audioTime":383,"title":"Early’s June 2 attack had failed","detail":"Jubal Early did not turn the U.S. right at Bethesda Church, leaving Grant free to continue the planned assault at Cold Harbor."},{"time":"7:17","audioTime":437,"title":"Lee strengthened the Cold Harbor line","detail":"Two divisions from A. P. Hill’s corps and John C. Breckinridge’s division reinforced the sector."},{"time":"7:35","audioTime":455,"title":"Confederates secured Turkey Hill","detail":"Breckinridge and Cadmus Wilcox drove Hancock’s troops from the hill, protecting the Confederate right near the Chickahominy River."},{"time":"8:40","audioTime":520,"title":"Engineers laid out new earthworks","detail":"After dark, Confederate officers selected firing lines, marked them with rope, and directed infantry working parties to dig."},{"time":"9:37","audioTime":577,"title":"Evander Law shortened a weak sector","detail":"Law replaced an exposed right-angle position with a shorter line across its base and a better field of fire."},{"time":"10:46","audioTime":646,"title":"U.S. soldiers expected heavy losses","detail":"Across a gap of roughly 600 to 1,000 yards, soldiers watched the Confederate works improve and prepared identification slips for their bodies."},{"time":"12:25","audioTime":745,"title":"Rain and fog covered the battlefield","detail":"Overnight rain turned the ground to mud, and patchy fog remained in low areas before the attack."},{"time":"12:59","audioTime":779,"title":"The assault signal sounded","detail":"At 4:30 a.m. on June 3, a gun from the 10th Massachusetts Battery signaled the attack. U.S. artillery fired for about ten minutes before the infantry advanced."},{"time":"13:34","audioTime":814,"title":"Prepared fire stopped most of the advance","detail":"Confederate infantry and artillery opened from earthworks. The curved U.S. line caused the attacking corps to separate and exposed them to crossfire."},{"time":"15:27","audioTime":927,"title":"Hancock’s II Corps attacked first","detail":"Francis Barlow and John Gibbon led two divisions south of the Gaines Mill Road while David Birney remained in reserve."},{"time":"16:03","audioTime":963,"title":"Barlow broke into Breckinridge’s line","detail":"Nelson Miles and John R. Brooke struck a section whose defenders had left flooded trenches to sleep uphill. They captured about 425 men and eight guns."},{"time":"17:25","audioTime":1045,"title":"The breach was not reinforced","detail":"Gibbon was delayed, one supporting brigade did not arrive, and Birney’s reserve remained back. Confederate counterattacks retook the guns and closed the opening."},{"time":"20:58","audioTime":1258,"title":"II Corps lost nearly 3,000 men","detail":"Hancock’s two attacking divisions suffered nearly 3,000 casualties in less than an hour."},{"time":"22:24","audioTime":1344,"title":"Wright’s VI Corps attack stopped quickly","detail":"David Russell delayed for flank support, James Ricketts advanced into heavy fire, and Horatio Wright ended the effort before losses grew further."},{"time":"24:04","audioTime":1444,"title":"Smith’s XVIII Corps attacked without a reserve","detail":"William F. Smith sent George Martindale and William Brooks forward while a third division covered an extended front. Neither assault reached the main works."},{"time":"27:23","audioTime":1643,"title":"Burnside and Warren advanced at 6 a.m.","detail":"Burnside drove in Confederate pickets on the U.S. right but stopped before the main line to bring up more artillery. Warren committed only two brigades."},{"time":"28:28","audioTime":1708,"title":"Early reports gave Meade an incorrect picture","detail":"Barlow’s temporary breakthrough and incomplete messages led Meade to believe a renewed general attack might still succeed."},{"time":"29:51","audioTime":1791,"title":"Grant left the decision with Meade","detail":"At 7 a.m. Grant told Meade to stop when failure was certain but to reinforce any point where an assault succeeded."},{"time":"31:29","audioTime":1889,"title":"Meade ordered the three southern corps to press again","detail":"Hancock advised against another assault, Smith refused to repeat his attack, and Wright’s subordinates increased their fire without making another full advance."},{"time":"35:04","audioTime":2104,"title":"Grant collected the corps commanders’ assessments","detail":"His staff found that none of the commanders expected a renewed attack to produce a useful breakthrough."},{"time":"36:02","audioTime":2162,"title":"Grant suspended further attacks","detail":"At 12:30 p.m. Grant authorized Meade to stop the advance. Meade then ordered the army to hold and entrench its current positions."},{"time":"37:45","audioTime":2265,"title":"The casualty total was about 7,000","detail":"The Army of the Potomac recorded losses for a broader period, but estimates place June 3 U.S. casualties near 7,000, most in the first hour."},{"time":"38:29","audioTime":2309,"title":"Confederate losses were much lower","detail":"The Confederate army lost fewer than 1,500 men, with only about 500 killed or wounded opposite the main U.S. attacks."},{"time":"39:45","audioTime":2385,"title":"Lee had no reserve for a counterattack","detail":"Lee told Confederate postmaster general John H. Reagan that shortening or weakening his line would allow Grant either to turn or break it."},{"time":"41:04","audioTime":2464,"title":"Wounded soldiers remained between the lines","detail":"The armies did not agree on a truce until the evening of June 7. Most wounded men had been recovered at night or had died by then."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"Ulysses S. Grant","command":"General-in-chief, U.S. armies","subordinates":"Set the campaign objective and authorized the suspension of further attacks"},{"commander":"George G. Meade","command":"Army of the Potomac","subordinates":"Issued and coordinated the assault orders"},{"commander":"Winfield S. Hancock","command":"II Corps","subordinates":"Francis Barlow, John Gibbon, and David Birney divisions"},{"commander":"Horatio G. Wright","command":"VI Corps","subordinates":"David Russell and James Ricketts divisions"},{"commander":"William F. “Baldy” Smith","command":"XVIII Corps, Army of the James","subordinates":"George Martindale, William Brooks, and Charles Devens divisions"},{"commander":"Gouverneur K. Warren","command":"V Corps","subordinates":"Supported the northern sector with two brigades"},{"commander":"Ambrose E. Burnside","command":"IX Corps","subordinates":"Attacked on the extreme U.S. right"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Robert E. Lee","command":"Army of Northern Virginia","subordinates":"Directed the defense of Richmond’s eastern approaches"},{"commander":"A. P. Hill","command":"Third Corps","subordinates":"Reinforced Cold Harbor with two divisions"},{"commander":"John C. Breckinridge","command":"Independent division","subordinates":"Held the Confederate right south of the Gaines Mill Road"},{"commander":"Cadmus M. Wilcox","command":"Division, Third Corps","subordinates":"Helped secure Turkey Hill and the Confederate right"},{"commander":"Evander M. Law","command":"Brigade, First Corps","subordinates":"Redesigned and defended an exposed section of the line"},{"commander":"Jubal A. Early","command":"Second Corps","subordinates":"Held the Confederate left after the failed June 2 attack at Bethesda Church"}]}],"people":[{"personId":"ulysses-s-grant","role":"Approved the assault and stopped further attacks after receiving the corps commanders’ assessments"},{"name":"George G. Meade","role":"Directed the Army of the Potomac and pressed the corps commanders to renew their attacks","side":"United States"},{"name":"Winfield S. Hancock","role":"Commanded II Corps; advised Meade that another attack in his sector would fail","side":"United States"},{"name":"William F. Smith","role":"Commanded XVIII Corps and refused to repeat an assault he considered impossible","side":"United States","image":"/images/baldy-smith-cold-harbor.jpg","source":"https://www.loc.gov/item/2018670739/"},{"name":"Horatio G. Wright","role":"Commanded VI Corps and stopped its first attack after limited progress","side":"United States"},{"name":"Francis C. Barlow","role":"Led the II Corps division that briefly penetrated Breckinridge’s line","side":"United States"},{"name":"Robert E. Lee","role":"Constructed a strong defensive line but lacked reserves for a counterattack","side":"Confederacy","image":"/images/robert-e-lee-1864.jpg","source":"https://www.loc.gov/item/2018666540/"},{"name":"John C. Breckinridge","role":"Commanded the understrength division struck by Barlow’s assault","side":"Confederacy"},{"name":"Evander M. Law","role":"Shortened a weak section of the Confederate line before the attack","side":"Confederacy"}],"losses":[{"name":"George M. Edgar","side":"Confederacy","role":"Colonel, 26th Virginia Battalion","outcome":"Killed while attempting to organize his men after Barlow’s troops entered the position"},{"name":"John R. Brooke","side":"United States","role":"II Corps brigade commander","outcome":"Badly wounded by canister after his brigade breached the Confederate line; survived"}],"gallery":[{"image":"/images/cold-harbor-june-1-3-map.jpg","alt":"Watercolor battle map of Cold Harbor","caption":"The map identifies the opposing works, roads, rivers, and principal attack sectors.","source":"https://www.loc.gov/item/gvhs01.vhs00233/"},{"image":"/images/cold-harbor-battlefield.jpg","alt":"Stereographic photograph of the Cold Harbor battlefield","caption":"A wartime photograph records the open ground and earthworks at Cold Harbor.","source":"https://www.loc.gov/item/2018666598/"},{"image":"/images/baldy-smith-cold-harbor.jpg","alt":"William F. Smith seated with his staff near Cold Harbor","caption":"William F. Smith and his staff in the field near Cold Harbor in June 1864.","source":"https://www.loc.gov/item/2018670739/"},{"image":"/images/robert-e-lee-1864.jpg","alt":"March 1864 portrait of Robert E. Lee","caption":"Lee’s prepared line defeated the assault, but his army was too thinly spread to counterattack.","source":"https://www.loc.gov/item/2018666540/"}],"sources":[{"label":"Official Episode 500 page","url":"https://civilwarpodcast.org/2025/08/10/civil-war-podcast-episode-500/"},{"label":"National Park Service: Cold Harbor, Grant’s Greatest Regret","url":"https://www.nps.gov/articles/cold-harbor-grant-s-greatest-regret.htm"},{"label":"National Park Service Cold Harbor battlefield overview","url":"https://www.nps.gov/rich/learn/historyculture/cold-harbor.htm"},{"label":"Library of Congress Cold Harbor battle plan","url":"https://www.loc.gov/item/gvhs01.vhs00233/"},{"label":"Library of Congress Cold Harbor battlefield photograph","url":"https://www.loc.gov/item/2018666598/"},{"label":"Library of Congress William F. Smith and staff photograph","url":"https://www.loc.gov/item/2018670739/"},{"label":"Library of Congress 1864 eastern Virginia campaign map","url":"https://www.loc.gov/item/99448882/"}]}}]}]
