11:["$","figure","Atlanta and its eastern railroad today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-84.67%2C33.55%2C-83.96%2C34.09&layer=mapnik&marker=33.755%2C-84.39","title":"Atlanta and its eastern railroad today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Atlanta and its eastern railroad today"}],["$","span",null,{"children":"Sherman planned to move from the Chattahoochee crossings around the north and east of Atlanta and cut the Georgia Railroad between Stone Mountain and Decatur."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
12:["$","figure","Petersburg, Washington, and the Shenandoah Valley",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-79.70%2C36.70%2C-75.40%2C40.20&layer=mapnik&marker=38.9072%2C-77.0369","title":"Petersburg, Washington, and the Shenandoah Valley","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Petersburg, Washington, and the Shenandoah Valley"}],["$","span",null,{"children":"Grant remained outside Petersburg while Jubal Early moved down the Shenandoah Valley, crossed the Potomac, defeated a U.S. force at Monocacy, and reached the defenses of Washington."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode returns to the Chattahoochee mills",{"className":"moment","children":[["$","$L18",null,{"seconds":77,"label":"1:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode returns to the Chattahoochee mills"}],["$","p",null,{"children":"When Johnston abandoned the Shoup Line, U.S. troops gained an industrial district along the river. Cavalrymen removed workers and burned mills that produced cloth for Confederate uniforms."}]]}]]}],["$","div","Johnston formed a line south of Peachtree Creek",{"className":"moment","children":[["$","$L18",null,{"seconds":169,"label":"2:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston formed a line south of Peachtree Creek"}],["$","p",null,{"children":"The Army of Tennessee occupied ground about three miles north of central Atlanta. Wheeler covered the front and William H. Jackson held the Confederate left."}]]}]]}],["$","div","Alexander P. Stewart took command of Polk’s former corps",{"className":"moment","children":[["$","$L18",null,{"seconds":228,"label":"3:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Alexander P. Stewart took command of Polk’s former corps"}],["$","p",null,{"children":"Stewart assumed corps command on July 7. William W. Loring returned to his division, and Jefferson Davis selected Henry D. Clayton to replace Stewart as a division commander."}]]}]]}],["$","div","Sherman planned to isolate Atlanta by rail",{"className":"moment","children":[["$","$L18",null,{"seconds":360,"label":"6:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman planned to isolate Atlanta by rail"}],["$","p",null,{"children":"Sherman intended to avoid a direct attack on the city defenses and make Atlanta unusable by cutting the railroads that connected it to the rest of the Confederacy."}]]}]]}],["$","div","Two cavalry raids targeted railroads west of Atlanta",{"className":"moment","children":[["$","$L18",null,{"seconds":457,"label":"7:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two cavalry raids targeted railroads west of Atlanta"}],["$","p",null,{"children":"Lovell Rousseau led a long-range raid from Tennessee into Alabama while George Stoneman crossed the Chattahoochee southwest of Atlanta."}]]}]]}],["$","div","Rousseau damaged the railroad in Alabama",{"className":"moment","children":[["$","$L18",null,{"seconds":488,"label":"8:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rousseau damaged the railroad in Alabama"}],["$","p",null,{"children":"His 2,500 cavalrymen destroyed supplies, bridges, rolling stock, and about 30 miles of track. The damage interrupted Confederate communications for weeks."}]]}]]}],["$","div","Stoneman withdrew after crossing the river",{"className":"moment","children":[["$","$L18",null,{"seconds":561,"label":"9:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stoneman withdrew after crossing the river"}],["$","p",null,{"children":"Stoneman captured a damaged bridge, crossed on July 14, then retreated when Confederate troops opposed him. Sherman ended that part of the operation."}]]}]]}],["$","div","Sherman began the movement around Atlanta",{"className":"moment","children":[["$","$L18",null,{"seconds":606,"label":"10:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman began the movement around Atlanta"}],["$","p",null,{"children":"McPherson moved from Roswell toward the Georgia Railroad. Schofield advanced in the center and Thomas served as the western hinge of the movement."}]]}]]}],["$","div","U.S. armies advanced to Nancy Creek",{"className":"moment","children":[["$","$L18",null,{"seconds":674,"label":"11:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. armies advanced to Nancy Creek"}],["$","p",null,{"children":"On July 17, the three armies pushed back Wheeler’s cavalry and moved about halfway from the Chattahoochee to Peachtree Creek."}]]}]]}],["$","div","The episode shifts to the wider war",{"className":"moment","children":["$L19","$L1a"]}],"$L1b","$L1c","$L1d"]}]]}]
