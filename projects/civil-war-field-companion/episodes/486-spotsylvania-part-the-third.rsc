17:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
19:["$","div","The attack overran the Confederate pickets",{"className":"moment","children":[["$","$L18",null,{"seconds":1022,"label":"17:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack overran the Confederate pickets"}],["$","p",null,{"children":"Fog and poor readiness allowed Hancock’s troops to reach the works after only brief resistance."}]]}]]}]
1a:["$","div","Hancock captured the northern Mule Shoe",{"className":"moment","children":[["$","$L18",null,{"seconds":1039,"label":"17:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock captured the northern Mule Shoe"}],["$","p",null,{"children":"Within minutes, U.S. troops took 20 guns and thousands of prisoners. Edward Johnson and brigade commander George H. Steuart were captured, and Johnson’s division ceased to function as an organized force."}]]}]]}]
1b:["$","div","The U.S. advance lost organization",{"className":"moment","children":[["$","$L18",null,{"seconds":1130,"label":"18:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. advance lost organization"}],["$","p",null,{"children":"Units became mixed while taking prisoners and crossing the works. Officers could not immediately form the mass into a coordinated force for an advance through the woods."}]]}]]}]
1c:["$","div","John B. Gordon organized a counterattack",{"className":"moment","children":[["$","$L18",null,{"seconds":1249,"label":"20:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"John B. Gordon organized a counterattack"}],["$","p",null,{"children":"Gordon first sent Robert D. Johnston’s small brigade forward to gain time, then assembled more troops from Ewell’s reserve division."}]]}]]}]
1d:["$","div","Lee tried to lead the counterattack",{"className":"moment","children":[["$","$L18",null,{"seconds":1335,"label":"22:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee tried to lead the counterattack"}],["$","p",null,{"children":"Gordon and his soldiers stopped Lee from advancing with the line. Gordon then sent three brigades against the disorganized U.S. force."}]]}]]}]
1e:["$","div","The counterattack recovered most of the salient",{"className":"moment","children":[["$","$L18",null,{"seconds":1419,"label":"23:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The counterattack recovered most of the salient"}],["$","p",null,{"children":"Gordon’s troops pushed Hancock back toward the northern tip. Additional brigades arrived while Lee moved reinforcements into the fight."}]]}]]}]
1f:["$","div","Wright’s VI Corps entered the battle",{"className":"moment","children":[["$","$L18",null,{"seconds":1473,"label":"24:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wright’s VI Corps entered the battle"}],["$","p",null,{"children":"Hancock reported that all his troops were committed and asked for immediate help. VI Corps attacked but neither side could dislodge the other from the Bloody Angle."}]]}]]}]
20:["$","div","The battle reached a stalemate by 7:30 a.m.",{"className":"moment","children":[["$","$L18",null,{"seconds":1538,"label":"25:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battle reached a stalemate by 7:30 a.m."}],["$","p",null,{"children":"Hancock had captured about 3,000 prisoners and 20 guns, but his advance was stopped. Wright was also stalled and Burnside had made little progress."}]]}]]}]
21:["$","div","Meade ordered Warren to attack Laurel Hill",{"className":"moment","children":[["$","$L18",null,{"seconds":1599,"label":"26:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade ordered Warren to attack Laurel Hill"}],["$","p",null,{"children":"Grant believed Lee must have weakened other parts of his line. Warren argued that the position remained fully defended and delayed while seeking artillery preparation."}]]}]]}]
22:["$","div","V Corps attacked and was repulsed",{"className":"moment","children":[["$","$L18",null,{"seconds":1749,"label":"29:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"V Corps attacked and was repulsed"}],["$","p",null,{"children":"Warren’s troops crossed open ground under artillery and musket fire. A single entrenched Confederate division retained Laurel Hill."}]]}]]}]
23:["$","div","Nearly the entire U.S. army was engaged",{"className":"moment","children":[["$","$L18",null,{"seconds":1815,"label":"30:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nearly the entire U.S. army was engaged"}],["$","p",null,{"children":"Reinforcements crowded into the Mule Shoe, sometimes 20 ranks deep, but their numbers could not be used effectively in the confined ground."}]]}]]}]
24:["$","div","Lee ordered a new line across the salient’s base",{"className":"moment","children":[["$","$L18",null,{"seconds":1884,"label":"31:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee ordered a new line across the salient’s base"}],["$","p",null,{"children":"Confederate troops held the Bloody Angle to give engineers and infantry time to complete a shorter defensive line behind them."}]]}]]}]
25:["$","div","Close-range fighting continued at the Bloody Angle",{"className":"moment","children":[["$","$L18",null,{"seconds":1944,"label":"32:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Close-range fighting continued at the Bloody Angle"}],["$","p",null,{"children":"Soldiers fired and stabbed across the log parapet in rain and mud. The intensity rose and fell, but combat continued through the afternoon and night."}]]}]]}]
26:["$","div","Confederates withdrew early on May 13",{"className":"moment","children":[["$","$L18",null,{"seconds":2086,"label":"34:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates withdrew early on May 13"}],["$","p",null,{"children":"After the new line was complete, the defenders pulled back around 3 a.m. U.S. losses exceeded 6,000; the episode counts at least 4,000 Confederates killed or wounded and another 4,000 captured."}]]}]]}]
27:["$","div","Rain stopped Grant’s attempted flank movement",{"className":"moment","children":[["$","$L18",null,{"seconds":2135,"label":"35:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rain stopped Grant’s attempted flank movement"}],["$","p",null,{"children":"Warren and Wright shifted toward the Confederate right on the night of May 13, but mud slowed the march and Lee adjusted his line before they could attack effectively."}]]}]]}]
28:["$","div","Grant ordered another Mule Shoe attack",{"className":"moment","children":[["$","$L18",null,{"seconds":2215,"label":"36:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant ordered another Mule Shoe attack"}],["$","p",null,{"children":"Six U.S. divisions returned to the area for a May 18 assault. Delays gave the Confederates warning, and artillery stopped the attack before it reached the new works."}]]}]]}]
29:["$","div","Defeats elsewhere changed Grant’s calculation",{"className":"moment","children":[["$","$L18",null,{"seconds":2324,"label":"38:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Defeats elsewhere changed Grant’s calculation"}],["$","p",null,{"children":"News that Sigel was retreating and Butler had withdrawn meant Confederate reinforcements could reach Lee. Grant began preparing another movement around Lee’s flank."}]]}]]}]
2a:["$","h3",null,{"children":"Winfield Scott Hancock"}]
2b:["$","p",null,{"children":"Directed the II Corps assault that broke the Mule Shoe and captured thousands of prisoners"}]
2c:["$","article","Francis C. Barlow",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"FC"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Francis C. Barlow"}],["$","p",null,{"children":"Arranged the lead division in a dense formation and reached the salient despite having little information about the ground"}]]}]]}]
2d:["$","article","Horatio G. Wright",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"HG"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Horatio G. Wright"}],["$","p",null,{"children":"Sent VI Corps into the Bloody Angle after Hancock requested immediate support"}]]}]]}]
2e:["$","article","Gouverneur K. Warren",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GK"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Gouverneur K. Warren"}],["$","p",null,{"children":"Opposed the Laurel Hill order because the Confederate defenses remained fully occupied; his attack was repulsed"}]]}]]}]
2f:["$","article","Robert E. Lee",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/robert-e-lee-1864.jpg","alt":"Portrait of Robert E. Lee","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Robert E. Lee"}],["$","p",null,{"children":"Directed the Confederate response and ordered construction of the shorter line that allowed withdrawal from the salient"}]]}]]}]
30:["$","article","Edward Johnson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/edward-johnson.jpg","alt":"Portrait of Edward Johnson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Edward Johnson"}],["$","p",null,{"children":"Commanded the division at the salient’s apex and was captured during Hancock’s breakthrough"}]]}]]}]
31:["$","article","John B. Gordon",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"John B. Gordon"}],["$","p",null,{"children":"Organized the immediate counterattack and prevented Hancock from cutting Lee’s army in two"}]]}]]}]
32:["$","article","George H. Steuart",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"George H. Steuart"}],["$","p",null,{"children":"Brigade commander in Johnson’s division who was captured inside the Mule Shoe"}]]}]]}]
