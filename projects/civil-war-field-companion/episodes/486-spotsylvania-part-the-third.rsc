15:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/spotsylvania-toughest-fight.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/spotsylvania-toughest-fight.jpg","alt":"Edwin Forbes drawing of fighting at the Spotsylvania salient","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Edwin Forbes drew the dense fighting and battlefield debris at the salient in May 1864."}]]}],["$","figure","/images/hancock-division-commanders.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/hancock-division-commanders.jpg","alt":"Winfield Scott Hancock seated with Francis Barlow, David Birney, and John Gibbon","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hancock and three of the II Corps division commanders used in the May 12 attack: Barlow at left, Birney behind Hancock, and Gibbon at right."}]]}],["$","figure","/images/edward-johnson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/edward-johnson.jpg","alt":"Portrait of Confederate Major General Edward Johnson","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Johnson commanded the division at the apex. He asked for the removed artillery to be returned but was captured when Hancock’s assault overran the position."}]]}],["$","figure","/images/spotsylvania-nps-battle-map.png",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/spotsylvania-nps-battle-map.png","alt":"Map of the Spotsylvania lines and Mule Shoe salient","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The shape of the salient exposed its northern apex and both flanks to attack."}]]}]]}]]}]
