10:["$","figure","The battlefield today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.635%2C38.190%2C-77.540%2C38.255&layer=mapnik&marker=38.2247%2C-77.5986","title":"The battlefield today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The battlefield today"}],["$","span",null,{"children":"The Mule Shoe and Bloody Angle are north of Spotsylvania Court House between Brock Road and the modern park tour road. The surviving earthworks can be followed on the battlefield trail."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
11:["$","figure","Spotsylvania in the Overland Campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Spotsylvania in the Overland Campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland Campaign showing Spotsylvania Court House","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Spotsylvania in the Overland Campaign"}],["$","span",null,{"children":"The campaign map places Spotsylvania southeast of the Wilderness and north of the later fighting at the North Anna and Cold Harbor."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Grant evaluated the attacks of May 10",{"className":"moment","children":[["$","$L18",null,{"seconds":89,"label":"1:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant evaluated the attacks of May 10"}],["$","p",null,{"children":"He believed Emory Upton’s temporary breakthrough could have produced a larger victory if it had received immediate support."}]]}]]}],["$","div","Lee reported that his line had been restored",{"className":"moment","children":[["$","$L18",null,{"seconds":189,"label":"3:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee reported that his line had been restored"}],["$","p",null,{"children":"The Confederate commander described the day’s attacks as repulsed except for Upton’s temporary success at the Mule Shoe."}]]}]]}],["$","div","Lee concentrated on the Mule Shoe",{"className":"moment","children":[["$","$L18",null,{"seconds":332,"label":"5:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee concentrated on the Mule Shoe"}],["$","p",null,{"children":"He brought Heth’s division back toward Spotsylvania Court House and told Richard Ewell to prepare for another attack on the salient."}]]}]]}],["$","div","Grant selected the Mule Shoe for a larger assault",{"className":"moment","children":[["$","$L18",null,{"seconds":404,"label":"6:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant selected the Mule Shoe for a larger assault"}],["$","p",null,{"children":"Reconnaissance showed the salient’s full outline. Grant and Meade concluded that a heavy attack against its apex could repeat and enlarge Upton’s breakthrough."}]]}]]}],["$","div","Hancock received the main assignment",{"className":"moment","children":[["$","$L18",null,{"seconds":463,"label":"7:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock received the main assignment"}],["$","p",null,{"children":"II Corps was ordered to move at night and attack at 4 a.m. with Burnside’s IX Corps supporting from the east. Warren and Wright were told to be ready to exploit success."}]]}]]}],["$","div","Barlow’s division became the lead formation",{"className":"moment","children":[["$","$L18",null,{"seconds":543,"label":"9:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Barlow’s division became the lead formation"}],["$","p",null,{"children":"Francis Barlow would spearhead the attack, David Birney and Gershom Mott would advance on his right, and John Gibbon would follow in reserve."}]]}]]}],["$","div","Barlow reached the Brown house after midnight",{"className":"moment","children":[["$","$L18",null,{"seconds":701,"label":"11:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Barlow reached the Brown house after midnight"}],["$","p",null,{"children":"His only usable information about the ground came from a rough sketch drawn on a wall by Lieutenant Colonel Waldo Merryman, who had participated in the May 10 attack."}]]}]]}],["$","div","Fog delayed the start by 45 minutes",{"className":"moment","children":[["$","$L18",null,{"seconds":828,"label":"13:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fog delayed the start by 45 minutes"}],["$","p",null,{"children":"Rain had soaked the troops and fields during the night. Hancock waited for enough light, then ordered the advance at 4:45 a.m."}]]}]]}],["$","div","About 19,000 U.S. soldiers advanced",{"className":"moment","children":[["$","$L18",null,{"seconds":854,"label":"14:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"About 19,000 U.S. soldiers advanced"}],["$","p",null,{"children":"Barlow used a dense, stacked formation based on Upton’s method. Mott and Birney moved in conventional lines on the right, with Gibbon behind them."}]]}]]}],["$","div","Lee had removed most artillery from the salient",{"className":"moment","children":[["$","$L18",null,{"seconds":947,"label":"15:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee had removed most artillery from the salient"}],["$","p",null,{"children":"Incorrect reports suggested Grant was moving toward Fredericksburg. Orders to return the guns arrived too late, and batteries were only beginning to reenter the works when the attack struck."}]]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","Overall command",{"className":"command-entry","children":[["$","strong",null,{"children":"Overall command"}],["$","span",null,{"children":"Ulysses S. Grant and George G. Meade"}],["$","small",null,{"children":"Selected the Mule Shoe as the main objective and committed four army corps during May 12"}]]}],["$","div","II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps"}],["$","span",null,{"children":"Winfield Scott Hancock"}],["$","small",null,{"children":"Francis Barlow, David Birney, Gershom Mott, and John Gibbon’s divisions"}]]}],["$","div","1st Division, II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, II Corps"}],["$","span",null,{"children":"Francis C. Barlow"}],["$","small",null,{"children":"Led the dense assault column that broke the northern face of the Mule Shoe"}]]}],["$","div","VI Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"VI Corps"}],["$","span",null,{"children":"Horatio G. Wright"}],["$","small",null,{"children":"Reinforced Hancock and fought at the Bloody Angle"}]]}],["$","div","IX Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"IX Corps"}],["$","span",null,{"children":"Ambrose E. Burnside"}],["$","small",null,{"children":"Attacked the east face and later Heth’s salient"}]]}],["$","div","V Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps"}],["$","span",null,{"children":"Gouverneur K. Warren"}],["$","small",null,{"children":"Attacked Laurel Hill, then sent much of his corps to reinforce the Mule Shoe sector"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Robert E. Lee"}],["$","small",null,{"children":"Committed reinforcements and ordered a new line across the base of the Mule Shoe"}]]}],["$","div","Second Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Corps"}],["$","span",null,{"children":"Richard S. Ewell"}],["$","small",null,{"children":"Held the Mule Shoe with Edward Johnson’s division and John B. Gordon’s reserve division"}]]}],["$","div","Division at the Mule Shoe apex",{"className":"command-entry","children":[["$","strong",null,{"children":"Division at the Mule Shoe apex"}],["$","span",null,{"children":"Edward Johnson"}],["$","small",null,{"children":"Captured with most of his division during Hancock’s initial breakthrough"}]]}],["$","div","Reserve division, Second Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Reserve division, Second Corps"}],["$","span",null,{"children":"John B. Gordon"}],["$","small",null,{"children":"Organized the counterattack that stopped Hancock’s advance"}]]}],["$","div","First Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"First Corps"}],["$","span",null,{"children":"Richard H. Anderson"}],["$","small",null,{"children":"Held Laurel Hill and the Confederate left"}]]}],["$","div","Division west of the Po River",{"className":"command-entry","children":[["$","strong",null,{"children":"Division west of the Po River"}],["$","span",null,{"children":"William Mahone"}],["$","small",null,{"children":"Sent reinforcements into the Mule Shoe fighting"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","chi