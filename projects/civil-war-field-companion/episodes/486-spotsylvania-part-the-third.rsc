,null,{"children":"About 19,000"}],"$undefined"]}],["$","div","Distance to the Confederate works",{"children":[["$","span",null,{"children":"Distance to the Confederate works"}],["$","strong",null,{"children":"About 1,400 yards"}],"$undefined"]}],["$","div","Attack began",{"children":[["$","span",null,{"children":"Attack began"}],["$","strong",null,{"children":"4:45 a.m., May 12"}],"$undefined"]}],["$","div","Confederate guns captured",{"children":[["$","span",null,{"children":"Confederate guns captured"}],["$","strong",null,{"children":"20"}],"$undefined"]}],["$","div","Confederate prisoners captured",{"children":[["$","span",null,{"children":"Confederate prisoners captured"}],["$","strong",null,{"children":"About 3,000"}],"$undefined"]}],["$","div","Duration of close fighting",{"children":[["$","span",null,{"children":"Duration of close fighting"}],["$","strong",null,{"children":"About 20 hours"}],"$undefined"]}],["$","div","U.S. casualties on May 12",{"children":[["$","span",null,{"children":"U.S. casualties on May 12"}],["$","strong",null,{"children":"More than 6,000"}],"$undefined"]}],["$","div","Confederate losses on May 12",{"children":[["$","span",null,{"children":"Confederate losses on May 12"}],["$","strong",null,{"children":"At least 8,000"}],["$","small",null,{"children":"At least 4,000 killed or wounded and about 4,000 captured in the episode’s count"}]]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Troop positions at th