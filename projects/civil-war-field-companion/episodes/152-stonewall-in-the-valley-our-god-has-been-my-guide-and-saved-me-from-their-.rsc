d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",152," · ","May 30–June 7, 1862"," · ","The Shenandoah Valley and Page Valley in Virginia, from Winchester and Strasburg south along the Valley Turnpike and Luray Road to Harrisonburg, Cross Keys, and Port Republic"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: \"OUR GOD HAS BEEN MY GUIDE AND SAVED ME FROM THEIR GRASP\""}],["$","span",null,{"className":"result-label","children":"Jackson escaped the attempted United States convergence at Strasburg and withdrew south under pressure from Frémont west of Massanutten Mountain and Shields to the east. Confederate bridge destruction, the paved Valley Turnpike, heavy rain, and hesitant Federal movement helped keep the two pursuing columns apart. Jackson then turned southeast at Harrisonburg and concentrated near Port Republic, where he occupied a central position from which he could fight the separated columns in turn. The June 6 rear-guard engagement near Harrisonburg delayed Frémont but cost the Confederacy Turner Ashby, who was killed while leading infantry on foot. The battles of Cross Keys and Port Republic fall outside this episode and begin the next installment."}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"May 30–June 7, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"The Shenandoah Valley and Page Valley in Virginia, from Winchester and Strasburg south along the Valley Turnpike and Luray Road to Harrisonburg, Cross Keys, and Port Republic"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Jackson escaped the attempted United States convergence at Strasburg and withdrew south under pressure from Frémont west of Massanutten Mountain and Shields to the east. Confederate bridge destruction, the paved Valley Turnpike, heavy rain, and hesitant Federal movement helped keep the two pursuing columns apart. Jackson then turned southeast at Harrisonburg and concentrated near Port Republic, where he occupied a central position from which he could fight the separated columns in turn. The June 6 rear-guard engagement near Harrisonburg delayed Frémont but cost the Confederacy Turner Ashby, who was killed while leading infantry on foot. The battles of Cross Keys and Port Republic fall outside this episode and begin the next installment."}]]}]]}],false,"$Lf","$undefined"]}],"$L10","$L11","$L12",false,"$L13","$L14","$L15","$L16","$L17","$L18"]}]]}]
