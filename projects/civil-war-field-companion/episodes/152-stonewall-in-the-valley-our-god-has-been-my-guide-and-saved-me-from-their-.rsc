13:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","National strategic direction-President Abraham Lincoln / Secretary Edwin M. Stanton",{"className":"command-entry","children":[["$","strong",null,{"children":"National strategic direction"}],["$","span",null,{"children":"President Abraham Lincoln / Secretary Edwin M. Stanton"}],["$","small",null,{"children":"Set the attempted convergence against Jackson and communicated separately with McDowell and Frémont, contributing to a divided field command"}]]}],["$","div","Department of the Rappahannock-Maj. Gen. Irvin McDowell",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Rappahannock"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Supervised Shields from the east and consented to the renewed movement south through the Luray Valley after Jackson escaped Strasburg"}]]}],["$","div","Division under McDowell, eastern arm-Brig. Gen. James Shields",{"className":"command-entry","children":[["$","strong",null,{"children":"Division under McDowell, eastern arm"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"Advanced from Front Royal through the Luray Valley; delayed on May 31 and later attempted to get ahead of Jackson near Port Republic"}]]}],["$","div","Mountain Department, western arm-Maj. Gen. John C. Frémont",{"className":"command-entry","children":[["$","strong",null,{"children":"Mountain Department, western arm"}],["$","span",null,{"children":"Maj. Gen. John C. Frémont"}],["$","small",null,{"children":"Approached Strasburg from the west, pursued south along the Valley Turnpike, reached Harrisonburg on June 6, and sent Milroy toward Cross Keys on June 7"}]]}],["$","div","Cavalry brigade from McDowell, attached to Frémont-Brig. Gen. George D. Bayard",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry brigade from McDowell, attached to Frémont"}],["$","span",null,{"children":"Brig. Gen. George D. Bayard"}],["$","small",null,{"children":"Temporarily joined Frémont after Strasburg and directed mounted troops pressing Jackson’s rear, including the 1st New Jersey Cavalry in the June 6 action near Harrisonburg"}]]}],["$","div","1st New Jersey Cavalry-Col. Sir Percy Wyndham",{"className":"command-entry","children":[["$","strong",null,{"children":"1st New Jersey Cavalry"}],["$","span",null,{"children":"Col. Sir Percy Wyndham"}],["$","small",null,{"children":"Led the cavalry attack near Good’s Farm and was captured when the charge struck the Confederate rear guard"}]]}],"$L22","$L23"]]}],"$L24"]}],"$L25"]]]}]
14:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. Turner Ashby",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Turner Ashby"}],["$","p",null,{"children":[["$","strong",null,{"children":["Cavalry commander and rear-guard leader","."]}]," ","Killed in action on June 6, 1862, near Good’s Farm southeast of Harrisonburg after his horse was shot and he led infantry forward on foot. The fatal shooter is unknown."]}]]}],["$","article","Gen. Joseph E. Johnston",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Gen. Joseph E. Johnston"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the Confederate force defending Richmond","."]}]," ","Seriously wounded at Seven Pines on May 31, outside this episode’s Valley operations; he survived. His incapacity led to Robert E. Lee assuming command on June 1."]}]]}]]}]]}]
15:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L26","/images/ep152-hotchkiss-valley-campaign-map.jpg",{"image":"/images/ep152-hotchkiss-valley-campaign-map.jpg","alt":"Nine-map proof sheet illustrating Jackson’s 1862 Valley Campaign.","caption":"Jedediah Hotchkiss and D. C. Humphreys prepared this 1880 proof sheet for William Allan’s campaign history. It includes an overview of the Valley and a panel of the Harrisonburg–Cross Keys–Port Republic region.","name":"Nine-map proof sheet illustrating Jackson’s 1862 Valley Campaign.","source":"https://www.loc.gov/item/99448346/","credit":"$undefined"}],["$","$L26","/images/ep152-turner-ashby.jpg",{"image":"/images/ep152-turner-ashby.jpg","alt":"Engraved portrait of Confederate cavalry commander Turner Ashby.","caption":"Ashby directed the Confederate rear guard during the retreat. He was killed near Harrisonburg on June 6 after a cavalry clash expanded into an infantry engagement.","name":"Engraved portrait of Confederate cavalry commander Turner Ashby.","source":"https://www.loc.gov/item/2002725241/","credit":"$undefined"}],["$","$L26","/images/ep152-stonewall-jackson.jpg",{"image":"/images/ep152-stonewall-jackson.jpg","alt":"Civil War-era photographic portrait of Confederate general Thomas J. Stonewall Jackson.","caption":"Jackson used the Valley Turnpike, bridge destruction, and the geography around Massanutten to escape the attempted convergence and reach Port Republic.","name":"Civil War-era photographic portrait of Confederate general Thomas J. Stonewall Jackson.","source":"https://www.loc.gov/item/2018670326/","credit":"$undefined"}],["$","$L26","/images/ep152-john-fremont.jpg",{"image":"/images/ep152-john-fremont.jpg","alt":"Photographic portrait of United States general John C. Frémont.","caption":"Frémont approached Strasburg from the west and then pursued Jackson south on the Valley side of Massanutten Mountain.","name":"Photographic portrait of United States general John C. Frémont.","source":"https://www.loc.gov/item/2017896011/","credit":"$undefined"}],["$","$L26","/images/ep152-james-shields-winchester.jpg",{"image":"/images/ep152-james-shields-winchester.jpg","alt":"Nineteenth-century lithograph depicting United States general James Shields at Winchester.","caption":"This historical print depicts Shields at the March 1862 Battle of Winchester, not during the May–June pursuit. In this episode he commanded the eastern Federal column moving through the Luray Valley.","name":"Nineteenth-century lithograph depicting United States general James Shields at Winchester.","source":"https://www.loc.gov/item/2001700087/","credit":"$undefined"}]]}]]}]
