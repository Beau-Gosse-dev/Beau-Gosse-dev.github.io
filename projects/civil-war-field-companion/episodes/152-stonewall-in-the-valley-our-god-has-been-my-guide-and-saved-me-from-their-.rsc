24:["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of the Valley-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Valley"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Directed the retreat through Strasburg, ordered bridge destruction, turned southeast at Harrisonburg, and concentrated around Port Republic"}]]}],["$","div","Division commander-Maj. Gen. Richard S. Ewell",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Helped cover the June 1 passage at Strasburg and by June 7 occupied the approach near Cross Keys between Frémont and Port Republic"}]]}],["$","div","Jackson’s division / Stonewall Brigade-Brig. Gen. Charles S. Winder",{"className":"command-entry","children":[["$","strong",null,{"children":"Jackson’s division / Stonewall Brigade"}],["$","span",null,{"children":"Brig. Gen. Charles S. Winder"}],["$","small",null,{"children":"Brought the exhausted brigade south from the Harpers Ferry demonstration and through Strasburg at noon on June 1"}]]}],["$","div","Cavalry and rear guard-Brig. Gen. Turner Ashby",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry and rear guard"}],["$","span",null,{"children":"Brig. Gen. Turner Ashby"}],["$","small",null,{"children":"Screened the retreat, contested bridge crossings, and led the June 6 rear-guard action near Harrisonburg, where he was killed"}]]}],["$","div","1st Maryland Infantry, Confederate States-Col. Bradley T. Johnson",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Maryland Infantry, Confederate States"}],["$","span",null,{"children":"Col. Bradley T. Johnson"}],["$","small",null,{"children":"Rejoined Jackson through Strasburg and fought with the rear guard near Harrisonburg on June 6"}]]}],["$","div","58th Virginia Infantry-Col. Samuel H. Letcher",{"className":"command-entry","children":[["$","strong",null,{"children":"58th Virginia Infantry"}],["$","span",null,{"children":"Col. Samuel H. Letcher"}],["$","small",null,{"children":"Commanded the regiment engaged with Federal cavalry and the Pennsylvania Bucktails near Good’s Farm and Chestnut Ridge"}]]}]]]}]
