f:["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Confederate impediments",{"children":[["$","th",null,{"scope":"row","children":"Confederate impediments"}],["$","td",null,{"children":["A seven-mile wagon train and nearly 2,000 prisoners slowed the withdrawal",["$","small",null,{"style":{"display":"block"},"children":"These are the episode’s figures. The 21st Virginia guarded the prisoners. The exact length of a moving train and number present at any instant cannot be reconstructed with precision."}]]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/05/08/civil-war-podcast-episode-152/",{"href":"https://civilwarpodcast.org/2016/05/08/civil-war-podcast-episode-152/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 152 page"]}],["$","a","https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm",{"href":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Jackson’s 1862 Campaign in the Shenandoah Valley"]}],["$","a","https://www.nps.gov/articles/000/battle-of-cross-keys.htm",{"href":"https://www.nps.gov/articles/000/battle-of-cross-keys.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of Cross Keys"]}],["$","a","https://www.nps.gov/articles/000/battle-of-port-republic.htm",{"href":"https://www.nps.gov/articles/000/battle-of-port-republic.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of Port Republic"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://ehistory.osu.edu/books/official-records/015",{"href":"https://ehistory.osu.edu/books/official-records/015","target":"_blank","rel":"noreferrer","children":[" · ","Primary source collection: Official Records, Series I, Volume XII, Part I"]}],["$","a","https://ehistory.osu.edu/books/official-records/018",{"href":"https://ehistory.osu.edu/books/official-records/018","target":"_blank","rel":"noreferrer","children":[" · ","Primary correspondence collection: Official Records, Series I, Volume XII, Part III"]}],["$","a","https://encyclopediavirginia.org/entries/shenandoah-valley-campaign-of-1862/",{"href":"https://encyclopediavirginia.org/entries/shenandoah-valley-campaign-of-1862/","target":"_blank","rel":"noreferrer","children":[" · ","Encyclopedia Virginia: Shenandoah Valley Campaign of 1862"]}],["$","a","https://encyclopediavirginia.org/entries/ashby-turner-1828-1862/",{"href":"https://encyclopediavirginia.org/entries/ashby-turner-1828-1862/","target":"_blank","rel":"noreferrer","children":[" · ","Encyclopedia Virginia: Turner Ashby"]}],["$","a","https://www.shenandoahatwar.org/turner-ashby",{"href":"https://www.shenandoahatwar.org/turner-ashby","target":"_blank","rel":"noreferrer","children":[" · ","Shenandoah Valley Battlefields National Historic District: Turner Ashby"]}],["$","a","https://www.dhr.virginia.gov/historic-registers/115-5063/",{"href":"https://www.dhr.virginia.gov/historic-registers/115-5063/","target":"_blank","rel":"noreferrer","childr