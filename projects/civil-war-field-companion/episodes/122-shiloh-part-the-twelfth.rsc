d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",122," · ","April 6, 1862, about 2:30 p.m. to 6 p.m.; later interpretation of the battle"," · ","The Hornet’s Nest, the ridge west of Pittsburg Landing, Dill Branch, and the Tennessee River, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Twelfth)"}],["$","span",null,{"className":"result-label","children":"Grant ordered chief of staff Joseph D. Webster to build a final defensive line near Pittsburg Landing. Webster placed five 24-pounder siege guns near the Corinth Road and collected field artillery around them. Hurlbut, Sherman, McClernand, and survivors from Wallace’s and Prentiss’s divisions joined the line as they withdrew. By late afternoon, the position extended about 2,500 yards from the river and held roughly 18,000 men according to the episode; the NPS estimates nearly 20,000 before Buell’s troops landed. The gunboats Tyler and Lexington supported the left flank. The Hornet’s Nest stand delayed some Confederate formations, but the final line was already strong before its defenders surrendered, and modern historians dispute the older claim that the stand alone saved Grant’s army"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 6, 1862, about 2:30 p.m. to 6 p.m.; later interpretation of the battle"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"The Hornet’s Nest, the ridge west of Pittsburg Landing, Dill Branch, and the Tennessee River, Tennessee"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Grant ordered chief of staff Joseph D. Webster to build a final defensive line near Pittsburg Landing. Webster placed five 24-pounder siege guns near the Corinth Road and collected field artillery around them. Hurlbut, Sherman, McClernand, and survivors from Wallace’s and Prentiss’s divisions joined the line as they withdrew. By late afternoon, the position extended about 2,500 yards from the river and held roughly 18,000 men according to the episode; the NPS estimates nearly 20,000 before Buell’s troops landed. The gunboats Tyler and Lexington supported the left flank. The Hornet’s Nest stand delayed some Confederate formations, but the final line was already strong before its defenders surrendered, and modern historians dispute the older claim that the stand alone saved Grant’s army"}]]}]]}],false,false,"$undefined"]}],"$Lf","$L10","$L11",false,"$L12","$L13","$L14","$L15","$L16","$L17"]}]]}]
