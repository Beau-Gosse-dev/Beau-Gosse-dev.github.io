1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",122," · ","April 6, 1862, about 2:30 p.m. to 6 p.m.; later interpretation of the battle"," · ","The Hornet’s Nest, the ridge west of Pittsburg Landing, Dill Branch, and the Tennessee River, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Twelfth)"}],["$","span",null,{"className":"result-label","children":"Grant ordered chief of staff Joseph D. Webster to build a final defensive line near Pittsburg Landing. Webster placed five 24-pounder siege guns near the Corinth Road and collected field artillery around them. Hurlbut, Sherman, McClernand, and survivors from Wallace’s and Prentiss’s divisions joined the line as they withdrew. By late afternoon, the position extended about 2,500 yards from the river and held roughly 18,000 men according to the episode; the NPS estimates nearly 20,000 before Buell’s troops landed. The gunboats Tyler and Lexington supported the left flank. The Hornet’s Nest stand delayed some Confederate formations, but the final line was already strong before its defenders surrendered, and modern historians dispute the older claim that the stand alone saved Grant’s army"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3685202082.mp3?updated=1695211624","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Final line started",{"children":[["$","span",null,{"children":"Final line started"}],["$","strong",null,{"children":"About 2:30 p.m. under Colonel Joseph D. Webster"}],"$undefined"]}],["$","div","Siege artillery",{"children":[["$","span",null,{"children":"Siege artillery"}],["$","strong",null,{"children":"Five 24-pounder guns placed near the Corinth Road"}],"$undefined"]}],["$","div","Field artillery",{"children":[["$","span",null,{"children":"Field artillery"}],["$","strong",null,{"children":"Podcast estimate: about 40 additional guns; NPS total: about 50 guns"}],"$undefined"]}],["$","div","Line length",{"children":[["$","span",null,{"children":"Line length"}],["$","strong",null,{"children":"About 2,500 yards"}],"$undefined"]}],["$","div","Infantry strength",{"children":[["$","span",null,{"children":"Infantry strength"}],["$","strong",null,{"children":"Podcast estimate: about 18,000; NPS: nearly 20,000 before Buell landed"}],"$undefined"]}],["$","div","Left flank",{"children":[["$","span",null,{"children":"Left flank"}],["$","strong",null,{"children":"Anchored on the Tennessee River above Pittsburg Landing"}],"$undefined"]}],["$","div","Right flank",{"children":[["$","span",null,{"children":"Right flank"}],["$","strong",null,{"children":"Sherman facing southwest and covering Lew Wallace’s expected approach"}],"$undefined"]}],["$","div","Naval support",{"children":[["$","span",null,{"children":"Naval support"}],["$","strong",null,{"children":"Timberclads Tyler and Lexington, using 8-inch and 32-pounder guns"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],"$Le","$Lf","$L10"]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17"]}]]}]
