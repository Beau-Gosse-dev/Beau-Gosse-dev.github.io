3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"#122 SHILOH (Part the Twelfth) · Field Companion"}],["$","meta","1",{"name":"description","content":"In which we continue telling the story of the Battle of Shiloh, which took place on April 6-7, 1862. In this episode we look at the legend of the Hornets' Nest and then discuss the formation of Grant's last line of defense."}],["$","meta","2",{"property":"og:title","content":"#122 SHILOH (Part the Twelfth) · Field Companion"}],["$","meta","3",{"property":"og:description","content":"In which we continue telling the story of the Battle of Shiloh, which took place on April 6-7, 1862. In this episode we look at the legend of the Hornets' Nest and then discuss the formation of Grant's last line of defense."}],["$","meta","4",{"name":"twitter:card","content":"summary"}],["$","meta","5",{"name":"twitter:title","content":"#122 SHILOH (Part the Twelfth) · Field Companion"}],["$","meta","6",{"name":"twitter:description","content":"In which we continue telling the story of the Battle of Shiloh, which took place on April 6-7, 1862. In this episode we look at the legend of the Hornets' Nest and then discuss the formation of Grant's last line of defense."}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["episodes","122-shiloh-part-the-twelfth"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"episodes","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"childr