rc":"/projects/civil-war-field-companion/images/shiloh-grants-last-line.svg","alt":"Map of Grant’s final line and naval support near Pittsburg Landing","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Grant’s final defensive line"}],["$","span",null,{"children":"Webster anchored the center on massed artillery near the Corinth Road. The line curved from the river west and north, with Hurlbut near the guns, McClernand and Sherman to the right, and gunboats covering Dill Branch."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/shiloh-grants-last-line.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ","$L18"]}],"$L19"]}],"$undefined"]}]]}],"$L1a"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode reviews the Hornet’s Nest surrender",{"className":"moment","children":[["$","$L1b",null,{"seconds":69,"label":"1:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode reviews the Hornet’s Nest surrender"}],["$","p",null,{"children":"Wallace was mortally wounded, and Prentiss and about 2,200 men from the 2nd and 6th Divisions were captured."}]]}]]}],["$","div","Prentiss promoted a postwar interpretation",{"className":"moment","children":[["$","$L1b",null,{"seconds":136,"label":"2:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Prentiss promoted a postwar interpretation"}],["$","p",null,{"children":"Prentiss argued that the Hornet’s Nest stand gave Grant time to build the final defensive line and therefore saved the army."}]]}]]}],["$","div","Both flanks had withdrawn by about 4:30 p.m.",{"className":"moment","children":[["$","$L1b",null,{"seconds":207,"label":"3:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both flanks had withdrawn by about 4:30 p.m."}],["$","p",null,{"children":"Sherman, McClernand, and Hurlbut moved toward the final line while Wallace and Prentiss continued holding the center."}]]}]]}],["$","div","The final line was already strong by 3 p.m.",{"className":"moment","children":[["$","$L1b",null,{"seconds":294,"label":"4:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"The final line was already strong by 3 p.m."}],["$","p",null,{"children":"Additional withdrawn units continued joining the position before the Hornet’s Nest surrendered."}]]}]]}],["$","div","The stand delayed the Confederate concentration",{"className":"moment","children":[["$","$L1b",null,{"seconds":316,"label":"5:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"The stand delayed the Confederate concentration"}],["$","p",null,{"children":"Confederate forces focused on surrounding the center, but the captured defenders were then unavailable to reinforce Grant’s line."}]]}]]}],["$","div","David W. Reed shaped later battlefield interpretation",{"className":"moment","children":[["$","$L1b",null,{"seconds":392,"label":"6:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"David W. Reed shaped later battlefield interpretation"}],["$","p",null,{"children":"The wounded 12th Iowa veteran later became historian of the Shiloh park commission and emphasized the Hornet’s Nest in his published history."}]]}]]}],["$","div","The episode examines Grant’s responsibility",{"className":"moment","children":[["$","$L1b",null,{"seconds":532,"label":"8:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode examines Grant’s responsibility"}],["$","p",null,{"children":"Grant’s last order to Prentiss was to hold. The episode argues that he should have sent a new order after the adjacent divisions withdrew."}]]}]]}],["$","div","Webster was ordered to form the last line",{"className":"moment","children":[["$","$L1b",null,{"seconds":615,"label":"10:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Webster was ordered to form the last line"}],["$","p",null,{"children":"Grant assigned his chief of staff to collect artillery and available infantry near Pittsburg Landing."}]]}]]}],["$","div","Webster positioned the siege guns",{"className":"moment","children":[["$","$L1b",null,{"seconds":815,"label":"13:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Webster positioned the siege guns"}],["$","p",null,{"children":"Starting around 2:30 p.m., he placed five 24-pounders across the likely approach along the Corinth Road and added available field batteries."}]]}]]}],["$","div","Withdrawn divisions joined the line",{"className":"moment","children":[["$","$L1b",null,{"seconds":926,"label":"15:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Withdrawn divisions joined the line"}],["$","p",null,{"children":"Hurlbut rallied his division near the artillery. Sherman and McClernand formed farther right, and escaped fragments of the 2nd and 6th Divisions also joined."}]]}]]}],"$L1c","$L1d","$L1e","$L1f"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Tennessee"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Ordered the final line formed and left naval fire decisions to the gunboat commanders"}]]}],["$","div","Chief of staff and artillery coordinator",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief of staff and artillery coordinator"}],["$","span",null,{"children":"Joseph D. Webster"}],["$","small",null,{"children":"Placed the siege guns, collected field batteries, and organized the defensive position near Pittsburg Landing"}]]}],["$","div","4th Division",{"className":"command-entry","children":[["$","strong",null,{"children":"4th Division"}],["$","span",null,{"children":"Stephen A. Hurlbut"}],["$","small",null,{"children":"Rallied infantry to support Webster’s artillery"}]]}],["$","div","1st Division",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division"}],["$","span",null,{"children":"John A. McClernand"}],["$","small",null,{"children":"Held the central-right section after withdrawing"}]]}],["$","div","5th Division",{"className":"command-entry","children":[["$","strong",null,{"children":"5th Division"}],["$","span",null,{"children":"William T. Sherman"}],["$","small",null,{"children":"Held the right flank and covered the route expected from Lew Wallace"}]]}],["$","div","USS Tyler / USS Lexington",{"className":"command-entry","children":[["$","strong",null,{"children":"USS Tyler / USS Lexington"}],["$","span",null,{"children":"William Gwin / James W. Shirk"}],["$","small",null,{"children":"Silenced Confederate batteries and fired toward Dill Branch"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of the Mississippi",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Mississippi"}],["$","span",null,{"children":"P.G.T. Beauregard"}],["$","small",null,{"children":"Commanded the army after Albert Sidney Johnston’s death"}]]}],["$","div","Late-afternoon field direction",{"className":"command-entry","children":[["$","strong",null,{"children":"Late-afternoon field direction"}],["$","span",null,{"children":"Braxton Bragg / Leonidas Polk"}],["$","small",null,{"children":"Reorganized units after the Hornet’s Nest surrender and prepared another advance"}]]}],["$","div","Brigades on the Confederate right",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigades on the Confederate right"}],["$","span",null,{"children":"James R. Chalmers / John K. Jackson"}],["$","small",null,{"children":"Advanced toward Dill Branch and the United States left near 6 p.m."}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Ulysses S. Grant",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Ulysses S. Grant"}],["$","p",null,{"children":"Ordered a final defensive line near Pittsburg Landing but did not send Wallace and Prentiss a documented withdrawal order"}]]}]]}],["$","article","Joseph D. Webster",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JD"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Joseph D. Webster"}],["$","p",null,{"children":"Grant’s chief of staff; organized the massed artillery and infantry line above Pittsburg Landing"}]]}]]}],"$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}]]}]
