11:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Shiloh battlefield today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/shiloh-nps-auto-tour-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Shiloh battlefield today at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-nps-auto-tour-map.jpg","alt":"National Park Service map of the Shiloh battlefield","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Shiloh battlefield today"}],["$","span",null,{"children":"The NPS map shows Pittsburg Landing, the Corinth Road, Dill Branch, the Hornet’s Nest, and the roads used by the withdrawing divisions."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/shiloh-nps-auto-tour-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/shil/planyourvisit/maps.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$11:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Why the Hornet’s Nest was cut off",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"c