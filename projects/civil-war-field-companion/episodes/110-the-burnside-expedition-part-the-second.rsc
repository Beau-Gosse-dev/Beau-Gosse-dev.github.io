1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",110," · ","February 10–July 6, 1862; Battle of New Bern March 14 and Fort Macon bombardment April 25"," · ","Elizabeth City, Winton, New Bern, Beaufort, Morehead City, and Fort Macon, North Carolina"]}],["$","h1",null,{"children":"THE BURNSIDE EXPEDITION (Part the Second)"}],["$","span",null,{"className":"result-label","children":"United States Army and Navy forces destroyed the remaining Confederate gunboats near Elizabeth City, captured New Bern after breaking the Confederate line at the railroad brickyard, and forced Fort Macon to surrender. New Bern remained a United States base for the rest of the war, but Burnside left with 7,000 men in July before attacking the railroad junction at Goldsboro"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4206806299.mp3?updated=1695129303","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Battle of New Bern",{"children":[["$","span",null,{"children":"Battle of New Bern"}],["$","strong",null,{"children":"March 14, 1862; United States victory after about four hours"}],"$undefined"]}],["$","div","Burnside’s force at New Bern",{"children":[["$","span",null,{"children":"Burnside’s force at New Bern"}],["$","strong",null,{"children":"About 11,000 soldiers supported by 13 warships"}],"$undefined"]}],["$","div","Branch’s force at New Bern",{"children":[["$","span",null,{"children":"Branch’s force at New Bern"}],["$","strong",null,{"children":"About 4,500 North Carolina troops"}],"$undefined"]}],["$","div","Confederate defensive line",{"children":[["$","span",null,{"children":"Confederate defensive line"}],["$","strong",null,{"children":"About one mile from Fort Thompson to the railroad, with a gap near the brickyard"}],"$undefined"]}],["$","div","New Bern losses stated in episode",{"children":[["$","span",null,{"children":"New Bern losses stated in episode"}],["$","strong",null,{"children":"U.S.: 90 killed, 380 wounded; Confederate: 64 killed, 101 wounded, 413 missing"}],"$undefined"]}],["$","div","Fort Macon",{"children":[["$","span",null,{"children":"Fort Macon"}],["$","strong",null,{"children":"Bombarded April 25; its garrison capitulated April 26"}],"$undefined"]}],["$","div","Coastal result",{"children":[["$","span",null,{"children":"Coastal result"}],["$","strong",null,{"children":"New Bern, Morehead City, Beaufort, and Fort Macon entered United States control"}],"$undefined"]}],["$","div","Unfinished objective",{"children":[["$","span",null,{"children":"Unfinished objective"}],["$","strong",null,{"children":"The expedition did not advance 60 miles inland to the Goldsboro railroad junction"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href"