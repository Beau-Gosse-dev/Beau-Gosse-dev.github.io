f:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The North Carolina coast and the campaign objectives"}],["$","span",null,{"children":"The episode follows operations from Roanoke Island and Elizabeth City south to New Bern, then southeast to Morehead City, Beaufort, and Fort Macon. Goldsboro, the intended inland objective, lay west of New Bern."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
