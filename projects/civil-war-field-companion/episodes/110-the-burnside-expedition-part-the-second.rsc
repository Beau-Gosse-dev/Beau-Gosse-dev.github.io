11:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.libsyn.com/110-the-burnside-expedition-part-the-second",{"href":"https://civilwarpodcast.libsyn.com/110-the-burnside-expedition-part-the-second","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 110"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=NC003",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=NC003","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of New Bern"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=nc004",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=nc004","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Fort Macon"]}],["$","a","https://www.nps.gov/people/lawrence-o-brian-branch.htm",{"href":"https://www.nps.gov/people/lawrence-o-brian-branch.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Lawrence O’Brian Branch"]}],["$","a","https://www.history.navy.mil/research/library/online-reading-room/title-list-alphabetically/n/navy-civil-war-chronology.html",{"href":"https://www.history.navy.mil/research/library/online-reading-room/title-list-alphabetically/n/navy-civil-war-chronology.html","target":"_blank","rel":"noreferrer","children":[" · ","Naval History and Heritage Command: Navy Civil War chronology"]}],["$","a","https://www.loc.gov/item/99447474/",{"href":"https://www.loc.gov/item/99447474/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Route to New Bern"]}],["$","a","https://www.loc.gov/pictures/item/90709073/",{"href":"https://www.loc.gov/pictures/item/90709073/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Battle of New Bern lithograph"]}],["$","a","https://www.loc.gov/item/99447458/",{"href":"https://www.loc.gov/item/99447458/","target":