d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",522," · ","June 21–27, 1864"," · ","Dead Angle, Cheatham Hill, Georgia"]}],["$","h1",null,{"children":"THE ATLANTA CAMPAIGN (Part the Twenty-first)"}],["$","span",null,{"className":"result-label","children":"Both armies prepared for the XIV Corps assault against Cheatham Hill on June 27"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"June 21–27, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Dead Angle, Cheatham Hill, Georgia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Both armies prepared for the XIV Corps assault against Cheatham Hill on June 27"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"June 21–27, 1864","place":"Dead Angle, Cheatham Hill, Georgia","result":"Both armies prepared for the XIV Corps assault against Cheatham Hill on June 27","facts":[{"label":"Confederate position","value":"A shallow salient later called the Dead Angle"},{"label":"Defenders","value":"Vaughan’s and Maney’s Tennessee brigades in Cheatham’s division"},{"label":"Visibility from the works","value":"Only 25–40 yards in parts of the salient"},{"label":"Attacking force","value":"McCook’s and Mitchell’s brigades, Davis’s division, XIV Corps"},{"label":"Attack time","value":"8 a.m., June 27"},{"label":"Ammunition carried","value":"60 rounds per U.S. soldier"}],"maps":[{"title":"Troop movements at Kennesaw Mountain","caption":"The National Park Service map shows Thomas’s main attack in blue against Hardee’s Confederate line in red. The Dead Angle was at Cheatham Hill near the center of the attack.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm","image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map of troop movements at Kennesaw Mountain on June 27, 1864"},{"title":"Confederate positions across Kennesaw Mountain","caption":"This 1864 drawing shows Confederate artillery positions across Pigeon Hill, Little Kennesaw, and Big Kennesaw, north of Cheatham Hill.","source":"https://www.loc.gov/item/2004660525/","image":"/images/kennesaw-battlefield-drawing.jpg","alt":"1864 drawing of Confederate artillery positions across Kennesaw Mountain"},{"title":"Cheatham Hill today","caption":"The Dead Angle is preserved at Cheatham Hill in the southern part of Kennesaw Mountain National Battlefield Park.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.626%2C33.915%2C-84.576%2C33.958&layer=mapnik&marker=33.9334%2C-84.6039"}],"moments":[{"time":"1:16","audioTime":76,"title":"The episode turns to the Dead Angle","detail":"Cheatham’s division held the line south of Cleburne. The XIV Corps attack would strike a bend in that line at Cheatham Hill."},{"time":"2:54","audioTime":174,"title":"Cheatham occupied the Kennesaw line","detail":"Vaughan’s brigade moved into position on June 19, and the rest of Cheatham’s division followed on the night of June 20."},{"time":"3:41","audioTime":221,"title":"Maney had to bend his brigade line","detail":"The ridge ended beside a branch of John Ward Creek. Maney placed part of his brigade on a low hill and the remainder along ground facing south."},{"time":"4:16","audioTime":256,"title":"A gap and bend created a shallow salient","detail":"Cheatham’s two wings were separated by about 150 yards, and the connecting line projected west toward the U.S. position."},{"time":"4:36","audioTime":276,"title":"Engineers placed the works on the natural crest","detail":"The line stood a few yards behind the military crest. Parts of the slope therefore remained hidden from the Confederate defenders."},{"time":"6:07","audioTime":367,"title":"Visibility was restricted at the salient","detail":"Men on Vaughan’s left and Maney’s right could see only 25 to 40 yards. Farther north, visibility improved to about 75 yards."},{"time":"6:27","audioTime":387,"title":"The problem became clear on June 21","detail":"Daylight exposed the mistake, but U.S. artillery fire made rebuilding the line difficult. Cheatham kept the position and strengthened it."},{"time":"7:29","audioTime":449,"title":"A forward ridge covered the approach","detail":"A creek valley and ridge lay about 400 yards west of the works. Cheatham sent skirmishers forward to occupy the ridge."},{"time":"8:21","audioTime":501,"title":"U.S. troops captured the forward ridge","detail":"On June 23, Stanley’s division drove off the Confederate skirmishers and captured about 40 prisoners."},{"time":"8:50","audioTime":530,"title":"The 1st and 27th Tennessee counterattacked","detail":"Cheatham called for volunteers, but the consolidated regiment advanced together. It drove U.S. skirmishers back without retaking the ridge."},{"time":"9:40","audioTime":580,"title":"U.S. artillery struck the angle on June 24","detail":"Fire damaged the works and partly enfiladed Vaughan’s left. Confederate artillery remained concealed and did not answer."},{"time":"10:32","audioTime":632,"title":"The defenders rebuilt their earthworks","detail":"The Tennesseans added earth, rocks, timber, head logs, and firing steps. Fence rails inside the trench helped keep displaced head logs from falling on the men."},{"time":"11:19","audioTime":679,"title":"Obstacles were unevenly distributed","detail":"Vaughan’s front had abatis about 30 yards from the works. Maney’s position at the salient had less obstruction and more open ground."},{"time":"12:35","audioTime":755,"title":"Some Confederate regiments were very small","detail":"Several depleted Tennessee regiments had been consolidated. The combined 1st and 27th Tennessee probably had no more than 200 men present."},{"time":"14:26","audioTime":866,"title":"Confederate generals inspected the position","detail":"On June 26, Johnston, Hardee, and Cheatham visited the line. Cheatham and Hardee told the defenders the position had to be held."},{"time":"16:00","audioTime":960,"title":"George Gordon coordinated supporting fire","detail":"Gordon arranged for adjacent regiments to fire obliquely across one another’s fronts where the ground blocked each unit’s direct view."},{"time":"16:32","audioTime":992,"title":"Eight guns covered the attacking route","detail":"Cheatham placed artillery south of the salient so it could fire along the right flank of troops attacking the Dead Angle."},{"time":"17:00","audioTime":1020,"title":"Two XIV Corps brigades received the assault assignment","detail":"McCook was to attack the northern shoulder and apex; Mitchell was to attack the southern shoulder. Morgan’s brigade remained in support."},{"time":"17:41","audioTime":1061,"title":"U.S. troops prepared before dawn","detail":"The men were awakened at 4 a.m., ate breakfast, left their knapsacks, and carried haversacks, canteens, and 60 rounds."},{"time":"20:28","audioTime":1228,"title":"The bombardment began at 8 a.m.","detail":"XIV Corps artillery and guns from the XX Corps sector opened on Cheatham Hill, warning the defenders that the assault was beginning."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"John M. Palmer’s XIV Corps"},{"commander":"John M. Palmer","command":"XIV Corps","subordinates":"Jefferson C. Davis’s division"},{"commander":"Jefferson C. Davis","command":"2nd Division, XIV Corps","subordinates":"Daniel McCook Jr., John G. Mitchell, and James D. Morgan"},{"commander":"Daniel McCook Jr.","command":"1st Brigade","subordinates":"Assigned to the northern shoulder of the Dead Angle"},{"commander":"John G. Mitchell","command":"2nd Brigade","subordinates":"Assigned to the southern shoulder of the Dead Angle"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"William J. Hardee’s corps"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Benjamin F. Cheatham’s division"},{"commander":"Benjamin F. Cheatham","command":"Cheatham’s Division","subordinates":"Alfred J. Vaughan and George Maney"},{"commander":"Alfred J. Vaughan","command":"Vaughan’s Brigade","subordinates":"Held the northern shoulder of the salient"},{"commander":"George Maney","command":"Maney’s Brigade","subordinates":"Held the apex and southern shoulder"},{"commander":"George Gordon","command":"11th Tennessee Infantry","subordinates":"Coordinated oblique fire between regiments"}]}],"people":[{"name":"Benjamin F. Cheatham","role":"Commanded the Confederate division holding Cheatham Hill","side":"Confederacy"},{"name":"George Maney","role":"Commanded the Tennessee brigade at the apex and southern side of the Dead Angle","side":"Confederacy"},{"name":"Alfred J. Vaughan","role":"Commanded the Tennessee brigade north of the Dead Angle","side":"Confederacy"},{"name":"George Gordon","role":"11th Tennessee colonel who organized overlapping infantry fire","side":"Confederacy"},{"name":"Daniel McCook Jr.","role":"Commanded the U.S. brigade assigned to attack the northern shoulder","side":"United States"},{"name":"John G. Mitchell","role":"Commanded the U.S. brigade assigned to attack the southern shoulder","side":"United States"},{"name":"Sam Watkins","role":"1st Tennessee soldier whose memoir describes the bombardment and defense","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map showing the U.S. attacks and Confederate line at Kennesaw Mountain","caption":"Thomas’s main attack struck Hardee’s line at Cheatham Hill while U.S. forces attacked and demonstrated along the wider front.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"image":"/images/kennesaw-battlefield-drawing.jpg","alt":"Theodore R. Davis drawing of Confederate artillery positions at Kennesaw Mountain","caption":"A wartime drawing of the Confederate position across Kennesaw Mountain.","source":"https://www.loc.gov/item/2004660525/"}],"sources":[{"label":"Official Episode 522 page","url":"https://civilwarpodcast.org/2026/03/08/civil-war-podcast-episode-522/"},{"label":"National Park Service battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ga015"},{"label":"National Park Service troop movements map","url":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"label":"National Park Service Confederate order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/confederate-order-of-battle.htm"},{"label":"National Park Service Union order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/union-order-of-battle.htm"},{"label":"Library of Congress Kennesaw battlefield drawing","url":"https://www.loc.gov/item/2004660525/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
