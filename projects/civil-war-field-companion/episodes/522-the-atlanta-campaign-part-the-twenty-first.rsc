11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode turns to the Dead Angle",{"className":"moment","children":[["$","$L16",null,{"seconds":76,"label":"1:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode turns to the Dead Angle"}],["$","p",null,{"children":"Cheatham’s division held the line south of Cleburne. The XIV Corps attack would strike a bend in that line at Cheatham Hill."}]]}]]}],["$","div","Cheatham occupied the Kennesaw line",{"className":"moment","children":[["$","$L16",null,{"seconds":174,"label":"2:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cheatham occupied the Kennesaw line"}],["$","p",null,{"children":"Vaughan’s brigade moved into position on June 19, and the rest of Cheatham’s division followed on the night of June 20."}]]}]]}],["$","div","Maney had to bend his brigade line",{"className":"moment","children":[["$","$L16",null,{"seconds":221,"label":"3:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Maney had to bend his brigade line"}],["$","p",null,{"children":"The ridge ended beside a branch of John Ward Creek. Maney placed part of his brigade on a low hill and the remainder along ground facing south."}]]}]]}],["$","div","A gap and bend created a shallow salient",{"className":"moment","children":[["$","$L16",null,{"seconds":256,"label":"4:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"A gap and bend created a shallow salient"}],["$","p",null,{"children":"Cheatham’s two wings were separated by about 150 yards, and the connecting line projected west toward the U.S. position."}]]}]]}],["$","div","Engineers placed the works on the natural crest",{"className":"moment","children":[["$","$L16",null,{"seconds":276,"label":"4:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Engineers placed the works on the natural crest"}],["$","p",null,{"children":"The line stood a few yards behind the military crest. Parts of the slope therefore remained hidden from the Confederate defenders."}]]}]]}],["$","div","Visibility was restricted at the salient",{"className":"moment","children":[["$","$L16",null,{"seconds":367,"label":"6:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Visibility was restricted at the salient"}],["$","p",null,{"children":"Men on Vaughan’s left and Maney’s right could see only 25 to 40 yards. Farther north, visibility improved to about 75 yards."}]]}]]}],["$","div","The problem became clear on June 21",{"className":"moment","children":[["$","$L16",null,{"seconds":387,"label":"6:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The problem became clear on June 21"}],["$","p",null,{"children":"Daylight exposed the mistake, but U.S. artillery fire made rebuilding the line difficult. Cheatham kept the position and strengthened it."}]]}]]}],["$","div","A forward ridge covered the approach",{"className":"moment","children":[["$","$L16",null,{"seconds":449,"label":"7:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"A forward ridge covered the approach"}],["$","p",null,{"children":"A creek valley and ridge lay about 400 yards west of the works. Cheatham sent skirmishers forward to occupy the ridge."}]]}]]}],["$","div","U.S. troops captured the forward ridge",{"className":"moment","children":[["$","$L16",null,{"seconds":501,"label":"8:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops captured the forward ridge"}],["$","p",null,{"children":"On June 23, Stanley’s division drove off the Confederate skirmishers and captured about 40 prisoners."}]]}]]}],["$","div","The 1st and 27th Tennessee counterattacked",{"className":"moment","children":[["$","$L16",null,{"seconds":530,"label":"8:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 1st and 27th Tennessee counterattacked"}],["$","p",null,{"children":"Cheatham called for volunteers, but the consolidated regiment advanced together. It drove U.S. skirmishers back without retaking the ridge."}]]}]]}],["$","div","U.S. artillery struck the angle on June 24",{"className":"moment","children":[["$","$L16",null,{"seconds":580,"label":"9:40"}],"$L17"]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}]]}]
