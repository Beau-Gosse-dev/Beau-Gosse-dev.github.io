17:["$","div",null,{"children":[["$","h3",null,{"children":"U.S. artillery struck the angle on June 24"}],["$","p",null,{"children":"Fire damaged the works and partly enfiladed Vaughan’s left. Confederate artillery remained concealed and did not answer."}]]}]
18:["$","div","The defenders rebuilt their earthworks",{"className":"moment","children":[["$","$L16",null,{"seconds":632,"label":"10:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"The defenders rebuilt their earthworks"}],["$","p",null,{"children":"The Tennesseans added earth, rocks, timber, head logs, and firing steps. Fence rails inside the trench helped keep displaced head logs from falling on the men."}]]}]]}]
19:["$","div","Obstacles were unevenly distributed",{"className":"moment","children":[["$","$L16",null,{"seconds":679,"label":"11:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Obstacles were unevenly distributed"}],["$","p",null,{"children":"Vaughan’s front had abatis about 30 yards from the works. Maney’s position at the salient had less obstruction and more open ground."}]]}]]}]
1a:["$","div","Some Confederate regiments were very small",{"className":"moment","children":[["$","$L16",null,{"seconds":755,"label":"12:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Some Confederate regiments were very small"}],["$","p",null,{"children":"Several depleted Tennessee regiments had been consolidated. The combined 1st and 27th Tennessee probably had no more than 200 men present."}]]}]]}]
1b:["$","div","Confederate generals inspected the position",{"className":"moment","children":[["$","$L16",null,{"seconds":866,"label":"14:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate generals inspected the position"}],["$","p",null,{"children":"On June 26, Johnston, Hardee, and Cheatham visited the line. Cheatham and Hardee told the defenders the position had to be held."}]]}]]}]
1c:["$","div","George Gordon coordinated supporting fire",{"className":"moment","children":[["$","$L16",null,{"seconds":960,"label":"16:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"George Gordon coordinated supporting fire"}],["$","p",null,{"children":"Gordon arranged for adjacent regiments to fire obliquely across one another’s fronts where the ground blocked each unit’s direct view."}]]}]]}]
1d:["$","div","Eight guns covered the attacking route",{"className":"moment","children":[["$","$L16",null,{"seconds":992,"label":"16:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Eight guns covered the attacking route"}],["$","p",null,{"children":"Cheatham placed artillery south of the salient so it could fire along the right flank of troops attacking the Dead Angle."}]]}]]}]
1e:["$","div","Two XIV Corps brigades received the assault assignment",{"className":"moment","children":[["$","$L16",null,{"seconds":1020,"label":"17:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two XIV Corps brigades received the assault assignment"}],["$","p",null,{"children":"McCook was to attack the northern shoulder and apex; Mitchell was to attack the southern shoulder. Morgan’s brigade remained in support."}]]}]]}]
1f:["$","div","U.S. troops prepared before dawn",{"className":"moment","children":[["$","$L16",null,{"seconds":1061,"label":"17:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops prepared before dawn"}],["$","p",null,{"children":"The men were awakened at 4 a.m., ate breakfast, left their knapsacks, and carried haversacks, canteens, and 60 rounds."}]]}]]}]
20:["$","div","The bombardment began at 8 a.m.",{"className":"moment","children":[["$","$L16",null,{"seconds":1228,"label":"20:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The bombardment began at 8 a.m."}],["$","p",null,{"children":"XIV Corps artillery and guns from the XX Corps sector opened on Cheatham Hill, warning the defenders that the assault was beginning."}]]}]]}]
