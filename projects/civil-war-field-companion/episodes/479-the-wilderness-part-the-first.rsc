d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",479," · ","Spring 1864"," · ","Virginia theater: the Rapidan River, the Wilderness, Richmond, Bermuda Hundred, and the Shenandoah Valley"]}],["$","h1",null,{"children":"THE WILDERNESS (Part the First)"}],["$","span",null,{"className":"result-label","children":"Grant made Lee’s army the main U.S. objective in Virginia and paired the Army of the Potomac’s movement around Lee’s right with supporting offensives by Benjamin Butler and Franz Sigel. Meade’s staff planned to cross east of Lee and move through the Wilderness in one day before the Confederates could interfere. The Army of the Potomac and IX Corps fielded more than 116,000 men, compared with fewer than 64,000 in Lee’s army, but the U.S. force contained many inexperienced soldiers and short-term veterans. Lee correctly anticipated most of Grant’s Virginia plan but underestimated the size of the main army"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"Spring 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Virginia theater: the Rapidan River, the Wilderness, Richmond, Bermuda Hundred, and the Shenandoah Valley"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Grant made Lee’s army the main U.S. objective in Virginia and paired the Army of the Potomac’s movement around Lee’s right with supporting offensives by Benjamin Butler and Franz Sigel. Meade’s staff planned to cross east of Lee and move through the Wilderness in one day before the Confederates could interfere. The Army of the Potomac and IX Corps fielded more than 116,000 men, compared with fewer than 64,000 in Lee’s army, but the U.S. force contained many inexperienced soldiers and short-term veterans. Lee correctly anticipated most of Grant’s Virginia plan but underestimated the size of the main army"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units 