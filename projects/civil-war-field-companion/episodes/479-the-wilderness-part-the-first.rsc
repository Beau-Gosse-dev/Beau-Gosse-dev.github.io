13:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/overland-campaign-1864-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland Campaign","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The rivers, roads, and narrow corridor between Washington and Richmond shaped the campaign plan."}]]}],["$","figure","/images/ulysses-s-grant.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Grant coordinated three Virginia offensives while leaving day-to-day control of the Army of the Potomac to Meade."}]]}],["$","figure","/images/robert-e-lee-1864.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/robert-e-lee-1864.jpg","alt":"Portrait of Robert E. Lee","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Lee correctly anticipated most of the U.S. operational plan but underestimated the main army’s size."}]]}]]}]]}]
