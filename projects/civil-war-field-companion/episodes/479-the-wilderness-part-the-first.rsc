10:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2025/01/05/civil-war-podcast-episode-479/",{"href":"https://civilwarpodcast.org/2025/01/05/civil-war-podcast-episode-479/","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 479"]}],["$","a","https://www.nps.gov/frsp/learn/historyculture/wildspot.htm",{"href":"https://www.nps.gov/frsp/learn/historyculture/wildspot.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: History of the Battle of the Wilderness"]}],["$","a","https://www.nps.gov/media/photo/gallery.htm?id=F6B164DB-01BE-4E4E-A97CC65D8F0FD22E",{"href":"https://www.nps.gov/media/photo/gallery.htm?id=F6B164DB-01BE-4E4E-A97CC65D8F0FD22E","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Wilderness troop movement maps"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va047",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va047","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Port Walthall Junction and the Bermuda Hundred Campaign"]}],["$","a","https://www.loc.gov/item/99448882/",{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Overland Campaign map"]}]]}]
