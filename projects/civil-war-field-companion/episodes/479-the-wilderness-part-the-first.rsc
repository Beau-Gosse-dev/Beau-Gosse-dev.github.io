1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",479," · ","Spring 1864"," · ","Virginia theater: the Rapidan River, the Wilderness, Richmond, Bermuda Hundred, and the Shenandoah Valley"]}],["$","h1",null,{"children":"THE WILDERNESS (Part the First)"}],["$","span",null,{"className":"result-label","children":"Grant made Lee’s army the main U.S. objective in Virginia and paired the Army of the Potomac’s movement around Lee’s right with supporting offensives by Benjamin Butler and Franz Sigel. Meade’s staff planned to cross east of Lee and move through the Wilderness in one day before the Confederates could interfere. The Army of the Potomac and IX Corps fielded more than 116,000 men, compared with fewer than 64,000 in Lee’s army, but the U.S. force contained many inexperienced soldiers and short-term veterans. Lee correctly anticipated most of Grant’s Virginia plan but underestimated the size of the main army"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4908932906.mp3?updated=1736133835","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Army of the Potomac",{"children":[["$","span",null,{"children":"Army of the Potomac"}],["$","strong",null,{"children":"More than 100,000 men"}],"$undefined"]}],["$","div","Burnside’s IX Corps",{"children":[["$","span",null,{"children":"Burnside’s IX Corps"}],["$","strong",null,{"children":"About 19,200 men"}],"$undefined"]}],["$","div","Army of Northern Virginia",{"children":[["$","span",null,{"children":"Army of Northern Virginia"}],["$","strong",null,{"children":"Fewer than 64,000 men"}],"$undefined"]}],["$","div","Lee’s estimate of Meade",{"children":[["$","span",null,{"children":"Lee’s estimate of Meade"}],["$","strong",null,{"children":"About 75,000; roughly 36% low"}],"$undefined"]}],["$","div","Wilderness area",{"children":[["$","span",null,{"children":"Wilderness area"}],["$","strong",null,{"children":"About 70 square miles"}],"$undefined"]}],["$","div","Butler’s starting force",{"children":[["$","span",null,{"children":"Butler’s starting force"}],["$","strong",null,{"children":"About 21,500 plus 10,000 reinforcements"}],"$undefined"]}],["$","div","Bermuda Hundred to Richmond",{"children":[["$","span",null,{"children":"Bermuda Hundred to Richmond"}],["$","strong",null,{"children":"About 16 miles"}],"$undefined"]}],["$","div","Bermuda Hundred to Petersburg",{"children":[["$","span",null,{"children":"Bermuda Hundred to Petersburg"}],["$","strong",null,{"children":"About 8 miles"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],["$","sectio