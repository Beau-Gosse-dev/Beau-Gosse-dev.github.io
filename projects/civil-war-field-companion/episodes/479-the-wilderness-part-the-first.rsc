e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Virginia operations planned for 1864"}],["$","span",null,{"children":"Grant’s main army would cross the Rapidan east of Lee, Butler would move up the James to Bermuda Hundred, and Sigel would advance through the Shenandoah Valley and against the Virginia and Tennessee Railroad."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
