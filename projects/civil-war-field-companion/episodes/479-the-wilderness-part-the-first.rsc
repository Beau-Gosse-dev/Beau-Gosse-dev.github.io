10:["$","figure","The opening battlefield",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/wilderness-may5-noon-3pm-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The opening battlefield at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/wilderness-may5-noon-3pm-map.jpg","alt":"Detailed National Park Service map of the roads and terrain at the Battle of the Wilderness","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The opening battlefield"}],["$","span",null,{"children":"The first NPS movement map shows the limited road network inside the Wilderness: Orange Turnpike, Orange Plank Road, Germanna Plank Road, and Brock Road."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/wilderness-may5-noon-3pm-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/media/photo/gallery-item.htm?gid=F6B164DB-01BE-4E4E-A97CC65D8F0FD22E&id=17fa8c32-a2c7-4633-92e2-d76770d6fee4","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Grant planned simultaneous offensives",{"className":"moment","children":[["$","$L16",null,{"seconds":149,"label":"2:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant planned simultaneous offensives"}],["$","p",null,{"children":"The 1864 strategy called for pressure in several theaters so Confederate armies could not reinforce one another."}]]}]]}],["$","div","Lee’s army was the main eastern objective",{"className":"moment","children":[["$","$L16",null,{"seconds":180,"label":"3:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s army was the main eastern objective"}],["$","p",null,{"children":"Political and military considerations required the principal U.S. effort in Virginia to target the Army of Northern Virginia."}]]}]]}],["$","div","Virginia’s geography restricted movement",{"className":"moment","children":[["$","$L16",null,{"seconds":227,"label":"3:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia’s geography restricted movement"}],["$","p",null,{"children":"Chesapeake Bay, the mountains, and west-to-east rivers limited north–south routes and repeatedly favored defenders."}]]}]]}],["$","div","U.S. sea power created another approach",{"className":"moment","children":[["$","$L16",null,{"seconds":274,"label":"4:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. sea power created another approach"}],["$","p",null,{"children":"Federal control of the coast made it possible to land and supply troops southeast of Richmond instead of crossing every Virginia river overland."}]]}]]}],["$","div","Grant assigned forces in southeastern Virginia",{"className":"moment","children":[["$","$L16",null,{"seconds":384,"label":"6:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant assigned forces in southeastern Virginia"}],["$","p",null,{"children":"About 21,500 troops already defended Hampton Roads, and Grant added roughly 10,000 men from X Corps for offensive use."}]]}]]}],["$","div","Grant met Benjamin Butler",{"className":"moment","children":[["$","$L16",null,{"seconds":439,"label":"7:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant met Benjamin Butler"}],["$","p",null,{"children":"At Fort Monroe, Butler proposed moving by water up the James River and landing at Bermuda Hundred."}]]}]]}],["$","div","Bermuda Hundred threatened two cities",{"className":"moment","children":[["$","$L16",null,{"seconds":482,"label":"8:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bermuda Hundred threatened two cities"}],["$","p",null,{"children":"The peninsula lay near the Richmond–Petersburg railroad, about 16 miles from Richmond and eight miles from Petersburg."}]]}]]}],["$","div","Grant considered the main Rapidan movement",{"className":"moment","children":[["$","$L16",null,{"seconds":541,"label":"9:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant considered the main Rapidan movement"}],["$","p",null,{"children":"Lee’s army camped between Gordonsville and Orange Court House, covered the Rapidan fords, and protected important rail and Shenandoah Valley connections."}]]}]]}],["$","div","Grant rejected a frontal river attack",{"className":"moment","children":[["$","$L16",null,{"seconds":602,"label":"10:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant rejected a frontal river attack"}],["$","p",null,{"children":"The fortified Rapidan crossings were too strong. A movement around Lee’s western flank would also create serious supply problems."}]]}]]}],["$","div","Grant chose Lee’s eastern flank",{"className":"moment","children":[["$","$L16",null,{"seconds":636,"label":"10:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant chose Lee’s eastern flank"}],["$","p",null,{"children":"Crossing below Lee would be easier to supply and would keep open the possibility of cooperation with Butler."}]]}]]}],["$","div","Meade retained operational command",{"className":"moment","children":[["$","$L16",null,{"seconds":653,"label":"10:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade retained operational command"}],"$L17"]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a"]}]]}]
