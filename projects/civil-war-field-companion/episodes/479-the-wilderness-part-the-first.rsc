sName":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/99448882/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Overland Campaign map"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}]]}]]}]
15:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
17:["$","p",null,{"children":"Grant accompanied the Army of the Potomac but left its day-to-day management to George Meade."}]
18:["$","div","Andrew Humphreys designed the movement",{"className":"moment","children":[["$","$L16",null,{"seconds":728,"label":"12:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Andrew Humphreys designed the movement"}],["$","p",null,{"children":"Meade’s chief of staff planned the detailed turn around Lee’s right."}]]}]]}]
19:["$","div","The Wilderness was the main obstacle",{"className":"moment","children":[["$","$L16",null,{"seconds":738,"label":"12:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Wilderness was the main obstacle"}],["$","p",null,{"children":"Roughly 70 square miles of dense second-growth vegetation and few roads made organized movement difficult and favored defense."}]]}]]}]
1a:["$","div","The plan required a one-day passage",{"className":"moment","children":[["$","$L16",null,{"seconds":817,"label":"13:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"The plan required a one-day passage"}],["$","p",null,{"children":"The Army of the Potomac was to cross the Rapidan and clear the Wilderness before Lee could intervene."}]]}]]}]
1b:["$","div","Humphreys planned to turn Mine Run",{"className":"moment","children":[["$","$L16",null,{"seconds":829,"label":"13:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Humphreys planned to turn Mine Run"}],["$","p",null,{"children":"A wide movement toward the stream’s headwaters would make Lee’s fortified Mine Run position unusable and force him to retreat or fight in open country."}]]}]]}]
1c:["$","div","Grant added the Shenandoah offensive",{"className":"moment","children":[["$","$L16",null,{"seconds":889,"label":"14:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant added the Shenandoah offensive"}],["$","p",null,{"children":"Franz Sigel’s forces would move up the valley while other columns attacked the Virginia and Tennessee Railroad, lead mines, and saltworks."}]]}]]}]
1d:["$","div","The presidential election affected strategy",{"className":"moment","children":[["$","$L16",null,{"seconds":985,"label":"16:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The presidential election affected strategy"}],["$","p",null,{"children":"A major U.S. defeat could increase support for a negotiated peace, while battlefield success could strengthen Lincoln’s reelection."}]]}]]}]
1e:["$","div","Longstreet proposed a political offensive",{"className":"moment","children":[["$","$L16",null,{"seconds":1088,"label":"18:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet proposed a political offensive"}],["$","p",null,{"children":"He suggested a Confederate movement into Kentucky to damage Northern morale and Lincoln’s electoral prospects, but practical objections ended the plan."}]]}]]}]
1f:["$","div","Lee faced desertion and shortages",{"className":"moment","children":[["$","$L16",null,{"seconds":1231,"label":"20:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee faced desertion and shortages"}],["$","p",null,{"children":"Absences reduced Confederate strength, while inadequate food and forage threatened the army’s ability to respond quickly."}]]}]]}]
20:["$","div","Lee operated his own intelligence system",{"className":"moment","children":[["$","$L16",null,{"seconds":1357,"label":"22:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee operated his own intelligence system"}],["$","p",null,{"children":"Reports came through Stuart, Richmond officials, scouts, civilians, and newspapers; Lee had no formal chief of intelligence."}]]}]]}]
21:["$","div","Lee anticipated the supporting offensives",{"className":"moment","children":[["$","$L16",null,{"seconds":1408,"label":"23:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee anticipated the supporting offensives"}],["$","p",null,{"children":"By April 30, he expected operations in the Shenandoah Valley, against southwestern railroads, and from southeastern Virginia."}]]}]]}]
22:["$","div","Lee underestimated Meade’s strength",{"className":"moment","children":[["$","$L16",null,{"seconds":1449,"label":"24:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee underestimated Meade’s strength"}],["$","p",null,{"children":"He estimated 75,000 U.S. troops. The Army of the Potomac already exceeded 100,000 and Burnside would add more than 16,000."}]]}]]}]
23:["$","div","Lee fielded three infantry corps",{"className":"moment","children":[["$","$L16",null,{"seconds":1498,"label":"24:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee fielded three infantry corps"}],["$","p",null,{"children":"Longstreet had about 10,000 men, Ewell about 17,200, and A. P. Hill just over 22,300, plus Stuart’s cavalry."}]]}]]}]
24:["$","div","Meade also fielded three infantry corps",{"className":"moment","children":[["$","$L16",null,{"seconds":1588,"label":"26:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade also fielded three infantry corps"}],["$","p",null,{"children":"Sedgwick’s VI Corps had about 24,000, Hancock’s II Corps about 26,600, and Warren’s V Corps about 24,100."}]]}]]}]
25:["$","div","Sheridan commanded about 15,800 cavalry",{"className":"moment","children":[["$","$L16",null,{"seconds":1695,"label":"28:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sheridan commanded about 15,800 cavalry"}],["$","p",null,{"children":"Grant brought him east from infantry command in the Western Theater to lead the Army of the Potomac’s three cavalry divisions."}]]}]]}]
26:["$","div","Burnside remained administratively separate",{"className":"moment","children":[["$","$L16",null,{"seconds":1754,"label":"29:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Burnside remained administratively separate"}],["$","p",null,{"children":"IX Corps had about 19,200 men and reported directly to Grant because Burnside outranked Meade."}]]}]]}]
27:["$","div","The U.S. numerical advantage had limits",{"className":"moment","children":[["$","$L16",null,{"seconds":1814,"label":"30:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. numerical advantage had limits"}],["$","p",null,{"children":"Up to one-third of Meade’s soldiers lacked combat experience, and some veteran enlistments were close to expiring."}]]}]]}]
28:["$","div","About 27,000 veterans reenlisted",{"className":"moment","children":[["$","$L16",null,{"seconds":2007,"label":"33:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"About 27,000 veterans reenlisted"}],["$","p",null,{"children":"Federal bonuses and furloughs retained many experienced soldiers, but thousands of others were due to leave during the campaign."}]]}]]}]
29:["$","div","The U.S. army still had about 70,000 veterans",{"className":"moment","children":[["$","$L16",null,{"seconds":2074,"label":"34:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. army still had about 70,000 veterans"}],["$","p",null,{"children":"The Army of the Potomac had roughly 65,000 experienced troops; IX Corps veterans raised the combined total slightly above 70,000."}]]}]]}]
2a:["$","div","The Army of the Potomac was well supplied",{"className":"moment","children":[["$","$L16",null,{"seconds":2098,"label":"34:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Potomac was well supplied"}],["$","p",null,{"children":"Morale and material condition were strong, with adequate clothing, equipment, food, and an effective logistical system."}]]}]]}]
2b:["$","h3",null,{"children":"Franz Sigel"}]
2c:["$","p",null,{"children":"Commanded the supporting Shenandoah Valley offensive"}]
2d:["$","article","George G. Meade",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GG"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George G. Meade"}],["$","p",null,{"children":"Retained operational command of the Army of the Potomac under Grant"}]]}]]}]
2e:["$","article","James Longstreet",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"James Longstreet"}],["$","p",null,{"children":"Commanded Lee’s First Corps and had proposed a politically aimed offensive into Kentucky"}]]}]]}]
2f:["$","article","J. E. B. Stuart",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"J. E. B. Stuart"}],["$","p",null,{"children":"Commanded Confederate cavalry and managed much of Lee’s intelligence network"}]]}]]}]
30:["$","article","Ulysses S. Grant",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Ulysses S. Grant"}],["$","p",null,{"children":"Set the coordinated Virginia strategy and chose the eastern approach around Lee"}]]}]]}]
31:["$","article","Robert E. Lee",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/robert-e-lee-1864.jpg","alt":"Portrait of Robert E. Lee","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Robert E. Lee"}],["$","p",null,{"children":"Commanded the Army of Northern Virginia and anticipated most of Grant’s plan"}]]}]]}]
