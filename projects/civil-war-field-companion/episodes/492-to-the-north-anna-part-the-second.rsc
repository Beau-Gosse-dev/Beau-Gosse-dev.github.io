 deep at the ford"}]]}],["$","div","Distance between U.S. bridgeheads",{"children":[["$","span",null,{"children":"Distance between U.S. bridgeheads"}],["$","strong",null,{"children":"About 5 miles"}],"$undefined"]}],["$","div","Jericho Mill casualties",{"children":[["$","span",null,{"children":"Jericho Mill casualties"}],["$","strong",null,{"children":"About 1,107"}],["$","small",null,{"children":"Approximately 730 Confederate and 377 U.S."}]]}],["$","div","Guns used against the Chesterfield redoubt",{"children":[["$","span",null,{"children":"Guns used against the Chesterfield redoubt"}],["$","strong",null,{"children":"20"}],"$undefined"]}],["$","div","U.S. divisions across at Jericho by mid-afternoon",{"children":[["$","span",null,{"children":"U.S. divisions across at Jericho by mid-afternoon"}],["$","strong",null,{"children":"2"}],"$undefined"]}],["$","div","Ledlie’s attack strength",{"children":[["$","span",null,{"children":"Ledlie’s attack strength"}],["$","strong",null,{"children":"About 1,500"}],"$undefined"]}],["$","div","Prisoners taken from Ledlie’s brigade",{"children":[["$","span",null,{"children":"Prisoners taken from Ledlie’s brigade"}],["$","strong",null,{"children":"About 100"}],"$undefined"]}],["$","div","Estimated North Anna casualties",{"children":[["$","span",null,{"children":"Estimated North Anna casualties"}],["$","strong",null,{"children":"5,140"}],["$","small",null,{"children":"National Park Service estimate: 2,623 U.S. and 2,517 Confederate"}]]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid",