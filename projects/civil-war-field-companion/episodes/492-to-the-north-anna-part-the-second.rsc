15:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
17:["$","div","U.S. artillery stabilized the line",{"className":"moment","children":[["$","$L16",null,{"seconds":527,"label":"8:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. artillery stabilized the line"}],["$","p",null,{"children":"Twelve guns crossed the new pontoon bridge. Charles Wainwright’s batteries held while infantry reformed, and Wilcox withdrew after dark."}]]}]]}]
18:["$","div","Jericho Mill cost more than a thousand casualties",{"className":"moment","children":[["$","$L16",null,{"seconds":556,"label":"9:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jericho Mill cost more than a thousand casualties"}],["$","p",null,{"children":"The episode reports about 730 Confederate and 377 U.S. casualties in the fighting around Warren’s bridgehead."}]]}]]}]
19:["$","div","Hancock attacked the Chesterfield Bridge redoubt",{"className":"moment","children":[["$","$L16",null,{"seconds":574,"label":"9:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock attacked the Chesterfield Bridge redoubt"}],["$","p",null,{"children":"Twenty guns bombarded three Confederate regiments on the north bank. Three U.S. brigades overran the position at 6 p.m. and secured the bridge approach."}]]}]]}]
1a:["$","div","Lee blamed Hill for using only one division",{"className":"moment","children":[["$","$L16",null,{"seconds":669,"label":"11:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee blamed Hill for using only one division"}],["$","p",null,{"children":"Lee argued that Hill should have committed the full corps against Warren. Hill had received inaccurate cavalry reports that only two U.S. brigades had crossed."}]]}]]}]
1b:["$","div","Lee’s commanders designed a new line",{"className":"moment","children":[["$","$L16",null,{"seconds":734,"label":"12:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s commanders designed a new line"}],["$","p",null,{"children":"The river crossings could not be defended, but abandoning the area would surrender Hanover Junction. Lee, his chief engineer, and senior commanders developed a position anchored at Ox Ford."}]]}]]}]
1c:["$","div","Grant ordered a general advance on May 24",{"className":"moment","children":[["$","$L16",null,{"seconds":867,"label":"14:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant ordered a general advance on May 24"}],["$","p",null,{"children":"Hancock crossed at Chesterfield Bridge, Warren and Wright advanced from Jericho Mill, and Burnside was ordered to cross between them at Ox Ford."}]]}]]}]
1d:["$","div","Initial reports said Lee had withdrawn",{"className":"moment","children":[["$","$L16",null,{"seconds":905,"label":"15:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Initial reports said Lee had withdrawn"}],["$","p",null,{"children":"Escaped enslaved people and the lack of resistance led Grant to tell Halleck that Lee was falling back toward Richmond."}]]}]]}]
1e:["$","div","Warren and Wright reached the railroad",{"className":"moment","children":[["$","$L16",null,{"seconds":941,"label":"15:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Warren and Wright reached the railroad"}],["$","p",null,{"children":"They occupied Noel Station and captured about 200 Confederates who had been left asleep when Wilcox withdrew."}]]}]]}]
1f:["$","div","Burnside found Ox Ford strongly defended",{"className":"moment","children":[["$","$L16",null,{"seconds":971,"label":"16:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Burnside found Ox Ford strongly defended"}],["$","p",null,{"children":"The south bank dominated the crossing and Confederate earthworks covered the bluff. Burnside shifted part of his corps upstream to Quarles Ford."}]]}]]}]
20:["$","div","U.S. columns found Lee’s new works",{"className":"moment","children":[["$","$L16",null,{"seconds":1107,"label":"18:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. columns found Lee’s new works"}],["$","p",null,{"children":"A V Corps division crossed near Quarles Ford and encountered entrenchments. Hancock’s advance also struck Confederate skirmishers and a second defensive line near Hanover Junction."}]]}]]}]
21:["$","div","Ledlie attacked without the rest of his division",{"className":"moment","children":[["$","$L16",null,{"seconds":1209,"label":"20:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ledlie attacked without the rest of his division"}],["$","p",null,{"children":"James Ledlie sent about 1,500 men toward Mahone’s entrenched veterans near Ox Ford. Confederate cannon and rifle fire broke the assault within minutes and captured about one hundred men."}]]}]]}]
22:["$","div","The shape of Lee’s position became clear",{"className":"moment","children":[["$","$L16",null,{"seconds":1299,"label":"21:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The shape of Lee’s position became clear"}],["$","p",null,{"children":"The Confederate line formed an inverted V with its point at Ox Ford and its sides covering Hanover Junction."}]]}]]}]
23:["$","div","Ox Ford divided the Army of the Potomac",{"className":"moment","children":[["$","$L16",null,{"seconds":1343,"label":"22:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ox Ford divided the Army of the Potomac"}],["$","p",null,{"children":"Grant’s wings could not reinforce each other without recrossing the river and marching about six miles. Lee could shift troops along shorter interior lines."}]]}]]}]
