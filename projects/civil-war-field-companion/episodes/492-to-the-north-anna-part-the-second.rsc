15:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L1c",null,{"guide":{"date":"May 23–24, 1864","place":"North Anna River, Jericho Mill, Chesterfield Bridge, Ox Ford, and Hanover Junction, Virginia","result":"U.S. forces established two bridgeheads and defeated Wilcox’s attack, but Lee’s new inverted-V line at Ox Ford divided Grant’s army and blocked a coordinated advance on Hanover Junction","facts":[{"label":"North Anna at Jericho Mill","value":"About 50 yards wide","note":"Approximately waist deep at the ford"},{"label":"Distance between U.S. bridgeheads","value":"About 5 miles"},{"label":"Jericho Mill casualties","value":"About 1,107","note":"Approximately 730 Confederate and 377 U.S."},{"label":"Guns used against the Chesterfield redoubt","value":"20"},{"label":"U.S. divisions across at Jericho by mid-afternoon","value":"2"},{"label":"Ledlie’s attack strength","value":"About 1,500"},{"label":"Prisoners taken from Ledlie’s brigade","value":"About 100"},{"label":"Estimated North Anna casualties","value":"5,140","note":"National Park Service estimate: 2,623 U.S. and 2,517 Confederate"}],"maps":[{"title":"The North Anna battle plan","caption":"The map identifies Jericho Mill, Chesterfield Bridge, Ox Ford, Hanover Junction, the railroads, and the two sides of Lee’s inverted-V line from May 23 to 26.","source":"https://www.loc.gov/item/gvhs01.vhs00237/","image":"/images/north-anna-battle-map.jpg","alt":"Historical battle map of the North Anna River and the inverted-V Confederate position"},{"title":"The North Anna crossings today","caption":"Warren crossed upstream at Jericho Mill while Hancock approached the Telegraph Road bridge downstream. Ox Ford lay between them and prevented a direct connection south of the river.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-77.71%2C37.82%2C-77.35%2C38.02&layer=mapnik&marker=37.9008%2C-77.4995"},{"title":"North Anna in the Overland Campaign","caption":"The North Anna position lay between Spotsylvania and Richmond. Hanover Junction connected the Virginia Central and Richmond, Fredericksburg and Potomac railroads.","source":"https://www.loc.gov/item/99448882/","image":"/images/overland-campaign-1864-map.jpg","alt":"Historical map showing the North Anna phase of the Overland Campaign"}],"moments":[{"time":"1:18","audioTime":78,"title":"Grant moved around Lee’s right again","detail":"After the Spotsylvania operations and failure of supporting campaigns elsewhere, Grant moved toward the North Anna rather than continue attacking the existing Confederate line."},{"time":"2:19","audioTime":139,"title":"Grant’s objective was Lee’s army","detail":"Lee expected the U.S. movement to focus on Richmond. Grant’s principal goal was to defeat the Army of Northern Virginia."},{"time":"2:48","audioTime":168,"title":"Lee saw a chance to concentrate Confederate forces","detail":"The U.S. Army had suffered heavy losses and longer supply lines. Lee had received more than 10,000 reinforcements and was only about forty miles from Beauregard."},{"time":"3:56","audioTime":236,"title":"Lee asked Davis to unite with Beauregard","detail":"On May 23 Lee proposed concentrating the available Confederate forces against Grant before the Army of the Potomac could rest and reinforce."},{"time":"4:42","audioTime":282,"title":"Grant wanted Lee to leave his earthworks","detail":"Grant believed open battle offered the best chance to destroy Lee’s army. He did not intend to pause despite Confederate reinforcements."},{"time":"5:24","audioTime":324,"title":"Grant prepared to end the Bermuda Hundred operation","detail":"He planned to retain City Point but bring most of the Army of the James north, under William F. Smith in the field, to reinforce the Army of the Potomac."},{"time":"6:16","audioTime":376,"title":"Poor maps delayed the U.S. march","detail":"II and V Corps crossed paths while seeking incorrectly marked or nonexistent destinations. The columns required several hours to separate and resume their routes."},{"time":"6:49","audioTime":409,"title":"Two U.S. corps reached separate crossings","detail":"Hancock approached Chesterfield Bridge while Warren reached Jericho Mill about five miles upstream."},{"time":"7:05","audioTime":425,"title":"Warren crossed at Jericho Mill","detail":"Infantry waded the waist-deep river while engineers built a pontoon bridge for wagons and artillery. Two divisions were south of the river by mid-afternoon."},{"time":"8:27","audioTime":507,"title":"Wilcox attacked the V Corps bridgehead","detail":"At about 5:45 p.m., Wilcox’s Confederate division drove back two U.S. brigades before resistance strengthened."},{"time":"8:47","audioTime":527,"title":"U.S. artillery stabilized the line","detail":"Twelve guns crossed the new pontoon bridge. Charles Wainwright’s batteries held while infantry reformed, and Wilcox withdrew after dark."},{"time":"9:16","audioTime":556,"title":"Jericho Mill cost more than a thousand casualties","detail":"The episode reports about 730 Confederate and 377 U.S. casualties in the fighting around Warren’s bridgehead."},{"time":"9:34","audioTime":574,"title":"Hancock attacked the Chesterfield Bridge redoubt","detail":"Twenty guns bombarded three Confederate regiments on the north bank. Three U.S. brigades overran the position at 6 p.m. and secured the bridge approach."},{"time":"11:09","audioTime":669,"title":"Lee blamed Hill for using only one division","detail":"Lee argued that Hill should have committed the full corps against Warren. Hill had received inaccurate cavalry reports that only two U.S. brigades had crossed."},{"time":"12:14","audioTime":734,"title":"Lee’s commanders designed a new line","detail":"The river crossings could not be defended, but abandoning the area would surrender Hanover Junction. Lee, his chief engineer, and senior commanders developed a position anchored at Ox Ford."},{"time":"14:27","audioTime":867,"title":"Grant ordered a general advance on May 24","detail":"Hancock crossed at Chesterfield Bridge, Warren and Wright advanced from Jericho Mill, and Burnside was ordered to cross between them at Ox Ford."},{"time":"15:05","audioTime":905,"title":"Initial reports said Lee had withdrawn","detail":"Escaped enslaved people and the lack of resistance led Grant to tell Halleck that Lee was falling back toward Richmond."},{"time":"15:41","audioTime":941,"title":"Warren and Wright reached the railroad","detail":"They occupied Noel Station and captured about 200 Confederates who had been left asleep when Wilcox withdrew."},{"time":"16:11","audioTime":971,"title":"Burnside found Ox Ford strongly defended","detail":"The south bank dominated the crossing and Confederate earthworks covered the bluff. Burnside shifted part of his corps upstream to Quarles Ford."},{"time":"18:27","audioTime":1107,"title":"U.S. columns found Lee’s new works","detail":"A V Corps division crossed near Quarles Ford and encountered entrenchments. Hancock’s advance also struck Confederate skirmishers and a second defensive line near Hanover Junction."},{"time":"20:09","audioTime":1209,"title":"Ledlie attacked without the rest of his division","detail":"James Ledlie sent about 1,500 men toward Mahone’s entrenched veterans near Ox Ford. Confederate cannon and rifle fire broke the assault within minutes and captured about one hundred men."},{"time":"21:39","audioTime":1299,"title":"The shape of Lee’s position became clear","detail":"The Confederate line formed an inverted V with its point at Ox Ford and its sides covering Hanover Junction."},{"time":"22:23","audioTime":1343,"title":"Ox Ford divided the Army of the Potomac","detail":"Grant’s wings could not reinforce each other without recrossing the river and marching about six miles. Lee could shift troops along shorter interior lines."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"Ulysses S. Grant","command":"General-in-chief","subordinates":"Directed the advance and expected Lee to withdraw from the North Anna"},{"commander":"George G. Meade","command":"Army of the Potomac","subordinates":"Hancock’s II Corps, Warren’s V Corps, Wright’s VI Corps, and Burnside’s IX Corps"},{"commander":"Gouverneur K. Warren","command":"V Corps","subordinates":"Established and defended the Jericho Mill bridgehead"},{"commander":"Winfield S. Hancock","command":"II Corps","subordinates":"Captured the Chesterfield Bridge redoubt and advanced toward Hanover Junction"},{"commander":"Ambrose E. Burnside","command":"IX Corps","subordinates":"Attempted crossings at Ox Ford and Quarles Ford"},{"commander":"Thomas L. Crittenden","command":"Division, IX Corps","subordinates":"James Ledlie’s brigade attacked the Ox Ford works"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Robert E. Lee","command":"Army of Northern Virginia","subordinates":"Designed the inverted-V position and protected Hanover Junction"},{"commander":"A. P. Hill","command":"Third Corps","subordinates":"Authorized Wilcox’s attack on the Jericho Mill bridgehead"},{"commander":"Cadmus M. Wilcox","command":"Division, Third Corps","subordinates":"Attacked Warren on May 23 and withdrew to Noel Station"},{"commander":"Richard H. Anderson","command":"First Corps","subordinates":"Held part of the eastern side of the Confederate line"},{"commander":"Richard S. Ewell","command":"Second Corps","subordinates":"Opposed Hancock near Hanover Junction"},{"commander":"William Mahone","command":"Division, Third Corps","subordinates":"Repelled Ledlie’s unsupported attack near Ox Ford"}]}],"people":[{"personId":"ulysses-s-grant","role":"Continued the advance, misread Lee’s initial movement, and divided his army across the North Anna"},{"name":"Gouverneur K. Warren","role":"Crossed at Jericho Mill and held the V Corps bridgehead against Wilcox","side":"United States"},{"name":"Winfield S. Hancock","role":"Captured the Chesterfield Bridge position and advanced south of the river","side":"United States"},{"name":"Charles S. Wainwright","role":"Directed the artillery that stopped Wilcox’s attack at Jericho Mill","side":"United States"},{"name":"James H. Ledlie","role":"Ordered an unsupported brigade attack against the Confederate works near Ox Ford","side":"United States"},{"name":"Robert E. Lee","role":"Replaced the river defense with an inverted-V line that separated Grant’s wings","side":"Confederacy","image":"/images/robert-e-lee-1864.jpg","source":"https://www.loc.gov/item/2018666540/"},{"name":"A. P. Hill","role":"Third Corps commander criticized for committing only Wilcox’s division at Jericho Mill","side":"Confederacy"},{"name":"Cadmus M. Wilcox","role":"Led the attack that initially drove back part of Warren’s bridgehead","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/north-anna-battle-map.jpg","alt":"Historical plan of the Battle of North Anna","caption":"The plan shows the two U.S. bridgeheads and the Confederate line anchored between them at Ox Ford.","source":"https://www.loc.gov/item/gvhs01.vhs00237/"},{"image":"/images/birney-crossing-north-anna.jpg","alt":"Alfred Waud drawing of Birney’s division crossing the North Anna","caption":"U.S. infantry crossed at multiple points while bridges were prepared for artillery, wagons, and later movement.","source":"https://www.loc.gov/item/2004660416/"},{"image":"/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland Campaign route","caption":"The North Anna position protected Hanover Junction and the rail routes running toward Richmond and the Shenandoah Valley.","source":"https://www.loc.gov/item/99448882/"},{"image":"/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","caption":"Grant expected the river crossings to force another Confederate retreat, but Lee instead occupied a new line south of the river.","source":"https://www.loc.gov/item/2018666428/"}],"sources":[{"label":"Civil War Podcast, episode 492","url":"https://civilwarpodcast.org/2025/05/11/civil-war-podcast-episode-492/"},{"label":"National Park Service: North Anna battle detail","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va055"},{"label":"National Park Service: Battle of North Anna","url":"https://www.nps.gov/frsp/planyourvisit/bona.htm"},{"label":"U.S. Army Center of Military History: The Overland Campaign","url":"https://history.army.mil/Publications/Publications-Catalog/Overland-Campaign/"},{"label":"Library of Congress: North Anna battle plan","url":"https://www.loc.gov/item/gvhs01.vhs00237/"},{"label":"Library of Congress: Birney’s division crossing the North Anna","url":"https://www.loc.gov/item/2004660416/"}]}}]}]
