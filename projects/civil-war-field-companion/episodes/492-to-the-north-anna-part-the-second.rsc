f:["$","figure","The North Anna crossings today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.71%2C37.82%2C-77.35%2C38.02&layer=mapnik&marker=37.9008%2C-77.4995","title":"The North Anna crossings today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The North Anna crossings today"}],["$","span",null,{"children":"Warren crossed upstream at Jericho Mill while Hancock approached the Telegraph Road bridge downstream. Ox Ford lay between them and prevented a direct connection south of the river."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
10:["$","figure","North Anna in the Overland Campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open North Anna in the Overland Campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map showing the North Anna phase of the Overland Campaign","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"North Anna in the Overland Campaign"}],["$","span",null,{"children":"The North Anna position lay between Spotsylvania and Richmond. Hanover Junction connected the Virginia Central and Richmond, Fredericksburg and Potomac railroads."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Grant moved around Lee’s right again",{"className":"moment","children":[["$","$L16",null,{"seconds":78,"label":"1:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant moved around Lee’s right again"}],["$","p",null,{"children":"After the Spotsylvania operations and failure of supporting campaigns elsewhere, Grant moved toward the North Anna rather than continue attacking the existing Confederate line."}]]}]]}],["$","div","Grant’s objective was Lee’s army",{"className":"moment","children":[["$","$L16",null,{"seconds":139,"label":"2:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant’s objective was Lee’s army"}],["$","p",null,{"children":"Lee expected the U.S. movement to focus on Richmond. Grant’s principal goal was to defeat the Army of Northern Virginia."}]]}]]}],["$","div","Lee saw a chance to concentrate Confederate forces",{"className":"moment","children":[["$","$L16",null,{"seconds":168,"label":"2:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee saw a chance to concentrate Confederate forces"}],["$","p",null,{"children":"The U.S. Army had suffered heavy losses and longer supply lines. Lee had received more than 10,000 reinforcements and was only about forty miles from Beauregard."}]]}]]}],["$","div","Lee asked Davis to unite with Beauregard",{"className":"moment","children":[["$","$L16",null,{"seconds":236,"label":"3:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee asked Davis to unite with Beauregard"}],["$","p",null,{"children":"On May 23 Lee proposed concentrating the available Confederate forces against Grant before the Army of the Potomac could rest and reinforce."}]]}]]}],["$","div","Grant wanted Lee to leave his earthworks",{"className":"moment","children":[["$","$L16",null,{"seconds":282,"label":"4:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant wanted Lee to leave his earthworks"}],["$","p",null,{"children":"Grant believed open battle offered the best chance to destroy Lee’s army. He did not intend to pause despite Confederate reinforcements."}]]}]]}],["$","div","Grant prepared to end the Bermuda Hundred operation",{"className":"moment","children":[["$","$L16",null,{"seconds":324,"label":"5:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant prepared to end the Bermuda Hundred operation"}],["$","p",null,{"children":"He planned to retain City Point but bring most of the Army of the James north, under William F. Smith in the field, to reinforce the Army of the Potomac."}]]}]]}],["$","div","Poor maps delayed the U.S. march",{"className":"moment","children":[["$","$L16",null,{"seconds":376,"label":"6:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Poor maps delayed the U.S. march"}],["$","p",null,{"children":"II and V Corps crossed paths while seeking incorrectly marked or nonexistent destinations. The columns required several hours to separate and resume their routes."}]]}]]}],["$","div","Two U.S. corps reached separate crossings",{"className":"moment","children":[["$","$L16",null,{"seconds":409,"label":"6:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two U.S. corps reached separate crossings"}],["$","p",null,{"children":"Hancock approached Chesterfield Bridge while Warren reached Jericho Mill about five miles upstream."}]]}]]}],["$","div","Warren crossed at Jericho Mill",{"className":"moment","children":[["$","$L16",null,{"seconds":425,"label":"7:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Warren crossed at Jericho Mill"}],["$","p",null,{"children":"Infantry waded the waist-deep river while engineers built a pontoon bridge for wagons and artillery. Two divisions were south of the river by mid-afternoon."}]]}]]}],["$","div","Wilcox attacked the V Corps bridgehead",{"className":"moment","children":[["$","$L16",null,{"seconds":507,"label":"8:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wilcox attacked the V Corps bridgehead"}],["$","p",null,{"children":"At about 5:45 p.m., Wilcox’s Confederate division drove back two U.S. brigades before resistance strengthened."}]]}]]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","General-in-chief",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Directed the advance and expected Lee to withdraw from the North Anna"}]]}],["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"George G. Meade"}],["$","small",null,{"children":"Hancock’s II Corps, Warren’s V Corps, Wright’s VI Corps, and Burnside’s IX Corps"}]]}],["$","div","V Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps"}],["$","span",null,{"children":"Gouverneur K. Warren"}],["$","small",null,{"children":"Established and defended the Jericho Mill bridgehead"}]]}],["$","div","II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps"}],["$","span",null,{"children":"Winfield S. Hancock"}],["$","small",null,{"children":"Captured the Chesterfield Bridge redoubt and advanced toward Hanover Junction"}]]}],["$","div","IX Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"IX Corps"}],["$","span",null,{"children":"Ambrose E. Burnside"}],["$","small",null,{"children":"Attempted crossings at Ox Ford and Quarles Ford"}]]}],["$","div","Division, IX Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Division, IX Corps"}],["$","span",null,{"children":"Thomas L. Crittenden"}],["$","small",null,{"children":"James Ledlie’s brigade attacked the Ox Ford works"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Robert E. Lee"}],["$","small",null,{"children":"Designed the inverted-V position and protected Hanover Junction"}]]}],["$","div","Third Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Third Corps"}],["$","span",null,{"children":"A. P. Hill"}],["$","small",null,{"children":"Authorized Wilcox’s attack on the Jericho Mill bridgehead"}]]}],["$","div","Division, Third Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Division, Third Corps"}],["$","span",null,{"children":"Cadmus M. Wilcox"}],["$","small",null,{"children":"Attacked Warren on May 23 and withdrew to Noel Station"}]]}],["$","div","First Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"First Corps"}],["$","span",null,{"children":"Richard H. Anderson"}],["$","small",null,{"children":"Held part of the eastern side of the Confederate line"}]]}],["$","div","Second Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Corps"}],["$","span",null,{"children":"Richard S. Ewell"}],["$","small",null,{"children":"Opposed Hancock near Hanover Junction"}]]}],["$","div","Division, Third Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Division, Third Corps"}],["$","span",null,{"children":"William Mahone"}],["$","small",null,{"children":"Repelled Ledlie’s unsupported attack near Ox Ford"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Ulysses S. Grant",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Ulysses S. Grant"}],["$","p",null,{"children":"Continued the advance, misread Lee’s initial movement, and divided his army across the North Anna"}]]}]]}],["$","article","Gouverneur K. Warren",{"className":"person-card","children":["$L24","$L25"]}],"$L26","$L27","$L28","$L29","$L2a","$L2b"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/north-anna-battle-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/north-anna-battle-map.jpg","alt":"Historical plan of the Battle of North Anna","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The plan shows the two U.S. bridgeheads and the Confederate line anchored between them at Ox Ford."}]]}],["$","figure","/images/birney-crossing-north-anna.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/birney-crossing-north-anna.jpg","alt":"Alfred Waud drawing of Birney’s division crossing the North Anna","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"U.S. infantry crossed at multiple points while bridges were prepared for artillery, wagons, and later movement."}]]}],["$","figure","/images/overland-campaign-1864-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland Campaign route","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The North Anna position protected Hanover Junction and the rail routes running toward Richmond and the Shenandoah Valley."}]]}],["$","figure","/images/ulysses-s-grant.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Grant expected the river crossings to force another Confederate retreat, but Lee instead occupied a new line south of the river."}]]}]]}]]}]
