12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The attack opened at 8 a.m.",{"className":"moment","children":[["$","$L18",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack opened at 8 a.m."}],["$","p",null,{"children":"XIV Corps artillery bombarded the Confederate line. Sam Watkins of the 1st Tennessee described heavy U.S. fire across the sector."}]]}]]}],["$","div","Two U.S. brigades prepared to attack the Dead Angle",{"className":"moment","children":[["$","$L18",null,{"seconds":142,"label":"2:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two U.S. brigades prepared to attack the Dead Angle"}],["$","p",null,{"children":"Daniel McCook Jr. and John G. Mitchell led brigades from Jefferson C. Davis’s division. James D. Morgan’s brigade remained in support."}]]}]]}],["$","div","McCook formed four regiments in column",{"className":"moment","children":[["$","$L18",null,{"seconds":200,"label":"3:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCook formed four regiments in column"}],["$","p",null,{"children":"The 125th Illinois led, followed by the 86th Illinois, 22nd Indiana, and 52nd Ohio. The 85th Illinois deployed as skirmishers."}]]}]]}],["$","div","A column concentrated force but was vulnerable",{"className":"moment","children":[["$","$L18",null,{"seconds":258,"label":"4:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"A column concentrated force but was vulnerable"}],["$","p",null,{"children":"The narrow formation reduced the fire U.S. soldiers could return and allowed men to bunch up when the leading regiments stopped."}]]}]]}],["$","div","McCook planned to widen the formation at the works",{"className":"moment","children":[["$","$L18",null,{"seconds":319,"label":"5:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCook planned to widen the formation at the works"}],["$","p",null,{"children":"Allen Fahnestock was to take the 86th Illinois left after the 125th reached the line, clearing the leading regiment and extending the front."}]]}]]}],["$","div","McCook’s brigade advanced",{"className":"moment","children":[["$","$L18",null,{"seconds":365,"label":"6:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCook’s brigade advanced"}],["$","p",null,{"children":"The column moved downhill at double-quick time. Marshy ground, a stream, and brush disrupted the formation."}]]}]]}],["$","div","The skirmishers captured Confederate pickets",{"className":"moment","children":[["$","$L18",null,{"seconds":466,"label":"7:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"The skirmishers captured Confederate pickets"}],["$","p",null,{"children":"The 85th Illinois crossed the valley ahead of the column and overran the Confederate skirmish line."}]]}]]}],["$","div","The 52nd Ohio took its first fatality",{"className":"moment","children":[["$","$L18",null,{"seconds":507,"label":"8:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 52nd Ohio took its first fatality"}],["$","p",null,{"children":"Isaac Newton Wyckoff was killed as the rear regiment reformed and began climbing toward the main line."}]]}]]}],["$","div","Eight Confederate guns fired into the assault",{"className":"moment","children":[["$","$L18",null,{"seconds":564,"label":"9:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Eight Confederate guns fired into the assault"}],["$","p",null,{"children":"Artillery south of the salient fired along the U.S. formation. McCook accelerated to reduce exposure to the guns."}]]}]]}],["$","div","Alfred Vaughan’s brigade opened fire",{"className":"moment","children":[["$","$L18",null,{"seconds":607,"label":"10:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Alfred Vaughan’s brigade opened fire"}],["$","p",null,{