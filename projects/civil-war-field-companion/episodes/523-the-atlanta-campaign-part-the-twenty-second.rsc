1a:["$","p",null,{"children":"A two-gun section on Vaughan’s right had been screened with brush and struck the column as it climbed the slope."}]
1b:["$","div","The attacking column lost cohesion",{"className":"moment","children":[["$","$L18",null,{"seconds":798,"label":"13:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attacking column lost cohesion"}],["$","p",null,{"children":"Wounded and retreating soldiers moved through the 52nd Ohio. The regiment continued uphill until it stopped about 25 yards from the works."}]]}]]}]
1c:["$","div","The 52nd Ohio lost 85 men",{"className":"moment","children":[["$","$L18",null,{"seconds":915,"label":"15:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 52nd Ohio lost 85 men"}],["$","p",null,{"children":"Four color bearers were among the casualties. About 300 men from the regiment entered the assault."}]]}]]}]
1d:["$","div","A small group tried to penetrate north of the salient",{"className":"moment","children":[["$","$L18",null,{"seconds":1037,"label":"17:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"A small group tried to penetrate north of the salient"}],["$","p",null,{"children":"Lansing Dawdy led about 20 men of the 86th Illinois forward where there was less abatis. All were shot down, and Dawdy was wounded near the trench."}]]}]]}]
1e:["$","div","U.S. flags reached the parapet",{"className":"moment","children":[["$","$L18",null,{"seconds":1130,"label":"18:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. flags reached the parapet"}],["$","p",null,{"children":"Color bearers planted flags at the Confederate works while soldiers on both sides fought at very short range."}]]}]]}]
1f:["$","div","Daniel McCook reached the works",{"className":"moment","children":[["$","$L18",null,{"seconds":1145,"label":"19:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Daniel McCook reached the works"}],["$","p",null,{"children":"McCook stood at the parapet urging his men forward and was shot through the right side at a range of about one foot."}]]}]]}]
20:["$","div","McCook was mortally wounded",{"className":"moment","children":[["$","$L18",null,{"seconds":1294,"label":"21:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCook was mortally wounded"}],["$","p",null,{"children":"The bullet penetrated the top of a lung. He died on July 17 and had learned of his promotion to brigadier general shortly before his death."}]]}]]}]
21:["$","div","Oscar Harmon took command and was killed",{"className":"moment","children":[["$","$L18",null,{"seconds":1315,"label":"21:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Oscar Harmon took command and was killed"}],["$","p",null,{"children":"The 125th Illinois colonel led the brigade for only a few minutes before he was shot and died."}]]}]]}]
22:["$","div","Close fighting continued at the parapet",{"className":"moment","children":[["$","$L18",null,{"seconds":1338,"label":"22:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Close fighting continued at the parapet"}],["$","p",null,{"children":"Confederates threw stones and wood at the U.S. troops. One Confederate soldier captured a U.S. flag from the foot of the works."}]]}]]}]
23:["$","div","The brigade fell back into dead ground",{"className":"moment","children":[["$","$L18",null,{"seconds":1514,"label":"25:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The brigade fell back into dead ground"}],["$","p",null,{"children":"After 15 to 30 minutes near the works, survivors moved behind a slight rise 25 to 60 yards away and remained under cover."}]]}]]}]
24:["$","div","Caleb Dilworth assumed command",{"className":"moment","children":[["$","$L18",null,{"seconds":1692,"label":"28:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Caleb Dilworth assumed command"}],["$","p",null,{"children":"Dilworth and Fahnestock decided another attack would fail and that a full retreat was also too dangerous. The survivors stayed and dug in."}]]}]]}]
25:["$","div","Some soldiers remained beside the Confederate works",{"className":"moment","children":[["$","$L18",null,{"seconds":1759,"label":"29:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Some soldiers remained beside the Confederate works"}],["$","p",null,{"children":"Men too exposed to move waited until they could crawl back. U.S. soldiers scraped out a low defensive line without tools."}]]}]]}]
