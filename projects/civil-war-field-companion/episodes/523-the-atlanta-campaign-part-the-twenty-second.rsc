11:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L19",null,{"guide":{"date":"June 27, 1864","place":"Dead Angle, Cheatham Hill, Georgia","result":"McCook’s brigade reached the Confederate parapet but failed to break the line","facts":[{"label":"Attack began","value":"8 a.m."},{"label":"Formation","value":"Four regiments in column with the 85th Illinois as skirmishers"},{"label":"Closest approach","value":"Some men reached the parapet; most stopped within 25 yards"},{"label":"52nd Ohio losses","value":"85 of about 300 engaged"},{"label":"Time to final position","value":"About 15 minutes"},{"label":"High-ranking losses","value":"Daniel McCook mortally wounded; Oscar Harmon killed"}],"maps":[{"title":"Troop movements at Kennesaw Mountain","caption":"The National Park Service map shows Thomas’s main attack in blue against Hardee’s line in red. McCook attacked the northern face of the salient at Cheatham Hill.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm","image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map of troop movements at Kennesaw Mountain on June 27, 1864"},{"title":"Confederate positions across Kennesaw Mountain","caption":"The 1864 drawing places Confederate artillery across Pigeon Hill, Little Kennesaw, and Big Kennesaw with U.S. forces to the north.","source":"https://www.loc.gov/item/2004660525/","image":"/images/kennesaw-battlefield-drawing.jpg","alt":"1864 drawing of Confederate artillery positions across Kennesaw Mountain"},{"title":"Cheatham Hill today","caption":"McCook’s brigade crossed a stream valley and attacked the northern side of the salient preserved at Cheatham Hill.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.626%2C33.915%2C-84.576%2C33.958&layer=mapnik&marker=33.9334%2C-84.6039"}],"moments":[{"time":"1:19","audioTime":79,"title":"The attack opened at 8 a.m.","detail":"XIV Corps artillery bombarded the Confederate line. Sam Watkins of the 1st Tennessee described heavy U.S. fire across the sector."},{"time":"2:22","audioTime":142,"title":"Two U.S. brigades prepared to attack the Dead Angle","detail":"Daniel McCook Jr. and John G. Mitchell led brigades from Jefferson C. Davis’s division. James D. Morgan’s brigade remained in support."},{"time":"3:20","audioTime":200,"title":"McCook formed four regiments in column","detail":"The 125th Illinois led, followed by the 86th Illinois, 22nd Indiana, and 52nd Ohio. The 85th Illinois deployed as skirmishers."},{"time":"4:18","audioTime":258,"title":"A column concentrated force but was vulnerable","detail":"The narrow formation reduced the fire U.S. soldiers could return and allowed men to bunch up when the leading regiments stopped."},{"time":"5:19","audioTime":319,"title":"McCook planned to widen the formation at the works","detail":"Allen Fahnestock was to take the 86th Illinois left after the 125th reached the line, clearing the leading regiment and extending the front."},{"time":"6:05","audioTime":365,"title":"McCook’s brigade advanced","detail":"The column moved downhill at double-quick time. Marshy ground, a stream, and brush disrupted the formation."},{"time":"7:46","audioTime":466,"title":"The skirmishers captured Confederate pickets","detail":"The 85th Illinois crossed the valley ahead of the column and overran the Confederate skirmish line."},{"time":"8:27","audioTime":507,"title":"The 52nd Ohio took its first fatality","detail":"Isaac Newton Wyckoff was killed as the rear regiment reformed and began climbing toward the main line."},{"time":"9:24","audioTime":564,"title":"Eight Confederate guns fired into the assault","detail":"Artillery south of the salient fired along the U.S. formation. McCook accelerated to reduce exposure to the guns."},{"time":"10:07","audioTime":607,"title":"Alfred Vaughan’s brigade opened fire","detail":"The consolidated 11th and 29th Tennessee and neighboring regiments fired into the dense U.S. column at close range."},{"time":"12:19","audioTime":739,"title":"Hidden Confederate guns fired at short range","detail":"A two-gun section on Vaughan’s right had been screened with brush and struck the column as it climbed the slope."},{"time":"13:18","audioTime":798,"title":"The attacking column lost cohesion","detail":"Wounded and retreating soldiers moved through the 52nd Ohio. The regiment continued uphill until it stopped about 25 yards from the works."},{"time":"15:15","audioTime":915,"title":"The 52nd Ohio lost 85 men","detail":"Four color bearers were among the casualties. About 300 men from the regiment entered the assault."},{"time":"17:17","audioTime":1037,"title":"A small group tried to penetrate north of the salient","detail":"Lansing Dawdy led about 20 men of the 86th Illinois forward where there was less abatis. All were shot down, and Dawdy was wounded near the trench."},{"time":"18:50","audioTime":1130,"title":"U.S. flags reached the parapet","detail":"Color bearers planted flags at the Confederate works while soldiers on both sides fought at very short range."},{"time":"19:05","audioTime":1145,"title":"Daniel McCook reached the works","detail":"McCook stood at the parapet urging his men forward and was shot through the right side at a range of about one foot."},{"time":"21:34","audioTime":1294,"title":"McCook was mortally wounded","detail":"The bullet penetrated the top of a lung. He died on July 17 and had learned of his promotion to brigadier general shortly before his death."},{"time":"21:55","audioTime":1315,"title":"Oscar Harmon took command and was killed","detail":"The 125th Illinois colonel led the brigade for only a few minutes before he was shot and died."},{"time":"22:18","audioTime":1338,"title":"Close fighting continued at the parapet","detail":"Confederates threw stones and wood at the U.S. troops. One Confederate soldier captured a U.S. flag from the foot of the works."},{"time":"25:14","audioTime":1514,"title":"The brigade fell back into dead ground","detail":"After 15 to 30 minutes near the works, survivors moved behind a slight rise 25 to 60 yards away and remained under cover."},{"time":"28:12","audioTime":1692,"title":"Caleb Dilworth assumed command","detail":"Dilworth and Fahnestock decided another attack would fail and that a full retreat was also too dangerous. The survivors stayed and dug in."},{"time":"29:19","audioTime":1759,"title":"Some soldiers remained beside the Confederate works","detail":"Men too exposed to move waited until they could crawl back. U.S. soldiers scraped out a low defensive line without tools."},{"time":"30:36","audioTime":1836,"title":"The brigade held a position close to the enemy","detail":"The misplaced Confederate line left a narrow strip of dead ground. XIV Corps troops used it to remain near the works after the failed assault."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"John M. Palmer’s XIV Corps"},{"commander":"John M. Palmer","command":"XIV Corps","subordinates":"Jefferson C. Davis’s division"},{"commander":"Jefferson C. Davis","command":"2nd Division, XIV Corps","subordinates":"Daniel McCook Jr., John G. Mitchell, and James D. Morgan"},{"commander":"Daniel McCook Jr.","command":"1st Brigade","subordinates":"85th, 86th, and 125th Illinois; 22nd Indiana; 52nd Ohio"},{"commander":"Oscar F. Harmon and Caleb J. Dilworth","command":"Successive brigade commanders","subordinates":"Took command after McCook was wounded"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Benjamin F. Cheatham’s division"},{"commander":"Benjamin F. Cheatham","command":"Cheatham’s Division","subordinates":"Alfred J. Vaughan and George Maney"},{"commander":"Alfred J. Vaughan","command":"Vaughan’s Brigade","subordinates":"Held the line north of the Dead Angle"},{"commander":"George Gordon","command":"Consolidated 11th and 29th Tennessee","subordinates":"Fired into McCook’s left"}]}],"people":[{"name":"Daniel McCook Jr.","role":"Led the brigade to the parapet and was mortally wounded","side":"United States"},{"name":"Oscar F. Harmon","role":"125th Illinois colonel killed shortly after assuming brigade command","side":"United States"},{"name":"Caleb J. Dilworth","role":"85th Illinois colonel who reorganized the survivors in the dead ground","side":"United States"},{"name":"Lansing J. Dawdy","role":"86th Illinois adjutant wounded during an attempted penetration north of the salient","side":"United States"},{"name":"James Holmes","role":"52nd Ohio officer whose account describes the regiment’s advance and losses","side":"United States"},{"name":"Alfred J. Vaughan","role":"Commanded Confederate defenders north of the salient","side":"Confederacy"},{"name":"J. T. Bowdoin","role":"12th Tennessee soldier whose account describes the Confederate fire","side":"Confederacy"}],"losses":[{"name":"Daniel McCook Jr.","side":"United States","role":"Brigade commander, XIV Corps","outcome":"Mortally wounded at the parapet; died July 17, 1864"},{"name":"Oscar F. Harmon","side":"United States","role":"Colonel, 125th Illinois Infantry","outcome":"Killed after taking command of McCook’s brigade"},{"name":"Lansing J. Dawdy","side":"United States","role":"Adjutant, 86th Illinois Infantry","outcome":"Severely wounded about ten feet from the Confederate trench; survived"}],"gallery":[{"image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map showing the U.S. attacks and Confederate line at Kennesaw Mountain","caption":"Thomas’s main attack hit Hardee’s line at Cheatham Hill while other U.S. forces attacked and demonstrated along the wider front.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"image":"/images/kennesaw-battlefield-drawing.jpg","alt":"Theodore R. Davis drawing of Confederate artillery positions at Kennesaw Mountain","caption":"A wartime drawing of the Confederate position across Kennesaw Mountain.","source":"https://www.loc.gov/item/2004660525/"}],"sources":[{"label":"Official Episode 523 page","url":"https://civilwarpodcast.org/2026/03/29/civil-war-podcast-episode-523/"},{"label":"National Park Service battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ga015"},{"label":"National Park Service troop movements map","url":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"label":"National Park Service Union order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/union-order-of-battle.htm"},{"label":"Library of Congress Kennesaw battlefield drawing","url":"https://www.loc.gov/item/2004660525/"}]}}]}]
