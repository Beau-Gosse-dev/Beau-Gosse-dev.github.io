3a:["$","article","Gershom J. Van Brunt",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GJ"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Gershom J. Van Brunt"}],["$","p",null,{"children":"Captain of Minnesota, the ship Monitor was ordered to protect"}]]}]]}]
3b:["$","article","Josiah Tattnall",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JT"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Josiah Tattnall"}],["$","p",null,{"children":"Later commander of Virginia who ordered it scuttled after Norfolk fell"}]]}]]}]
3c:["$","article","John P. Bankhead",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JP"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John P. Bankhead"}],["$","p",null,{"children":"Commanded Monitor on its final voyage off Cape Hatteras"}]]}]]}]
