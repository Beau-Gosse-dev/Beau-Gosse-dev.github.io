f:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The battle area today"}],["$","span",null,{"children":"The ironclads fought in Hampton Roads between Newport News Point, Sewell’s Point, and Fort Monroe. Minnesota remained grounded north of the main shipping channel."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
10:["$","figure","Monitor and Virginia on March 9",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/hampton-roads-march-9-battle-map.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Monitor and Virginia on March 9 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/hampton-roads-march-9-battle-map.svg","alt":"Tactical map showing USS Monitor and CSS Virginia circling, ramming, grounding, the pilot-house hit, and their withdrawals on March 9, 1862","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Monitor and Virginia on March 9"}],["$","span",null,{"children":"Monitor moved away from Minnesota to intercept Virginia. The ships circled, exchanged fire, tried to ram, and fought at close range. Virginia grounded briefly. A shot hit Monitor’s pilot house and wounded Worden shortly before both sides withdrew."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/hampton-roads-march-9-battle-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.history.navy.mil/browse-by-topic/wars-conflicts-and-operations/civil-war/cw-operations-and-engagements/1862-civil-war/hampton-roads.html","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
11:["$","figure","Hampton Roads in 1862",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/hampton-roads-1862-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Hampton Roads in 1862 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/hampton-roads-1862-map.jpg","alt":"1862 U.S. Army reconnaissance map of the Hampton Roads vicinity with military positions","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Hampton Roads in 1862"}],["$","span",null,{"children":"The wartime reconnaissance map shows the harbor, channels, forts, and nearby military positions. The shoals favored Monitor’s shallow draft and restricted Virginia’s movement."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/hampton-roads-1862-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.history.navy.mil/browse-by-topic/wars-conflicts-and-operations/civil-war/cw-operations-and-engagements/1862-civil-war/hampton-roads.html","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
12:["$","figure","Monitor’s wreck site off Cape Hatteras",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-76.25%2C34.72%2C-74.75%2C35.72&layer=mapnik&marker=35.006%2C-75.408","title":"Monitor’s wreck site off Cape Hatteras","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Monitor’s wreck site off Cape Hatteras"}],["$","span",null,{"children":"Monitor sank in a storm on December 31, 1862, about 16 miles south-southeast of Cape Hatteras. The wreck lies in roughly 220 feet of water inside Monitor National Marine Sanctuary."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://monitor.noaa.gov/about/history.html","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Virginia prepared to return",{"className":"moment","children":[["$","$L19",null,{"seconds":81,"label":"1:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia prepared to return"}],["$","p",null,{"children":"Before dawn on March 9, its crew inspected damage from the previous day. The smokestack, fittings, two gun muzzles, and the bow were damaged, but 98 hits on the armor had not penetrated."}]]}]]}],["$","div","Washington learned of the March 8 defeat",{"className":"moment","children":[["$","$L19",null,{"seconds":182,"label":"3:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Washington learned of the March 8 defeat"}],["$","p",null,{"children":"Delayed reports reached Gideon Welles and the White House on Sunday morning. Lincoln called an immediate cabinet meeting."}]]}]]}],["$","div","The cabinet expected further attacks",{"className":"moment","children":[["$","$L19",null,{"seconds":222,"label":"3:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cabinet expected further attacks"}],["$","p",null,{"children":"Edwin Stanton feared Virginia might attack Washington or northern ports. Welles explained that its deep draft kept it from ascending the Potomac and that Monitor was already headed to Hampton Roads."}]]}]]}],["$","div","Stanton prepared to obstruct the Potomac",{"className":"moment","children":[["$","$L19",null,{"seconds":376,"label":"6:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stanton prepared to obstruct the Potomac"}],["$","p",null,{"children":"The War Department planned to sink stone-filled barges below Washington. Lincoln delayed the action because it would also block United States shipping."}]]}]]}],["$","div","Monitor waited beside Minnesota",{"className":"moment","children":[["$","$L19",null,{"seconds":437,"label":"7:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor waited beside Minnesota"}],["$","p",null,{"children":"The crew had slept little during the dangerous trip from New York, but Worden prepared the ship for battle at first light."}]]}]]}],["$","div","Jones waited for tide and visibility",{"className":"moment","children":[["$","$L19",null,{"seconds":472,"label":"7:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jones waited for tide and visibility"}],["$","p",null,{"children":"Fog covered Hampton Roads. Catesby ap Roger Jones delayed Virginia’s movement until the tide rose and the fog cleared."}]]}]]}],["$","div","Virginia moved toward Minnesota",{"className":"moment","children":[["$","$L19",null,{"seconds":505,"label":"8:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia moved toward Minnesota"}],["$","p",null,{"children":"Around 8 a.m., Virginia left Sewell’s Point with Patrick Henry, Jamestown, and Teaser and steamed toward the grounded frigate."}]]}]]}],["$","div","The Confederates saw Monitor",{"className":"moment","children":[["$","$L19",null,{"seconds":516,"label":"8:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederates saw Monitor"}],["$","p",null,{"children":"Virginia’s crew had not expected the unfamiliar low-profile ship beside Minnesota. They identified it as the new United States ironclad."}]]}]]}],["$","div","Worden promised to defend Minnesota",{"className":"moment","children":[["$","$L19",null,{"seconds":638,"label":"10:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Worden promised to defend Minnesota"}],["$","p",null,{"children":"Minnesota’s captain, Gershom Van Brunt, doubted Monitor could help. Worden said he would stay with the frigate as long as possible."}]]}]]}],["$","div","Virginia fired toward Minnesota",{"className":"moment","children":[["$","$L19",null,{"seconds":678,"label":"11:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia fired toward Minnesota"}],["$","p",null,{"children":"The Confederate ironclad opened from long range. A shell passed over Monitor and struck Minnesota."}]]}]]}],["$","div","Monitor intercepted Virginia",{"className":"moment","children":["$L1a","$L1b"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36"]}]]}]
14:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Secretary of the Navy",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of the Navy"}],["$","span",null,{"children":"Gideon Welles"}],["$","small",null,{"children":"Received the delayed battle report and directed the naval response"}]]}],["$","div","USS Monitor",{"className":"command-entry","children":[["$","strong",null,{"children":"USS Monitor"}],["$","span",null,{"children":"John L. Worden"}],["$","small",null,{"children":"Pilot house command; Samuel D. Greene commanded the turret"}]]}],["$","div","Monitor executive officer",{"className":"command-entry","children":[["$","strong",null,{"children":"Monitor executive officer"}],["$","span",null,{"children":"Samuel D. Greene"}],["$","small",null,{"children":"Directed both 11-inch guns and assumed ship command after Worden was wounded"}]]}],["$","div","USS Minnesota",{"className":"command-entry","children":[["$","strong",null,{"children":"USS Minnesota"}],["$","span",null,{"children":"Gershom J. Van Brunt"}],["$","small",null,{"children":"Defended the grounded frigate while Monitor intercepted Virginia"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Secretary of the Navy",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of the Navy"}],["$","span",null,{"children":"Stephen R. Mallory"}],["$","small",null,{"children":"Directed Confederate naval strategy"}]]}],["$","div","CSS Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"CSS Virginia"}],["$","span",null,{"children":"Catesby ap Roger Jones"}],["$","small",null,{"children":"Commanded the March 9 engagement in Franklin Buchanan’s absence"}]]}],["$","div","Virginia engineering department",{"className":"command-entry","children":[["$","strong",null,{"children":"Virginia engineering department"}],["$","span",null,{"children":"H. Ashton Ramsay"}],["$","small",null,{"children":"Forced the ship off the shoal and maintained the damaged machinery"}]]}],["$","div","Virginia marine guard",{"className":"command-entry","children":[["$","strong",null,{"children":"Virginia marine guard"}],["$","span",null,{"children":"Reuben Thom"}],["$","small",null,{"children":"Prepared a boarding party that was not used"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","John L. Worden",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John L. Worden"}],["$","p",null,{"children":"Commanded Monitor, moved the fight away from Minnesota, and was wounded at the pilot house"}]]}]]}],["$","article","Samuel D. Greene",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"SD"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Samuel D. Greene"}],["$","p",null,{"children":"Directed Monitor’s turret and assumed command after Worden was wounded"}]]}]]}],["$","article","Catesby ap Roger Jones",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"Ca"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Catesby ap Roger Jones"}],["$","p",null,{"children":"Commanded Virginia throughout the March 9 battle"}]]}]]}],["$","article","H. Ashton Ramsay",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"HA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"H. Ashton Ramsay"}],"$L37"]}]]}],"$L38","$L39","$L3a","$L3b","$L3c"]}]]}]
15:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","John L. Worden",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John L. Worden"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commanding officer of USS Monitor","."]}]," ","Wounded and temporarily blinded when a Virginia shell exploded against the pilot house. He survived and recovered his sight."]}]]}],["$","article","Monitor’s final-voyage crew",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Monitor’s final-voyage crew"}],["$","p",null,{"children":[["$","strong",null,{"children":["Officers and sailors aboard USS Monitor","."]}]," ","Four officers and 12 enlisted men died when Monitor sank off Cape Hatteras on December 31, 1862."]}]]}]]}]]}]
16:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/hampton-roads-ironclads-print.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/hampton-roads-ironclads-print.jpg","alt":"Lithograph showing USS Monitor and CSS Virginia fighting in Hampton Roads","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A later lithograph of the March 9 duel. The ships fought at close range, but their armor resisted the available guns."}]]}],["$","figure","/images/uss-monitor-at-sea.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/uss-monitor-at-sea.jpg","alt":"USS Monitor at sea in an 1862 drawing","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Monitor’s shallow draft and small turning circle let it maneuver around Virginia’s fixed broadside guns."}]]}],["$","figure","/images/uss-monitor-crew.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/uss-monitor-crew.jpg","alt":"Members of USS Monitor’s crew on deck near the turret in 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Monitor crewmen on deck near the turret later in 1862. Sixteen members of a later crew died when the ship sank in December."}]]}],["$","figure","/images/css-virginia-drydock.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/css-virginia-drydock.jpg","alt":"CSS Virginia in dry dock at Gosport Navy Yard","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Virginia returned to dry dock after the battle. The Confederacy destroyed it two months later when the loss of Norfolk left it without a base."}]]}]]}]]}]
