1a:["$","$L19",null,{"seconds":704,"label":"11:44"}]
1b:["$","div",null,{"children":[["$","h3",null,{"children":"Monitor intercepted Virginia"}],["$","p",null,{"children":"Just before 8:30 a.m., Worden got underway and moved away from Minnesota so the fight would occur farther from the grounded ship."}]]}]
1c:["$","div","Greene commanded the turret",{"className":"moment","children":[["$","$L19",null,{"seconds":725,"label":"12:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Greene commanded the turret"}],["$","p",null,{"children":"Samuel D. Greene supervised 16 gun crewmen loading and firing the two Dahlgrens. The speaking tube to Worden’s pilot house did not work, so messengers carried orders."}]]}]]}]
1d:["$","div","Monitor fired at close range",{"className":"moment","children":[["$","$L19",null,{"seconds":801,"label":"13:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor fired at close range"}],["$","p",null,{"children":"Worden turned to clear the pilot house from the guns’ line of fire. The ships passed within about 100 yards and then moved on roughly opposite courses."}]]}]]}]
1e:["$","div","Virginia answered with a broadside",{"className":"moment","children":[["$","$L19",null,{"seconds":818,"label":"13:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia answered with a broadside"}],["$","p",null,{"children":"Shots struck Monitor’s turret and deck but did not penetrate. The turret continued operating."}]]}]]}]
1f:["$","div","Monitor’s maneuverability mattered",{"className":"moment","children":[["$","$L19",null,{"seconds":873,"label":"14:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor’s maneuverability mattered"}],["$","p",null,{"children":"Its shallow draft and tighter turning radius let Worden choose positions outside the firing arcs of Virginia’s fixed broadside guns."}]]}]]}]
20:["$","div","Monitor used reduced powder charges",{"className":"moment","children":[["$","$L19",null,{"seconds":890,"label":"14:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor used reduced powder charges"}],["$","p",null,{"children":"The Navy limited the 11-inch Dahlgrens to two-thirds charges because John Dahlgren feared repeated full charges might burst them. Later tests showed the guns could safely use more powder."}]]}]]}]
21:["$","div","The ships fought in tightening circles",{"className":"moment","children":[["$","$L19",null,{"seconds":984,"label":"16:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The ships fought in tightening circles"}],["$","p",null,{"children":"They closed to point-blank range. Projectiles struck and dented armor but generally glanced away without penetrating."}]]}]]}]
22:["$","div","Failed communications slowed Monitor",{"className":"moment","children":[["$","$L19",null,{"seconds":1069,"label":"17:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Failed communications slowed Monitor"}],["$","p",null,{"children":"Worden could not see the turret’s target and Greene could not see where the pilot house was steering. Paymaster William Keeler and clerk Daniel Toffey carried messages between them."}]]}]]}]
23:["$","div","Both commanders changed tactics",{"className":"moment","children":[["$","$L19",null,{"seconds":1168,"label":"19:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both commanders changed tactics"}],["$","p",null,{"children":"After about two hours, Jones and Worden recognized that gunfire alone was unlikely to destroy the opposing ironclad."}]]}]]}]
24:["$","div","Monitor tried to strike Virginia’s stern",{"className":"moment","children":[["$","$L19",null,{"seconds":1188,"label":"19:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor tried to strike Virginia’s stern"}],["$","p",null,{"children":"Worden attempted to damage the rudder or propeller but missed the stern by about two feet."}]]}]]}]
25:["$","div","Virginia grounded near Minnesota",{"className":"moment","children":[["$","$L19",null,{"seconds":1211,"label":"20:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia grounded near Minnesota"}],["$","p",null,{"children":"Jones steered toward the frigate and ran onto a shoal. Monitor moved into a blind spot and concentrated fire against one section of the casemate."}]]}]]}]
26:["$","div","Virginia forced itself off the shoal",{"className":"moment","children":[["$","$L19",null,{"seconds":1267,"label":"21:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia forced itself off the shoal"}],["$","p",null,{"children":"H. Ashton Ramsay’s engineers raised boiler pressure beyond normal limits and used full reverse power until the ship pulled free."}]]}]]}]
27:["$","div","Virginia tried to ram Monitor",{"className":"moment","children":[["$","$L19",null,{"seconds":1323,"label":"22:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia tried to ram Monitor"}],["$","p",null,{"children":"The slow ship needed much of an hour to line up the attack. Monitor turned at the last moment, and Virginia delivered only a glancing blow that dented Monitor’s hull."}]]}]]}]
28:["$","div","Jones considered boarding",{"className":"moment","children":[["$","$L19",null,{"seconds":1387,"label":"23:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jones considered boarding"}],["$","p",null,{"children":"Reuben Thom organized marines to cover the pilot-house slits and jam the turret, but Monitor moved away before they could attempt it."}]]}]]}]
29:["$","div","Virginia again threatened Minnesota",{"className":"moment","children":[["$","$L19",null,{"seconds":1423,"label":"23:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia again threatened Minnesota"}],["$","p",null,{"children":"Jones fired at the grounded frigate. Monitor closed to protect it and made another unsuccessful attempt to reach Virginia’s stern."}]]}]]}]
2a:["$","div","A shell struck Monitor’s pilot house",{"className":"moment","children":[["$","$L19",null,{"seconds":1442,"label":"24:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"A shell struck Monitor’s pilot house"}],["$","p",null,{"children":"The blast drove fragments and powder into Worden’s face as he looked through a vision slit. He was temporarily blinded but survived and later recovered his sight."}]]}]]}]
2b:["$","div","Greene assumed command",{"className":"moment","children":[["$","$L19",null,{"seconds":1472,"label":"24:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Greene assumed command"}],["$","p",null,{"children":"Greene left the turret, reached the damaged pilot house, and took control while Monitor moved into water too shallow for Virginia."}]]}]]}]
2c:["$","div","Virginia withdrew",{"className":"moment","children":[["$","$L19",null,{"seconds":1497,"label":"24:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia withdrew"}],["$","p",null,{"children":"Jones first turned toward Minnesota, but pilots warned that the falling tide threatened to trap the deep-draft ship. Virginia left around 12:30 p.m."}]]}]]}]
2d:["$","div","The engagement ended in a tactical draw",{"className":"moment","children":[["$","$L19",null,{"seconds":1542,"label":"25:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"The engagement ended in a tactical draw"}],["$","p",null,{"children":"The episode states that Monitor was hit 23 times and Virginia 20 times. Neither was seriously damaged. Worden was the only casualty aboard either ironclad that day."}]]}]]}]
2e:["$","div","Monitor accomplished its defensive mission",{"className":"moment","children":[["$","$L19",null,{"seconds":1585,"label":"26:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor accomplished its defensive mission"}],["$","p",null,{"children":"Virginia did not destroy Minnesota or break the blockade. United States warships retained control of Hampton Roads."}]]}]]}]
2f:["$","div","The Navy ordered more monitor-type ships",{"className":"moment","children":[["$","$L19",null,{"seconds":1686,"label":"28:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Navy ordered more monitor-type ships"}],["$","p",null,{"children":"Twenty-one seagoing and seven river monitors entered service during the war. Confederate shipbuilders continued to favor casemate ironclads based on Virginia."}]]}]]}]
30:["$","div","Virginia affected the Peninsula Campaign",{"className":"moment","children":[["$","$L19",null,{"seconds":1744,"label":"29:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia affected the Peninsula Campaign"}],["$","p",null,{"children":"Its presence restricted United States naval access to the James River and complicated McClellan’s operations even after the March battle."}]]}]]}]
31:["$","div","Virginia tried to draw Monitor into another fight",{"className":"moment","children":[["$","$L19",null,{"seconds":1777,"label":"29:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia tried to draw Monitor into another fight"}],["$","p",null,{"children":"Josiah Tattnall brought Virginia out on April 11, but Monitor remained near Fort Monroe under orders not to take unnecessary risks."}]]}]]}]
32:["$","div","Virginia was scuttled after Norfolk fell",{"className":"moment","children":[["$","$L19",null,{"seconds":1793,"label":"29:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia was scuttled after Norfolk fell"}],["$","p",null,{"children":"Confederates evacuated Norfolk in May. Virginia remained too deep to go up the James even after being lightened, so its crew destroyed it near Craney Island on May 11."}]]}]]}]
33:["$","div","United States ships were stopped at Drewry’s Bluff",{"className":"moment","children":[["$","$L19",null,{"seconds":1849,"label":"30:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States ships were stopped at Drewry’s Bluff"}],["$","p",null,{"children":"Monitor and Galena led a James River expedition on May 15. Confederate batteries eight miles below Richmond forced the squadron to withdraw."}]]}]]}]
34:["$","div","Monitor sank off Cape Hatteras",{"className":"moment","children":[["$","$L19",null,{"seconds":1892,"label":"31:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor sank off Cape Hatteras"}],["$","p",null,{"children":"While under tow toward Wilmington, it foundered in a storm shortly after midnight on December 31. Four officers and 12 enlisted men died."}]]}]]}]
35:["$","div","The wreck was found in 1973",{"className":"moment","children":[["$","$L19",null,{"seconds":1949,"label":"32:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The wreck was found in 1973"}],["$","p",null,{"children":"A Duke University team located Monitor with sonar. The site became the first United States national marine sanctuary in 1975."}]]}]]}]
36:["$","div","The turret was recovered in 2002",{"className":"moment","children":[["$","$L19",null,{"seconds":1980,"label":"33:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The turret was recovered in 2002"}],["$","p",null,{"children":"A conservation team raised the 120-ton turret on August 5. It was transferred to the Mariners’ Museum in Newport News for treatment."}]]}]]}]
37:["$","p",null,{"children":"Virginia’s chief engineer who forced the grounded ship back into deep water"}]
38:["$","article","William F. Keeler",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WF"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"William F. Keeler"}],["$","p",null,{"children":"Monitor paymaster who carried messages between the pilot house and turret"}]]}]]}]
