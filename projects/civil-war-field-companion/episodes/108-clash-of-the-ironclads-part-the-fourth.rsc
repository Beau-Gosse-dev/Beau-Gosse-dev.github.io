","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://monitor.noaa.gov/150th/hampton.html",{"children":["$","a",null,{"href":"https://monitor.noaa.gov/150th/hampton.html","target":"_blank","rel":"noreferrer","children":["NOAA Monitor National Marine Sanctuary: Battle of Hampton Roads"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va008",{"children":["$","a",null,{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va008","target":"_blank","rel":"noreferrer","children":["National Park Service: Battle of Hampton Roads"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/91482238/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/91482238/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Monitor and Merrimac lithograph"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/2011646197/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/2011646197/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Crew of Monitor"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}]]}]]}]
