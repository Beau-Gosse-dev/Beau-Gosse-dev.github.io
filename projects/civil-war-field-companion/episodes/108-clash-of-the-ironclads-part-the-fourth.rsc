f:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The battle area today"}],["$","span",null,{"children":"The ironclads fought in Hampton Roads between Newport News Point, Sewell’s Point, and Fort Monroe. Minnesota remained grounded north of the main shipping channel."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
