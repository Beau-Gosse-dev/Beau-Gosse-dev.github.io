1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",108," · ","March 9, 1862, with the ships’ later history through 2002"," · ","Hampton Roads and the James River, Virginia; later Cape Hatteras, North Carolina"]}],["$","h1",null,{"children":"CLASH OF THE IRONCLADS (Part the Fourth)"}],["$","span",null,{"className":"result-label","children":"Monitor and Virginia fought for about four hours on March 9, but neither penetrated the other’s armor or disabled the opposing ship. The immediate engagement was a tactical draw. Monitor protected the grounded Minnesota and the United States blockade remained in place, giving the United States the strategic advantage. Virginia withdrew around 12:30 p.m.; Monitor did not pursue because its orders centered on Minnesota"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8135992802.mp3?updated=1695129263","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Ironclad battle",{"children":[["$","span",null,{"children":"Ironclad battle"}],["$","strong",null,{"children":"About 8:30 a.m.–12:30 p.m., March 9, 1862"}],"$undefined"]}],["$","div","Monitor armament",{"children":[["$","span",null,{"children":"Monitor armament"}],["$","strong",null,{"children":"Two 11-inch Dahlgren smoothbores in a revolving turret"}],"$undefined"]}],["$","div","Virginia armament",{"children":[["$","span",null,{"children":"Virginia armament"}],["$","strong",null,{"children":"Ten guns in a fixed armored casemate"}],"$undefined"]}],["$","div","Hits stated in episode",{"children":[["$","span",null,{"children":"Hits stated in episode"}],["$","strong",null,{"children":"Monitor: 23; Virginia: 20"}],"$undefined"]}],["$","div","March 9 casualties",{"children":[["$","span",null,{"children":"March 9 casualties"}],["$","strong",null,{"children":"John Worden wounded; no one else killed or wounded aboard either ironclad"}],"$undefined"]}],["$","div","Tactical result",{"children":[["$","span",null,{"children":"Tactical result"}],["$","strong",null,{"children":"Draw; neither ironclad seriously damaged the other"}],"$undefined"]}],["$","div","Strategic result",{"children":[["$","span",null,{"children":"Strategic result"}],["$","strong",null,{"children":"United States advantage; Minnesota and the blockade remained in place"}],"$undefined"]}],["$","div","Virginia destroyed",{"children":[["$","span",null,{"children":"Virginia destroyed"}],["$","strong",null,{"children":"Scuttled near Craney Island on May 11, 1862"}],"$undefined"]}],["$","div","Monitor lost",{"children":[["$","span",null,{"children":"Monitor lost"}],["$","strong",null,{"children":"Sank off Cape Hatteras on December 31, 1862; 16 crewmen died"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{