1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",194," · ","September 17, 1862"," · ","The northern Antietam battlefield near Sharpsburg, Maryland, from Pry Ford and the East Woods west across Miller’s Cornfield and the Hagerstown Turnpike into the West Woods and the ground around the Dunker Church"]}],["$","h1",null,{"children":"ANTIETAM (Part the Ninth)"}],["$","span",null,{"className":"result-label","children":"At about 9 a.m. the United States held much of the ground east of the Hagerstown Turnpike, but Joseph Hooker’s wound removed the northern attack’s senior commander as Confederate reinforcements arrived. Edwin V. Sumner then pushed John Sedgwick’s division into the West Woods without reconnaissance, a skirmish line, close support, or coordination with William French. McLaws’s, Early’s, and other Confederate commands struck Sedgwick’s exposed flank while artillery fired from Hauser Ridge. The division broke after roughly twenty minutes and lost about 2,200 men by the National Park Service estimate. George S. Greene retained a small foothold near the Dunker Church, but the Federal opportunity for a decisive breakthrough on Lee’s left had passed"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5751636453.mp3?updated=1695499512","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"About 9 a.m. to shortly after 10 a.m. on the northern battlefield"}],["$","small",null,{"children":"The episode begins with the opening attacks nearly spent, follows Hooker’s wounding and Sedgwick’s advance into the West Woods, and closes with Greene still holding near the Dunker Church."}]]}],["$","div","Cost before Sumner arrived",{"children":[["$","span",null,{"children":"Cost before Sumner arrived"}],["$","strong",null,{"children":"About 8,000 men already fallen in the episode’s estimate"}],["$","small",null,{"children":"The episode describes the losses from three hours of fighting around the Cornfield, East Woods, and Hagerstown Turnpike as divided about evenly between the armies."}]]}],["$","div","Federal opportunity at 9 a.m.",{"children":[["$","span",null,{"children":"Federal opportunity at 9 a.m."}],["$","strong",null,{"children":"Confederates driven from the ground east of the turnpike"}],["$","small",null,{"children":"Hooker and Mansfield had attacked separately, but their successive blows left Jackson’s and D. H. Hill’s formations disordered and created a short-lived chance to break Lee’s left."}]]}],["$","div","Lee’s emergency response",{"children":[["$","span",null,{"children":"Lee’s emergency response"}],["$","strong",null,{"children":"A fallback gun line and fresh infantry for Jackson"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}],"$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d"]}]]}]
30:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"Lee directed artillery toward Hauser Ridge and sent Lafayette McLaws’s division and George T. Anderson’s brigade north. The episode presents these reinforcements as arriving just before Sedgwick’s attack."}]
f:["$","div","Hooker wounded",{"children":[["$","span",null,{"children":"Hooker wounded"}],["$","strong",null,{"children":"Shot in the foot near the front"}],["$","small",null,{"children":"Hooker was positioning troops and batteries when a bullet struck him. He was carried from the field after ordering XII Corps troops to take and hold the woods."}]]}]
10:["$","div","Williams’s message",{"children":[["$","span",null,{"children":"Williams’s message"}],["$","strong",null,{"children":"“We hold the field at present”"}],["$","small",null,{"children":"After taking command of XII Corps from the mortally wounded Mansfield, Alpheus Williams reported Hooker’s wound, Sumner’s approach, and the need for immediate assistance."}]]}]
11:["$","div","II Corps order time",{"children":[["$","span",null,{"children":"II Corps order time"}],["$","strong",null,{"children":"7:20 a.m."}],["$","small",null,{"children":"Sumner’s official report agrees with the episode that he received the order to march at 7:20. Sedgwick led, French followed, and Richardson was released later."}]]}]
12:["$","div","A division held east of the creek",{"children":[["$","span",null,{"children":"A division held east of the creek"}],["$","strong",null,{"children":"McClellan initially retained one of Sumner’s three divisions"}],["$","small",null,{"children":"The episode says the division could not move until George Morell’s V Corps division replaced it; Morell took about ninety minutes to cover roughly one mile."}]]}]
13:["$","div","Northern command vacuum",{"children":[["$","span",null,{"children":"Northern command vacuum"}],["$","strong",null,{"children":"Mansfield mortally wounded and Hooker removed"}],["$","small",null,{"children":"By the time Sumner reached the East Woods, neither of the commanders who had directed the I and XII Corps attacks could coordinate him. Williams briefed Sumner on the scattered Federal positions."}]]}]
14:["$","div","Sumner’s concept",{"children":[["$","span",null,{"children":"Sumner’s concept"}],["$","strong",null,{"children":"Drive west, then wheel south through the Confederate line"}],["$","small",null,{"children":"Seeing Greene near the Dunker Church, Sumner treated that advanced position as the army’s flank and planned to sweep Sedgwick through the West Woods toward Sharpsburg."}]]}]
15:["$","div","Precautions omitted",{"children":[["$","span",null,{"children":"Precautions omitted"}],["$","strong",null,{"children":"No effective reconnaissance, skirmish screen, or close support"}],["$","small",null,{"children":"The episode emphasizes that Sumner advanced without establishing the Confederate position in the broken, wooded ground and did not wait for French’s division."}]]}]
16:["$","div","Confederate recovery",{"children":[["$","span",null,{"children":"Confederate recovery"}],["$","strong",null,{"children":"About 3,000 fresh troops added before Sedgwick arrived"}],["$","small",null,{"children":"The episode says Jackson had only about 1,400 effectives immediately after Hood’s repulse, then received Anderson’s brigade and three brigades under McLaws."}]]}]
17:["$","div","Sedgwick’s strength",{"children":[["$","span",null,{"children":"Sedgwick’s strength"}],["$","strong",null,{"children":"About 5,400 men in the episode; 5,300 in the NPS overview"}],["$","small",null,{"children":"The small difference reflects the uncertainty common in battlefield strength estimates. Both figures describe a large division committed in a single unsupported thrust."}]]}]
18:["$","div","Attack formation",{"children":[["$","span",null,{"children":"Attack formation"}],["$","strong",null,{"children":"Three brigade lines on a front about 500 yards wide"}],["$","small",null,{"children":"Gorman led, Dana followed, and Howard commanded the third line. The episode places the lines only about thirty yards apart; Howard’s official report gives sixty to seventy paces."}]]}]
19:["$","div","French separated",{"children":[["$","span",null,{"children":"French separated"}],["$","strong",null,{"children":"About twenty minutes behind Sedgwick"}],["$","small",null,{"children":"Sumner left no staff officer to direct French when that division reached the East Woods. French moved south toward the Sunken Road instead of reinforcing Sedgwick."}]]}]
1a:["$","div","Hauser Ridge artillery",{"children":[["$","span",null,{"children":"Hauser Ridge artillery"}],["$","strong",null,{"children":"Confederate shells struck the compact Federal formation"}],["$","small",null,{"children":"Stuart had shifted guns west of the West Woods, where they could fire over or through openings toward Sedgwick’s closely spaced brigade lines."}]]}]
1b:["$","div","125th Pennsylvania",{"children":[["$","span",null,{"children":"125th Pennsylvania"}],["$","strong",null,{"children":"An isolated new regiment near the Dunker Church"}],["$","small",null,{"children":"Jacob C. Higgins withdrew when Confederate fire reached his front and flank. He reported that remaining two minutes longer would have cost his entire command."}]]}]
1c:["$","div","Friendly-fire crisis",{"children":[["$","span",null,{"children":"Friendly-fire crisis"}],["$","strong",null,{"children":"59th New York fired into the 15th Massachusetts"}],["$","small",null,{"children":"As the rear formations tried to face the attack, units overlapped in the smoke and woods. Sumner rode into the confusion and stopped the New Yorkers’ fire."}]]}]
1d:["$","div","15th Massachusetts loss",{"children":[["$","span",null,{"children":"15th Massachusetts loss"}],["$","strong",null,{"children":"318 casualties in the episode; 330 on the NPS monument page"}],["$","small",null,{"children":"The monument records 75 killed and 255 wounded among 606 present. Different historical tabulations explain why the episode and some NPS pages give nearby but nonidentical totals."}]]}]
1e:["$","div","72nd Pennsylvania loss",{"children":[["$","span",null,{"children":"72nd Pennsylvania loss"}],["$","strong",null,{"children":"237 casualties in the episode"}],["$","small",null,{"children":"The Philadelphia Brigade regiment occupied the exposed left of Howard’s line and was among the first Federal units to collapse under the flank attack."}]]}]
1f:["$","div","Sedgwick’s division",{"children":[["$","span",null,{"children":"Sedgwick’s division"}],["$","strong",null,{"children":"About 2,200 casualties in roughly twenty minutes"}],["$","small",null,{"children":"The National Park Service gives 2,200 losses out of 5,300 men. The episode combines Sedgwick’s division with the 125th Pennsylvania and states a total exceeding 2,300."}]]}]
20:["$","div","Senior Federal wounds",{"children":[["$","span",null,{"children":"Senior Federal wounds"}],["$","strong",null,{"children":"Hooker, Sedgwick, and Dana wounded"}],["$","small",null,{"children":"Hooker left the field with a foot wound. Sedgwick was hit three times and carried away. Dana was wounded while commanding Sedgwick’s second brigade line."}]]}]
21:["$","div","Oliver Wendell Holmes Jr.",{"children":[["$","span",null,{"children":"Oliver Wendell Holmes Jr."}],["$","strong",null,{"children":"Wounded in the neck with the 20th Massachusetts"}],["$","small",null,{"children":"The future Supreme Court justice reached the Nicodemus farmhouse, where wounded men from the shattered division gathered as the ground changed hands."}]]}]
22:["$","div","Greene’s foothold",{"children":[["$","span",null,{"children":"Greene’s foothold"}],["$","strong",null,{"children":"A small Federal force behind the Dunker Church"}],["$","small",null,{"children":"The episode estimates roughly 700 men in the immediate lodgment after Greene repulsed John G. Walker’s attack. Greene’s official report gives 2,504 for his full division before its detachments and losses."}]]}]
23:["$","div","Northern battle after four hours",{"children":[["$","span",null,{"children":"Northern battle after four hours"}],["$","strong",null,{"children":"No decisive Federal breakthrough"}],["$","small",null,{"children":"I Corps could no longer attack, XII Corps was badly reduced, and Sedgwick’s II Corps division was wrecked. Greene still held advanced ground but lacked the reinforcements needed to exploit it."}]]}]
24:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“A Field Guide to Antietam” by Carol Reardon and Tom Vossler"}],["$","small",null,{"children":"The guide organizes twenty-one battlefield stops around what happened, who fought and commanded, who fell and lived there, and how participants remembered the event."}]]}]
25:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Dunker Church, Hauser Ridge, McLaws, Morell, George T. Anderson, J. E. B. Stuart, Alfred Poffenberger, and Jacob C. Higgins"}],["$","small",null,{"children":"The automated transcript produces forms including “Dunkirk Church,” “Housers Ridge,” “McClaws,” “Morrill,” “Tyg Anderson,” “J.O.B. Stewart,” and “Poffenberg.” This guide uses standard historical spellings."}]]}]
26:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
27:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Sumner’s approach to the northern battlefield",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep194-sumner-approach.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Sumner’s approach to the northern battlefield at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep194-sumner-approach.svg","alt":"Schematic map of Sedgwick’s route from the East Woods across the Cornfield and Hagerstown Turnpike into the West Woods, with French trailing and Confederate reinforcements moving north.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Sumner’s approach to the northern battlefield"}],["$","span",null,{"children":"Sedgwick led II Corps west from Pry Ford and the East Woods while French followed about twenty minutes behind and Richardson remained farther back. Sumner drove Sedgwick across the Cornfield and turnpike toward the West Woods just as McLaws and George T. Anderson reinforced Jackson. Greene held near the Dunker Church and Hooker’s wound had removed the commander intended to coordinate the northern attack. Routes and positions are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep194-sumner-approach.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield West Woods Trail, U.S. Army Center of Military History staff ride guide, Official Reports, Antietam Battlefield Board atlas, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Sedgwick enveloped in the West Woods",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep194-west-woods-envelopment.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Sedgwick enveloped in the West Woods at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep194-west-woods-envelopment.svg","alt":"Schematic tactical map showing Sedgwick’s three close brigade lines in the West Woods struck by Confederate infantry from the south and artillery from Hauser Ridge.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Sedgwick enveloped in the West Woods"}],["$","span",null,{"children":"Gorman, Dana, and Howard entered in three close brigade lines with little room to turn. Confederate infantry under Early, Barksdale, Semmes, and associated commands struck the exposed left and rear while Stuart’s guns fired from Hauser Ridge. Kershaw’s advance also drove the 125th Pennsylvania from the Dunker Church sector. Movements are generalized and compressed. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep194-west-woods-envelopment.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],"$L2e"]}],"$undefined"]}]]}],"$L2f"]}]]}]
28:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The battlefield at 9 a.m. is recapped",{"className":"moment","children":[["$","$L30",null,{"seconds":70,"label":"1:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battlefield at 9 a.m. is recapped"}],["$","p",null,{"children":"After three hours of combat and about 8,000 losses, Federal troops have cleared the ground east of the Hagerstown Turnpike."}]]}]]}],["$","div","Jackson’s line reaches the breaking point",{"className":"moment","children":[["$","$L30",null,{"seconds":150,"label":"2:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s line reaches the breaking point"}],["$","p",null,{"children":"Wrecked Confederate formations try to rally while the XII Corps advance creates a chance for a Federal breakthrough."}]]}]]}],["$","div","Hood sends an urgent warning",{"className":"moment","children":[["$","$L30",null,{"seconds":177,"label":"2:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood sends an urgent warning"}],["$","p",null,{"children":"Stephen D. Lee carries Hood’s message that the Confederate left may collapse unless Robert E. Lee sends reinforcements."}]]}]]}],["$","div","Lee builds a fallback position",{"className":"moment","children":[["$","$L30",null,{"seconds":206,"label":"3:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee builds a fallback position"}],["$","p",null,{"children":"Lee plans an artillery line on Hauser Ridge and points to McLaws’s approaching division as support for Jackson."}]]}]]}],["$","div","Hooker sees victory within reach",{"className":"moment","children":[["$","$L30",null,{"seconds":253,"label":"4:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker sees victory within reach"}],["$","p",null,{"children":"With Greene near the church and the Confederate front disordered, Hooker believes Lee’s army can be driven toward the Potomac."}]]}]]}],["$","div","Hooker is shot in the foot",{"className":"moment","children":[["$","$L30",null,{"seconds":281,"label":"4:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker is shot in the foot"}],["$","p",null,{"children":"A Confederate bullet strikes Hooker while he rides his white horse near the front and personally places troops and guns."}]]}]]}],["$","div","Hooker gives a final order",{"className":"moment","children":[["$","$L30",null,{"seconds":300,"label":"5:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker gives a final order"}],["$","p",null,{"children":"As he leaves the field, Hooker tells the XII Corps troops to carry and hold the woods."}]]}]]}],["$","div","Williams asks headquarters for help",{"className":"moment","children":[["$","$L30",null,{"seconds":309,"label":"5:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Williams asks headquarters for help"}],["$","p",null,{"children":"The acting XII Corps commander reports Mansfield and Hooker wounded, Sumner approaching, and the field still in Federal hands."}]]}]]}],["$","div","McClellan finally releases II Corps",{"className":"moment","children":[["$","$L30",null,{"seconds":350,"label":"5:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan finally releases II Corps"}],["$","p",null,{"children":"At 7:20 a.m. McClellan orders Sumner to support the northern attack but initially holds one division east of the creek."}]]}]]}],["$","div","Morell’s relief march consumes ninety minutes",{"className":"moment","children":[["$","$L30",null,{"seconds":382,"label":"6:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Morell’s relief march consumes ninety minutes"}],["$","p",null,{"children":"The episode faults the V Corps division for moving about one mile without the urgency needed to free Sumner’s third division."}]]}]]}],["$","div","Sedgwick reaches the East Woods",{"className":"moment","children":[["$","$L30",null,{"seconds":409,"label":"6:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sedgwick reaches the East Woods"}],["$","p",null,{"children":"A lull has settled over the brightening northern field when Sumner arrives with his leading division."}]]}]]}],"$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e"]}]]}]
29:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Released II Corps at 7:20 a.m. but initially retained one division east of Antietam Creek and failed to provide close coordination on the northern field"}]]}],["$","div","I Corps and northern wing",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps and northern wing"}],["$","span",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","small",null,{"children":"Tried to renew the offensive near the West Woods before a foot wound removed him from command"}]]}],["$","div","XII Corps after Mansfield’s wounding",{"className":"command-entry","children":[["$","strong",null,{"children":"XII Corps after Mansfield’s wounding"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Briefed Sumner, supported Greene, and attempted to reinforce the West Woods fighting with available regiments"}]]}],["$","div","2nd Division, XII Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, XII Corps"}],["$","span",null,{"children":"Brig. Gen. George S. Greene"}],["$","small",null,{"children":"Held advanced ground near the Dunker Church, repulsed Confederate attacks, and repeatedly requested reinforcements"}]]}],["$","div","125th Pennsylvania, XII Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"125th Pennsylvania, XII Corps"}],["$","span",null,{"children":"Col. Jacob C. Higgins"}],["$","small",null,{"children":"Held an isolated position near the church until Confederate fire reached the regiment’s front and flank"}]]}],["$","div","II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps"}],["$","span",null,{"children":"Maj. Gen. Edwin V. Sumner"}],["$","small",null,{"children":"Personally led Sedgwick west without reconnaissance or close support and tried to rally the division when it was enveloped"}]]}],["$","div","2nd Division, II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, II Corps"}],["$","span",null,{"children":"Maj. Gen. John Sedgwick"}],["$","small",null,{"children":"Advanced three brigade lines into the West Woods and was wounded three times during the collapse"}]]}],["$","div","1st Brigade, Sedgwick’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Sedgwick’s division"}],["$","span",null,{"children":"Brig. Gen. Willis A. Gorman"}],["$","small",null,{"children":"Led the front line across the turnpike and fought near the Alfred Poffenberger farm on the far side of the woods"}]]}],["$","div","3rd Brigade, Sedgwick’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Brigade, Sedgwick’s division"}],["$","span",null,{"children":"Brig. Gen. Napoleon J. T. Dana"}],["$","small",null,{"children":"Led the second brigade line and was wounded during the Confederate flank attack"}]]}],["$","div","2nd Brigade and then Sedgwick’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade and then Sedgwick’s division"}],["$","span",null,{"children":"Brig. Gen. Oliver O. Howard"}],["$","small",null,{"children":"Commanded the rear brigade line and assumed division command after Sedgwick was carried from the field"}]]}],["$","div","3rd Division, II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division, II Corps"}],["$","span",null,{"children":"Brig. Gen. William H. French"}],["$","small",null,{"children":"Arrived behind Sedgwick without guidance and turned south toward the Sunken Road instead of entering the West Woods"}]]}]]]}],"$L4f"]}],"$L50","$L51"]}]
2a:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Maj. Gen. Joseph Hooker",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of I Corps and the northern wing","."]}]," ","Wounded in the foot while placing troops and artillery near the front; blood loss and pain forced him from the field and removed the commander intended to coordinate Sumner’s arrival."]}]]}],["$","article","Maj. Gen. John Sedgwick",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. John Sedgwick"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of 2nd Division, II Corps","."]}]," ","Hit three times—in the wrist, leg, and shoulder—during the West Woods repulse and carried from the field; Brig. Gen. Oliver O. Howard assumed division command."]}]]}],["$","article","Brig. Gen. Napoleon J. T. Dana",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brig. Gen. Napoleon J. T. Dana"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of 3rd Brigade, Sedgwick’s division","."]}]," ","Wounded while leading the second brigade line in the West Woods. Sumner’s official report lists Dana among the brigade commanders wounded during the battle."]}]]}]]}]]}]
