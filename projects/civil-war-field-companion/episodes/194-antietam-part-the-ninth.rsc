41:["$","div","Jackson turns on Sedgwick’s flank",{"className":"moment","children":[["$","$L30",null,{"seconds":1345,"label":"22:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson turns on Sedgwick’s flank"}],["$","p",null,{"children":"Early, Barksdale, and Semmes spearhead the attack against a formation that has almost no room to face south."}]]}]]}]
42:["$","div","Sumner tries to reverse the disaster",{"className":"moment","children":[["$","$L30",null,{"seconds":1396,"label":"23:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sumner tries to reverse the disaster"}],["$","p",null,{"children":"His first signals are mistaken for an order to charge before he gets close enough to tell the troops to move back."}]]}]]}]
