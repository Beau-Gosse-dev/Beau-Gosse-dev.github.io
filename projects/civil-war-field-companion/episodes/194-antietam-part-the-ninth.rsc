32:["$","section","Confederacy",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Moved artillery to Hauser Ridge and timed reinforcements from the army’s right and reserve to sustain the threatened left"}]]}],["$","div","Confederate left wing-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate left wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Reorganized the West Woods defense and directed the counterattack against Sedgwick’s exposed left flank"}]]}],["$","div","McLaws’s division-Maj. Gen. Lafayette McLaws",{"className":"command-entry","children":[["$","strong",null,{"children":"McLaws’s division"}],["$","span",null,{"children":"Maj. Gen. Lafayette McLaws"}],["$","small",null,{"children":"Brought Kershaw’s, Barksdale’s, and Semmes’s brigades north in time to join the West Woods counterstroke"}]]}],["$","div","Kershaw’s brigade, McLaws’s division-Brig. Gen. Joseph B. Kershaw",{"className":"command-entry","children":[["$","strong",null,{"children":"Kershaw’s brigade, McLaws’s division"}],["$","span",null,{"children":"Brig. Gen. Joseph B. Kershaw"}],["$","small",null,{"children":"Attacked near the Dunker Church and pursued withdrawing Federal troops toward the East Woods before canister stopped the advance"}]]}],["$","div","Barksdale’s brigade, McLaws’s division-Brig. Gen. William Barksdale",{"className":"command-entry","children":[["$","strong",null,{"children":"Barksdale’s brigade, McLaws’s division"}],["$","span",null,{"children":"Brig. Gen. William Barksdale"}],["$","small",null,{"children":"Helped spearhead the assault into the exposed flank o