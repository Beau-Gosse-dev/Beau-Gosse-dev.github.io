4f:["$","section","Confederacy",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Moved artillery to Hauser Ridge and timed reinforcements from the army’s right and reserve to sustain the threatened left"}]]}],["$","div","Confederate left wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate left wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Reorganized the West Woods defense and directed the counterattack against Sedgwick’s exposed left flank"}]]}],["$","div","McLaws’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"McLaws’s division"}],["$","span",null,{"children":"Maj. Gen. Lafayette McLaws"}],["$","small",null,{"children":"Brought Kershaw’s, Barksdale’s, and Semmes’s brigades north in time to join the West Woods counterstroke"}]]}],["$","div","Kershaw’s brigade, McLaws’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Kershaw’s brigade, McLaws’s division"}],["$","span",null,{"children":"Brig. Gen. Joseph B. Kershaw"}],["$","small",null,{"children":"Attacked near the Dunker Church and pursued withdrawing Federal troops toward the East Woods before canister stopped the advance"}]]}],["$","div","Barksdale’s brigade, McLaws’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Barksdale’s brigade, McLaws’s division"}],["$","span",null,{"children":"Brig. Gen. William Barksdale"}],["$","small",null,{"children":"Helped spearhead the assault into the exposed flank of Sedgwick’s compact formation"}]]}],["$","div","Semmes’s brigade, McLaws’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Semmes’s brigade, McLaws’s division"}],["$","span",null,{"children":"Brig. Gen. Paul J. Semmes"}],["$","small",null,{"children":"Advanced from the south with the Confederate force enveloping Sedgwick in the woods"}]]}],["$","div","Early’s brigade and remnants of Ewell’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Early’s brigade and remnants of Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Jubal A. Early"}],["$","small",null,{"children":"Returned from the Confederate flank and attacked the Federal left with McLaws’s brigades"}]]}],["$","div","Anderson’s brigade, D. R. Jones’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Anderson’s brigade, D. R. Jones’s division"}],["$","span",null,{"children":"Col. George T. Anderson"}],["$","small",null,{"children":"Arrived from the Confederate right and reinforced Jackson in the West Woods before Sedgwick’s attack"}]]}],["$","div","Cavalry and artillery on the Confederate left",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry and artillery on the Confederate left"}],["$","span",null,{"children":"Brig. Gen. J. E. B. Stuart"}],["$","small",null,{"children":"Shifted batteries toward Hauser Ridge and supported the attack on Sedgwick’s front and flank"}]]}],["$","div","Walker’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Walker’s division"}],["$","span",null,{"children":"Brig. Gen. John G. Walker"}],["$","small",null,{"children":"Sent brigades from the Confederate right; one checked XII Corps troops in the West Woods while the other failed to dislodge Greene"}]]}]]]}]
