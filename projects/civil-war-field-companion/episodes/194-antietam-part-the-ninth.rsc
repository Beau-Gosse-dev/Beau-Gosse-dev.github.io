4c:["$","div","The northern attacks are spent",{"className":"moment","children":[["$","$L30",null,{"seconds":2178,"label":"36:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The northern attacks are spent"}],["$","p",null,{"children":"I Corps, XII Corps, and Sedgwick’s division have all been badly damaged, with their commanders wounded or killed."}]]}]]}]
4d:["$","div","The initiative passes from McClellan",{"className":"moment","children":[["$","$L30",null,{"seconds":2248,"label":"37:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The initiative passes from McClellan"}],["$","p",null,{"children":"The episode concludes that piecemeal commitment and poor coordination allowed Lee to stop each Federal attack in turn."}]]}]]}]
