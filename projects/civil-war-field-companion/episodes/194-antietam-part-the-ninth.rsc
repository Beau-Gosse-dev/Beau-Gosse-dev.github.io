46:["$","div","The twenty-minute cost is counted",{"className":"moment","children":[["$","$L30",null,{"seconds":1700,"label":"28:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The twenty-minute cost is counted"}],["$","p",null,{"children":"The episode places more than 2,300 Federal casualties in Sedgwick’s division and the 125th Pennsylvania, against fewer than 1,000 Confederate losses in Jackson’s immediate counterstroke."}]]}]]}]
47:["$","div","Sumner signals for reinforcements",{"className":"moment","children":[["$","$L30",null,{"seconds":1752,"label":"29:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sumner signals for reinforcements"}],["$","p",null,{"children":"He warns McClellan that the troops are giving way and asks headquarters to locate French’s missing division."}]]}]]}]
