3f:["$","div","The 125th Pennsylvania is hit",{"className":"moment","children":[["$","$L30",null,{"seconds":1220,"label":"20:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 125th Pennsylvania is hit"}],["$","p",null,{"children":"Fire reaches Jacob Higgins’s isolated regiment near the Dunker Church from both front and flank."}]]}]]}]
