f:["$","figure","United States positions and Confederate attacks, 9–10 a.m.",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/shiloh-april-6-midmorning.svg","target":"_blank","rel":"noreferrer","aria-label":"Open United States positions and Confederate attacks, 9–10 a.m. at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-april-6-midmorning.svg","alt":"Tactical map of the Shiloh battlefield at mid-morning on April 6, 1862","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"United States positions and Confederate attacks, 9–10 a.m."}],["$","span",null,{"children":"Wallace, Prentiss, and Hurlbut formed a new center while Stuart remained isolated near the river. Seven Confederate brigades converged against Sherman and Raith around Shiloh Church; Chalmers and Jackson were diverted toward Stuart."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/shiloh-april-6-midmorning.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
