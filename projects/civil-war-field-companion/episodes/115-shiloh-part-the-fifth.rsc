. Wallace",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"W. H. L. Wallace"}],["$","p",null,{"children":"Commanded the 2nd Division and helped form the new United States center"}]]}]]}],["$","article","Stephen A. Hurlbut",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"SA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Stephen A. Hurlbut"}],["$","p",null,{"children":"Placed two brigades across Bell Field on the left of Prentiss"}]]}]]}],["$","article","David Stuart",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"DS"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"David Stuart"}],["$","p",null,{"children":"Commanded the isolated brigade that Confederate scouts mistook for a full division"}]]}]]}],["$","article","Albert Sidney Johnston",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/albert-sidney-johnston.jpg","alt":"Portrait of Albert Sidney Johnston","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Albert Sidney Johnston"}],["$","p",null,{"children":"Diverted forces toward Stuart and believed the United States army was nearly trapped"}]]}]]}],["$","article","Patrick Cleburne",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"PC"}]}],["$","div",null,{"