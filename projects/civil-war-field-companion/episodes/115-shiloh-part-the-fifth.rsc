21:["$","div","Seven Confederate brigades faced Sherman and Raith",{"className":"moment","children":[["$","$L17",null,{"seconds":1919,"label":"31:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Seven Confederate brigades faced Sherman and Raith"}],["$","p",null,{"children":"By about 9:30, formations from Hardee, Bragg, and Polk had converged around Shiloh Church without a single coordinating commander."}]]}]]}]
