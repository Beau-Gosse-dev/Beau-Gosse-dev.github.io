1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",115," · ","April 6, 1862, about 5–10 a.m."," · ","Shiloh Church, Ray Field, the farm lane through the United States center, Bell Field, and the Hamburg–Savannah Road, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Fifth)"}],["$","span",null,{"className":"result-label","children":"Prentiss re-formed part of his routed division, and the divisions of W. H. L. Wallace and Stephen Hurlbut extended the new United States center. Johnston diverted Chalmers and Jackson toward Stuart’s isolated brigade after mistaking it for a full division. On the United States right, Sherman recovered from the initial surprise and held near Shiloh Church for more than two hours. By about 10 a.m., seven Confederate brigades had converged on Sherman and Julius Raith, and Hildebrand’s brigade began to break"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2840487693.mp3?updated=1695140586","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","New United States center",{"children":[["$","span",null,{"children":"New United States center"}],["$","strong",null,{"children":"Nearly one mile from the Corinth Road to the Hamburg–Savannah Road"}],"$undefined"]}],["$","div","Prentiss’s reinforcement",{"children":[["$","span",null,{"children":"Prentiss’s reinforcement"}],["$","strong",null,{"children":"About 1,000 fresh men of the 23rd Missouri"}],"$undefined"]}],["$","div","Center formed",{"children":[["$","span",null,{"children":"Center formed"}],["$","strong",null,{"children":"About 9–9:30 a.m."}],"$undefined"]}],["$","div","Stuart’s detached brigade",{"children":[["$","span",null,{"children":"Stuart’s detached brigade"}],["$","strong",null,{"children":"One Illinois and two Ohio regiments near the river"}],"$undefined"]}],["$","div","Gap beside Stuart",{"children":[["$","span",null,{"children":"Gap beside Stuart"}],["$","strong",null,{"children":"About 200 yards, obstructed by woods and a ravine"}],"$undefined"]}],["$","div","Cleburne’s formation",{"children":[["$","span",null,{"children":"Cleburne’s formation"}],["$","strong",null,{"children":"Six regiments in one line, roughly one mile wide before terrain divided it"}],"$undefined"]}],["$","div","Confederate concentration",{"children":[["$","span",null,{"children":"Confederate concentration"}],["$","strong",null,{"children":"Seven brigades against Sherman and Raith by about 9:30 a.m."}],"$undefined"]}],["$","div","Sherman’s wound",{"children":[["$","span",null,{"children":"Sherman’s wound"}],["$","strong",null,{"children":"Buckshot through the right hand; he remained in command"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"Peop