11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode resumes after Prentiss’s defeat",{"className":"moment","children":[["$","$L17",null,{"seconds":70,"label":"1:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode resumes after Prentiss’s defeat"}],["$","p",null,{"children":"The Confederate attack had driven Prentiss’s division from its camps, but it had not cut the United States army off from Pittsburg Landing."}]]}]]}],["$","div","Confederate troops stopped in the captured camps",{"className":"moment","children":[["$","$L17",null,{"seconds":220,"label":"3:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate troops stopped in the captured camps"}],["$","p",null,{"children":"Some formations became disorganized while soldiers searched the tents and collected food and equipment."}]]}]]}],["$","div","Johnston received an incorrect report about Stuart",{"className":"moment","children":[["$","$L17",null,{"seconds":274,"label":"4:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston received an incorrect report about Stuart"}],["$","p",null,{"children":"A cavalry patrol saw Stuart’s detached brigade and reported a United States division moving south near the river."}]]}]]}],["$","div","Johnston diverted two brigades",{"className":"moment","children":[["$","$L17",null,{"seconds":422,"label":"7:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston diverted two brigades"}],["$","p",null,{"children":"He sent James Chalmers and John K. Jackson toward Stuart, leaving only one brigade to cover a large part of the Confederate center."}]]}]]}],["$","div","Two reserve brigades were redirected",{"className":"moment","children":[["$","$L17",null,{"seconds":496,"label":"8:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two reserve brigades were redirected"}],["$","p",null,{"children":"Johnston changed earlier orders and sent two of Breckinridge’s brigades back toward the right to reinforce the weakened center."}]]}]]}],["$","div","Prentiss rebuilt part of his division",{"className":"moment","children":[["$","$L17",null,{"seconds":526,"label":"8:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Prentiss rebuilt part of his division"}],["$","p",null,{"children":"Survivors rallied along a farm lane about 1,200 yards north of their captured camps instead of counterattacking."}]]}]]}],["$","div","The 23rd Missouri joined Prentiss",{"className":"moment","children":[["$","$L17",null,{"seconds":610,"label":"10:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 23rd Missouri joined Prentiss"}],["$","p",null,{"children":"The newly arrived regiment contributed about 1,000 fresh soldiers, probably more men than Prentiss had rallied from his original division."}]]}]]}],["$","div","Wallace and Hurlbut formed a new center",{"className":"moment","children":[["$","$L17",null,{"seconds":666,"label":"11:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wallace and Hurlbut formed a new center"}],["$","p",null,{"children":"Their divisions took positions on either side of Prentiss between about 9 and 9:30 a.m."}]]}]]}],["$","div","MacArthur extended Hurlbut’s left",{"className":"moment","children":[["$","$L17",null,{"seconds":736,"label":"12:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"MacArthur extended Hurlbut’s left"}],["$","p",null,{"children":"W. H. L. Wallace sent John McArthur’s brigade across the line, but a 200-yard wooded gap still separated it from Stuart."}]]}]]}],["$","div","A lull developed in the center",{"className":"moment","children":[["$","$L17",null,{"seconds":785,"label":"13:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"A lull developed in the center"}],["$","p",null,{"children":"After Chalmers and Jackson moved toward Stuart, only Adams’s brigade faced the Wallace–Prentiss–Hurlbut line for most of the next hour."}]]}]]}],["$","div","Johnston believed the army was trapped",{"className":"moment","children":[["$","$L17",null,{"seconds":867,"label":"14:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston believed the army was trapped"}],"$L18"]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]]}]
