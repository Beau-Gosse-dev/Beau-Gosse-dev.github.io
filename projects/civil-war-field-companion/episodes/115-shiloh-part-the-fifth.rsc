18:["$","p",null,{"children":"He thought the Confederate right had turned Grant’s left and that the rest of the United States army could be driven into the Owl and Snake Creek bottomlands."}]
19:["$","div","Appler heard the opening fighting",{"className":"moment","children":[["$","$L17",null,{"seconds":1004,"label":"16:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Appler heard the opening fighting"}],["$","p",null,{"children":"The 53rd Ohio formed after its pickets reported heavy firing, but Sherman again dismissed the warning."}]]}]]}]
1a:["$","div","Cleburne’s brigade entered Ray Field",{"className":"moment","children":[["$","$L17",null,{"seconds":1135,"label":"18:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cleburne’s brigade entered Ray Field"}],["$","p",null,{"children":"Its regiments crossed the southern end of the field while moving toward the United States camps."}]]}]]}]
1b:["$","div","Sherman confirmed the attack",{"className":"moment","children":[["$","$L17",null,{"seconds":1221,"label":"20:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman confirmed the attack"}],["$","p",null,{"children":"Confederate skirmishers fired at him from about 75 yards. Buckshot struck his right hand and killed his orderly, Thomas D. Holliday."}]]}]]}]
1c:["$","div","The 53rd Ohio stopped the first assault",{"className":"moment","children":[["$","$L17",null,{"seconds":1369,"label":"22:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 53rd Ohio stopped the first assault"}],["$","p",null,{"children":"Appler’s regiment fired a close-range volley into two of Cleburne’s regiments and drove them back."}]]}]]}]
1d:["$","div","Terrain divided Cleburne’s brigade",{"className":"moment","children":[["$","$L17",null,{"seconds":1470,"label":"24:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Terrain divided Cleburne’s brigade"}],["$","p",null,{"children":"Mud and broken ground split the six-regiment line. Two regiments moved against Appler while four attacked Hildebrand and Buckland."}]]}]]}]
1e:["$","div","Sherman stabilized his division",{"className":"moment","children":[["$","$L17",null,{"seconds":1581,"label":"26:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman stabilized his division"}],["$","p",null,{"children":"Although wounded and losing two horses, he directed Buckland and Hildebrand under sustained fire."}]]}]]}]
1f:["$","div","Appler ordered a retreat",{"className":"moment","children":[["$","$L17",null,{"seconds":1732,"label":"28:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Appler ordered a retreat"}],["$","p",null,{"children":"Several hundred men of the 53rd Ohio ran toward Pittsburg Landing. Other companies remained until their exposed flank forced them back."}]]}]]}]
