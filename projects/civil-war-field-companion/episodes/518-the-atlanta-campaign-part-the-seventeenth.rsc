12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Sherman received Thomas’s warning",{"className":"moment","children":[["$","$L17",null,{"seconds":76,"label":"1:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman received Thomas’s warning"}],["$","p",null,{"children":"On June 24, Thomas reported that Howard’s and Palmer’s fronts were already too extended to mass troops easily and that the men were exhausted."}]]}]]}],["$","div","Sherman decided to attack",{"className":"moment","children":[["$","$L17",null,{"seconds":155,"label":"2:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman decided to attack"}],["$","p",null,{"children":"Schofield could not extend farther south because the Confederate left had matched his movement. Sherman concluded another flanking move was not immediately available."}]]}]]}],["$","div","Sherman planned to break the extended line",{"className":"moment","children":[["$","$L17",null,{"seconds":200,"label":"3:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman planned to break the extended line"}],["$","p",null,{"children":"He told Thomas that he intended to study the ground, let Johnston stretch his army, and attack on June 27."}]]}]]}],["$","div","Special Field Orders No. 28 set the plan",{"className":"moment","children":[["$","$L17",null,{"seconds":221,"label":"3:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Special Field Orders No. 28 set the plan"}],["$","p",null,{"children":"Each U.S. army was to attack or demonstrate at 8 a.m. If a breach opened, reserves would push through toward Marietta."}]]}]]}],["$","div","Schofield was to press the Confederate left",{"className":"moment","children":[["$","$L17",null,{"seconds":254,"label":"4:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schofield was to press the Confederate left"}],["$","p",null,{"children":"The Army of the Ohio would move along Powder Springs Road and maintain pressure south of the main battlefield."}]]}]]}],["$","div","McPherson received the northern assignment",{"className":"moment","children":[["$","$L17",null,{"seconds":266,"label":"4:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson received the northern assignment"}],["$","p",null,{"children":"The Army of the Tennessee would demonstrate against the Confederate right and attack south of Kennesaw Mountain."}]]}]]}],["$","div","Thomas chose the main attack sector",{"className":"moment","children":[["$","$L17",null,{"seconds":296,"label":"4:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas chose the main attack sector"}],["$","p",null,{"children":"The Army of the Cumberland would attack the Confederate center. Sherman left the exact point to Thomas."}]]}]]}],["$","div","Thomas examined the Confederate line",{"className":"moment","children":[["$","$L17",null,{"seconds":401,"label":"6:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas examined the Confederate line"}],["$","p",null,{"children":"On June 25, Thomas went to the picket line and beyond it to inspect the terrain and works."}]]}]]}],["$","div","Thomas selected two divisions",{"className":"moment","children":[["$","$L17",null,{"seconds":419,"label":"6:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas selected two divisions"}],["$","p",null,{"children":"Howard chose John Newton’s IV Corps division. Thomas directed John M. Palmer to use Jefferson C. Davis’s XIV Corps division."}]]}]]}],["$","div","The main assault would be south of Dallas Road",{"className":"moment","children":[["$","$L17",null,{"seconds":446,"label":"7:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"The main assault would be south of Dallas Road"}],["$","p",null,{"children":"The ground was less steep than Big Kennesaw, Little Kennesaw, and Pigeon Hill, although it remained wooded and broken."}]]}]]}],["$","div","Logan prepared the XV Corps attack",{"className":"moment","children":[["$","$L17",null,{"seconds":477,"label":"7:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Logan prepared the XV Corps attack"}],["$","p",null,{"children":"McPherson assigned Morgan L. Smith’s division to lead near Burnt Hickory Road, with Peter J. Osterhaus in support and Charles C. Walcutt available."}]]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]]}]
