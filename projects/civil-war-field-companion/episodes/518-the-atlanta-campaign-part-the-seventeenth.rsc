d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",518," · ","June 24–26, 1864"," · ","Kennesaw Mountain line, Georgia"]}],["$","h1",null,{"children":"THE ATLANTA CAMPAIGN (Part the Seventeenth)"}],["$","span",null,{"className":"result-label","children":"Sherman ordered coordinated attacks for 8 a.m. on June 27 and assigned Thomas’s army the main assault"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"June 24–26, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Kennesaw Mountain line, Georgia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Sherman ordered coordinated attacks for 8 a.m. on June 27 and assigned Thomas’s army the main assault"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"June 24–26, 1864","place":"Kennesaw Mountain line, Georgia","result":"Sherman ordered coordinated attacks for 8 a.m. on June 27 and assigned Thomas’s army the main assault","facts":[{"label":"Order","value":"Special Field Orders No. 28"},{"label":"Attack time","value":"8 a.m., June 27"},{"label":"Main U.S. effort","value":"Army of the Cumberland south of Dallas Road"},{"label":"Thomas’s assault divisions","value":"Newton’s IV Corps division and Davis’s XIV Corps division"},{"label":"McPherson’s assault sector","value":"Pigeon Hill and Burnt Hickory Road"},{"label":"Daily supply requirement","value":"About 65 railcars"}],"maps":[{"title":"The June 27 attack plan","caption":"The National Park Service map shows McPherson’s attack near Pigeon Hill, Thomas’s attack south of Dallas Road, and Schofield’s movement against the Confederate left.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm","image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map of troop movements at Kennesaw Mountain on June 27, 1864"},{"title":"Confederate positions across Kennesaw Mountain","caption":"This 1864 drawing shows the heights held by Loring’s corps and the artillery positions overlooking the U.S. approach.","source":"https://www.loc.gov/item/2004660525/","image":"/images/kennesaw-battlefield-drawing.jpg","alt":"1864 drawing of Confederate artillery positions across Kennesaw Mountain"},{"title":"The wider Atlanta campaign","caption":"Sherman’s armies depended on the Western and Atlantic Railroad from Chattanooga while the Confederate army blocked the route toward Marietta and Atlanta.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of the Atlanta campaign across northwestern Georgia"},{"title":"Kennesaw Mountain today","caption":"The battlefield extends from Big Kennesaw and Pigeon Hill south across Dallas Road to Cheatham Hill and Kolb’s Farm.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.68%2C33.89%2C-84.52%2C34.05&layer=mapnik&marker=33.983%2C-84.579"}],"moments":[{"time":"1:16","audioTime":76,"title":"Sherman received Thomas’s warning","detail":"On June 24, Thomas reported that Howard’s and Palmer’s fronts were already too extended to mass troops easily and that the men were exhausted."},{"time":"2:35","audioTime":155,"title":"Sherman decided to attack","detail":"Schofield could not extend farther south because the Confederate left had matched his movement. Sherman concluded another flanking move was not immediately available."},{"time":"3:20","audioTime":200,"title":"Sherman planned to break the extended line","detail":"He told Thomas that he intended to study the ground, let Johnston stretch his army, and attack on June 27."},{"time":"3:41","audioTime":221,"title":"Special Field Orders No. 28 set the plan","detail":"Each U.S. army was to attack or demonstrate at 8 a.m. If a breach opened, reserves would push through toward Marietta."},{"time":"4:14","audioTime":254,"title":"Schofield was to press the Confederate left","detail":"The Army of the Ohio would move along Powder Springs Road and maintain pressure south of the main battlefield."},{"time":"4:26","audioTime":266,"title":"McPherson received the northern assignment","detail":"The Army of the Tennessee would demonstrate against the Confederate right and attack south of Kennesaw Mountain."},{"time":"4:56","audioTime":296,"title":"Thomas chose the main attack sector","detail":"The Army of the Cumberland would attack the Confederate center. Sherman left the exact point to Thomas."},{"time":"6:41","audioTime":401,"title":"Thomas examined the Confederate line","detail":"On June 25, Thomas went to the picket line and beyond it to inspect the terrain and works."},{"time":"6:59","audioTime":419,"title":"Thomas selected two divisions","detail":"Howard chose John Newton’s IV Corps division. Thomas directed John M. Palmer to use Jefferson C. Davis’s XIV Corps division."},{"time":"7:26","audioTime":446,"title":"The main assault would be south of Dallas Road","detail":"The ground was less steep than Big Kennesaw, Little Kennesaw, and Pigeon Hill, although it remained wooded and broken."},{"time":"7:57","audioTime":477,"title":"Logan prepared the XV Corps attack","detail":"McPherson assigned Morgan L. Smith’s division to lead near Burnt Hickory Road, with Peter J. Osterhaus in support and Charles C. Walcutt available."},{"time":"8:47","audioTime":527,"title":"Pigeon Hill became McPherson’s target","detail":"After consulting engineer Chauncey B. Reese, Logan concentrated the attack on Pigeon Hill and the ground south of it."},{"time":"9:34","audioTime":574,"title":"Loring’s corps held the northern heights","detail":"Featherston, Walthall, and French held Big Kennesaw, Little Kennesaw, and Pigeon Hill. Wheeler’s cavalry guarded the Confederate right."},{"time":"11:06","audioTime":666,"title":"Hardee’s corps held the central and southern line","detail":"Walker and Bate held ground down to Dallas Road. Cleburne and Cheatham held the ridge farther south toward Kolb’s Farm."},{"time":"14:46","audioTime":886,"title":"Sherman notified Washington","detail":"He told Henry Halleck that he intended to attack the Confederate left center after stretching the line."},{"time":"15:36","audioTime":936,"title":"Supply pressure influenced Sherman","detail":"The army group required about 65 railcars of supplies each day. Confederate raids repeatedly interrupted the long railroad from Chattanooga."},{"time":"16:41","audioTime":1001,"title":"Sherman described his options to Ellen Sherman","detail":"On June 26, he wrote that he had to attack directly or turn the position and that either choice would cause loss and difficulty."},{"time":"18:21","audioTime":1101,"title":"Sherman believed Johnston’s line had become thin","detail":"The U.S. line extended about ten miles. Sherman reasoned that Johnston’s smaller army had to be stretched even more and could be broken at the center."},{"time":"22:55","audioTime":1375,"title":"Army commanders issued final orders","detail":"Thomas, McPherson, and Schofield directed their corps commanders to be ready for the coordinated operation on June 27."},{"time":"23:43","audioTime":1423,"title":"McPherson emphasized secrecy","detail":"He ordered movements to make as little noise and visible change along the line as possible."},{"time":"25:59","audioTime":1559,"title":"Hardee expected to hold","detail":"The Confederate corps commander wrote that his lines were strong and that he expected to defeat any U.S. attack."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Issued Special Field Orders No. 28"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Main attack by IV and XIV Corps"},{"commander":"Oliver O. Howard","command":"IV Corps","subordinates":"John Newton’s division"},{"commander":"John M. Palmer","command":"XIV Corps","subordinates":"Jefferson C. Davis’s division"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"John A. Logan’s XV Corps near Pigeon Hill"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"Pressed the Confederate left along Powder Springs Road"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Held the Kennesaw line"},{"commander":"William W. Loring","command":"Loring’s Corps","subordinates":"Featherston, Walthall, and French on the Kennesaw heights"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Walker, Bate, Cleburne, and Cheatham south of Pigeon Hill"},{"commander":"Joseph Wheeler","command":"Cavalry Corps","subordinates":"Guarded the Confederate right north and east of Big Kennesaw"}]}],"people":[{"name":"William T. Sherman","role":"Decided to attack and issued the coordinated plan for June 27","side":"United States"},{"name":"George H. Thomas","role":"Selected the Army of the Cumberland’s assault sector and divisions","side":"United States"},{"name":"James B. McPherson","role":"Prepared the Army of the Tennessee’s attack near Pigeon Hill","side":"United States"},{"name":"John M. Schofield","role":"Reported that further movement around the Confederate left was blocked","side":"United States"},{"name":"John Newton","role":"Commanded the IV Corps division selected for the main assault","side":"United States"},{"name":"Jefferson C. Davis","role":"Commanded the XIV Corps division selected for the main assault","side":"United States"},{"name":"William W. Loring","role":"Temporarily commanded the corps holding the Kennesaw heights after Leonidas Polk’s death","side":"Confederacy"},{"name":"William J. Hardee","role":"Commanded the corps holding the line south of Pigeon Hill","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map showing the U.S. attack plan and Confederate line at Kennesaw Mountain","caption":"The June 27 plan assigned attacks and demonstrations across the Confederate line.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"image":"/images/kennesaw-battlefield-drawing.jpg","alt":"Theodore R. Davis drawing of Confederate artillery positions at Kennesaw Mountain","caption":"A wartime drawing of the northern Confederate position.","source":"https://www.loc.gov/item/2004660525/"}],"sources":[{"label":"Official Episode 518 page","url":"https://civilwarpodcast.org/2026/01/25/civil-war-podcast-episode-518/"},{"label":"National Park Service battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ga015"},{"label":"National Park Service troop movements map","url":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"label":"National Park Service Union order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/union-order-of-battle.htm"},{"label":"National Park Service Confederate order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/confederate-order-of-battle.htm"},{"label":"Library of Congress Kennesaw battlefield drawing","url":"https://www.loc.gov/item/2004660525/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
