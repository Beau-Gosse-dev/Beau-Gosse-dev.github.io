18:["$","div","Pigeon Hill became McPherson’s target",{"className":"moment","children":[["$","$L17",null,{"seconds":527,"label":"8:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pigeon Hill became McPherson’s target"}],["$","p",null,{"children":"After consulting engineer Chauncey B. Reese, Logan concentrated the attack on Pigeon Hill and the ground south of it."}]]}]]}]
19:["$","div","Loring’s corps held the northern heights",{"className":"moment","children":[["$","$L17",null,{"seconds":574,"label":"9:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Loring’s corps held the northern heights"}],["$","p",null,{"children":"Featherston, Walthall, and French held Big Kennesaw, Little Kennesaw, and Pigeon Hill. Wheeler’s cavalry guarded the Confederate right."}]]}]]}]
1a:["$","div","Hardee’s corps held the central and southern line",{"className":"moment","children":[["$","$L17",null,{"seconds":666,"label":"11:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hardee’s corps held the central and southern line"}],["$","p",null,{"children":"Walker and Bate held ground down to Dallas Road. Cleburne and Cheatham held the ridge farther south toward Kolb’s Farm."}]]}]]}]
1b:["$","div","Sherman notified Washington",{"className":"moment","children":[["$","$L17",null,{"seconds":886,"label":"14:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman notified Washington"}],["$","p",null,{"children":"He told Henry Halleck that he intended to attack the Confederate left center after stretching the line."}]]}]]}]
1c:["$","div","Supply pressure influenced Sherman",{"className":"moment","children":[["$","$L17",null,{"seconds":936,"label":"15:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Supply pressure influenced Sherman"}],["$","p",null,{"children":"The army group required about 65 railcars of supplies each day. Confederate raids repeatedly interrupted the long railroad from Chattanooga."}]]}]]}]
1d:["$","div","Sherman described his options to Ellen Sherman",{"className":"moment","children":[["$","$L17",null,{"seconds":1001,"label":"16:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman described his options to Ellen Sherman"}],["$","p",null,{"children":"On June 26, he wrote that he had to attack directly or turn the position and that either choice would cause loss and difficulty."}]]}]]}]
1e:["$","div","Sherman believed Johnston’s line had become thin",{"className":"moment","children":[["$","$L17",null,{"seconds":1101,"label":"18:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman believed Johnston’s line had become thin"}],["$","p",null,{"children":"The U.S. line extended about ten miles. Sherman reasoned that Johnston’s smaller army had to be stretched even more and could be broken at the center."}]]}]]}]
1f:["$","div","Army commanders issued final orders",{"className":"moment","children":[["$","$L17",null,{"seconds":1375,"label":"22:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Army commanders issued final orders"}],["$","p",null,{"children":"Thomas, McPherson, and Schofield directed their corps commanders to be ready for the coordinated operation on June 27."}]]}]]}]
20:["$","div","McPherson emphasized secrecy",{"className":"moment","children":[["$","$L17",null,{"seconds":1423,"label":"23:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson emphasized secrecy"}],["$","p",null,{"children":"He ordered movements to make as little noise and visible change along the line as possible."}]]}]]}]
