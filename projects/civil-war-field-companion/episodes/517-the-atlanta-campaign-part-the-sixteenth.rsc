12:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L19",null,{"guide":{"date":"June 22, 1864","place":"Kolb’s Farm, Cobb County, Georgia","result":"U.S. victory; Hood’s two attacking divisions were repulsed by the XX and XXIII Corps","facts":[{"label":"Confederate attack","value":"About 11,000 men in Stevenson’s and Hindman’s divisions"},{"label":"Attack began","value":"About 5 p.m."},{"label":"Duration","value":"About 90 minutes"},{"label":"Confederate losses","value":"More than 1,000"},{"label":"Stevenson’s losses","value":"More than 800"},{"label":"U.S. losses","value":"A few hundred"}],"maps":[{"title":"Kolb’s Farm on the Kennesaw battlefield","caption":"The National Park Service map shows Hood’s Confederate attack in red against Hooker’s and Schofield’s U.S. positions in blue at Kolb’s Farm.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm","image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map showing the Battle of Kolb’s Farm south of Kennesaw Mountain"},{"title":"Kennesaw Mountain and the campaign front","caption":"The wartime drawing shows the Confederate position north of Kolb’s Farm. Hood moved from the army’s right to its far left before the battle.","source":"https://www.loc.gov/item/2004660525/","image":"/images/kennesaw-battlefield-drawing.jpg","alt":"1864 drawing of Confederate artillery positions across Kennesaw Mountain"},{"title":"Kolb’s Farm today","caption":"The fighting occurred along Powder Springs Road southwest of Marietta, on ground now preserved in Kennesaw Mountain National Battlefield Park.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.66%2C33.88%2C-84.57%2C33.95&layer=mapnik&marker=33.908%2C-84.629"}],"moments":[{"time":"1:16","audioTime":76,"title":"Johnston shifted Hood to the Confederate left","detail":"Hood’s corps moved from the right of the Kennesaw line on the night of June 21 and reached the southern flank the next afternoon."},{"time":"3:47","audioTime":227,"title":"Hood chose an offensive response","detail":"Johnston’s assignment was to protect the flank. Hood decided to advance along Powder Springs Road and stop the U.S. turning movement."},{"time":"4:22","audioTime":262,"title":"Hooker and Schofield held the U.S. right","detail":"The XX Corps occupied the Kolb farm, and the XXIII Corps extended south along Powder Springs Road."},{"time":"5:27","audioTime":327,"title":"Five U.S. divisions covered the sector","detail":"Butterfield, Geary, and Williams formed the XX Corps line. Hascall and Cox held the XXIII Corps positions to their south."},{"time":"6:18","audioTime":378,"title":"Two regiments reconnoitered forward","detail":"The 123rd New York advanced north of Powder Springs Road and the 14th Kentucky advanced south of it."},{"time":"6:54","audioTime":414,"title":"Hooker ordered earthworks","detail":"By about 3 p.m., Hooker expected an attack and directed his corps to entrench while the two reconnaissance regiments moved forward."},{"time":"7:27","audioTime":447,"title":"Hooker overestimated the opposing force","detail":"At 4 p.m., he told Thomas that the whole Confederate army was moving toward his front and requested support."},{"time":"8:13","audioTime":493,"title":"Hood deployed two divisions in front","detail":"Carter L. Stevenson formed on the left and Thomas C. Hindman on the right. A third division remained in reserve."},{"time":"9:15","audioTime":555,"title":"Hood attacked without adequate reconnaissance","detail":"The corps was not ready until midafternoon. Hood mistook the two U.S. reconnaissance regiments for the opening of a larger attack."},{"time":"9:48","audioTime":588,"title":"Stevenson advanced around 5 p.m.","detail":"The 123rd New York and 14th Kentucky fired and withdrew across open ground to the prepared U.S. line."},{"time":"11:29","audioTime":689,"title":"The two forward regiments lost more than 100","detail":"Both regiments suffered casualties while delaying the Confederate advance and returning to the main defenses."},{"time":"12:07","audioTime":727,"title":"About 11,000 Confederates entered the attack","detail":"Stevenson had roughly 6,000 men, and Hindman’s division brought the attacking force to about 11,000."},{"time":"12:36","audioTime":756,"title":"Prepared U.S. troops opened fire","detail":"Hooker’s preparations placed infantry and artillery behind fieldworks. Artillery firing grape and canister disrupted the Confederate lines before they reached the works."},{"time":"13:33","audioTime":813,"title":"Hindman was stopped by artillery","detail":"U.S. batteries fired canister into the division. Hindman’s troops did not reach the main U.S. line and withdrew."},{"time":"14:40","audioTime":880,"title":"The attack ended after about 90 minutes","detail":"Fighting ran from about 5 to 6:30 p.m. More than 1,000 Confederates and a few hundred U.S. soldiers were casualties."},{"time":"14:59","audioTime":899,"title":"Stevenson’s division suffered most of the loss","detail":"The division reported more than 800 casualties, and several Confederate regiments lost more than half their men."},{"time":"17:30","audioTime":1050,"title":"Williams described a complete U.S. success","detail":"The XX Corps division commander reported that the attack was defeated with comparatively low U.S. losses."},{"time":"18:02","audioTime":1082,"title":"Hooker again reported three Confederate corps","detail":"Sherman rejected the claim because he knew much of Johnston’s army remained on the Confederate right and center."},{"time":"18:45","audioTime":1125,"title":"Schofield correctly identified Hood’s corps","detail":"Schofield reported that Hood alone had attacked and that the Confederate losses were much greater."},{"time":"19:52","audioTime":1192,"title":"Johnston’s official account was incorrect","detail":"Johnston told Richmond that Hood had been attacked and had captured part of the U.S. works. The Confederate attack had actually failed."},{"time":"20:14","audioTime":1214,"title":"Stevenson blamed the ground","detail":"His report stated that the terrain was unsuitable for the movement and that carrying the U.S. works by assault was impractical."},{"time":"20:44","audioTime":1244,"title":"Manigault criticized Hood","detail":"The Confederate brigade commander considered the attack reckless and cited it as evidence that Hood was unfit for corps command."},{"time":"22:39","audioTime":1359,"title":"Schofield found the Confederate flank extended","detail":"On June 23, Schofield reported that entrenched Confederates continued well beyond the point his corps could reach."},{"time":"25:04","audioTime":1504,"title":"Sherman decided to order a direct attack","detail":"The failed turning movement and continued stalemate contributed to Sherman’s decision to attack the Kennesaw line."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed the movement around the Confederate left"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Joseph Hooker’s XX Corps"},{"commander":"Joseph Hooker","command":"XX Corps","subordinates":"Daniel Butterfield, John Geary, and Alpheus Williams"},{"commander":"John M. Schofield","command":"Army of the Ohio and XXIII Corps","subordinates":"Milo Hascall and Jacob D. Cox"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Ordered Hood to protect the left flank"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Carter Stevenson and Thomas Hindman attacked; one division in reserve"},{"commander":"Carter L. Stevenson","command":"Stevenson’s Division","subordinates":"Advanced on the Confederate left"},{"commander":"Thomas C. Hindman","command":"Hindman’s Division","subordinates":"Advanced on the Confederate right"}]}],"people":[{"name":"John B. Hood","role":"Ordered the two-division Confederate attack at Kolb’s Farm","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"Joseph Hooker","role":"Prepared the XX Corps position before the Confederate attack","side":"United States"},{"name":"John M. Schofield","role":"Commanded the XXIII Corps on Hooker’s right and reported the result accurately","side":"United States"},{"name":"Carter L. Stevenson","role":"Led the Confederate division that suffered most of the losses","side":"Confederacy"},{"name":"Thomas C. Hindman","role":"Led the other Confederate assault division","side":"Confederacy"},{"name":"Alpheus S. Williams","role":"Commanded a XX Corps division in the prepared U.S. line","side":"United States"},{"name":"Arthur M. Manigault","role":"Confederate brigade commander who later condemned Hood’s attack","side":"Confederacy"},{"name":"Rice C. Bull","role":"123rd New York sergeant whose account describes the initial withdrawal","side":"United States"}],"losses":[],"gallery":[{"image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map showing Hood’s attack at Kolb’s Farm","caption":"Hood attacked the prepared XX and XXIII Corps positions south of Kennesaw Mountain.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"image":"/images/kennesaw-battlefield-drawing.jpg","alt":"Theodore R. Davis drawing of Confederate artillery positions at Kennesaw Mountain","caption":"A wartime drawing of the Confederate position north of Kolb’s Farm.","source":"https://www.loc.gov/item/2004660525/"}],"sources":[{"label":"Official Episode 517 page","url":"https://civilwarpodcast.org/2026/01/18/civil-war-podcast-episode-517/"},{"label":"National Park Service battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ga015"},{"label":"National Park Service troop movements map","url":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"label":"National Park Service Union order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/union-order-of-battle.htm"},{"label":"National Park Service Confederate order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/confederate-order-of-battle.htm"},{"label":"Library of Congress Kennesaw battlefield drawing","url":"https://www.loc.gov/item/2004660525/"}]}}]}]
