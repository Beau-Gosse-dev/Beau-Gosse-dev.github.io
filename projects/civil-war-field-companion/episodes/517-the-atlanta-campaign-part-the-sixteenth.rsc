17:["$","div","About 11,000 Confederates entered the attack",{"className":"moment","children":[["$","$L16",null,{"seconds":727,"label":"12:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"About 11,000 Confederates entered the attack"}],["$","p",null,{"children":"Stevenson had roughly 6,000 men, and Hindman’s division brought the attacking force to about 11,000."}]]}]]}]
18:["$","div","Prepared U.S. troops opened fire",{"className":"moment","children":[["$","$L16",null,{"seconds":756,"label":"12:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Prepared U.S. troops opened fire"}],["$","p",null,{"children":"Hooker’s preparations placed infantry and artillery behind fieldworks. Artillery firing grape and canister disrupted the Confederate lines before they reached the works."}]]}]]}]
19:["$","div","Hindman was stopped by artillery",{"className":"moment","children":[["$","$L16",null,{"seconds":813,"label":"13:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hindman was stopped by artillery"}],["$","p",null,{"children":"U.S. batteries fired canister into the division. Hindman’s troops did not reach the main U.S. line and withdrew."}]]}]]}]
1a:["$","div","The attack ended after about 90 minutes",{"className":"moment","children":[["$","$L16",null,{"seconds":880,"label":"14:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack ended after about 90 minutes"}],["$","p",null,{"children":"Fighting ran from about 5 to 6:30 p.m. More than 1,000 Confederates and a few hundred U.S. soldiers were casualties."}]]}]]}]
1b:["$","div","Stevenson’s division suffered most of the loss",{"className":"moment","children":[["$","$L16",null,{"seconds":899,"label":"14:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stevenson’s division suffered most of the loss"}],["$","p",null,{"children":"The division reported more than 800 casualties, and several Confederate regiments lost more than half their men."}]]}]]}]
1c:["$","div","Williams described a complete U.S. success",{"className":"moment","children":[["$","$L16",null,{"seconds":1050,"label":"17:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Williams described a complete U.S. success"}],["$","p",null,{"children":"The XX Corps division commander reported that the attack was defeated with comparatively low U.S. losses."}]]}]]}]
1d:["$","div","Hooker again reported three Confederate corps",{"className":"moment","children":[["$","$L16",null,{"seconds":1082,"label":"18:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker again reported three Confederate corps"}],["$","p",null,{"children":"Sherman rejected the claim because he knew much of Johnston’s army remained on the Confederate right and center."}]]}]]}]
1e:["$","div","Schofield correctly identified Hood’s corps",{"className":"moment","children":[["$","$L16",null,{"seconds":1125,"label":"18:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schofield correctly identified Hood’s corps"}],["$","p",null,{"children":"Schofield reported that Hood alone had attacked and that the Confederate losses were much greater."}]]}]]}]
1f:["$","div","Johnston’s official account was incorrect",{"className":"moment","children":[["$","$L16",null,{"seconds":1192,"label":"19:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston’s official account was incorrect"}],["$","p",null,{"children":"Johnston told Richmond that Hood had been attacked and had captured part of the U.S. works. The Confederate attack had actually failed."}]]}]]}]
20:["$","div","Stevenson blamed the ground",{"className":"moment","children":[["$","$L16",null,{"seconds":1214,"label":"20:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stevenson blamed the ground"}],["$","p",null,{"children":"His report stated that the terrain was unsuitable for the movement and that carrying the U.S. works by assault was impractical."}]]}]]}]
