11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Johnston shifted Hood to the Confederate left",{"className":"moment","children":[["$","$L16",null,{"seconds":76,"label":"1:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston shifted Hood to the Confederate left"}],["$","p",null,{"children":"Hood’s corps moved from the right of the Kennesaw line on the night of June 21 and reached the southern flank the next afternoon."}]]}]]}],["$","div","Hood chose an offensive response",{"className":"moment","children":[["$","$L16",null,{"seconds":227,"label":"3:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood chose an offensive response"}],["$","p",null,{"children":"Johnston’s assignment was to protect the flank. Hood decided to advance along Powder Springs Road and stop the U.S. turning movement."}]]}]]}],["$","div","Hooker and Schofield held the U.S. right",{"className":"moment","children":[["$","$L16",null,{"seconds":262,"label":"4:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker and Schofield held the U.S. right"}],["$","p",null,{"children":"The XX Corps occupied the Kolb farm, and the XXIII Corps extended south along Powder Springs Road."}]]}]]}],["$","div","Five U.S. divisions covered the sector",{"className":"moment","children":[["$","$L16",null,{"seconds":327,"label":"5:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Five U.S. divisions covered the sector"}],["$","p",null,{"children":"Butterfield, Geary, and Williams formed the XX Corps line. Hascall and Cox held the XXIII Corps positions to their south."}]]}]]}],["$","div","Two regiments reconnoitered forward",{"className":"moment","children":[["$","$L16",null,{"seconds":378,"label":"6:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two regiments reconnoitered forward"}],["$","p",null,{"children":"The 123rd New York advanced north of Powder Springs Road and the 14th Kentucky advanced south of it."}]]}]]}],["$","div","Hooker ordered earthworks",{"className":"moment","children":[["$","$L16",null,{"seconds":414,"label":"6:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker ordered earthworks"}],["$","p",null,{"children":"By about 3 p.m., Hooker expected an attack and directed his corps to entrench while the two reconnaissance regiments moved forward."}]]}]]}],["$","div","Hooker overestimated the opposing force",{"className":"moment","children":[["$","$L16",null,{"seconds":447,"label":"7:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker overestimated the opposing force"}],["$","p",null,{"children":"At 4 p.m., he told Thomas that the whole Confederate army was moving toward his front and requested support."}]]}]]}],["$","div","Hood deployed two divisions in front",{"className":"moment","children":[["$","$L16",null,{"seconds":493,"label":"8:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood deployed two divisions in front"}],["$","p",null,{"children":"Carter L. Stevenson formed on the left and Thomas C. Hindman on the right. A third division remained in reserve."}]]}]]}],["$","div","Hood attacked without adequate reconnaissance",{"className":"moment","children":[["$","$L16",null,{"seconds":555,"label":"9:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood attacked without adequate reconnaissance"}],["$","p",null,{"children":"The corps was not ready until midafternoon. Hood mistook the two U.S. reconnaissance regiments for the opening of a larger attack."}]]}]]}],["$","div","Stevenson advanced around 5 p.m.",{"className":"moment","children":[["$","$L16",null,{"seconds":588,"label":"9:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stevenson advanced around 5 p.m."}],["$","p",null,{"children":"The 123rd New York and 14th Kentucky fired and withdrew across open ground to the prepared U.S. line."}]]}]]}],["$","div","The two forward regiments lost more than 100",{"className":"moment","children":[["$","$L16",null,{"seconds":689,"label":"11:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The two forward regiments lost more than 100"}],["$","p",null,{"children":"Both regiments suffered casualties while delaying the Confederate advance and returning to the main defenses."}]]}]]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}]
