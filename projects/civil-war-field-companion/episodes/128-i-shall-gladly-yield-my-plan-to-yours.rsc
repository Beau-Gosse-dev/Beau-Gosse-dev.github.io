1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",128," · ","December 1, 1861–February 3, 1862"," · ","Washington, D.C.; the United States and Confederate lines around Centreville and Manassas, Virginia; and McClellan’s proposed route through the Chesapeake Bay, Rappahannock River, Urbanna, and Richmond"]}],["$","h1",null,{"children":"\"I SHALL GLADLY YIELD MY PLAN TO YOURS\""}],["$","span",null,{"className":"result-label","children":"Lincoln’s effort to force an advance produced two war orders and a direct strategic test for McClellan. Lincoln favored an overland movement against the Confederate railroad communications southwest of Manassas; McClellan argued for transporting the Army of the Potomac by water to Urbanna and approaching Richmond from the east. McClellan’s argument prevailed for the moment, and Lincoln’s January 31 order was not carried out. When Joseph E. Johnston withdrew from the Centreville–Manassas line in March, the Urbanna concept lost its intended advantage and McClellan shifted the landing point to Fort Monroe for the Peninsula Campaign"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9424543880.mp3?updated=1695211772","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Immediate planning crisis",{"children":[["$","span",null,{"children":"Immediate planning crisis"}],["$","strong",null,{"children":"January 10–13, 1862 White House conferences"}],["$","small",null,{"children":"McClellan was recovering from typhoid fever when Lincoln consulted Irvin McDowell, William B. Franklin, Montgomery C. Meigs, and cabinet members."}]]}],["$","div","Opposing armies",{"children":[["$","span",null,{"children":"Opposing armies"}],["$","strong",null,{"children":"About 30 miles apart"}],["$","small",null,{"children":"The Army of the Potomac guarded Washington while Joseph E. Johnston’s Confederates wintered around Centreville and Manassas."}]]}],["$","div","Lincoln’s preferred line",{"children":[["$","span",null,{"children":"Lincoln’s preferred line"}],["$","strong",null,{"children":"Overland toward the railroad southwest of Manassas"}],"$undefined"]}],["$","div","McClellan’s preferred line",{"children":[["$","span",null,{"children":"McClellan’s preferred line"}],["$","strong",null,{"children":"By water to Urbanna, then overland toward Richmond"}],["$","small",null,{"children":"Urbanna is the correct Virginia place-name; the automated transcript renders it “Urbana.”"}]]}],["$","div","Proposed waterborne force",{"children":[["$","span",null,{"children":"Proposed waterborne force"}],["$","strong",null,{"children":"110,000–140,000 soldiers"}],["$","small",null,{"children":"McClellan gave this range in his January 31 memorandum to Secretary of War Edwin M. Stanton."}]]}],["$","div","Transportation estimate",{"children":[["$","span",null,{"children":"Transportation estimate"}],["$","strong",null,{"children":"30 days after authorization"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14"]}],"$L15","$undefined","$L16",false,"$L17",false,"$L18","$L19","$L1a"]}]]}]
