e:["$","small",null,{"children":"McClellan proposed collecting canal boats, barges, schooners, wood boats, and small steamers."}]
f:["$","div","General War Order No. 1",{"children":[["$","span",null,{"children":"General War Order No. 1"}],["$","strong",null,{"children":"Issued January 27, 1862"}],["$","small",null,{"children":"It named February 22 as the date for a general movement of United States land and naval forces."}]]}]
10:["$","div","Special War Order No. 1",{"children":[["$","span",null,{"children":"Special War Order No. 1"}],["$","strong",null,{"children":"Issued January 31, 1862"}],["$","small",null,{"children":"It directed the Army of the Potomac to seize a point on the railroad southwest of Manassas Junction while leaving Washington secure."}]]}]
11:["$","div","Lincoln’s test",{"children":[["$","span",null,{"children":"Lincoln’s test"}],["$","strong",null,{"children":"Five questions about time, cost, certainty, value, communications, and retreat"}],"$undefined"]}]
12:["$","div","Immediate outcome",{"children":[["$","span",null,{"children":"Immediate outcome"}],["$","strong",null,{"children":"McClellan’s plan accepted in principle"}],["$","small",null,{"children":"The January 31 order was never carried out, although Lincoln did not formally revoke it."}]]}]
