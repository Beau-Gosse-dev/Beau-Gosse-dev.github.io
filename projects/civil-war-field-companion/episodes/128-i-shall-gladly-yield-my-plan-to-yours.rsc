d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",128," · ","December 1, 1861–February 3, 1862"," · ","Washington, D.C.; the United States and Confederate lines around Centreville and Manassas, Virginia; and McClellan’s proposed route through the Chesapeake Bay, Rappahannock River, Urbanna, and Richmond"]}],["$","h1",null,{"children":"\"I SHALL GLADLY YIELD MY PLAN TO YOURS\""}],["$","span",null,{"className":"result-label","children":"Lincoln’s effort to force an advance produced two war orders and a direct strategic test for McClellan. Lincoln favored an overland movement against the Confederate railroad communications southwest of Manassas; McClellan argued for transporting the Army of the Potomac by water to Urbanna and approaching Richmond from the east. McClellan’s argument prevailed for the moment, and Lincoln’s January 31 order was not carried out. When Joseph E. Johnston withdrew from the Centreville–Manassas line in March, the Urbanna concept lost its intended advantage and McClellan shifted the landing point to Fort Monroe for the Peninsula Campaign"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"December 1, 1861–February 3, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Washington, D.C.; the United States and Confederate lines around Centreville and Manassas, Virginia; and McClellan’s proposed route through the Chesapeake Bay, Rappahannock River, Urbanna, and Richmond"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Lincoln’s effort to force an advance produced two war orders and a direct strategic test for McClellan. Lincoln favored an overland movement against the Confederate railroad communications southwest of Manassas; McClellan argued for transporting the Army of the Potomac by water to Urbanna and approaching Richmond from the east. McClellan’s argument prevailed for the moment, and Lincoln’s January 31 order was not carried out. When Joseph E. Johnston withdrew from the Centreville–Manassas line in March, the Urbanna concept lost its intended advantage and McClellan shifted the landing point to Fort Monroe for the Peninsula Campaign"}]]}]]}],false,"$Lf","$undefined"]}],"$L10","$L11","$L12",false,"$L13",false,"$L14","$L15","$L16","$L17"]}]]}]
