17:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","President and constitutional commander in chief-Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"President and constitutional commander in chief"}],["$","span",null,{"children":"Abraham Lincoln"}],["$","small",null,{"children":"Set national strategy, consulted army leaders, and issued General War Order No. 1 and Special War Order No. 1"}]]}],["$","div","Secretary of War-Edwin M. Stanton",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of War"}],["$","span",null,{"children":"Edwin M. Stanton"}],["$","small",null,{"children":"Replaced Simon Cameron in January 1862 and served as the civilian head of the War Department during the final exchange over the campaign plan"}]]}],["$","div","General-in-chief and commander, Army of the Potomac-George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief and commander, Army of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Controlled the principal United States army in the East and proposed the waterborne Urbanna operation"}]]}],["$","div","Division commander, Army of the Potomac-Irvin McDowell",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander, Army of the Potomac"}],["$","span",null,{"children":"Irvin McDowell"}],["$","small",null,{"children":"Senior division commander consulted by Lincoln; recommended an overland turning movement from the Washington base"}]]}],["$","div","Division commander, Army of the Potomac-William B. Franklin",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander, Army of the Potomac"}],["$","span",null,{"children":"William B. Franklin"}],["$","small",null,{"children":"McClellan ally consulted by Lincoln; outlined the deeper waterborne approach toward Richmond"}]]}],["$","div","Quartermaster General, United States Army-Montgomery C. Meigs",{"className":"command-entry","children":[["$","strong",null,{"children":"Quartermaster General, United States Army"}],["$","span",null,{"children":"Montgomery C. Meigs"}],["$","small",null,{"children":"Evaluated transport and supply requirements and initially recommended operating from the army’s existing Washington base"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","President and commander in chief-Jefferson Davis",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander in chief"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Exercised national authority over Confederate forces and their defense of Virginia"}]]}],["$","div","Department of Northern Virginia; field army around Centreville and Manassas-Joseph E. Johnston",{"className":"command-entry","children":["$L1b","$L1c","$L1d"]}],"$L1e"]]}]]}],"$L1f"]]]