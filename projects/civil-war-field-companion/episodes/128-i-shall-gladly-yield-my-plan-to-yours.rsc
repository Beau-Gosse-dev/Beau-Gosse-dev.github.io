18:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep128-lincoln-mcclellan-letter.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep128-lincoln-mcclellan-letter.jpg","alt":"Library of Congress transcription image of Lincoln’s February 3, 1862 letter to McClellan","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Lincoln’s February 3 letter sets the competing routes side by side and asks five questions before stating that he would yield if McClellan answered them satisfactorily."}]]}],["$","figure","/images/ep128-eastern-virginia-map-1862.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep128-eastern-virginia-map-1862.jpg","alt":"Color map of eastern Virginia prepared by the United States Coast Survey in 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The 1862 map records the railroads, rivers, roads, and Chesapeake waterways on which both campaign proposals depended."}]]}],["$","figure","/images/ep128-abraham-lincoln-1861.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep128-abraham-lincoln-1861.jpg","alt":"Abraham Lincoln seated for a portrait in May 1861","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Lincoln moved from private consultation to written orders as he tried to convert the United States advantage in numbers into simultaneous pressure on Confederate armies."}]]}],["$","figure","/images/ep128-george-mcclellan-1861.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep128-george-mcclellan-1861.jpg","alt":"Major General George B. McClellan standing in uniform in 1861","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"McClellan built the Army of the Potomac into a large organized force but resisted an advance from Washington and argued for a new line of operations by water."}]]}],["$","figure","/images/ep128-edwin-stanton.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep128-edwin-stanton.jpg","alt":"Wartime portrait of Secretary of War Edwin M. Stanton","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Stanton entered the War Department during the planning dispute and transmitted the written arguments between Lincoln and McClellan."}]]}]]}]]}]
