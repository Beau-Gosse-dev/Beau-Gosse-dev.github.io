00/",{"href":"https://www.loc.gov/item/mal1397100/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Lincoln to Buell on simultaneous pressure, January 13, 1862"]}],["$","a","https://www.loc.gov/exhibits/lincoln/lincoln-as-commander-in-chief.html",{"href":"https://www.loc.gov/exhibits/lincoln/lincoln-as-commander-in-chief.html","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress exhibition: Lincoln as commander in chief"]}],["$","a","https://www.loc.gov/item/08010508/",{"href":"https://www.loc.gov/item/08010508/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: McClellan’s official report on the Army of the Potomac"]}],["$","a","https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/",{"href":"https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Civil War campaign summary"]}],["$","a","https://history.army.mil/Research/Reference-Topics/-CONTINENTAL-ARMY-GENERAL-AND-COMMANDER-IN-CHIEF/",{"href":"https://history.army.mil/Research/Reference-Topics/-CONTINENTAL-ARMY-GENERAL-AND-COMMANDER-IN-CHIEF/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: United States Army commanding generals"]}],["$","a","https://history.army.mil/Portals/143/Images/Publications/ArmyHistoryMag/pdf/19901999/AH47newOCR.pdf",{"href":"https://history.army.mil/Portals/143/Images/Publications/ArmyHistoryMag/pdf/19901999/AH47newOCR.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: An Overview of the Eastern Theater"]}],["$","a","https://www.nps.gov/people/george-b-mcclellan.htm",{"href":"https://www.nps.gov/people/george-b-mcclellan.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: George B. McClellan"]}],"$L18","$L19","$L1a","$