11:["$","figure","The Wilderness–Spotsylvania corridor today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.88%2C38.17%2C-77.50%2C38.40&layer=mapnik&marker=38.2167%2C-77.6000","title":"The Wilderness–Spotsylvania corridor today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Wilderness–Spotsylvania corridor today"}],["$","span",null,{"children":"Brock Road runs southeast from the Wilderness through Todd’s Tavern to Laurel Hill. Confederate columns used parallel roads to reach the courthouse from the west and south."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
12:["$","figure","The movement within the Overland Campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The movement within the Overland Campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland Campaign between the Wilderness and Spotsylvania","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The movement within the Overland Campaign"}],["$","span",null,{"children":"The campaign map shows Grant’s turn southeast from the Wilderness to Spotsylvania rather than north across the Rapidan. Lee’s army remained between Grant and Richmond."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The Wilderness battle ended without a decision",{"className":"moment","children":[["$","$L19",null,{"seconds":78,"label":"1:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Wilderness battle ended without a decision"}],["$","p",null,{"children":"The episode counts more than 17,500 U.S. casualties from about 102,000 engaged and about 13,000 Confederate casualties from just over 61,000."}]]}]]}],["$","div","Grant decided not to retreat",{"className":"moment","children":[["$","$L19",null,{"seconds":132,"label":"2:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant decided not to retreat"}],["$","p",null,{"children":"He broke contact in the Wilderness and moved southeast around Lee’s right toward Spotsylvania Court House."}]]}]]}],["$","div","Both armies remained behind their works on May 7",{"className":"moment","children":[["$","$L19",null,{"seconds":230,"label":"3:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both armies remained behind their works on May 7"}],["$","p",null,{"children":"Neither renewed the main battle. Patrols and skirmishers remained active while commanders determined the next movement."}]]}]]}],["$","div","Grant shifted his supply line east",{"className":"moment","children":[["$","$L19",null,{"seconds":268,"label":"4:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant shifted his supply line east"}],["$","p",null,{"children":"Pontoon bridges were removed from Germanna Ford and sent to Ely’s Ford to speed evacuation of wounded soldiers toward Fredericksburg."}]]}]]}],["$","div","Lee concluded Grant was moving away from the Rapidan",{"className":"moment","children":[["$","$L19",null,{"seconds":296,"label":"4:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee concluded Grant was moving away from the Rapidan"}],["$","p",null,{"children":"The abandoned Germanna Ford route showed that Grant was not retreating north. Lee identified Fredericksburg and Spotsylvania as the two likely destinations."}]]}]]}],["$","div","Roads made Spotsylvania strategically important",{"className":"moment","children":[["$","$L19",null,{"seconds":334,"label":"5:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Roads made Spotsylvania strategically important"}],["$","p",null,{"children":"Brock Road met routes from Fredericksburg and Richmond near the courthouse. A U.S. arrival first would place Grant between Lee and Richmond."}]]}]]}],["$","div","Lee sent Stuart to cover the roads",{"className":"moment","children":[["$","$L19",null,{"seconds":389,"label":"6:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee sent Stuart to cover the roads"}],["$","p",null,{"children":"At about 2 p.m. on May 7, Confederate cavalry received orders to delay any U.S. movement toward Spotsylvania."}]]}]]}],["$","div","Anderson’s corps received the lead march assignment",{"className":"moment","children":[["$","$L19",null,{"seconds":426,"label":"7:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Anderson’s corps received the lead march assignment"}],["$","p",null,{"children":"James Longstreet was wounded, so Richard Anderson led the corps nearest Spotsylvania. Its position lacked a direct road south."}]]}]]}],["$","div","Confederates opened a military road",{"className":"moment","children":[["$","$L19",null,{"seconds":497,"label":"8:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates opened a military road"}],["$","p",null,{"children":"William Pendleton cut a rough track from Anderson’s position to Catharpin Road. Infantry could use it, but the artillery had to take the longer route through Parker’s Store."}]]}]]}],["$","div","Lee ordered Anderson to move at 3 a.m.",{"className":"moment","children":[["$","$L19",null,{"seconds":532,"label":"8:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee ordered Anderson to move at 3 a.m."}],["$","p",null,{"children":"The original plan was to leave the works after dark, rest briefly, and begin the main march early on May 8."}]]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b"]}]]}]
14:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","Overall command",{"className":"command-entry","children":[["$","strong",null,{"children":"Overall command"}],["$","span",null,{"children":"Ulysses S. Grant and George G. Meade"}],["$","small",null,{"children":"Directed the movement from the Wilderness and the effort to seize Spotsylvania"}]]}],["$","div","V Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps"}],["$","span",null,{"children":"Gouverneur K. Warren"}],["$","small",null,{"children":"John C. Robinson and Charles Griffin’s divisions attacked at Laurel Hill"}]]}],["$","div","VI Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"VI Corps"}],["$","span",null,{"children":"John Sedgwick"}],["$","small",null,{"children":"Moved through Chancellorsville and was ordered to reinforce Warren"}]]}],["$","div","II and IX Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"II and IX Corps"}],["$","span",null,{"children":"Winfield Scott Hancock and Ambrose E. Burnside"}],["$","small",null,{"children":"Covered the army’s withdrawal from the Wilderness"}]]}],["$","div","Cavalry Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry Corps"}],["$","span",null,{"children":"Philip H. Sheridan"}],["$","small",null,{"children":"David Gregg, Wesley Merritt, and James H. Wilson’s divisions"}]]}],["$","div","1st Cavalry Division",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Cavalry Division"}],["$","span",null,{"children":"Wesley Merritt"}],["$","small",null,{"children":"Fought Fitzhugh Lee on Brock Road and called for V Corps infantry support"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Robert E. Lee"}],["$","small",null,{"children":"Anticipated the Spotsylvania movement and ordered cavalry and infantry south"}]]}],["$","div","First Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"First Corps"}],["$","span",null,{"children":"Richard H. Anderson"}],["$","small",null,{"children":"Joseph Kershaw and Charles Field’s divisions marched through the night"}]]}],["$","div","Infantry division",{"className":"command-entry","children":[["$","strong",null,{"children":"Infantry division"}],["$","span",null,{"children":"Joseph B. Kershaw"}],["$","small",null,{"children":"Two brigades reinforced Laurel Hill while two secured the courthouse"}]]}],["$","div","Cavalry Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry Corps"}],["$","span",null,{"children":"J. E. B. Stuart"}],["$","small",null,{"children":"Directed the delaying defense at Laurel Hill"}]]}],["$","div","Cavalry division",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry division"}],["$","span",null,{"children":"Fitzhugh Lee"}],["$","small",null,{"children":"Blocked Brock Road with felled trees, dismounted troopers, artillery, and fieldworks"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Richard H. Anderson",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"RH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Richard H. Anderson"}],["$","p",null,{"children":"Led Longstreet’s corps through the night and reached Spotsylvania before Warren"}]]}]]}],["$","article","J. E. B. Stuart",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/jeb-stuart.jpg","alt":"Portrait of J. E. B. Stuart","width":420,"height":520,"loading":"lazy"}],"$L2c"]}],"$L2d","$L2e","$L2f","$L30","$L31","$L32"]}]]}]
15:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","John C. Robinson",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John C. Robinson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Brigadier general commanding a V Corps division","."]}]," ","Shot through the left knee while leading the Laurel Hill attack; his leg was amputated and he did not return to field command"]}]]}]]}]]}]
16:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/spotsylvania-may8-morning-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/spotsylvania-may8-morning-map.jpg","alt":"Detailed NPS map of the early May 8 race to Laurel Hill","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The morning map shows the cavalry delaying action, Warren’s approach, Anderson’s night march, and Wilson’s isolated arrival at the courthouse."}]]}],["$","figure","/images/spotsylvania-may8-afternoon-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/spotsylvania-may8-afternoon-map.jpg","alt":"Detailed NPS map of the May 8 afternoon battle at Laurel Hill","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"By afternoon, Confederate infantry held the Laurel Hill line while Warren extended V Corps east and waited for Sedgwick."}]]}],["$","figure","/images/jeb-stuart.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/jeb-stuart.jpg","alt":"Portrait of Confederate cavalry commander J. E. B. Stuart","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Stuart’s cavalry delayed the U.S. advance long enough for Anderson’s infantry to occupy Laurel Hill."}]]}],["$","figure","/images/philip-sheridan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/philip-sheridan.jpg","alt":"Portrait of U.S. cavalry commander Philip H. Sheridan","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Sheridan’s dispute with Meade ended with the cavalry corps leaving the main army to seek a battle with Stuart."}]]}]]}]]}]
