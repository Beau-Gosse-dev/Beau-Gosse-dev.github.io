18:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
1a:["$","div","Anderson continued through the night",{"className":"moment","children":[["$","$L19",null,{"seconds":573,"label":"9:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Anderson continued through the night"}],["$","p",null,{"children":"His troops started by 10 p.m. Fires and rough ground prevented a bivouac, so the corps kept marching toward Spotsylvania without rest."}]]}]]}]
1b:["$","div","The Army of the Potomac began its night march",{"className":"moment","children":[["$","$L19",null,{"seconds":626,"label":"10:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Potomac began its night march"}],["$","p",null,{"children":"Warren moved down Brock Road, Sedgwick took a route through Chancellorsville, and Burnside and Hancock covered the rear."}]]}]]}]
1c:["$","div","Traffic stalled the U.S. columns",{"className":"moment","children":[["$","$L19",null,{"seconds":645,"label":"10:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Traffic stalled the U.S. columns"}],["$","p",null,{"children":"Ambulances, artillery, infantry, fatigue, and darkness backed up Brock Road for miles and slowed the march to a few steps at a time."}]]}]]}]
1d:["$","div","Meade found two cavalry divisions at Todd’s Tavern",{"className":"moment","children":[["$","$L19",null,{"seconds":741,"label":"12:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade found two cavalry divisions at Todd’s Tavern"}],["$","p",null,{"children":"Gregg and Merritt had no instructions about the night movement even though Meade expected Sheridan’s cavalry to screen the route."}]]}]]}]
1e:["$","div","Meade issued orders directly to Gregg and Merritt",{"className":"moment","children":[["$","$L19",null,{"seconds":929,"label":"15:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade issued orders directly to Gregg and Merritt"}],["$","p",null,{"children":"Gregg was sent toward Corbin’s Bridge and Merritt toward Blockhouse Bridge through Spotsylvania to deny the Po River crossings to Lee."}]]}]]}]
1f:["$","div","The cavalry left Todd’s Tavern at 3 a.m.",{"className":"moment","children":[["$","$L19",null,{"seconds":1109,"label":"18:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cavalry left Todd’s Tavern at 3 a.m."}],["$","p",null,{"children":"Gregg moved west on Catharpin Road while Merritt rode south on Brock Road."}]]}]]}]
20:["$","div","Fitzhugh Lee blocked Brock Road",{"className":"moment","children":[["$","$L19",null,{"seconds":1133,"label":"18:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fitzhugh Lee blocked Brock Road"}],["$","p",null,{"children":"Felled trees, dismounted cavalry, and artillery stopped Merritt about two miles south of Todd’s Tavern. By daylight his entire division was engaged."}]]}]]}]
21:["$","div","Merritt requested infantry support",{"className":"moment","children":[["$","$L19",null,{"seconds":1177,"label":"19:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Merritt requested infantry support"}],["$","p",null,{"children":"John C. Robinson’s V Corps division was about a mile behind. Warren sent Robinson’s leading brigade to clear the road."}]]}]]}]
22:["$","div","Sheridan deployed the arriving infantry",{"className":"moment","children":[["$","$L19",null,{"seconds":1236,"label":"20:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sheridan deployed the arriving infantry"}],["$","p",null,{"children":"Robinson’s troops initially pushed the Confederate cavalry south, but heat and exhaustion quickly slowed them."}]]}]]}]
23:["$","div","Confederates formed a position at Laurel Hill",{"className":"moment","children":[["$","$L19",null,{"seconds":1287,"label":"21:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates formed a position at Laurel Hill"}],["$","p",null,{"children":"Fitzhugh Lee’s troopers built abatis and fence-rail breastworks along a pine-covered rise with a clear field of fire across roughly 400 yards."}]]}]]}]
24:["$","div","Warren ordered an immediate attack",{"className":"moment","children":[["$","$L19",null,{"seconds":1347,"label":"22:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Warren ordered an immediate attack"}],["$","p",null,{"children":"Robinson preferred to wait for his full division, but Warren decided to attack before the defense could grow stronger."}]]}]]}]
25:["$","div","Peter Lyle’s brigade reached within 60 yards",{"className":"moment","children":[["$","$L19",null,{"seconds":1385,"label":"23:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Peter Lyle’s brigade reached within 60 yards"}],["$","p",null,{"children":"A close Confederate volley stopped the advance. V Corps brigades then entered the fight separately as each arrived."}]]}]]}]
26:["$","div","Robinson was severely wounded",{"className":"moment","children":[["$","$L19",null,{"seconds":1509,"label":"25:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Robinson was severely wounded"}],["$","p",null,{"children":"A bullet shattered his left knee. The leg was amputated, ending his field service, and the V Corps assault collapsed."}]]}]]}]
27:["$","div","Anderson’s infantry reached Laurel Hill",{"className":"moment","children":[["$","$L19",null,{"seconds":1572,"label":"26:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Anderson’s infantry reached Laurel Hill"}],["$","p",null,{"children":"Two brigades from Joseph Kershaw’s division reinforced the cavalry in time to repel Warren’s attacks. Two others continued to secure Spotsylvania Court House."}]]}]]}]
28:["$","div","Wilson reached the courthouse and withdrew",{"className":"moment","children":[["$","$L19",null,{"seconds":1626,"label":"27:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wilson reached the courthouse and withdrew"}],["$","p",null,{"children":"James Wilson’s cavalry arrived before Kershaw’s infantry, but Sheridan ordered it back because it was isolated and unsupported."}]]}]]}]
29:["$","div","Meade learned Confederate infantry held the road",{"className":"moment","children":[["$","$L19",null,{"seconds":1655,"label":"27:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade learned Confederate infantry held the road"}],["$","p",null,{"children":"He ordered Sedgwick to deploy VI Corps on Warren’s left and directed both corps to attack again."}]]}]]}]
2a:["$","div","Meade confronted Sheridan",{"className":"moment","children":[["$","$L19",null,{"seconds":1735,"label":"28:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade confronted Sheridan"}],["$","p",null,{"children":"Meade blamed the cavalry for failing to screen the march and block Confederate routes. Sheridan objected to Meade issuing orders directly to cavalry division commanders."}]]}]]}]
2b:["$","div","Grant authorized Sheridan’s independent raid",{"className":"moment","children":[["$","$L19",null,{"seconds":1817,"label":"30:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant authorized Sheridan’s independent raid"}],["$","p",null,{"children":"When told Sheridan said he could defeat Stuart, Grant approved the proposal. Meade ordered the cavalry corps to move against Confederate cavalry and later resupply at Haxall’s Landing."}]]}]]}]
2c:["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"J. E. B. Stuart"}],["$","p",null,{"children":"Placed cavalry on the roads and directed Kershaw’s arriving infantry at Laurel Hill"}]]}]
2d:["$","article","Fitzhugh Lee",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"FL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Fitzhugh Lee"}],["$","p",null,{"children":"Conducted the mounted and dismounted delaying action along Brock Road"}]]}]]}]
2e:["$","article","Gouverneur K. Warren",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GK"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Gouverneur K. Warren"}],["$","p",null,{"children":"Pushed V Corps down Brock Road and committed brigades separately against Laurel Hill"}]]}]]}]
2f:["$","article","John C. Robinson",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JC"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John C. Robinson"}],["$","p",null,{"children":"Led V Corps infantry at Laurel Hill until a leg wound ended his field service"}]]}]]}]
30:["$","article","Philip H. Sheridan",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/philip-sheridan.jpg","alt":"Portrait of Philip H. Sheridan","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Philip H. Sheridan"}],["$","p",null,{"children":"Clashed with Meade over the cavalry’s role and received permission to leave on a raid against Stuart"}]]}]]}]
31:["$","article","Wesley Merritt",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WM"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Wesley Merritt"}],["$","p",null,{"children":"Led the cavalry advance down Brock Road and fought Fitzhugh Lee’s delaying force"}]]}]]}]
32:["$","article","James H. Wilson",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"James H. Wilson"}],["$","p",null,{"children":"Reached Spotsylvania Court House first but withdrew on Sheridan’s order because his division was unsupported"}]]}]]}]
