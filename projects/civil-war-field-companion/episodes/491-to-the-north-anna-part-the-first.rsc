17:["$","div",null,{"children":[["$","h3",null,{"children":"Three hours of fighting followed"}],["$","p",null,{"children":"The battle took place in heavy rain. Confederate troops briefly reached a wagon train but could not hold the ground against Tyler and additional heavy-artillery regiments."}]]}]
18:["$","div","Both sides suffered heavy casualties",{"className":"moment","children":[["$","$L16",null,{"seconds":812,"label":"13:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both sides suffered heavy casualties"}],["$","p",null,{"children":"Ewell withdrew after losing about 900 men. The U.S. heavy-artillery regiments lost about 1,500 but established their ability to fight as infantry."}]]}]]}]
19:["$","div","Grant still believed Lee might attack",{"className":"moment","children":[["$","$L16",null,{"seconds":854,"label":"14:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant still believed Lee might attack"}],["$","p",null,{"children":"The Harris Farm action increased Grant’s hope that an apparently isolated II Corps would draw Lee away from his entrenchments."}]]}]]}]
1a:["$","div","Hancock began marching on May 20",{"className":"moment","children":[["$","$L16",null,{"seconds":885,"label":"14:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock began marching on May 20"}],["$","p",null,{"children":"II Corps moved east after dark with cavalry protection, reached Guinea Station, and then followed the railroad south."}]]}]]}]
1b:["$","div","Hancock reached Milford Station and Bowling Green",{"className":"moment","children":[["$","$L16",null,{"seconds":911,"label":"15:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock reached Milford Station and Bowling Green"}],["$","p",null,{"children":"Cavalry reached Milford Station by 9 a.m. on May 21. The lead infantry crossed the Mattaponi River near Bowling Green around noon."}]]}]]}]
1c:["$","div","II Corps was about twenty miles from support",{"className":"moment","children":[["$","$L16",null,{"seconds":962,"label":"16:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"II Corps was about twenty miles from support"}],["$","p",null,{"children":"Hancock threatened Lee’s communications but remained isolated. Prisoners from Pickett’s division showed that reinforcements had already reached the area."}]]}]]}]
1d:["$","div","Hancock stopped and fortified",{"className":"moment","children":[["$","$L16",null,{"seconds":1015,"label":"16:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock stopped and fortified"}],["$","p",null,{"children":"The presence of Pickett’s troops made a farther unsupported advance too dangerous. II Corps entrenched near the Mattaponi and waited."}]]}]]}]
1e:["$","div","Lee did not take the bait",{"className":"moment","children":[["$","$L16",null,{"seconds":1106,"label":"18:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee did not take the bait"}],["$","p",null,{"children":"He interpreted Hancock’s march as the leading element of a general U.S. movement, not an isolated target, and ordered the Army of Northern Virginia toward the North Anna."}]]}]]}]
1f:["$","div","The armies marched on parallel routes",{"className":"moment","children":[["$","$L16",null,{"seconds":1161,"label":"19:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies marched on parallel routes"}],["$","p",null,{"children":"For about thirty-six hours Grant moved through Guinea and Milford while Lee took the Telegraph Road. The armies were out of direct contact for the first time since May 5."}]]}]]}]
20:["$","div","The armies entered largely untouched Caroline County",{"className":"moment","children":[["$","$L16",null,{"seconds":1221,"label":"20:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies entered largely untouched Caroline County"}],["$","p",null,{"children":"U.S. soldiers found livestock and crops in a wealthy agricultural area. Unauthorized foraging and pillaging increased during the march."}]]}]]}]
21:["$","div","Officers disagreed about foraging",{"className":"moment","children":[["$","$L16",null,{"seconds":1312,"label":"21:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Officers disagreed about foraging"}],["$","p",null,{"children":"Some punished pillagers and threatened severe penalties; others considered the behavior inevitable. Grant allowed authorized foraging but treated straggling and theft as threats to discipline."}]]}]]}]
22:["$","div","Lee selected the North Anna as a temporary shield",{"className":"moment","children":[["$","$L16",null,{"seconds":1449,"label":"24:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee selected the North Anna as a temporary shield"}],["$","p",null,{"children":"The river protected Hanover Junction and was crossable at only a few places. Its higher north bank, however, allowed U.S. artillery to command many crossings."}]]}]]}]
23:["$","div","Lee expected Grant to move toward Richmond",{"className":"moment","children":[["$","$L16",null,{"seconds":1581,"label":"26:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee expected Grant to move toward Richmond"}],["$","p",null,{"children":"Lee thought Grant would cross the Pamunkey and approach from the east or rebuild the railroad for a direct southern advance. He did not expect immediate battle at North Anna."}]]}]]}]
24:["$","div","Lee misidentified Grant’s main objective",{"className":"moment","children":[["$","$L16",null,{"seconds":1758,"label":"29:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee misidentified Grant’s main objective"}],["$","p",null,{"children":"Confederate leaders assumed Richmond was the objective. Grant’s operational goal remained the destruction of the Army of Northern Virginia."}]]}]]}]
25:["$","div","Lee asked to concentrate with Beauregard",{"className":"moment","children":[["$","$L16",null,{"seconds":1853,"label":"30:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee asked to concentrate with Beauregard"}],["$","p",null,{"children":"With more than 10,000 reinforcements and shorter supply lines, Lee told Davis on May 23 that combining forces might permit a decisive attack on Grant."}]]}]]}]
