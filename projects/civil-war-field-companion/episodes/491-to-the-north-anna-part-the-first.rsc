e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The movement from Spotsylvania to North Anna"}],["$","span",null,{"children":"The campaign map shows Grant’s southeastern route through Guinea Station, Milford Station, and Bowling Green while Lee used the more direct Telegraph Road toward Hanover Junction."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
f:["$","figure","The North Anna and Hanover Junction",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/north-anna-battle-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The North Anna and Hanover Junction at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/north-anna-battle-map.jpg","alt":"Historical map of the North Anna River and Hanover Junction","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The North Anna and Hanover Junction"}],["$","span",null,{"children":"The battle plan identifies the river crossings and the two railroads meeting at Hanover Junction. Lee needed to protect the Virginia Central route to the Shenandoah Valley."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/north-anna-battle-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/gvhs01.vhs00237/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
10:["$","figure","Spotsylvania, Milford Station, and the North Anna today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.85%2C37.75%2C-77.20%2C38.30&layer=mapnik&marker=37.9008%2C-77.4995","title":"Spotsylvania, Milford Station, and the North Anna today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Spotsylvania, Milford Station, and the North Anna today"}],["$","span",null,{"children":"Hancock moved well east of the main army before turning south. The two armies then marched on roughly parallel routes toward the North Anna."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Grant prepared another southeastern movement",{"className":"moment","children":[["$","$L16",null,{"seconds":78,"label":"1:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant prepared another southeastern movement"}],["$","p",null,{"children":"Defeats in the Shenandoah Valley and at Bermuda Hundred freed Confederate reinforcements for Lee. Grant concluded that remaining at Spotsylvania offered no further advantage."}]]}]]}],["$","div","The army needed a new supply base",{"className":"moment","children":[["$","$L16",null,{"seconds":192,"label":"3:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army needed a new supply base"}],["$","p",null,{"children":"Moving around Lee’s right exposed the road back to Belle Plain. Grant designated Port Royal on the Rappahannock for future supplies and reinforcements."}]]}]]}],["$","div","Grant wanted an open-field battle",{"className":"moment","children":[["$","$L16",null,{"seconds":233,"label":"3:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant wanted an open-field battle"}],["$","p",null,{"children":"The North Anna and Richmond fortifications offered Lee new defensive positions. Grant sought a way to make Lee leave his earthworks."}]]}]]}],["$","div","Hancock’s II Corps became the bait",{"className":"moment","children":[["$","$L16",null,{"seconds":340,"label":"5:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock’s II Corps became the bait"}],["$","p",null,{"children":"Grant planned to move II Corps around the Confederate right while the rest of the army remained at Spotsylvania. If Lee attacked Hancock, Grant intended to strike the committed Confederates."}]]}]]}],["$","div","A Confederate movement delayed the plan",{"className":"moment","children":[["$","$L16",null,{"seconds":391,"label":"6:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"A Confederate movement delayed the plan"}],["$","p",null,{"children":"On May 19 U.S. formations shifted to a north-south line while Hancock assembled in the rear. Confederate troops appeared near Harris Farm before Hancock could depart."}]]}]]}],["$","div","The Harris Farm action threatened the supply road",{"className":"moment","children":[["$","$L16",null,{"seconds":446,"label":"7:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Harris Farm action threatened the supply road"}],["$","p",null,{"children":"Confederates approached the Fredericksburg Road on the U.S. right. Meade ordered Hancock to reinforce the sector and postponed the turning movement."}]]}]]}],["$","div","Grant ordered a counterattack",{"className":"moment","children":[["$","$L16",null,{"seconds":504,"label":"8:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant ordered a counterattack"}],["$","p",null,{"children":"He sent Horace Porter to the threatened flank with instructions to stop the advance and take the offensive, with Warren’s corps supporting."}]]}]]}],["$","div","Former heavy artillerists entered their first battle",{"className":"moment","children":[["$","$L16",null,{"seconds":542,"label":"9:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Former heavy artillerists entered their first battle"}],["$","p",null,{"children":"Robert Tyler’s division contained five large regiments trained for Washington’s forts. Grant had recently converted them to infantry duty."}]]}]]}],["$","div","Ewell’s reconnaissance became a battle",{"className":"moment","children":[["$","$L16",null,{"seconds":673,"label":"11:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell’s reconnaissance became a battle"}],["$","p",null,{"children":"Lee ordered Ewell to locate the new U.S. flank. Ewell used his entire six-thousand-man corps, and Ramseur began an attack after mistakenly expecting the U.S. troops to charge."}]]}]]}],["$","div","Three hours of fighting followed",{"className":"moment","children":[["$","$L16",null,{"seconds":739,"label":"12:19"}],"$L17"]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","General-in-chief",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Planned to use II Corps to draw Lee into open battle and ordered the army southeast"}]]}],["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"George G. Meade"}],["$","small",null,{"children":"Redirected Hancock to Harris Farm before the march began"}]]}],["$","div","II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps"}],["$","span",null,{"children":"Winfield S. Hancock"}],["$","small",null,{"children":"Advanced through Guinea and Milford Stations to the Mattaponi River"}]]}],["$","div","Heavy Artillery Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Heavy Artillery Division"}],["$","span",null,{"children":"Robert O. Tyler"}],["$","small",null,{"children":"Five converted heavy-artillery regiments that fought at Harris Farm"}]]}],["$","div","V Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps"}],["$","span",null,{"children":"Gouverneur K. Warren"}],["$","small",null,{"children":"Supported the right flank and followed Hancock during the general movement"}]]}],["$","div","Provost marshal general",{"className":"command-entry","children":[["$","strong",null,{"children":"Provost marshal general"}],["$","span",null,{"children":"Marsena R. Patrick"}],["$","small",null,{"children":"Responsible for controlling stragglers and unauthorized pillaging"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Robert E. Lee"}],["$","small",null,{"children":"Ordered the North Anna withdrawal and sought concentration with Beauregard"}]]}],["$","div","Second Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Corps"}],["$","span",null,{"children":"Richard S. Ewell"}],["$","small",null,{"children":"Used his corps to locate the new U.S. flank at Harris Farm"}]]}],["$","div","Brigade, Second Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Second Corps"}],["$","span",null,{"children":"Stephen D. Ramseur"}],["$","small",null,{"children":"Opened the Harris Farm attack after misreading U.S. intentions"}]]}],["$","div","Division, First Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Division, First Corps"}],["$","span",null,{"children":"George E. Pickett"}],["$","small",null,{"children":"Returning troops whose presence warned Hancock that reinforcements were arriving"}]]}],["$","div","Department of North Carolina and Southern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of North Carolina and Southern Virginia"}],["$","span",null,{"children":"P. G. T. Beauregard"}],["$","small",null,{"children":"Commanded forces Lee hoped to combine with his army"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Ulysses S. Grant",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Ulysses S. Grant"}],["$","p",null,{"children":"Designed the attempted trap and shifted the army toward North Anna after it failed"}]]}]]}],["$","article","Winfield S. Hancock",{"className":"person-card","children":["$L26","$L27"]}],"$L28","$L29","$L2a","$L2b","$L2c","$L2d"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/overland-campaign-1864-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland Campaign route","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The armies left the Spotsylvania lines and moved southeast toward the North Anna on separate roads."}]]}],["$","figure","/images/north-anna-battle-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/north-anna-battle-map.jpg","alt":"Historical map of the North Anna River and Hanover Junction","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The North Anna protected the rail junction that connected Lee to Richmond and the Shenandoah Valley."}]]}],["$","figure","/images/jericho-mill-pontoon-bridge.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/jericho-mill-pontoon-bridge.jpg","alt":"1864 photograph of a canvas pontoon bridge at Jericho Mill","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The 50th New York Engineers built this bridge for Warren’s V Corps during the North Anna operations."}]]}],["$","figure","/images/birney-crossing-north-anna.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/birney-crossing-north-anna.jpg","alt":"Alfred Waud drawing of U.S. troops crossing the North Anna","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The river could be crossed at only a limited number of bridges and fords, making their control essential."}]]}]]}]]}]
