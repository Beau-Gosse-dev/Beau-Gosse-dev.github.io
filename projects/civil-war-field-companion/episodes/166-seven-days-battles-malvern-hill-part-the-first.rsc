1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",166," · ","July 1, 1862"," · ","Malvern Hill, an open plateau north of the James River in Henrico County, Virginia, about fifteen miles southeast of Richmond"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: MALVERN HILL (Part the First)"}],["$","span",null,{"className":"result-label","children":"This episode establishes the terrain, opposing deployments, and Confederate plan before the main artillery and infantry fighting. The Army of the Potomac occupied a compact position supported by massed artillery, while Robert E. Lee planned to suppress the Federal guns with artillery on two ridges and then attack. Misidentified roads, dispersed batteries, ammunition shortages, and an ambiguous attack order prevented the intended Confederate concentration. The full battle, covered in the following episode, ended in a United States victory"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5551231788.mp3?updated=1695385126","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The battlefield and command arrangements before the main fighting at Malvern Hill"}],["$","small",null,{"children":"The narrative stops after explaining the failed Confederate artillery concentration. The gun duel, infantry assaults, and casualty totals belong to the following episode."}]]}],["$","div","Campaign setting",{"children":[["$","span",null,{"children":"Campaign setting"}],["$","strong",null,{"children":"Final battle of the Seven Days, one day after Glendale"}],["$","small",null,{"children":"By July 1, the Army of the Potomac had concentrated on Malvern Hill during its movement toward the James River."}]]}],["$","div","Battlefield form",{"children":[["$","span",null,{"children":"Battlefield form"}],["$","strong",null,{"children":"An elevated, open plateau with long fields of fire"}],["$","small",null,{"children":"The episode describes the plateau as about one and one-quarter miles north to south, three-quarters of a mile wide, and approximately 130 feet above the James River. Published measurements vary according to the boundaries used."}]]}],["$","div","Natural boundaries",{"children":[["$","span",null,{"children":"Natural boundaries"}],["$","strong",null,{"children":"Turkey Run and Western Run framed the plateau"}],["$","small",null,{"children":"Malvern Cliffs and Turkey Run protected the western side. Wooded, swampy Western Run bordered the east and crossed the northern approach below the open slope."}]]}],["$","div","Main approach",{"children":[["$","span",null,{"children":"Main approach"}],["$","strong",null,{"children":"Willis Church Road crossed the plateau from north to south"}],["$","small",null,{"children":"The road divided the principal Federal position and became the central reference line for both armies."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}],"$L24","$L25","$L26","$L27",false,"$L28","$L29","$L2a"]}]]}]
2e:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Federal formation",{"children":[["$","span",null,{"children":"Federal formation"}],["$","strong",null,{"children":"A loose inverted horseshoe facing north and east"}],["$","small",null,{"children":"Porter’s V Corps held the western and northern sectors; Couch’s division extended east of Willis Church Road. Sumner and Heintzelman stood behind the eastern side, and Franklin guarded approaches nearer the James."}]]}]
f:["$","div","V Corps frontage",{"children":[["$","span",null,{"children":"V Corps frontage"}],["$","strong",null,{"children":"Sykes west of Willis Church Road; Morell across the northern face"}],["$","small",null,{"children":"Morell’s division curved around the Crew house. Griffin held the forward field, with Martindale and Butterfield behind and to the east."}]]}]
10:["$","div","Couch’s deployment",{"children":[["$","span",null,{"children":"Couch’s deployment"}],["$","strong",null,{"children":"Three brigades in depth near the West house"}],["$","small",null,{"children":"The episode identifies the brigades of Innis N. Palmer, Albion P. Howe, and John J. Abercrombie. Palmer’s understrength brigade formed the forward line."}]]}]
11:["$","div","Federal artillery",{"children":[["$","span",null,{"children":"Federal artillery"}],["$","strong",null,{"children":"Army artillery and siege guns were available around the plateau"}],["$","small",null,{"children":"The episode gives 268 field pieces and 26 siege guns in the vicinity. It places 31 guns in seven batteries on the northern front, about 60 guns in ten batteries to the east, and roughly 50 more guns in reserve. These figures describe availability and deployment areas, not simultaneous fire from one line."}]]}]
12:["$","div","Artillery direction",{"children":[["$","span",null,{"children":"Artillery direction"}],["$","strong",null,{"children":"Col. Henry J. Hunt organized and sustained the Federal gun line"}],["$","small",null,{"children":"As Army of the Potomac chief of artillery, Hunt selected positions and arranged for batteries to rotate through the firing line."}]]}]
13:["$","div","McClellan’s movements",{"children":[["$","span",null,{"children":"McClellan’s movements"}],["$","strong",null,{"children":"Inspected Harrison’s Landing before returning to Malvern Hill in mid-afternoon"}],["$","small",null,{"children":"McClellan traveled from Haxall’s Landing aboard USS Galena and later remained on the eastern side of the Federal position. Porter directed the sector facing the principal Confederate approach."}]]}]
14:["$","div","Lee’s condition",{"children":[["$","span",null,{"children":"Lee’s condition"}],["$","strong",null,{"children":"Fatigued and ill after the preceding campaign days"}],["$","small",null,{"children":"The episode reports that Lee asked Longstreet to remain with him in case Longstreet needed to assume command. The extent to which fatigue affected later decisions remains an interpretation rather than a measurable fact."}]]}]
15:["$","div","D. H. Hill’s warning",{"children":[["$","span",null,{"children":"D. H. Hill’s warning"}],["$","strong",null,{"children":"Advised against attacking if McClellan held Malvern Hill in strength"}],["$","small",null,{"children":"Hill had questioned a local chaplain about the ground and relayed the warning to Lee near Willis Methodist Church."}]]}]
16:["$","div","Confederate assumption",{"children":[["$","span",null,{"children":"Confederate assumption"}],["$","strong",null,{"children":"Lee and Longstreet believed the retreating Federal army was demoralized"}],["$","small",null,{"children":"D. H. Hill later identified this belief as a reason Lee risked an attack against a strong position."}]]}]
17:["$","div","Intended Confederate alignment",{"children":[["$","span",null,{"children":"Intended Confederate alignment"}],["$","strong",null,{"children":"Jackson east of Willis Church Road; Magruder west of it"}],["$","small",null,{"children":"Lee selected commands that had done little fighting at Glendale: Jackson, Huger, and Magruder."}]]}]
18:["$","div","Road-name error",{"children":[["$","span",null,{"children":"Road-name error"}],["$","strong",null,{"children":"Lee called Willis Church Road the Quaker Road"}],["$","small",null,{"children":"Confederate maps applied the Quaker Road name to Willis Church Road, while local guides knew a different Quaker Road about two miles west. The mismatch sent Magruder away from his intended route until an aide redirected him."}]]}]
19:["$","div","Unmapped eastern road",{"children":[["$","span",null,{"children":"Unmapped eastern road"}],["$","strong",null,{"children":"A parallel road east of Willis Church Road did not appear on Lee’s maps"}],["$","small",null,{"children":"The episode notes that Federal wagons had used it and that it might have offered Jackson a better flanking approach. That possible use is counterfactual and cannot be verified as an available attack route under battlefield conditions."}]]}]
1a:["$","div","Longstreet’s proposal",{"children":[["$","span",null,{"children":"Longstreet’s proposal"}],["$","strong",null,{"children":"Mass artillery on both sides of Willis Church Road to create converging fire"}],["$","small",null,{"children":"Longstreet estimated that about 60 guns could fit on the plateau behind Armistead and Wright. Lee selected the Poindexter farm ridge for the corresponding position on the eastern side."}]]}]
1b:["$","div","Armistead’s role",{"children":[["$","span",null,{"children":"Armistead’s role"}],["$","strong",null,{"children":"His advance was named as the signal for a general infantry attack"}],["$","small",null,{"children":"The order said that if artillery broke the Federal line, Armistead was to charge with a yell and other commands were to do the same. Armistead did not receive the order because it went only to division commanders."}]]}]
1c:["$","div","Chilton order",{"children":[["$","span",null,{"children":"Chilton order"}],["$","strong",null,{"children":"Undated and dependent on an audible yell across the battlefield"}],["$","small",null,{"children":"Lee’s aide Robert H. Chilton drafted the order before 1 p.m. Its wording did not specify how commanders were to verify that the bombardment had broken the Federal line."}]]}]
1d:["$","div","Confederate artillery problem",{"children":[["$","span",null,{"children":"Confederate artillery problem"}],["$","strong",null,{"children":"The two planned concentrations were never assembled"}],["$","small",null,{"children":"Available batteries were dispersed among divisions, routes and orders were unclear, and several batteries never reached the intended ridges."}]]}]
1e:["$","div","D. H. Hill’s batteries",{"children":[["$","span",null,{"children":"D. H. Hill’s batteries"}],["$","strong",null,{"children":"Seven batteries lacked ammunition after White Oak Swamp"}],["$","small",null,{"children":"The episode states that Hill’s artillery had exhausted its ammunition during the June 30 bombardment and was unavailable for the planned Malvern Hill concentration."}]]}]
1f:["$","div","Artillery reserve",{"children":[["$","span",null,{"children":"Artillery reserve"}],["$","strong",null,{"children":"Six batteries under Brig. Gen. William N. Pendleton remained idle"}],["$","small",null,{"children":"The episode finds no record of Lee summoning the reserve. Pendleton searched for Lee but did not establish contact in time to employ the batteries."}]]}]
20:["$","div","Battle result outside episode scope",{"children":[["$","span",null,{"children":"Battle result outside episode scope"}],["$","strong",null,{"children":"United States victory"}],["$","small",null,{"children":"The National Park Service estimates 8,355 casualties for the complete battle: about 3,000 United States and 5,355 Confederate. These losses occurred during fighting narrated in the following episode, not during this episode’s setup."}]]}]
21:["$","div","Senior leader losses in this episode",{"children":[["$","span",null,{"children":"Senior leader losses in this episode"}],["$","strong",null,{"children":"None"}],["$","small",null,{"children":"No senior commander is killed or mortally wounded during the preparatory events covered here."}]]}]
22:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Voices of the Civil War: The Seven Days” by the editors of Time-Life Books"}],["$","small",null,{"children":"The episode recommends this collection of participant accounts, and the official podcast listing confirms the title."}]]}]
23:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Morell, Couch, Heintzelman, Huger, Haxall’s Landing, Abercrombie, Poindexter, and Chilton"}],["$","small",null,{"children":"The automated transcript produces forms including “Morrill,” “Daria’s couches,” “Heinzelman,” “UJ,” “Haxle’s,” “Ambercrombie,” and “Presthard.”"}]]}]
24:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
25:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Malvern Hill in the Peninsula Campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep166-peninsula-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Malvern Hill in the Peninsula Campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep166-peninsula-context.svg","alt":"Schematic regional map of eastern Virginia showing Richmond, the Virginia Peninsula, Fort Monroe, Yorktown, Glendale, Malvern Hill, Harrison’s Landing, and the Army of the Potomac’s broad movement.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Malvern Hill in the Peninsula Campaign"}],["$","span",null,{"children":"The Army of the Potomac advanced from Fort Monroe toward Richmond between the York and James rivers, then moved southeast during the Seven Days toward the security of the James. Malvern Hill stood between Glendale and Harrison’s Landing. Locations, shorelines, routes, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep166-peninsula-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History, National Park Service, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Positions and intended artillery plan at Malvern Hill",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep166-malvern-hill-positions.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Positions and intended artillery plan at Malvern Hill at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep166-malvern-hill-positions.svg","alt":"Schematic map of Malvern Hill showing the Federal line, Sykes, Morell, Couch, supporting corps, the planned Confederate artillery ridges, Jackson, Huger, Magruder’s mistaken movement, Willis Church Road, Quaker Road, Turkey Run, Western Run, and the James River.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Positions and intended artillery plan at Malvern Hill"}],["$","span",null,{"children":"Federal infantry and artillery occupied the plateau around the Crew and West houses. Lee intended Confederate artillery on the Armistead ridge west of Willis Church Road and the Poindexter ridge east of it to subject the Federal line to converging fire before an infantry assault. Magruder initially moved toward the actual Quaker Road after Lee used that name for Willis Church Road. Unit areas and arrows show generalized relationships, not exact routes, formations, frontage, or gun positions. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep166-malvern-hill-positions.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ","$L2b"]}],"$L2c"]}],"$undefined"]}]]}],"$L2d"]}]]}]
26:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Glendale is reviewed",{"className":"moment","children":[["$","$L2e",null,{"seconds":69,"label":"1:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Glendale is reviewed"}],["$","p",null,{"children":"The episode begins by assessing why Lee’s June 30 plan failed to trap the retreating Federal army."}]]}]]}],["$","div","Command failures at Glendale are assigned",{"className":"moment","children":[["$","$L2e",null,{"seconds":172,"label":"2:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Command failures at Glendale are assigned"}],["$","p",null,{"children":"Huger and Jackson are criticized, but the episode places primary army-level responsibility on Lee."}]]}]]}],["$","div","Lee’s June 30 inspection of Malvern Hill is recalled",{"className":"moment","children":[["$","$L2e",null,{"seconds":260,"label":"4:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s June 30 inspection of Malvern Hill is recalled"}],["$","p",null,{"children":"Lee had examined Holmes’s sector and diverted Magruder toward the River Road before reversing part of that movement."}]]}]]}],["$","div","The Army of the Potomac concentrates",{"className":"moment","children":[["$","$L2e",null,{"seconds":448,"label":"7:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Potomac concentrates"}],["$","p",null,{"children":"On July 1, the Federal army is assembled at Malvern Hill with the James River behind it."}]]}]]}],["$","div","The plateau is described",{"className":"moment","children":[["$","$L2e",null,{"seconds":485,"label":"8:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"The plateau is described"}],["$","p",null,{"children":"The episode gives the dimensions and elevation of the open ground above the James."}]]}]]}],["$","div","The watercourses frame the position",{"className":"moment","children":[["$","$L2e",null,{"seconds":507,"label":"8:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The watercourses frame the position"}],["$","p",null,{"children":"Turkey Run, Western Run, and the Malvern Cliffs define the principal approaches and flanks."}]]}]]}],["$","div","Porter evaluates the defensive ground",{"className":"moment","children":[["$","$L2e",null,{"seconds":564,"label":"9:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Porter evaluates the defensive ground"}],["$","p",null,{"children":"Porter considers Malvern Hill better suited to defense than earlier V Corps positions."}]]}]]}],["$","div","The Federal line is outlined",{"className":"moment","children":[["$","$L2e",null,{"seconds":579,"label":"9:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Federal line is outlined"}],["$","p",null,{"children":"The army forms a loose inverted horseshoe facing the expected Confederate approach."}]]}]]}],["$","div","Sykes and Morell take the principal front",{"className":"moment","children":[["$","$L2e",null,{"seconds":591,"label":"9:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sykes and Morell take the principal front"}],["$","p",null,{"children":"Sykes covers the western cliffs and River Road while Morell spans the northern face toward Willis Church Road."}]]}]]}],["$","div","Couch extends the line east",{"className":"moment","children":[["$","$L2e",null,{"seconds":648,"label":"10:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Couch extends the line east"}],["$","p",null,{"children":"Couch places Palmer, Howe, and Abercrombie in depth near the West house."}]]}]]}],["$","div","The supporting corps are located",{"className":"moment","children":[["$","$L2e",null,{"seconds":679,"label":"11:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The supporting corps are located"}],["$","p",null,{"children":"Sumner and Heintzelman stand behind the eastern side, with Franklin nearer the James."}]]}]]}],["$","div","Federal artillery becomes the central defensive advantage",{"className":"moment","children":[["$","$L2e",null,{"seconds":694,"label":"11:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal artillery becomes the central defensive advantage"}],["$","p",null,{"children":"The episode inventories the field batteries, siege guns, and reserve pieces available around Malvern Hill."}]]}]]}],"$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43"]}]]}]
