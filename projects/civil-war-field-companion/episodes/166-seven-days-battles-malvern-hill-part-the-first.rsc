32:["$","div","The position’s narrow front is assessed",{"className":"moment","children":[["$","$L2e",null,{"seconds":904,"label":"15:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The position’s narrow front is assessed"}],["$","p",null,{"children":"The episode notes that only a limited number of defenders could occupy the 1,200-yard northern front at once, but nearby reserves could respond to a breakthrough."}]]}]]}]
33:["$","div","Lee’s condition is considered",{"className":"moment","children":[["$","$L2e",null,{"seconds":976,"label":"16:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s condition is considered"}],["$","p",null,{"children":"Lee is described as fatigued and ill after days of limited sleep and operational disappointment."}]]}]]}]
34:["$","div","D. H. Hill warns against an attack",{"className":"moment","children":[["$","$L2e",null,{"seconds":1046,"label":"17:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"D. H. Hill warns against an attack"}],["$","p",null,{"children":"Near Willis Methodist Church, Hill reports local information about the strength of the ground and advises leaving McClellan alone if he holds it in force."}]]}]]}]
35:["$","div","Longstreet judges the Federal army demoralized",{"className":"moment","children":[["$","$L2e",null,{"seconds":1091,"label":"18:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet judges the Federal army demoralized"}],["$","p",null,{"children":"Longstreet interprets the continuing retreat as evidence that the Army of the Potomac can be defeated by another attack."}]]}]]}]
