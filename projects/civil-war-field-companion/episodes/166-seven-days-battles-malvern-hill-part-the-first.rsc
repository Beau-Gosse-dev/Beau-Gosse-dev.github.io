28:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep166-peninsula-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep166-peninsula-context.svg","alt":"Schematic regional map of the Virginia Peninsula and the movement from Richmond toward the James River.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The broad campaign map places Malvern Hill between Glendale and Harrison’s Landing during the Army of the Potomac’s movement away from Richmond."}]]}],["$","figure","/images/ep166-malvern-hill-positions.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep166-malvern-hill-positions.svg","alt":"Schematic troop-position and movement map for the opening arrangements at Malvern Hill.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The northern plateau concentrated Porter’s and Couch’s divisions with Federal artillery. The proposed Confederate gun positions stood on separate ridges north of that line, but the planned concentration did not occur."}]]}],["$","figure","/images/ep166-malvern-hill-waud.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep166-malvern-hill-waud.jpg","alt":"Alfred Waud drawing of United States guns and troops at Malvern Hill on July 1, 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alfred R. Waud drew the Battle of Malvern Hill on July 1, 1862. The original is pencil and Chinese white on tan paper."}]]}],["$","figure","/images/ep166-henry-hunt.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep166-henry-hunt.jpg","alt":"Civil War-era photographic portrait of United States artillery officer Henry J. Hunt.","width":1280,"height":820,"load