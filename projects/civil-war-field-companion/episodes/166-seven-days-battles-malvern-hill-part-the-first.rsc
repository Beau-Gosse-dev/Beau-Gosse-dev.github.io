d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",166," · ","July 1, 1862"," · ","Malvern Hill, an open plateau north of the James River in Henrico County, Virginia, about fifteen miles southeast of Richmond"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: MALVERN HILL (Part the First)"}],["$","span",null,{"className":"result-label","children":"This episode establishes the terrain, opposing deployments, and Confederate plan before the main artillery and infantry fighting. The Army of the Potomac occupied a compact position supported by massed artillery, while Robert E. Lee planned to suppress the Federal guns with artillery on two ridges and then attack. Misidentified roads, dispersed batteries, ammunition shortages, and an ambiguous attack order prevented the intended Confederate concentration. The full battle, covered in the following episode, ended in a United States victory"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"July 1, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Malvern Hill, an open plateau north of the James River in Henrico County, Virginia, about fifteen miles southeast of Richmond"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"This episode establishes the terrain, opposing deployments, and Confederate plan before the main artillery and infantry fighting. The Army of the Potomac occupied a compact position supported by massed artillery, while Robert E. Lee planned to suppress the Federal guns with artillery on two ridges and then attack. Misidentified roads, dispersed batteries, ammunition shortages, and an ambiguous attack order prevented the intended Confederate concentration. The full battle, covered in the following episode, ended in a United States victory"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":"$Lf"}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
