1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",148," · ","May 18–23, 1862"," · ","The Shenandoah and Luray valleys from Mount Solon and New Market to Front Royal, Virginia, with the battle extending north from the town across the South and North Forks of the Shenandoah River to Guard Hill and Cedarville"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: FRONT ROYAL & WINCHESTER (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Decisive Confederate victory at Front Royal. Jackson and Ewell crossed Massanutten Mountain, concentrated in the Luray Valley, and surprised John R. Kenly’s isolated United States garrison on May 23. Kenly delayed the first Confederate infantry on Richardson’s Hill, then withdrew across both river forks and made another stand on Guard Hill. Confederate cavalry overtook and broke the retreating column near Cedarville. The destruction of the garrison placed Jackson on Nathaniel Banks’s flank and threatened the Federal line from Strasburg to Winchester, but slow and poorly coordinated Confederate deployment consumed most of the day and prevented an earlier exploitation"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3780490121.mp3?updated=1695307545","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Confederate concentration and the Battle of Front Royal, May 18–23, 1862"}],["$","small",null,{"children":"The title also names Winchester, but this installment ends on the night of May 23. Banks’s retreat on May 24 and the First Battle of Winchester on May 25 belong to later episodes."}]]}],["$","div","Strategic purpose",{"children":[["$","span",null,{"children":"Strategic purpose"}],["$","strong",null,{"children":"Strike Banks before he could reinforce McDowell or McClellan"}],["$","small",null,{"children":"Jackson and Ewell first intended to unite near New Market and attack Strasburg. Their revised plan crossed Massanutten Mountain and attacked the exposed Federal post at Front Royal instead."}]]}],["$","div","Confederate command dispute",{"children":[["$","span",null,{"children":"Confederate command dispute"}],["$","strong",null,{"children":"Jackson temporarily suspended Johnston’s May 17 order recalling Ewell east"}],["$","small",null,{"children":"Jackson asked Robert E. Lee for immediate guidance. Joseph E. Johnston then authorized Jackson and Ewell to attack if they believed they could defeat Banks."}]]}],["$","div","Revised plan",{"children":[["$","span",null,{"children":"Revised plan"}],["$","strong",null,{"children":"Cross New Market Gap, join Ewell, and advance north through the Luray Valley"}],["$","small",null,{"children":"Taking Front Royal would turn Banks’s Strasburg position and place Confederate troops between Banks and Irvin McDowell’s command east of the Blue Ridge."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}],"$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c"]}]]}]
2d:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Confederate force condition",{"children":[["$","span",null,{"children":"Confederate force condition"}],["$","strong",null,{"children":"Exhausted by roughly 200 miles of marching in twenty days"}],["$","small",null,{"children":"The episode reports severe straggling, desertion, and supply problems. It says fewer than 5,000 of the 8,597 men Jackson claimed on May 3 remained present when his division entered the Luray Valley."}]]}]
f:["$","div","Combined Confederate strength",{"children":[["$","span",null,{"children":"Combined Confederate strength"}],["$","strong",null,{"children":"Probably about 12,000 effective in the episode’s estimate"}],["$","small",null,{"children":"The Confederate War Department expected about 18,000, and National Park Service accounts often use about 17,000 for Jackson’s combined command. Totals vary by date and by whether paper strength, present-for-duty strength, or only troops engaged at Front Royal are counted."}]]}]
10:["$","div","May 22 movement",{"children":[["$","span",null,{"children":"May 22 movement"}],["$","strong",null,{"children":"Seven infantry brigades, twenty cavalry companies, and forty-eight guns moved north"}],["$","small",null,{"children":"The episode calls this the largest force Jackson had yet commanded. At night the column’s camps stretched about fourteen miles along the road south of Front Royal."}]]}]
11:["$","div","Front Royal garrison",{"children":[["$","span",null,{"children":"Front Royal garrison"}],["$","strong",null,{"children":"About 1,000–1,100 United States troops under Col. John R. Kenly"}],["$","small",null,{"children":"The main body was the 1st Maryland Infantry, supported by two guns from Battery E, Pennsylvania Light Artillery, detachments of the 29th Pennsylvania, and two companies of the 5th New York Cavalry that arrived during the action."}]]}]
12:["$","div","Maryland against Maryland",{"children":[["$","span",null,{"children":"Maryland against Maryland"}],["$","strong",null,{"children":"Jackson ordered the Confederate 1st Maryland to lead against the United States 1st Maryland"}],["$","small",null,{"children":"Only about 200 men of Bradley T. Johnson’s regiment moved forward after a dispute over enlistment terms had left much of the regiment under arrest or unwilling to fight."}]]}]
13:["$","div","Morning halt",{"children":[["$","span",null,{"children":"Morning halt"}],["$","strong",null,{"children":"At least four and a half hours in the episode’s time-and-distance reconstruction"}],["$","small",null,{"children":"The courier had to ride to the rear of an approximately eleven-mile column; Johnson then addressed his men, and the regiment marched forward. The estimate is an inference rather than a recorded stopwatch time."}]]}]
14:["$","div","Reason for the halt",{"children":[["$","span",null,{"children":"Reason for the halt"}],["$","strong",null,{"children":"Unknown"}],["$","small",null,{"children":"The episode presents Gary Ecelbarger’s hypothesis that Jackson was waiting for engineer Keith Boswell or mapmaker Jedediah Hotchkiss to return. Boswell reached Jackson before the attack and worked on maps toward Winchester, but the surviving evidence does not prove that this caused the halt."}]]}]
15:["$","div","Belle Boyd’s warning",{"children":[["$","span",null,{"children":"Belle Boyd’s warning"}],["$","strong",null,{"children":"Dramatic but apparently not operationally new"}],["$","small",null,{"children":"Boyd ran to Jackson’s staff shortly before the attack and reported that the Federal force was small. Jackson’s local cavalry scouts had already identified the garrison, and his Confederate Marylanders were already at the head of the column."}]]}]
16:["$","div","Opening attack",{"children":[["$","span",null,{"children":"Opening attack"}],["$","strong",null,{"children":"Between about 2:00 and 2:30 p.m. on May 23"}],["$","small",null,{"children":"The Confederate 1st Maryland, Wheat’s Louisiana battalion, and a company of the 6th Virginia Cavalry quickly overran the small force in Front Royal itself."}]]}]
17:["$","div","Richardson’s Hill",{"children":[["$","span",null,{"children":"Richardson’s Hill"}],["$","strong",null,{"children":"Kenly held roughly 600 infantry and two rifled guns north of town for nearly two hours"}],["$","small",null,{"children":"From about 2:30 until 4:00 p.m., the first Confederate infantry opposite him numbered only about 450 in the episode’s accounting: roughly 200 Marylanders and 250 of Wheat’s battalion."}]]}]
18:["$","div","Taylor brigade uncertainty",{"children":[["$","span",null,{"children":"Taylor brigade uncertainty"}],["$","strong",null,{"children":"The locations of the 7th, 8th, and 9th Louisiana are not established from about 2:30 to 4:00 p.m."}],["$","small",null,{"children":"The episode states that surviving records do not account for most of these roughly 2,000 men during the critical early phase. Their absence from the first line is clear; their precise movements are not."}]]}]
19:["$","div","Confederate artillery failure",{"children":[["$","span",null,{"children":"Confederate artillery failure"}],["$","strong",null,{"children":"Only one effective rifled gun was in action during most of the Richardson’s Hill stand"}],["$","small",null,{"children":"Chief of artillery Stapleton Crutchfield brought batteries forward without knowing their armament. Two additional long-range pieces were not unlimbered until after 4:00 p.m., leaving Kenly’s two Parrott rifles largely unopposed."}]]}]
1a:["$","div","Confederate reinforcement",{"children":[["$","span",null,{"children":"Confederate reinforcement"}],["$","strong",null,{"children":"The 6th Louisiana attacked around 4:00 p.m.; the 8th Louisiana appeared as Kenly withdrew"}],["$","small",null,{"children":"The 8th Louisiana moved east, crossed the railroad bridge over the South Fork, and helped prevent destruction of the turnpike bridge across the North Fork."}]]}]
1b:["$","div","United States withdrawal",{"children":[["$","span",null,{"children":"United States withdrawal"}],["$","strong",null,{"children":"Richardson’s Hill to Guard Hill, then north toward Cedarville"}],["$","small",null,{"children":"Kenly began leaving Richardson’s Hill about 4:30 p.m., crossed both forks of the Shenandoah, and briefly formed again on Guard Hill before continuing up the Front Royal–Winchester Turnpike."}]]}]
1c:["$","div","Bridge fires",{"children":[["$","span",null,{"children":"Bridge fires"}],["$","strong",null,{"children":"Federal troops tried to burn both crossings; Confederates extinguished the fires"}],["$","small",null,{"children":"The damage delayed but did not stop pursuit. The North Fork bridge was partly damaged, and men crossed its surviving portion in restricted files."}]]}]
1d:["$","div","Cavalry pursuit",{"children":[["$","span",null,{"children":"Cavalry pursuit"}],["$","strong",null,{"children":"Seven companies of the 6th Virginia Cavalry pursued north"}],["$","small",null,{"children":"Four leading companies caught Kenly’s retreating column near Cedarville. Two charges by Thomas S. Flournoy’s cavalry broke the final roadblock and converted the retreat into a rout and mass surrender."}]]}]
1e:["$","div","United States casualties",{"children":[["$","span",null,{"children":"United States casualties"}],["$","strong",null,{"children":"Published totals conflict: roughly 770 to 904 killed, wounded, and captured"}],["$","small",null,{"children":"The detailed NPS article reports more than 690 captured and 82 killed or wounded. The NPS battle-detail database gives 904 total. The episode says all but about 100 of the roughly 800 men in the retreating column were killed, wounded, or captured; these figures measure different pools and should not be combined."}]]}]
1f:["$","div","Confederate casualties",{"children":[["$","span",null,{"children":"Confederate casualties"}],["$","strong",null,{"children":"26 in the episode’s pursuit account; 36 or 56 in NPS summaries"}],["$","small",null,{"children":"The transcript attaches 26 casualties to the cavalry action. The detailed NPS narrative gives 36 for the battle, while the NPS battle-detail database gives 56. No single total is presented here as uniquely settled."}]]}]
20:["$","div","Operational consequence",{"children":[["$","span",null,{"children":"Operational consequence"}],["$","strong",null,{"children":"Banks’s Strasburg position was turned"}],["$","small",null,{"children":"Front Royal’s fall threatened Banks’s railroad, road communications, and route north. He began preparing to withdraw toward Winchester that night."}]]}]
21:["$","div","Battlefield assessment",{"children":[["$","span",null,{"children":"Battlefield assessment"}],["$","strong",null,{"children":"Decisive result, inefficient execution"}],["$","small",null,{"children":"Jackson destroyed the isolated post and achieved surprise, but an hours-long morning halt, slow infantry deployment, poor artillery preparation, and weak coordination consumed daylight and delayed pressure on Banks."}]]}]
22:["$","div","Important leader losses",{"children":[["$","span",null,{"children":"Important leader losses"}],["$","strong",null,{"children":"No senior commander was killed or mortally wounded"}],["$","small",null,{"children":"Kenly was severely wounded during the final cavalry action and captured, but he survived the war. No comparable Confederate command loss occurred in the battle."}]]}]
23:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Ewell, Luray, Massanutten, Strasburg, Kenly, Ecelbarger, and Parrott rifles"}],["$","small",null,{"children":"The automated transcript repeatedly renders these as “Yule,” “LeRae,” “Massa Nutton,” “Strasbourg,” “Kinley,” “Ecklebarger,” and “parrot” guns. The guide uses standard historical spellings."}]]}]
24:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“Three Days in the Shenandoah: Stonewall Jackson at Front Royal and Winchester” by Gary Ecelbarger"}],"$undefined"]}]
25:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
26:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","May 21–23: the turning movement against Banks",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep148-front-royal-operation.svg","target":"_blank","rel":"noreferrer","aria-label":"Open May 21–23: the turning movement against Banks at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-front-royal-operation.svg","alt":"Schematic operational map showing Jackson crossing Massanutten Mountain, joining Ewell in the Luray Valley, and advancing north to Front Royal on Banks’s flank.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"May 21–23: the turning movement against Banks"}],["$","span",null,{"children":"Jackson crossed Massanutten Mountain through New Market Gap, joined Ewell in the Luray Valley, and marched north against Kenly at Front Royal while Banks’s main force remained west at Strasburg. Cavalry moved toward the Strasburg–Front Royal communications. This operational map is schematic: routes, force locations, distances, and terrain bands are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep148-front-royal-operation.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/articles/000/battle-of-front-royal.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","May 23: three stages of the Battle of Front Royal",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep148-front-royal-tactics.svg","target":"_blank","rel":"noreferrer","aria-label":"Open May 23: three stages of the Battle of Front Royal at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-front-royal-tactics.svg","alt":"Schematic tactical map of the Confederate attack at Front Royal, Kenly’s stands on Richardson’s and Guard Hills, the river crossings, and the cavalry pursuit to Cedarville.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"May 23: three stages of the Battle of Front Royal"}],["$","span",null,{"children":"The first Confederate infantry overran Front Royal, then confronted Kenly on Richardson’s Hill. Kenly withdrew across the South and North Forks to Guard Hill and continued north, where Flournoy’s cavalry broke the final roadblock near Cedarville. This is a schematic phase map, not a surveyed plot; river courses, unit positions, arrows, times, and spacing are simplified."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep148-front-royal-tactics.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/articles/000/battle-of-front-royal.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
27:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Shields has left the Valley",{"className":"moment","children":[["$","$L2d",null,{"seconds":150,"label":"2:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shields has left the Valley"}],["$","p",null,{"children":"The episode resumes with James Shields moving east toward Irvin McDowell while Jackson and Ewell seek to attack the reduced command Nathaniel Banks retained at Strasburg and Front Royal."}]]}]]}],["$","div","The original plan points toward Strasburg",{"className":"moment","children":[["$","$L2d",null,{"seconds":223,"label":"3:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"The original plan points toward Strasburg"}],["$","p",null,{"children":"Jackson and Ewell expected to unite between New Market and Mount Jackson on May 21, then move north on the Valley Turnpike against Banks."}]]}]]}],["$","div","Jackson’s men leave knapsacks behind",{"className":"moment","children":[["$","$L2d",null,{"seconds":254,"label":"4:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s men leave knapsacks behind"}],["$","p",null,{"children":"As the Valley Army passed Harrisonburg, the order to abandon knapsacks signaled that speed and combat, not a routine march, lay ahead."}]]}]]}],["$","div","Jackson reaches New Market",{"className":"moment","children":[["$","$L2d",null,{"seconds":275,"label":"4:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson reaches New Market"}],["$","p",null,{"children":"On May 20 the Valley force camped at the junction of the Valley Turnpike and the road east through New Market Gap into the Luray Valley."}]]}]]}],["$","div","Ewell receives a direct recall",{"className":"moment","children":[["$","$L2d",null,{"seconds":322,"label":"5:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell receives a direct recall"}],["$","p",null,{"children":"Joseph E. Johnston’s May 17 order required Ewell to leave the Valley and move toward Richmond, disrupting the generals’ arrangement to attack Banks."}]]}]]}],["$","div","Jackson appeals by telegraph",{"className":"moment","children":[["$","$L2d",null,{"seconds":372,"label":"6:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson appeals by telegraph"}],["$","p",null,{"children":"Jackson suspended Ewell’s departure and wired Robert E. Lee that an attack on Banks should be attempted, but that Johnston’s instruction prevented him from acting without immediate guidance."}]]}]]}],["$","div","Taylor’s Louisiana Brigade arrives",{"className":"moment","children":[["$","$L2d",null,{"seconds":423,"label":"7:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taylor’s Louisiana Brigade arrives"}],["$","p",null,{"children":"About 3,000 Louisianans marched in after a twenty-six-mile movement around the southern end of Massanutten. Their discipline, bands, uniforms, and dancing impressed Jackson’s tired Valley soldiers."}]]}]]}],["$","div","Richard Taylor is introduced",{"className":"moment","children":[["$","$L2d",null,{"seconds":499,"label":"8:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richard Taylor is introduced"}],["$","p",null,{"children":"The episode traces the thirty-six-year-old brigadier’s family connections, limited formal military background, strict discipline, and unexpected effectiveness as a field leader."}]]}]]}],["$","div","Taylor enforces discipline on the Tigers",{"className":"moment","children":[["$","$L2d",null,{"seconds":560,"label":"9:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taylor enforces discipline on the Tigers"}],["$","p",null,{"children":"After a failed attempt to free imprisoned comrades, two ringleaders were court-martialed and executed by a firing squad drawn from their own battalion."}]]}]]}],["$","div","Taylor meets Jackson",{"className":"moment","children":[["$","$L2d",null,{"seconds":667,"label":"11:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taylor meets Jackson"}],["$","p",null,{"children":"Jackson praised the Louisiana Brigade’s lack of stragglers, then disapproved of its dancing. Taylor replied that the men’s gaiety would not prevent them from doing serious work."}]]}]]}],"$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d"]}]]}]
28:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","National strategic direction",{"className":"command-entry","children":[["$","strong",null,{"children":"National strategic direction"}],["$","span",null,{"children":"President Abraham Lincoln / Secretary Edwin M. Stanton"}],["$","small",null,{"children":"Had detached Shields toward McDowell and left Banks to guard the Shenandoah Valley with a reduced force"}]]}],["$","div","Department of the Shenandoah",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Shenandoah"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Held the main United States force around Strasburg while maintaining smaller posts at Front Royal and Buckton Station"}]]}],["$","div","Infantry division near Strasburg",{"className":"command-entry","children":[["$","strong",null,{"children":"Infantry division near Strasburg"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"About 4,500 infantry in the episode’s estimate; remained with Banks while Kenly fought at Front Royal"}]]}],["$","div","Front Royal garrison; 1st Maryland Infantry",{"className":"command-entry","children":[["$","strong",null,{"children":"Front Royal garrison; 1st Maryland Infantry"}],["$","span",null,{"children":"Col. John R. Kenly"}],["$","small",null,{"children":"About 1,000–1,100 total with attached infantry, artillery, and cavalry; directed the defenses on Richardson’s Hill, Guard Hill, and the road toward Cedarville"}]]}],["$","div","Section, Battery E, Pennsylvania Light Artillery",{"className":"command-entry","children":[["$","strong",null,{"children":"Section, Battery E, Pennsylvania Light Artillery"}],["$","span",null,{"children":"Lt. Charles A. Atwell"}],["$","small",null,{"children":"Two Parrott rifles that supported Kenly’s successive defensive positions"}]]}],["$","div","Bridge guards and cavalry reinforcement",{"className":"command-entry","children":[["$","strong",null,{"children":"Bridge guards and cavalry reinforcement"}],["$","span",null,{"children":"Detached United States troops"}],["$","small",null,{"children":"Companies B and G, 29th Pennsylvania Infantry, and two companies of the 5th New York Cavalry joined the retreating garrison during the battle"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Senior Confederate field authority",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior Confederate field authority"}],["$","span",null,{"children":"Gen. Joseph E. Johnston"}],["$","small",null,{"children":"Initially ordered Ewell east, then authorized Jackson and Ewell to attack Banks if they could defeat him"}]]}],["$","div","Overall commander, combined Valley force",{"className":"command-entry","children":[["$","strong",null,{"children":"Overall commander, combined Valley force"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Revised the plan toward Front Royal, directed the approach and battle, and controlled Jackson’s division, Ewell’s division, cavalry, and artillery"}]]}],["$","div","Division commander under Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander under Jackson"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Brought Taylor’s, Trimble’s, and Elzey’s brigades into the concentration; Taylor’s brigade supplied most of the infantry used at Front Royal"}]]}],["$","div","Louisiana Brigade, Ewell’s division",{"className":"command-entry","children":["$L4e","$L4f","$L50"]}],"$L51","$L52","$L53","$L54","$L55"]]}]]}],"$L56","$L57"]}]
29:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. John R. Kenly",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. John R. Kenly"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Front Royal garrison and 1st Maryland Infantry","."]}]," ","Severely wounded during the final cavalry action near Cedarville and captured; he survived and later returned to duty. No senior commander on either side was killed or mortally wounded at Front Royal."]}]]}]]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep148-front-royal-forbes.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-front-royal-forbes.jpg","alt":"Edwin Forbes pencil drawing of United States troops under Nathaniel Banks entering Front Royal on May 20, 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Edwin Forbes drew Banks’s troops entering Front Royal on May 20, three days before Jackson attacked the isolated post. The contemporary drawing is a scene of occupation, not an image of the battle itself."}]]}],["$","figure","/images/ep148-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-stonewall-jackson.jpg","alt":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson achieved the operational surprise he sought by crossing Massanutten and approaching Front Royal through the Luray Valley, but his battlefield deployment consumed most of May 23."}]]}],["$","figure","/images/ep148-richard-ewell.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-richard-ewell.jpg","alt":"Wartime photographic portrait of Confederate general Richard S. Ewell in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Ewell remained in the Valley after Johnston revised his orders. His division supplied Taylor’s Louisiana Brigade and much of the force used at Front Royal."}]]}],["$","figure","/images/ep148-richard-taylor.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-richard-taylor.jpg","alt":"Civil War-era photographic portrait of Confederate general Richard Taylor in civilian dress.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Taylor’s well-drilled Louisiana Brigade led the May 23 column. Wheat’s battalion and the 6th and 8th Louisiana fought at Front Royal, while the other regiments’ early-afternoon locations remain uncertain."}]]}],["$","figure","/images/ep148-belle-boyd.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-belle-boyd.jpg","alt":"Civil War-era photographic portrait of Confederate courier and spy Belle Boyd.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Boyd’s run to Jackson’s staff became a celebrated episode of the battle. Her warning was consistent with what Confederate scouts had already learned about Kenly’s small garrison."}]]}],["$","figure","/images/ep148-nathaniel-banks.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-nathaniel-banks.jpg","alt":"Civil War-era photographic portrait of United States general Nathaniel P. Banks in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Banks’s main force remained at Strasburg while Kenly fought twelve miles away. Front Royal’s loss threatened the route north and forced a decision about retreat."}]]}],["$","figure","/images/ep148-front-royal-operation.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-front-royal-operation.svg","alt":"Schematic map of Jackson’s movement across Massanutten Mountain and north to Front Royal.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The operational schematic shows how the move through New Market Gap placed Jackson east of Banks and enabled a strike at the separated Front Royal garrison."}]]}],"$L58"]}]]}]
2b:["$","details",null,{"className":"reference-sources","children":[["$","summary",null,{"children":"Sources and image credits"}],["$","ul",null,{"children":[["$","li","https://civilwarpodcast.org/2016/04/03/civil-war-podcast-episode-148/",{"children":["$","a",null,{"href":"https://civilwarpodcast.org/2016/04/03/civil-war-podcast-episode-148/","target":"_blank","rel":"noreferrer","children":["Official Civil War Podcast episode 148 page"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/articles/000/battle-of-front-royal.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/articles/000/battle-of-front-royal.htm","target":"_blank","rel":"noreferrer","children":["National Park Service: Battle of Front Royal"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va103",{"children":["$","a",null,{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va103","target":"_blank","rel":"noreferrer","children":["National Park Service: Front Royal battle detail"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm","target":"_blank","rel":"noreferrer","children":["National Park Service: Jackson’s 1862 Shenandoah Valley Campaign"," ",["$","$Ld",null,{"ref":"$u