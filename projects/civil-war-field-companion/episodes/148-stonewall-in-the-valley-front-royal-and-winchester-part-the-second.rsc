2c:["$","div","Overall commander, combined Valley force-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Overall commander, combined Valley force"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Revised the plan toward Front Royal, directed the approach and battle, and controlled Jackson’s division, Ewell’s division, cavalry, and artillery"}]]}]
2d:["$","div","Division commander under Jackson-Maj. Gen. Richard S. Ewell",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander under Jackson"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Brought Taylor’s, Trimble’s, and Elzey’s brigades into the concentration; Taylor’s brigade supplied most of the infantry used at Front Royal"}]]}]
2e:["$","div","Louisiana Brigade, Ewell’s division-Brig. Gen. Richard Taylor",{"className":"command-entry","children":[["$","strong",null,{"children":"Louisiana Brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Richard Taylor"}],["$","small",null,{"children":"6th, 7th, 8th, and 9th Louisiana Infantry and Wheat’s 1st Special Battalion; only parts of the brigade reached the firing line in time to influence the battle"}]]}]
2f:["$","div","1st Maryland Infantry, Confederate States-Col. Bradley T. Johnson",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Maryland Infantry, Confederate States"}],["$","span",null,{"children":"Col. Bradley T. Johnson"}],["$","small",null,{"children":"Rallied about 200 men and led the opening infantry advance against Kenly’s United States 1st Maryland"}]]}]
30:["$","div","1st Special Battalion, Louisiana Infantry-Maj. Chatham Roberdeau Wheat",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Special Battalion, Louisiana Infantry"}],["$","span",null,{"children":"Maj. Chatham Roberdeau Wheat"}],["$","small",null,{"children":"About 250 “Louisiana Tigers” in the episode’s estimate; advanced through Front Royal and held below Richardson’s Hill until reinforced"}]]}]
31:["$","div","Chief of artillery-Col. Stapleton Crutchfield",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief of artillery"}],["$","span",null,{"children":"Col. Stapleton Crutchfield"}],["$","small",null,{"children":"Selected the initial artillery height but failed to bring an effective concentration of rifled guns into action promptly"}]]}]
32:["$","div","6th Virginia Cavalry pursuit force-Lt. Col. Thomas S. Flournoy",{"className":"command-entry","children":[["$","strong",null,{"children":"6th Virginia Cavalry pursuit force"}],["$","span",null,{"children":"Lt. Col. Thomas S. Flournoy"}],["$","small",null,{"children":"Seven companies pursued Kenly; the four leading companies broke the final United States position near Cedarville"}]]}]
33:["$","div","Engineering and topographical staff-Lt. Keith Boswell / Jedediah Hotchkiss",{"className":"command-entry","children":[["$","strong",null,{"children":"Engineering and topographical staff"}],["$","span",null,{"children":"Lt. Keith Boswell / Jedediah Hotchkiss"}],["$","small",null,{"children":"Recalled from reconnaissance toward Strasburg; Boswell returned before the attack, mapped the route toward Winchester, and sought a closer artillery position"}]]}]
34:["$","section",null,{"className":"other-people","aria-label":"Other people","children":[["$","h3",null,{"className":"subsection-title","children":"Other people"}],"$undefined",["$","ul",null,{"className":"other-people-list","children":[["$","li","Thomas J. “Stonewall” Jackson",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-stonewall-jackson.jpg","alt":"Portrait of Thomas J. “Stonewall” Jackson","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h4",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Overall Confederate commander who kept Ewell in the Valley, shifted the target from Strasburg to Front Royal, and directed the May 23 attack"}]]}]]}]}],["$","li","Richard S. Ewell",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-richard-ewell.jpg","alt":"Portrait of Richard S. Ewell","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h4",null,{"children":"Richard S. Ewell"}],["$","p",null,{"children":"Division commander whose recall order was suspended; he joined Jackson in the Luray Valley and operated under Jackson during the advance"}]]}]]}]}],["$","li","Nathaniel P. Banks",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-nathaniel-banks.jpg","alt":"Portrait of Nathaniel P. Banks","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h4",null,{"children":"Nathaniel P. Banks"}],["$","p",null,{"children":"Department commander at Strasburg whose eastern post was destroyed and whose road and railroad communications were threatened"}]]}]]}]}],["$","li","Richard Taylor",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-richard-taylor.jpg","alt":"Portrait of Richard Taylor","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h4",null,{"children":"Richard Taylor"}],["$","p",null,{"children":"Louisiana brigade commander praised for discipline and marching ability; parts of his brigade conducted the infantry attack at Front Royal"}]]}]]}]}],["$","li","Isabella Maria “Belle” Boyd",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-belle-boyd.jpg","alt":"Portrait of Isabella Maria “Belle” Boyd","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h4",null,{"children":"Isabella Maria “Belle” Boyd"}],["$","p",null,{"children":"Front Royal resident and Confederate courier who ran to Jackson’s staff with a warning that the Federal garrison was small"}]]}]]}]}],["$","li","John R. Kenly",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","div",null,{"className":"portrait-placeholder","aria-label":"No portrait available for John R. Kenly","children":["$","span",null,{"children":"JR"}]}],["$","div",null,{"classNam