66:["$","article","Charles A. Atwell",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"CA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Charles A. Atwell"}],["$","p",null,{"children":"United States artillery lieutenant whose two Parrott rifles supported Kenly on Richardson’s Hill and Guard Hill"}]]}]]}]
67:["$","article","Keith Boswell",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"KB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Keith Boswell"}],["$","p",null,{"children":"Jackson’s engineering officer who returned before the attack, prepared maps toward Winchester, and found a closer artillery position"}]]}]]}]
68:["$","article","Jedediah Hotchkiss",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Jedediah Hotchkiss"}],["$","p",null,{"children":"Topographical engineer recalled from reconnaissance toward Strasburg; the uncertainty over his and Boswell’s return figures in the episode’s explanation of the morning halt"}]]}]]}]
69:["$","article","Joseph E. Johnston",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Joseph E. Johnston"}],["$","p",null,{"children":"Senior Confederate commander who first recalled Ewell and then authorized an attack on Banks if Jackson and Ewell judged it practicable"}]]}]]}]
6a:["$","article","Robert E. Lee",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"RE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Robert E. Lee"}],["$","p",null,{"children":"Confederate military adviser who communicated with Jackson by telegraph and supported action that would keep Banks from reinforcing eastern Virginia"}]]}]]}]
