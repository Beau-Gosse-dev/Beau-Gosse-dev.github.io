,{"href":"https://ehistory.osu.edu/books/official-records/018","target":"_blank","rel":"noreferrer","children":["Primary correspondence collection: Official Records, Series I, Volume XII, Part III"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://ehistory.osu.edu/books/official-records/atlas_11",{"children":["$","a",null,{"href":"https://ehistory.osu.edu/books/official-records/atlas_11","target":"_blank","rel":"noreferrer","children":["Official Records Atlas index: Front Royal map, Plate 5, map 5"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.shenandoahatwar.org/battle-of-front-royal",{"children":["$","a",null,{"href":"https://www.shenandoahatwar.org/battle-of-front-royal","target":"_blank","rel":"noreferrer","children":["Shenandoah Valley Battlefields National Historic District: Battle of Front Royal"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],"$L59","$L5a","$L5b","$L5c","$L5d","$L5e","$L5f","$L60","$L61"]}]]}]
2c:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
2e:["$","div","Johnston permits the attack",{"className":"moment","children":[["$","$L2d",null,{"seconds":825,"label":"13:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston permits the attack"}],["$","p",null,{"children":"A courier brought word that Jackson and Ewell could strike Banks if they judged conditions favorable, resolving the immediate command conflict."}]]}]]}]
2f:["$","div","The generals revise the plan",{"className":"moment","children":[["$","$L2d",null,{"seconds":859,"label":"14:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The generals revise the plan"}],["$","p",null,{"children":"Instead of Ewell crossing west for a direct attack on Strasburg, Jackson would cross east, join Ewell in the Luray Valley, and attack Front Royal."}]]}]]}]
30:["$","div","Johnston gives explicit confirmation",{"className":"moment","children":[["$","$L2d",null,{"seconds":925,"label":"15:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston gives explicit confirmation"}],["$","p",null,{"children":"A second message stated that if Jackson and Ewell united could defeat Banks, they should do so."}]]}]]}]
31:["$","div","The soldiers describe exhaustion",{"className":"moment","children":[["$","$L2d",null,{"seconds":975,"label":"16:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The soldiers describe exhaustion"}],["$","p",null,{"children":"Letters and diaries report near-continuous marching, little restorative sleep, and orders to rise at 2:30 a.m. after weeks of movement and fighting."}]]}]]}]
32:["$","div","The foot cavalry has marched about 200 miles",{"className":"moment","children":[["$","$L2d",null,{"seconds":1020,"label":"17:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The foot cavalry has marched about 200 miles"}],["$","p",null,{"children":"The episode calculates that Jackson’s infantry covered roughly 200 miles between May 3 and May 22, sharply reducing the number still present in the ranks."}]]}]]}]
33:["$","div","The Stonewall Brigade’s paper strength collapses",{"className":"moment","children":[["$","$L2d",null,{"seconds":1052,"label":"17:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Stonewall Brigade’s paper strength collapses"}],["$","p",null,{"children":"Jackson claimed 3,681 men in the brigade on May 3, but fewer than 1,600 were present twenty days later; the episode attributes the decline primarily to desertion and straggling."}]]}]]}]
34:["$","div","Paper strength and effective strength diverge",{"className":"moment","children":[["$","$L2d",null,{"seconds":1155,"label":"19:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Paper strength and effective strength diverge"}],["$","p",null,{"children":"Richmond expected approximately 18,000 men, while the episode judges that no more than 14,000 and probably closer to 12,000 were effective when Jackson and Ewell moved against Banks."}]]}]]}]
35:["$","div","Jackson crosses Massanutten",{"className":"moment","children":[["$","$L2d",null,{"seconds":1215,"label":"20:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson crosses Massanutten"}],["$","p",null,{"children":"The Valley force moved through New Market Gap, crossed the South Fork near Luray, and joined Ewell in the Luray Valley."}]]}]]}]
36:["$","div","The combined army starts north",{"className":"moment","children":[["$","$L2d",null,{"seconds":1228,"label":"20:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The combined army starts north"}],["$","p",null,{"children":"Early on May 22, seven infantry brigades, twenty cavalry companies, and forty-eight guns moved north under Jackson’s overall command."}]]}]]}]
37:["$","div","The column camps along fourteen miles of road",{"className":"moment","children":[["$","$L2d",null,{"seconds":1263,"label":"21:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The column camps along fourteen miles of road"}],["$","p",null,{"children":"Ewell’s lead brigade stopped about ten miles from Front Royal, while Jackson’s worn Stonewall Brigade remained far to the rear near Luray."}]]}]]}]
38:["$","div","Taylor takes the point on May 23",{"className":"moment","children":[["$","$L2d",null,{"seconds":1305,"label":"21:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taylor takes the point on May 23"}],["$","p",null,{"children":"Taylor’s brigade led the renewed march. Bradley Johnson’s Confederate 1st Maryland marked time until the rest of the long column passed it."}]]}]]}]
39:["$","div","Jackson orders the 1st Maryland forward",{"className":"moment","children":[["$","$L2d",null,{"seconds":1373,"label":"22:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson orders the 1st Maryland forward"}],["$","p",null,{"children":"At about 8 a.m. a courier carried Jackson’s order to the rear: Johnson’s regiment was to move to the front and attack the Federal garrison."}]]}]]}]
3a:["$","div","Johnson rallies about 200 Marylanders",{"className":"moment","children":[["$","$L2d",null,{"seconds":1403,"label":"23:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnson rallies about 200 Marylanders"}],["$","p",null,{"children":"A speech persuaded part of the near-mutinous regiment to take up arms. Those men then hurried toward the head of the column."}]]}]]}]
3b:["$","div","The halt consumes at least four and a half hours",{"className":"moment","children":[["$","$L2d",null,{"seconds":1457,"label":"24:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The halt consumes at least four and a half hours"}],["$","p",null,{"children":"The episode combines the courier’s ride, Johnson’s speech and preparation, and the regiment’s approximately eleven-mile march to explain why the attack began in mid-afternoon."}]]}]]}]
3c:["$","div","The reason for Jackson’s halt remains uncertain",{"className":"moment","children":[["$","$L2d",null,{"seconds":1565,"label":"26:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"The reason for Jackson’s halt remains uncertain"}],["$","p",null,{"children":"Gary Ecelbarger suggests Jackson may have waited for Keith Boswell or Jedediah Hotchkiss to return, but the episode makes clear that the surviving evidence does not settle the question."}]]}]]}]
3d:["$","div","Boswell reaches the army",{"className":"moment","children":[["$","$L2d",null,{"seconds":1621,"label":"27:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Boswell reaches the army"}],["$","p",null,{"children":"Jackson’s engineer arrived about an hour before the attack and then prepared maps of the country between Front Royal and Winchester for Jackson and Ewell."}]]}]]}]
3e:["$","div","The army takes the Gooney Manor Road",{"className":"moment","children":[["$","$L2d",null,{"seconds":1689,"label":"28:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army takes the Gooney Manor Road"}],["$","p",null,{"children":"Jackson shifted the column onto a country lane and then the graded road along Dickey Ridge, approaching Front Royal from the south."}]]}]]}]
3f:["$","div","Belle Boyd runs to the Confederates",{"className":"moment","children":[["$","$L2d",null,{"seconds":1708,"label":"28:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Belle Boyd runs to the Confederates"}],["$","p",null,{"children":"Boyd warned staff officers that the Federal force was small. The episode concludes that cavalry scouts had already supplied the relevant intelligence."}]]}]]}]
40:["$","div","The attack enters Front Royal",{"className":"moment","children":[["$","$L2d",null,{"seconds":1782,"label":"29:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack enters Front Royal"}],["$","p",null,{"children":"Between about 2:00 and 2:30 p.m., the Confederate 1st Maryland, Wheat’s battalion, and a company of cavalry overwhelmed the small detachment in town."}]]}]]}]
41:["$","div","Kenly stands on Richardson’s Hill",{"className":"moment","children":[["$","$L2d",null,{"seconds":1819,"label":"30:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kenly stands on Richardson’s Hill"}],["$","p",null,{"children":"With about 600 infantry and two rifled guns, Kenly held the height north of town for nearly two hours despite the much larger Confederate army nearby."}]]}]]}]
42:["$","div","Most of Taylor’s brigade is unaccounted for",{"className":"moment","children":[["$","$L2d",null,{"seconds":1887,"label":"31:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Most of Taylor’s brigade is unaccounted for"}],["$","p",null,{"children":"The episode finds no clear record of the 7th, 8th, and 9th Louisiana from roughly 2:30 to 4:00 p.m., leaving only the Marylanders and Wheat’s battalion opposite Kenly early on."}]]}]]}]
43:["$","div","Confederate artillery arrives unprepared",{"className":"moment","children":[["$","$L2d",null,{"seconds":1915,"label":"31:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate artillery arrives unprepared"}],["$","p",null,{"children":"Crutchfield’s first batteries yielded only three useful long-range guns, and just one was brought into action during the first hour."}]]}]]}]
44:["$","div","Jackson demands every rifled gun and brigade",{"className":"moment","children":[["$","$L2d",null,{"seconds":2008,"label":"33:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson demands every rifled gun and brigade"}],["$","p",null,{"children":"Frustrated by the slow deployment, Jackson called for all available rifled artillery and infantry to be brought forward."}]]}]]}]
45:["$","div","The 6th Louisiana climbs Richardson’s Hill",{"className":"moment","children":[["$","$L2d",null,{"seconds":2027,"label":"33:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 6th Louisiana climbs Richardson’s Hill"}],["$","p",null,{"children":"The regiment entered the action around 4 p.m. Boswell found a closer artillery position, but Kenly withdrew before guns could use it."}]]}]]}]
46:["$","div","Kenly begins a fighting withdrawal",{"className":"moment","children":[["$","$L2d",null,{"seconds":2056,"label":"34:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kenly begins a fighting withdrawal"}],["$","p",null,{"children":"At about 4:30 p.m. the United States line left Richardson’s Hill and moved toward the two river crossings north of town."}]]}]]}]
47:["$","div","The 8th Louisiana moves around the flank",{"className":"moment","children":[["$","$L2d",null,{"seconds":2062,"label":"34:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 8th Louisiana moves around the flank"}],["$","p",null,{"children":"The regiment crossed the railroad bridge over the South Fork and helped extinguish fires at the turnpike bridge across the North Fork."}]]}]]}]
48:["$","div","Kenly briefly forms on Guard Hill",{"className":"moment","children":[["$","$L2d",null,{"seconds":2077,"label":"34:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kenly briefly forms on Guard Hill"}],["$","p",null,{"children":"After crossing both river branches, he redeployed his two guns on Guard Hill but abandoned the position by about 5 p.m. and continued north."}]]}]]}]
49:["$","div","Flournoy’s cavalry takes up the pursuit",{"className":"moment","children":[["$","$L2d",null,{"seconds":2124,"label":"35:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Flournoy’s cavalry takes up the pursuit"}],["$","p",null,{"children":"Seven companies of the 6th Virginia Cavalry followed Kenly. Four leading companies caught the retreating column near Cedarville and broke it in a short, violent action."}]]}]]}]
4a:["$","div","The victory has consumed the day",{"className":"moment","children":[["$","$L2d",null,{"seconds":2177,"label":"36:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The victory has consumed the day"}],["$","p",null,{"children":"Most of Kenly’s surviving men did not surrender until after 6:30 p.m. The sun set soon afterward, limiting Jackson’s opportunity to move immediately into Banks’s rear."}]]}]]}]
4b:["$","div","Jackson closes around Front Royal",{"className":"moment","children":[["$","$L2d",null,{"seconds":2253,"label":"37:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson closes around Front Royal"}],["$","p",null,{"children":"By May 24 the episode estimates about 12,000 Confederates within six miles of town, while Banks held roughly 6,000 men around Strasburg twelve miles west."}]]}]]}]
4c:["$","div","Operational skill and tactical weakness are separated",{"className":"moment","children":[["$","$L2d",null,{"seconds":2287,"label":"38:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Operational skill and tactical weakness are separated"}],["$","p",null,{"children":"The hosts credit Jackson with placing the army where it could win but fault the battle’s execution: unclear instructions, missing infantry, and poorly prepared artillery turned a favorable situation into a four-hour fight."}]]}]]}]
4d:["$","div","The episode recommends Ecelbarger’s study",{"className":"moment","children":[["$","$L2d",null,{"seconds":2373,"label":"39:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode recommends Ecelbarger’s study"}],["$","p",null,{"children":"The book recommendation is Gary Ecelbarger’s “Three Days in the Shenandoah: Stonewall Jackson at Front Royal and Winchester.”"}]]}]]}]
4e:["$","strong",null,{"children":"Louisiana Brigade, Ewell’s division"}]
4f:["$","span",null,{"children":"Brig. Gen. Richard Taylor"}]
50:["$","small",null,{"children":"6th, 7th, 8th, and 9th Louisiana Infantry and Wheat’s 1st Special Battalion; only parts of the brigade reached the firing line in time to influence the battle"}]
51:["$","div","1st Maryland Infantry, Confederate States",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Maryland Infantry, Confederate States"}],["$","span",null,{"children":"Col. Bradley T. Johnson"}],["$","small",null,{"children":"Rallied about 200 men and led the opening infantry advance against Kenly’s United States 1st Maryland"}]]}]
52:["$","div","1st Special Battalion, Louisiana Infantry",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Special Battalion, Louisiana Infantry"}],["$","span",null,{"children":"Maj. Chatham Roberdeau Wheat"}],["$","small",null,{"children":"About 250 “Louisiana Tigers” in the episode’s estimate; advanced through Front Royal and held below Richardson’s Hill until reinforced"}]]}]
53:["$","div","Chief of artillery",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief of artillery"}],["$","span",null,{"children":"Col. Stapleton Crutchfield"}],["$","small",null,{"children":"Selected the initial artillery height but failed to bring an effective concentration of rifled guns into action promptly"}]]}]
54:["$","div","6th Virginia Cavalry pursuit force",{"className":"command-entry","children":[["$","strong",null,{"children":"6th Virginia Cavalry pursuit force"}],["$","span",null,{"children":"Lt. Col. Thomas S. Flournoy"}],["$","small",null,{"children":"Seven companies pursued Kenly; the four leading companies broke the final United States position near Cedarville"}]]}]
55:["$","div","Engineering and topographical staff",{"className":"command-entry","children":[["$","strong",null,{"children":"Engineering and topographical staff"}],["$","span",null,{"children":"Lt. Keith Boswell / Jedediah Hotchkiss"}],["$","small",null,{"children":"Recalled from reconnaissance toward Strasburg; Boswell returned before the attack, mapped the route toward Winchester, and sought a closer artillery position"}]]}]
56:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
57:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Thomas J. “Stonewall” Jackson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-stonewall-jackson.jpg","alt":"Portrait of Thomas J. “Stonewall” Jackson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Overall Confederate commander who kept Ewell in the Valley, shifted the target from Strasburg to Front Royal, and directed the May 23 attack"}]]}]]}],["$","article","Richard S. Ewell",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-richard-ewell.jpg","alt":"Portrait of Richard S. Ewell","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Richard S. Ewell"}],["$","p",null,{"children":"Division commander whose recall order was suspended; he joined Jackson in the Luray Valley and operated under Jackson during the advance"}]]}]]}],["$","article","Nathaniel P. Banks",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-nathaniel-banks.jpg","alt":"Portrait of Nathaniel P. Banks","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Nathaniel P. Banks"}],["$","p",null,{"children":"Department commander at Strasburg whose eastern post was destroyed and whose road and railroad communications were threatened"}]]}]]}],["$","article","Richard Taylor",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-richard-taylor.jpg","alt":"Portrait of Richard Taylor","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Richard Taylor"}],["$","p",null,{"children":"Louisiana brigade commander praised for discipline and marching ability; parts of his brigade conducted the infantry attack at Front Royal"}]]}]]}],["$","article","Isabella Maria “Belle” Boyd",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep148-belle-boyd.jpg","alt":"Portrait of Isabella Maria “Belle” Boyd","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Isabella Maria “Belle” Boyd"}],["$","p",null,{"children":"Front Royal resident and Confederate courier who ran to Jackson’s staff with a warning that the Federal garrison was small"}]]}]]}],["$","article","John R. Kenly",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JR"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John R. Kenly"}],["$","p",null,{"children":"United States colonel who commanded the Front Royal garrison, held successive positions north of town, and was wounded and captured in the final cavalry action"}]]}]]}],["$","article","Bradley T. Johnson",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"BT"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Bradley T. Johnson"}],["$","p",null,{"children":"Confederate colonel who rallied about 200 men of the 1st Maryland and led them against the United States regiment of the same designation"}]]}]]}],["$","article","Chatham Roberdeau Wheat",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"CR"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],"$L62","$L63"]}]]}],"$L64","$L65","$L66","$L67","$L68","$L69","$L6a","$L6b"]}]
