d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",207," · ","July 31–August 25, 1862"," · ","Chattanooga and Knoxville in Tennessee; Cumberland Gap, Rogers Gap, Barbourville, London, Big Hill, Richmond, Lexington, and the Kentucky River line in Kentucky"]}],["$","h1",null,{"children":"\"KENTUCKY'S SIREN SONG OF GLORY\""}],["$","span",null,{"className":"result-label","children":"Edmund Kirby Smith abandoned the preliminary reduction of Cumberland Gap and led the newly styled Confederate Army of Kentucky north from Knoxville. By bypassing the gap, detaching Carter Stevenson to contain George W. Morgan, and advancing through Barbourville and London, Smith cut the United States garrison’s communications and opened the Old State Road toward Richmond and Lexington. The Confederate movement forced a hurried United States reorganization in Kentucky, but John Hunt Morgan’s promise of mass recruiting proved false in the mountain counties. At the episode’s end Smith had resumed his advance with Patrick Cleburne and Thomas Churchill while Henry Heth remained near Barbourville and Stevenson watched Cumberland Gap"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"July 31–August 25, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Chattanooga and Knoxville in Tennessee; Cumberland Gap, Rogers Gap, Barbourville, London, Big Hill, Richmond, Lexington, and the Kentucky River line in Kentucky"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Edmund Kirby Smith abandoned the preliminary reduction of Cumberland Gap and led the newly styled Confederate Army of Kentucky north from Knoxville. By bypassing the gap, detaching Carter Stevenson to contain George W. Morgan, and advancing through Barbourville and London, Smith cut the United States garrison’s communications and opened the Old State Road toward Richmond and Lexington. The Confederate movement forced a hurried United States reorganization in Kentucky, but John Hunt Morgan’s promise of mass recruiting proved false in the mountain counties. At the episode’s end Smith had resumed his advance with Patrick Cleburne and Thomas Churchill while Henry Heth remained near Barbourville and Stevenson watched Cumberland Gap"}]]}]]}],false,"$Lf","$undefined"]}],"$L10","$L11","$L12",false,"$L13",false,"$L14","$L15","$L16","$L17"]}]]}]
