f:["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Cumberland Gap garrison",{"children":[["$","th",null,{"scope":"row","children":"Cumberland Gap garrison"}],["$","td",null,{"children":["About 9,000 United States troops under George W. Morgan",["$","small",null,{"style":{"display":"block"},"children":"The position was supplied well enough to resist a quick reduction. A prolonged siege would have destroyed the speed on which the proposed Nashville operation depended."}]]}]]}],["$","tr","First Division",{"children":[["$","th",null,{"scope":"row","children":"First Division"}],["$","td",null,{"children":["Brig. Gen. Carter L. Stevenson; roughly 9,000 men",["$","small",null,{"style":{"display":"block"},"children":"The largest division was detached to approach and contain the United States garrison at Cumberland Gap."}]]}]]}],["$","tr","Second Division",{"children":[["$","th",null,{"scope":"row","children":"Second Division"}],["$","td",null,{"children":["Brig. Gen. Henry Heth; roughly 6,000 men",["$","small",null,{"style":{"display":"block"},"children":"The automated transcript renders Heth as “Heath.” His division remained near Barbourville when Smith resumed the advance on August 25."}]]}]]}],["$","tr","Third Division",{"children":[["$","th",null,{"scope":"row","children":"Third Division"}],["$","td",null,{"children":["Brig. Gen. Thomas J. Churchill; roughly 3,000 men",["$","small",null,{"style":{"display":"block"},"children":"Churchill temporarily commanded in place of Maj. Gen. John P. McCown, who stayed in Knoxville with responsibility for East Tennessee during Smith’s absence."}]]}]]}],["$","tr","Fourth Division",{"children":[["$","th",null,{"scope":"row","children":"Fourth Division"}],["$","td",null,{"children":["Brig. Gen. Patrick R. Cleburne; roughly 3,000 men",["$","small",null,{"style":{"display":"block"},"children":"The command consisted of two brigades lent by Bragg. The automated transcript renders Cleburne as “Claiborne.”"}]]}]]}],["$","tr","Cavalry",{"children":[["$","th",null,{"scope":"row","children":"Cavalry"}],["$","td",null,{"children":["Col. John S. Scott; roughly 1,000 men",["$","small",null,{"style":{"display":"block"},"children":"Scott screened the advance, ranged north along the Old State Road, and reported that the road toward Lexington appeared open."}]]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/category/1862/page/5/",{"href":"https://civilwarpodcast.org/category/1862/page/5/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast page containing episode 207"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-7.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-7.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Civil War in the Western Theater, 1862"]}],["$","a","https://www.armyupress.army.mil/Portals/7/educational-services/staff-rides/StaffRideHB_Perryville.pdf",{"href":"https://www.armyupress.army.mil/Portals/7/educational-services/staff-rides/StaffRideHB_Perryville.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army staff ride handbook for the Perryville Campaign"]}],["$","a","https://www.nps.gov/cuga/civil-war-at-cumberland-gap.htm",{"href":"https://www.nps.gov/cuga/civil-war-at-cumberland-gap.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Civil War at Cumberland Gap"]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}]]}]
