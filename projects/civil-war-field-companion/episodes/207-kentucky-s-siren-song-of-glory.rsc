24:["$","section","United States command in Kentucky",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States command in Kentucky"}],[["$","div","General in chief-Maj. Gen. Henry W. Halleck",{"className":"command-entry","children":[["$","strong",null,{"children":"General in chief"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Responded to the invasion by reorganizing authority in the Department of the Ohio under Horatio Wright"}]]}],["$","div","Department of the Ohio-Maj. Gen. Horatio G. Wright",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Ohio"}],["$","span",null,{"children":"Maj. Gen. Horatio G. Wright"}],["$","small",null,{"children":"Supervised the emergency reinforcement of Kentucky while disputing strategy and authority with William Nelson"}]]}],["$","div","Military command in Kentucky-Brig. Gen. Jeremiah T. Boyle",{"className":"command-entry","children":[["$","strong",null,{"children":"Military command in Kentucky"}],["$","span",null,{"children":"Brig. Gen. Jeremiah T. Boyle"}],["$","small",null,{"children":"Warned higher authorities and requested reinforcements as Smith’s purpose became clear"}]]}],["$","div","7th Division, Army of the Ohio-Brig. Gen. George W. Morgan",{"className":"command-entry","children":[["$","strong",null,{"children":"7th Division, Army of the Ohio"}],["$","span",null,{"children":"Brig. Gen. George W. Morgan"}],["$","small",null,{"children":"Held Cumberland Gap with roughly 9,000 troops but lost his route to Lexington when Smith moved around him"}]]}],["$","div","First commander, United States Army of Kentucky-Maj. Gen. Lew Wallace",{"className":"command-entry","children":[["$","strong",null,{"children":"First commander, United States Army of Kentucky"}],["$","span",null,{"children":"Maj. Gen. Lew Wallace"}],["$","small",null,{"children":"Organized a defense along the Kentucky River before Nelson replaced him at Lexington"}]]}],["$","div","United States Army of Kentucky-Maj. Gen. William “Bull” Nelson",{"className":"command-entry","children":[["$","strong",null,{"children":"United States Army of Kentucky"}],["$","span",null,{"children":"Maj. Gen. William “Bull” Nelson"}],["$","small",null,{"children":"Replaced Wallace; assigned infantry brigades to Charles Cruft and Mahlon Manson and cavalry to James S. Jackson; ordered the infantry toward Richmond"}]]}]]]}]
