13:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","Confederate western coordination",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederate western coordination"}],[["$","div","Army of Mississippi and Department No. 2-Gen. Braxton Bragg",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Mississippi and Department No. 2"}],["$","span",null,{"children":"Gen. Braxton Bragg"}],["$","small",null,{"children":"Concentrated at Chattanooga, lent two brigades to Smith, and accepted the change from a Nashville concentration to separate advances into Kentucky"}]]}],["$","div","Department of East Tennessee and Army of Kentucky-Maj. Gen. Edmund Kirby Smith",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of East Tennessee and Army of Kentucky"}],["$","span",null,{"children":"Maj. Gen. Edmund Kirby Smith"}],["$","small",null,{"children":"Bypassed Cumberland Gap, divided his army to contain Morgan, and directed the main advance toward Richmond and Lexington"}]]}]]]}],["$","section","Confederate Army of Kentucky",{"className":"command-column #a45a36","children":[["$","h3",null,{"children":"Confederate Army of Kentucky"}],[["$","div","1st Division-Brig. Gen. Carter L. Stevenson",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division"}],["$","span",null,{"children":"Brig. Gen. Carter L. Stevenson"}],["$","small",null,{"children":"Roughly 9,000 men; detached to approach and contain the United States garrison at Cumberland Gap"}]]}],["$","div","2nd Division-Brig. Gen. Henry Heth",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division"}],["$","span",null,{"children":"Brig. Gen. Henry Heth"}],["$","small",null,{"children":"Roughly 6,000 men; moved into Kentucky and remained near Barbourville when Smith advanced on August 25"}]]}],["$","div","3rd Division-Brig. Gen. Thomas J. Churchill",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division"}],["$","span",null,{"children":"Brig. Gen. Thomas J. Churchill"}],["$","small",null,{"children":"Roughly 3,000 men; temporarily replaced John P. McCown and continued toward Richmond with Smith"}]]}],["$","div","4th Division-Brig. Gen. Patrick R. Cleburne",{"className":"command-entry","children":[["$","strong",null,{"children":"4th Division"}],["$","span",null,{"children":"Brig. Gen. Patrick R. Cleburne"}],["$","small",null,{"children":"Roughly 3,000 men in two brigades borrowed from Bragg; continued toward Richmond with Smith"}]]}],["$","div","Cavalry-Col. John S. Scott",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry"}],["$","span",null,{"children":"Col. John S. Scott"}],"$L22"]}],"$L23"]]}],"$L24"]}],"$L25"]]]}]
14:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L26","/images/ep207-cumberland-gap-operations-map.jpg",{"image":"/images/ep207-cumberland-gap-operations-map.jpg","alt":"Historical military map of the roads, ridges, fortifications, and 1862 operations around Cumberland Gap.","caption":"A detailed historical map of George W. Morgan’s 1862 operations at Cumberland Gap. The terrain explains why a quick direct assault was unattractive and why Smith chose a route around the position.","name":"Historical military map of the roads, ridges, fortifications, and 1862 operations around Cumberland Gap.","source":"$undefined","credit":"U.S. Army Corps of Engineers and Edward Ruger; Library of Congress Geography and Map Division and Library of Virginia."}],["$","$L26","/images/ep207-edmund-kirby-smith.jpg",{"image":"/images/ep207-edmund-kirby-smith.jpg","alt":"Wartime photographic portrait of Confederate Major General Edmund Kirby Smith in uniform.","caption":"Smith’s independent command authority and preference for Lexington turned a preliminary operation into a separate invasion route.","name":"Wartime photographic portrait of Confederate Major General Edmund Kirby Smith in uniform.","source":"$undefined","credit":"Civil War Glass Negatives and Related Prints, Library of Congress; no known restrictions on publication."}],["$","$L26","/images/ep207-patrick-cleburne.jpg",{"image":"/images/ep207-patrick-cleburne.jpg","alt":"Engraved portrait of Confederate Brigadier General Patrick R. Cleburne facing left.","caption":"Cleburne commanded the 4th Division, two brigades borrowed from Bragg, and led one of the formations advancing toward Richmond.","name":"Engraved portrait of Confederate Brigadier General Patrick R. Cleburne facing left.","source":"$undefined","credit":"Civil War Photograph Collection, Library of Congress; no known restrictions on publication."}]]}]]}]
