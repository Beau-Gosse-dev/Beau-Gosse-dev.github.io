d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",480," · ","May 4–5, 1864"," · ","Rapidan River crossings, Wilderness Tavern, Orange Turnpike, Orange Plank Road, and Saunders Field, Virginia"]}],["$","h1",null,{"children":"THE WILDERNESS (Part the Second)"}],["$","span",null,{"className":"result-label","children":"The Army of the Potomac crossed the Rapidan on five pontoon bridges and halted inside the Wilderness so its supply train could catch up. Confederate signalmen detected the movement before dawn. Lee sent Ewell east on Orange Turnpike, Hill east on Orange Plank Road, and Longstreet over southern roads, intending to hold Grant in terrain that reduced the U.S. numerical advantage. On May 5, Ewell made contact near Saunders Field and entrenched. Incomplete U.S. reports led Meade and Grant to believe they could attack an isolated part of Lee’s army"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"May 4–5, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Rapidan River crossings, Wilderness Tavern, Orange Turnpike, Orange Plank Road, and Saunders Field, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"The Army of the Potomac crossed the Rapidan on five pontoon bridges and halted inside the Wilderness so its supply train could catch up. Confederate signalmen detected the movement before dawn. Lee sent Ewell east on Orange Turnpike, Hill east on Orange Plank Road, and Longstreet over southern roads, intending to hold Grant in terrain that reduced the U.S. numerical advantage. On May 5, Ewell made contact near Saunders Field and entrenched. Incomplete U.S. reports led Meade and Grant to believe they could attack an isolated part of Lee’s army"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"May 4–5, 1864","place":"Rapidan River crossings, Wilderness Tavern, Orange Turnpike, Orange Plank Road, and Saunders Field, Virginia","result":"The Army of the Potomac crossed the Rapidan on five pontoon bridges and halted inside the Wilderness so its supply train could catch up. Confederate signalmen detected the movement before dawn. Lee sent Ewell east on Orange Turnpike, Hill east on Orange Plank Road, and Longstreet over southern roads, intending to hold Grant in terrain that reduced the U.S. numerical advantage. On May 5, Ewell made contact near Saunders Field and entrenched. Incomplete U.S. reports led Meade and Grant to believe they could attack an isolated part of Lee’s army","facts":[{"label":"U.S. pontoon bridges","value":"5"},{"label":"Army wagons","value":"More than 3,400"},{"label":"Ambulances","value":"Almost 600"},{"label":"Draft animals","value":"More than 24,000 horses and mules"},{"label":"Main U.S. crossings","value":"Germanna, Culpeper Mine, and Ely’s fords"},{"label":"Main Confederate routes","value":"3 parallel eastward roads"},{"label":"Longstreet at dusk May 4","value":"About 20 miles from the battlefield"},{"label":"Opening battlefield","value":"Dense second-growth Wilderness"}],"maps":[{"title":"The Rapidan crossings and Wilderness today","caption":"V and VI Corps crossed at Germanna Ford, II Corps crossed downstream at Ely’s Ford, and the wagon train used Culpeper Mine Ford between them. The army then moved toward Wilderness Tavern and Chancellorsville.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-77.90%2C38.22%2C-77.55%2C38.48&layer=mapnik&marker=38.3227%2C-77.7564"},{"title":"The first contact, noon–3 p.m. on May 5","caption":"The National Park Service map shows Ewell on Orange Turnpike, Hill approaching along Orange Plank Road, and the U.S. corps spread between the Rapidan crossings and Brock Road.","source":"https://www.nps.gov/media/photo/gallery-item.htm?gid=F6B164DB-01BE-4E4E-A97CC65D8F0FD22E&id=17fa8c32-a2c7-4633-92e2-d76770d6fee4","image":"/images/wilderness-may5-noon-3pm-map.jpg","alt":"Detailed troop movement map showing first contact at the Battle of the Wilderness on May 5, 1864"},{"title":"The opening of the Overland Campaign","caption":"The campaign map shows the Rapidan crossings, the Wilderness west of Fredericksburg, and the route the armies would follow toward Spotsylvania and Richmond.","source":"https://www.loc.gov/item/99448882/","image":"/images/overland-campaign-1864-map.jpg","alt":"Historical map of the opening movements of the Overland Campaign"}],"moments":[{"time":"0:32","audioTime":32,"title":"U.S. troops crossed the Rapidan","detail":"Theodore Lyman watched V and VI Corps cross at Germanna Ford on May 4 at the beginning of the Overland Campaign."},{"time":"2:29","audioTime":149,"title":"Lee recognized the coming offensive","detail":"Increased rail traffic, closed camps, and other activity led Lee to tell Jefferson Davis by April 28 that the Army of the Potomac had completed its preparations."},{"time":"3:40","audioTime":220,"title":"Lee began the campaign without several formations","detail":"Longstreet’s two divisions had returned, but Pickett’s division and the brigades of Robert Hoke and Robert Johnston remained on detached duties."},{"time":"4:49","audioTime":289,"title":"Grant’s other offensives held Confederate troops away","detail":"Simultaneous U.S. operations on several fronts prevented Richmond from returning every detached unit to Lee."},{"time":"5:12","audioTime":312,"title":"The night march began","detail":"Shortly after midnight on May 4, U.S. infantry moved toward the Rapidan while Sheridan’s cavalry cleared Confederate pickets from the fords."},{"time":"5:31","audioTime":331,"title":"Engineers laid five pontoon bridges","detail":"Warren’s V Corps and Sedgwick’s VI Corps crossed at Germanna Ford beginning around 6 a.m.; Hancock’s II Corps used Ely’s Ford four miles downstream."},{"time":"5:59","audioTime":359,"title":"The supply train used Culpeper Mine Ford","detail":"More than 3,400 wagons, almost 600 ambulances, over 24,000 draft animals, and a cattle herd crossed between the infantry routes."},{"time":"6:24","audioTime":384,"title":"Confederate signalmen detected the crossing","detail":"Before dawn, observers on Clark Mountain saw activity at the fords and after sunrise confirmed that the U.S. army was moving east of Lee."},{"time":"7:05","audioTime":425,"title":"Lee ordered Ewell east","detail":"Ewell left a rear guard and moved Second Corps along Orange Turnpike toward the Wilderness."},{"time":"7:26","audioTime":446,"title":"Hill took Orange Plank Road","detail":"Two Third Corps divisions marched east on the road parallel to Ewell while Hill’s remaining division watched the upper Rapidan crossings."},{"time":"7:47","audioTime":467,"title":"Longstreet selected a southern route","detail":"Lee first placed First Corps behind Hill, but Longstreet obtained permission to use shorter back roads that avoided congestion."},{"time":"8:20","audioTime":500,"title":"Three Confederate columns moved east","detail":"By early afternoon, Ewell, Hill, and Longstreet were marching on parallel routes while Stuart’s cavalry sought information around the U.S. army."},{"time":"8:55","audioTime":535,"title":"The U.S. cavalry screened the movement","detail":"Sheridan kept Stuart from learning much about Grant’s dispositions, but made little effort to determine where Lee’s infantry was moving."},{"time":"10:03","audioTime":603,"title":"Lee considered three responses","detail":"He could defend Mine Run, fall back to the North Anna, or move east and strike Grant while the U.S. army remained in the Wilderness."},{"time":"10:36","audioTime":636,"title":"Lee chose the Wilderness","detail":"He expected the dense terrain and limited roads to reduce Grant’s numerical advantage and create a chance to attack."},{"time":"11:22","audioTime":682,"title":"Ewell and Hill received limits","detail":"Lee ordered them to make contact but avoid a general battle until Longstreet arrived."},{"time":"12:30","audioTime":750,"title":"Meade expected Lee to defend or retreat","detail":"Meade judged Mine Run and the North Anna to be Lee’s likely choices and gave little weight to an advance east of Mine Run."},{"time":"14:06","audioTime":846,"title":"Grant preferred offensive action","detail":"Grant’s experience made him more willing than Meade to attack and less comfortable waiting for Lee’s move."},{"time":"16:32","audioTime":992,"title":"Meade halted in the Wilderness","detail":"After about 15 hours of marching, the U.S. infantry stopped so the supply train could close up and the troops could rest."},{"time":"16:49","audioTime":1009,"title":"The U.S. corps bivouacked in two groups","detail":"V and VI Corps stopped between Germanna Ford and Wilderness Tavern. II Corps camped east of Chancellorsville."},{"time":"17:17","audioTime":1037,"title":"Ewell and Hill stopped within four miles","detail":"Ewell halted at Locust Grove and Hill at New Verdiersville. Longstreet remained about 20 miles away at Brock’s Bridge."},{"time":"18:40","audioTime":1120,"title":"Lee continued east despite uncertain information","detail":"Stuart could not determine whether Grant would turn west to fight or east toward Fredericksburg, but Lee chose the more aggressive course."},{"time":"21:33","audioTime":1293,"title":"Fitzhugh Lee’s scouts found the U.S. direction","detail":"Scouts reached Chancellorsville and reported that Federal infantry was turning west toward Orange Court House rather than east toward Fredericksburg."},{"time":"22:22","audioTime":1342,"title":"Lee planned to hold Grant in the Wilderness","detail":"He intended Ewell and Hill to pin the U.S. army until Longstreet arrived for a larger attack."},{"time":"22:53","audioTime":1373,"title":"Ewell advanced at 5 a.m. on May 5","detail":"Second Corps moved down Orange Turnpike and contacted U.S. pickets about three miles east."},{"time":"23:53","audioTime":1433,"title":"Lee warned Ewell not to become trapped","detail":"With Hill behind schedule and Longstreet distant, Lee allowed reconnaissance but prohibited Ewell from committing so deeply that he could not withdraw."},{"time":"24:29","audioTime":1469,"title":"Ewell occupied Saunders Field","detail":"Edward Johnson deployed on the western edge of the clearing, Robert Rodes extended south, and Jubal Early remained in reserve."},{"time":"25:25","audioTime":1525,"title":"The Confederates built fieldworks","detail":"Ewell’s soldiers dug rifle pits and stacked logs into parapets, part of the increasing use of entrenchments during active campaigning."},{"time":"29:03","audioTime":1743,"title":"Incomplete reports reached Meade","detail":"Dispatches suggested the Confederates were not present in strength. Meade canceled the scheduled march and prepared to attack."},{"time":"29:44","audioTime":1784,"title":"Grant approved the attack","detail":"Both commanders believed they had an opportunity to strike an isolated portion of Lee’s army before the full Confederate force arrived."}],"command":[{"side":"United States","color":"#315f8c","branches":[{"commander":"Ulysses S. Grant","command":"General-in-chief","subordinates":"Set the campaign’s strategic direction while accompanying the Army of the Potomac"},{"commander":"George G. Meade","command":"Army of the Potomac","subordinates":"Warren’s V Corps, Sedgwick’s VI Corps, and Hancock’s II Corps"},{"commander":"Philip H. Sheridan","command":"Cavalry Corps","subordinates":"Cleared the fords and screened the army but did not locate Lee’s infantry columns"},{"commander":"Gouverneur K. Warren and John Sedgwick","command":"V and VI Corps","subordinates":"Crossed at Germanna Ford and halted near Wilderness Tavern"},{"commander":"Winfield Scott Hancock","command":"II Corps","subordinates":"Crossed at Ely’s Ford and bivouacked east of Chancellorsville"}]},{"side":"Confederacy","color":"#9a3d32","branches":[{"commander":"Robert E. Lee","command":"Army of Northern Virginia","subordinates":"Directed three infantry columns east toward the Wilderness"},{"commander":"Richard S. Ewell","command":"Second Corps","subordinates":"Edward Johnson and Robert Rodes formed at Saunders Field; Jubal Early held in reserve"},{"commander":"A. P. Hill","command":"Third Corps","subordinates":"Two divisions advanced on Orange Plank Road; Richard Anderson remained near Clark Mountain"},{"commander":"James Longstreet","command":"First Corps","subordinates":"Used southern back roads with two divisions; Pickett remained detached"},{"commander":"J. E. B. Stuart","command":"Cavalry Corps","subordinates":"Fitzhugh Lee’s scouts identified the U.S. turn west"}]}],"people":[{"name":"George G. Meade","role":"Directed the Rapidan crossing and halted the army so its supply train could close up","side":"United States"},{"name":"Philip H. Sheridan","role":"Cleared and screened the crossings but did not find Lee’s main infantry columns","side":"United States"},{"name":"Richard S. Ewell","role":"Led the first Confederate corps into contact and entrenched at Saunders Field","side":"Confederacy"},{"name":"James Longstreet","role":"Selected the southern approach route and remained a day’s march from the opening contact","side":"Confederacy"},{"name":"J. E. B. Stuart","role":"Used cavalry to determine whether Grant was turning toward Fredericksburg or Lee","side":"Confederacy"},{"personId":"ulysses-s-grant","role":"Crossed the Rapidan with Meade and approved an attack after the first contact"},{"name":"Robert E. Lee","role":"Chose to confront Grant inside the Wilderness rather than defend Mine Run or the North Anna","side":"Confederacy","image":"/images/robert-e-lee-1864.jpg","source":"https://www.loc.gov/item/2018666540/"}],"losses":[],"gallery":[{"image":"/images/wilderness-may5-noon-3pm-map.jpg","alt":"National Park Service map of the first contact in the Wilderness","caption":"The map shows the separate roads that brought Ewell and Hill toward the U.S. army and the gap between their corps.","source":"https://www.nps.gov/media/photo/gallery-item.htm?gid=F6B164DB-01BE-4E4E-A97CC65D8F0FD22E&id=17fa8c32-a2c7-4633-92e2-d76770d6fee4"},{"image":"/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","caption":"Grant crossed the Rapidan with the Army of the Potomac and accepted battle when Ewell was reported ahead.","source":"https://www.loc.gov/item/2018666428/"},{"image":"/images/robert-e-lee-1864.jpg","alt":"Portrait of Robert E. Lee","caption":"Lee moved east to stop Grant before the U.S. army escaped the restrictive Wilderness terrain.","source":"https://www.loc.gov/item/2018666540/"}],"sources":[{"label":"Civil War Podcast episode 480","url":"https://civilwarpodcast.org/2025/01/12/civil-war-podcast-episode-480/"},{"label":"National Park Service: History of the Battle of the Wilderness","url":"https://www.nps.gov/frsp/learn/historyculture/wildspot.htm"},{"label":"National Park Service: Wilderness troop movement maps","url":"https://www.nps.gov/media/photo/gallery.htm?id=F6B164DB-01BE-4E4E-A97CC65D8F0FD22E"},{"label":"National Park Service: Saunders Field","url":"https://www.nps.gov/places/saunders-field.htm"},{"label":"Library of Congress: Overland Campaign map","url":"https://www.loc.gov/item/99448882/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
