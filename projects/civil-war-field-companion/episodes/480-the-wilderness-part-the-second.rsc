1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",480," · ","May 4–5, 1864"," · ","Rapidan River crossings, Wilderness Tavern, Orange Turnpike, Orange Plank Road, and Saunders Field, Virginia"]}],["$","h1",null,{"children":"THE WILDERNESS (Part the Second)"}],["$","span",null,{"className":"result-label","children":"The Army of the Potomac crossed the Rapidan on five pontoon bridges and halted inside the Wilderness so its supply train could catch up. Confederate signalmen detected the movement before dawn. Lee sent Ewell east on Orange Turnpike, Hill east on Orange Plank Road, and Longstreet over southern roads, intending to hold Grant in terrain that reduced the U.S. numerical advantage. On May 5, Ewell made contact near Saunders Field and entrenched. Incomplete U.S. reports led Meade and Grant to believe they could attack an isolated part of Lee’s army"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9587771604.mp3?updated=1736731651","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","U.S. pontoon bridges",{"children":[["$","span",null,{"children":"U.S. pontoon bridges"}],["$","strong",null,{"children":"5"}],"$undefined"]}],["$","div","Army wagons",{"children":[["$","span",null,{"children":"Army wagons"}],["$","strong",null,{"children":"More than 3,400"}],"$undefined"]}],["$","div","Ambulances",{"children":[["$","span",null,{"children":"Ambulances"}],["$","strong",null,{"children":"Almost 600"}],"$undefined"]}],["$","div","Draft animals",{"children":[["$","span",null,{"children":"Draft animals"}],["$","strong",null,{"children":"More than 24,000 horses and mules"}],"$undefined"]}],["$","div","Main U.S. crossings",{"children":[["$","span",null,{"children":"Main U.S. crossings"}],["$","strong",null,{"children":"Germanna, Culpeper Mine, and Ely’s fords"}],"$undefined"]}],["$","div","Main Confederate routes",{"children":[["$","span",null,{"children":"Main Confederate routes"}],["$","strong",null,{"children":"3 parallel eastward roads"}],"$undefined"]}],["$","div","Longstreet at dusk May 4",{"children":[["$","span",null,{"children":"Longstreet at dusk May 4"}],["$","strong",null,{"children":"About 20 miles from the battlefield"}],"$undefined"]}],["$","div","Opening battlefield",{"children":[["$","span",null,{"children":"Opening battlefield"}],["$","strong",null,{"children":"Dense second-growth Wilderness"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],"$undefined",["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-gri