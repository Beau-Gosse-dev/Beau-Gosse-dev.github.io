tle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"July 19–20, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"North of Atlanta, Georgia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"The Confederate attack began about 3:15 p.m."}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"July 19–20, 1864","place":"North of Atlanta, Georgia","result":"The Confederate attack began about 3:15 p.m.","facts":[{"label":"Confederate force described","value":"About 55,000, including cavalry and militia"},{"label":"Target","value":"George H. Thomas's army after it crossed Peachtree Creek"},{"label":"Planned start","value":"1:00 p.m. on July 20"},{"label":"Actual start","value":"About 3:15 p.m.","note":"The line shifted right before the attack."}],"maps":[{"title":"Atlanta and Decatur today","caption":"Thomas approached Atlanta from the north. Schofield and McPherson moved farther east toward Decatur, creating the gap Hood planned to use.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.49%2C33.70%2C-84.20%2C33.89&layer=mapnik&marker=33.8105%2C-84.4032"},{"title":"Troop positions and Confederate attacks","caption":"Blue marks the U.S. line. Red marks the Confederate line and attack directions. The attack was intended to begin on the Confederate right and continue westward.","source":"https://commons.wikimedia.org/wiki/File:BATTLE_OF_PEACHTREE_CREEK.jpg","image":"/images/peachtree-tactical-map.jpg","alt":"U.S. Army map of the Battle of Peachtree Creek showing United States positions in blue and Confederate positions and attacks in red"},{"title":"Atlanta campaign operations","caption":"This U.S. Army Corps of Engineers map shows Atlanta, Decatur, Peachtree Creek, roads, railroads, fortifications, and the wider operations around the city.","source":"https://www.loc.gov/item/99447303/","image":"/images/peachtree-operations-map.jpg","alt":"1875 military operations map of Atlanta and the surrounding region"},{"title":"U.S. positions at Peachtree Creek","caption":"A wartime manuscript map showing U.S. camps and troop positions north of Atlanta around Peachtree Creek.","source":"https://www.loc.gov/item/2007626736/","image":"/images/peachtree-union-positions.jpg","alt":"Wartime manuscript map of United States troop positions at Peachtree Creek"}],"moments":[{"time":"1:18","audioTime":78,"title":"The armies were positioned north and east of Atlanta","detail":"Stewart held the Confederate left, Hardee the center, and Cheatham the right. Thomas was crossing Peachtree Creek while Schofield and McPherson moved toward Decatur."},{"time":"3:00","audioTime":180,"title":"Hood identified a gap in the U.S. line","detail":"About two miles separated the left of Thomas from the right of Schofield. Marshy stream headwaters made rapid support between the two forces difficult."},{"time":"4:36","audioTime":276,"title":"Hood met his senior commanders","detail":"On the night of July 19, Hood met with Stewart, Hardee, Cheatham, and Georgia militia commander Gustavus W. Smith."},{"time":"6:42","audioTime":402,"title":"Hood ordered an attack on Thomas","detail":"Hardee and Stewart were to attack Thomas after his corps crossed the creek but before they had completed their defenses."},{"time":"7:22","audioTime":442,"title":"The plan called for an attack from east to west","detail":"Hardee was to begin on the Confederate right. The divisions to his left would follow in sequence and push Thomas west toward the angle between Peachtree Creek and the Chattahoochee River."},{"time":"8:38","audioTime":518,"title":"The attack was set for 1 p.m.","detail":"Cheatham, Wheeler, and the Georgia militia were assigned to protect the eastern approaches while Hardee and Stewart attacked."},{"time":"11:51","audioTime":711,"title":"U.S. troops had already reached Decatur","detail":"Hood did not know how far McPherson and Schofield had advanced east of Atlanta."},{"time":"12:56","audioTime":776,"title":"Hood shifted the Confederate line to the right","detail":"After Wheeler requested help, Hood ordered Cheatham to move toward the Decatur Road. Hardee and Stewart also had to move right before attacking."},{"time":"13:58","audioTime":838,"title":"The shift delayed the attack","detail":"Cheatham moved farther than Hood expected. Hardee and Stewart followed, and the movement was not complete until after 3 p.m."},{"time":"18:10","audioTime":1090,"title":"Peachtree Creek complicated the U.S. crossing","detail":"The stream ran west through steep banks and dense vegetation about four miles north of Atlanta. Thomas crossed at several points."},{"time":"19:32","audioTime":1172,"title":"Thomas established a three-mile front","detail":"Palmer’s XIV Corps held the right, Hooker’s XX Corps the center, and John Newton’s IV Corps division the left. Most of the army was south of the creek by noon."},{"time":"22:43","audioTime":1363,"title":"The first Confederate attacks began","detail":"Rice C. Bull of the 123rd New York described the sudden firing. The battle opened at about 3:15 p.m."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Overall campaign command"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"John M. Palmer, Joseph Hooker, and John Newton"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"Advanced toward Decatur between Thomas and McPherson"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Advanced east of Atlanta toward Decatur"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"John B. Hood","command":"Army of Tennessee","subordinates":"Directed the attack"},{"commander":"William J. Hardee","command":"Hardee's Corps","subordinates":"Bate, Walker, Maney, and Cleburne"},{"commander":"Alexander P. Stewart","command":"Stewart's Corps","subordinates":"Loring, Walthall, and French"},{"commander":"Benjamin F. Cheatham","command":"Cheatham's Corps","subordinates":"Protected the Confederate right and the Decatur Road"},{"commander":"Joseph Wheeler","command":"Cavalry Corps","subordinates":"Reported the U.S. advance from Decatur"},{"commander":"Gustavus W. Smith","command":"Georgia militia","subordinates":"Protected the eastern approaches to Atlanta"}]}],"people":[{"name":"John B. Hood","role":"Designed the attack against Thomas three days after taking army command","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"George H. Thomas","role":"Commanded the Army of the Cumberland as it crossed Peachtree Creek","side":"United States"},{"name":"Rice C. Bull","role":"123rd New York officer whose account describes the opening of the attack","side":"United States"},{"name":"William H. Jackson","role":"Commanded Confederate cavalry west of Atlanta","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/peachtree-battle-drawing.jpg","alt":"Adolph Metzner watercolor drawing of the Battle of Peachtree Creek made in 1864","caption":"Adolph Metzner, an officer in the 32nd Indiana, drew this view of the battle in 1864.","source":"https://www.loc.gov/pictures/item/2017646908/"},{"image":"/images/atlanta-fortifications.jpg","alt":"Earthwork fortifications outside Atlanta photographed in 1864","caption":"Confederate fortifications at Atlanta. Hood planned to attack before Thomas could complete similar field defenses north of the city.","source":"https://www.loc.gov/item/2018670937/"}],"sources":[{"label":"Official Episode 536 page","url":"https://civilwarpodcast.org/2026/08/02/civil-war-podcast-episode-536/"},{"label":"Episode 536 transcript index","url":"https://podcastrex.com/shows/the-civil-war-reconstruction/536-the-atlanta-campaign-peach-tree-creek"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta operations map","url":"https://www.loc.gov/item/99447303/"},{"label":"Library of Congress U.S. positions map","url":"https://www.loc.gov/item/2007626736/"},{"label":"Library of Congress battlefield drawing","url":"https://www.loc.gov/pictures/item/2017646908/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
