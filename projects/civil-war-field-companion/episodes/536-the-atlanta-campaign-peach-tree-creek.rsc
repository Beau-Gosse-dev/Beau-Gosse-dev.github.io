11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The armies were positioned north and east of Atlanta",{"className":"moment","children":[["$","$L16",null,{"seconds":78,"label":"1:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies were positioned north and east of Atlanta"}],["$","p",null,{"children":"Stewart held the Confederate left, Hardee the center, and Cheatham the right. Thomas was crossing Peachtree Creek while Schofield and McPherson moved toward Decatur."}]]}]]}],["$","div","Hood identified a gap in the U.S. line",{"className":"moment","children":[["$","$L16",null,{"seconds":180,"label":"3:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood identified a gap in the U.S. line"}],["$","p",null,{"children":"About two miles separated the left of Thomas from the right of Schofield. Marshy stream headwaters made rapid support between the two forces difficult."}]]}]]}],["$","div","Hood met his senior commanders",{"className":"moment","children":[["$","$L16",null,{"seconds":276,"label":"4:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood met his senior commanders"}],["$","p",null,{"children":"On the night of July 19, Hood met with Stewart, Hardee, Cheatham, and Georgia militia commander Gustavus W. Smith."}]]}]]}],["$","div","Hood ordered an attack on Thomas",{"className":"moment","children":[["$","$L16",null,{"seconds":402,"label":"6:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood ordered an attack on Thomas"}],["$","p",null,{"children":"Hardee and Stewart were to attack Thomas after his corps crossed the creek but before they had completed their defenses."}]]}]]}],["$","div","The plan called for an attack from east to west",{"className":"moment","children":[["$","$L16",null,{"seconds":442,"label":"7:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The plan called for an attack from east to west"}],["$","p",null,{"children":"Hardee was to begin on the Confederate right. The divisions to his left would follow in sequence and push Thomas west toward the angle between Peachtree Creek and the Chattahoochee River."}]]}]]}],["$","div","The attack was set for 1 p.m.",{"className":"moment","children":[["$","$L16",null,{"seconds":518,"label":"8:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack was set for 1 p.m."}],["$","p",null,{"children":"Cheatham, Wheeler, and the Georgia militia were assigned to protect the eastern approaches while Hardee and Stewart attacked."}]]}]]}],["$","div","U.S. troops had already reached Decatur",{"className":"moment","children":[["$","$L16",null,{"seconds":711,"label":"11:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops had already reached Decatur"}],["$","p",null,{"children":"Hood did not know how far McPherson and Schofield had advanced east of Atlanta."}]]}]]}],["$","div","Hood shifted the Confederate line to the right",{"className":"moment","children":[["$","$L16",null,{"seconds":776,"label":"12:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood shifted the Confederate line to the right"}],["$","p",null,{"children":"After Wheeler requested help, Hood ordered Cheatham to move toward the Decatur Road. Hardee and Stewart also had to move right before attacking."}]]}]]}],["$","div","The shift delayed the attack",{"className":"moment","children":[["$","$L16",null,{"seconds":838,"label":"13:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"The shift delayed the attack"}],["$","p",null,{"children":"Cheatham moved farther than Hood expected. Hardee and Stewart followed, and the movement was not complete until after 3 p.m."}]]}]]}],["$","div","Peachtree Creek complicated the U.S. crossing",{"className":"moment","children":[["$","$L16",null,{"seconds":1090,"label":"18:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Peachtree Creek complicated the U.S. crossing"}],["$","p",null,{"children":"The stream ran west through steep banks and dense vegetation about four miles north of Atlanta. Thomas crossed at several points."}]]}]]}],"$L17","$L18"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","Military Division of the Mississippi",{"className":"command-entry","children":[["$","strong",null,{"children":"Military Division of the Mississippi"}],["$","span",null,{"children":"William T. Sherman"}],["$","small",null,{"children":"Overall campaign command"}]]}],["$","div","Army of the Cumberland",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Cumberland"}],["$","span",null,{"children":"George H. Thomas"}],["$","small",null,{"children":"John M. Palmer, Joseph Hooker, and John Newton"}]]}],["$","div","Army of the Ohio",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Ohio"}],["$","span",null,{"children":"John M. Schofield"}],["$","small",null,{"children":"Advanced toward Decatur between Thomas and McPherson"}]]}],["$","div","Army of the Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Tennessee"}],["$","span",null,{"children":"James B. McPherson"}],["$","small",null,{"children":"Advanced east of Atlanta toward Decatur"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Tennessee"}],["$","span",null,{"children":"John B. Hood"}],["$","small",null,{"children":"Directed the attack"}]]}],["$","div","Hardee's Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Hardee's Corps"}],["$","span",null,{"children":"William J. Hardee"}],["$","small",null,{"children":"Bate, Walker, Maney, and Cleburne"}]]}],["$","