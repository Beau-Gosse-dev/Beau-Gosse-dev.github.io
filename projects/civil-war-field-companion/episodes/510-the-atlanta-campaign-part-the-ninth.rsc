11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Johnston shifted troops toward Dalton",{"className":"moment","children":[["$","$L16",null,{"seconds":77,"label":"1:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston shifted troops toward Dalton"}],["$","p",null,{"children":"Reports about U.S. movements led Johnston to reinforce the northern end of his line and move cavalry away from Resaca."}]]}]]}],["$","div","Canty remained at Resaca",{"className":"moment","children":[["$","$L16",null,{"seconds":126,"label":"2:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canty remained at Resaca"}],["$","p",null,{"children":"Johnston repeatedly changed Canty’s orders but ultimately kept his infantry near Resaca while Polk’s reinforcements moved toward north Georgia."}]]}]]}],["$","div","Johnston misread McPherson’s objective",{"className":"moment","children":[["$","$L16",null,{"seconds":231,"label":"3:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston misread McPherson’s objective"}],["$","p",null,{"children":"Confederate reports tracked McPherson south through LaFayette, but Johnston continued to expect an advance toward Rome."}]]}]]}],["$","div","U.S. troops attacked Rocky Face Ridge",{"className":"moment","children":[["$","$L16",null,{"seconds":302,"label":"5:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops attacked Rocky Face Ridge"}],["$","p",null,{"children":"On May 8, Oliver O. Howard’s IV Corps climbed the northern end of the ridge and met the main Confederate line."}]]}]]}],["$","div","Hooker attacked Dug Gap",{"className":"moment","children":[["$","$L16",null,{"seconds":350,"label":"5:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker attacked Dug Gap"}],["$","p",null,{"children":"Four U.S. regiments reached the pass before a Confederate counterattack drove them back."}]]}]]}],["$","div","The demonstrations fixed Johnston in place",{"className":"moment","children":[["$","$L16",null,{"seconds":393,"label":"6:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The demonstrations fixed Johnston in place"}],["$","p",null,{"children":"The attacks cost about 400 U.S. casualties and gained no important ground, but they kept Confederate attention on Dalton."}]]}]]}],["$","div","McPherson occupied Snake Creek Gap",{"className":"moment","children":[["$","$L16",null,{"seconds":414,"label":"6:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson occupied Snake Creek Gap"}],["$","p",null,{"children":"The 9th Illinois Mounted Infantry and 39th Iowa reached the unguarded pass late on May 8 without Confederate detection."}]]}]]}],["$","div","The railroad was exposed",{"className":"moment","children":[["$","$L16",null,{"seconds":447,"label":"7:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The railroad was exposed"}],["$","p",null,{"children":"From the gap, McPherson could move east toward Resaca and cut Johnston’s railroad supply and retreat route to Atlanta."}]]}]]}],["$","div","Confederate cavalry was sent to the gap",{"className":"moment","children":[["$","$L16",null,{"seconds":583,"label":"9:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate cavalry was sent to the gap"}],["$","p",null,{"children":"J. Warren Grigsby’s brigade was delayed by a guide and reached the southern entrance around dawn on May 9."}]]}]]}],["$","div","The Confederates discovered the U.S. position",{"className":"moment","children":[["$","$L16",null,{"seconds":607,"label":"10:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederates discovered the U.S. position"}],["$","p",null,{"children":"Grigsby’s cavalry drove back a small mounted patrol but was stopped by U.S. infantry inside the gap."}]]}]]}],["$","div","McPherson advanced toward Resaca",{"className":"moment","children":[["$","$L16",null,{"seconds":640,"label":"10:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson advanced toward Resaca"}],["$","p",null,{"children":"Grenville Dodge’s XVI Corps led, followed by John A. Logan’s XV Corps. Bad roads and Confederate cavalry slowed the march."}]]}]]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}]]}]
