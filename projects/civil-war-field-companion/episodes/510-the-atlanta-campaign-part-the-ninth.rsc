11:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L18",null,{"guide":{"date":"May 5–12, 1864","place":"Dalton, Rocky Face Ridge, Snake Creek Gap, and Resaca, Georgia","result":"McPherson captured the unguarded Snake Creek Gap but did not cut the railroad at Resaca; Sherman then shifted most of his force south and compelled Johnston to leave Dalton","facts":[{"label":"Rocky Face and Dug Gap losses","value":"About 400 U.S. casualties"},{"label":"Snake Creek Gap occupied","value":"May 8, 1864"},{"label":"Distance from gap to Resaca","value":"About 8–9 miles"},{"label":"Sherman concentrated at the gap","value":"By May 12"}],"maps":[{"title":"Chattanooga, Dalton, and Resaca","caption":"The campaign map shows the U.S. routes toward Rocky Face Ridge and the wide movement through LaFayette and Snake Creek Gap toward Resaca.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of the Atlanta campaign from Chattanooga to the Oostanaula River"},{"title":"Dalton, Snake Creek Gap, and Resaca today","caption":"Sherman demonstrated around Dalton while McPherson marched south through LaFayette and Villanow, then east through Snake Creek Gap toward the railroad at Resaca.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-85.35%2C34.48%2C-84.75%2C34.95&layer=mapnik&marker=34.679%2C-85.111"},{"title":"Fieldworks used during the campaign","caption":"Confederate earthworks guarded Dalton, Rocky Face Ridge, and Resaca. The Resaca works McPherson saw were designed chiefly to protect the bridges from raids.","source":"https://www.loc.gov/item/2018670937/","image":"/images/atlanta-fortifications.jpg","alt":"Civil War earthwork fortifications made from earth and timber"}],"moments":[{"time":"1:17","audioTime":77,"title":"Johnston shifted troops toward Dalton","detail":"Reports about U.S. movements led Johnston to reinforce the northern end of his line and move cavalry away from Resaca."},{"time":"2:06","audioTime":126,"title":"Canty remained at Resaca","detail":"Johnston repeatedly changed Canty’s orders but ultimately kept his infantry near Resaca while Polk’s reinforcements moved toward north Georgia."},{"time":"3:51","audioTime":231,"title":"Johnston misread McPherson’s objective","detail":"Confederate reports tracked McPherson south through LaFayette, but Johnston continued to expect an advance toward Rome."},{"time":"5:02","audioTime":302,"title":"U.S. troops attacked Rocky Face Ridge","detail":"On May 8, Oliver O. Howard’s IV Corps climbed the northern end of the ridge and met the main Confederate line."},{"time":"5:50","audioTime":350,"title":"Hooker attacked Dug Gap","detail":"Four U.S. regiments reached the pass before a Confederate counterattack drove them back."},{"time":"6:33","audioTime":393,"title":"The demonstrations fixed Johnston in place","detail":"The attacks cost about 400 U.S. casualties and gained no important ground, but they kept Confederate attention on Dalton."},{"time":"6:54","audioTime":414,"title":"McPherson occupied Snake Creek Gap","detail":"The 9th Illinois Mounted Infantry and 39th Iowa reached the unguarded pass late on May 8 without Confederate detection."},{"time":"7:27","audioTime":447,"title":"The railroad was exposed","detail":"From the gap, McPherson could move east toward Resaca and cut Johnston’s railroad supply and retreat route to Atlanta."},{"time":"9:43","audioTime":583,"title":"Confederate cavalry was sent to the gap","detail":"J. Warren Grigsby’s brigade was delayed by a guide and reached the southern entrance around dawn on May 9."},{"time":"10:07","audioTime":607,"title":"The Confederates discovered the U.S. position","detail":"Grigsby’s cavalry drove back a small mounted patrol but was stopped by U.S. infantry inside the gap."},{"time":"10:40","audioTime":640,"title":"McPherson advanced toward Resaca","detail":"Grenville Dodge’s XVI Corps led, followed by John A. Logan’s XV Corps. Bad roads and Confederate cavalry slowed the march."},{"time":"11:09","audioTime":669,"title":"The column reached the Resaca approaches","detail":"Dodge arrived at a crossroads about two miles west of town during the afternoon and detached a division to cover the northern roads."},{"time":"12:19","audioTime":739,"title":"McPherson halted before the earthworks","detail":"He did not know their strength and feared Confederate troops could arrive from Dalton against his left flank."},{"time":"13:29","audioTime":809,"title":"The U.S. column withdrew to the gap","detail":"McPherson ordered Dodge back and entrenched at the entrance instead of cutting the railroad."},{"time":"13:38","audioTime":818,"title":"A cavalry patrol reached the railroad","detail":"The patrol cut telegraph wires and burned locomotive fuel but could not disable the line."},{"time":"15:22","audioTime":922,"title":"Control of the gap still forced a Confederate response","detail":"Although the railroad remained open, Johnston could no longer safely hold Dalton while a large U.S. force occupied his rear."},{"time":"19:57","audioTime":1197,"title":"Sherman shifted south","detail":"Beginning May 10, most of Thomas’s and Schofield’s troops marched west of Rocky Face Ridge to join McPherson."},{"time":"20:40","audioTime":1240,"title":"Most U.S. forces reached Snake Creek Gap","detail":"By the night of May 12, only IV Corps and some cavalry remained in front of Dalton."},{"time":"23:19","audioTime":1399,"title":"Polk’s reinforcements reached Resaca","detail":"The leading units from Alabama arrived on May 11. Polk became the senior subordinate in the enlarged Army of Tennessee."},{"time":"25:36","audioTime":1536,"title":"Johnston finally ordered a movement to Resaca","detail":"A cavalry reconnaissance found only one U.S. corps at Dalton. Johnston then directed Hardee and Hood to move south."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Used attacks at Dalton to cover McPherson’s movement"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Howard’s IV Corps and Hooker’s XX Corps demonstrated at Rocky Face Ridge"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Logan’s XV Corps and Dodge’s XVI Corps seized Snake Creek Gap"},{"commander":"Grenville M. Dodge","command":"XVI Corps","subordinates":"Led the May 9 advance toward Resaca"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Directed defenses at Dalton and the eventual movement to Resaca"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Held part of the Dalton position"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Operated in Crow Valley and moved toward Resaca"},{"commander":"Leonidas Polk","command":"Polk’s Corps","subordinates":"Brought reinforcements from Alabama and Mississippi"},{"commander":"Joseph Wheeler","command":"Cavalry Corps","subordinates":"Concentrated north of Dalton"}]}],"people":[{"name":"James B. McPherson","role":"Captured Snake Creek Gap but withdrew before cutting the railroad at Resaca","side":"United States"},{"name":"William T. Sherman","role":"Designed the flanking movement and then concentrated most of his armies at the gap","side":"United States"},{"name":"Joseph E. Johnston","role":"Misidentified McPherson’s objective and left Snake Creek Gap unguarded","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"Grenville M. Dodge","role":"Led XVI Corps toward Resaca on May 9","side":"United States"},{"name":"John A. Logan","role":"Commanded XV Corps behind Dodge’s advance","side":"United States"},{"name":"John B. Hood","role":"Commanded Confederate troops shifted between Dalton and Resaca","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"Leonidas Polk","role":"Arrived at Resaca with reinforcements and became Johnston’s second in command","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of the Atlanta campaign from Chattanooga to Resaca","caption":"The map records the wide U.S. approach through Snake Creek Gap and the direct demonstrations at Dalton.","source":"https://www.loc.gov/item/2008628278/"},{"image":"/images/joseph-e-johnston.jpg","alt":"Portrait of Joseph E. Johnston","caption":"Johnston kept his attention on Dalton after reports showed McPherson moving south.","source":"https://www.loc.gov/item/2018666539/"},{"image":"/images/john-b-hood.jpg","alt":"Portrait of John B. Hood","caption":"Hood moved between Crow Valley, Dalton, and Resaca as Confederate headquarters tried to identify the main threat.","source":"https://www.loc.gov/pictures/item/2002722867/"}],"sources":[{"label":"Official Episode 510 page","url":"https://civilwarpodcast.org/2025/11/02/civil-war-podcast-episode-510/"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"Library of Congress Atlanta fortifications photograph","url":"https://www.loc.gov/item/2018670937/"}]}}]}]
