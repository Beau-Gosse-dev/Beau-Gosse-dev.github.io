17:["$","div","The column reached the Resaca approaches",{"className":"moment","children":[["$","$L16",null,{"seconds":669,"label":"11:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The column reached the Resaca approaches"}],["$","p",null,{"children":"Dodge arrived at a crossroads about two miles west of town during the afternoon and detached a division to cover the northern roads."}]]}]]}]
18:["$","div","McPherson halted before the earthworks",{"className":"moment","children":[["$","$L16",null,{"seconds":739,"label":"12:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson halted before the earthworks"}],["$","p",null,{"children":"He did not know their strength and feared Confederate troops could arrive from Dalton against his left flank."}]]}]]}]
19:["$","div","The U.S. column withdrew to the gap",{"className":"moment","children":[["$","$L16",null,{"seconds":809,"label":"13:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. column withdrew to the gap"}],["$","p",null,{"children":"McPherson ordered Dodge back and entrenched at the entrance instead of cutting the railroad."}]]}]]}]
1a:["$","div","A cavalry patrol reached the railroad",{"className":"moment","children":[["$","$L16",null,{"seconds":818,"label":"13:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"A cavalry patrol reached the railroad"}],["$","p",null,{"children":"The patrol cut telegraph wires and burned locomotive fuel but could not disable the line."}]]}]]}]
1b:["$","div","Control of the gap still forced a Confederate response",{"className":"moment","children":[["$","$L16",null,{"seconds":922,"label":"15:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Control of the gap still forced a Confederate response"}],["$","p",null,{"children":"Although the railroad remained open, Johnston could no longer safely hold Dalton while a large U.S. force occupied his rear."}]]}]]}]
1c:["$","div","Sherman shifted south",{"className":"moment","children":[["$","$L16",null,{"seconds":1197,"label":"19:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman shifted south"}],["$","p",null,{"children":"Beginning May 10, most of Thomas’s and Schofield’s troops marched west of Rocky Face Ridge to join McPherson."}]]}]]}]
1d:["$","div","Most U.S. forces reached Snake Creek Gap",{"className":"moment","children":[["$","$L16",null,{"seconds":1240,"label":"20:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Most U.S. forces reached Snake Creek Gap"}],["$","p",null,{"children":"By the night of May 12, only IV Corps and some cavalry remained in front of Dalton."}]]}]]}]
