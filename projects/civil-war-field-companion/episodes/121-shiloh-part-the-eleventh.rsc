d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",121," · ","April 6, 1862, about 4 p.m. to 5:30 p.m.; W.H.L. Wallace died April 10"," · ","Duncan Field, the Hornet’s Nest, the Corinth Road, and the final United States line above Pittsburg Landing, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Eleventh)"}],["$","span",null,{"className":"result-label","children":"Patton Anderson’s frontal attack failed. Daniel Ruggles then assembled 11 Confederate batteries with as many as 53 guns and opened a sustained bombardment. At about 4 p.m., Sherman and McClernand withdrew from the west while Hurlbut withdrew from the east, leaving W.H.L. Wallace and Benjamin Prentiss exposed on both flanks. Wallace ordered a retreat but was shot in the head while directing it. Several regiments escaped; most of the 58th Illinois, 12th Iowa, 14th Iowa, and Prentiss’s remaining command were surrounded. Prentiss and about 2,200 United States soldiers surrendered at about 5:30 p.m. Wallace was recovered alive the next day and died on April 10"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 6, 1862, about 4 p.m. to 5:30 p.m.; W.H.L. Wallace died April 10"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Duncan Field, the Hornet’s Nest, the Corinth Road, and the final United States line above Pittsburg Landing, Tennessee"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Patton Anderson’s frontal attack failed. Daniel Ruggles then assembled 11 Confederate batteries with as many as 53 guns and opened a sustained bombardment. At about 4 p.m., Sherman and McClernand withdrew from the west while Hurlbut withdrew from the east, leaving W.H.L. Wallace and Benjamin Prentiss exposed on both flanks. Wallace ordered a retreat but was shot in the head while directing it. Several regiments escaped; most of the 58th Illinois, 12th Iowa, 14th Iowa, and Prentiss’s remaining command were surrounded. Prentiss and about 2,200 United States soldiers surrendered at about 5:30 p.m. Wallace was recovered alive the next day and died on April 10"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":["$Lf","$L10","$L11","$L12"]}],"$undefined"]}],"$L13","$L14","$L15",false,"$L16","$L17","$L18","$L19","$L1a","$L1b"]}]]}]
