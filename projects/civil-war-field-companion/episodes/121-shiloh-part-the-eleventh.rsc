1a:["$","h3",null,{"children":"Grant’s earlier order remained in effect"}]
1b:["$","p",null,{"children":"Grant had told Wallace and Prentiss to hold. Wallace now had to decide when continued resistance would result in encirclement."}]
1c:["$","div","Sweeney reported that the right could not hold",{"className":"moment","children":[["$","$L19",null,{"seconds":1053,"label":"17:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sweeney reported that the right could not hold"}],["$","p",null,{"children":"Only the 7th and 58th Illinois remained with his brigade; Confederates were already moving around them."}]]}]]}]
1d:["$","div","Wallace ordered a withdrawal",{"className":"moment","children":[["$","$L19",null,{"seconds":1146,"label":"19:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wallace ordered a withdrawal"}],["$","p",null,{"children":"Artillery left first. The 7th Illinois and the 2nd and 7th Iowa moved toward the Corinth Road as Confederate forces closed in."}]]}]]}]
1e:["$","div","W.H.L. Wallace was mortally wounded",{"className":"moment","children":[["$","$L19",null,{"seconds":1182,"label":"19:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"W.H.L. Wallace was mortally wounded"}],["$","p",null,{"children":"A bullet entered the back of his head and exited near the left eye. His aides left him beside the road when Confederate fire made it impossible to carry him farther."}]]}]]}]
1f:["$","div","Several regiments were trapped",{"className":"moment","children":[["$","$L19",null,{"seconds":1239,"label":"20:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Several regiments were trapped"}],["$","p",null,{"children":"Most of the 58th Illinois and the 12th and 14th Iowa were cut off north of the farm lane. Most of Prentiss’s remaining command was also surrounded."}]]}]]}]
20:["$","div","The Hornet’s Nest surrendered",{"className":"moment","children":[["$","$L19",null,{"seconds":1314,"label":"21:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Hornet’s Nest surrendered"}],["$","p",null,{"children":"Confederates captured Prentiss and about 2,200 men from the 2nd and 6th Divisions at about 5:30 p.m."}]]}]]}]
21:["$","div","Wallace was recovered alive",{"className":"moment","children":[["$","$L19",null,{"seconds":1452,"label":"24:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wallace was recovered alive"}],["$","p",null,{"children":"On April 7, Cyrus Dickey found Wallace still breathing. He was taken to Cherry Mansion in Savannah, where he died four days after being wounded."}]]}]]}]
22:["$","p",null,{"children":"Commanded the 2nd Division, ordered its withdrawal, and was mortally wounded while directing it"}]
