1:[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css"}],"$undefined"],"$Ld"]
