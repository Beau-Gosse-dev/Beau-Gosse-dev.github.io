12:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.libsyn.com/121-shiloh-part-the-eleventh",{"href":"https://civilwarpodcast.libsyn.com/121-shiloh-part-the-eleventh","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 121"]}],["$","a","https://www.nps.gov/places/hornets-nest-tour-stop-10.htm",{"href":"https://www.nps.gov/places/hornets-nest-tour-stop-10.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Hornet’s Nest"]}],["$","a","https://www.nps.gov/places/ruggles-battery-tour-stop-4.htm",{"href":"https://www.nps.gov/places/ruggles-battery-tour-stop-4.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Ruggles’ Battery"]}],["$","a","https://www.nps.gov/shil/learn/historyculture/monument-detail.htm?id=I",{"href":"https://www.nps.gov/shil/learn/historyculture/monument-detail.htm?id=I","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Prentiss’s 6th Division tablet"]}],["$","a","https://www.nps.gov/shil/planyourvisit/maps.htm",{"href":"https://www.nps.gov/shil/planyourvisit/maps.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Shiloh maps"]}],["$","a","https://www.loc.gov/item/85690890/",{"href":"https://www.loc.gov/item/85690890/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Shiloh battlefield map"]}],["$","a","https://www.loc.gov/pictures/item/2018666477/",{"href":"https://www.loc.gov/pictures/item/2018666477/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Benjamin Prentiss portrait"]}]]}]
