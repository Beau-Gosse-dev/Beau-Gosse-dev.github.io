s/shiloh-hornets-nest-collapse.svg","alt":"Map of the artillery bombardment and encirclement of the Hornet’s Nest at Shiloh","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Collapse of the Hornet’s Nest"}],["$","span",null,{"children":"Ruggles’s artillery bombarded from the south. Withdrawals by Sherman, McClernand, and Hurlbut opened both flanks; Confederates then surrounded Wallace’s and Prentiss’s remaining troops."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/shiloh-hornets-nest-collapse.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ","$L16"]}],"$L17"]}],"$undefined"]}]]}],"$L18"]}]]}]
10:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The attack shifted to the United States center",{"className":"moment","children":[["$","$L19",null,{"seconds":347,"label":"5:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack shifted to the United States center"}],["$","p",null,{"children":"Patton Anderson took four regiments and two battalions across Duncan Field against W.H.L. Wallace’s line."}]]}]]}],["$","div","Anderson’s attack was repulsed",{"className":"moment","children":[["$","$L19",null,{"seconds":397,"label":"6:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Anderson’s attack was repulsed"}],["$","p",null,{"children":"Wallace’s infantry waited in the thickets and along the farm lane, then stopped the advance with close-range volleys."}]]}]]}],["$","div","Beauregard assigned Ruggles to the center",{"className":"moment","children":[["$","$L19",null,{"seconds":424,"label":"7:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Beauregard assigned Ruggles to the center"}],["$","p",null,{"children":"Daniel Ruggles took responsibility for the Confederate attacks against Wallace and Prentiss."}]]}]]}],["$","div","Ruggles decided to mass artillery",{"className":"moment","children":[["$","$L19",null,{"seconds":507,"label":"8:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ruggles decided to mass artillery"}],["$","p",null,{"children":"After earlier frontal attacks failed, he sent his staff to collect batteries from across the battlefield."}]]}]]}],["$","div","The Confederate batteries assembled",{"className":"moment","children":[["$","$L19",null,{"seconds":542,"label":"9:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate batteries assembled"}],["$","p",null,{"children":"The podcast describes all or parts of 12 batteries and about 60 guns; the NPS identifies 11 batteries and as many as 53 guns."}]]}]]}],["$","div","The bombardment began",{"className":"moment","children":[["$","$L19",null,{"seconds":565,"label":"9:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The bombardment began"}],["$","p",null,{"children":"The guns opened at about 4 p.m. and continued arriving until about 5 p.m. Many rounds passed over infantry sheltering close to the ground, but some defenders were killed or wounded."}]]}]]}],["$","div","Sherman and McClernand withdrew",{"className":"moment","children":[["$","$L19",null,{"seconds":709,"label":"11:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman and McClernand withdrew"}],["$","p",null,{"children":"At about 4 p.m., the two divisions moved northeast and formed along the Hamburg–Savannah Road, roughly one mile from the river."}]]}]]}],["$","div","Hurlbut withdrew from the United States left",{"className":"moment","children":[["$","$L19",null,{"seconds":745,"label":"12:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hurlbut withdrew from the United States left"}],["$","p",null,{"children":"Confederates moved between his flank and the river. His attempt to form at Cloud Field failed, and parts of the division ran to the final ridge above Pittsburg Landing."}]]}]]}],["$","div","Hurlbut rallied troops around the siege guns",{"className":"moment","children":[["$","$L19",null,{"seconds":843,"label":"14:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hurlbut rallied troops around the siege guns"}],["$","p",null,{"children":"Units that retained organization became rally points, and field batteries were placed beside the 24-pounder siege guns."}]]}]]}],["$","div","Prentiss’s left flank became exposed",{"className":"moment","children":[["$","$L19",null,{"seconds":899,"label":"14:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Prentiss’s left flank became exposed"}],["$","p",null,{"children":"Hurlbut’s courier was killed before delivering notice of the withdrawal. Prentiss bent his line back but did not immediately retreat."}]]}]]}],["$","div","Grant’s earlier order remained in effect",{"className":"moment","children":[["$","$L19",null,{"seconds":971,"label":"16:11"}],["$","div",null,{"children":["$L1a","$L1b"]}]]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]]}]
11:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Tennessee"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Ordered the center to hold and organized the final line above Pittsburg Landing"}]]}],["$","div","2nd Division",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division"}],["$","span",null,{"children":"W.H.L. Wallace"}],["$","small",null,{"children":"Tuttle’s and Sweeney’s brigades; ordered the late withdrawal and was mortally wounded"}]]}],["$","div","6th Division remnant",{"className":"command-entry","children":[["$","strong",null,{"children":"6th Division remnant"}],["$","span",null,{"children":"Benjamin M. Prentiss"}],["$","small",null,{"children":"Held the left half of the Hornet’s Nest and surrendered with most of his remaining command"}]]}],["$","div","Brigade, Wallace’s 2nd Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Wallace’s 2nd Division"}],["$","span",null,{"children":"Thomas W. Sweeney"}],["$","small",null,{"children":"7th and 58th Illinois remained after four regiments had been detached"}]]}],["$","div","Brigade, Wallace’s 2nd Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Wallace’s 2nd Division"}],["$","span",null,{"children":"James M. Tuttle"}],["$","small",null,{"children":"2nd, 7th, 12th, and 14th Iowa during the withdrawal"}]]}],["$","div","4th Division",{"className":"command-entry","children":[["$","strong",null,{"children":"4th Division"}],["$","span",null,{"children":"Stephen A. Hurlbut"}],["$","small",null,{"children":"Withdrew from the east and rallied survivors around the siege guns"}]]}],["$","div","United States right",{"className":"command-entry","children":[["$","strong",null,{"children":"United States right"}],["$","span",null,{"children":"William T. Sherman / John A. McClernand"}],["$","small",null,{"children":"Withdrew northeast to the Hamburg–Savannah Road at about 4 p.m."}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of the Mississippi",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Mississippi"}],["$","span",null,{"children":"P.G.T. Beauregard"}],["$","small",null,{"children":"Assigned Ruggles to direct operations against the United States center"}]]}],["$","div","Confederate attack on the center",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate attack on the center"}],["$","span",null,{"children":"Daniel Ruggles"}],["$","small",null,{"children":"Assembled the massed artillery and coordinated pressure on the Hornet’s Nest"}]]}],["$","div","Brigade, Ruggles’s Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Ruggles’s Division"}],["$","span",null,{"children":"Patton Anderson"}],["$","small",null,{"children":"Led the failed attack across Duncan Field before the artillery concentration"}]]}],["$","div","Infantry converging on the center",{"className":"command-entry","children":[["$","strong",null,{"children":"Infantry converging on the center"}],["$","span",null,{"children":"Braxton Bragg and other field commanders"}],["$","small",null,{"children":"Confederate brigades moved around both exposed flanks and closed the escape routes"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","W.H.L. Wallace",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WW"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"W.H.L. Wallace"}],"$L22"]}]]}],"$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b"]}]]}]
