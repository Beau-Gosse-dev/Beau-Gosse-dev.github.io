1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",121," · ","April 6, 1862, about 4 p.m. to 5:30 p.m.; W.H.L. Wallace died April 10"," · ","Duncan Field, the Hornet’s Nest, the Corinth Road, and the final United States line above Pittsburg Landing, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Eleventh)"}],["$","span",null,{"className":"result-label","children":"Patton Anderson’s frontal attack failed. Daniel Ruggles then assembled 11 Confederate batteries with as many as 53 guns and opened a sustained bombardment. At about 4 p.m., Sherman and McClernand withdrew from the west while Hurlbut withdrew from the east, leaving W.H.L. Wallace and Benjamin Prentiss exposed on both flanks. Wallace ordered a retreat but was shot in the head while directing it. Several regiments escaped; most of the 58th Illinois, 12th Iowa, 14th Iowa, and Prentiss’s remaining command were surrounded. Prentiss and about 2,200 United States soldiers surrendered at about 5:30 p.m. Wallace was recovered alive the next day and died on April 10"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2353872093.mp3?updated=1695211605","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Anderson’s attack",{"children":[["$","span",null,{"children":"Anderson’s attack"}],["$","strong",null,{"children":"Four regiments and two battalions; repulsed by close-range fire"}],"$undefined"]}],["$","div","Ruggles’s artillery",{"children":[["$","span",null,{"children":"Ruggles’s artillery"}],["$","strong",null,{"children":"11 batteries and as many as 53 guns"}],"$undefined"]}],["$","div","Bombardment began",{"children":[["$","span",null,{"children":"Bombardment began"}],["$","strong",null,{"children":"About 4 p.m."}],"$undefined"]}],["$","div","United States flanks",{"children":[["$","span",null,{"children":"United States flanks"}],["$","strong",null,{"children":"Sherman and McClernand withdrew on the right; Hurlbut withdrew on the left"}],"$undefined"]}],["$","div","Wallace’s withdrawal",{"children":[["$","span",null,{"children":"Wallace’s withdrawal"}],["$","strong",null,{"children":"Ordered after Thomas Sweeney reported that his remaining two regiments could not hold"}],"$undefined"]}],["$","div","Wallace wounded",{"children":[["$","span",null,{"children":"Wallace wounded"}],["$","strong",null,{"children":"Shot through the head while directing Tuttle’s brigade toward the Corinth Road"}],"$undefined"]}],["$","div","Captured",{"children":[["$","span",null,{"children":"Captured"}],["$","strong",null,{"children":"About 2,200 men from the 2nd and 6th Divisions, including Benjamin Prentiss"}],"$undefined"]}],["$","div","Position surrendered",{"children":[["$","span",null,{"children":"Position surrendered"}],["$","strong",null,{"children":"About 5:30 p.m."}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15"]}]]}]
