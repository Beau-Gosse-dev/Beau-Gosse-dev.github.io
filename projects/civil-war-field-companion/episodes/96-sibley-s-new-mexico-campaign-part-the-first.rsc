:"battle-facts","aria-label":"Battle facts","children":[["$","div","Texas secession ordinance",{"children":[["$","span",null,{"children":"Texas secession ordinance"}],["$","strong",null,{"children":"February 1, 1861"}],"$undefined"]}],["$","div","Texas referendum",{"children":[["$","span",null,{"children":"Texas referendum"}],["$","strong",null,{"children":"February 23: 46,100–14,600 for secession"}],"$undefined"]}],["$","div","U.S. property surrendered in Texas",{"children":[["$","span",null,{"children":"U.S. property surrendered in Texas"}],["$","strong",null,{"children":"February 18, 1861"}],"$undefined"]}],["$","div","Baylor entered New Mexico",{"children":[["$","span",null,{"children":"Baylor entered New Mexico"}],["$","strong",null,{"children":"July 23, 1861"}],"$undefined"]}],["$","div","Fort Fillmore evacuated",{"children":[["$","span",null,{"children":"Fort Fillmore evacuated"}],["$","strong",null,{"children":"1 a.m., July 27"}],"$undefined"]}],["$","div","Forces stated in episode",{"children":[["$","span",null,{"children":"Forces stated in episode"}],["$","strong",null,{"children":"Fewer than 300 Texans captured more than 500 U.S. troops"}],"$undefined"]}],["$","div","Confederate Arizona proclaimed",{"children":[["$","span",null,{"children":"Confederate Arizona proclaimed"}],["$","strong",null,{"children":"August 1, 1861"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The campaign area today",{"className":"reference-map","children":[["$","div",null,{"className":"