f:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.libsyn.com/96-sibleys-new-mexico-campaign-part-the-first",{"href":"https://civilwarpodcast.libsyn.com/96-sibleys-new-mexico-campaign-part-the-first","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 96"]}],["$","a","https://www.nps.gov/elca/learn/historyculture/the-civil-war.htm",{"href":"https://www.nps.gov/elca/learn/historyculture/the-civil-war.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: The Civil War on El Camino Real"]}],["$","a","https://www.nps.gov/elca/learn/management/upload/Comprehensive-Management-Plan-Appendixes-E-and-F-508.pdf",{"href":"https://www.nps.gov/elca/learn/management/upload/Comprehensive-Management-Plan-Appendixes-E-and-F-508.pdf","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Mesilla historic-site documentation"]}],["$","a","https://www.nps.gov/civilwar/search-battle-units-detail.htm?battleUnitCode=UUR0007RI",{"href":"https://www.nps.gov/civilwar/search-battle-units-detail.htm?battleUnitCode=UUR0007RI","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: 7th U.S. Infantry service record"]}],["$","a","https://www.nps.gov/articles/the-battle-of-glorieta-pass-a-shattered-dream-teaching-with-historic-places.htm",{"href":"https://www.nps.gov/articles/the-battle-of-glorieta-pass-a-shattered-dream-teaching-with-historic-places.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Glorieta Pass campaign overview"]}],["$","a","https://www.loc.gov/resource/g4030.fi000103/",{"href":"https://www.loc.gov/resource/g4030.fi000103/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: 1857 map of Texas and New Mexico"]}],["$","a","https://www.loc.gov/pictures/item/2018670405/",{"href":"https://www.loc.gov/pictures/item/2018670405/","target":"_blank","rel":"noreferrer","children":["