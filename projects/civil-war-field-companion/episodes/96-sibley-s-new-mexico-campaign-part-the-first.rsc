12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The New Mexico campaign extended the war far west",{"className":"moment","children":[["$","$L17",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The New Mexico campaign extended the war far west"}],["$","p",null,{"children":"The 1861–62 Confederate invasion of New Mexico was the westernmost major campaign of the Civil War and included two major battles and several smaller engagements."}]]}]]}],["$","div","Davis authorized Sibley to organize a brigade",{"className":"moment","children":[["$","$L17",null,{"seconds":129,"label":"2:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis authorized Sibley to organize a brigade"}],["$","p",null,{"children":"Henry Hopkins Sibley resigned his U.S. Army commission, presented a plan to Jefferson Davis, and received authority on July 5, 1861, to raise mounted volunteers in Texas and drive U.S. forces from New Mexico."}]]}]]}],["$","div","Sibley planned a wider western advance",{"className":"moment","children":[["$","$L17",null,{"seconds":205,"label":"3:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sibley planned a wider western advance"}],["$","p",null,{"children":"According to his artillery chief, Sibley intended to take New Mexico, move into Colorado’s mining districts, and eventually reach ports in Southern California."}]]}]]}],["$","div","Kit Carson entered U.S. service",{"className":"moment","children":[["$","$L17",null,{"seconds":250,"label":"4:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kit Carson entered U.S. service"}],["$","p",null,{"children":"Carson became lieutenant colonel of the 1st New Mexico Volunteer Infantry. The episode uses him to introduce local opposition to the Confederate invasion."}]]}]]}],["$","div","New Mexico Territory covered a much larger area",{"className":"moment","children":[["$","$L17",null,{"seconds":432,"label":"7:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"New Mexico Territory covered a much larger area"}],["$","p",null,{"children":"In 1860 the territory included present-day New Mexico and Arizona and the southern tip of Nevada, with about 100,000 residents."}]]}]]}],["$","div","Roads and the Rio Grande controlled movement",{"className":"moment","children":[["$","$L17",null,{"seconds":478,"label":"7:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Roads and the Rio Grande controlled movement"}],["$","p",null,{"children":"The Santa Fe Trail entered from the northeast, the Overland Mail route crossed southern New Mexico, and the Camino Real followed the Rio Grande. The territory had no railroad or telegraph."}]]}]]}],["$","div","Texas secessionists bypassed Sam Houston",{"className":"moment","children":[["$","$L17",null,{"seconds":762,"label":"12:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Texas secessionists bypassed Sam Houston"}],["$","p",null,{"children":"Delegates elected without effective Unionist opposition met at Austin and adopted a secession ordinance on February 1, 1861, by 166 votes to 8."}]]}]]}],["$","div","A committee began seizing U.S. property",{"className":"moment","children":[["$","$L17",null,{"seconds":863,"label":"14:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"A committee began seizing U.S. property"}],["$","p",null,{"children":"Before the public referendum, the convention created a Committee of Public Safety and authorized it to take federal posts, supplies, and other property in Texas."}]]}]]}],["$","div","Texas demanded the surrender of the Department of Texas",{"className":"moment","children":[["$","$L17",null,{"seconds":966,"label":"16:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Texas demanded the surrender of the Department of Texas"}],["$","p",null,{"children":"The committee sent commissioners to David Twiggs while Ben McCulloch brought about 1,000 armed men into San Antonio to support the demand."}]]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]]}]
