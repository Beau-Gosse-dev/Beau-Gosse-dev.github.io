18:["$","div","Twiggs surrendered U.S. posts and supplies",{"className":"moment","children":[["$","$L17",null,{"seconds":1094,"label":"18:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Twiggs surrendered U.S. posts and supplies"}],["$","p",null,{"children":"On February 18, Twiggs agreed to turn over federal buildings, military property, and 19 forts and posts. Roughly 2,500 U.S. soldiers were ordered to leave Texas by the Gulf Coast."}]]}]]}]
19:["$","div","Texas voters approved secession",{"className":"moment","children":[["$","$L17",null,{"seconds":1208,"label":"20:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Texas voters approved secession"}],["$","p",null,{"children":"The February 23 referendum passed 46,100 to 14,600. Sam Houston refused to swear allegiance to the Confederacy and was removed as governor in March."}]]}]]}]
1a:["$","div","Texas formed mounted regiments for its frontier",{"className":"moment","children":[["$","$L17",null,{"seconds":1288,"label":"21:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Texas formed mounted regiments for its frontier"}],["$","p",null,{"children":"John R. Baylor became lieutenant colonel of the 2nd Texas Mounted Rifles and was sent west to secure abandoned U.S. posts, including Fort Bliss."}]]}]]}]
1b:["$","div","Van Dorn ordered Baylor toward Fort Fillmore",{"className":"moment","children":[["$","$L17",null,{"seconds":1487,"label":"24:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Van Dorn ordered Baylor toward Fort Fillmore"}],["$","p",null,{"children":"Earl Van Dorn sent Baylor from San Antonio to West Texas and authorized an attack on Fort Fillmore, about 40 miles north of Fort Bliss."}]]}]]}]
1c:["$","div","The march reduced Baylor’s force",{"className":"moment","children":[["$","$L17",null,{"seconds":1551,"label":"25:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The march reduced Baylor’s force"}],["$","p",null,{"children":"About 1,000 men left San Antonio, but desertion, illness, heat, fatigue, and detachments at posts left roughly 400 at El Paso in early July."}]]}]]}]
1d:["$","div","Baylor invaded New Mexico with fewer than 300 men",{"className":"moment","children":[["$","$L17",null,{"seconds":1613,"label":"26:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Baylor invaded New Mexico with fewer than 300 men"}],["$","p",null,{"children":"He moved north on July 23. After a deserter warned Fort Fillmore, Baylor crossed the Rio Grande and entered Mesilla."}]]}]]}]
1e:["$","div","Lynde failed to remove Baylor from Mesilla",{"className":"moment","children":[["$","$L17",null,{"seconds":1659,"label":"27:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lynde failed to remove Baylor from Mesilla"}],["$","p",null,{"children":"Major Isaac Lynde brought most of his larger garrison across the river, made an unsuccessful attack on July 25, and returned to Fort Fillmore."}]]}]]}]
1f:["$","div","The U.S. garrison evacuated Fort Fillmore",{"className":"moment","children":[["$","$L17",null,{"seconds":1744,"label":"29:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. garrison evacuated Fort Fillmore"}],["$","p",null,{"children":"Lynde left at 1 a.m. on July 27 and took the desert road toward Fort Stanton. Heat, lack of water, and whiskey taken from the post weakened and scattered the column."}]]}]]}]
20:["$","div","Lynde surrendered near San Augustine Springs",{"className":"moment","children":[["$","$L17",null,{"seconds":1808,"label":"30:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lynde surrendered near San Augustine Springs"}],["$","p",null,{"children":"Only about 100 soldiers formed when Baylor caught the column. Lynde surrendered more than 500 men to fewer than 300 Texans without a final exchange of fire."}]]}]]}]
21:["$","div","Baylor proclaimed Confederate Arizona",{"className":"moment","children":[["$","$L17",null,{"seconds":1867,"label":"31:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Baylor proclaimed Confederate Arizona"}],["$","p",null,{"children":"Unable to continue north with his small force, Baylor remained at Mesilla. On August 1 he declared the area south of the 34th parallel the Confederate Territory of Arizona and named himself governor."}]]}]]}]
22:["$","h3",null,{"children":"Henry H. Sibley"}]
23:["$","p",null,{"children":"Proposed the New Mexico invasion and organized the larger force that would follow Baylor"}]
