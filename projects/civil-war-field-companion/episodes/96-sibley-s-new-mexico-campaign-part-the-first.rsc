","children":[["$","strong",null,{"children":"Battalion, 2nd Texas Mounted Rifles"}],["$","span",null,{"children":"John R. Baylor"}],["$","small",null,{"children":"Occupied Mesilla, captured Lynde’s force, and proclaimed Confederate Arizona"}]]}],["$","div","Army of New Mexico being organized",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of New Mexico being organized"}],["$","span",null,{"children":"Henry H. Sibley"}],["$","small",null,{"children":"Raised a larger Texas brigade for the next phase of the invasion"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","John R. Baylor",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JR"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"John R. Baylor"}],["$","p",null,{"children":"Led the first Confederate invasion of New Mexico, captured the Fort Fillmore garrison, and proclaimed Confederate Arizona"}]]}]]}],["$","article","Isaac Lynde",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"IL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Isaac Lynde"}],["$","p",null,{"children":"Commanded Fort Fillmore and surrendered more than 500 U.S. soldiers after the desert retreat"}]]}]]}],["$","article","David E. Twiggs",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/david-twiggs.jpg","alt":"Portrait of David E. Twiggs","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h