3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"#496- STEPPING INTO HELL: The Soldier's Ordeal During the Overland Campaign · Field Companion"}],["$","meta","1",{"name":"description","content":"In which we look at the physical misery & psychological strain endured by the soldiers during the Overland Campaign."}],["$","meta","2",{"property":"og:title","content":"#496- STEPPING INTO HELL: The Soldier's Ordeal During the Overland Campaign · Field Companion"}],["$","meta","3",{"property":"og:description","content":"In which we look at the physical misery & psychological strain endured by the soldiers during the Overland Campaign."}],["$","meta","4",{"name":"twitter:card","content":"summary"}],["$","meta","5",{"name":"twitter:title","content":"#496- STEPPING INTO HELL: The Soldier's Ordeal During the Overland Campaign · Field Companion"}],["$","meta","6",{"name":"twitter:description","content":"In which we look at the physical misery & psychological strain endured by the soldiers during the Overland Campaign."}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["episodes","496-stepping-into-hell-the-soldier-s-ordeal-during-the-overland-campaign"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"episodes","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error