15:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
17:["$","h3",null,{"children":"Uniforms went unchanged for weeks"}]
18:["$","p",null,{"children":"Rufus Dawes wrote on May 25 that he had worn the same clothing since May 3. Boiling uniforms killed lice but could shrink the clothing."}]
19:["$","div","Shelter and sleep were limited",{"className":"moment","children":[["$","$L16",null,{"seconds":725,"label":"12:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shelter and sleep were limited"}],["$","p",null,{"children":"Many men slept on the ground or in trenches under a rubber blanket. One officer estimated soldiers averaged only two to four hours of sleep per day."}]]}]]}]
1a:["$","div","Illness removed thousands from duty",{"className":"moment","children":[["$","$L16",null,{"seconds":865,"label":"14:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Illness removed thousands from duty"}],["$","p",null,{"children":"Poor food, bad water, insects, mud, and exhaustion produced diarrhea, fever, and other disease. Records list 4,225 sick soldiers evacuated from Fredericksburg to Washington."}]]}]]}]
1b:["$","div","Both armies wanted rest",{"className":"moment","children":[["$","$L16",null,{"seconds":931,"label":"15:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both armies wanted rest"}],["$","p",null,{"children":"Confederate general Bryan Grimes wrote on May 19 that his men had fought or skirmished for fifteen days and were nearly exhausted."}]]}]]}]
1c:["$","div","Repeated danger produced psychological strain",{"className":"moment","children":[["$","$L16",null,{"seconds":958,"label":"15:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Repeated danger produced psychological strain"}],["$","p",null,{"children":"Civil War battles usually exposed troops to intense danger for hours rather than weeks. During the Overland Campaign, soldiers remained under threat with little return to safety."}]]}]]}]
1d:["$","div","Soldiers relied on duty, belief, and expectations of survival",{"className":"moment","children":[["$","$L16",null,{"seconds":1117,"label":"18:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Soldiers relied on duty, belief, and expectations of survival"}],["$","p",null,{"children":"The episode describes two common supports: a conscious belief that remaining in danger was required and an expectation that the individual might survive even when others did not."}]]}]]}]
1e:["$","div","Religion and fatalism helped soldiers manage fear",{"className":"moment","children":[["$","$L16",null,{"seconds":1156,"label":"19:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Religion and fatalism helped soldiers manage fear"}],["$","p",null,{"children":"Many soldiers relied on Christian belief or accepted that they could not control the outcome. Religious revivals had spread through both armies before the campaign."}]]}]]}]
1f:["$","div","Physical fear did not always prevent action",{"className":"moment","children":[["$","$L16",null,{"seconds":1306,"label":"21:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Physical fear did not always prevent action"}],["$","p",null,{"children":"Accounts describe trembling and dread before combat, followed by effective action once fighting began. The body’s immediate stress response could help temporarily."}]]}]]}]
20:["$","div","Constant exposure reduced the ability to function",{"className":"moment","children":[["$","$L16",null,{"seconds":1381,"label":"23:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Constant exposure reduced the ability to function"}],["$","p",null,{"children":"After many days, anxiety and sleep loss made stress harder to manage. Soldiers reported that remaining in a continuous state of excitement was exhausting."}]]}]]}]
21:["$","div","The North Anna pause restored some effectiveness",{"className":"moment","children":[["$","$L16",null,{"seconds":1464,"label":"24:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The North Anna pause restored some effectiveness"}],["$","p",null,{"children":"For about two days the armies were not in close contact. Soldiers slept and briefly recovered before fighting increased again."}]]}]]}]
22:["$","div","Veteran units became less reliable under accumulated strain",{"className":"moment","children":[["$","$L16",null,{"seconds":1517,"label":"25:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Veteran units became less reliable under accumulated strain"}],["$","p",null,{"children":"Observers saw reduced willingness to complete attacks and sudden collapses in units that previously had fought well, including the Iron Brigade at Jericho Mill."}]]}]]}]
23:["$","div","Army of the Potomac veterans faced additional concerns",{"className":"moment","children":[["$","$L16",null,{"seconds":1551,"label":"25:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Army of the Potomac veterans faced additional concerns"}],["$","p",null,{"children":"They distrusted some replacements and knew many experienced regiments were close to the end of their enlistments. Those perceptions affected confidence even when the short-term soldiers continued to fight."}]]}]]}]
