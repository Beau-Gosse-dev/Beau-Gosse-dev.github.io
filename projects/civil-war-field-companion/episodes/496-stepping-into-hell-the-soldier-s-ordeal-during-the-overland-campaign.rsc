on",{"children":[["$","span",null,{"children":"Confederate flour or cornmeal ration"}],["$","strong",null,{"children":"About 1½ pounds daily"}],"$undefined"]}],["$","div","Cattle with the Army of the Potomac",{"children":[["$","span",null,{"children":"Cattle with the Army of the Potomac"}],["$","strong",null,{"children":"More than 1,000"}],"$undefined"]}],["$","div","Estimated sleep for many U.S. soldiers",{"children":[["$","span",null,{"children":"Estimated sleep for many U.S. soldiers"}],["$","strong",null,{"children":"2–4 hours per day"}],"$undefined"]}],["$","div","Sick evacuated from Fredericksburg",{"children":[["$","span",null,{"children":"Sick evacuated from Fredericksburg"}],["$","strong",null,{"children":"4,225"}],"$undefined"]}],["$","div","Share of recorded evacuations caused by sickness",{"children":[["$","span",null,{"children":"Share of recorded evacuations caused by sickness"}],["$","strong",null,{"children":"More than 16%"}],"$undefined"]}],["$","div","Estimated Army of Northern Virginia conversions",{"children":[["$","span",null,{"children":"Estimated Army of Northern Virginia conversions"}],["$","strong",null,{"children":"About 7,000"}],["$","small",null,{"children":"During the religious revivals of winter 1863–64"}]]}],["$","div","North Anna break in close contact",{"children":[["$","span",null,{"children":"North Anna break in close contact"}],["$","strong",null,{"children":"About 2 days"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The Overland Campa