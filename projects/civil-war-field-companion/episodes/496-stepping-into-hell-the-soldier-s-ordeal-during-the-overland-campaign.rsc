27:["$","article","Bryan Grimes",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"BG"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Bryan Grimes"}],["$","p",null,{"children":"Reported that Confederate soldiers needed rest after fifteen days of nearly continuous fighting"}]]}]]}]
28:["$","article","John C. Worsham",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JC"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"John C. Worsham"}],["$","p",null,{"children":"Confederate sergeant who described daily rations at roughly half the prescribed amount"}]]}]]}]
