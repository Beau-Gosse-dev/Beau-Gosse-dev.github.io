e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Overland Campaign route"}],["$","span",null,{"children":"The armies fought and marched from the Wilderness through Spotsylvania and the North Anna toward Cold Harbor. The sustained movement gave soldiers little time to eat, sleep, wash, or recover."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
f:["$","figure","The Wilderness and Spotsylvania area today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-78.10%2C37.85%2C-77.15%2C38.55&layer=mapnik&marker=38.3104%2C-77.7467","title":"The Wilderness and Spotsylvania area today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Wilderness and Spotsylvania area today"}],["$","span",null,{"children":"The first weeks of the campaign took place in a wooded region crossed by small streams and roads. Water sources were limited or difficult to reach during combat."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
10:["$","figure","From the North Anna to Cold Harbor",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.80%2C37.45%2C-77.05%2C38.15&layer=mapnik&marker=37.5892%2C-77.2886","title":"From the North Anna to Cold Harbor","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From the North Anna to Cold Harbor"}],["$","span",null,{"children":"A short reduction in close contact at the North Anna allowed some units to sleep before the armies moved southeast into another week of fighting."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The campaign imposed continuous stress",{"className":"moment","children":[["$","$L16",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign imposed continuous stress"}],["$","p",null,{"children":"Soldiers marched, fought, dug earthworks, and stood picket duty for weeks with few long pauses. Grant and enlisted men counted the consecutive days of combat in their letters."}]]}]]}],["$","div","Rain on May 17 created a needed pause",{"className":"moment","children":[["$","$L16",null,{"seconds":171,"label":"2:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rain on May 17 created a needed pause"}],["$","p",null,{"children":"One soldier wrote that his unit had worked day and night for about two weeks, far longer than the two- or three-day battles he had experienced before."}]]}]]}],["$","div","Soldiers had to maintain themselves",{"className":"moment","children":[["$","$L16",null,{"seconds":200,"label":"3:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Soldiers had to maintain themselves"}],["$","p",null,{"children":"Besides fighting and marching, individuals found water, cooked food, cleaned clothing, built shelter, dug works, and buried the dead. Exhaustion made many of those tasks impossible."}]]}]]}],["$","div","Many soldiers fought without regular meals",{"className":"moment","children":[["$","$L16",null,{"seconds":240,"label":"4:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Many soldiers fought without regular meals"}],["$","p",null,{"children":"After the first day in the Wilderness, some men slept instead of eating. Fighting resumed before they could prepare breakfast."}]]}]]}],["$","div","Confederate rations were below the official allowance",{"className":"moment","children":[["$","$L16",null,{"seconds":273,"label":"4:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate rations were below the official allowance"}],["$","p",null,{"children":"John Worsham recalled roughly half a pound of meat and limited bread or meal each day. Real coffee was issued rarely and in very small quantities."}]]}]]}],["$","div","U.S. rations were larger but repetitive",{"className":"moment","children":[["$","$L16",null,{"seconds":339,"label":"5:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. rations were larger but repetitive"}],["$","p",null,{"children":"Army of the Potomac soldiers commonly received salt pork and hardtack. Marches and mud sometimes separated units from their supply wagons for one or two days."}]]}]]}],["$","div","The Army of the Potomac moved cattle with it",{"className":"moment","children":[["$","$L16",null,{"seconds":380,"label":"6:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Potomac moved cattle with it"}],["$","p",null,{"children":"More than 1,000 cattle supplied occasional fresh beef, but soldiers also had to herd, slaughter, and butcher the animals."}]]}]]}],["$","div","Safe drinking water was difficult to obtain",{"className":"moment","children":[["$","$L16",null,{"seconds":473,"label":"7:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Safe drinking water was difficult to obtain"}],["$","p",null,{"children":"Streams in the Wilderness were few and could be distant from units under fire. Later in the campaign, soldiers described drinking contaminated swamp water."}]]}]]}],["$","div","Vegetation and insects caused additional problems",{"className":"moment","children":[["$","$L16",null,{"seconds":547,"label":"9:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Vegetation and insects caused additional problems"}],["$","p",null,{"children":"Poison ivy, ticks, mosquitoes, horseflies, and lice affected daily life. Soldiers often had no time to wash clothes or remove lice."}]]}]]}],["$","div","Uniforms went unchanged for weeks",{"className":"moment","children":[["$","$L16",null,{"seconds":708,"label":"11:48"}],["$","div",null,{"children":["$L17","$L18"]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","General-in-chief",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Kept the army moving and fighting while acknowledging the campaign’s sustained bloodshed"}]]}],["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"George G. Meade"}],["$","small",null,{"children":"Directed the field army and its corps through continuous operations"}]]}],["$","div","IX Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"IX Corps"}],["$","span",null,{"children":"Ambrose E. Burnside"}],["$","small",null,{"children":"Included in the evacuation statistics cited for the Army of the Potomac"}]]}],["$","div","6th Wisconsin Infantry",{"className":"command-entry","children":[["$","strong",null,{"children":"6th Wisconsin Infantry"}],["$","span",null,{"children":"Rufus R. Dawes"}],["$","small",null,{"children":"Recorded the effects of lice, unchanged clothing, and repeated combat on his men"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Robert E. Lee"}],["$","small",null,{"children":"Sustained defensive operations despite food shortages and exhaustion"}]]}],["$","div","Second Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Corps"}],["$","span",null,{"children":"Jubal A. Early"}],["$","small",null,{"children":"Described the limited meal served at Lee’s headquarters during Spotsylvania"}]]}],["$","div","Brigade, Second Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Second Corps"}],["$","span",null,{"children":"Bryan Grimes"}],["$","small",null,{"children":"Reported on May 19 that his troops were nearly exhausted after fifteen days of fighting"}]]}],["$","div","21st Virginia Infantry",{"className":"command-entry","children":[["$","strong",null,{"children":"21st Virginia Infantry"}],["$","span",null,{"children":"John C. Worsham"}],["$","small",null,{"children":"Recorded the reduced Confederate ration and shortage of coffee"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Ulysses S. Grant",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Ulysses S. Grant"}],["$","p",null,{"children":"Directed the campaign and wrote repeatedly about its unusually long and bloody character"}]]}]]}],["$","article","Rufus R. Dawes",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"RR"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Rufus R. Dawes"}],["$","p",null,{"children":"6th Wisconsin commander whose letters and memoir described lice, clothing, fatigue, and entrenchment duties"}]]}]]}],["$","article","Theodore Gerrish",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"TG"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Theodore Gerrish"}],["$","p",null,{"children":"20th Maine private who described sleeping on hard ground during the campaign"}]]}]]}],["$","article","Robert E. Lee",{"className":"person-card","children":["$L24","$L25"]}],"$L26","$L27","$L28"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/overland-campaign-1864-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland Campaign route","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The campaign required repeated fighting and marching across eastern Virginia during May and June 1864."}]]}],["$","figure","/images/cold-harbor-rifle-pits-drawing.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/cold-harbor-rifle-pits-drawing.jpg","alt":"1864 drawing of soldiers and rifle pits near Cold Harbor","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Soldiers constructed and occupied earthworks while remaining exposed to artillery and small-arms fire."}]]}],["$","figure","/images/spotsylvania-field-hospital-drawing.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/spotsylvania-field-hospital-drawing.jpg","alt":"1864 drawing of the Fifth Corps field hospital at Spotsylvania Court House","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Illness joined battle wounds as a major reason soldiers left the front during the campaign."}]]}],["$","figure","/images/cold-harbor-battlefield.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/cold-harbor-battlefield.jpg","alt":"Historical photograph of the Cold Harbor battlefield","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"By the end of the campaign, the armies had spent weeks fighting, marching, digging, and sleeping outdoors."}]]}]]}]]}]
