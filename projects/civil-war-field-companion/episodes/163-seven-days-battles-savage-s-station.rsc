1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",163," · ","June 28–30, 1862 (battle on June 29)"," · ","Savage’s Station and Allen’s Farm on the Richmond & York River Railroad east of Richmond, Virginia, with the Army of the Potomac withdrawing south through White Oak Swamp toward the James River"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: SAVAGE'S STATION"}],["$","span",null,{"className":"result-label","children":"The Battle of Savage’s Station was tactically indecisive. John B. Magruder attacked the United States rear guard late on June 29 but committed only part of his command and did not stop the withdrawal. Edwin V. Sumner’s troops held until darkness, then crossed White Oak Swamp. The Confederates occupied the field and captured the sick and wounded left at the station, but Robert E. Lee failed to trap the retreating army north of the swamp"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2764527674.mp3?updated=1695385058","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The June 29 pursuit and Battle of Savage’s Station"}],["$","small",null,{"children":"The episode follows the Army of the Potomac’s withdrawal after Gaines’s Mill, the battle at Savage’s Station, and the night march through White Oak Swamp."}]]}],["$","div","Federal objective",{"children":[["$","span",null,{"children":"Federal objective"}],["$","strong",null,{"children":"Move the army and supply trains to a new base on the James River"}],["$","small",null,{"children":"McClellan called the operation a change of base. Two corps moved toward Malvern Hill while the remaining corps covered the roads and White Oak Swamp crossings."}]]}],["$","div","Withdrawal begins",{"children":[["$","span",null,{"children":"Withdrawal begins"}],["$","strong",null,{"children":"Early June 28"}],["$","small",null,{"children":"Men, artillery, livestock, and wagons moved south toward the limited crossings through White Oak Swamp."}]]}],["$","div","Lee identifies the route",{"children":[["$","span",null,{"children":"Lee identifies the route"}],["$","strong",null,{"children":"Before daylight on June 29"}],["$","small",null,{"children":"Lee concluded that McClellan was moving toward the James and issued pursuit orders to his division commanders."}]]}],["$","div","Lee’s June 29 plan",{"children":[["$","span",null,{"children":"Lee’s June 29 plan"}],["$","strong",null,{"children":"Fix the rear guard north of White Oak Swamp while other columns moved toward Glendale"}],["$","small",null,{"children":"Magruder was to advance east on the Williamsburg Road, Jackson was to cross the Chickahominy on Magruder’s left, and Huger was to use the Charles City Road. Longstreet and A. P. Hill had the longer march toward Glendale for the following day."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}],"$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e"]}]]}]
31:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Savage’s Station function",{"children":[["$","span",null,{"children":"Savage’s Station function"}],["$","strong",null,{"children":"Rail depot, supply point, headquarters site, and field hospital"}],["$","small",null,{"children":"The Richmond & York River Railroad connected the station to the former Federal supply base at White House Landing."}]]}]
f:["$","div","Hospital population",{"children":[["$","span",null,{"children":"Hospital population"}],["$","strong",null,{"children":"More than 3,000 sick and wounded before the retreat"}],["$","small",null,{"children":"The episode states that about 2,500 men who could not be transported were left at the hospital and became prisoners. These patients were separate from the battle’s casualty count."}]]}]
10:["$","div","Destroyed materiel",{"children":[["$","span",null,{"children":"Destroyed materiel"}],["$","strong",null,{"children":"Food, equipment, rolling stock, and ammunition that could not be moved"}],["$","small",null,{"children":"United States troops burned large stores and railroad cars. The episode also describes an ammunition train sent toward the destroyed Chickahominy bridge."}]]}]
11:["$","div","Rear-guard command",{"children":[["$","span",null,{"children":"Rear-guard command"}],["$","strong",null,{"children":"No single commander was formally designated by McClellan"}],["$","small",null,{"children":"Sumner, Heintzelman, and Franklin received withdrawal instructions, but coordination depended on communication among three corps commanders after McClellan moved south of White Oak Swamp."}]]}]
12:["$","div","Allen’s Farm position",{"children":[["$","span",null,{"children":"Allen’s Farm position"}],["$","strong",null,{"children":"Sumner stopped about two miles west of Savage’s Station"}],["$","small",null,{"children":"He resisted withdrawing to the assigned line until Franklin personally explained the danger to William F. Smith’s exposed division. Sumner fell back at about 11 a.m."}]]}]
13:["$","div","Unified Federal line",{"children":[["$","span",null,{"children":"Unified Federal line"}],["$","strong",null,{"children":"Established near Savage’s Station by about 1 p.m."}],["$","small",null,{"children":"The line contained Sumner’s II Corps and elements of Franklin’s VI Corps while other troops and trains continued toward White Oak Swamp."}]]}]
14:["$","div","Heintzelman’s withdrawal",{"children":[["$","span",null,{"children":"Heintzelman’s withdrawal"}],["$","strong",null,{"children":"III Corps left before the late-afternoon battle"}],["$","small",null,{"children":"Heintzelman judged that the area contained more troops than could be used and marched south without informing Sumner or Franklin, leaving the Federal left unexpectedly exposed."}]]}]
15:["$","div","Magruder’s effective strength",{"children":[["$","span",null,{"children":"Magruder’s effective strength"}],["$","strong",null,{"children":"About 14,000 men available; only about 3,000 engaged"}],["$","small",null,{"children":"The episode states that nine Confederate regiments entered the main fight. Strength totals are approximate and vary with the units and time counted."}]]}]
16:["$","div","Federal force late in the day",{"children":[["$","span",null,{"children":"Federal force late in the day"}],["$","strong",null,{"children":"About 16,000 men under Sumner after other divisions departed"}],["$","small",null,{"children":"This is the episode’s estimate for Sumner’s remaining command before Smith’s nearest brigade returned. Battlefield strength estimates vary by source."}]]}]
17:["$","div","Magruder’s delay",{"children":[["$","span",null,{"children":"Magruder’s delay"}],["$","strong",null,{"children":"He waited for support that Lee had not intended him to require before advancing"}],["$","small",null,{"children":"Magruder expected Huger on his right and Jackson in direct cooperation on his left. Lee intended Magruder to initiate the pursuit and Jackson to support it after crossing the river."}]]}]
18:["$","div","Temporary reinforcement",{"children":[["$","span",null,{"children":"Temporary reinforcement"}],["$","strong",null,{"children":"Two of Huger’s brigades were offered only until 2 p.m."}],["$","small",null,{"children":"Because no major fighting had begun by the deadline, Huger recalled the brigades for the march toward Glendale."}]]}]
19:["$","div","Jackson’s delay",{"children":[["$","span",null,{"children":"Jackson’s delay"}],["$","strong",null,{"children":"His command remained north of the Chickahominy and did not fight at Savage’s Station"}],["$","small",null,{"children":"Bridge repairs progressed slowly. Jackson then interpreted a forwarded contingency message as a reason to remain north of the river, although Lee later said that interpretation was mistaken."}]]}]
1a:["$","div","Confederate attack order",{"children":[["$","span",null,{"children":"Confederate attack order"}],["$","strong",null,{"children":"Issued by Magruder at about 4 p.m."}],["$","small",null,{"children":"The principal engagement began near 5 p.m., after the best opportunity to catch a larger portion of the Federal rear guard had passed."}]]}]
1b:["$","div","Confederate deployment",{"children":[["$","span",null,{"children":"Confederate deployment"}],["$","strong",null,{"children":"Kershaw near the railroad, Semmes across the Williamsburg Road, and part of Griffith’s brigade farther south"}],["$","small",null,{"children":"William Barksdale directed Griffith’s brigade after Griffith was wounded. Dense woods disrupted the Confederate right, and some regiments fired on friendly troops before finding the Federal line."}]]}]
1c:["$","div","Railroad gun",{"children":[["$","span",null,{"children":"Railroad gun"}],["$","strong",null,{"children":"A 32-pound naval gun mounted on a protected railroad car"}],["$","small",null,{"children":"Often called the “Land Merrimac,” it supported the Confederate left along the railroad. The episode describes it as visually imposing but ineffective."}]]}]
1d:["$","div","Federal response",{"children":[["$","span",null,{"children":"Federal response"}],["$","strong",null,{"children":"Sumner committed nearby regiments and recalled William T. H. Brooks’s brigade"}],["$","small",null,{"children":"Brooks’s brigade returned from its movement toward White Oak Swamp and reinforced the threatened sector south of the Williamsburg Road."}]]}]
1e:["$","div","Brooks’s brigade losses",{"children":[["$","span",null,{"children":"Brooks’s brigade losses"}],["$","strong",null,{"children":"Nearly 450 casualties in the episode’s account"}],["$","small",null,{"children":"The episode states that the 5th Vermont lost nearly half its strength. Regimental and brigade totals differ among compilations."}]]}]
1f:["$","div","Battle duration",{"children":[["$","span",null,{"children":"Battle duration"}],["$","strong",null,{"children":"About 5 p.m. to 9 p.m."}],["$","small",null,{"children":"The fighting extended across the railroad and Williamsburg Road sectors and ended in darkness as rain began."}]]}]
20:["$","div","Battle casualties",{"children":[["$","span",null,{"children":"Battle casualties"}],["$","strong",null,{"children":"United States 919; Confederacy 444"}],["$","small",null,{"children":"These are the National Park Service estimates. The episode gives ranges of 600–1,000 United States casualties and 375–475 Confederate casualties."}]]}]
21:["$","div","Important leader loss",{"children":[["$","span",null,{"children":"Important leader loss"}],["$","strong",null,{"children":"Brig. Gen. Richard Griffith mortally wounded"}],["$","small",null,{"children":"Griffith was struck during the Confederate attack and died shortly afterward in Richmond. Sources differ on whether his death occurred late June 29 or on June 30."}]]}]
22:["$","div","Tactical result",{"children":[["$","span",null,{"children":"Tactical result"}],["$","strong",null,{"children":"Indecisive"}],["$","small",null,{"children":"The Confederates occupied the field after the Federal night withdrawal, but neither side broke the opposing battle line during the main engagement."}]]}]
23:["$","div","Operational result",{"children":[["$","span",null,{"children":"Operational result"}],["$","strong",null,{"children":"The Army of the Potomac escaped north of the swamp"}],["$","small",null,{"children":"The rear guard withdrew after dark, and the last Federal troops crossed White Oak Swamp shortly before 10 a.m. on June 30."}]]}]
24:["$","div","Lee’s assessment",{"children":[["$","span",null,{"children":"Lee’s assessment"}],["$","strong",null,{"children":"The pursuit had made too little progress"}],["$","small",null,{"children":"Lee rebuked Magruder that night and emphasized the need to move before McClellan escaped. The episode also assigns army-level responsibility to Lee for unclear orders and inadequate staff supervision."}]]}]
25:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“To the Gates of Richmond” by Stephen W. Sears"}],["$","small",null,{"children":"The episode closing identifies Sears’s study of the Peninsula Campaign as its recommendation."}]]}]
26:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Heintzelman, Huger, Keyes, Morell, Kershaw, Semmes, Barksdale, and Robert Knox Sneden"}],["$","small",null,{"children":"The automated transcript produces forms including “Heinsleman,” “UJ,” “Erasmus Key,” “Most,” “Simms,” and “Sneeden.”"}]]}]
27:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
28:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Peninsula Campaign context",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep163-peninsula-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Peninsula Campaign context at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-peninsula-context.svg","alt":"Schematic regional map locating Richmond, Fair Oaks, Savage’s Station, White Oak Swamp, Glendale, Malvern Hill, and Harrison’s Landing between the York and James River corridors.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Peninsula Campaign context"}],["$","span",null,{"children":"Savage’s Station lay east of Richmond on the Richmond & York River Railroad and north of the route through White Oak Swamp. The rear guard fought there while the army, artillery, livestock, and wagon trains moved toward Glendale, Malvern Hill, and the James River. Locations, routes, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep163-peninsula-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Library of Congress, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Positions and movements at Savage’s Station",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep163-savage-station-movements.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Positions and movements at Savage’s Station at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-savage-station-movements.svg","alt":"Schematic tactical map of Confederate advances and Federal withdrawals around Allen’s Farm, Savage’s Station, the railroad, and Williamsburg Road.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Positions and movements at Savage’s Station"}],["$","span",null,{"children":"Sumner fell back from Allen’s Farm to Savage’s Station. Heintzelman withdrew before the main battle. Magruder’s late attack placed Kershaw near the railroad, Semmes across the Williamsburg Road, and part of Griffith’s brigade farther south; Brooks’s brigade returned to reinforce the Federal left. Jackson remained north of the Chickahominy. Arrows and unit areas are generalized and do not reconstruct exact regimental formations. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep163-savage-station-movements.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$28:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Robert Knox Sneden map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2f"]}]]}],"$undefined"]}]]}],"$L30"]}]]}]
29:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The retreat after Gaines’s Mill is introduced",{"className":"moment","children":[["$","$L31",null,{"seconds":347,"label":"5:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"The retreat after Gaines’s Mill is introduced"}],["$","p",null,{"children":"Lee waits for confirmation of McClellan’s route after the June 27 battle."}]]}]]}],["$","div","Lee identifies the movement toward the James",{"className":"moment","children":[["$","$L31",null,{"seconds":361,"label":"6:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee identifies the movement toward the James"}],["$","p",null,{"children":"By the morning of June 29, Lee is convinced that the Army of the Potomac is moving south."}]]}]]}],["$","div","The Federal withdrawal begins",{"className":"moment","children":[["$","$L31",null,{"seconds":447,"label":"7:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Federal withdrawal begins"}],["$","p",null,{"children":"The episode dates the first large movements toward White Oak Swamp to early June 28."}]]}]]}],["$","div","Lee’s June 29 plan is outlined",{"className":"moment","children":[["$","$L31",null,{"seconds":540,"label":"9:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s June 29 plan is outlined"}],["$","p",null,{"children":"Magruder and Jackson are to fix the rear guard while Huger, Longstreet, and A. P. Hill move toward Glendale."}]]}]]}],["$","div","Jackson receives the crossing assignment",{"className":"moment","children":[["$","$L31",null,{"seconds":568,"label":"9:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson receives the crossing assignment"}],["$","p",null,{"children":"He is to rebuild a Chickahominy bridge, cross, and support Magruder’s left."}]]}]]}],["$","div","Speed is identified as the plan’s requirement",{"className":"moment","children":[["$","$L31",null,{"seconds":676,"label":"11:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Speed is identified as the plan’s requirement"}],["$","p",null,{"children":"Lee needs rapid movement to reduce the advantage created by McClellan’s earlier start."}]]}]]}],["$","div","Longstreet’s engineers examine Golding’s Farm",{"className":"moment","children":[["$","$L31",null,{"seconds":942,"label":"15:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet’s engineers examine Golding’s Farm"}],["$","p",null,{"children":"They find the fieldworks empty shortly after dawn and confirm that the Federal withdrawal is underway."}]]}]]}],["$","div","The Savage’s Station hospital is described",{"className":"moment","children":[["$","$L31",null,{"seconds":1123,"label":"18:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Savage’s Station hospital is described"}],["$","p",null,{"children":"Wounded and sick men arriving from II Corps bring the hospital population above 3,000."}]]}]]}],["$","div","Supplies are destroyed",{"className":"moment","children":[["$","$L31",null,{"seconds":1152,"label":"19:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Supplies are destroyed"}],["$","p",null,{"children":"United States troops burn food, equipment, and railroad rolling stock that cannot be taken south."}]]}]]}],["$","div","Wounded soldiers are left behind",{"className":"moment","children":[["$","$L31",null,{"seconds":1211,"label":"20:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wounded soldiers are left behind"}],["$","p",null,{"children":"The episode states that nearly 2,500 wounded men remain at the Savage’s Station field hospital."}]]}]]}],["$","div","McClellan moves south of the swamp",{"className":"moment","children":[["$","$L31",null,{"seconds":1223,"label":"20:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan moves south of the swamp"}],["$","p",null,{"children":"He leaves withdrawal orders but appoints no single officer to command the rear guard."}]]}]]}],["$","div","Sumner stops at Allen’s Farm",{"className":"moment","children":[["$","$L31",null,{"seconds":1279,"label":"21:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sumner stops at Allen’s Farm"}],["$","p",null,{"children":"The II Corps commander refuses to withdraw immediately to Savage’s Station."}]]}]]}],"$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a"]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Ordered the change of base and rear-guard withdrawal, then moved headquarters south of White Oak Swamp without appointing a single rear-guard commander"}]]}],["$","div","II Corps and senior officer on the battlefield",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps and senior officer on the battlefield"}],["$","span",null,{"children":"Maj. Gen. Edwin V. Sumner"}],["$","small",null,{"children":"Directed mixed elements of II and VI Corps, including troops from the divisions of Israel B. Richardson, John Sedgwick, and William F. Smith"}]]}],["$","div","VI Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"VI Corps"}],["$","span",null,{"children":"Maj. Gen. William B. Franklin"}],["$","small",null,{"children":"Identified the gap beside Smith’s division, persuaded Sumner to leave Allen’s Farm, and helped coordinate the Savage’s Station line"}]]}],["$","div","2nd Division, VI Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, VI Corps"}],["$","span",null,{"children":"Brig. Gen. William F. “Baldy” Smith"}],["$","small",null,{"children":"Started toward White Oak Swamp, then sent William T. H. Brooks’s brigade back to support Sumner"}]]}],["$","div","2nd Brigade, Smith’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade, Smith’s division"}],["$","span",null,{"children":"Brig. Gen. William T. H. Brooks"}],["$","small",null,{"children":"Returned to the threatened Federal left and sustained nearly 450 casualties in the episode’s account"}]]}],["$","div","III Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps"}],["$","span",null,{"children":"Maj. Gen. Samuel P. Heintzelman"}],["$","small",null,{"children":"Withdrew through White Oak Swamp before the main engagement without notifying Sumner or Franklin"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Designed the pursuit, expected Magruder to fix the Federal rear guard, and directed other divisions toward crossings and Glendale"}]]}],["$","div","Three-division force pursuing on the railroad and Williamsburg Road",{"className":"command-entry","children":[["$","strong",null,{"children":"Three-division force pursuing on the railroad and Williamsburg Road"}],["$","span",null,{"children":"Maj. Gen. John B. Magruder"}],["$","small",null,{"children":"Delayed while seeking flank support, then committed the brigades of Joseph B. Kershaw, Paul J. Semmes, and Richard Griffith"}]]}],["$","div","Brigade in Lafayette McLaws’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade in Lafayette McLaws’s division"}],["$","span",null,{"children":"Brig. Gen. Joseph B. Kershaw"}],["$","small",null,{"children":"Led the late-afternoon advance with the brigade’s left on the railroad"}]]}],["$","div","Brigade in McLaws’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade in McLaws’s division"}],["$","span",null,{"children":"Brig. Gen. Paul J. Semmes"}],["$","small",null,{"children":"Extended the Confederate line across and south of the Williamsburg Road"}]]}],"$L4b","$L4c","$L4d"]]}]]}],"$L4e","$L4f"]}]
2b:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. Richard Griffith",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Richard Griffith"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of a Mississippi brigade in Magruder’s force","."]}]," ","Mortally wounded by artillery fire during the late-afternoon attack at Savage’s Station and died shortly afterward in Richmond. The National Park Service identifies him as mortally wounded in the battle; Library of Congress cataloging for his surviving letter gives June 30 as the date of death, while some later accounts give June 29."]}]]}]]}]]}]
2c:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep163-peninsula-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-peninsula-context.svg","alt":"Schematic regional map of the Richmond, Savage’s Station, White Oak Swamp, and James River corridor.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Savage’s Station stood on the railroad east of Richmond, immediately north of the army’s constrained route through White Oak Swamp toward the James River."}]]}],["$","figure","/images/ep163-savage-station-movements.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-savage-station-movements.svg","alt":"Schematic map of troop movements during the Battle of Savage’s Station.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The diagram separates the morning withdrawal from Allen’s Farm, Heintzelman’s independent departure, Magruder’s late attack, Brooks’s return, and Jackson’s nonparticipation."}]]}],["$","figure","/images/ep163-savage-station-waud.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-savage-station-waud.jpg","alt":"Alfred Waud’s June 29, 1862 drawing of the opening of the Battle of Savage’s Station.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Waud’s field sketch records the Federal advance, Sumner and his staff, hospital tents, Confederate-held woods, and burning railroad equipment."}]]}],["$","figure","/images/ep163-savage-station-1862.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-savage-station-1862.jpg","alt":"June 27, 1862 stereograph of United States headquarters, covered wagons, and railroad cars at Savage’s Station.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This photograph was made at Savage’s Station on June 27, two days before the battle. It shows Army of the Potomac headquarters, covered wagons, and railroad cars before the withdrawal."}]]}],["$","figure","/images/ep163-edwin-sumner.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-edwin-sumner.jpg","alt":"Civil War-era photographic portrait of United States major general Edwin V. Sumner in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Sumner, the senior officer left north of White Oak Swamp, directed the mixed rear guard during the main engagement."}]]}],["$","figure","/images/ep163-john-magruder.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-john-magruder.jpg","alt":"Civil War-era photographic portrait of Confederate major general John B. Magruder in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Magruder had primary responsibility for the direct pursuit but delayed the main attack until late afternoon and committed only part of his force."}]]}]]}]]}]
