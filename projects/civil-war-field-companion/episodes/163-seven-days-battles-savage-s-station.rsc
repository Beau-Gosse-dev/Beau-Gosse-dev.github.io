2a:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. Richard Griffith",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Richard Griffith"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of a Mississippi brigade in Magruder’s force","."]}]," ","Mortally wounded by artillery fire during the late-afternoon attack at Savage’s Station and died shortly afterward in Richmond. The National Park Service identifies him as mortally wounded in the battle; Library of Congress cataloging for his surviving letter gives June 30 as the date of death, while some later accounts give June 29."]}]]}]]}]]}]
2b:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep163-peninsula-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-peninsula-context.svg","alt":"Schematic regional map of the Richmond, Savage’s Station, White Oak Swamp, and James River corridor.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Savage’s Station stood on the railroad east of Richmond, immediately north of the army’s constrained route through White Oak Swamp toward the James River."}]]}],["$","figure","/images/ep163-savage-station-movements.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-savage-station-movements.svg","alt":"Schematic map of troop movements during the Battle of Savage’s Station.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The diagram separates the morning withdrawal from Allen’s Farm, Heintzelman’s independent departure, Magruder’s late attack, Brooks’s return, and Jackson’s nonparticipation."}]]}],["$","figure","/images/ep163-savage-station-waud.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-savage-station-waud.jpg","alt":"Alfred Waud’s June 29, 1862 drawing of the opening of the Battle of Savage’s Station.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Waud’s field sketch records the Federal advance, Sumner and his staff, hospital tents, Confederate-held woods, and burning railroad equipment."}]]}],["$","figure","/images/ep163-savage-station-1862.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-savage-station-1862.jpg","alt":"June 27, 1862 stereograph of United States headquarters, covered wagons, and railroad cars at Savage’s Station.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This photograph was made at Savage’s Station on June 27, two days before the battle. It shows Army of the Potomac headquarters, covered wagons, and railroad cars before the withdrawal."}]]}],["$","figure","/images/ep163-edwin-sumner.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-edwin-sumner.jpg","alt":"Civil War-era photographic portrait of United States major general Edwin V. Sumner in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Sumner, the senior officer left north of White Oak Swamp, directed the mixed rear guard during the main engagement."}]]}],["$","figure","/images/ep163-john-magruder.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep163-john-magruder.jpg","alt":"Civil War-era photographic portrait of Confederate major general John B. Magruder in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Magruder had primary responsibility for the direct pursuit but delayed the main attack until late afternoon and committed only part of his force."}]]}]]}]]}]
