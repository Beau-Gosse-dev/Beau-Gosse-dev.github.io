ection",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"Winter 1863–April 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Dalton, Rocky Face Ridge, Resaca, Rome, and northwest Georgia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"The terrain protected Johnston’s front at Dalton but left his railroad vulnerable through several gaps and from Rome; Sherman planned to demonstrate at Dalton while McPherson moved against the Confederate rear"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"Winter 1863–April 1864","place":"Dalton, Rocky Face Ridge, Resaca, Rome, and northwest Georgia","result":"The terrain protected Johnston’s front at Dalton but left his railroad vulnerable through several gaps and from Rome; Sherman planned to demonstrate at Dalton while McPherson moved against the Confederate rear","facts":[{"label":"Rocky Face Ridge length","value":"Nearly 25 miles"},{"label":"Highest relief above valleys","value":"About 800 feet"},{"label":"Dalton to Rome defensive line","value":"About 40 miles"},{"label":"Dalton to Etowah crossing","value":"About 45 miles"}],"maps":[{"title":"Northwest Georgia and the three mountain gaps","caption":"The campaign map shows Mill Creek Gap at Dalton, Dug Gap farther south, and Snake Creek Gap near Resaca, together with the railroad and routes toward Rome.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of northwest Georgia during the opening of the Atlanta campaign"},{"title":"Dalton, Resaca, and Rome today","caption":"Rocky Face Ridge runs southwest from Dalton toward the Oostanaula. Rome lies where the Oostanaula and Etowah Rivers join to form the Coosa.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-85.45%2C34.15%2C-84.70%2C34.95&layer=mapnik&marker=34.769%2C-84.971"},{"title":"The Western and Atlantic Railroad","caption":"The railroad passed through Mill Creek Gap, ran just east of Rocky Face Ridge, crossed the Oostanaula at Resaca, and continued toward Atlanta.","source":"https://www.loc.gov/item/2018670923/","image":"/images/atlanta-railroad-depot.jpg","alt":"Civil War era railroad depot and tracks in Atlanta"}],"moments":[{"time":"1:17","audioTime":77,"title":"Johnston waited at Dalton","detail":"The Army of Tennessee strengthened its Rocky Face Ridge defenses and left Sherman to choose where and how to open the campaign."},{"time":"2:46","audioTime":166,"title":"Parallel ridges divided northwest Georgia","detail":"The southern ends of the Appalachian Mountains ran diagonally across the region and restricted east-west movement."},{"time":"3:19","audioTime":199,"title":"Rocky Face Ridge covered Dalton from the west","detail":"The ridge began northwest of town, stretched nearly 25 miles toward the Oostanaula, and rose as much as 800 feet above nearby valleys."},{"time":"4:11","audioTime":251,"title":"Only three passes could carry an army","detail":"Mill Creek Gap carried the railroad and main road, Dug Gap crossed the ridge south of Dalton, and Snake Creek Gap opened near Resaca."},{"time":"5:00","audioTime":300,"title":"Snake Creek Gap approached the Confederate railroad","detail":"The pass opened into Sugar Valley west of Resaca, where the Western and Atlantic crossed the Oostanaula River."},{"time":"5:41","audioTime":341,"title":"The defensive problem extended to Rome","detail":"Johnston had to cover Crow Valley, Rocky Face Ridge, the Oostanaula River, and Rome rather than only the fortified position at Dalton."},{"time":"6:35","audioTime":395,"title":"Rome was a transportation and industrial point","detail":"It was a river port and connected by a branch railroad to Kingston on the Western and Atlantic."},{"time":"7:04","audioTime":424,"title":"U.S. troops had several routes to Rome","detail":"They could march south from Chattanooga through western valleys or move southeast from the Tennessee River across the ridges."},{"time":"7:39","audioTime":459,"title":"A U.S. force at Rome would threaten Dalton","detail":"From Rome, it could move toward Kingston or the Etowah crossing and force Johnston to attack, retreat east, or withdraw rapidly south."},{"time":"8:03","audioTime":483,"title":"The next strong railroad position was far south","detail":"If Johnston left Dalton, he had no suitable stop north of the Etowah crossing about 45 miles away."},{"time":"8:41","audioTime":521,"title":"Johnston made few preparations south of Dalton","detail":"He did little to fortify Rome or coordinate the defense of northwest Georgia with Leonidas Polk’s command in Alabama and Mississippi."},{"time":"10:56","audioTime":656,"title":"Crow Valley left the position open from the north","detail":"U.S. troops could enter from east Tennessee or move around the north end of Rocky Face Ridge and flank the Confederate line."},{"time":"11:44","audioTime":704,"title":"The railroad ran parallel to the defensive line","detail":"Any U.S. force passing through Dug Gap or Snake Creek Gap could quickly reach Johnston’s supply and retreat route."},{"time":"13:41","audioTime":821,"title":"The ridge also gave Johnston interior lines","detail":"Protected roads and the railroad behind the ridge allowed Confederate troops to shift between Crow Valley, Resaca, and Rome."},{"time":"16:09","audioTime":969,"title":"Johnston later called Dalton a weak position","detail":"He said pressure from Richmond kept the army there, but he did not explain his concerns to Jefferson Davis or Secretary of War James Seddon."},{"time":"17:45","audioTime":1065,"title":"Grant assigned Sherman two connected tasks","detail":"Sherman was to defeat Johnston or keep his army occupied so it could not reinforce Robert E. Lee in Virginia."},{"time":"18:52","audioTime":1132,"title":"Sherman preferred maneuver to major battle","detail":"He considered battlefield results uncertain and often insufficient to destroy an opposing army."},{"time":"21:06","audioTime":1266,"title":"Sherman aimed beyond battlefield victory","detail":"He emphasized attacks on morale, transportation, and economic support as well as the opposing army."},{"time":"22:18","audioTime":1338,"title":"Sherman rejected a direct assault at Dalton","detail":"His knowledge of northwest Georgia and study of the map led him to focus on Rome and the Confederate railroad."},{"time":"23:31","audioTime":1411,"title":"McPherson received the original flanking assignment","detail":"The Army of the Tennessee would move from northern Alabama toward Rome while Thomas and Schofield demonstrated against Dalton."},{"time":"24:08","audioTime":1448,"title":"Sherman expected Johnston to withdraw","detail":"A strong U.S. force near Rome would threaten the railroad and could force the Confederates to fall back toward Atlanta."},{"time":"26:26","audioTime":1586,"title":"Sherman moved headquarters to Chattanooga","detail":"He left Nashville on April 28 as both armies prepared to begin operations in early May."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"Ulysses S. Grant","command":"General-in-Chief","subordinates":"Assigned Sherman the western part of the coordinated 1864 strategy"},{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Thomas, McPherson, and Schofield"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Assigned to demonstrate against Dalton"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Originally assigned to move toward Rome"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"Assigned to support the Dalton demonstration"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Jefferson Davis","command":"Confederate president","subordinates":"Set national policy and communicated through the War Department"},{"commander":"Joseph E. Johnston","command":"Army and Department of Tennessee","subordinates":"Defended Dalton and northwest Georgia"},{"commander":"Leonidas Polk","command":"Department of Alabama, Mississippi, and East Louisiana","subordinates":"Controlled Confederate forces west of Johnston’s department"}]}],"people":[{"name":"William T. Sherman","role":"Studied the terrain and planned to turn the Dalton position instead of attacking it directly","side":"United States"},{"name":"Joseph E. Johnston","role":"Held Rocky Face Ridge but made limited preparations for threats to Resaca and Rome","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"James B. McPherson","role":"Received the original assignment to move from northern Alabama toward Rome","side":"United States"},{"name":"George H. Thomas","role":"Was assigned to demonstrate against the northern part of the Confederate position","side":"United States"},{"name":"John M. Schofield","role":"Was assigned to support Thomas near Dalton","side":"United States"},{"name":"Leonidas Polk","role":"Commanded the neighboring Confederate department but had no coordinated defense plan with Johnston","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of northwest Georgia and the Atlanta campaign","caption":"Ridges, gaps, rivers, and railroads determined the opening plans of both commanders.","source":"https://www.loc.gov/item/2008628278/"},{"image":"/images/atlanta-railroad-depot.jpg","alt":"Civil War era railroad depot and tracks","caption":"The Western and Atlantic was both Johnston’s supply line and the main target of Sherman’s turning movement.","source":"https://www.loc.gov/item/2018670923/"},{"image":"/images/joseph-e-johnston.jpg","alt":"Portrait of Joseph E. Johnston","caption":"Johnston concentrated on the immediate defenses of Dalton despite threats to his longer left flank.","source":"https://www.loc.gov/item/2018666539/"}],"sources":[{"label":"Official Episode 508 page","url":"https://civilwarpodcast.org/2025/10/19/civil-war-podcast-episode-508/"},{"label":"National Park Service Rocky Face Ridge summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=GA007"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
