18:["$","div",null,{"children":[["$","h3",null,{"children":"Johnston made few preparations south of Dalton"}],["$","p",null,{"children":"He did little to fortify Rome or coordinate the defense of northwest Georgia with Leonidas Polk’s command in Alabama and Mississippi."}]]}]
19:["$","div","Crow Valley left the position open from the north",{"className":"moment","children":[["$","$L16",null,{"seconds":656,"label":"10:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crow Valley left the position open from the north"}],["$","p",null,{"children":"U.S. troops could enter from east Tennessee or move around the north end of Rocky Face Ridge and flank the Confederate line."}]]}]]}]
1a:["$","div","The railroad ran parallel to the defensive line",{"className":"moment","children":[["$","$L16",null,{"seconds":704,"label":"11:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The railroad ran parallel to the defensive line"}],["$","p",null,{"children":"Any U.S. force passing through Dug Gap or Snake Creek Gap could quickly reach Johnston’s supply and retreat route."}]]}]]}]
1b:["$","div","The ridge also gave Johnston interior lines",{"className":"moment","children":[["$","$L16",null,{"seconds":821,"label":"13:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The ridge also gave Johnston interior lines"}],["$","p",null,{"children":"Protected roads and the railroad behind the ridge allowed Confederate troops to shift between Crow Valley, Resaca, and Rome."}]]}]]}]
1c:["$","div","Johnston later called Dalton a weak position",{"className":"moment","children":[["$","$L16",null,{"seconds":969,"label":"16:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston later called Dalton a weak position"}],["$","p",null,{"children":"He said pressure from Richmond kept the army there, but he did not explain his concerns to Jefferson Davis or Secretary of War James Seddon."}]]}]]}]
1d:["$","div","Grant assigned Sherman two connected tasks",{"className":"moment","children":[["$","$L16",null,{"seconds":1065,"label":"17:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant assigned Sherman two connected tasks"}],["$","p",null,{"children":"Sherman was to defeat Johnston or keep his army occupied so it could not reinforce Robert E. Lee in Virginia."}]]}]]}]
1e:["$","div","Sherman preferred maneuver to major battle",{"className":"moment","children":[["$","$L16",null,{"seconds":1132,"label":"18:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman preferred maneuver to major battle"}],["$","p",null,{"children":"He considered battlefield results uncertain and often insufficient to destroy an opposing army."}]]}]]}]
1f:["$","div","Sherman aimed beyond battlefield victory",{"className":"moment","children":[["$","$L16",null,{"seconds":1266,"label":"21:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman aimed beyond battlefield victory"}],["$","p",null,{"children":"He emphasized attacks on morale, transportation, and economic support as well as the opposing army."}]]}]]}]
20:["$","div","Sherman rejected a direct assault at Dalton",{"className":"moment","children":[["$","$L16",null,{"seconds":1338,"label":"22:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman rejected a direct assault at Dalton"}],["$","p",null,{"children":"His knowledge of northwest Georgia and study of the map led him to focus on Rome and the Confederate railroad."}]]}]]}]
21:["$","div","McPherson received the original flanking assignment",{"className":"moment","children":[["$","$L16",null,{"seconds":1411,"label":"23:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson received the original flanking assignment"}],["$","p",null,{"children":"The Army of the Tennessee would move from northern Alabama toward Rome while Thomas and Schofield demonstrated against Dalton."}]]}]]}]
22:["$","div","Sherman expected Johnston to withdraw",{"className":"moment","children":[["$","$L16",null,{"seconds":1448,"label":"24:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman expected Johnston to withdraw"}],["$","p",null,{"children":"A strong U.S. force near Rome would threaten the railroad and could force the Confederates to fall back toward Atlanta."}]]}]]}]
