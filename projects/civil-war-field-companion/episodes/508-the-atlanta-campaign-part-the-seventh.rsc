11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Johnston waited at Dalton",{"className":"moment","children":[["$","$L16",null,{"seconds":77,"label":"1:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston waited at Dalton"}],["$","p",null,{"children":"The Army of Tennessee strengthened its Rocky Face Ridge defenses and left Sherman to choose where and how to open the campaign."}]]}]]}],["$","div","Parallel ridges divided northwest Georgia",{"className":"moment","children":[["$","$L16",null,{"seconds":166,"label":"2:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Parallel ridges divided northwest Georgia"}],["$","p",null,{"children":"The southern ends of the Appalachian Mountains ran diagonally across the region and restricted east-west movement."}]]}]]}],["$","div","Rocky Face Ridge covered Dalton from the west",{"className":"moment","children":[["$","$L16",null,{"seconds":199,"label":"3:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rocky Face Ridge covered Dalton from the west"}],["$","p",null,{"children":"The ridge began northwest of town, stretched nearly 25 miles toward the Oostanaula, and rose as much as 800 feet above nearby valleys."}]]}]]}],["$","div","Only three passes could carry an army",{"className":"moment","children":[["$","$L16",null,{"seconds":251,"label":"4:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Only three passes could carry an army"}],["$","p",null,{"children":"Mill Creek Gap carried the railroad and main road, Dug Gap crossed the ridge south of Dalton, and Snake Creek Gap opened near Resaca."}]]}]]}],["$","div","Snake Creek Gap approached the Confederate railroad",{"className":"moment","children":[["$","$L16",null,{"seconds":300,"label":"5:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Snake Creek Gap approached the Confederate railroad"}],["$","p",null,{"children":"The pass opened into Sugar Valley west of Resaca, where the Western and Atlantic crossed the Oostanaula River."}]]}]]}],["$","div","The defensive problem extended to Rome",{"className":"moment","children":[["$","$L16",null,{"seconds":341,"label":"5:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The defensive problem extended to Rome"}],["$","p",null,{"children":"Johnston had to cover Crow Valley, Rocky Face Ridge, the Oostanaula River, and Rome rather than only the fortified position at Dalton."}]]}]]}],["$","div","Rome was a transportation and industrial point",{"className":"moment","children":[["$","$L16",null,{"seconds":395,"label":"6:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rome was a transportation and industrial point"}],["$","p",null,{"children":"It was a river port and connected by a branch railroad to Kingston on the Western and Atlantic."}]]}]]}],["$","div","U.S. troops had several routes to Rome",{"className":"moment","children":[["$","$L16",null,{"seconds":424,"label":"7:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops had several routes to Rome"}],["$","p",null,{"children":"They could march south from Chattanooga through western valleys or move southeast from the Tennessee River across the ridges."}]]}]]}],["$","div","A U.S. force at Rome would threaten Dalton",{"className":"moment","children":[["$","$L16",null,{"seconds":459,"label":"7:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"A U.S. force at Rome would threaten Dalton"}],["$","p",null,{"children":"From Rome, it could move toward Kingston or the Etowah crossing and force Johnston to attack, retreat east, or withdraw rapidly south."}]]}]]}],["$","div","The next strong railroad position was far south",{"className":"moment","children":[["$","$L16",null,{"seconds":483,"label":"8:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The next strong railroad position was far south"}],["$","p",null,{"children":"If Johnston left Dalton, he had no suitable stop north of the Etowah crossing about 45 miles away."}]]}]]}],["$","div","Johnston made few preparations south of Dalton",{"className":"moment","children":["$L17","$L18"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}]
