11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode leaves Kennesaw Mountain",{"className":"moment","children":[["$","$L17",null,{"seconds":77,"label":"1:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode leaves Kennesaw Mountain"}],["$","p",null,{"children":"Sherman had lost about 3,000 men in the June 27 assaults. On July 3, he learned that Johnston had withdrawn because of the U.S. movement around the Confederate left."}]]}]]}],["$","div","Thomas pursued through Marietta",{"className":"moment","children":[["$","$L17",null,{"seconds":173,"label":"2:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas pursued through Marietta"}],["$","p",null,{"children":"XIV Corps followed the railroad, IV Corps advanced on its left, and XX Corps on its right. McPherson and Schofield continued south on the Sandtown Road."}]]}]]}],["$","div","A Confederate rear guard slowed the advance",{"className":"moment","children":[["$","$L17",null,{"seconds":215,"label":"3:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"A Confederate rear guard slowed the advance"}],["$","p",null,{"children":"Skirmishing south of Marietta delayed Thomas. By late afternoon, resistance near Smyrna Station forced a full U.S. division to deploy."}]]}]]}],["$","div","Johnston occupied the Smyrna Line",{"className":"moment","children":[["$","$L17",null,{"seconds":289,"label":"4:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston occupied the Smyrna Line"}],["$","p",null,{"children":"The east-west position crossed the railroad at Smyrna, with Rottenwood Creek protecting the right and Nickajack Creek protecting the left."}]]}]]}],["$","div","The Confederate corps formed the line",{"className":"moment","children":[["$","$L17",null,{"seconds":330,"label":"5:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate corps formed the line"}],["$","p",null,{"children":"William W. Loring held the right, William J. Hardee the center, John B. Hood the left, and Georgia militia extended farther west."}]]}]]}],["$","div","Skirmishing continued on July 4",{"className":"moment","children":[["$","$L17",null,{"seconds":452,"label":"7:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Skirmishing continued on July 4"}],["$","p",null,{"children":"The opposing armies exchanged fire along the Smyrna Line while Sherman prepared to continue the pursuit."}]]}]]}],["$","div","Alfred J. Vaughan was severely wounded",{"className":"moment","children":[["$","$L17",null,{"seconds":460,"label":"7:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Alfred J. Vaughan was severely wounded"}],["$","p",null,{"children":"A U.S. artillery shell struck the Confederate brigade commander’s left foot. His leg was amputated, and he did not return to field service during the war."}]]}]]}],["$","div","McPherson crossed Nickajack Creek",{"className":"moment","children":[["$","$L17",null,{"seconds":781,"label":"13:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson crossed Nickajack Creek"}],["$","p",null,{"children":"U.S. troops drove back Georgia militia and threatened to separate them from Johnston’s army."}]]}]]}],["$","div","Johnston abandoned the Smyrna Line",{"className":"moment","children":[["$","$L17",null,{"seconds":809,"label":"13:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston abandoned the Smyrna Line"}],["$","p",null,{"children":"During the night, the Army of Tennessee moved six miles south into the Shoup Line."}]]}]]}],["$","div","U.S. troops encountered the Shoup Line",{"className":"moment","children":[["$","$L17",null,{"seconds":835,"label":"13:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops encountered the Shoup Line"}],["$","p",null,{"children":"Francis A. Shoup designed the six-mile defensive system. About 1,000 enslaved laborers had worked on it for two weeks."}]]}]]}],["$","div","Redoubts and stockades strengthened the position",{"className":"moment","children":[["$","$L17",null,{"seconds":884,"label":"14:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Redoubts and stockades strengthened the position"}],"$L18"]}]]}],"$L19","$L1a"]}]]}]
