11:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L19",null,{"guide":{"date":"July 3–5, 1864","place":"Marietta, Smyrna, and the Chattahoochee River, Georgia","result":"Johnston withdrew into the Shoup Line, and U.S. forces reached the Chattahoochee eight miles from Atlanta","facts":[{"label":"Kennesaw casualties reviewed","value":"About 3,000 U.S. and just over 1,000 Confederate"},{"label":"Smyrna Line abandoned","value":"Night of July 4–5"},{"label":"Shoup Line","value":"Six miles long and about one mile deep"},{"label":"Redoubt spacing","value":"About 80 feet apart","note":"Log stockades connected the individual forts."},{"label":"Distance to Atlanta","value":"About eight miles from the observation point near Vinings"}],"maps":[{"title":"From Kennesaw Mountain to the Chattahoochee","caption":"The map shows the U.S. advance through Marietta and Smyrna, the Sandtown Road movement on the west, and the Confederate positions covering the river.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-4.jpg","alt":"U.S. Army campaign map showing Kennesaw Mountain, Marietta, Smyrna, and the Chattahoochee River"},{"title":"Marietta, Smyrna, Vinings, and Atlanta today","caption":"Thomas followed the Western and Atlantic Railroad through Marietta and Smyrna. McPherson and Schofield moved farther west along the Sandtown Road.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.76%2C33.69%2C-84.31%2C34.08&layer=mapnik&marker=33.8648%2C-84.4644"},{"title":"The wider Atlanta campaign","caption":"Blue and red lines record the opposing movements and fieldworks across northwestern Georgia before the armies reached Atlanta.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of U.S. and Confederate movements during the Atlanta campaign"}],"moments":[{"time":"1:17","audioTime":77,"title":"The episode leaves Kennesaw Mountain","detail":"Sherman had lost about 3,000 men in the June 27 assaults. On July 3, he learned that Johnston had withdrawn because of the U.S. movement around the Confederate left."},{"time":"2:53","audioTime":173,"title":"Thomas pursued through Marietta","detail":"XIV Corps followed the railroad, IV Corps advanced on its left, and XX Corps on its right. McPherson and Schofield continued south on the Sandtown Road."},{"time":"3:35","audioTime":215,"title":"A Confederate rear guard slowed the advance","detail":"Skirmishing south of Marietta delayed Thomas. By late afternoon, resistance near Smyrna Station forced a full U.S. division to deploy."},{"time":"4:49","audioTime":289,"title":"Johnston occupied the Smyrna Line","detail":"The east-west position crossed the railroad at Smyrna, with Rottenwood Creek protecting the right and Nickajack Creek protecting the left."},{"time":"5:30","audioTime":330,"title":"The Confederate corps formed the line","detail":"William W. Loring held the right, William J. Hardee the center, John B. Hood the left, and Georgia militia extended farther west."},{"time":"7:32","audioTime":452,"title":"Skirmishing continued on July 4","detail":"The opposing armies exchanged fire along the Smyrna Line while Sherman prepared to continue the pursuit."},{"time":"7:40","audioTime":460,"title":"Alfred J. Vaughan was severely wounded","detail":"A U.S. artillery shell struck the Confederate brigade commander’s left foot. His leg was amputated, and he did not return to field service during the war."},{"time":"13:01","audioTime":781,"title":"McPherson crossed Nickajack Creek","detail":"U.S. troops drove back Georgia militia and threatened to separate them from Johnston’s army."},{"time":"13:29","audioTime":809,"title":"Johnston abandoned the Smyrna Line","detail":"During the night, the Army of Tennessee moved six miles south into the Shoup Line."},{"time":"13:55","audioTime":835,"title":"U.S. troops encountered the Shoup Line","detail":"Francis A. Shoup designed the six-mile defensive system. About 1,000 enslaved laborers had worked on it for two weeks."},{"time":"14:44","audioTime":884,"title":"Redoubts and stockades strengthened the position","detail":"Earth-and-log redoubts up to 12 feet thick stood about 80 feet apart and were connected by log stockades. Both ends rested on the river."},{"time":"15:11","audioTime":911,"title":"Sherman saw Atlanta from near Vinings","detail":"On July 5, Sherman and Thomas viewed the city about eight miles away and examined possible routes across the Chattahoochee."},{"time":"16:06","audioTime":966,"title":"James A. Connolly described the view","detail":"The 123rd Illinois officer wrote that U.S. soldiers cheered when they saw Atlanta and that artillery soon fired across the river."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed the pursuit toward the Chattahoochee"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"XIV Corps center, IV Corps left, XX Corps right"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Advanced on the Sandtown Road and crossed Nickajack Creek"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"Advanced with McPherson west of Thomas"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Directed the withdrawal from Smyrna to the Shoup Line"},{"commander":"William W. Loring","command":"Loring’s Corps","subordinates":"Held the Confederate right at Smyrna"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Held the center at Smyrna"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Held the left at Smyrna"},{"commander":"Joseph Wheeler","command":"Cavalry Corps","subordinates":"Covered the Confederate right"},{"commander":"William H. Jackson","command":"Cavalry division","subordinates":"Covered the Confederate left"}]}],"people":[{"name":"Francis A. Shoup","role":"Designed the fortified line protecting the Chattahoochee crossings","side":"Confederacy"},{"name":"Alfred J. Vaughan","role":"Brigade commander wounded by artillery at the Smyrna Line","side":"Confederacy"},{"name":"James A. Connolly","role":"123rd Illinois officer whose letter describes the first view of Atlanta","side":"United States"},{"name":"Absalom Baird","role":"U.S. division commander present when Sherman and Thomas viewed Atlanta","side":"United States"},{"name":"Joseph E. Johnston","role":"Prepared two defensive lines north of the Chattahoochee","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"}],"losses":[{"name":"Alfred J. Vaughan","side":"Confederacy","role":"Brigade commander, Cheatham’s Division","outcome":"Severely wounded on July 4; left leg amputated and out of action for the rest of the war"}],"gallery":[{"image":"/images/atlanta-railroad-depot.jpg","alt":"Atlanta railroad depot photographed in 1864","caption":"Atlanta’s railroad depot. The Western and Atlantic Railroad led U.S. forces from Chattanooga toward the city.","source":"https://www.loc.gov/item/2018666982/"},{"image":"/images/atlanta-fortifications.jpg","alt":"Confederate earthwork fortifications at Atlanta in 1864","caption":"Confederate earthworks at Atlanta show the same use of packed earth and timber found in the Shoup Line.","source":"https://www.loc.gov/item/2018670937/"}],"sources":[{"label":"Official Episode 530 page","url":"https://civilwarpodcast.org/2026/06/07/civil-war-podcast-episode-530/"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"Library of Congress Atlanta railroad depot photograph","url":"https://www.loc.gov/item/2018666982/"},{"label":"Library of Congress Atlanta fortifications photograph","url":"https://www.loc.gov/item/2018670937/"}]}}]}]
