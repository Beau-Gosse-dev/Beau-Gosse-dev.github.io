d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",196," · ","September 17, 1862"," · ","The center of the Antietam battlefield east of Sharpsburg, Maryland, from the Roulette farm south across the ridge to the Sunken Road between the Hagerstown Turnpike and the Roulette farm lane"]}],["$","h1",null,{"children":"ANTIETAM (Part the Eleventh)"}],["$","span",null,{"className":"result-label","children":"Beginning at about 9:30 a.m., Brig. Gen. William H. French sent three brigade lines against Maj. Gen. D. H. Hill’s infantry in the Sunken Road. The road’s banks and piled fence rails protected the Confederates, who waited until the Federal lines crossed the ridge before firing at close range. Weber’s, Morris’s, and Kimball’s brigades were each stopped, and French’s division could not break the position before Israel Richardson’s division arrived. French reported 1,817 casualties; the episode uses 1,760. The first phase therefore ended with Hill’s line intact but under continuing pressure and with reinforcements approaching both sides"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"September 17, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"The center of the Antietam battlefield east of Sharpsburg, Maryland, from the Roulette farm south across the ridge to the Sunken Road between the Hagerstown Turnpike and the Roulette farm lane"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Beginning at about 9:30 a.m., Brig. Gen. William H. French sent three brigade lines against Maj. Gen. D. H. Hill’s infantry in the Sunken Road. The road’s banks and piled fence rails protected the Confederates, who waited until the Federal lines crossed the ridge before firing at close range. Weber’s, Morris’s, and Kimball’s brigades were each stopped, and French’s division could not break the position before Israel Richardson’s division arrived. French reported 1,817 casualties; the episode uses 1,760. The first phase therefore ended with Hill’s line intact but under continuing pressure and with reinforcements approaching both sides"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":["$Lf","$L10","$L11","$L12"]}],"$undefined"]}],"$L13","$L14","$L15",false,"$L16","$L17","$L18","$L19","$L1a","$L1b"]}]]}]
