11:["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Federal strength",{"children":[["$","th",null,{"scope":"row","children":"Federal strength"}],["$","td",null,{"children":["About 5,700 men in French’s division",["$","small",null,{"style":{"display":"block"},"children":"The division had only recently been assembled and attacked in three brigade lines under Max Weber, Dwight Morris, and Nathan Kimball."}]]}]]}],["$","tr","First Federal wave",{"children":[["$","th",null,{"scope":"row","children":"First Federal wave"}],["$","td",null,{"children":["About 1,700 men under Brig. Gen. Max Weber",["$","small",null,{"style":{"display":"block"},"children":"The 1st Delaware, 5th Maryland, and 4th New York advanced first. The slower pace of the large 5th Maryland color bearer caused the brigade line to bow inward."}]]}]]}],["$","tr","Weber’s repulse",{"children":[["$","th",null,{"scope":"row","children":"Weber’s repulse"}],["$","td",null,{"children":["As many as 500 casualties within about five minutes in the episode",["$","small",null,{"style":{"display":"block"},"children":"Weber was severely wounded, all nine members of the 1st Delaware color guard fell, and the brigade stopped short of the road."}]]}]]}],["$","tr","1st Delaware",{"children":[["$","th",null,{"scope":"row","children":"1st Delaware"}],["$","td",null,{"children":["286 of 635 men killed or wounded in less than five minutes",["$","small",null,{"style":{"display":"block"},"children":"This episode figure comes from Lt. Charles B. Tanner’s recollection and is also used in the National Park Service Bloody Lane trail interpretation."}]]}]]}],["$","tr","Second Federal wave",{"children":[["$","th",null,{"scope":"row","children":"Second Federal wave"}],["$","td",null,{"children":["About 1,000 men under Col. Dwight Morris",["$","small",null,{"style":{"display":"block"},"children":"The 108th New York, 130th Pennsylvania, and 14th Connecticut were all new regiments entering combat for the first time."}]]}]]}],["$","tr","Richard A. Oakford",{"children":[["$","th",null,{"scope":"row","children":"Richard A. Oakford"}],["$","td",null,{"children":["Killed while leading the 132nd Pennsylvania",["$","small",null,{"style":{"display":"block"},"children":"The automated transcript renders his surname as “Oakley.” Kimball’s official report identifies Col. Richard A. Oakford and states that he was killed while leading his regiment."}]]}]]}]]}]]}]
12:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2017/05/21/civil-war-podcast-episode-196/",{"href":"https://civilwarpodcast.org/2017/05/21/civil-war-podcast-episode-196/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 196 page"]}],["$","a","https://www.nps.gov/anti/planyourvisit/bloody-lane-trail.htm",{"href":"https://www.nps.gov/anti/planyourvisit/bloody-lane-trail.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Bloody Lane Trail overview"]}],["$","a","https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-stop-2.htm",{"href":"https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-stop-2.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Roulette Farm"]}],["$","a","https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-stop-3.htm",{"href":"https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-stop-3.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: uphill to the Sunken Road"]}],["$","a","https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-stop-4.htm",{"href":"https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-stop-4.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Fire!"]}],["$","a","https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-stop-5.htm",{"href":"https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-stop-5.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Sunken Road to Bloody Lane"]}],["$","a","https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-stop-6.htm",{"href":"https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-stop-6.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Charles Tanner’s Medal of Honor action"]}],["$","a","https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-table-of-organization.htm",{"href":"https://www.nps.gov/anti/planyourvisit/bloody-lane-trail-table-of-organization.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Bloody Lane table of organization"]}],["$","a","https://ehistory.osu.edu/books/official-records/027",{"href":"https://ehistory.osu.edu/books/official-records/027","target":"_blank","rel":"noreferrer","children":[" · ","Official Records, Series I, Volume XIX, Part I"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=54",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=54","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: William H. French’s official report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=126",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=126","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Nathan Kimball’s official report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=32",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=32","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: D. H. Hill’s official report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=74",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=74","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Robert E. Rodes’s official report"]}],["$","a","https://www.loc.gov/item/map05000006/",{"href":"https://www.loc.gov/item/map05000006/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Atlas of the battlefield of Antietam"]}],["$","a","https://www.loc.gov/item/2014646934/",{"href":"https://www.loc.gov/item/2014646934/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Gardner photograph of the Sunken Road"]}],"$L1c"]}]
