1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",196," · ","September 17, 1862"," · ","The center of the Antietam battlefield east of Sharpsburg, Maryland, from the Roulette farm south across the ridge to the Sunken Road between the Hagerstown Turnpike and the Roulette farm lane"]}],["$","h1",null,{"children":"ANTIETAM (Part the Eleventh)"}],["$","span",null,{"className":"result-label","children":"Beginning at about 9:30 a.m., Brig. Gen. William H. French sent three brigade lines against Maj. Gen. D. H. Hill’s infantry in the Sunken Road. The road’s banks and piled fence rails protected the Confederates, who waited until the Federal lines crossed the ridge before firing at close range. Weber’s, Morris’s, and Kimball’s brigades were each stopped, and French’s division could not break the position before Israel Richardson’s division arrived. French reported 1,817 casualties; the episode uses 1,760. The first phase therefore ended with Hill’s line intact but under continuing pressure and with reinforcements approaching both sides"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3184096954.mp3?updated=1695499558","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"About 9:15 to 10:30 a.m. in the Confederate center"}],["$","small",null,{"children":"The episode follows French from the East Woods through three failed brigade attacks and ends before Richardson’s division begins the next phase of the Sunken Road fight."}]]}],["$","div","French’s decision",{"children":[["$","span",null,{"children":"French’s decision"}],["$","strong",null,{"children":"Turn south toward the only visible Confederate line"}],["$","small",null,{"children":"Sedgwick had disappeared into the West Woods without leaving French a guide. French saw Greene near the Dunker Church and Confederate skirmishers farther south, then moved toward the Roulette farm."}]]}],["$","div","Sunken Road",{"children":[["$","span",null,{"children":"Sunken Road"}],["$","strong",null,{"children":"A farm lane worn several feet below the surrounding fields"}],["$","small",null,{"children":"Wagon traffic and erosion created a natural infantry position. Confederate troops strengthened it by piling fence rails along the bank."}]]}],["$","div","Location of the defended sector",{"children":[["$","span",null,{"children":"Location of the defended sector"}],["$","strong",null,{"children":"About 600 yards south of the Dunker Church"}],["$","small",null,{"children":"The episode traces the road east from the Hagerstown Turnpike to its bend at the Roulette farm lane and then southeast toward the Boonsboro Turnpike."}]]}],["$","div","Federal strength",{"children":[["$","span",null,{"children":"Federal strength"}],"$Le","$Lf"]}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],"$L23","$undefined","$L24",false,"$L25","$L26","$L27","$L28","$L29"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","strong",null,{"children":"About 5,700 men in French’s division"}]
f:["$","small",null,{"children":"The division had only recently been assembled and attacked in three brigade lines under Max Weber, Dwight Morris, and Nathan Kimball."}]
10:["$","div","Confederate strength",{"children":[["$","span",null,{"children":"Confederate strength"}],["$","strong",null,{"children":"About 2,500 in the episode; about 2,200 in current NPS interpretation"}],["$","small",null,{"children":"The difference reflects varying estimates of the effectives from Rodes’s and George B. Anderson’s brigades and the battered remnants extending the line west."}]]}]
11:["$","div","Hill’s available brigades",{"children":[["$","span",null,{"children":"Hill’s available brigades"}],["$","strong",null,{"children":"Two relatively intact brigades and remnants of two others"}],["$","small",null,{"children":"Rodes and George B. Anderson held most of the road. The surviving portions of Colquitt’s brigade and Garland’s brigade under Duncan McRae extended the position toward the Hagerstown Turnpike."}]]}]
12:["$","div","Rodes’s line",{"children":[["$","span",null,{"children":"Rodes’s line"}],["$","strong",null,{"children":"About 750 Alabamians in five regiments in the episode"}],["$","small",null,{"children":"From the road’s bend westward, the episode places the 6th, 5th, 3rd, 12th, and 26th Alabama. Rodes’s official report gives fewer than 800 effectives at the beginning of this fight."}]]}]
13:["$","div","George B. Anderson’s line",{"children":[["$","span",null,{"children":"George B. Anderson’s line"}],["$","strong",null,{"children":"About 1,150 North Carolinians in four regiments"}],["$","small",null,{"children":"The episode lists the 2nd, 14th, 4th, and 30th North Carolina from left to right in the deepest part of the road."}]]}]
14:["$","div","First Federal wave",{"children":[["$","span",null,{"children":"First Federal wave"}],["$","strong",null,{"children":"About 1,700 men under Brig. Gen. Max Weber"}],["$","small",null,{"children":"The 1st Delaware, 5th Maryland, and 4th New York advanced first. The slower pace of the large 5th Maryland color bearer caused the brigade line to bow inward."}]]}]
15:["$","div","Confederate fire discipline",{"children":[["$","span",null,{"children":"Confederate fire discipline"}],["$","strong",null,{"children":"Fire withheld until the Federals were about 80 yards away"}],["$","small",null,{"children":"Officers kept the defenders down behind the road bank and fence rails until Weber’s line crossed the ridge and began descending the open slope."}]]}]
16:["$","div","Weber’s repulse",{"children":[["$","span",null,{"children":"Weber’s repulse"}],["$","strong",null,{"children":"As many as 500 casualties within about five minutes in the episode"}],["$","small",null,{"children":"Weber was severely wounded, all nine members of the 1st Delaware color guard fell, and the brigade stopped short of the road."}]]}]
17:["$","div","1st Delaware",{"children":[["$","span",null,{"children":"1st Delaware"}],["$","strong",null,{"children":"286 of 635 men killed or wounded in less than five minutes"}],["$","small",null,{"children":"This episode figure comes from Lt. Charles B. Tanner’s recollection and is also used in the National Park Service Bloody Lane trail interpretation."}]]}]
18:["$","div","Tanner’s Medal of Honor action",{"children":[["$","span",null,{"children":"Tanner’s Medal of Honor action"}],["$","strong",null,{"children":"Recovered the 1st Delaware colors after three wounds"}],["$","small",null,{"children":"Tanner reached the fallen flag, suffered a shattered arm and two additional wounds, and carried the colors back. He later received the Medal of Honor."}]]}]
19:["$","div","Second Federal wave",{"children":[["$","span",null,{"children":"Second Federal wave"}],["$","strong",null,{"children":"About 1,000 men under Col. Dwight Morris"}],["$","small",null,{"children":"The 108th New York, 130th Pennsylvania, and 14th Connecticut were all new regiments entering combat for the first time."}]]}]
1a:["$","div","Friendly fire",{"children":[["$","span",null,{"children":"Friendly fire"}],["$","strong",null,{"children":"14th Connecticut fired into the rear of 1st Delaware"}],["$","small",null,{"children":"Morris’s advancing green troops encountered survivors of Weber’s line amid heavy fire and confusion near the crest."}]]}]
1b:["$","div","Third Federal wave",{"children":[["$","span",null,{"children":"Third Federal wave"}],["$","strong",null,{"children":"Kimball’s brigade shifted east and attacked"}],["$","small",null,{"children":"The 14th Indiana, 8th Ohio, and 7th Virginia (later 7th West Virginia) were combat veterans; the 132nd Pennsylvania had only recently entered service."}]]}]
1c:["$","div","Roulette farm beehives",{"children":[["$","span",null,{"children":"Roulette farm beehives"}],["$","strong",null,{"children":"A Confederate shell scattered bees among the 132nd Pennsylvania"}],["$","small",null,{"children":"The regiment broke briefly in the orchard, rallied, and continued toward the Sunken Road. The NPS records William Roulette’s later compensation claim for damaged beehives and other property."}]]}]
1d:["$","div","Richard A. Oakford",{"children":[["$","span",null,{"children":"Richard A. Oakford"}],["$","strong",null,{"children":"Killed while leading the 132nd Pennsylvania"}],["$","small",null,{"children":"The automated transcript renders his surname as “Oakley.” Kimball’s official report identifies Col. Richard A. Oakford and states that he was killed while leading his regiment."}]]}]
1e:["$","div","French’s total loss",{"children":[["$","span",null,{"children":"French’s total loss"}],["$","strong",null,{"children":"1,817 officially reported; 1,760 in the episode"}],["$","small",null,{"children":"French reported 1,614 killed or wounded and 203 missing. The nearby totals are retained rather than treated as interchangeable."}]]}]
1f:["$","div","Why the attacks stopped",{"children":[["$","span",null,{"children":"Why the attacks stopped"}],["$","strong",null,{"children":"Open approach, protected defenders, and successive commitment"}],["$","small",null,{"children":"Each Federal brigade crossed the ridge separately into close-range fire. Survivors used the reverse slope for cover while the next formation went forward."}]]}]
20:["$","div","Reinforcements approaching",{"children":[["$","span",null,{"children":"Reinforcements approaching"}],["$","strong",null,{"children":"Richardson for the United States; Richard H. Anderson for the Confederacy"}],["$","small",null,{"children":"The episode closes before either formation’s role in the second phase is described."}]]}]
21:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The Long Road to Antietam” by Richard Slotkin"}],["$","small",null,{"children":"The full subtitle is “How the Civil War Became a Revolution.” The episode recommends it for its combined military and political account of the Maryland Campaign and emancipation."}]]}]
22:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Dunker Church, George B. Anderson, Robert Rodes, Richard A. Oakford, Roulette farm, and The Gleam of Bayonets"}],["$","small",null,{"children":"The automated transcript produces forms including “Dunkirk Church,” “Rhodes,” “Oakley,” “roulette,” and “In the Gleam of Bayonets.” This guide uses the historical names and titles."}]]}]
23:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
24:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","French turns toward the Confederate center",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep196-french-approach.svg","target":"_blank","rel":"noreferrer","aria-label":"Open French turns toward the Confederate center at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep196-french-approach.svg","alt":"Schematic map of French’s division moving south from the Roulette farm toward Confederate brigades in the Sunken Road.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"French turns toward the Confederate center"}],["$","span",null,{"children":"French reached the East Woods without orders or a guide from Sumner. He moved south through the Roulette farm toward the Sunken Road, where Rodes and George B. Anderson held the main Confederate position and battered remnants extended west to the Hagerstown Turnpike. Richard H. Anderson’s division approached from the south. Routes and positions are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep196-french-approach.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield Bloody Lane Trail, Official Reports, Antietam Battlefield Board atlas, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","French’s three brigade attacks",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep196-sunken-road-waves.svg","target":"_blank","rel":"noreferrer","aria-label":"Open French’s three brigade attacks at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep196-sunken-road-waves.svg","alt":"Schematic tactical diagram showing Weber, Morris, and Kimball attacking the Sunken Road in three successive waves.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"French’s three brigade attacks"}],["$","span",null,{"children":"Weber, Morris, and Kimball attacked in sequence across the ridge north of the Sunken Road. The protected defenders waited until each Federal line came into close range. Weber was wounded, Morris’s green regiments were checked, and Oakford was killed with Kimball’s 132nd Pennsylvania before the survivors fell back behind the ridge. Attacks and positions are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep196-sunken-road-waves.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield Bloody Lane Trail stops 3–6, French’s and Kimball’s Official Reports, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],"$L2a"]}]]}]
25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Ordered II Corps into the battle; the episode begins after its divisions had become separated during the approach"}]]}],["$","div","II Corps-Maj. Gen. Edwin V. Sumner",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps"}],["$","span",null,{"children":"Maj. Gen. Edwin V. Sumner"}],["$","small",null,{"children":"Led Sedgwick away without leaving French a guide, then sent orders for French to press the Confederate center"}]]}],["$","div","3rd Division, II Corps-Brig. Gen. William H. French",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division, II Corps"}],["$","span",null,{"children":"Brig. Gen. William H. French"}],["$","small",null,{"children":"Directed about 5,700 men in three brigade attacks from the Roulette farm toward the Sunken Road"}]]}],["$","div","1st Brigade, French’s division-Brig. Gen. Max Weber",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, French’s division"}],["$","span",null,{"children":"Brig. Gen. Max Weber"}],["$","small",null,{"children":"Led the 1st Delaware, 5th Maryland, and 4th New York in the first assault; severely wounded"}]]}],["$","div","2nd Brigade, French’s division-Col. Dwight Morris",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade, French’s division"}],["$","span",null,{"children":"Col. Dwight Morris"}],["$","small",null,{"children":"Led the new 108th New York, 130th Pennsylvania, and 14th Connecticut in the second assault"}]]}],["$","div","3rd Brigade, French’s division-Brig. Gen. Nathan Kimball",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Brigade, French’s division"}],["$","span",null,{"children":"Brig. Gen. Nathan Kimball"}],["$","small",null,{"children":"Shifted east with the 14th Indiana, 8th Ohio, 7th Virginia (later 7th West Virginia), and 132nd Pennsylvania for the third assault"}]]}],["$","div","132nd Pennsylvania, Kimball’s brigade-Col. Richard A. Oakford",{"className":"command-entry","children":[["$","strong",null,{"children":"132nd Pennsylvania, Kimball’s brigade"}],["$","span",null,{"children":"Col. Richard A. Oakford"}],["$","small",null,{"children":"Rallied the new regiment after the beehive incident and was killed while leading it near the ridge"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Inspected Hill’s line as French approached and directed Richard H. Anderson’s division toward the center"}]]}],"$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31"]]}]]}],"$L32"]]]}]
