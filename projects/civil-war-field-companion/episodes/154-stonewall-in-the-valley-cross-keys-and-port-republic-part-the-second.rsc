34:["$","div","Trimble’s brigade fires at close range",{"className":"moment","children":[["$","$L30",null,{"seconds":942,"label":"15:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Trimble’s brigade fires at close range"}],["$","p",null,{"children":"The Confederates wait behind the fence until the New Yorkers are roughly 40–50 yards away, then deliver a concentrated volley."}]]}]]}]
35:["$","div","The 8th New York is broken",{"className":"moment","children":[["$","$L30",null,{"seconds":966,"label":"16:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 8th New York is broken"}],["$","p",null,{"children":"The episode gives 43 killed, 134 wounded, and about 40 captured before the survivors retreat."}]]}]]}]
36:["$","div","Trimble begins a counterattack",{"className":"moment","children":[["$","$L30",null,{"seconds":980,"label":"16:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Trimble begins a counterattack"}],["$","p",null,{"children":"After recalling the immediate pursuit, Trimble moves against a Federal battery and Bohlen’s brigade with support from Elzey’s regiments."}]]}]]}]
