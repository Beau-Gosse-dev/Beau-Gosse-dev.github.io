38:["$","div","Milroy’s flank move is recalled",{"className":"moment","children":[["$","$L30",null,{"seconds":1075,"label":"17:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Milroy’s flank move is recalled"}],["$","p",null,{"children":"A courier reaches Milroy just as the 25th Ohio is moving toward the Confederate left; Milroy complies despite objecting to the order."}]]}]]}]
39:["$","div","Schenck’s brigade remains idle",{"className":"moment","children":[["$","$L30",null,{"seconds":1109,"label":"18:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schenck’s brigade remains idle"}],["$","p",null,{"children":"Milroy sees five regiments uncommitted and later argues that their use on his right could have strengthened his attack."}]]}]]}]
3a:["$","div","Cross Keys firing ends",{"className":"moment","children":[["$","$L30",null,{"seconds":1200,"label":"20:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cross Keys firing ends"}],["$","p",null,{"children":"The episode places the end of the action at about 6:15 p.m.; both armies remain near the field after the Federal withdrawal."}]]}]]}]
3b:["$","div","Trimble proposes a night attack",{"className":"moment","children":[["$","$L30",null,{"seconds":1216,"label":"20:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Trimble proposes a night attack"}],["$","p",null,{"children":"He wants to strike Frémont’s campfires but does not receive Ewell’s permission."}]]}]]}]
3c:["$","div","Jackson sets the June 9 plan",{"className":"moment","children":[["$","$L30",null,{"seconds":1260,"label":"21:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson sets the June 9 plan"}],["$","p",null,{"children":"Ewell learns that the army will concentrate at Port Republic, attack the eastern Federal force first, and turn back toward Frémont only if time permits."}]]}]]}]
3d:["$","div","Ewell marches toward Port Republic",{"className":"moment","children":[["$","$L30",null,{"seconds":1574,"label":"26:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell marches toward Port Republic"}],["$","p",null,{"children":"Most of his division leaves Cross Keys before dawn while Trimble and Patton temporarily watch Frémont as rear guard."}]]}]]}]
3e:["$","div","Winder starts across the rivers",{"className":"moment","children":[["$","$L30",null,{"seconds":1604,"label":"26:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Winder starts across the rivers"}],["$","p",null,{"children":"At about 5 a.m. the Stonewall Brigade crosses through Port Republic and uses the makeshift South River span to approach Tyler’s line."}]]}]]}]
3f:["$","div","Tyler’s position is defined",{"className":"moment","children":[["$","$L30",null,{"seconds":1635,"label":"27:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Tyler’s position is defined"}],["$","p",null,{"children":"Open fields provide clear fire, the South Fork protects the Federal right, and the Coaling anchors the left."}]]}]]}]
40:["$","div","Fog covers the deployment",{"className":"moment","children":[["$","$L30",null,{"seconds":1697,"label":"28:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fog covers the deployment"}],["$","p",null,{"children":"Winder places the 5th and 27th Virginia against the Federal right before the fog clears around 5:45 a.m."}]]}]]}]
41:["$","div","The artillery duel begins",{"className":"moment","children":[["$","$L30",null,{"seconds":1716,"label":"28:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The artillery duel begins"}],["$","p",null,{"children":"Poague’s guns exchange fire with the stronger Federal artillery position for at least an hour in some accounts."}]]}]]}]
42:["$","div","The crossing becomes a bottleneck",{"className":"moment","children":[["$","$L30",null,{"seconds":1766,"label":"29:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"The crossing becomes a bottleneck"}],["$","p",null,{"children":"Troops and wagons clog Port Republic and the makeshift bridge, delaying the reinforcements Winder needs."}]]}]]}]
43:["$","div","Winder attacks before support is massed",{"className":"moment","children":[["$","$L30",null,{"seconds":1840,"label":"30:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Winder attacks before support is massed"}],["$","p",null,{"children":"The 5th and 27th Virginia and 7th Louisiana advance across open ground toward the Federal right along Lewiston Lane."}]]}]]}]
44:["$","div","The first Confederate attack fails",{"className":"moment","children":[["$","$L30",null,{"seconds":1957,"label":"32:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first Confederate attack fails"}],["$","p",null,{"children":"Federal infantry stops the advance and counterattacks, driving back Winder’s line and forcing Confederate gunners to abandon pieces."}]]}]]}]
45:["$","div","Virginia reinforcements stabilize the line",{"className":"moment","children":[["$","$L30",null,{"seconds":2015,"label":"33:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia reinforcements stabilize the line"}],["$","p",null,{"children":"The 44th and 58th Virginia arrive, stop the Federal advance, and allow the Confederates to restore a front across the bottomland."}]]}]]}]
46:["$","div","Jackson shifts attention to the Coaling",{"className":"moment","children":[["$","$L30",null,{"seconds":2072,"label":"34:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson shifts attention to the Coaling"}],["$","p",null,{"children":"The failed attack on Tyler’s right demonstrates that the Federal artillery on the left must be neutralized."}]]}]]}]
47:["$","div","The first Coaling assault is repulsed",{"className":"moment","children":[["$","$L30",null,{"seconds":2120,"label":"35:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first Coaling assault is repulsed"}],["$","p",null,{"children":"The 2nd and 4th Virginia and a two-gun section cannot overcome musketry and canister from the height."}]]}]]}]
48:["$","div","Taylor’s Louisiana Brigade is committed",{"className":"moment","children":[["$","$L30",null,{"seconds":2158,"label":"35:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taylor’s Louisiana Brigade is committed"}],["$","p",null,{"children":"The 8th and 9th Louisiana and Wheat’s Battalion move through dense woods and underbrush toward the Federal guns."}]]}]]}]
49:["$","div","The Louisianans reach the battery",{"className":"moment","children":[["$","$L30",null,{"seconds":2197,"label":"36:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Louisianans reach the battery"}],["$","p",null,{"children":"Taylor’s men emerge near the Coaling, cross a ravine, and overrun part of the gun line before Federal infantry counterattacks."}]]}]]}]
4a:["$","div","The first capture is reversed",{"className":"moment","children":[["$","$L30",null,{"seconds":2294,"label":"38:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first capture is reversed"}],["$","p",null,{"children":"After about fifteen minutes of close fighting, Ohio troops drive Taylor’s brigade back; only one recaptured gun can be removed."}]]}]]}]
4b:["$","div","Frémont advances too late at Cross Keys",{"className":"moment","children":[["$","$L30",null,{"seconds":2317,"label":"38:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Frémont advances too late at Cross Keys"}],["$","p",null,{"children":"At about 10 a.m. his lead troops find Ewell gone. Ewell’s brigades are already passing through Port Republic toward the June 9 battlefield."}]]}]]}]
4c:["$","div","Ewell strikes the shifting Federal left",{"className":"moment","children":[["$","$L30",null,{"seconds":2354,"label":"39:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell strikes the shifting Federal left"}],["$","p",null,{"children":"Arriving Confederates fire into the 5th and 7th Ohio while those regiments are moving from Lewiston Lane toward the Coaling."}]]}]]}]
4d:["$","div","Taylor’s final attack takes the Coaling",{"className":"moment","children":[["$","$L30",null,{"seconds":2395,"label":"39:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taylor’s final attack takes the Coaling"}],["$","p",null,{"children":"After repeated repulses, Confederate pressure and reinforcements force the Federal defenders from the height."}]]}]]}]
4e:["$","div","Winder renews the attack",{"className":"moment","children":[["$","$L30",null,{"seconds":2444,"label":"40:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Winder renews the attack"}],["$","p",null,{"children":"Seeing Federal units leave the Lewiston Lane line, Winder presses the 27th Virginia forward as the left flank gives way."}]]}]]}]
4f:["$","div","Jackson secures the field",{"className":"moment","children":[["$","$L30",null,{"seconds":2477,"label":"41:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson secures the field"}],["$","p",null,{"children":"By about 11 a.m. Tyler’s line has collapsed and the Confederates begin a pursuit that the episode places at roughly eight miles."}]]}]]}]
50:["$","div","The burned bridge blocks Frémont",{"className":"moment","children":[["$","$L30",null,{"seconds":2483,"label":"41:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"The burned bridge blocks Frémont"}],["$","p",null,{"children":"His troops reach the opposite side of the South Fork after the rear guard destroys the North River bridge, preventing direct support for Tyler."}]]}]]}]
51:["$","div","The cost of Port Republic is assessed",{"className":"moment","children":[["$","$L30",null,{"seconds":2534,"label":"42:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cost of Port Republic is assessed"}],["$","p",null,{"children":"The episode gives 816 Confederate casualties and just over 1,000 United States casualties after a four-hour battle."}]]}]]}]
52:["$","div","Shields encounters the retreat",{"className":"moment","children":[["$","$L30",null,{"seconds":2594,"label":"43:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shields encounters the retreat"}],["$","p",null,{"children":"Still short of the battlefield, he rallies fugitives from Tyler’s and Carroll’s commands and prepares to continue the movement."}]]}]]}]
53:["$","div","McDowell ends the pursuit",{"className":"moment","children":[["$","$L30",null,{"seconds":2625,"label":"43:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"McDowell ends the pursuit"}],["$","p",null,{"children":"Orders direct Shields back to Luray for a return toward Fredericksburg; a similar direction goes to Frémont."}]]}]]}]
54:["$","div","The book recommendation",{"className":"moment","children":[["$","$L30",null,{"seconds":2659,"label":"44:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The book recommendation"}],["$","p",null,{"children":"The hosts recommend Donald C. Pfanz’s biography “Richard S. Ewell: A Soldier’s Life.”"}]]}]]}]
55:["$","div","Valley District and combined Valley Army",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District and combined Valley Army"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Controlled the Port Republic crossings, assigned Ewell to hold Frémont on June 8, and personally directed the June 9 attack against Tyler"}]]}]
56:["$","div","Division at Cross Keys",{"className":"command-entry","children":[["$","strong",null,{"children":"Division at Cross Keys"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Deployed about 5,800 by the NPS estimate, repelled Frémont, left a rear guard, and led most of the division to reinforce Jackson at Port Republic"}]]}]
57:["$","div","Left brigade, Ewell’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Left brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. George H. Steuart"}],["$","small",null,{"children":"Held the western portion of Ewell’s Cross Keys line against the sector approached by Milroy"}]]}]
58:["$","div","Center brigade, Ewell’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Center brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Arnold Elzey"}],["$","small",null,{"children":"Supported the central artillery; regiments under Col. James A. Walker reinforced Trimble’s counterattack. Elzey was seriously wounded but survived"}]]}]
59:["$","div","Right brigade, Ewell’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Right brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Isaac R. Trimble"}],["$","small",null,{"children":"Destroyed the isolated 8th New York attack, counterattacked the Federal left, and served as part of the rear guard on June 9"}]]}]
5a:["$","div","Stonewall Brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Brig. Gen. Charles S. Winder"}],["$","small",null,{"children":"Led the first main attack at Port Republic with elements of the 5th, 27th, 2nd, and 4th Virginia and later renewed pressure along Lewiston Lane"}]]}]
5b:["$","div","Louisiana Brigade, Ewell’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Louisiana Brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Richard Taylor"}],["$","small",null,{"children":"Led the 8th and 9th Louisiana and Wheat’s Battalion through the woods in repeated attacks that ultimately took the Coaling"}]]}]
5c:["$","div","Louisiana Tigers battalion",{"className":"command-entry","children":[["$","strong",null,{"children":"Louisiana Tigers battalion"}],["$","span",null,{"children":"Maj. Chatham Roberdeau Wheat"}],["$","small",null,{"children":"Fought under Taylor in the close action around the Coaling and helped disable artillery horses so the guns could not be removed"}]]}]
5d:["$","div","Rockbridge Artillery",{"className":"command-entry","children":[["$","strong",null,{"children":"Rockbridge Artillery"}],["$","span",null,{"children":"Capt. William T. Poague"}],["$","small",null,{"children":"Opened the June 9 artillery action in support of Winder; Federal counterbattery fire held the advantage"}]]}]
5e:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
5f:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Thomas J. “Stonewall” Jackson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-stonewall-jackson.jpg","alt":"Portrait of Thomas J. “Stonewall” Jackson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Overall Confederate commander who used the river crossings to keep Frémont and Shields apart, then directed the piecemeal but successful attack at Port Republic"}]]}]]}],["$","article","Richard S. Ewell",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-richard-ewell.jpg","alt":"Portrait of Richard S. Ewell","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Richard S. Ewell"}],["$","p",null,{"children":"Division commander who selected and held the Cross Keys position, then transferred most of his force to Jackson at Port Republic"}]]}]]}],["$","article","John C. Frémont",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-john-fremont.jpg","alt":"Portrait of John C. Frémont","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John C. Frémont"}],["$","p",null,{"children":"Mountain Department commander whose incorrect strength estimate and fragmented control limited the Federal attack at Cross Keys"}]]}]]}],["$","article","Isaac R. Trimble",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"IR"