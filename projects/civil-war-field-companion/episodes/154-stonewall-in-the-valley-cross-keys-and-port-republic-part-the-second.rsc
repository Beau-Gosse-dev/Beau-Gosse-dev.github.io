1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",154," · ","June 8–9, 1862"," · ","Cross Keys and Port Republic, Rockingham County, Virginia, at the southern end of Massanutten Mountain and the junction of the North and South rivers"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: CROSS KEYS & PORT REPUBLIC (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Confederate victories at Cross Keys and Port Republic. Ewell stopped Frémont on June 8, then most of his division reinforced Jackson against Tyler and Carroll on June 9. Control and destruction of the river bridges kept the two United States columns from combining. McDowell subsequently recalled Shields toward Fredericksburg, Frémont also withdrew, and the 1862 Valley Campaign ended with Jackson free to reinforce Lee near Richmond"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6617234635.mp3?updated=1695325894","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The battles of Cross Keys and Port Republic, June 8–9, 1862"}],["$","small",null,{"children":"The episode begins with a recap of Carroll’s June 8 action at Port Republic, then covers Cross Keys and the following day’s battle at Port Republic."}]]}],["$","div","Operational problem",{"children":[["$","span",null,{"children":"Operational problem"}],["$","strong",null,{"children":"Keep Frémont and Shields separated, then defeat their forces in turn"}],["$","small",null,{"children":"Jackson controlled the bridges around Port Republic. Massanutten Mountain and the rivers limited the routes by which the two United States columns could support one another."}]]}],["$","div","Cross Keys result",{"children":[["$","span",null,{"children":"Cross Keys result"}],["$","strong",null,{"children":"Confederate victory on June 8"}],["$","small",null,{"children":"Ewell held the approaches to Port Republic and preserved Jackson’s control of the crossings."}]]}],["$","div","Cross Keys strength",{"children":[["$","span",null,{"children":"Cross Keys strength"}],["$","strong",null,{"children":"NPS estimate: 11,500 United States; 5,800 Confederate"}],["$","small",null,{"children":"The episode gives Frémont’s own figure of 10,500, Milroy’s estimate of about 12,000, and fewer than 5,000 under Ewell. Returns, availability, and rounding produce different totals."}]]}],["$","div","Cross Keys casualties",{"children":[["$","span",null,{"children":"Cross Keys casualties"}],["$","strong",null,{"children":"NPS battle detail: 684 United States; 288 Confederate"}],["$","small",null,{"children":"The NPS campaign overview gives 664 and 287 instead. The episode rounds the losses to nearly 700 and slightly fewer than 300, so the exact aggregate remains source-dependent."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}],"$L26","$L27","$L28","$L29",false,"$L2a","$L2b","$L2c"]}]]}]
30:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Ewell’s line",{"children":[["$","span",null,{"children":"Ewell’s line"}],["$","strong",null,{"children":"Steuart on the left, Elzey and artillery in the center, Trimble on the right"}],["$","small",null,{"children":"Trimble received permission to advance his brigade beyond the main line to the Pence farm, where his men used a rise and split-rail fence."}]]}]
f:["$","div","Frémont’s deployment",{"children":[["$","span",null,{"children":"Frémont’s deployment"}],["$","strong",null,{"children":"A broad Federal line formed without firm central direction at the front"}],["$","small",null,{"children":"After a limited reconnaissance, Frémont left detailed placement largely to staff officers identified in the episode as Colonel Albert and Lieutenant Colonel Pilson. The episode describes Frémont as remaining in the rear and receiving incomplete information."}]]}]
10:["$","div","Frémont’s mistaken estimate",{"children":[["$","span",null,{"children":"Frémont’s mistaken estimate"}],["$","strong",null,{"children":"He believed he faced Jackson’s entire army and was outnumbered"}],["$","small",null,{"children":"In fact his force outnumbered Ewell’s division by about two to one. This incorrect estimate shaped his cautious and fragmented attacks."}]]}]
11:["$","div","8th New York",{"children":[["$","span",null,{"children":"8th New York"}],["$","strong",null,{"children":"About 548 men attacked Trimble without effective support"}],["$","small",null,{"children":"The 45th New York stopped short, two other Stahel regiments lost direction, and one remained with a battery."}]]}]
12:["$","div","Close-range volley",{"children":[["$","span",null,{"children":"Close-range volley"}],["$","strong",null,{"children":"43 killed, 134 wounded, and about 43 captured in the 8th New York"}],["$","small",null,{"children":"NPS gives a total loss of about 40 percent after Trimble’s brigade waited behind the fence until the attackers were roughly 40–50 yards away."}]]}]
13:["$","div","Trimble’s counterattack",{"children":[["$","span",null,{"children":"Trimble’s counterattack"}],["$","strong",null,{"children":"Pressed Stahel and Bohlen back on the Federal left"}],["$","small",null,{"children":"Trimble’s advance included the 15th Alabama, 16th Mississippi, and 21st Georgia, supported in part by regiments from Elzey’s brigade. The exact position and timing of each regiment varied during the movement."}]]}]
14:["$","div","Milroy’s sector",{"children":[["$","span",null,{"children":"Milroy’s sector"}],["$","strong",null,{"children":"A developing move against the Confederate left was recalled"}],["$","small",null,{"children":"Milroy was advancing through difficult ground and had sent the 25th Ohio toward the Confederate flank when Frémont ordered the army back."}]]}]
15:["$","div","Unused strength",{"children":[["$","span",null,{"children":"Unused strength"}],["$","strong",null,{"children":"Schenck’s brigade remained largely uncommitted"}],["$","small",null,{"children":"Milroy later argued that placing Schenck on his right could have changed the action. That is a participant’s counterfactual judgment, not a demonstrable outcome."}]]}]
16:["$","div","Cross Keys firing ends",{"children":[["$","span",null,{"children":"Cross Keys firing ends"}],["$","strong",null,{"children":"About 6:15 p.m. on June 8"}],["$","small",null,{"children":"Frémont withdrew to his earlier position under artillery protection rather than renew a coordinated assault."}]]}]
17:["$","div","Rejected night attack",{"children":[["$","span",null,{"children":"Rejected night attack"}],["$","strong",null,{"children":"Ewell denied Trimble permission to attack Frémont’s camps"}],["$","small",null,{"children":"Ewell prioritized Jackson’s plan to concentrate against the force east of Port Republic on the morning of June 9."}]]}]
18:["$","div","Confederate night movement",{"children":[["$","span",null,{"children":"Confederate night movement"}],["$","strong",null,{"children":"Most of Ewell’s division marched from Cross Keys to Port Republic"}],["$","small",null,{"children":"Trimble and Patton remained temporarily as a rear guard with orders to retire and burn the North River bridge if pressed."}]]}]
19:["$","div","Port Republic result",{"children":[["$","span",null,{"children":"Port Republic result"}],["$","strong",null,{"children":"Confederate victory by about 11 a.m. on June 9"}],["$","small",null,{"children":"The fall of the Coaling forced Tyler’s line to withdraw. Confederate pursuit continued for roughly eight miles in the episode’s account."}]]}]
1a:["$","div","Port Republic strength",{"children":[["$","span",null,{"children":"Port Republic strength"}],["$","strong",null,{"children":"NPS estimate: 3,500 United States; 6,000 Confederate"}],["$","small",null,{"children":"The episode describes about 4,000 men from Tyler’s and Carroll’s brigades on the field. Shields and the other two brigades of his division were still many miles away."}]]}]
1b:["$","div","Port Republic casualties",{"children":[["$","span",null,{"children":"Port Republic casualties"}],["$","strong",null,{"children":"1,002 United States; 816 Confederate"}],["$","small",null,{"children":"These are the NPS campaign figures and match the episode’s 816 Confederates and just over 1,000 Federals. The United States total includes a substantial number captured or missing."}]]}]
1c:["$","div","Federal position",{"children":[["$","span",null,{"children":"Federal position"}],["$","strong",null,{"children":"Right on the South Fork; left anchored on the Coaling"}],["$","small",null,{"children":"Tyler’s line followed the Lewiston Lane area across open bottomland. Artillery on the approximately 70-foot rise could fire across much of the field."}]]}]
1d:["$","div","Crossing bottleneck",{"children":[["$","span",null,{"children":"Crossing bottleneck"}],["$","strong",null,{"children":"Port Republic streets and the makeshift South River crossing delayed support"}],["$","small",null,{"children":"The episode describes a crossing built from wagons and sawmill boards. Congestion caused Jackson to commit units before his force was fully assembled."}]]}]
1e:["$","div","Initial Confederate attack",{"children":[["$","span",null,{"children":"Initial Confederate attack"}],["$","strong",null,{"children":"Winder’s attack against the Federal right was repulsed"}],["$","small",null,{"children":"The 5th and 27th Virginia and 7th Louisiana attacked before adequate reinforcements arrived. The Federal counterattack briefly endangered the Confederate line and forced the abandonment of artillery pieces."}]]}]
1f:["$","div","The Coaling",{"children":[["$","span",null,{"children":"The Coaling"}],["$","strong",null,{"children":"The decisive point at Port Republic"}],["$","small",null,{"children":"The first attack by parts of the Stonewall Brigade failed. Taylor’s Louisiana Brigade then fought repeated close-range actions for the Federal guns until Confederate reinforcements helped secure the height."}]]}]
20:["$","div","Frémont blocked",{"children":[["$","span",null,{"children":"Frémont blocked"}],["$","strong",null,{"children":"Arrived opposite Port Republic after the North River bridge was burned"}],["$","small",null,{"children":"His batteries fired across the river but could not provide useful infantry support to Tyler and Carroll. The episode repeats William C. Oates’s later allegation that the fire endangered Confederate ambulances and parties assisting wounded men."}]]}]
21:["$","div","Command casualties",{"children":[["$","span",null,{"children":"Command casualties"}],["$","strong",null,{"children":"No senior leader was killed or mortally wounded in these two battles"}],["$","small",null,{"children":"Brigade commander Arnold Elzey was seriously wounded at Cross Keys, and 7th Louisiana commander Harry T. Hays was wounded in the shoulder at Port Republic. Neither wound was fatal, so the leader-loss list is empty."}]]}]
22:["$","div","End of the campaign",{"children":[["$","span",null,{"children":"End of the campaign"}],["$","strong",null,{"children":"McDowell ordered Shields back toward Luray and Fredericksburg"}],["$","small",null,{"children":"A similar withdrawal direction went to Frémont. Jackson later crossed the Blue Ridge and joined Lee for the defense of Richmond."}]]}]
23:["$","div","Historical-image caution",{"children":[["$","span",null,{"children":"Historical-image caution"}],["$","strong",null,{"children":"The Library of Congress Cross Keys drawing is contemporary but not a tactical map"}],["$","small",null,{"children":"Its catalog title says Sunday, June 7, 1862; Sunday was June 8. The drawing is useful visual evidence of the battlefield experience, but its title contains a one-day date error."}]]}]
24:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Frémont, Ewell, Stahel, Blenker, Cluseret, Bohlen, Schenck, Koltes, Pilson, Steuart, Elzey, Pence, Poague, Lewiston Lane, the Coaling, Luray, and Pfanz"}],["$","small",null,{"children":"The automated transcript renders several names phonetically, including Ewell as “Yule,” Elzey as “Elsie,” and the Coaling as “colon.”"}]]}]
25:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“Richard S. Ewell: A Soldier’s Life” by Donald C. Pfanz"}],["$","small",null,{"children":"The transcript misrecognizes both the subject’s surname and the author’s surname."}]]}]
26:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
27:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The two-battle operational problem",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep154-operational-overview.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The two-battle operational problem at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-operational-overview.svg","alt":"Schematic overview of Frémont approaching Cross Keys, Shields’s troops approaching Port Republic, and Ewell moving between the two battlefields.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The two-battle operational problem"}],["$","span",null,{"children":"Frémont approached from Harrisonburg on the west side of the river system while Shields’s detached brigades approached Port Republic from the Page Valley. Jackson’s possession of the crossings allowed Ewell to fight at Cross Keys on June 8 and then move most of his division to Port Republic for June 9. Routes and positions are approximate. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep154-operational-overview.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service battle histories, Official Records, and Hotchkiss map; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Cross Keys: attack and counterattack",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep154-cross-keys-movements.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Cross Keys: attack and counterattack at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-cross-keys-movements.svg","alt":"Schematic troop-movement map of Cross Keys showing Ewell’s line, the isolated 8th New York attack, Trimble’s counterattack, and Milroy’s recalled advance.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Cross Keys: attack and counterattack"}],["$","span",null,{"children":"Ewell placed Steuart on the left, Elzey in the center, and Trimble forward on the right. The 8th New York advanced without effective support and was stopped by Trimble’s close-range volley. Trimble then pressed the Federal left while Milroy’s separate movement on the opposite flank was recalled. Unit blocks and routes show relationships rather than exact formations. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep154-cross-keys-movements.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service Cross Keys history and Official Records; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Port Republic: the fight for the Coaling",{"className":"reference-map","children":["$L2d","$L2e"]}],"$L2f"]}]]}]
28:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Carroll’s June 8 action is reviewed",{"className":"moment","children":[["$","$L30",null,{"seconds":281,"label":"4:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Carroll’s June 8 action is reviewed"}],["$","p",null,{"children":"The episode resumes with Carroll’s failed attempt to hold the North River bridge at Port Republic and the arrival of Tyler’s brigade later that day."}]]}]]}],["$","div","Tyler decides to remain",{"className":"moment","children":[["$","$L30",null,{"seconds":451,"label":"7:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Tyler decides to remain"}],["$","p",null,{"children":"Eight regiments and three batteries from Tyler’s and Carroll’s brigades take position northeast of Port Republic rather than withdraw."}]]}]]}],["$","div","The account turns to Cross Keys",{"className":"moment","children":[["$","$L30",null,{"seconds":473,"label":"7:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"The account turns to Cross Keys"}],["$","p",null,{"children":"While Jackson dealt with events at Port Republic, Frémont advanced from Harrisonburg against Ewell northwest of the town."}]]}]]}],["$","div","Strength estimates are compared",{"className":"moment","children":[["$","$L30",null,{"seconds":546,"label":"9:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Strength estimates are compared"}],["$","p",null,{"children":"Frémont reported 10,500 men, Milroy estimated about 12,000, and the episode places fewer than 5,000 Confederates with Ewell."}]]}]]}],["$","div","Frémont’s column leaves Harrisonburg",{"className":"moment","children":[["$","$L30",null,{"seconds":570,"label":"9:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Frémont’s column leaves Harrisonburg"}],["$","p",null,{"children":"The lead brigade marched at about 4:45 a.m., followed by the remaining infantry brigades and artillery."}]]}]]}],["$","div","Pickets make first contact",{"className":"moment","children":[["$","$L30",null,{"seconds":622,"label":"10:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pickets make first contact"}],["$","p",null,{"children":"Cluseret’s skirmishers encounter two companies of the 15th Alabama north of Union Church Cemetery between 8 and 8:30 a.m."}]]}]]}],["$","div","Ewell forms his line",{"className":"moment","children":[["$","$L30",null,{"seconds":641,"label":"10:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell forms his line"}],["$","p",null,{"children":"Steuart anchors the left, Elzey and four batteries occupy the center, and Trimble holds the right."}]]}]]}],["$","div","Trimble advances to the Pence farm",{"className":"moment","children":[["$","$L30",null,{"seconds":684,"label":"11:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Trimble advances to the Pence farm"}],["$","p",null,{"children":"Concerned about the woods and his refused flank, Trimble moves forward of Ewell’s main line and uses a rise and rail fence."}]]}]]}],["$","div","The Confederate defense is ready",{"className":"moment","children":[["$","$L30",null,{"seconds":699,"label":"11:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate defense is ready"}],["$","p",null,{"children":"By about 10 a.m. Ewell’s brigades occupy the ground blocking Frémont’s route toward Port Republic."}]]}]]}],["$","div","Frémont describes the position",{"className":"moment","children":[["$","$L30",null,{"seconds":722,"label":"12:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Frémont describes the position"}],["$","p",null,{"children":"He reports a strong wooded ridge commanding the road junction and continues to believe the Confederate force is larger than his own."}]]}]]}],["$","div","Ewell’s artillery opens",{"className":"moment","children":[["$","$L30",null,{"seconds":806,"label":"13:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell’s artillery opens"}],["$","p",null,{"children":"Confederate batteries in the center begin firing as the Federal brigades deploy; Frémont’s artillery answers."}]]}]]}],["$","div","Frémont attacks Ewell’s right",{"className":"moment","children":["$L31","$L32"]}],"$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51","$L52","$L53","$L54"]}]]}]
29:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Mountain Department army at Cross Keys",{"className":"command-entry","children":[["$","strong",null,{"children":"Mountain Department army at Cross Keys"}],["$","span",null,{"children":"Maj. Gen. John C. Frémont"}],["$","small",null,{"children":"Approximately 11,500 by the NPS estimate; brigades under Cluseret, Stahel, Milroy, Bohlen, Schenck, and Koltes, with senior staff officers Colonel Albert and Lieutenant Colonel John Pilson directing important parts of the deployment"}]]}],["$","div","Division in Frémont’s army",{"className":"command-entry","children":[["$","strong",null,{"children":"Division in Frémont’s army"}],["$","span",null,{"children":"Brig. Gen. Louis Blenker"}],["$","small",null,{"children":"Included Stahel, Bohlen, and Koltes; the principal June 8 attack began with Stahel’s brigade on the Federal left"}]]}],["$","div","Brigade, Blenker’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Blenker’s division"}],["$","span",null,{"children":"Brig. Gen. Julius Stahel"}],["$","small",null,{"children":"Only the 8th New York completed the initial assault against Trimble; the brigade did not attack as a coordinated body"}]]}],["$","div","Independent brigade in Frémont’s army",{"className":"command-entry","children":[["$","strong",null,{"children":"Independent brigade in Frémont’s army"}],["$","span",null,{"children":"Brig. Gen. Robert H. Milroy"}],["$","small",null,{"children":"Advanced against the Confederate left and began a flank movement with the 25th Ohio before obeying Frémont’s withdrawal order"}]]}],["$","div","Brigade in Frémont’s army",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade in Frémont’s army"}],["$","span",null,{"children":"Brig. Gen. Robert C. Schenck"}],["$","small",null,{"children":"Remained largely uncommitted at Cross Keys; Milroy later criticized the failure to use the brigade"}]]}],["$","div","Division, Department of the Rappahannock",{"className":"command-entry","children":[["$","strong",null,{"children":"Division, Department of the Rappahannock"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"Not present at Port Republic; Tyler and Carroll were the two advance brigades while Shields remained with the rest of the division farther north"}]]}],["$","div","Senior United States commander at Port Republic",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior United States commander at Port Republic"}],["$","span",null,{"children":"Col. Erastus B. Tyler"}],["$","small",null,{"children":"Directed his brigade and Carroll’s brigade, about 3,500 by the NPS estimate, and anchored the line between the South Fork and the Coaling"}]]}],["$","div","Brigade in Shields’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade in Shields’s division"}],["$","span",null,{"children":"Brig. Gen. Samuel S. Carroll"}],["$","small",null,{"children":"Urged withdrawal after the failed June 8 bridge action but fought under Tyler’s senior command on June 9"}]]}],["$","div","Coaling infantry and artillery defense",{"className":"command-entry","children":[["$","strong",null,{"children":"Coaling infantry and artillery defense"}],["$","span",null,{"children":"Col. Charles Candy / Maj. James F. Huntington"}],["$","small",null,{"children":"Candy’s 66th Ohio supported the guns; Huntington commanded Battery H, 1st Ohio Light Artillery, in the contested artillery position"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],["$L55","$L56","$L57","$L58","$L59","$L5a","$L5b","$L5c","$L5d"]]}]]}],"$L5e","$L5f"]}]
2a:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep154-operational-overview.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-operational-overview.svg","alt":"Schematic operational map of the two Federal approaches and the Confederate movement between Cross Keys and Port Republic.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Control of the Port Republic crossings let Jackson shift forces between two separated opponents on June 8 and 9. The map is schematic and not to scale."}]]}],["$","figure","/images/ep154-cross-keys-movements.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-cross-keys-movements.svg","alt":"Schematic Cross Keys map showing Ewell’s ridge, the 8th New York attack, and Trimble’s counterattack.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Frémont’s numerical advantage did not become a coordinated assault. Trimble stopped the isolated 8th New York and then pushed against the Federal left."}]]}],["$","figure","/images/ep154-port-republic-movements.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-port-republic-movements.svg","alt":"Schematic Port Republic map showing Tyler’s line, the Coaling, and the Confederate attacks.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Winder’s attack across the bottomland failed. Taylor’s repeated attacks and Ewell’s arriving reinforcements took the Coaling and forced Tyler to withdraw."}]]}],["$","figure","/images/ep154-cross-keys-forbes.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-cross-keys-forbes.jpg","alt":"Edwin Forbes pencil drawing of soldiers and combat at Cross Keys.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Edwin Forbes’s contemporary pencil drawing of Cross Keys. The Library of Congress catalog title gives Sunday, June 7, although the battle occurred on Sunday, June 8, 1862."}]]}],["$","figure","/images/ep154-port-republic-hotchkiss.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-port-republic-hotchkiss.jpg","alt":"Jedediah Hotchkiss’s 1886 manuscript topographic map of Port Republic battlefield.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hotchkiss’s postwar map records the battlefield’s roads, residents, waterways, and relief. It is historical geographic evidence rather than an exact unit-position map."}]]}],["$","figure","/images/ep154-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-stonewall-jackson.jpg","alt":"Photographic portrait from life of Confederate general Thomas J. Stonewall Jackson.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson chose to fight the separated Federal columns and controlled the bridges that made the sequence possible, but at Port Republic he attacked before his troops were fully massed."}]]}],["$","figure","/images/ep154-richard-ewell.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep154-richard-ewell.jpg","alt":"Civil War-era photographic portrait of Confederate general Richard Stoddert Ewell in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Ewell conducted the defensive battle at Cross Keys and then moved most of his division to reinforce Jackson at Port Republic."}]]}],["$","figure","/images/ep154-john-fremont.jpg",{"children":["$L60","$L61"]}]]}]]}]
