d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",105," · ","April 1861–March 8, 1862"," · ","Gosport Navy Yard, Norfolk, and Hampton Roads, Virginia"]}],["$","h1",null,{"children":"CLASH OF THE IRONCLADS (Part the First)"}],["$","span",null,{"className":"result-label","children":"The Confederacy rebuilt the burned steam frigate USS Merrimack as the ironclad CSS Virginia. On March 8, 1862, Franklin Buchanan took Virginia into Hampton Roads and attacked the United States blockading squadron, sinking USS Cumberland and destroying USS Congress. USS Monitor arrived that night; the duel between the ironclads is covered in episode 106"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 1861–March 8, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Gosport Navy Yard, Norfolk, and Hampton Roads, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"The Confederacy rebuilt the burned steam frigate USS Merrimack as the ironclad CSS Virginia. On March 8, 1862, Franklin Buchanan took Virginia into Hampton Roads and attacked the United States blockading squadron, sinking USS Cumberland and destroying USS Congress. USS Monitor arrived that night; the duel between the ironclads is covered in episode 106"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Crew",{"children":[["$","th",null,{"scope":"row","children":"Crew"}],["$","td",null,{"children":["About 320 officers and men","$undefined"]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":[["$"