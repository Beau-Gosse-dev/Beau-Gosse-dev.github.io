13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The naval battle coincided with Pea Ridge",{"className":"moment","children":[["$","$L19",null,{"seconds":68,"label":"1:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The naval battle coincided with Pea Ridge"}],["$","p",null,{"children":"On March 8, 1862, the first day of the Hampton Roads battle began while the armies at Pea Ridge were preparing for their second day of fighting."}]]}]]}],["$","div","Confederates recovered Merrimack’s hull",{"className":"moment","children":[["$","$L19",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates recovered Merrimack’s hull"}],["$","p",null,{"children":"United States forces burned and sank USS Merrimack when they evacuated Gosport Navy Yard in April 1861. The machinery and lower hull remained usable after the Confederacy took the yard."}]]}]]}],["$","div","Merrimack became CSS Virginia",{"className":"moment","children":[["$","$L19",null,{"seconds":106,"label":"1:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Merrimack became CSS Virginia"}],["$","p",null,{"children":"Confederate engineers cut down the frigate and built an armored casemate over the surviving hull. The completed ship was commissioned as CSS Virginia."}]]}]]}],["$","div","Wood and iron protected the casemate",{"className":"moment","children":[["$","$L19",null,{"seconds":110,"label":"1:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wood and iron protected the casemate"}],["$","p",null,{"children":"The sloped sides used 24 inches of pine and oak covered by two layers of 2-inch iron plate."}]]}]]}],["$","div","A ram was fixed to the bow",{"className":"moment","children":[["$","$L19",null,{"seconds":122,"label":"2:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"A ram was fixed to the bow"}],["$","p",null,{"children":"A roughly 1,500-pound iron ram projected about three feet from the bow for attacks below an enemy ship’s waterline."}]]}]]}],["$","div","Virginia was a large ship",{"className":"moment","children":[["$","$L19",null,{"seconds":124,"label":"2:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia was a large ship"}],["$","p",null,{"children":"The rebuilt vessel was 275 feet long, slightly more than 51 feet wide, and carried a crew of about 320."}]]}]]}],["$","div","Ten guns filled the battery",{"className":"moment","children":[["$","$L19",null,{"seconds":133,"label":"2:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ten guns filled the battery"}],["$","p",null,{"children":"Virginia carried two 7-inch Brooke rifles, two 6.4-inch Brooke rifles, and six 9-inch Dahlgren smoothbores."}]]}]]}],["$","div","Virginia entered Confederate service",{"className":"moment","children":[["$","$L19",null,{"seconds":145,"label":"2:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia entered Confederate service"}],["$","p",null,{"children":"The Confederate Navy commissioned the ship on February 17, 1862."}]]}]]}],["$","div","Buchanan left Gosport on March 8",{"className":"moment","children":[["$","$L19",null,{"seconds":151,"label":"2:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buchanan left Gosport on March 8"}],["$","p",null,{"children":"Franklin Buchanan took Virginia down the Elizabeth River on what was expected to be a trial run, then continued into Hampton Roads to attack the blockading squadron."}]]}]]}],["$","div","Virginia broke the wooden-ship line",{"className":"moment","children":[["$","$L19",null,{"seconds":169,"label":"2:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia broke the wooden-ship line"}],["$","p",null,{"children":"Virginia sank Cumberland with gunfire and its ram, forced Congress to surrender and burn, and helped drive Minnesota, Roanoke, and St. Lawrence aground."}]]}]]}],["$","div","Virginia withdrew at about 5 p.m.",{"className":"moment","children":[["$","$L19",null,{"seconds":190,"label":"3:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia withdrew at about 5 p.m."}],["$","p",null,{"children":"The falling tide and damage to the ship led Buchanan’s command to leave the scene and return toward the Elizabeth River."}]]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a"]}]]}]
