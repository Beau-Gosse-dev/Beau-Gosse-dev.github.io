1a:["$","div","Monitor reached Hampton Roads that night",{"className":"moment","children":[["$","$L19",null,{"seconds":207,"label":"3:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Monitor reached Hampton Roads that night"}],["$","p",null,{"children":"USS Monitor arrived from New York and took position near the grounded Minnesota. The ironclads fought on March 9."}]]}]]}]
1b:["$","div","Stephen Mallory became Confederate Navy secretary",{"className":"moment","children":[["$","$L19",null,{"seconds":263,"label":"4:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stephen Mallory became Confederate Navy secretary"}],["$","p",null,{"children":"Jefferson Davis appointed Mallory in February 1861. The Confederacy began without a national navy or a shipbuilding system."}]]}]]}]
1c:["$","div","Mallory had maritime and Senate experience",{"className":"moment","children":[["$","$L19",null,{"seconds":307,"label":"5:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mallory had maritime and Senate experience"}],["$","p",null,{"children":"Mallory was born in Trinidad, grew up in Key West, practiced maritime law, and won election to the United States Senate in 1851."}]]}]]}]
1d:["$","div","Mallory had directed naval legislation",{"className":"moment","children":[["$","$L19",null,{"seconds":385,"label":"6:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mallory had directed naval legislation"}],["$","p",null,{"children":"As a member and later chairman of the Senate Naval Affairs Committee, he supported fleet expansion and technical improvements before secession."}]]}]]}]
1e:["$","div","The Confederacy started with ten small vessels",{"className":"moment","children":[["$","$L19",null,{"seconds":463,"label":"7:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederacy started with ten small vessels"}],["$","p",null,{"children":"Its initial force consisted of four revenue cutters, an old side-wheel steamer, and several tenders and tugs. None could match a major United States warship."}]]}]]}]
1f:["$","div","The United States fleet expanded rapidly",{"className":"moment","children":[["$","$L19",null,{"seconds":570,"label":"9:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"The United States fleet expanded rapidly"}],["$","p",null,{"children":"The United States Navy had more than 100 warships early in the conflict and 264 by December 1861."}]]}]]}]
20:["$","div","Mallory chose several ways to offset the fleet imbalance",{"className":"moment","children":[["$","$L19",null,{"seconds":622,"label":"10:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mallory chose several ways to offset the fleet imbalance"}],["$","p",null,{"children":"His department pursued new weapons, bought and built ships abroad, and used commerce raiders and privateers against United States shipping."}]]}]]}]
21:["$","div","The Confederate Navy developed new weapons",{"className":"moment","children":[["$","$L19",null,{"seconds":764,"label":"12:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate Navy developed new weapons"}],["$","p",null,{"children":"The department supported electrically detonated mines, then called torpedoes, as well as submarines and armored ships."}]]}]]}]
22:["$","div","Mallory made iron armor a priority",{"className":"moment","children":[["$","$L19",null,{"seconds":809,"label":"13:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mallory made iron armor a priority"}],["$","p",null,{"children":"He argued that armored ships could withstand the guns of wooden warships and reduce the United States Navy’s numerical advantage."}]]}]]}]
23:["$","div","Armored vessels already existed",{"className":"moment","children":[["$","$L19",null,{"seconds":923,"label":"15:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Armored vessels already existed"}],["$","p",null,{"children":"Korean, Spanish, French, and British ships had used armor before the Civil War. The French Gloire and British Warrior showed that seagoing armored warships were practical."}]]}]]}]
24:["$","div","The design team selected Merrimack",{"className":"moment","children":[["$","$L19",null,{"seconds":1103,"label":"18:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"The design team selected Merrimack"}],["$","p",null,{"children":"John M. Brooke, John L. Porter, and William P. Williamson met Mallory on June 23, 1861, and recommended converting the wreck at Gosport."}]]}]]}]
25:["$","div","Congress funded the conversion",{"className":"moment","children":[["$","$L19",null,{"seconds":1152,"label":"19:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Congress funded the conversion"}],["$","p",null,{"children":"The Confederate Congress appropriated $170,000 for the project."}]]}]]}]
26:["$","div","Tredegar supplied the armor",{"className":"moment","children":[["$","$L19",null,{"seconds":1208,"label":"20:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Tredegar supplied the armor"}],["$","p",null,{"children":"Tredegar Iron Works in Richmond was the only Southern mill able to roll the required plates. It delivered about 725 tons of iron for the ship."}]]}]]}]
27:["$","div","Conditions aboard were poor",{"className":"moment","children":[["$","$L19",null,{"seconds":1284,"label":"21:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Conditions aboard were poor"}],["$","p",null,{"children":"The casemate had limited ventilation, heat, smoke, and crowded accommodations. Catesby ap Roger Jones described the ship as unhealthy for its crew."}]]}]]}]
28:["$","div","Draft and engines limited the ship",{"className":"moment","children":[["$","$L19",null,{"seconds":1316,"label":"21:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Draft and engines limited the ship"}],["$","p",null,{"children":"Virginia drew more than 22 feet of water and used the unreliable engines condemned before Merrimack’s loss. It made only about five or six knots and turned slowly."}]]}]]}]
29:["$","div","Buchanan entered Confederate service",{"className":"moment","children":[["$","$L19",null,{"seconds":1390,"label":"23:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buchanan entered Confederate service"}],["$","p",null,{"children":"The veteran United States Navy officer resigned in 1861 when he expected Maryland to secede. Gideon Welles refused his attempt to withdraw the resignation, and Buchanan later joined the Confederate Navy."}]]}]]}]
2a:["$","div","The ship went directly into combat",{"className":"moment","children":[["$","$L19",null,{"seconds":1471,"label":"24:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"The ship went directly into combat"}],["$","p",null,{"children":"Buchanan reported aboard on March 4. Four days later, Virginia left on its first powered trip with untested guns and yard workers still aboard, then attacked the blockade."}]]}]]}]
2b:["$","article","John M. Brooke",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JM"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"John M. Brooke"}],["$","p",null,{"children":"Developed the ironclad proposal, armor arrangement, and Brooke rifled guns"}]]}]]}]
2c:["$","article","John L. Porter",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"John L. Porter"}],["$","p",null,{"children":"Naval constructor responsible for much of Virginia’s design and conversion"}]]}]]}]
