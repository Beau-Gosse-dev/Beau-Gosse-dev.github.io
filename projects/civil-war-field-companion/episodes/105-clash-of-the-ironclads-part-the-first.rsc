1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",105," · ","April 1861–March 8, 1862"," · ","Gosport Navy Yard, Norfolk, and Hampton Roads, Virginia"]}],["$","h1",null,{"children":"CLASH OF THE IRONCLADS (Part the First)"}],["$","span",null,{"className":"result-label","children":"The Confederacy rebuilt the burned steam frigate USS Merrimack as the ironclad CSS Virginia. On March 8, 1862, Franklin Buchanan took Virginia into Hampton Roads and attacked the United States blockading squadron, sinking USS Cumberland and destroying USS Congress. USS Monitor arrived that night; the duel between the ironclads is covered in episode 106"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8779347956.mp3?updated=1695129198","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","CSS Virginia commissioned",{"children":[["$","span",null,{"children":"CSS Virginia commissioned"}],["$","strong",null,{"children":"February 17, 1862"}],"$undefined"]}],["$","div","Hull",{"children":[["$","span",null,{"children":"Hull"}],["$","strong",null,{"children":"275 feet long; slightly more than 51 feet wide"}],"$undefined"]}],["$","div","Crew",{"children":[["$","span",null,{"children":"Crew"}],["$","strong",null,{"children":"About 320 officers and men"}],"$undefined"]}],["$","div","Casemate protection",{"children":[["$","span",null,{"children":"Casemate protection"}],["$","strong",null,{"children":"24 inches of pine and oak under two layers of 2-inch iron plate"}],"$undefined"]}],["$","div","Ram",{"children":[["$","span",null,{"children":"Ram"}],["$","strong",null,{"children":"About 1,500 pounds and projected roughly 3 feet from the bow"}],"$undefined"]}],["$","div","Armament",{"children":[["$","span",null,{"children":"Armament"}],["$","strong",null,{"children":"Two 7-inch Brooke rifles, two 6.4-inch Brooke rifles, and six 9-inch Dahlgren smoothbores"}],"$undefined"]}],["$","div","Maximum speed",{"children":[["$","span",null,{"children":"Maximum speed"}],["$","strong",null,{"children":"About 5–6 knots with unreliable engines"}],"$undefined"]}],["$","div","March 8 result",{"children":[["$","span",null,{"children":"March 8 result"}],["$","strong",null,{"children":"Cumberland sunk; Congress destroyed; Minnesota grounded; Virginia withdrew with the tide"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}],"$undefined",["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Hampton Roads today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-76.48%2C36.76%2C-76.20%2C37.05&layer=mapnik&marker=36.987%2C-76.309","title":"Hampton Roads today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Hampton Roads today"}],["$","span",null,{"children":"Hampton Roads is the harbor where the James, Elizabeth, and Nansemond rivers meet the Chesapeake Bay. The former Gosport Navy Yard is now Norfolk Naval Shipyard in Portsmouth. Newport News Point, Sewell’s Point, and Fort Monroe define the approaches to the 1862 battlefield."}],"$Le","$Lf"]}]]}],"$L10","$L11"]}]]}],false,"$L12","$L13","$L14","$L15","$L16"]}]]}]
