1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",168," · ","July 1–August 3, 1862"," · ","Malvern Hill and Harrison’s Landing on the James River, Virginia; Washington, D.C.; and the planned transfer route through Fort Monroe to Aquia Creek, Virginia"]}],["$","h1",null,{"children":"\"IT IS DETERMINED TO WITHDRAW YOUR ARMY FROM THE PENINSULA\""}],["$","span",null,{"className":"result-label","children":"The Army of the Potomac won the defensive battle at Malvern Hill but continued its withdrawal to Harrison’s Landing rather than counterattacking. McClellan then asked for major reinforcements to renew operations against Richmond. After consulting him, General-in-Chief Henry W. Halleck concluded that Washington could not supply the requested force and ordered the army transferred from the Peninsula to Aquia Creek to unite with John Pope’s Army of Virginia"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3146931375.mp3?updated=1695385169","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The aftermath of Malvern Hill, the Harrison’s Landing encampment, and the decision to end the Peninsula Campaign"}],["$","small",null,{"children":"The opening section reviews responsibility for the July 1 battle before the narrative follows McClellan, Lincoln, and Halleck through August 3."}]]}],["$","div","Malvern Hill result",{"children":[["$","span",null,{"children":"Malvern Hill result"}],["$","strong",null,{"children":"United States victory on July 1, 1862"}],["$","small",null,{"children":"Confederate attacks were poorly coordinated and failed to break the Federal position. The National Park Service estimates about 3,000 United States and 5,355 Confederate casualties."}]]}],["$","div","Confederate attack pattern",{"children":[["$","span",null,{"children":"Confederate attack pattern"}],["$","strong",null,{"children":"Separate brigades entered the fight without a single coordinated assault"}],["$","small",null,{"children":"The episode accepts D. H. Hill’s criticism that the attacks were piecemeal but rejects his claim that Magruder’s command did little fighting."}]]}],["$","div","Magruder’s participation",{"children":[["$","span",null,{"children":"Magruder’s participation"}],["$","strong",null,{"children":"Three of four brigades made substantial attacks"}],["$","small",null,{"children":"The episode states that Magruder’s men reached closer to the Federal line near the Crew house than other Confederate formations."}]]}],["$","div","Episode’s responsibility assessment",{"children":[["$","span",null,{"children":"Episode’s responsibility assessment"}],["$","strong",null,{"children":"Robert E. Lee held final command responsibility for the failed attacks"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}],"$L1e","$undefined","$L1f",false,"$L20",false,"$L21","$L22","$L23"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","small",null,{"children":"This is the hosts’ interpretation. They emphasize Lee’s approval of the artillery plan, the ambiguous attack order, his failure to cancel it, and his later orders to continue the assault."}]
f:["$","div","Withdrawal after Malvern Hill",{"children":[["$","span",null,{"children":"Withdrawal after Malvern Hill"}],["$","strong",null,{"children":"About eight miles to Harrison’s Landing on July 2"}],["$","small",null,{"children":"McClellan declined proposals for a counterattack and moved the army down the James River to an entrenched position protected by United States gunboats."}]]}]
10:["$","div","Army at Harrison’s Landing",{"children":[["$","span",null,{"children":"Army at Harrison’s Landing"}],["$","strong",null,{"children":"About 100,000 soldiers in the U.S. Army campaign summary"}],["$","small",null,{"children":"The army occupied a strong bridgehead on the James. Disease, heat, logistics, and the separation from Pope’s army shaped the administration’s later decision."}]]}]
11:["$","div","McClellan’s enemy estimate",{"children":[["$","span",null,{"children":"McClellan’s enemy estimate"}],["$","strong",null,{"children":"Nearly 180,000 Confederates in the episode’s account"}],["$","small",null,{"children":"The episode presents this as a serious overestimate that reinforced McClellan’s belief that withdrawal was necessary."}]]}]
12:["$","div","Field command criticism",{"children":[["$","span",null,{"children":"Field command criticism"}],["$","strong",null,{"children":"The episode faults McClellan for remaining away from key fighting"}],["$","small",null,{"children":"The hosts distinguish their explanation—protection of his reputation—from either personal cowardice or treason. That explanation is interpretation, not an established documentary fact."}]]}]
13:["$","div","Lincoln at Harrison’s Landing",{"children":[["$","span",null,{"children":"Lincoln at Harrison’s Landing"}],["$","strong",null,{"children":"July 7, 1862"}],["$","small",null,{"children":"Lincoln traveled to inspect the army and met McClellan. The Library of Congress dates McClellan’s Harrison’s Landing letter to the president to the same day."}]]}]
14:["$","div","Harrison’s Landing letter",{"children":[["$","span",null,{"children":"Harrison’s Landing letter"}],["$","strong",null,{"children":"Military strategy and a conciliatory war policy"}],["$","small",null,{"children":"McClellan argued that the war should preserve the Union without becoming a campaign of subjugation, confiscation, or forcible abolition. The episode describes the letter as unsolicited advice extending beyond field command."}]]}]
15:["$","div","Second Confiscation Act",{"children":[["$","span",null,{"children":"Second Confiscation Act"}],["$","strong",null,{"children":"Approved July 17, 1862"}],["$","small",null,{"children":"The legislation expanded Federal action against rebel property and addressed the freedom of enslaved people held by participants in the rebellion."}]]}]
16:["$","div","First emancipation draft presented",{"children":[["$","span",null,{"children":"First emancipation draft presented"}],["$","strong",null,{"children":"July 22, 1862"}],["$","small",null,{"children":"Lincoln read his preliminary draft to the cabinet as a military measure. He delayed public issuance until after a favorable military event; the preliminary proclamation followed Antietam in September."}]]}]
17:["$","div","New general-in-chief",{"children":[["$","span",null,{"children":"New general-in-chief"}],["$","strong",null,{"children":"Henry W. Halleck, appointed July 11, 1862"}],["$","small",null,{"children":"The post had been vacant since Lincoln removed McClellan from the general-in-chief role in March. McClellan remained commander of the Army of the Potomac."}]]}]
18:["$","div","Halleck’s consultation",{"children":[["$","span",null,{"children":"Halleck’s consultation"}],["$","strong",null,{"children":"July 24–27, 1862"}],["$","small",null,{"children":"Halleck’s official report says that he left Washington on July 24, consulted McClellan at Harrison’s Landing, and returned on July 27. The episode describes him as arriving on July 24."}]]}]
19:["$","div","Reinforcement sequence",{"children":[["$","span",null,{"children":"Reinforcement sequence"}],["$","strong",null,{"children":"50,000 requested; 20,000 offered; 35,000 later stated as necessary"}],["$","small",null,{"children":"Halleck reported that McClellan initially wanted at least 50,000 additional troops, agreed the next morning to attempt an advance with 20,000, and then raised the requirement to 35,000 after Halleck returned to Washington."}]]}]
1a:["$","div","Withdrawal order",{"children":[["$","span",null,{"children":"Withdrawal order"}],["$","strong",null,{"children":"August 3, 1862, at 7:45 p.m."}],["$","small",null,{"children":"Halleck ordered McClellan to begin immediate measures to transfer the army from the Peninsula to Aquia Creek while covering the movement."}]]}]
1b:["$","div","Strategic purpose",{"children":[["$","span",null,{"children":"Strategic purpose"}],["$","strong",null,{"children":"Unite McClellan’s army with Pope’s and cover Washington"}],["$","small",null,{"children":"Halleck argued that the administration could not reinforce both separated armies and that Aquia Creek offered the feasible route to concentrate them on the Rappahannock line."}]]}]
1c:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Abraham Lincoln and the Second American Revolution” by James M. McPherson"}],["$","small",null,{"children":"The podcast’s official book list identifies this collection of essays as the recommendation for episode 168."}]]}]
1d:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Benjamin Huger, Philip Kearny, Lafayette McLaws, William H. C. Whiting, George Brinton McClellan, and Gideon Welles"}],["$","small",null,{"children":"The automated transcript produces “U.J.,” “Kearney,” “McClaws,” “Whiting” without initials, “George Britton McClellan,” and “Wells.” “U.J.” refers to Huger."}]]}]
