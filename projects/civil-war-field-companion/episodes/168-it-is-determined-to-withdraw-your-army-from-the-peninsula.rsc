14:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L22","/images/ep168-waud-harrisons-line.jpg",{"image":"/images/ep168-waud-harrisons-line.jpg","alt":"Alfred Waud drawing of the fortified Federal line at Harrison’s Landing with soldiers, artillery, earthworks, and tents.","caption":"Alfred R. Waud drew the Harrison’s Landing line in July or August 1862. The long, narrow field sketch records the defensive camp occupied after the Seven Days.","name":"Alfred Waud drawing of the fortified Federal line at Harrison’s Landing with soldiers, artillery, earthworks, and tents.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L22","/images/ep168-harrisons-landing-headquarters.jpg",{"image":"/images/ep168-harrisons-landing-headquarters.jpg","alt":"Nine United States soldiers and an African American cook posed in front of the Fifth Corps headquarters tent at Harrison’s Landing.","caption":"The Fifth Corps headquarters at Harrison’s Landing, photographed in August 1862. Fitz John Porter is among the identified officers; the Library of Congress catalog also identifies the Black man at the left as the headquarters cook.","name":"Nine United States soldiers and an African American cook posed in front of the Fifth Corps headquarters tent at Harrison’s Landing.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L22","/images/ep168-george-mcclellan.jpg",{"image":"/images/ep168-george-mcclellan.jpg","alt":"Wartime glass-plate portrait of Major General George B. McClellan in United States Army uniform.","caption":"George B. McClellan commanded the Army of the Potomac throughout the Peninsula Campaign and remained personally popular with many of its soldiers despite criticism of his battlefield conduct and strategic decisions.","name":"Wartime glass-plate portrait of Major General George B. McClellan in United States Army uniform.","source":"$undefined","credit":"Library of Congress Civil War photograph collection; see sources below."}],["$","$L22","/images/ep168-henry-halleck.jpg",{"image":"/images/ep168-henry-halleck.jpg","alt":"Wartime glass-plate portrait of Major General Henry W. Halleck in United States Army uniform.","caption":"Henry W. Halleck became general-in-chief in July 1862. His Harrison’s Landing consultation and August 3 telegram ended the administration’s attempt to continue the Peninsula approach.","name":"Wartime glass-plate portrait of Major General Henry W. Halleck in United States Army uniform.","source":"$undefined","credit":"Library of Congress Civil War photograph collection; see sources below."}]]}]]}]
