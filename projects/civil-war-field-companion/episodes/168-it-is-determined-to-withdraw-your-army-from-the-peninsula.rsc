10:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/10/16/civil-war-podcast-episode-168/",{"href":"https://civilwarpodcast.org/2016/10/16/civil-war-podcast-episode-168/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 168 page"]}],["$","a","https://civilwarpodcast.org/book-recommendations/",{"href":"https://civilwarpodcast.org/book-recommendations/","target":"_blank","rel":"noreferrer","children":[" · ","Official Civil War Podcast book recommendations"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va021",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va021","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of Malvern Hill"]}],["$","a","https://www.nps.gov/rich/learn/historyculture/mhbull.htm",{"href":"https://www.nps.gov/rich/learn/historyculture/mhbull.htm","target":"_blank","rel":"noreferrer","children":[" · ","Richmond National Battlefield Park: The Battle of Malvern Hill"]}],["$","a","https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/",{"href":"https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Civil War campaign summary"]}],["$","a","https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo72995/pdf/GOVPUB-D114-PURL-gpo72995.pdf",{"href":"https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo72995/pdf/GOVPUB-D114-PURL-gpo72995.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://www.historyofwar.org/sources/acw/officialrecords/vol011chap023part1/00001_p3_09.html",{"href":"https://www.historyofwar.org/sources/acw/officialrecords/vol011chap023part1/00001_p3_09.html","target":"_blank","rel":"noreferrer","children":[" · ","Official Records: McClellan report and Halleck correspondence, August 1862"]}],["$","a","https://www.loc.gov/collections/george-brinton-mcclellan-papers/articles-and-essays/timeline/",{"href":"https://www.loc.gov/collections/george-brinton-mcclellan-papers/articles-and-essays/timeline/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: McClellan papers timeline"]}],["$","a","https://www.loc.gov/item/mal1685600/",{"href":"https://www.loc.gov/item/mal1685600/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: July 7 Harrison’s Landing letter cover"]}],["$","a","https://www.loc.gov/collections/abraham-lincoln-papers/articles-and-essays/abraham-lincoln-and-emancipation/",{"href":"https://www.loc.gov/collections/abraham-lincoln-papers/articles-and-essays/abraham-lincoln-and-emancipation/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Lincoln and emancipation"]}],["$","a","https://www.loc.gov/resource/mal.1723200/?st=text",{"href":"https://www.loc.gov/resource/mal.1723200/?st=text","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: July 22 preliminary emancipation draft"]}],["$","a","https://www.archives.gov/education/lessons/blacks-civil-war",{"href":"https://www.archives.gov/education/lessons/blacks-civil-war","target":"_blank","rel":"noreferrer","children":[" · ","National Archives: Black soldiers and the July 1862 legislation"]}],["$","a","https://www.nps.gov/people/george-b-mcclellan.htm",{"href":"https://www.nps.gov/people/george-b-mcclellan.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: George B. McClellan"]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}]
