1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",168," · ","July 1–August 3, 1862"," · ","Malvern Hill and Harrison’s Landing on the James River, Virginia; Washington, D.C.; and the planned transfer route through Fort Monroe to Aquia Creek, Virginia"]}],["$","h1",null,{"children":"\"IT IS DETERMINED TO WITHDRAW YOUR ARMY FROM THE PENINSULA\""}],["$","span",null,{"className":"result-label","children":"The Army of the Potomac won the defensive battle at Malvern Hill but continued its withdrawal to Harrison’s Landing rather than counterattacking. McClellan then asked for major reinforcements to renew operations against Richmond. After consulting him, General-in-Chief Henry W. Halleck concluded that Washington could not supply the requested force and ordered the army transferred from the Peninsula to Aquia Creek to unite with John Pope’s Army of Virginia"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3146931375.mp3?updated=1695385169","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The aftermath of Malvern Hill, the Harrison’s Landing encampment, and the decision to end the Peninsula Campaign"}],["$","small",null,{"children":"The opening section reviews responsibility for the July 1 battle before the narrative follows McClellan, Lincoln, and Halleck through August 3."}]]}],["$","div","Malvern Hill result",{"children":[["$","span",null,{"children":"Malvern Hill result"}],["$","strong",null,{"children":"United States victory on July 1, 1862"}],["$","small",null,{"children":"Confederate attacks were poorly coordinated and failed to break the Federal position. The National Park Service estimates about 3,000 United States and 5,355 Confederate casualties."}]]}],["$","div","Confederate attack pattern",{"children":[["$","span",null,{"children":"Confederate attack pattern"}],["$","strong",null,{"children":"Separate brigades entered the fight without a single coordinated assault"}],["$","small",null,{"children":"The episode accepts D. H. Hill’s criticism that the attacks were piecemeal but rejects his claim that Magruder’s command did little fighting."}]]}],["$","div","Magruder’s participation",{"children":[["$","span",null,{"children":"Magruder’s participation"}],["$","strong",null,{"children":"Three of four brigades made substantial attacks"}],["$","small",null,{"children":"The episode states that Magruder’s men reached closer to the Federal line near the Crew house than other Confederate formations."}]]}],["$","div","Episode’s responsibility assessment",{"children":[["$","span",null,{"children":"Episode’s responsibility assessment"}],["$","strong",null,{"children":"Robert E. Lee held final command responsibility for the failed attacks"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}],"$L1e","$L1f","$L20","$L21",false,"$L22","$L23","$L24"]}]]}]
25:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"This is the hosts’ interpretation. They emphasize Lee’s approval of the artillery plan, the ambiguous attack order, his failure to cancel it, and his later orders to continue the assault."}]
f:["$","div","Withdrawal after Malvern Hill",{"children":[["$","span",null,{"children":"Withdrawal after Malvern Hill"}],["$","strong",null,{"children":"About eight miles to Harrison’s Landing on July 2"}],["$","small",null,{"children":"McClellan declined proposals for a counterattack and moved the army down the James River to an entrenched position protected by United States gunboats."}]]}]
10:["$","div","Army at Harrison’s Landing",{"children":[["$","span",null,{"children":"Army at Harrison’s Landing"}],["$","strong",null,{"children":"About 100,000 soldiers in the U.S. Army campaign summary"}],["$","small",null,{"children":"The army occupied a strong bridgehead on the James. Disease, heat, logistics, and the separation from Pope’s army shaped the administration’s later decision."}]]}]
11:["$","div","McClellan’s enemy estimate",{"children":[["$","span",null,{"children":"McClellan’s enemy estimate"}],["$","strong",null,{"children":"Nearly 180,000 Confederates in the episode’s account"}],["$","small",null,{"children":"The episode presents this as a serious overestimate that reinforced McClellan’s belief that withdrawal was necessary."}]]}]
12:["$","div","Field command criticism",{"children":[["$","span",null,{"children":"Field command criticism"}],["$","strong",null,{"children":"The episode faults McClellan for remaining away from key fighting"}],["$","small",null,{"children":"The hosts distinguish their explanation—protection of his reputation—from either personal cowardice or treason. That explanation is interpretation, not an established documentary fact."}]]}]
13:["$","div","Lincoln at Harrison’s Landing",{"children":[["$","span",null,{"children":"Lincoln at Harrison’s Landing"}],["$","strong",null,{"children":"July 7, 1862"}],["$","small",null,{"children":"Lincoln traveled to inspect the army and met McClellan. The Library of Congress dates McClellan’s Harrison’s Landing letter to the president to the same day."}]]}]
14:["$","div","Harrison’s Landing letter",{"children":[["$","span",null,{"children":"Harrison’s Landing letter"}],["$","strong",null,{"children":"Military strategy and a conciliatory war policy"}],["$","small",null,{"children":"McClellan argued that the war should preserve the Union without becoming a campaign of subjugation, confiscation, or forcible abolition. The episode describes the letter as unsolicited advice extending beyond field command."}]]}]
15:["$","div","Second Confiscation Act",{"children":[["$","span",null,{"children":"Second Confiscation Act"}],["$","strong",null,{"children":"Approved July 17, 1862"}],["$","small",null,{"children":"The legislation expanded Federal action against rebel property and addressed the freedom of enslaved people held by participants in the rebellion."}]]}]
16:["$","div","First emancipation draft presented",{"children":[["$","span",null,{"children":"First emancipation draft presented"}],["$","strong",null,{"children":"July 22, 1862"}],["$","small",null,{"children":"Lincoln read his preliminary draft to the cabinet as a military measure. He delayed public issuance until after a favorable military event; the preliminary proclamation followed Antietam in September."}]]}]
17:["$","div","New general-in-chief",{"children":[["$","span",null,{"children":"New general-in-chief"}],["$","strong",null,{"children":"Henry W. Halleck, appointed July 11, 1862"}],["$","small",null,{"children":"The post had been vacant since Lincoln removed McClellan from the general-in-chief role in March. McClellan remained commander of the Army of the Potomac."}]]}]
18:["$","div","Halleck’s consultation",{"children":[["$","span",null,{"children":"Halleck’s consultation"}],["$","strong",null,{"children":"July 24–27, 1862"}],["$","small",null,{"children":"Halleck’s official report says that he left Washington on July 24, consulted McClellan at Harrison’s Landing, and returned on July 27. The episode describes him as arriving on July 24."}]]}]
19:["$","div","Reinforcement sequence",{"children":[["$","span",null,{"children":"Reinforcement sequence"}],["$","strong",null,{"children":"50,000 requested; 20,000 offered; 35,000 later stated as necessary"}],["$","small",null,{"children":"Halleck reported that McClellan initially wanted at least 50,000 additional troops, agreed the next morning to attempt an advance with 20,000, and then raised the requirement to 35,000 after Halleck returned to Washington."}]]}]
1a:["$","div","Withdrawal order",{"children":[["$","span",null,{"children":"Withdrawal order"}],["$","strong",null,{"children":"August 3, 1862, at 7:45 p.m."}],["$","small",null,{"children":"Halleck ordered McClellan to begin immediate measures to transfer the army from the Peninsula to Aquia Creek while covering the movement."}]]}]
1b:["$","div","Strategic purpose",{"children":[["$","span",null,{"children":"Strategic purpose"}],["$","strong",null,{"children":"Unite McClellan’s army with Pope’s and cover Washington"}],["$","small",null,{"children":"Halleck argued that the administration could not reinforce both separated armies and that Aquia Creek offered the feasible route to concentrate them on the Rappahannock line."}]]}]
1c:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Abraham Lincoln and the Second American Revolution” by James M. McPherson"}],["$","small",null,{"children":"The podcast’s official book list identifies this collection of essays as the recommendation for episode 168."}]]}]
1d:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Benjamin Huger, Philip Kearny, Lafayette McLaws, William H. C. Whiting, George Brinton McClellan, and Gideon Welles"}],["$","small",null,{"children":"The automated transcript produces “U.J.,” “Kearney,” “McClaws,” “Whiting” without initials, “George Britton McClellan,” and “Wells.” “U.J.” refers to Huger."}]]}]
1e:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
1f:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","From Malvern Hill to Harrison’s Landing",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep168-malvern-to-harrisons.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From Malvern Hill to Harrison’s Landing at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep168-malvern-to-harrisons.svg","alt":"Generalized schematic map showing the Army of the Potomac withdrawing from Malvern Hill to Harrison’s Landing on July 2, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From Malvern Hill to Harrison’s Landing"}],["$","span",null,{"children":"After the July 1 defensive victory, the Army of the Potomac moved roughly eight miles down the James River and established an entrenched camp at Harrison’s Landing under naval protection. Shoreline, road, route, position, and distance are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep168-malvern-to-harrisons.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Library of Congress maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Strategic choices after the Seven Days",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep168-strategic-options.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Strategic choices after the Seven Days at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep168-strategic-options.svg","alt":"Generalized schematic map of Washington, Aquia Creek, Pope’s position, Richmond, Petersburg, Fort Monroe, and McClellan at Harrison’s Landing.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Strategic choices after the Seven Days"}],["$","span",null,{"children":"McClellan proposed renewed operations against Richmond, including a possible movement toward Petersburg, but required reinforcements. Halleck instead ordered the army to move through Fort Monroe toward Aquia Creek so it could join Pope’s Army of Virginia and help cover Washington. Locations, waterways, routes, positions, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep168-strategic-options.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Halleck’s official report, U.S. Army campaign histories, Library of Congress maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
20:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode returns to Malvern Hill",{"className":"moment","children":[["$","$L25",null,{"seconds":119,"label":"1:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode returns to Malvern Hill"}],["$","p",null,{"children":"The narrative begins by reviewing the final battle of the Seven Days and the Confederate defeat on July 1."}]]}]]}],["$","div","D. H. Hill identifies piecemeal attacks",{"className":"moment","children":[["$","$L25",null,{"seconds":193,"label":"3:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"D. H. Hill identifies piecemeal attacks"}],["$","p",null,{"children":"The episode accepts Hill’s criticism that Confederate units entered separately but rejects his claim that Magruder’s command did little fighting."}]]}]]}],["$","div","Jackson’s role is reassessed",{"className":"moment","children":[["$","$L25",null,{"seconds":234,"label":"3:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s role is reassessed"}],["$","p",null,{"children":"D. H. Hill’s division attacked under Jackson’s authority, and additional divisions were moving forward when darkness ended the battle."}]]}]]}],["$","div","Huger’s brigades enter the account",{"className":"moment","children":[["$","$L25",null,{"seconds":256,"label":"4:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Huger’s brigades enter the account"}],["$","p",null,{"children":"The transcript’s “U.J.” is Benjamin Huger. The episode states that three of his four brigades eventually joined the fighting despite friction with Magruder."}]]}]]}],["$","div","Longstreet and the artillery plan",{"className":"moment","children":[["$","$L25",null,{"seconds":270,"label":"4:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet and the artillery plan"}],["$","p",null,{"children":"The episode notes criticism of Longstreet for encouraging the belief that two large Confederate artillery groupings could suppress the Federal guns."}]]}]]}],["$","div","Magruder’s conduct is reviewed",{"className":"moment","children":[["$","$L25",null,{"seconds":293,"label":"4:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Magruder’s conduct is reviewed"}],["$","p",null,{"children":"The hosts separate Magruder’s delayed arrival from his later attacks, which they describe as compliance with Lee’s repeated orders."}]]}]]}],["$","div","Two attack orders reach Magruder",{"className":"moment","children":[["$","$L25",null,{"seconds":323,"label":"5:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two attack orders reach Magruder"}],["$","p",null,{"children":"One order came through Lee’s chief of staff, Robert H. Chilton, and another came from Lee through Captain A. G. Dickinson."}]]}]]}],["$","div","The hosts assign final responsibility to Lee",{"className":"moment","children":[["$","$L25",null,{"seconds":366,"label":"6:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The hosts assign final responsibility to Lee"}],["$","p",null,{"children":"Their interpretation places command responsibility for Malvern Hill’s Confederate defeat on the army commander."}]]}]]}],["$","div","The attack signal was unclear",{"className":"moment","children":[["$","$L25",null,{"seconds":378,"label":"6:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack signal was unclear"}],["$","p",null,{"children":"Chilton’s untimed order made the advance of Lewis Armistead’s brigade the signal for a general assault, but the episode states that Armistead was not informed of that role."}]]}]]}],["$","div","Lee leaves the main front",{"className":"moment","children":[["$","$L25",null,{"seconds":403,"label":"6:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee leaves the main front"}],["$","p",null,{"children":"After deciding that the artillery effort was failing, Lee moved away without first canceling the earlier assault instructions."}]]}]]}],["$","div","Reports prompt another attack order",{"className":"moment","children":[["$","$L25",null,{"seconds":417,"label":"6:57"}],["$","div",null,{"children":["$L26","$L27"]}]]}],"$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44"]}]]}]
21:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States national and army command",{"className":"command-column #2f5f9f","children":[["$","h3",null,{"children":"United States national and army command"}],[["$","div","Commander in chief and head of the administration",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief and head of the administration"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Secretary of War Edwin M. Stanton; Secretary of State William H. Seward; Secretary of the Navy Gideon Welles"}]]}],["$","div","General-in-chief of the United States Army from July 11, 1862",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief of the United States Army from July 11, 1862"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Issued strategic instructions to McClellan and coordinated the intended concentration with Pope"}]]}],["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Maj. Gen. Fitz John Porter, V Corps; other corps commanders managing the Seven Days withdrawal"}]]}],["$","div","Army of Virginia in northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia in northern Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"The force Halleck intended McClellan’s transferred army to reinforce and join"}]]}]]]}],["$","section","Confederate national and army command at Malvern Hill",{"className":"command-column #a24a42","children":[["$","h3",null,{"children":"Confe