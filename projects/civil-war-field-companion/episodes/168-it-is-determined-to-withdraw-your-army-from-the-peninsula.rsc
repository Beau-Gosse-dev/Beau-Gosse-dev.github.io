24:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
26:["$","h3",null,{"children":"Reports prompt another attack order"}]
27:["$","p",null,{"children":"Messages from Whiting and Magruder indicating Federal withdrawal and Armistead’s advance led Lee to order Magruder forward without personally confirming conditions at the front."}]
28:["$","div","Lee continues the attacks",{"className":"moment","children":[["$","$L25",null,{"seconds":435,"label":"7:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee continues the attacks"}],["$","p",null,{"children":"The episode states that Lee sent Lafayette McLaws’s division forward and redirected Magruder rather than stopping the assault."}]]}]]}]
29:["$","div","Lee’s physical condition is discussed",{"className":"moment","children":[["$","$L25",null,{"seconds":471,"label":"7:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s physical condition is discussed"}],["$","p",null,{"children":"The hosts describe him as fatigued and ill and note that Longstreet accompanied him in case he needed help directing the battle."}]]}]]}]
2a:["$","div","Confederates expect a counterattack",{"className":"moment","children":[["$","$L25",null,{"seconds":549,"label":"9:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates expect a counterattack"}],["$","p",null,{"children":"After the costly repulse, some Confederate officers expected McClellan to use Malvern Hill as the base for an attack on July 2."}]]}]]}]
2b:["$","div","Porter urges offensive action",{"className":"moment","children":[["$","$L25",null,{"seconds":562,"label":"9:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Porter urges offensive action"}],["$","p",null,{"children":"Fitz John Porter and other Federal officers pressed McClellan to counterattack from the strong position."}]]}]]}]
2c:["$","div","McClellan orders the withdrawal to continue",{"className":"moment","children":[["$","$L25",null,{"seconds":575,"label":"9:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan orders the withdrawal to continue"}],["$","p",null,{"children":"The Army of the Potomac moved approximately eight miles down the James River to Harrison’s Landing."}]]}]]}]
2d:["$","div","McClellan estimates 180,000 Confederates",{"className":"moment","children":[["$","$L25",null,{"seconds":628,"label":"10:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan estimates 180,000 Confederates"}],["$","p",null,{"children":"The episode presents the estimate as a large exaggeration that helped convince him continued retreat was necessary."}]]}]]}]
2e:["$","div","McClellan’s absence from battle is criticized",{"className":"moment","children":[["$","$L25",null,{"seconds":683,"label":"11:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan’s absence from battle is criticized"}],["$","p",null,{"children":"The narrative turns from the retreat decision to his repeated physical distance from the principal fighting during the Seven Days."}]]}]]}]
2f:["$","div","Corps commanders manage the retreat",{"className":"moment","children":[["$","$L25",null,{"seconds":746,"label":"12:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Corps commanders manage the retreat"}],["$","p",null,{"children":"The episode argues that McClellan left major battlefield decisions and the protection of the withdrawal to subordinate commanders."}]]}]]}]
30:["$","div","Kearny condemns McClellan",{"className":"moment","children":[["$","$L25",null,{"seconds":757,"label":"12:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kearny condemns McClellan"}],["$","p",null,{"children":"Philip Kearny’s reported anger after the withdrawal is used to show the depth of criticism among some senior Federal officers."}]]}]]}]
31:["$","div","The hosts offer a reputation-based explanation",{"className":"moment","children":[["$","$L25",null,{"seconds":784,"label":"13:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The hosts offer a reputation-based explanation"}],["$","p",null,{"children":"They reject cowardice and treason and argue that McClellan distanced himself to protect his self-image and public reputation. This is their interpretation."}]]}]]}]
32:["$","div","Army loyalty survives the retreat",{"className":"moment","children":[["$","$L25",null,{"seconds":866,"label":"14:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Army loyalty survives the retreat"}],["$","p",null,{"children":"The episode distinguishes dissatisfied officers from many soldiers who retained confidence in McClellan and blamed Washington for inadequate support."}]]}]]}]
33:["$","div","Lincoln travels to Harrison’s Landing",{"className":"moment","children":[["$","$L25",null,{"seconds":978,"label":"16:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln travels to Harrison’s Landing"}],["$","p",null,{"children":"On July 7, the president left Washington to inspect the Army of the Potomac and meet its commander."}]]}]]}]
34:["$","div","McClellan gives Lincoln a policy letter",{"className":"moment","children":[["$","$L25",null,{"seconds":987,"label":"16:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan gives Lincoln a policy letter"}],["$","p",null,{"children":"The Harrison’s Landing letter addressed national war policy as well as military operations."}]]}]]}]
35:["$","div","McClellan advocates a limited war",{"className":"moment","children":[["$","$L25",null,{"seconds":1024,"label":"17:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan advocates a limited war"}],["$","p",null,{"children":"He argued for conciliation and against confiscation and forcible abolition as instruments of the war."}]]}]]}]
36:["$","div","Lincoln reads the letter without comment",{"className":"moment","children":[["$","$L25",null,{"seconds":1041,"label":"17:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln reads the letter without comment"}],["$","p",null,{"children":"The episode describes the president reading it in McClellan’s presence and pocketing it without giving the favorable response McClellan wanted."}]]}]]}]
37:["$","div","Federal policy is moving beyond conciliation",{"className":"moment","children":[["$","$L25",null,{"seconds":1087,"label":"18:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal policy is moving beyond conciliation"}],["$","p",null,{"children":"Congress was completing the Second Confiscation Act while Lincoln considered emancipation as a military measure."}]]}]]}]
38:["$","div","Lincoln consults Seward and Welles",{"className":"moment","children":[["$","$L25",null,{"seconds":1102,"label":"18:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln consults Seward and Welles"}],["$","p",null,{"children":"The episode refers to Lincoln’s mid-July discussion with the secretaries of state and the navy about emancipation as a military necessity."}]]}]]}]
39:["$","div","The cabinet hears the emancipation draft",{"className":"moment","children":[["$","$L25",null,{"seconds":1125,"label":"18:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cabinet hears the emancipation draft"}],["$","p",null,{"children":"Lincoln presented his preliminary draft on July 22 and stated that the basic decision was his, while inviting cabinet advice on implementation and timing."}]]}]]}]
3a:["$","div","Halleck becomes general-in-chief",{"className":"moment","children":[["$","$L25",null,{"seconds":1156,"label":"19:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck becomes general-in-chief"}],["$","p",null,{"children":"Lincoln called Halleck from the Western Theater on July 11 to fill the post removed from McClellan in March."}]]}]]}]
3b:["$","div","McClellan resents Halleck’s appointment",{"className":"moment","children":[["$","$L25",null,{"seconds":1180,"label":"19:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan resents Halleck’s appointment"}],["$","p",null,{"children":"The episode quotes McClellan’s private description of the promotion as a personal rebuke and shows his contempt for civilian and military superiors."}]]}]]}]
3c:["$","div","Halleck goes to Harrison’s Landing",{"className":"moment","children":[["$","$L25",null,{"seconds":1230,"label":"20:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck goes to Harrison’s Landing"}],["$","p",null,{"children":"He inspected the army and asked whether a practical renewed offensive against Richmond could begin from the James River base."}]]}]]}]
3d:["$","div","McClellan asks for 50,000 reinforcements",{"className":"moment","children":[["$","$L25",null,{"seconds":1289,"label":"21:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan asks for 50,000 reinforcements"}],["$","p",null,{"children":"Halleck’s official report and the episode agree that this was McClellan’s initial minimum for renewed operations."}]]}]]}]
3e:["$","div","A movement against Petersburg is proposed",{"className":"moment","children":[["$","$L25",null,{"seconds":1304,"label":"21:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"A movement against Petersburg is proposed"}],["$","p",null,{"children":"McClellan first suggested crossing the James and operating against Petersburg, south of Richmond."}]]}]]}]
3f:["$","div","The proposal shifts back toward Richmond",{"className":"moment","children":[["$","$L25",null,{"seconds":1322,"label":"22:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The proposal shifts back toward Richmond"}],["$","p",null,{"children":"McClellan then discussed advancing on the north bank of the James and stated that he needed 30,000 reinforcements."}]]}]]}]
40:["$","div","Halleck limits the offer to 20,000",{"className":"moment","children":[["$","$L25",null,{"seconds":1338,"label":"22:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck limits the offer to 20,000"}],["$","p",null,{"children":"Halleck said that Washington could not provide 50,000 and that he was authorized to offer no more than 20,000."}]]}]]}]
41:["$","div","McClellan accepts the smaller reinforcement",{"className":"moment","children":[["$","$L25",null,{"seconds":1367,"label":"22:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan accepts the smaller reinforcement"}],["$","p",null,{"children":"After considering the choice overnight, he told Halleck that he would attempt an advance with 20,000 additional soldiers."}]]}]]}]
42:["$","div","The stated requirement rises to 35,000",{"className":"moment","children":[["$","$L25",null,{"seconds":1377,"label":"22:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The stated requirement rises to 35,000"}],["$","p",null,{"children":"After Halleck returned to Washington, McClellan telegraphed that 35,000 reinforcements would be necessary."}]]}]]}]
43:["$","div","Halleck orders the army off the Peninsula",{"className":"moment","children":[["$","$L25",null,{"seconds":1391,"label":"23:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck orders the army off the Peninsula"}],["$","p",null,{"children":"The August 3 telegram directed McClellan to begin the transfer to Aquia Creek immediately and cover the movement."}]]}]]}]
44:["$","div","The episode recommends James M. McPherson",{"className":"moment","children":[["$","$L25",null,{"seconds":1410,"label":"23:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode recommends James M. McPherson"}],["$","p",null,{"children":"The selection is “Abraham Lincoln and the Second American Revolution,” a collection of essays on Lincoln and the transformation produced by the war."}]]}]]}]
45:["$","article","Abraham Lincoln",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Abraham Lincoln"}],["$","p",null,{"children":"President and commander in chief who inspected the army, received McClellan’s policy letter, and selected Halleck as general-in-chief"}]]}]]}]
