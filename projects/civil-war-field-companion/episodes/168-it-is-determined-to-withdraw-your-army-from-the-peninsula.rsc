1f:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","From Malvern Hill to Harrison’s Landing",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep168-malvern-to-harrisons.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From Malvern Hill to Harrison’s Landing at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep168-malvern-to-harrisons.svg","alt":"Generalized schematic map showing the Army of the Potomac withdrawing from Malvern Hill to Harrison’s Landing on July 2, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From Malvern Hill to Harrison’s Landing"}],["$","span",null,{"children":"After the July 1 defensive victory, the Army of the Potomac moved roughly eight miles down the James River and established an entrenched camp at Harrison’s Landing under naval protection. Shoreline, road, route, position, and distance are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep168-malvern-to-harrisons.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Library of Congress maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Strategic choices after the Seven Days",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep168-strategic-options.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Strategic choices after the Seven Days at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep168-strategic-options.svg","alt":"Generalized schematic map of Washington, Aquia Creek, Pope’s position, Richmond, Petersburg, Fort Monroe, and McClellan at Harrison’s Landing.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Strategic choices after the Seven Days"}],["$","span",null,{"children":"McClellan proposed renewed operations against Richmond, including a possible movement toward Petersburg, but required reinforcements. Halleck instead ordered the army to move through Fort Monroe toward Aquia Creek so it could join Pope’s Army of Virginia and help cover Washington. Locations, waterways, routes, positions, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep168-strategic-options.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Halleck’s official report, U.S. Army campaign histories, Library of Congress maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1f:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
20:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States national and army command",{"className":"command-column #2f5f9f","children":[["$","h3",null,{"children":"United States national and army command"}],[["$","div","Commander in chief and head of the administration-President Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief and head of the administration"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Secretary of War Edwin M. Stanton; Secretary of State William H. Seward; Secretary of the Navy Gideon Welles"}]]}],["$","div","General-in-chief of the United States Army from July 11, 1862-Maj. Gen. Henry W. Halleck",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief of the United States Army from July 11, 1862"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Issued strategic instructions to McClellan and coordinated the intended concentration with Pope"}]]}],["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Maj. Gen. Fitz John Porter, V Corps; other corps commanders managing the Seven Days withdrawal"}]]}],["$","div","Army of Virginia in northern Virginia-Maj. Gen. John Pope",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia in northern Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"The force Halleck intended McClellan’s transferred army to reinforce and join"}]]}]]]}],["$","section","Confederate national and army command at Malvern Hill",{"className":"command-column #a24a42","children":[["$","h3",null,{"children":"Confederate national and army command at Malvern Hill"}],[["$","div","Confederate commander in chief-President Jefferson Davis",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate commander in chief"}],["$","span",null,{"children":"President Jefferson Davis"}],["$","small",null,{"children":"Observed part of the July 1 operations and remained at the top of the Confederate political command"}]]}],["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Chief of staff Col. Robert H. Chilton; Capt. A. G. Dickinson carried a direct order to Magruder"}]]}],["$","div","Senior division commander and adviser near Lee-Maj. Gen. James Longstreet",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior division commander and adviser near Lee"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Accompanied Lee during the battle and helped develop the artillery concept discussed in the episode"}]]}],"$L24"]]}]]}],"$L25"]]]}]
21:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep168-waud-harrisons-line.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep168-waud-harrisons-line.jpg","alt":"Alfred Waud drawing of the fortified Federal line at Harrison’s Landing with soldiers, artillery, earthworks, and tents.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alfred R. Waud drew the Harrison’s Landing line in July or August 1862. The long, narrow field sketch records the defensive camp occupied after the Seven Days."}]]}],["$","figure","/images/ep168-harrisons-landing-headquarters.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep168-harrisons-landing-headquarters.jpg","alt":"Nine United States soldiers and an African American cook posed in front of the Fifth Corps headquarters tent at Harrison’s Landing.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The Fifth Corps headquarters at Harrison’s Landing, photographed in August 1862. Fitz John Porter is among the identified officers; the Library of Congress catalog also identifies the Black man at the left as the headquarters cook."}]]}],["$","figure","/images/ep168-george-mcclellan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep168-george-mcclellan.jpg","alt":"Wartime glass-plate portrait of Major General George B. McClellan in United States Army uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"George B. McClellan commanded the Army of the Potomac throughout the Peninsula Campaign and remained personally popular with many of its soldiers despite criticism of his battlefield conduct and strategic decisions."}]]}],["$","figure","/images/ep168-henry-halleck.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep168-henry-halleck.jpg","alt":"Wartime glass-plate portrait of Major General Henry W. Halleck in United States Army uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Henry W. Halleck became general-in-chief in July 1862. His Harrison’s Landing consultation and August 3 telegram ended the administration’s attempt to continue the Peninsula approach."}]]}]]}]]}]
