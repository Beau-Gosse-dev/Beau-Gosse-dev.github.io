1d:["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Department of Northern Virginia-Gen. Joseph E. Johnston",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Northern Virginia"}],["$","span",null,{"children":"Gen. Joseph E. Johnston"}],["$","small",null,{"children":"Strategic superior who had directed Jackson to prevent United States troops from leaving the Valley"}]]}],["$","div","Valley District-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Directed the infantry brigades, Ashby’s cavalry, and artillery; remained near the artillery during the main wall fight and ordered late reserves forward"}]]}],["$","div","Stonewall Brigade-Brig. Gen. Richard B. Garnett",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Brig. Gen. Richard B. Garnett"}],["$","small",null,{"children":"2nd, 4th, 5th, 27th, and 33rd Virginia Infantry; managed the main line at the wall and ordered the withdrawal when ammunition and cohesion failed"}]]}],["$","div","Second Brigade-Col. Jesse S. Burks",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Brigade"}],["$","span",null,{"children":"Col. Jesse S. Burks"}],["$","small",null,{"children":"21st, 42nd, and 48th Virginia Infantry and 1st Virginia (Irish) Battalion; Jackson directly ordered some of these units during the fight"}]]}],["$","div","Third Brigade-Col. Samuel V. Fulkerson",{"className":"command-entry","children":[["$","strong",null,{"children":"Third Brigade"}],["$","span",null,{"children":"Col. Samuel V. Fulkerson"}],["$","small",null,{"children":"23rd and 37th Virginia Infantry; filled the western section of the wall and was partly cut off when the withdrawal order failed to reach the entire line"}]]}],["$","div","7th Virginia Cavalry and attached forces-Col. Turner Ashby",{"className":"command-entry","children":[["$","strong",null,{"children":"7th Virginia Cavalry and attached forces"}],["$","span",null,{"children":"Col. Turner Ashby"}],["$","small",null,{"children":"Operated east of the Valley Turnpike during the battle and covered the retreat toward Middletown on March 24"}]]}],["$","div","Rockbridge Artillery-Capt. William N. Pendleton / Lt. William T. Poague",{"className":"command-entry","children":[["$","strong",null,{"children":"Rockbridge Artillery"}],["$","span",null,{"children":"Capt. William N. Pendleton / Lt. William T. Poague"}],["$","small",null,{"children":"Part of Jackson’s artillery position on Sandy Ridge; Poague’s forward two-gun section lost one piece during the retreat"}]]}]]]}]
1e:["$","section",null,{"className":"other-people","aria-label":"Other people","children":[["$","h3",null,{"className":"subsection-title","children":"Other people"}],"$undefined",["$","ul",null,{"className":"other-people-list","children":[["$","li","Thomas J. “Stonewall” Jackson",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","href":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep143-stonewall-jackson.jpg","alt":"Portrait of Thomas J. “Stonewall” Jackson","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h4",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Confederate commander whose late reserve movement could not prevent the collapse of the stone-wall line; his attack caused major United States strategic redeployments"}],"$undefined"]}]]}]}],["$","li","Nathan Kimball",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","href":"$undefined","children":[["$","div",null,{"className":"portrait-placeholder","aria-label":"No portrait available for Nathan Kimball","children":["$","span",null,{"children":"NK"}]}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h4",null,{"children":"Nathan Kimball"}],["$","p",null,{"children":"United States field commander who sent Tyler to Sandy Ridge, reinforced the stalled attack, held the battlefield, and resumed pursuit on March 24"}],"$undefined"]}]]}]}],["$","li","Erastus B. Tyler",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","href":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep143-erastus-tyler.jpg","alt":"Portrait of Erastus