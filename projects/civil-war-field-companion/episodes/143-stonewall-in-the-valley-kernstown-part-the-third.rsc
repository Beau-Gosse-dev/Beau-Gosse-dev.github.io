d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",143," · ","March 23–24, 1862"," · ","Sandy Ridge, Pritchard’s Hill, the Glass farm, and the Valley Turnpike south of Winchester, Virginia"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: KERNSTOWN (Part the Third)"}],["$","span",null,{"className":"result-label","children":"United States tactical victory. Nathan Kimball committed Erastus Tyler’s brigade and successive reinforcements against the Confederate line behind the stone wall on Sandy Ridge. Tyler’s compact assault column was stopped with heavy loss, but the United States troops recovered, extended the fight, and exhausted the defenders’ ammunition. Richard Garnett ordered a withdrawal shortly before dark without receiving an order from Jackson. United States troops took the wall and Jackson’s army escaped south. The attack nevertheless prompted the Lincoln administration to retain or redirect major forces toward the Shenandoah Valley and Washington instead of reinforcing McClellan on the Peninsula"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"March 23–24, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Sandy Ridge, Pritchard’s Hill, the Glass farm, and the Valley Turnpike south of Winchester, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"United States tactical victory. Nathan Kimball committed Erastus Tyler’s brigade and successive reinforcements against the Confederate line behind the stone wall on Sandy Ridge. Tyler’s compact assault column was stopped with heavy loss, but the United States troops recovered, extended the fight, and exhausted the defenders’ ammunition. Richard Garnett ordered a withdrawal shortly before dark without receiving an order from Jackson. United States troops took the wall and Jackson’s army escaped south. The attack nevertheless prompted the Lincoln administration to retain or redirect major forces toward the Shenandoah Valley and Washington instead of reinforcing McClellan on the Peninsula"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],"$Lf","$L10","$L11"]}],"$undefined"]}],"$L12","$L13",false,false,"$L14","$L15","$L16","$L17","$L18","$L19"]}]]}]
