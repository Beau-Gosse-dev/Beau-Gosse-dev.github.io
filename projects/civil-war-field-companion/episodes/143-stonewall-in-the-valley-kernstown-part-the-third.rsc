2a:["$","div","Valley District-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Directed the infantry brigades, Ashby’s cavalry, and artillery; remained near the artillery during the main wall fight and ordered late reserves forward"}]]}]
2b:["$","div","Stonewall Brigade-Brig. Gen. Richard B. Garnett",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Brig. Gen. Richard B. Garnett"}],["$","small",null,{"children":"2nd, 4th, 5th, 27th, and 33rd Virginia Infantry; managed the main line at the wall and ordered the withdrawal when ammunition and cohesion failed"}]]}]
2c:["$","div","Second Brigade-Col. Jesse S. Burks",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Brigade"}],["$","span",null,{"children":"Col. Jesse S. Burks"}],["$","small",null,{"children":"21st, 42nd, and 48th Virginia Infantry and 1st Virginia (Irish) Battalion; Jackson directly ordered some of these units during the fight"}]]}]
2d:["$","div","Third Brigade-Col. Samuel V. Fulkerson",{"className":"command-entry","children":[["$","strong",null,{"children":"Third Brigade"}],["$","span",null,{"children":"Col. Samuel V. Fulkerson"}],["$","small",null,{"children":"23rd and 37th Virginia Infantry; filled the western section of the wall and was partly cut off when the withdrawal order failed to reach the entire line"}]]}]
