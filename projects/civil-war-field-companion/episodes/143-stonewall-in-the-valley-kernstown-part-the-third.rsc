-copy","children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h4",null,{"children":"John Echols"}],["$","p",null,{"children":"Colonel of the 27th Virginia who placed skirmishers north of the wall and then opened the main infantry fight at close range"}]]}]]}]}],["$","li","John M. Patton Jr.",{"children":"$L36"}],"$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43"]}]]}]
