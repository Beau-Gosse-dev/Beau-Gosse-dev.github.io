1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",143," · ","March 23–24, 1862"," · ","Sandy Ridge, Pritchard’s Hill, the Glass farm, and the Valley Turnpike south of Winchester, Virginia"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: KERNSTOWN (Part the Third)"}],["$","span",null,{"className":"result-label","children":"United States tactical victory. Nathan Kimball committed Erastus Tyler’s brigade and successive reinforcements against the Confederate line behind the stone wall on Sandy Ridge. Tyler’s compact assault column was stopped with heavy loss, but the United States troops recovered, extended the fight, and exhausted the defenders’ ammunition. Richard Garnett ordered a withdrawal shortly before dark without receiving an order from Jackson. United States troops took the wall and Jackson’s army escaped south. The attack nevertheless prompted the Lincoln administration to retain or redirect major forces toward the Shenandoah Valley and Washington instead of reinforcing McClellan on the Peninsula"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6453002162.mp3?updated=1695307430","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The decisive Sandy Ridge fighting, Confederate retreat, immediate pursuit, casualty accounting, and strategic consequences of First Kernstown"}],["$","small",null,{"children":"The episode resumes at roughly 3:45 p.m. on March 23 and follows events through the federal pursuit on March 24 and Washington’s reaction."}]]}],["$","div","Battle result",{"children":[["$","span",null,{"children":"Battle result"}],["$","strong",null,{"children":"United States victory"}],["$","small",null,{"children":"The United States held the battlefield and Jackson withdrew south. NPS classifies Kernstown as a Union victory while also emphasizing the important Confederate strategic benefit."}]]}],["$","div","Strategic effect",{"children":[["$","span",null,{"children":"Strategic effect"}],["$","strong",null,{"children":"Federal troops were kept away from McClellan’s Peninsula operation"}],["$","small",null,{"children":"Washington overestimated Jackson’s strength and treated the Valley as an active threat. Banks remained in the Valley, Alpheus Williams was recalled, Louis Blenker’s division was directed toward Frémont, and Irvin McDowell’s corps remained to cover Washington."}]]}],["$","div","Forces engaged",{"children":[["$","span",null,{"children":"Forces engaged"}],["$","strong",null,{"children":"About 7,200 United States troops and 3,700 Confederates"}],["$","small",null,{"children":"NPS uses these engaged-strength figures in its battle narrative. Its order of battle gives larger approximate totals of 8,500 United States and 3,500 Confederate personnel. Jackson’s official report counted 2,742 infantry actually engaged, plus 18 guns and cavalry."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}],"$L21","$undefined","$L22",false,"$L23","$L24","$L25","$L26","$L27"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Casualties",{"children":[["$","span",null,{"children":"Casualties"}],["$","strong",null,{"children":"590 United States; about 718–737 Confederate"}],["$","small",null,{"children":"The episode totals the reports as 118 killed, 450 wounded, and 22 missing or captured for the United States; 139 killed, 312 wounded, 253 captured, and 33 missing for the Confederates, or 737. NPS sources give Confederate totals of about 718 or nearly 740. Categories and later consolidation of missing and captured men account for the variation."}]]}]
f:["$","div","Confederate position",{"children":[["$","span",null,{"children":"Confederate position"}],["$","strong",null,{"children":"A roughly 500-yard stone wall across a spur of Sandy Ridge"}],["$","small",null,{"children":"The 27th Virginia first occupied the sector. Reinforcements extended the defense, using the wall and the rising ground behind it as cover. Map positions and frontages remain approximate."}]]}]
10:["$","div","Tyler’s formation",{"children":[["$","span",null,{"children":"Tyler’s formation"}],["$","strong",null,{"children":"Close column of divisions, about 75 yards wide and roughly 400 yards deep"}],["$","small",null,{"children":"The five-regiment brigade advanced with only two companies in front and the remaining companies stacked behind. Woods and combat prevented an orderly deployment before Confederate fire struck the head of the column."}]]}]
11:["$","div","Tyler’s brigade",{"children":[["$","span",null,{"children":"Tyler’s brigade"}],["$","strong",null,{"children":"7th Ohio, 7th Indiana, 1st Virginia (later West Virginia), 110th Pennsylvania, and 29th Ohio"}],["$","small",null,{"children":"Eight companies of United States cavalry under Lt. Col. Joseph T. Copeland followed the infantry."}]]}]
12:["$","div","Fight opens on Sandy Ridge",{"children":[["$","span",null,{"children":"Fight opens on Sandy Ridge"}],["$","strong",null,{"children":"About 4 p.m."}],["$","small",null,{"children":"The 27th Virginia skirmishers withdrew behind the stone wall and fired into the head of Tyler’s column at less than 100 yards."}]]}]
13:["$","div","Initial United States setback",{"children":[["$","span",null,{"children":"Initial United States setback"}],["$","strong",null,{"children":"Tyler’s leading regiments lost cohesion within minutes"}],["$","small",null,{"children":"The 7th Ohio and 7th Indiana took cover; the 110th Pennsylvania broke to the rear; and its flight divided the 29th Ohio. The 1st Virginia maintained better order but its flank attack was repulsed."}]]}]
14:["$","div","Thoburn wounded",{"children":[["$","span",null,{"children":"Thoburn wounded"}],["$","strong",null,{"children":"Col. Joseph Thoburn suffered a shattered upper arm"}],["$","small",null,{"children":"Fulkerson’s 23rd and 37th Virginia reached the previously open western section of wall just before Thoburn’s 1st Virginia. Their close-range volley stopped the attack. Thoburn survived."}]]}]
15:["$","div","Confederate line at 4:30 p.m.",{"children":[["$","span",null,{"children":"Confederate line at 4:30 p.m."}],["$","strong",null,{"children":"About 1,200 men behind the wall"}],["$","small",null,{"children":"The episode, following Gary Ecelbarger, describes the 27th, 21st, 33rd, 4th, and parts of other commands forming a defensive line while Tyler’s mixed units fought from woods, a ravine, and open ground to the north."}]]}]
16:["$","div","Kimball reinforces",{"children":[["$","span",null,{"children":"Kimball reinforces"}],["$","strong",null,{"children":"Elements of five more regiments entered the Sandy Ridge fight"}],["$","small",null,{"children":"Four companies of the 8th Ohio were followed by the 67th Ohio, 84th Pennsylvania, part of the 5th Ohio, and finally the 14th Indiana. The attacks were piecemeal, but they added pressure the smaller Confederate force could not sustain indefinitely."}]]}]
17:["$","div","Colonel Murray killed",{"children":[["$","span",null,{"children":"Colonel Murray killed"}],["$","strong",null,{"children":"Col. William G. Murray of the 84th Pennsylvania was killed"}],["$","small",null,{"children":"Murray was shot in the head during his regiment’s third advance toward the wall. His death helped break the regiment’s attack."}]]}]
18:["$","div","14th Indiana charge",{"children":[["$","span",null,{"children":"14th Indiana charge"}],["$","strong",null,{"children":"The regiment crossed the open ground and reached the wall about 6 p.m."}],["$","small",null,{"children":"The episode credits Pvt. Paul Truckey of Company G with starting the forward rush. The automated transcript renders his surname phonetically as “Truckee.”"}]]}]
19:["$","div","Confederate ammunition crisis",{"children":[["$","span",null,{"children":"Confederate ammunition crisis"}],["$","strong",null,{"children":"Several regiments had exhausted or nearly exhausted their cartridges"}],["$","small",null,{"children":"The 21st Virginia had only scavenged rounds left and the 27th Virginia had none when the withdrawal order arrived. Casualties, exhaustion, straggling, and concern about cavalry beyond the left compounded the problem."}]]}]
1a:["$","div","Garnett’s decision",{"children":[["$","span",null,{"children":"Garnett’s decision"}],["$","strong",null,{"children":"Ordered withdrawal from the stone wall without an order from Jackson"}],["$","small",null,{"children":"Garnett had no current information about Jackson’s plan or the reserves approaching from the rear. Given the ammunition shortage, thinning line, and threat to the left, the retreat preserved much of the command. Jackson later treated the decision as disobedience and ordered Garnett’s arrest."}]]}]
1b:["$","div","Command breakdown",{"children":[["$","span",null,{"children":"Command breakdown"}],["$","strong",null,{"children":"Jackson and Garnett did not meet during the main two-hour fight"}],["$","small",null,{"children":"The episode places Jackson near the Rockbridge Artillery, roughly a quarter mile from the wall. Garnett was not told Jackson’s location, reserve movements, or full intent. Jackson reached Garnett only after the retreat was underway."}]]}]
1c:["$","div","Captured gun",{"children":[["$","span",null,{"children":"Captured gun"}],["$","strong",null,{"children":"One Rockbridge Artillery piece was left behind"}],["$","small",null,{"children":"Lt. William T. Poague brought two guns forward during the retreat. United States pressure forced his section back so quickly that one piece could not be removed."}]]}]
1d:["$","div","Rear guard",{"children":[["$","span",null,{"children":"Rear guard"}],["$","strong",null,{"children":"The 5th and 42nd Virginia covered the escape"}],["$","small",null,{"children":"They briefly stabilized the position after sunset. The 13th Indiana and other United States units continued the advance, but darkness and exhaustion limited pursuit."}]]}]
1e:["$","div","Aide captured",{"children":[["$","span",null,{"children":"Aide captured"}],["$","strong",null,{"children":"Lt. George Junkin was captured during the retreat"}],["$","small",null,{"children":"The episode credits Privates Lee Frazier and Bob Owens of the 14th Indiana. Junkin was a member of Jackson’s staff, not a battlefield commander."}]]}]
1f:["$","div","Night pursuit",{"children":[["$","span",null,{"children":"Night pursuit"}],["$","strong",null,{"children":"Kimball halted until morning"}],["$","small",null,{"children":"He cited exhaustion and lack of food and water. The pursuit resumed at first light on March 24 and encountered Ashby’s rear guard near Middletown that afternoon."}]]}]
20:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“Decoying the Yanks: Jackson’s Valley Campaign” by Champ Clark and the Editors of Time-Life Books"}],"$undefined"]}]
21:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
22:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","About 4 p.m.: Tyler’s column strikes the stone wall",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep143-sandy-ridge-assault.svg","target":"_blank","rel":"noreferrer","aria-label":"Open About 4 p.m.: Tyler’s column strikes the stone wall at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep143-sandy-ridge-assault.svg","alt":"Schematic map of Tyler’s close column advancing south on Sandy Ridge toward the Confederate stone-wall position about 4 p.m.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"About 4 p.m.: Tyler’s column strikes the stone wall"}],["$","span",null,{"children":"Tyler advanced south through the woods in a close column only about two companies wide. Confederate skirmishers fell back to the east–west stone wall. The 27th Virginia stopped the head of the column while the 21st Virginia, Fulkerson’s brigade, and additional Stonewall Brigade regiments filled the line. The diagram is schematic: routes, distances, vegetation, and unit frontages are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep143-sandy-ridge-assault.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/articles/000/first-battle-of-kernstown.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$22:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","About 6 p.m.: the wall breaks and Jackson retreats",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep143-sandy-ridge-retreat.svg","target":"_blank","rel":"noreferrer","aria-label":"Open About 6 p.m.: the wall breaks and Jackson retreats at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep143-sandy-ridge-retreat.svg","alt":"Schematic map of the Confederate withdrawal from Sandy Ridge after the United States advance reached the stone wall near 6 p.m.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"About 6 p.m.: the wall breaks and Jackson retreats"}],["$","span",null,{"children":"The 14th Indiana reached the eastern end of the line as Confederate ammunition ran out. Garnett ordered the withdrawal; some units did not receive the order and were exposed to enfilading fire and cavalry near the Glass farm. Jackson’s late-arriving 5th and 42nd Virginia covered the escape toward the Valley Turnpike. This phase map is schematic and does not show exact paths, timing, or capture locations."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep143-sandy-ridge-retreat.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$22:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/articles/000/first-battle-of-kernstown.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$22:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
23:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","V Corps, Army of the Potomac-Maj. Gen. Nathaniel P. Banks",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps, Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Absent from the field during the battle; returned to Winchester on March 24 and joined the pursuit"}]]}],["$","div","Second Division, V Corps-Brig. Gen. James Shields",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Division, V Corps"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"Recovering from his March 22 wound in Winchester; received reports but did not exercise direct battlefield control"}]]}],["$","div","First Brigade and acting field commander-Col. Nathan Kimball",{"className":"command-entry","children":[["$","strong",null,{"children":"First Brigade and acting field commander"}],["$","span",null,{"children":"Col. Nathan Kimball"}],["$","small",null,{"children":"14th Indiana, 8th Ohio, 67th Ohio, and 84th Pennsylvania; directed the division in the field and sent successive reinforcements to Sandy Ridge"}]]}],["$","div","Second Brigade-Col. Jeremiah C. Sullivan",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Brigade"}],["$","span",null,{"children":"Col. Jeremiah C. Sullivan"}],["$","small",null,{"children":"5th Ohio, 13th Indiana, 62nd Ohio, and unengaged 39th Illinois; the 5th Ohio and 13th Indiana entered the Sandy Ridge action"}]]}],["$","div","Third Brigade-Col. Erastus B. Tyler",{"className":"command-entry","children":[["$","strong",null,{"children":"Third Brigade"}],["$","span",null,{"children":"Col. Erastus B. Tyler"}],["$","small",null,{"children":"7th Ohio, 7th Indiana, 1st Virginia (later West Virginia), 29th Ohio, and 110th Pennsylvania; attacked Sandy Ridge in close column"}]]}],["$","div","Cavalry detachment with Tyler-Lt. Col. Joseph T. Copeland",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry detachment with Tyler"}],["$","span",null,{"children":"Lt. Col. Joseph T. Copeland"}],["$","small",null,{"children":"Eight companies followed Tyler’s infantry; other United States cavalry operated near the Glass farm and took prisoners during the Confederate retreat"}]]}],["$","div","Division artillery-Lt. Col. Philip Daum",{"className":"command-entry","children":[["$","strong",null,{"children":"Division artillery"}],["$","span",null,{"children":"Lt. Col. Philip Daum"}],["$","small",null,{"children":"United States and Ohio batteries on Pritchard’s Hill continued supporting the Sandy Ridge attacks"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Department of Northern Virginia-Gen. Joseph E. Johnston",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Northern Virginia"}],"$L28","$L29"]}],"$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]]}]]}],"$L30"]]]}]
24:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. William G. Murray",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. William G. Murray"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 84th Pennsylvania Infantry","."]}]," ","Killed instantly by a shot to the head while leading the regiment’s third advance to within about 40 yards of the stone wall"]}]]}]]}]]}]
25:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep143-erastus-tyler.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep143-erastus-tyler.jpg","alt":"Wartime carte-de-visite portrait of United States officer Erastus B. Tyler in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Erastus B. Tyler led the five-regiment brigade sent to clear Sandy Ridge. His choice of a deep column delayed deployment and exposed the leading regiments to concentrated fire from the stone wall."}]]}],["$","figure","/images/ep143-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep143-stonewall-jackson.jpg","alt":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson remained near the Sandy Ridge artillery during the main infantry fight. He did not learn that Garnett’s ammunition-starved line was withdrawing until after 6 p.m."}]]}],["$","figure","/images/ep143-kernstown-sneden.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep143-kernstown-sneden.jpg","alt":"Robert Knox Sneden’s color plan of the Battle of Kernstown showing roads, terrain, and troop positions","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Robert Knox Sneden’s wartime-era plan helps locate Sandy Ridge relative to Pritchard’s Hill and the Valley Turnpike. It is a historical interpretation rather than a surveyed map, and its troop-strength annotation is much higher than official reports and modern estimates."}]]}],["$","figure","/images/ep143-sandy-ridge-assault.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep143-sandy-ridge-assault.svg","alt":"Schematic map of the close-column United States assault against the Confederate stone-wall line on Sandy Ridge","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Tyler’s narrow column entered wooded ground and met the 27th Virginia at the wall before it could form an effective line. Confederate reinforcements arrived quickly enough to stop the first flank attempt."}]]}],["$","figure","/images/ep143-sandy-ridge-retreat.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep143-sandy-ridge-retreat.svg","alt":"Schematic map of Garnett’s withdrawal and the Confederate rear guard on Sandy Ridge","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"After about two hours of close fighting, empty cartridge boxes and pressure on both ends of the line forced Garnett to withdraw. Late reserves covered a disordered escape after sunset."}]]}]]}]]}]
