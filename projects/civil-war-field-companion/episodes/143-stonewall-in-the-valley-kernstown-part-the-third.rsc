10:["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Forces engaged",{"children":[["$","th",null,{"scope":"row","children":"Forces engaged"}],["$","td",null,{"children":["About 7,200 United States troops and 3,700 Confederates",["$","small",null,{"style":{"display":"block"},"children":"NPS uses these engaged-strength figures in its battle narrative. Its order of battle gives larger approximate totals of 8,500 United States and 3,500 Confederate personnel. Jackson’s official report counted 2,742 infantry actually engaged, plus 18 guns and cavalry."}]]}]]}],["$","tr","Casualties",{"children":[["$","th",null,{"scope":"row","children":"Casualties"}],["$","td",null,{"children":["590 United States; about 718–737 Confederate",["$","small",null,{"style":{"display":"block"},"children":"The episode totals the reports as 118 killed, 450 wounded, and 22 missing or captured for the United States; 139 killed, 312 wounded, 253 captured, and 33 missing for the Confederates, or 737. NPS sources give Confederate totals of about 718 or nearly 740. Categories and later consolidation of missing and captured men account for the variation."}]]}]]}],["$","tr","Confederate line at 4:30 p.m.",{"children":[["$","th",null,{"scope":"row","children":"Confederate line at 4:30 p.m."}],["$","td",null,{"children":["About 1,200 men behind the wall",["$","small",null,{"style":{"display":"block"},"children":"The episode, following Gary Ecelbarger, describes the 27th, 21st, 33rd, 4th, and parts of other commands forming a defensive line while Tyler’s mixed units fought from woods, a ravine, and open ground to the north."}]]}]]}],["$","tr","Colonel Murray killed",{"children":[["$","th",null,{"scope":"row","children":"Colonel Murray killed"}],["$","td",null,{"children":["Col. William G. Murray of the 84th Pennsylvania was killed",["$","small",null,{"style":{"display":"block"},"children":"Murray was shot in the head during his regiment’s third advance toward the wall. His death helped break the regiment’s attack."}]]}]]}]]}]]}]
11:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/02/21/civil-war-podcast-episode-143/",{"href":"https://civilwarpodcast.org/2016/02/21/civil-war-podcast-episode-143/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 143 page"]}],["$","a","https://www.nps.gov/articles/000/first-battle-of-kernstown.htm",{"href":"https://www.nps.gov/articles/000/first-battle-of-kernstown.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: First Battle of Kernstown"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va101",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va101","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Kernstown I battle detail"]}],["$","a","https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm",{"href":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Jackson’s 1862 Shenandoah Valley Campaign"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://ehistory.osu.edu/books/official-records/015",{"href":"https://ehistory.osu.edu/books/official-records/015","target":"_blank","rel":"noreferrer","children":[" · ","Primary source collection: Official Records, Series I, Volume XII, Part I"]}],["$","a","https://ehistory.osu.edu/books/official-records/015/0342",{"href":"https://ehistory.osu.edu/books/official-records/015/0342","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Shields’s report and United States casualty return, Official Records page 342"]}],["$","a","https://ehistory.osu.edu/books/official-records/015/0383",{"href":"https://ehistory.osu.edu/books/official-records/015/0383","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Jackson’s report and Confederate strength, Official Records page 383"]}],["$","a","https://ehistory.osu.edu/books/battles/vol2/302",{"href":"https://ehistory.osu.edu/books/battles/vol2/302","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Nathan Kimball, “Fighting Jackson at Kernstown,” Battles and Leaders, volume II"]}],["$","a","https://www.shenandoahatwar.org/first-kernstown-article",{"href":"https://www.shenandoahatwar.org/first-kernstown-article","target":"_blank","rel":"noreferrer","children":[" · ","Shenandoah Valley Battlefields National Historic District: First Kernstown"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00077/",{"href":"https://www.loc.gov/item/gvhs01.vhs00077/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Robert Knox Sneden plan of the Battle of Kernstown"]}],["$","a","https://www.loc.gov/pictures/item/2022630733/",{"href":"https://www.loc.gov/pictures/item/2022630733/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Erastus B. Tyler portrait"]}],["$","a","https://www.loc.gov/item/2003674500/",{"href":"https://www.loc.gov/item/2003674500/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Thomas J. “Stonewall” Jackson portrait"]}],["$","a","https://www.loc.gov/collections/hotchkiss-maps/articles-and-essays/the-hotchkiss-collection-of-confederate-maps/",{"href":"https://www.loc.gov/collections/hotchkiss-maps/articles-and-essays/the-hotchkiss-collection-of-confederate-maps/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Hotchkiss map collection history"]}],"$L1a"]}]
