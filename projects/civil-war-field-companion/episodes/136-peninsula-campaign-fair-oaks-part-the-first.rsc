d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",136," · ","May 25–31, 1862 (episode coverage ends late on May 31)"," · ","The Chickahominy River approaches east of Richmond, including Fair Oaks Station, Seven Pines, the Williamsburg Road, Nine Mile Road, Charles City Road, and White Oak Swamp, Virginia"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN: Fair Oaks (Part the First)"}],["$","span",null,{"className":"result-label","children":"Joseph E. Johnston tried to attack the two United States corps south of the flooded Chickahominy before the three corps north of the river could reinforce them. Confused orders and James Longstreet’s movement onto the Williamsburg Road delayed the attack for about five hours and blocked Benjamin Huger. D. H. Hill nevertheless broke Silas Casey’s forward line, while Philip Kearny reinforced the defense and Micah Jenkins split part of the United States line. The episode stops as Johnston leads W. H. C. Whiting toward Fair Oaks; the first day and the battle remain unresolved at that point"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"May 25–31, 1862 (episode coverage ends late on May 31)"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"The Chickahominy River approaches east of Richmond, including Fair Oaks Station, Seven Pines, the Williamsburg Road, Nine Mile Road, Charles City Road, and White Oak Swamp, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Joseph E. Johnston tried to attack the two United States corps south of the flooded Chickahominy before the three corps north of the river could reinforce them. Confused orders and James Longstreet’s movement onto the Williamsburg Road delayed the attack for about five hours and blocked Benjamin Huger. D. H. Hill nevertheless broke Silas Casey’s forward line, while Philip Kearny reinforced the defense and Micah Jenkins split part of the United States line. The episode stops as Johnston leads W. H. C. Whiting toward Fair Oaks; the first day and the battle remain unresolved at that point"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$Lf",false,false,"$L10","$L11","$L12","$L13"]}],"$L14",false,false,"$L15","$L16","$L17","$L18","$L19","$L1a"]}]]}]
