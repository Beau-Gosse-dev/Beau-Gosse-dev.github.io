1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",136," · ","May 25–31, 1862 (episode coverage ends late on May 31)"," · ","The Chickahominy River approaches east of Richmond, including Fair Oaks Station, Seven Pines, the Williamsburg Road, Nine Mile Road, Charles City Road, and White Oak Swamp, Virginia"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN: Fair Oaks (Part the First)"}],["$","span",null,{"className":"result-label","children":"Joseph E. Johnston tried to attack the two United States corps south of the flooded Chickahominy before the three corps north of the river could reinforce them. Confused orders and James Longstreet’s movement onto the Williamsburg Road delayed the attack for about five hours and blocked Benjamin Huger. D. H. Hill nevertheless broke Silas Casey’s forward line, while Philip Kearny reinforced the defense and Micah Jenkins split part of the United States line. The episode stops as Johnston leads W. H. C. Whiting toward Fair Oaks; the first day and the battle remain unresolved at that point"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9353253284.mp3?updated=1695220100","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Two names",{"children":[["$","span",null,{"children":"Two names"}],["$","strong",null,{"children":"Fair Oaks (United States) / Seven Pines (Confederate)"}],["$","small",null,{"children":"Both names refer to the May 31–June 1 battle east of Richmond."}]]}],["$","div","United States deployment",{"children":[["$","span",null,{"children":"United States deployment"}],["$","strong",null,{"children":"Three corps north of the Chickahominy; two corps south"}],["$","small",null,{"children":"Porter’s V, Franklin’s VI, and Sumner’s II Corps were north of the river. Keyes’s IV and Heintzelman’s III Corps were south of it."}]]}],["$","div","Weather and terrain",{"children":[["$","span",null,{"children":"Weather and terrain"}],["$","strong",null,{"children":"Violent rain on May 30 flooded the Chickahominy bottomlands"}],["$","small",null,{"children":"The episode says the river rose three to four feet, damaged bridges, and made the low ground much harder to cross."}]]}],["$","div","Confederate concentration",{"children":[["$","span",null,{"children":"Confederate concentration"}],["$","strong",null,{"children":"About 74,000–75,000 near Richmond"}],["$","small",null,{"children":"This is the episode’s estimate. Strength calculations vary by source and by which troops are counted as available."}]]}],["$","div","Planned attacking force",{"children":[["$","span",null,{"children":"Planned attacking force"}],["$","strong",null,{"children":"Up to 51,600 against about 33,000 south of the river"}],["$","small",null,{"children":"These are the episode’s planning estimates, not counts of the troops that actually reached combat in this phase."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16"]}],"$L17","$undefined","$L18",false,"$L19","$L1a","$L1b","$L1c","$L1d"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Planned start",{"children":[["$","span",null,{"children":"Planned start"}],["$","strong",null,{"children":"8:00 a.m., May 31"}],"$undefined"]}]
f:["$","div","Actual opening attack",{"children":[["$","span",null,{"children":"Actual opening attack"}],["$","strong",null,{"children":"About 1:00 p.m."}],["$","small",null,{"children":"D. H. Hill advanced after learning that Huger’s lead brigade had reached its assigned area on Charles City Road."}]]}]
10:["$","div","Three intended approach roads",{"children":[["$","span",null,{"children":"Three intended approach roads"}],["$","strong",null,{"children":"Nine Mile, Williamsburg, and Charles City roads"}],["$","small",null,{"children":"Johnston intended simultaneous pressure on the front and flanks of the isolated United States wing."}]]}]
11:["$","div","Command failure",{"children":[["$","span",null,{"children":"Command failure"}],["$","strong",null,{"children":"Johnston gave Longstreet verbal instructions"}],["$","small",null,{"children":"No record of their May 30 conversation survives. Johnston and Longstreet later disputed responsibility for the route misunderstanding, and Johnston asked Gustavus W. Smith to omit related details from Smith’s report."}]]}]
12:["$","div","Hill’s attacking division",{"children":[["$","span",null,{"children":"Hill’s attacking division"}],["$","strong",null,{"children":"About 8,500 in four brigades"}],["$","small",null,{"children":"The episode’s estimate. Hill’s men wore white cloth on their headgear to reduce the risk of friendly fire in the woods."}]]}]
13:["$","div","Casey’s main position",{"children":[["$","span",null,{"children":"Casey’s main position"}],["$","strong",null,{"children":"Rifle pits, abatis, and an unfinished five-sided redoubt"}],["$","small",null,{"children":"The episode places six artillery pieces in Casey’s Redoubt."}]]}]
14:["$","div","6th Alabama losses",{"children":[["$","span",null,{"children":"6th Alabama losses"}],["$","strong",null,{"children":"About 59 percent of the regiment"}],["$","small",null,{"children":"The transcript gives 91 killed and says 59 percent of the unit was lost. Rodes’s official report lists 91 killed and 277 wounded; the NPS unit summary gives 59 percent of 632 engaged. Later compilations give slightly different totals."}]]}]
15:["$","div","Episode stopping point",{"children":[["$","span",null,{"children":"Episode stopping point"}],["$","strong",null,{"children":"Johnston advances with Whiting late on May 31"}],["$","small",null,{"children":"Johnston’s later wounding and Robert H. Hatton’s death occur after this episode’s stopping point and are not treated as events in this guide."}]]}]
16:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"Fair Oaks 1862: McClellan’s Peninsula Campaign by Angus Konstam"}],["$","small",null,{"children":"The automated transcript renders the author’s surname incorrectly."}]]}]
17:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
18:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The army divided by the Chickahominy",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep136-chickahominy-disposition.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The army divided by the Chickahominy at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep136-chickahominy-disposition.svg","alt":"Operational map of the five United States corps around the Chickahominy and Johnston’s revised attack toward Seven Pines","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The army divided by the Chickahominy"}],["$","span",null,{"children":"McClellan kept Porter, Franklin, and Sumner north of the river while Keyes and Heintzelman operated south of it. The May 30 flood damaged crossings and increased the isolation of the southern wing. Johnston shifted his main effort toward that exposed wing after learning that McDowell would not join McClellan. Corps positions and geography are schematic."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep136-chickahominy-disposition.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$18:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Johnston’s plan and the delayed May 31 attack",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep136-fair-oaks-may31-tactical.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Johnston’s plan and the delayed May 31 attack at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep136-fair-oaks-may31-tactical.svg","alt":"Tactical map comparing Johnston’s intended three-road attack with the actual movements through late afternoon on May 31","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Johnston’s plan and the delayed May 31 attack"}],["$","span",null,{"children":"Dashed arrows show the intended simultaneous movement on Nine Mile, Williamsburg, and Charles City roads. Solid arrows show the episode’s sequence: Longstreet moved onto the Williamsburg Road and delayed Huger; Hill attacked about 1 p.m.; Kearny counterattacked; Anderson and Jenkins drove between Fair Oaks and Seven Pines; and Johnston led Whiting down Nine Mile Road late in the afternoon. Routes and unit frontages are schematic."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep136-fair-oaks-may31-tactical.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$18:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/gvhs01.vhs00292/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$18:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
19:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Commander, Army of the Potomac-George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Army of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Directed five corps on both sides of the Chickahominy; the episode does not place him at the forward Seven Pines fighting"}]]}],["$","div","Commander, IV Corps; south of the Chickahominy-Erasmus D. Keyes",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, IV Corps; south of the Chickahominy"}],["$","span",null,{"children":"Erasmus D. Keyes"}],["$","small",null,{"children":"Silas Casey held the forward line and redoubt; Darius N. Couch formed behind Casey near Seven Pines and Fair Oaks"}]]}],["$","div","Commander, III Corps; south of the Chickahominy-Samuel P. Heintzelman",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, III Corps; south of the Chickahominy"}],["$","span",null,{"children":"Samuel P. Heintzelman"}],["$","small",null,{"children":"Philip Kearny reinforced Keyes with two brigades; Joseph Hooker’s division was also in III Corps"}]]}],["$","div","Commander, II Corps; north of the Chickahominy-Edwin V. Sumner",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, II Corps; north of the Chickahominy"}],["$","span",null,{"children":"Edwin V. Sumner"}],["$","small",null,{"children":"John Sedgwick and Israel B. Richardson; their later crossing falls outside this episode’s stopping point"}]]}],["$","div","Commanders, V and VI Corps; north of the Chickahominy-Fitz John Porter and William B. Franklin",{"className":"command-entry","children":[["$","strong",null,{"children":"Commanders, V and VI Corps; north of the Chickahominy"}],["$","span",null,{"children":"Fitz John Porter and William B. Franklin"}],["$","small",null,{"children":"Held the northern wing with Sumner while the opening attack struck south of the river"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Commander, Confederate field army defending Richmond-Joseph E. Johnston",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Confederate field army defending Richmond"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"Created a left wing under Gustavus W. Smith and a right wing under James Longstreet, then personally advanced with Whiting late in the episode"}]]}],["$","div","Left wing-Gustavus W. Smith",{"className":"command-entry","children":[["$","strong",null,{"children":"Left wing"}],["$","span",null,{"children":"Gustavus W. Smith"}],["$","small",null,{"children":"W. H. C. Whiting was designated to support Longstreet; John B. Magruder and A. P. Hill remained in reserve along the upper Chickahominy"}]]}],"$L1e","$L1f","$L20","$L21"]]}]]}],"$L22"]]]}]
1a:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Lt. Col. James J. Willingham",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Lt. Col. James J. Willingham"}],["$","p",null,{"children":[["$","strong",null,{"children":["Lieutenant colonel, 6th Alabama Infantry","."]}]," ","Killed during the regiment’s attack on May 31."]}]]}],["$","article","Maj. Samuel Perry Nesmith",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Maj. Samuel Perry Nesmith"}],["$","p",null,{"children":[["$","strong",null,{"children":["Major, 6th Alabama Infantry","."]}]," ","Killed during the regiment’s attack on May 31."]}]]}],["$","article","Brig. Gen. Robert E. Rodes",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Robert E. Rodes"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Rodes’s brigade, D. H. Hill’s division","."]}]," ","Wounded in the arm; remained in command for about two hours, then left the field. The wound was not mortal."]}]]}]]}]]}]
1b:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep136-fair-oaks-may31-tactical.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep136-fair-oaks-may31-tactical.svg","alt":"Schematic map of the planned and actual Confederate movements at Fair Oaks and Seven Pines","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Johnston intended a simultaneous three-road attack. Longstreet’s movement onto Williamsburg Road delayed Huger and reduced the opening action to Hill’s unsupported advance."}]]}],["$","figure","/images/ep136-joseph-e-johnston.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep136-joseph-e-johnston.jpg","alt":"Portrait of Confederate general Joseph E. Johnston in civilian dress","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Joseph E. Johnston recognized the opportunity created by the flooded Chickahominy but did not provide the detailed written orders needed to coordinate separate columns on three roads."}]]}],["$","figure","/images/ep136-james-longstreet.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep136-james-longstreet.jpg","alt":"Portrait of James Longstreet during the Civil War era","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"James Longstreet held tactical control of the main attack. His route misunderstanding placed his division on Williamsburg Road and blocked Huger’s assigned approach."}]]}],["$","figure","/images/ep136-silas-casey.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep136-silas-casey.jpg","alt":"Silas Casey seated in United States Army uniform during the Civil War","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Silas Casey’s understrength division occupied the forward IV Corps line. Its fieldworks resisted Hill for a time before the redoubt and camps were overrun."}]]}],["$","figure","/images/ep136-philip-kearny.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep136-philip-kearny.jpg","alt":"Contemporary engraving of Philip Kearny standing in United States Army uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Philip Kearny brought two III Corps brigades forward and counterattacked south of Williamsburg Road after Casey’s line collapsed."}]]}]]}]]}]
