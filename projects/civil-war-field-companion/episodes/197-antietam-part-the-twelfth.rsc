5f:["$","section","Confederacy",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Had shifted troops away from the right and committed Richard H. Anderson’s division, his last available battlefield reserve, to the center"}]]}],["$","div","Right Wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Oversaw both D. R. Jones on the southern flank and the reinforcements sent into the center; ordered Cook’s counterstroke"}]]}],["$","div","Jones’s division, Confederate right",{"className":"command-entry","children":[["$","strong",null,{"children":"Jones’s division, Confederate right"}],["$","span",null,{"children":"Brig. Gen. David R. Jones"}],["$","small",null,{"children":"Held the southern sector with a layered defense and assigned Toombs’s brigade to cover the bridge and creek crossings"}]]}],["$","div","Toombs’s brigade at the Lower Bridge",{"className":"command-entry","children":[["$","strong",null,{"children":"Toombs’s brigade at the Lower Bridge"}],["$","span",null,{"children":"Brig. Gen. Robert A. Toombs and Col. Henry L. Benning"}],["$","small",null,{"children":"Toombs commanded the brigade; Benning directed the 2nd and 20th Georgia in the immediate bridge defense"}]]}],["$","div","Hill’s division and the Sunken Road defense",{"className":"command-entry","children":[["$","strong",null,{"children":"Hill’s division and the Sunken Road defense"}],["$","span",null,{"children":"Maj. Gen. D. H. Hill"}],["$","small",null,{"children":"Held Lee’s center with Rodes and George B. Anderson while reinforcements entered the Piper farm sector"}]]}],["$","div","Anderson’s division, Longstreet’s wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Anderson’s division, Longstreet’s wing"}],["$","span",null,{"children":"Maj. Gen. Richard H. Anderson"}],["$","small",null,{"children":"Brought about 3,400 reinforcements toward the Sunken Road in the episode and was badly wounded on arrival"}]]}],["$","div","Anderson’s division after Anderson was wounded",{"className":"command-entry","children":[["$","strong",null,{"children":"Anderson’s division after Anderson was wounded"}],["$","span",null,{"children":"Brig. Gen. Roger A. Pryor"}],["$","small",null,{"children":"Succeeded without a clear understanding of Anderson’s orders, leaving the arriving brigades without effective coordination"}]]}],["$","div","Anderson’s North Carolina brigade, Hill’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Anderson’s North Carolina brigade, Hill’s division"}],["$","span",null,{"children":"Brig. Gen. George B. Anderson and Col. Charles C. Tew"}],["$","small",null,{"children":"Both were mortally wounded as the brigade held the eastern and deepest part of the Sunken Road"}]]}],["$","div","Rodes’s brigade, Hill’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Rodes’s brigade, Hill’s division"}],["$","span",null,{"children":"Brig. Gen. Robert E. Rodes"}],["$","small",null,{"children":"Held five Alabama regiments west of the bend until enfilading fire and a misunderstood order caused the brigade to retreat"}]]}],["$","div","6th Alabama, Rodes’s brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"6th Alabama, Rodes’s brigade"}],["$","span",null,{"children":"Col. John B. Gordon"}],["$","small",null,{"children":"Commanded the regiment at the exposed right of Rodes’s line until receiving his fifth wound of the day"}]]}],["$","div","Posey’s brigade, R. H. Anderson’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Posey’s brigade, R. H. Anderson’s division"}],"$L6b","$L6c"]}],"$L6d"]]}]
