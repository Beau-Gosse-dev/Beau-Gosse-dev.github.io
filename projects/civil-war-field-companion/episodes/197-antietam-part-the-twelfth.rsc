2c:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Released Richardson’s division and ordered the Ninth Corps to attack; remained at the Pry House during the actions covered"}]]}],["$","div","Right Wing headquarters and effective control of the Ninth Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing headquarters and effective control of the Ninth Corps"}],["$","span",null,{"children":"Maj. Gen. Ambrose E. Burnside"}],["$","small",null,{"children":"Received McClellan’s order and passed it to Cox while continuing to exercise authority over the corps"}]]}],["$","div","Ninth Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Ninth Corps"}],["$","span",null,{"children":"Brig. Gen. Jacob D. Cox"}],["$","small",null,{"children":"Directed the bridge operation under Burnside; the unusual command arrangement divided responsibility at corps headquarters"}]]}],["$","div","2nd Division, Ninth Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, Ninth Corps"}],["$","span",null,{"children":"Brig. Gen. Samuel D. Sturgis"}],["$","small",null,{"children":"Sent Nagle’s brigade into the second bridge attack and supervised the division’s artillery support"}]]}],["$","div","1st Brigade, Sturgis’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Sturgis’s division"}],["$","span",null,{"children":"Brig. Gen. James Nagle"}],["$","small",nul