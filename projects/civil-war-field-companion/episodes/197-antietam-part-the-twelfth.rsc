2d:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. Henry W. Kingsbury",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. Henry W. Kingsbury"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the 11th Connecticut","."]}]," ","Hit in the heel, leg, shoulder, and abdomen while leading the first attack near the Lower Bridge. He was carried to the Rohrbach farm and died on September 18, 1862."]}]]}],["$","article","Capt. John D. Griswold",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Capt. John D. Griswold"}],["$","p",null,{"children":[["$","strong",null,{"children":["Company D, 11th Connecticut","."]}]," ","Killed while attempting to lead his company across Antietam Creek during the first bridge attack."]}]]}],["$","article","Maj. Gen. Richard H. Anderson",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Maj. Gen. Richard H. Anderson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of Anderson’s division","."]}]," ","Badly wounded soon after reaching the Sunken Road sector. He survived, but his removal left Roger A. Pryor in command during the collapse."]}]]}],["$","article","Brig. Gen. George B. Anderson",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. George B. Anderson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of Anderson’s brigade, Hill’s division","."]}]," ","Mortally wounded in the ankle. Infection followed an amputation, and he died in Raleigh, North Carolina, on October 16, 1862."]}]]}],["$","article","Col. Charles C. Tew",{"children":[[