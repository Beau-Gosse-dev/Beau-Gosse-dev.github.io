1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",197," · ","September 17, 1862"," · ","Two sectors of the Antietam battlefield near Sharpsburg, Maryland: the Lower Bridge and Antietam Creek on the Federal left, and the Sunken Road from the Hagerstown Turnpike east toward the Roulette farm lane in the Confederate center"]}],["$","h1",null,{"children":"ANTIETAM (Part the Twelfth)"}],["$","span",null,{"className":"result-label","children":"Between about 10:00 and 11:00 a.m., the Ninth Corps made two uncoordinated attacks against the Lower Bridge. The 11th Connecticut was repulsed with roughly one-third of the regiment hit, Crook’s brigade stopped upstream, Rodman’s flanking column lost time searching for a usable ford, and the 2nd Maryland was repulsed in Nagle’s attack. Near the Sunken Road, Richardson’s division renewed the Federal offensive. Meagher’s Irish Brigade suffered severe losses, Caldwell extended the line, and Barlow’s enfilading fire helped make the Confederate position untenable. Posey’s failed counterattack, disrupted Confederate command, and a misunderstood order in Rodes’s brigade accelerated the collapse. Federal troops seized the road and entered the Piper cornfield, opening a temporary breach in Lee’s center"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6902148885.mp3?updated=1695499580","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"About 10:00 a.m. to the Federal advance beyond the Sunken Road"}],["$","small",null,{"children":"The episode alternates between the first two attacks on the Lower Bridge and Richardson’s attack on the Confederate center, ending before the later Federal withdrawal from the Piper farm sector."}]]}],["$","div","Two simultaneous fronts",{"children":[["$","span",null,{"children":"Two simultaneous fronts"}],["$","strong",null,{"children":"Lower Bridge and Sunken Road"}],["$","small",null,{"children":"The Ninth Corps acted on the southern end of the battlefield while the II Corps attacked Lee’s center roughly two miles to the north."}]]}],["$","div","Ninth Corps strength",{"children":[["$","span",null,{"children":"Ninth Corps strength"}],["$","strong",null,{"children":"About 12,500 in the episode; close to 12,000 in NPS interpretation"}],["$","small",null,{"children":"Terrain prevented more than a small part of the corps from approaching the narrow bridge at once."}]]}],["$","div","Lower Bridge dimensions",{"children":[["$","span",null,{"children":"Lower Bridge dimensions"}],["$","strong",null,{"children":"Three stone arches, about 125 feet long and 12 feet wide"}],["$","small",null,{"children":"The Rohrbach Bridge carried the road from Rohrersville toward Sharpsburg. It became known as Burnside Bridge after the battle."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}],"$L29","$undefined","$L2a",false,"$L2b","$L2c","$L2d","$L2e","$L2f"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Confederate terrain advantage",{"children":[["$","span",null,{"children":"Confederate terrain advantage"}],["$","strong",null,{"children":"Steep west bank, quarry cuts, woods, stone walls, and flanking fire"}],["$","small",null,{"children":"The east-bank approach ran nearly parallel to Confederate positions before turning onto the bridge, exposing Federal troops at short range."}]]}]
f:["$","div","Bridge defenders",{"children":[["$","span",null,{"children":"Bridge defenders"}],["$","strong",null,{"children":"About 400 in the episode; fewer than 500 in NPS interpretation"}],["$","small",null,{"children":"The 2nd and 20th Georgia of Robert Toombs’s brigade held the immediate crossing under Col. Henry L. Benning. The episode emphasizes Benning; the NPS identifies Toombs as the brigade commander."}]]}]
10:["$","div","Confederate support at the bridge",{"children":[["$","span",null,{"children":"Confederate support at the bridge"}],["$","strong",null,{"children":"Five batteries in the episode"}],["$","small",null,{"children":"Confederate guns occupied higher ground behind the infantry. NPS interpretation describes a layered defense with artillery and the rest of David R. Jones’s division farther west."}]]}]
11:["$","div","Federal bridge plan",{"children":[["$","span",null,{"children":"Federal bridge plan"}],["$","strong",null,{"children":"Frontal pressure plus a downstream flank crossing"}],["$","small",null,{"children":"The 11th Connecticut and Crook’s brigade were to press the bridge while Rodman’s division and Ewing’s brigade moved downstream. Two other divisions would exploit a successful crossing."}]]}]
12:["$","div","First bridge attack",{"children":[["$","span",null,{"children":"First bridge attack"}],["$","strong",null,{"children":"11th Connecticut and Crook’s brigade at about 10:00 a.m."}],["$","small",null,{"children":"The 11th Connecticut advanced along the creek. Crook misunderstood his role and reached a position roughly 300 to 350 yards upstream, where his brigade was pinned down."}]]}]
13:["$","div","11th Connecticut loss",{"children":[["$","span",null,{"children":"11th Connecticut loss"}],["$","strong",null,{"children":"About one-third of the regiment killed or wounded"}],["$","small",null,{"children":"Capt. John D. Griswold was killed while attempting to cross the creek, and Col. Henry W. Kingsbury was hit four times and mortally wounded."}]]}]
14:["$","div","Rodman’s assigned force",{"children":[["$","span",null,{"children":"Rodman’s assigned force"}],["$","strong",null,{"children":"About 3,200 men"}],["$","small",null,{"children":"Rodman’s division and Ewing’s brigade found the engineers’ proposed crossing impracticable, then had to march farther downstream after Snavely’s Ford was located."}]]}]
15:["$","div","Reconnaissance failure",{"children":[["$","span",null,{"children":"Reconnaissance failure"}],["$","strong",null,{"children":"The usable downstream ford was not located in advance"}],["$","small",null,{"children":"Local civilians had reported Snavely’s Ford, but the Ninth Corps did not establish its location before the attack. The resulting delay prevented the flanking column from supporting the first two bridge assaults."}]]}]
16:["$","div","Second bridge attack",{"children":[["$","span",null,{"children":"Second bridge attack"}],["$","strong",null,{"children":"Nagle’s brigade at about 11:00 a.m."}],["$","small",null,{"children":"Nagle sent the 2nd Maryland and 6th New Hampshire along the Rohrersville Road while the 48th Pennsylvania and 9th New Hampshire supplied covering fire from higher ground."}]]}]
17:["$","div","2nd Maryland repulse",{"children":[["$","span",null,{"children":"2nd Maryland repulse"}],["$","strong",null,{"children":"45 percent casualties in about ninety seconds in the episode"}],["$","small",null,{"children":"The regiment advanced roughly 250 yards along the exposed road under infantry and artillery fire, then broke off the charge before reaching the bridge."}]]}]
18:["$","div","Richardson’s division",{"children":[["$","span",null,{"children":"Richardson’s division"}],["$","strong",null,{"children":"About 4,000 II Corps veterans in the episode"}],["$","small",null,{"children":"Richardson arrived after French’s three brigades had been stopped and formed on French’s left rather than moving toward Greene’s earlier foothold near the Dunker Church."}]]}]
19:["$","div","Confederate reserve committed",{"children":[["$","span",null,{"children":"Confederate reserve committed"}],["$","strong",null,{"children":"About 3,400 men in Richard H. Anderson’s division in the episode"}],["$","small",null,{"children":"Anderson’s division was Lee’s last available battlefield reserve apart from A. P. Hill’s division, which was still marching from Harpers Ferry."}]]}]
1a:["$","div","Irish Brigade",{"children":[["$","span",null,{"children":"Irish Brigade"}],["$","strong",null,{"children":"63rd, 69th, and 88th New York; 29th Massachusetts"}],["$","small",null,{"children":"Brig. Gen. Thomas Francis Meagher led Richardson’s first attack. The automated transcript repeatedly renders his surname as “Marr.”"}]]}]
1b:["$","div","Irish Brigade losses",{"children":[["$","span",null,{"children":"Irish Brigade losses"}],["$","strong",null,{"children":"More than 500 of roughly 1,200 killed or wounded in NPS interpretation"}],["$","small",null,{"children":"The episode describes more than half the brigade falling in minutes. NPS figures give the 69th New York 196 killed or wounded out of 317 and the 63rd New York a 59 percent loss."}]]}]
1c:["$","div","Father William Corby",{"children":[["$","span",null,{"children":"Father William Corby"}],["$","strong",null,{"children":"Gave absolution as the Irish Brigade prepared to attack"}],["$","small",null,{"children":"Corby was chaplain of the 88th New York. The episode places him moving along the brigade front before Meagher ordered the advance."}]]}]
1d:["$","div","Caldwell’s brigade",{"children":[["$","span",null,{"children":"Caldwell’s brigade"}],["$","strong",null,{"children":"The fresh Federal line that replaced Meagher and extended east"}],["$","small",null,{"children":"Richardson followed the Irish Brigade with Col. John C. Caldwell’s brigade, increasing pressure on the eastern section of the Sunken Road."}]]}]
1e:["$","div","Barlow’s enfilade",{"children":[["$","span",null,{"children":"Barlow’s enfilade"}],["$","strong",null,{"children":"61st and 64th New York fired west along the road"}],["$","small",null,{"children":"Col. Francis C. Barlow moved his two understrength regiments to a knoll that exposed the shallow bend and the right of Rodes’s line to fire from the flank."}]]}]
1f:["$","div","Richard H. Anderson wounded",{"children":[["$","span",null,{"children":"Richard H. Anderson wounded"}],["$","strong",null,{"children":"Division command passed to Brig. Gen. Roger A. Pryor"}],["$","small",null,{"children":"Anderson was badly wounded soon after reaching the sector. Pryor did not know Anderson’s orders, and the arriving brigades lacked effective division-level direction."}]]}]
20:["$","div","George B. Anderson mortally wounded",{"children":[["$","span",null,{"children":"George B. Anderson mortally wounded"}],["$","strong",null,{"children":"An ankle wound led to his death on October 16, 1862"}],["$","small",null,{"children":"The North Carolina brigade commander was carried from the field, later underwent amputation, and died after infection developed."}]]}]
21:["$","div","Charles C. Tew",{"children":[["$","span",null,{"children":"Charles C. Tew"}],["$","strong",null,{"children":"2nd North Carolina colonel killed in the road"}],["$","small",null,{"children":"The automated transcript renders his surname as “II.” He succeeded George B. Anderson in brigade command and was killed during the collapse."}]]}]
22:["$","div","Posey’s counterattack",{"children":[["$","span",null,{"children":"Posey’s counterattack"}],["$","strong",null,{"children":"Repulsed north of the Sunken Road"}],["$","small",null,{"children":"Col. Carnot Posey advanced his arriving Mississippi brigade into the crowded sector. Its retreat spread confusion through the right side of the Confederate position."}]]}]
23:["$","div","Rodes’s mistaken order",{"children":[["$","span",null,{"children":"Rodes’s mistaken order"}],["$","strong",null,{"children":"A flank adjustment became a brigade retreat"}],["$","small",null,{"children":"Rodes ordered Lt. Col. James N. Lightfoot to refuse the 6th Alabama’s exposed right. Lightfoot instead ordered the regiment to about-face and march to the rear, and the movement spread to the rest of the brigade."}]]}]
24:["$","div","John B. Gordon",{"children":[["$","span",null,{"children":"John B. Gordon"}],["$","strong",null,{"children":"Wounded five times and survived"}],["$","small",null,{"children":"The 6th Alabama colonel fell before the order error. His wounds removed an experienced regimental commander at the point under Barlow’s enfilading fire."}]]}]
25:["$","div","Confederate center breached",{"children":[["$","span",null,{"children":"Confederate center breached"}],["$","strong",null,{"children":"Federal troops crossed the road into the Piper cornfield"}],["$","small",null,{"children":"The 2nd and 14th North Carolina made a final stand but were hit from two directions. The defenders withdrew toward the Piper farm, leaving the center temporarily open."}]]}]
26:["$","div","Cook’s counterstroke",{"children":[["$","span",null,{"children":"Cook’s counterstroke"}],["$","strong",null,{"children":"675 men in the episode; more than half lost"}],["$","small",null,{"children":"Col. John R. Cook brought the 27th North Carolina and 3rd Arkansas southeast from the West Woods area against the Federal right. Brooke shifted his brigade west and stopped the attack."}]]}]
27:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The Gleam of Bayonets” by James V. Murfin"}],["$","small",null,{"children":"The full subtitle is “The Battle of Antietam and Robert E. Lee’s Maryland Campaign, September 1862.” The author’s surname is spelled Murfin, not “Murphin.”"}]]}]
28:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Meagher, Rodes, Tew, Nagle, Griswold, Pry House, and enfilading fire"}],["$","small",null,{"children":"The automated transcript produces “Marr,” “Rhodes,” “Charles II,” “Nagel,” “Griswald,” “pry house,” and “inflating fire.” This guide uses the historical forms."}]]}]
29:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
2a:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The first two attacks at the Lower Bridge",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep197-lower-bridge-first-assaults.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The first two attacks at the Lower Bridge at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep197-lower-bridge-first-assaults.svg","alt":"Schematic map of the 11th Connecticut, Crook, Nagle, and Rodman operating against the Confederate defense of the Lower Bridge.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The first two attacks at the Lower Bridge"}],["$","span",null,{"children":"The 11th Connecticut moved along the creek while Crook’s brigade stopped upstream. Rodman and Ewing searched downstream for a usable crossing. At about 11:00 a.m., Nagle’s brigade used the exposed Rohrersville Road for the second attack. Benning directed the 2nd and 20th Georgia at the bridge within Toombs’s broader command. Positions and routes are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep197-lower-bridge-first-assaults.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield Union Advance Trail, Official Reports, Antietam Battlefield Board atlas, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Richardson breaks the Sunken Road line",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep197-sunken-road-breakthrough.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Richardson breaks the Sunken Road line at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep197-sunken-road-breakthrough.svg","alt":"Schematic map showing Meagher and Caldwell attacking the Sunken Road, Barlow firing along it, the Confederate retreat, and Brooke repulsing Cook.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Richardson breaks the Sunken Road line"}],["$","span",null,{"children":"Meagher attacked first, Caldwell extended the Federal line east, and Barlow reached a knoll that allowed his men to fire west along the road. Posey’s repulse disrupted the Confederate right, while the misunderstood order in Rodes’s brigade accelerated the collapse on the left. Brooke turned west to stop Cook’s separate attack. Sequential actions are combined, and positions are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep197-sunken-road-breakthrough.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield Bloody Lane Trail, Official Reports, Antietam Battlefield Board atlas, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L30"]}]]}],"$undefined"]}]]}],"$L31"]}]]}]
2b:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Released Richardson’s division and ordered the Ninth Corps to attack; remained at the Pry House during the actions covered"}]]}],["$","div","Right Wing headquarters and effective control of the Ninth Corps-Maj. Gen. Ambrose E. Burnside",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing headquarters and effective control of the Ninth Corps"}],["$","span",null,{"children":"Maj. Gen. Ambrose E. Burnside"}],["$","small",null,{"children":"Received McClellan’s order and passed it to Cox while continuing to exercise authority over the corps"}]]}],["$","div","Ninth Corps-Brig. Gen. Jacob D. Cox",{"className":"command-entry","children":[["$","strong",null,{"children":"Ninth Corps"}],["$","span",null,{"children":"Brig. Gen. Jacob D. Cox"}],["$","small",null,{"children":"Directed the bridge operation under Burnside; the unusual command arrangement divided responsibility at corps headquarters"}]]}],["$","div","2nd Division, Ninth Corps-Brig. Gen. Samuel D. Sturgis",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, Ninth Corps"}],["$","span",null,{"children":"Brig. Gen. Samuel D. Sturgis"}],["$","small",null,{"children":"Sent Nagle’s brigade into the second bridge attack and supervised the division’s artillery support"}]]}],["$","div","1st Brigade, Sturgis’s division-Brig. Gen. James Nagle",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Sturgis’s division"}],["$","span",null,{"children":"Brig. Gen. James Nagle"}],["$","small",null,{"children":"Used the 2nd Maryland and 6th New Hampshire for the road assault while two other regiments supplied covering fire"}]]}],["$","div","1st Brigade, Kanawha Division-Col. George Crook",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Kanawha Division"}],["$","span",null,{"children":"Col. George Crook"}],["$","small",null,{"children":"Was intended to support the first bridge attack but reached a position roughly 300 to 350 yards upstream"}]]}],["$","div","3rd Division, Ninth Corps, reinforced by Ewing’s brigade-Brig. Gen. Isaac P. Rodman",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division, Ninth Corps, reinforced by Ewing’s brigade"}],["$","span",null,{"children":"Brig. Gen. Isaac P. Rodman"}],["$","small",null,{"children":"Led about 3,200 men downstream after the assigned crossing failed, delaying the planned flank attack"}]]}],["$","div","1st Division, II Corps-Maj. Gen. Israel B. Richardson",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, II Corps"}],["$","span",null,{"children":"Maj. Gen. Israel B. Richardson"}],"$L32"]}],"$L33","$L34","$L35","$L36"]]}],"$L37"]}],"$L38"]]]}]
2c:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. Henry W. Kingsbury",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. Henry W. Kingsbury"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the 11th Connecticut","."]}]," ","Hit in the heel, leg, shoulder, and abdomen while leading the first attack near the Lower Bridge. He was carried to the Rohrbach farm and died on September 18, 1862."]}]]}],["$","article","Capt. John D. Griswold",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Capt. John D. Griswold"}],["$","p",null,{"children":[["$","strong",null,{"children":["Company D, 11th Connecticut","."]}]," ","Killed while attempting to lead his company across Antietam Creek during the first bridge attack."]}]]}],["$","article","Maj. Gen. Richard H. Anderson",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Maj. Gen. Richard H. Anderson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of Anderson’s division","."]}]," ","Badly wounded soon after reaching the Sunken Road sector. He survived, but his removal left Roger A. Pryor in command during the collapse."]}]]}],["$","article","Brig. Gen. George B. Anderson",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. George B. Anderson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of Anderson’s brigade, Hill’s division","."]}]," ","Mortally wounded in the ankle. Infection followed an amputation, and he died in Raleigh, North Carolina, on October 16, 1862."]}]]}],["$","article","Col. Charles C. Tew",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Charles C. Tew"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the 2nd North Carolina and successor to George B. Anderson","."]}]," ","Killed in the Sunken Road during the final collapse. The automated transcript renders his name as “Charles II.”"]}]]}],["$","article","Col. John B. Gordon",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. John B. Gordon"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the 6th Alabama","."]}]," ","Received his fifth wound of the day at the Sunken Road. He survived and returned to military service in 1863."]}]]}]]}]]}]
2d:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep197-lower-bridge-first-assaults.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep197-lower-bridge-first-assaults.svg","alt":"Schematic map of the first two Federal attacks on the Lower Bridge and the delayed downstream flanking movement.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The bridge approach exposed small Federal assault columns to short-range fire while Crook stopped upstream and Rodman searched downstream for a crossing."}]]}],["$","figure","/images/ep197-sunken-road-breakthrough.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep197-sunken-road-breakthrough.svg","alt":"Schematic tactical map of Richardson’s attack and the collapse of the Confederate Sunken Road position.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Caldwell’s extension and Barlow’s enfilading fire coincided with command losses, Posey’s failed counterattack, and the mistaken withdrawal of Rodes’s brigade."}]]}],["$","figure","/images/ep197-burnside-bridge.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep197-burnside-bridge.jpg","alt":"Alexander Gardner photograph of the Lower Bridge over Antietam Creek shortly after the battle.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Gardner’s September 1862 view records the narrow stone span and steep creek banks that shaped the Ninth Corps attacks."}]]}],["$","figure","/images/ep197-israel-richardson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep197-israel-richardson.jpg","alt":"Portrait of United States major general Israel Bush Richardson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Israel B. Richardson personally directed his division at the front and pressed the breakthrough beyond the Sunken Road."}]]}]]}]]}]
