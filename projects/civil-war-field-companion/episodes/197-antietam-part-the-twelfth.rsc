31:["$","figure","The Lower Bridge after the battle",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep197-burnside-bridge.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The Lower Bridge after the battle at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep197-burnside-bridge.jpg","alt":"Alexander Gardner photograph of the Lower Bridge over Antietam Creek in September 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Lower Bridge after the battle"}],["$","span",null,{"children":"Alexander Gardner photographed the three-arch stone bridge from the southeast in September 1862. The bridge carried the narrow road that constrained the Federal assaults described in the episode."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep197-burnside-bridge.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Prints and Photographs Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
32:["$","small",null,{"children":"Renewed the attack on the Sunken Road with the brigades of Meagher, Caldwell, and Brooke and led the advance into the Piper cornfield"}]
33:["$","div","2nd Brigade, Richardson’s division-Brig. Gen. Thomas Francis Meagher",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Brigade, Richardson’s division"}],["$","span",null,{"children":"Brig. Gen. Thomas Francis Meagher"}],["$","small",null,{"children":"Led the Irish Brigade in the first attack by Richardson’s division and suffered severe losses"}]]}]
34:["$","div","1st Brigade, Richardson’s division-Col. John C. Caldwell",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Richardson’s division"}],["$","span",null,{"children":"Col. John C. Caldwell"}],["$","small",null,{"children":"Replaced Meagher in the front line and extended the attack east along the Sunken Road"}]]}]
35:["$","div","61st and 64th New York, Caldwell’s brigade-Col. Francis C. Barlow",{"className":"command-entry","children":[["$","strong",null,{"children":"61st and 64th New York, Caldwell’s brigade"}],["$","span",null,{"children":"Col. Francis C. Barlow"}],["$","small",null,{"children":"Moved his two regiments to a knoll where they could fire along the Confederate line from the flank"}]]}]
36:["$","div","3rd Brigade, Richardson’s division-Col. John R. Brooke",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Brigade, Richardson’s division"}],["$","span",null,{"children":"Col. John R. Brooke"}],["$","small",null,{"children":"Shifted west to stop Cook’s counterattack against the Federal right after the road had fallen"}]]}]
37:["$","section","Confederacy",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Had shifted troops away from the right and committed Richard H. Anderson’s division, his last available battlefield reserve, to the center"}]]}],["$","div","Right Wing-Maj. Gen. James Longstreet",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Oversaw both D. R. Jones on the southern flank and the reinforcements sent into the center; ordered Cook’s counterstroke"}]]}],["$","div","Jones’s division, Confederate right-Brig. Gen. David R. Jones",{"className":"command-entry","children":[["$","strong",null,{"children":"Jones’s division, Confederate right"}],["$","span",null,{"children":"Brig. Gen. David R. Jones"}],["$","small",null,{"children":"Held the southern sector with a layered defense and assigned Toombs’s brigade to cover the bridge and creek crossings"}]]}],["$","div","Toombs’s brigade at the Lower Bridge-Brig. Gen. Robert A. Toombs and Col. Henry L. Benning",{"className":"command-entry","children":[["$","strong",null,{"children":"Toombs’s brigade at the Lower Bridge"}],["$","span",null,{"children":"Brig. Gen. Robert A. Toombs and Col. Henry L. Benning"}],["$","small",null,{"children":"Toombs commanded the brigade; Benning directed the 2nd and 20th Georgia in the immediate bridge defense"}]]}],["$","div","Hill’s division and the Sunken Road defense-Maj. Gen. D. H. Hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Hill’s division and the Sunken Road defense"}],["$","span",null,{"children":"Maj. Gen. D. H. Hill"}],["$","small",null,{"children":"Held Lee’s center with Rodes and George B. Anderson while reinforcements entered the Piper farm sector"}]]}],["$","div","Anderson’s division, Longstreet’s wing-Maj. Gen. Richard H. Anderson",{"className":"command-entry","children":[["$","strong",null,{"children":"Anderson’s division, Longstreet’s wing"}],["$","span",null,{"children":"Maj. Gen. Richard H. Anderson"}],["$","small",null,{"children":"Brought about 3,400 reinforcements toward the Sunken Road in the episode and was badly wounded on arrival"}]]}],["$","div","Anderson’s division after Anderson was wounded-Brig. Gen. Roger A. Pryor",{"className":"command-entry","children":[["$","strong",null,{"children":"Anderson’s division after Anderson was wounded"}],["$","span",null,{"children":"Brig. Gen. Roger A. Pryor"}],["$","small",null,{"children":"Succeeded without a clear understanding of Anderson’s orders, leaving the arriving brigades without effective coordination"}]]}],["$","div","Anderson’s North Carolina brigade, Hill’s division-Brig. Gen. George B. Anderson and Col. Charles C. Tew",{"className":"command-entry","children":[["$","strong",null,{"children":"Anderson’s North Carolina brigade, Hill’s division"}],["$","span",null,{"children":"Brig. Gen. George B. Anderson and Col. Charles C. Tew"}],["$","small",null,{"children":"Both were mortally wounded as the brigade held the eastern and deepest part of the Sunken Road"}]]}],["$","div","Rodes’s brigade, Hill’s division-Brig. Gen. Robert E. Rodes",{"className":"command-entry","children":[["$","strong",null,{"children":"Rodes’s brigade, Hill’s division"}],["$","span",null,{"children":"Brig. Gen. Robert E. Rodes"}],["$","small",null,{"children":"Held five Alabama regiments west of the bend until enfilading fire and a misunderstood order caused the brigade to retreat"}]]}],["$","div","6th Alabama, Rodes’s brigade-Col. John B. Gordon",{"className":"command-entry","children":["$L44","$L45","$L46"]}],"$L47","$L48"]]}]
