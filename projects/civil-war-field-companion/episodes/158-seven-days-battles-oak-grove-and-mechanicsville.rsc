15:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/07/17/civil-war-podcast-episode-158/",{"href":"https://civilwarpodcast.org/2016/07/17/civil-war-podcast-episode-158/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 158 page"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va015",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va015","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service battle summary: Oak Grove"]}],["$","a","https://www.nps.gov/rich/learn/historyculture/bdcbulletin.htm",{"href":"https://www.nps.gov/rich/learn/historyculture/bdcbulletin.htm","target":"_blank","rel":"noreferrer","children":[" · ","Richmond National Battlefield Park: Battle of Beaver Dam Creek"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://www.loc.gov/pictures/item/va2109/",{"href":"https://www.loc.gov/pictures/item/va2109/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress Historic American Landscapes Survey: Battle of Beaver Dam Creek"]}],["$","a","https://www.loc.gov/item/2004660959/",{"href":"https://www.loc.gov/item/2004660959/","target":"_blank","rel":"noreferrer","children":[" · ","Primary visual source: Alfred R. Waud’s Ellerson’s Mill drawing, June 26, 1862"]}],["$","a","https://www.loc.gov/item/2007685830/",{"href":"https://www.loc.gov/item/2007685830/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Mechanicsville photograph by John Reekie, April 1865"]}],["$","a","https://www.loc.gov/item/2022630549/",{"href":"https://www.loc.gov/item/2022630549/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: A. P. Hill portrait"]}],["$","a","https://www.loc.gov/item/2018667594/",{"href":"https://www.loc.gov/item/2018667594/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Fitz John Porter portrait"]}],["$","a","https://civilwarpodcast.org/book-recommendations/",{"href":"https://civilwarpodcast.org/book-recommendations/","target":"_blank","rel":"noreferrer","children":[" · ","Official podcast book-recommendations list"]}]]}]
