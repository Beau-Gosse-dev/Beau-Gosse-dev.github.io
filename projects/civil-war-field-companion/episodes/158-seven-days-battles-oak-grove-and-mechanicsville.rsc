1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",158," · ","June 25–26, 1862"," · ","Oak Grove along the Williamsburg Road south of the Chickahominy River, followed by Mechanicsville and Beaver Dam Creek north of the river, near Richmond, Virginia"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: OAK GROVE AND MECHANICSVILLE"}],["$","span",null,{"className":"result-label","children":"Oak Grove ended inconclusively after George B. McClellan gained about 600 yards without disrupting Robert E. Lee’s planned offensive. At Beaver Dam Creek the next day, Fitz John Porter and George A. McCall repulsed direct Confederate attacks from a prepared position. Lee’s army suffered substantially heavier losses, but McClellan ordered Porter to withdraw during the night, surrendered the battlefield, and yielded the operational initiative to Lee"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5490275286.mp3?updated=1695325981","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The first two engagements of the Seven Days Battles"}],["$","small",null,{"children":"The episode covers Oak Grove on June 25 and Beaver Dam Creek, also called Mechanicsville or Ellerson’s Mill, on June 26."}]]}],["$","div","Oak Grove objective",{"children":[["$","span",null,{"children":"Oak Grove objective"}],["$","strong",null,{"children":"Advance the United States line toward high ground near Old Tavern"}],["$","small",null,{"children":"McClellan wanted ground suitable for siege guns that could threaten Richmond. The episode places the intended advance at about one and one-half miles."}]]}],["$","div","Oak Grove opening",{"children":[["$","span",null,{"children":"Oak Grove opening"}],["$","strong",null,{"children":"About 8:30 a.m. on June 25"}],["$","small",null,{"children":"Joseph Hooker sent Daniel Sickles’s brigade on the right and Cuvier Grover’s brigade in the center; Philip Kearny sent John C. Robinson’s brigade on the left."}]]}],["$","div","Terrain at Oak Grove",{"children":[["$","span",null,{"children":"Terrain at Oak Grove"}],["$","strong",null,{"children":"Wooded and swampy ground disrupted the advancing line"}],["$","small",null,{"children":"Sickles’s brigade fell behind in the difficult terrain, leaving Grover unsupported on his right when Grover met Ambrose R. Wright’s Confederates."}]]}],["$","div","Remote direction",{"children":[["$","span",null,{"children":"Remote direction"}],["$","strong",null,{"children":"McClellan first directed the action by telegraph from about three miles away"}],["$","small",null,{"children":"He ordered a withdrawal after receiving reports of heavy fighting, reached the front at about 1 p.m., assessed the field, and ordered the lost ground retaken."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}],"$L25","$undefined","$L26",false,"$L27","$L28","$L29","$L2a","$L2b"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Oak Grove result",{"children":[["$","span",null,{"children":"Oak Grove result"}],["$","strong",null,{"children":"Indecisive; the United States line advanced about 600 yards"}],["$","small",null,{"children":"The limited gain did not interrupt the Confederate offensive scheduled for June 26."}]]}]
f:["$","div","Oak Grove casualties",{"children":[["$","span",null,{"children":"Oak Grove casualties"}],["$","strong",null,{"children":"United States 626; Confederacy 441"}],["$","small",null,{"children":"The National Park Service gives 1,067 total casualties. The standard breakdown is United States: 68 killed, 503 wounded, 55 missing; Confederacy: 66 killed, 362 wounded, 13 missing. The automated transcript drops a digit and renders the Confederate wounded as “36.”"}]]}]
10:["$","div","Lee’s risk",{"children":[["$","span",null,{"children":"Lee’s risk"}],["$","strong",null,{"children":"Most Confederate striking power shifted north of the Chickahominy"}],["$","small",null,{"children":"The episode states that about 25,000 Confederates remained south of the river to defend Richmond. Strength figures vary by source and method of counting."}]]}]
11:["$","div","McClellan’s intelligence",{"children":[["$","span",null,{"children":"McClellan’s intelligence"}],["$","strong",null,{"children":"Reports indicated that Jackson was moving toward the exposed Federal right"}],["$","small",null,{"children":"McClellan correctly suspected the direction of Lee’s intended blow but did not reinforce the right before Lee attacked."}]]}]
12:["$","div","Planned Confederate trigger",{"children":[["$","span",null,{"children":"Planned Confederate trigger"}],["$","strong",null,{"children":"Jackson turn the Federal right early on June 26"}],["$","small",null,{"children":"Lee expected Jackson’s movement to set Branch, A. P. Hill, Longstreet, and D. H. Hill in motion in sequence."}]]}]
13:["$","div","Jackson’s delayed march",{"children":[["$","span",null,{"children":"Jackson’s delayed march"}],["$","strong",null,{"children":"Slash Church at about 9 a.m., roughly six hours behind the planned schedule"}],["$","small",null,{"children":"The episode attributes delay to a late start, obstacles cut by United States cavalry, unfamiliar roads, and cautious movement. Exact expectations and responsibility are matters of historical interpretation."}]]}]
14:["$","div","A. P. Hill’s decision",{"children":[["$","span",null,{"children":"A. P. Hill’s decision"}],["$","strong",null,{"children":"Crossed Meadow Bridge at about 3 p.m. without confirmation from Jackson"}],["$","small",null,{"children":"Hill acted without first notifying Lee or obtaining new permission. The episode also notes evidence that Lee had independently concluded that a crossing should occur before dark."}]]}]
15:["$","div","Porter’s defensive choice",{"children":[["$","span",null,{"children":"Porter’s defensive choice"}],["$","strong",null,{"children":"Withdrew outposts through Mechanicsville to Beaver Dam Creek"}],["$","small",null,{"children":"Porter intended to fight from the prepared east-bank position rather than hold the village."}]]}]
16:["$","div","Beaver Dam Creek position",{"children":[["$","span",null,{"children":"Beaver Dam Creek position"}],["$","strong",null,{"children":"Steep, swampy approach, felled-tree obstacles, earthworks, and supporting artillery"}],["$","small",null,{"children":"The National Park Service describes a strong position with open fields of fire. Its vulnerable point was the northern flank that Jackson was supposed to turn."}]]}]
17:["$","div","Forces at Beaver Dam Creek",{"children":[["$","span",null,{"children":"Forces at Beaver Dam Creek"}],["$","strong",null,{"children":"About 14,000 United States troops and roughly 10,000–11,000 Confederates engaged"}],["$","small",null,{"children":"The episode uses 14,000 and 10,000. The National Park Service states that five A. P. Hill brigades, perhaps 11,000 men, pushed toward the creek. These are approximate battlefield strengths."}]]}]
18:["$","div","Jackson at Hundley’s Corner",{"children":[["$","span",null,{"children":"Jackson at Hundley’s Corner"}],["$","strong",null,{"children":"Reached the Federal flank area late and stopped for the night"}],["$","small",null,{"children":"The episode places his arrival at about 5 p.m. and his bivouac order at 6 p.m. The National Park Service describes arrival at the creek headwaters late on June 26. Precise timing differs among accounts."}]]}]
19:["$","div","Main Confederate engagement",{"children":[["$","span",null,{"children":"Main Confederate engagement"}],["$","strong",null,{"children":"A. P. Hill’s brigades fixed McCall’s division along the creek"}],["$","small",null,{"children":"Field and Archer engaged from the west bank. Anderson briefly crossed in the upper sector. Pender and later Ripley attacked near Ellerson’s Mill."}]]}]
1a:["$","div","Ellerson’s Mill attacks",{"children":[["$","span",null,{"children":"Ellerson’s Mill attacks"}],["$","strong",null,{"children":"Pender’s and Ripley’s attacks failed under concentrated infantry and artillery fire"}],["$","small",null,{"children":"The movement occurred over difficult, exposed ground against Truman Seymour’s brigade. The schematic map does not reconstruct exact regimental routes or formations."}]]}]
1b:["$","div","Ripley’s brigade losses",{"children":[["$","span",null,{"children":"Ripley’s brigade losses"}],["$","strong",null,{"children":"Nearly 600 killed and wounded"}],["$","small",null,{"children":"The National Park Service states that Ripley’s brigade incurred almost half of Lee’s losses in the battle."}]]}]
1c:["$","div","44th Georgia losses",{"children":[["$","span",null,{"children":"44th Georgia losses"}],["$","strong",null,{"children":"335 killed and wounded from 514 reported engaged"}],["$","small",null,{"children":"The episode gives these figures and identifies the regiment’s first battle as the attack at Ellerson’s Mill. Contemporary reporting varies in how detached men and later deaths were counted."}]]}]
1d:["$","div","1st North Carolina losses",{"children":[["$","span",null,{"children":"1st North Carolina losses"}],["$","strong",null,{"children":"About 142 casualties in the episode’s account"}],["$","small",null,{"children":"Published figures vary slightly by source and category. The regiment also lost much of its field and company leadership."}]]}]
1e:["$","div","Beaver Dam Creek casualties",{"children":[["$","span",null,{"children":"Beaver Dam Creek casualties"}],["$","strong",null,{"children":"Approximately 1,400 Confederates and 350 United States troops"}],["$","small",null,{"children":"The National Park Service uses these rounded totals. The episode gives about 1,500 Confederate casualties and 361 United States casualties; estimates vary by source and categorization."}]]}]
1f:["$","div","Tactical result",{"children":[["$","span",null,{"children":"Tactical result"}],["$","strong",null,{"children":"United States victory at Beaver Dam Creek"}],["$","small",null,{"children":"No Confederate force broke McCall’s east-bank line on June 26, and the direct attacks failed at heavy cost."}]]}]
20:["$","div","Night withdrawal",{"children":[["$","span",null,{"children":"Night withdrawal"}],["$","strong",null,{"children":"Porter moved east before dawn on June 27"}],["$","small",null,{"children":"Concern that Jackson could turn the northern flank led McClellan to order the position abandoned despite the tactical victory."}]]}]
21:["$","div","Operational consequence",{"children":[["$","span",null,{"children":"Operational consequence"}],["$","strong",null,{"children":"McClellan yielded the initiative after winning the June 26 battlefield fight"}],["$","small",null,{"children":"The withdrawal carried Porter toward the Gaines’s Mill position and began the Army of the Potomac’s movement away from the Richmond front."}]]}]
22:["$","div","Command failure",{"children":[["$","span",null,{"children":"Command failure"}],["$","strong",null,{"children":"The Confederate plan operated without timely coordination among separated columns"}],["$","small",null,{"children":"Jackson, Branch, A. P. Hill, and Lee lacked an effective flow of current information. The episode assigns ultimate responsibility for army-level staff coordination to Lee while distinguishing that judgment from the observed movements."}]]}]
23:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Davis and Lee at War” by Steven E. Woodworth"}],["$","small",null,{"children":"The podcast page and episode closing identify this title as the recommendation."}]]}]
24:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Heintzelman, Kearny, Huger, Beaver Dam Creek, Hundley’s Corner, abatis, and Ellerson’s Mill"}],["$","small",null,{"children":"The automated transcript produces forms including “Heinsleman,” “Carney,” “Nugez,” “UJ,” “Bosen’s Creek,” and “Ellersons.”"}]]}]
25:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
26:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The first two Seven Days battlefields",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep158-seven-days-overview.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The first two Seven Days battlefields at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep158-seven-days-overview.svg","alt":"Schematic overview of Richmond, the Chickahominy River, Oak Grove, Mechanicsville, Beaver Dam Creek, and the broad locations of the opposing forces.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The first two Seven Days battlefields"}],["$","span",null,{"children":"Oak Grove lay south of the Chickahominy on the Williamsburg Road, while Mechanicsville and Beaver Dam Creek lay north of the river. The diagram shows the broad operational relationship: McClellan’s June 25 advance, Lee’s concentration against Porter on June 26, and the smaller Confederate force holding the Richmond approaches. Locations, routes, force areas, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep158-seven-days-overview.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Historic American Landscapes Survey, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Movements at Mechanicsville and Beaver Dam Creek",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep158-mechanicsville-movements.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Movements at Mechanicsville and Beaver Dam Creek at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep158-mechanicsville-movements.svg","alt":"Schematic troop-movement map of A. P. Hill crossing at Meadow Bridge, the Federal withdrawal to Beaver Dam Creek, Jackson near Hundley’s Corner, and attacks near Ellerson’s Mill.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Movements at Mechanicsville and Beaver Dam Creek"}],["$","span",null,{"children":"At about 3 p.m., A. P. Hill crossed Meadow Bridge and pushed through Mechanicsville as Porter’s outposts retired to McCall’s prepared line. Hill’s brigades engaged along Beaver Dam Creek; Pender and Ripley attacked near Ellerson’s Mill. Jackson reached the upper creek area late and did not turn the position that day. Arrows show generalized relationships, not exact routes, formations, frontage, or troop geometry. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep158-mechanicsville-movements.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, Historic American Landscapes Survey, U.S. Army Center of Military History, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2c"]}]]}],"$undefined"]}]]}],"$L2d"]}]]}]
27:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Directed the Oak Grove advance, visited both battlefields, and ordered Porter’s withdrawal after the June 26 victory"}]]}],["$","div","III Corps at Oak Grove-Maj. Gen. Samuel P. Heintzelman",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps at Oak Grove"}],["$","span",null,{"children":"Maj. Gen. Samuel P. Heintzelman"}],["$","small",null,{"children":"Divisions of Brig. Gens. Joseph Hooker and Philip Kearny"}]]}],["$","div","Attacking brigades at Oak Grove-Brig. Gens. Daniel E. Sickles, Cuvier Grover, and John C. Robinson",{"className":"command-entry","children":[["$","strong",null,{"children":"Attacking brigades at Oak Grove"}],["$","span",null,{"children":"Brig. Gens. Daniel E. Sickles, Cuvier Grover, and John C. Robinson"}],["$","small",null,{"children":"Advanced on the right, center, and left, respectively"}]]}],["$","div","V Corps north of the Chickahominy-Maj. Gen. Fitz John Porter",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps north of the Chickahominy"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"Ordered the Mechanicsville outposts back to Beaver Dam Creek and supervised the defense"}]]}],["$","div","Pennsylvania Reserves division-Brig. Gen. George A. McCall",{"className":"command-entry","children":[["$","strong",null,{"children":"Pennsylvania Reserves division"}],["$","span",null,{"children":"Brig. Gen. George A. McCall"}],["$","small",null,{"children":"Brigades of John F. Reynolds and Truman Seymour held the creek; supporting troops extended and reinforced the line"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Committed the June 26 offensive and directed supporting divisions across the Chickahominy"}]]}],["$","div","Division opposing Oak Grove-Maj. Gen. Benjamin Huger",{"className":"command-entry","children":[["$","strong",null,{"children":"Division opposing Oak Grove"}],["$","span",null,{"children":"Maj. Gen. Benjamin Huger"}],["$","small",null,{"children":"Brigades including Ambrose R. Wright and Robert Ransom fought the United States advance"}]]}],["$","div","Light Division-Maj. Gen. A. P. Hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Light Division"}],["$","span",null,{"children":"Maj. Gen. A. P. Hill"}],["$","small",null,{"children":"Crossed Meadow Bridge and committed brigades under Joseph R. Anderson, Jame