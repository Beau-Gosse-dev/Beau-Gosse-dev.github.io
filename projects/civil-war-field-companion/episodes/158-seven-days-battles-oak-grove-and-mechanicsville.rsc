29:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. Robert A. Smith",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Robert A. Smith"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 44th Georgia Infantry","."]}]," ","Mortally wounded while leading the regiment’s attack at Ellerson’s Mill. Contemporary reporting recorded 335 killed and wounded in the regiment; counts vary slightly on the number actually in the attacking line."]}]]}],["$","article","Col. Montford S. Stokes",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Montford S. Stokes"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 1st North Carolina Infantry","."]}]," ","Mortally wounded in the attack near Ellerson’s Mill and died in July 1862. Later sources disagree on the exact date of death."]}]]}]]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep158-seven-days-overview.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep158-seven-days-overview.svg","alt":"Schematic overview of the first two Seven Days battlefields near Richmond.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Oak Grove and Beaver Dam Creek occurred on opposite sides of the Chickahominy. The map shows their operational relationship without claiming exact unit positions."}]]}],["$","figure","/images/ep158-mechanicsville-movements.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep158-mechanicsville-movements.svg","alt":"Schematic map of generalized movements at Mechanicsville and Beaver Dam Creek.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hill crossed at Meadow Bridge, Federal outposts retired to the creek, and Confederate brigades attacked the prepared line while Jackson remained out of effective contact to the north."}]]}],["$","figure","/images/ep158-ellisons-mill-waud.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep158-ellisons-mill-waud.jpg","alt":"Alfred Waud’s June 26, 1862 pencil drawing of the fighting at Ellerson’s Mill.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alfred R. Waud made this drawing, titled “A glimpse of the defeat at Ellisons Mill,” on June 26, 1862. It depicts United States defenders and the fortified landscape."}]]}],["$","figure","/images/ep158-mechanicsville-1865.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep158-mechanicsville-1865.jpg","alt":"John Reekie photograph of buildings in Mechanicsville, Virginia, in April 1865.","width":1280,"height":