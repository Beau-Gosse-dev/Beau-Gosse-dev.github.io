28:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Directed the Oak Grove advance, visited both battlefields, and ordered Porter’s withdrawal after the June 26 victory"}]]}],["$","div","III Corps at Oak Grove",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps at Oak Grove"}],["$","span",null,{"children":"Maj. Gen. Samuel P. Heintzelman"}],["$","small",null,{"children":"Divisions of Brig. Gens. Joseph Hooker and Philip Kearny"}]]}],["$","div","Attacking brigades at Oak Grove",{"className":"command-entry","children":[["$","strong",null,{"children":"Attacking brigades at Oak Grove"}],["$","span",null,{"children":"Brig. Gens. Daniel E. Sickles, Cuvier Grover, and John C. Robinson"}],["$","small",null,{"children":"Advanced on the right, center, and left, respectively"}]]}],["$","div","V Corps north of the Chickahominy",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps north of the Chickahominy"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"Ordered the Mechanicsville outposts back to Beaver Dam Creek and supervised the defense"}]]}],["$","div","Pennsylvania Reserves division",{"className":"command-entry","children":[["$","strong",null,{"children":"Pennsylvania Reserves division"}],["$","span",null,{"children":"Brig. Gen. George A. McCall"}],["$","small",null,{"children":"Brigades of John F. Reynolds and Truman Seymour held the creek; supporting troops extended and rei