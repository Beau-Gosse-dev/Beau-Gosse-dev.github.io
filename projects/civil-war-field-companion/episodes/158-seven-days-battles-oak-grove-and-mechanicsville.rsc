d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",158," · ","June 25–26, 1862"," · ","Oak Grove along the Williamsburg Road south of the Chickahominy River, followed by Mechanicsville and Beaver Dam Creek north of the river, near Richmond, Virginia"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: OAK GROVE AND MECHANICSVILLE"}],["$","span",null,{"className":"result-label","children":"Oak Grove ended inconclusively after George B. McClellan gained about 600 yards without disrupting Robert E. Lee’s planned offensive. At Beaver Dam Creek the next day, Fitz John Porter and George A. McCall repulsed direct Confederate attacks from a prepared position. Lee’s army suffered substantially heavier losses, but McClellan ordered Porter to withdraw during the night, surrendered the battlefield, and yielded the operational initiative to Lee"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"June 25–26, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Oak Grove along the Williamsburg Road south of the Chickahominy River, followed by Mechanicsville and Beaver Dam Creek north of the river, near Richmond, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Oak Grove ended inconclusively after George B. McClellan gained about 600 yards without disrupting Robert E. Lee’s planned offensive. At Beaver Dam Creek the next day, Fitz John Porter and George A. McCall repulsed direct Confederate attacks from a prepared position. Lee’s army suffered substantially heavier losses, but McClellan ordered Porter to withdraw during the night, surrendered the battlefield, and yielded the operational initiative to Lee"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":["$Lf","$L10","$L11","$L12","$L13","$L14"]}]]}],"$L15"]}],"$undefined"]}],"$L16","$L17","$L18",false,"$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}]]}]
