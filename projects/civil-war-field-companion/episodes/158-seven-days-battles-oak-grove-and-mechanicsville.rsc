1a:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. Robert A. Smith",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Robert A. Smith"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 44th Georgia Infantry","."]}]," ","Mortally wounded while leading the regiment’s attack at Ellerson’s Mill. Contemporary reporting recorded 335 killed and wounded in the regiment; counts vary slightly on the number actually in the attacking line."]}]]}],["$","article","Col. Montford S. Stokes",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Montford S. Stokes"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 1st North Carolina Infantry","."]}]," ","Mortally wounded in the attack near Ellerson’s Mill and died in July 1862. Later sources disagree on the exact date of death."]}]]}]]}]]}]
1b:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L27","/images/ep158-ellisons-mill-waud.jpg",{"image":"/images/ep158-ellisons-mill-waud.jpg","alt":"Alfred Waud’s June 26, 1862 pencil drawing of the fighting at Ellerson’s Mill.","caption":"Alfred R. Waud made this drawing, titled “A glimpse of the defeat at Ellisons Mill,” on June 26, 1862. It depicts United States defenders and the fortified landscape.","name":"Alfred Waud’s June 26, 1862 pencil drawing of the fighting at Ellerson’s Mill.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L27","/images/ep158-mechanicsville-1865.jpg",{"image":"/images/ep158-mechanicsville-1865.jpg","alt":"John Reekie photograph of buildings in Mechanicsville, Virginia, in April 1865.","caption":"John Reekie photographed Mechanicsville in April 1865. The image documents the village several years after the June 1862 battle and does not show the battle in progress.","name":"John Reekie photograph of buildings in Mechanicsville, Virginia, in April 1865.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L27","/images/ep158-ap-hill.jpg",{"image":"/images/ep158-ap-hill.jpg","alt":"Civil War-era photographic portrait of Confederate general A. P. Hill in uniform.","caption":"A. P. Hill crossed Meadow Bridge at about 3 p.m. and began the fighting before receiving confirmation that Jackson had reached the Federal flank.","name":"Civil War-era photographic portrait of Confederate general A. P. Hill in uniform.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L27","/images/ep158-fitz-john-porter.jpg",{"image":"/images/ep158-fitz-john-porter.jpg","alt":"Civil War-era photographic portrait of United States general Fitz John Porter.","caption":"Porter concentrated the V Corps defense behind Beaver Dam Creek and withdrew only after McClellan ordered a night movement east.","name":"Civil War-era photographic portrait of United States general Fitz John Porter.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}]]}]]}]
