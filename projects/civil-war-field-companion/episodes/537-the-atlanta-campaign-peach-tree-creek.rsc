11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Hood ordered an attack on Thomas",{"className":"moment","children":[["$","span",null,{"children":"Before the attack"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood ordered an attack on Thomas"}],["$","p",null,{"children":"Hood directed Hardee's and Stewart's corps to attack from right to left. The target was Thomas's Army of the Cumberland after it crossed Peachtree Creek but before its line was fully established."}]]}]]}],["$","div","Hardee's attack began late and shifted right",{"className":"moment","children":[["$","span",null,{"children":"About 3:30 p.m."}],["$","div",null,{"children":[["$","h3",null,{"children":"Hardee's attack began late and shifted right"}],["$","p",null,{"children":"William Bate's division moved through rough ground into the gap between Thomas and Schofield and missed the main U.S. line. The shift separated Confederate divisions and prevented a simultaneous attack."}]]}]]}],["$","div","Walker and Maney attacked Newton",{"className":"moment","children":[["$","span",null,{"children":"Afternoon"}],["$","div",null,{"children":[["$","h3",null,{"children":"Walker and Maney attacked Newton"}],["$","p",null,{"children":"W. H. T. Walker's and George Maney's divisions attacked John Newton's IV Corps division. U.S. infantry and artillery stopped repeated attacks. Newton bent back part of his line when Confederate troops overlapped his right flank."}]]}]]}],["$","div","Stewart attacked the XX Corps line",{"className":"moment","children":[["$","span",null,{"children":"Afternoon"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stewart attacked the XX Corps line"}],["$","p",null,{"children":"William Loring's division struck John Geary's sector, briefly overrunning the forward 33rd New Jersey. Edward Walthall's division penetrated parts of Geary's and Alpheus Williams's positions before U.S. counterattacks and enfilading fire forced it back."}]]}]]}],["$","div","The Confederate attack ended",{"className":"moment","children":[["$","span",null,{"children":"By dark"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate attack ended"}],["$","p",null,{"children":"Stewart withdrew his troops to their starting lines. Thomas's army held the ground, and Hood did not prevent the U.S. armies from continuing their movement against Atlanta."}]]}]]}]]}]]}]
