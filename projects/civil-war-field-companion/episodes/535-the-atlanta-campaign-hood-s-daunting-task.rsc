12:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L19",null,{"guide":{"date":"July 18–19, 1864","place":"Atlanta, Georgia","result":"Hood selected Thomas's army as his first target","facts":[{"label":"U.S. force described","value":"About 95,000 men"},{"label":"Army of Tennessee","value":"Fewer than 60,000 men"},{"label":"Only remaining rail connection","value":"Macon and Western Railroad","note":"After U.S. troops cut the Georgia Railroad at Decatur."},{"label":"Operational opportunity","value":"A gap between Thomas and Schofield"}],"maps":[{"title":"Atlanta and Decatur today","caption":"Sherman sent Thomas toward Atlanta from the north while Schofield and McPherson moved farther east toward Decatur.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.49%2C33.70%2C-84.20%2C33.89&layer=mapnik&marker=33.755%2C-84.39"},{"title":"Atlanta campaign operations","caption":"This map shows the roads, railroads, waterways, fortifications, and military operations that shaped Hood’s options around Atlanta.","source":"https://www.loc.gov/item/99447303/","image":"/images/peachtree-operations-map.jpg","alt":"1875 military operations map of Atlanta and the surrounding region"},{"title":"Planned attack at Peachtree Creek","caption":"Blue marks the U.S. line. Red marks the Confederate line and attack directions. Hood planned to strike Thomas before the U.S. line was fully established.","source":"https://commons.wikimedia.org/wiki/File:BATTLE_OF_PEACHTREE_CREEK.jpg","image":"/images/peachtree-tactical-map.jpg","alt":"U.S. Army map of the Battle of Peachtree Creek showing United States positions in blue and Confederate positions and attacks in red"}],"moments":[{"time":"1:18","audioTime":78,"title":"Hood inherited a restricted position","detail":"The Army of Tennessee was close to Atlanta with little room to maneuver. The Chattahoochee no longer blocked the U.S. advance."},{"time":"2:09","audioTime":129,"title":"Atlanta was losing its railroad connections","detail":"The Western and Atlantic was under U.S. control, the Montgomery and West Point had been damaged, and McPherson cut the Georgia Railroad near Decatur."},{"time":"4:13","audioTime":253,"title":"The Army of Tennessee had fewer than 60,000 men","detail":"Casualties, sickness, and desertion had reduced the army. Johnston’s removal also damaged morale among soldiers who supported him."},{"time":"5:13","audioTime":313,"title":"The army staff was in conflict","detail":"Chief of Staff William Mackall opposed Johnston’s removal. He remained for one week before Francis Shoup replaced him."},{"time":"6:07","audioTime":367,"title":"Hardee wanted a transfer","detail":"William Hardee resented serving under the younger Hood. Jefferson Davis denied the request because Hardee was the army’s only experienced corps commander."},{"time":"6:56","audioTime":416,"title":"Other corps commanders lacked experience","detail":"Alexander Stewart had led a corps for less than three weeks. Benjamin Cheatham temporarily took Hood’s former corps until Stephen D. Lee could arrive."},{"time":"9:34","audioTime":574,"title":"Hood had limited staff support","detail":"Hood’s wounds restricted his movement, the headquarters staff was weak, and Shoup and artillery chief Robert Beckham were new to their jobs."},{"time":"12:45","audioTime":765,"title":"The command transfer continued during active operations","detail":"Johnston directed movements in Hood’s name for much of July 18 while Hood learned the army’s positions. Davis refused a request to delay the transfer."},{"time":"13:48","audioTime":828,"title":"Hood needed an offensive result","detail":"Holding the city required more than pushing Sherman behind the Chattahoochee. Hood needed to damage part of the larger U.S. force before it could be supported."},{"time":"16:14","audioTime":974,"title":"Scouts reported a gap in Sherman’s armies","detail":"McPherson and Schofield moved toward Decatur while Thomas approached from the north. The separation prevented rapid mutual support."},{"time":"17:40","audioTime":1060,"title":"Hood planned to attack Thomas at Peachtree Creek","detail":"The plan was to hit Thomas after he crossed the creek, push his army west, and trap it against the Chattahoochee River."},{"time":"18:43","audioTime":1123,"title":"Sherman expected an attack elsewhere","detail":"Sherman expected Hood to attack McPherson or Schofield and ordered IV Corps toward them, weakening Thomas near Hood’s intended target."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed three armies around Atlanta"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Advanced toward Atlanta from the north"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"Advanced toward Decatur"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Cut the Georgia Railroad near Decatur"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"John B. Hood","command":"Army of Tennessee","subordinates":"New army commander"},{"commander":"William J. Hardee","command":"Hardee's Corps","subordinates":"The army’s experienced corps commander"},{"commander":"Alexander P. Stewart","command":"Stewart's Corps","subordinates":"Recently promoted to corps command"},{"commander":"Benjamin F. Cheatham","command":"Cheatham's Corps","subordinates":"Temporary commander pending Stephen D. Lee’s arrival"},{"commander":"William W. Mackall","command":"Army chief of staff","subordinates":"Replaced by Francis A. Shoup on July 24"}]}],"people":[{"name":"John B. Hood","role":"Took command with restricted mobility from earlier wounds and no prior experience leading an army","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"Francis A. Shoup","role":"Army artillery chief selected to replace Mackall as chief of staff","side":"Confederacy"},{"name":"Carter L. Stevenson","role":"Temporarily led Hood’s former corps but was not selected as its permanent commander","side":"Confederacy"},{"name":"Stephen D. Lee","role":"Selected to command Hood’s former corps after arriving from Mississippi","side":"Confederacy"},{"name":"Robert F. Beckham","role":"Replaced Shoup as the Army of Tennessee’s chief of artillery","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/atlanta-railroad-depot.jpg","alt":"Atlanta railroad depot photographed in 1864","caption":"Atlanta’s railroad depot in 1864. By July 18, the Macon and Western was the city’s only remaining railroad connection to the rest of the Confederacy.","source":"https://www.loc.gov/item/2018666982/"},{"image":"/images/atlanta-fortifications.jpg","alt":"Confederate earthwork fortifications at Atlanta in 1864","caption":"Confederate fortifications at Atlanta, photographed in 1864.","source":"https://www.loc.gov/item/2018670937/"}],"sources":[{"label":"Official Episode 535 page","url":"https://civilwarpodcast.org/2026/07/26/civil-war-podcast-episode-535/"},{"label":"Episode 535 transcript index","url":"https://podcastrex.com/shows/the-civil-war-reconstruction/535-the-atlanta-campaign-hood-s-daunting-task"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta operations map","url":"https://www.loc.gov/item/99447303/"},{"label":"Library of Congress Atlanta railroad depot photograph","url":"https://www.loc.gov/item/2018666982/"},{"label":"Library of Congress Atlanta fortifications photograph","url":"https://www.loc.gov/item/2018670937/"}]}}]}]
