f:["$","figure","Planned attack at Peachtree Creek",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/peachtree-tactical-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Planned attack at Peachtree Creek at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/peachtree-tactical-map.jpg","alt":"U.S. Army map of the Battle of Peachtree Creek showing United States positions in blue and Confederate positions and attacks in red","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Planned attack at Peachtree Creek"}],["$","span",null,{"children":"Blue marks the U.S. line. Red marks the Confederate line and attack directions. Hood planned to strike Thomas before the U.S. line was fully established."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/peachtree-tactical-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:3:props:children:1:props:children:0:props:children:1:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:BATTLE_OF_PEACHTREE_CREEK.jpg","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:3:props:children:1:props:children:0:props:children:1:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
10:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Hood inherited a restricted position",{"className":"moment","children":[["$","$L15",null,{"seconds":78,"label":"1:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood inherited a restricted position"}],["$","p",null,{"children":"The Army of Tennessee was close to Atlanta with little room to maneuver. The Chattahoochee no longer blocked the U.S. advance."}]]}]]}],["$","div","Atlanta was losing its railroad connections",{"className":"moment","children":[["$","$L15",null,{"seconds":129,"label":"2:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Atlanta was losing its railroad connections"}],["$","p",null,{"children":"The Western and Atlantic was under U.S. control, the Montgomery and West Point had been damaged, and McPherson cut the Georgia Railroad near Decatur."}]]}]]}],["$","div","The Army of Tennessee had fewer than 60,000 men",{"className":"moment","children":[["$","$L15",null,{"seconds":253,"label":"4:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of Tennessee had fewer than 60,000 men"}],["$","p",null,{"children":"Casualties, sickness, and desertion had reduced the army. Johnston’s removal also damaged morale among soldiers who supported him."}]]}]]}],["$","div","The army staff was in conflict",{"className":"moment","children":[["$","$L15",null,{"seconds":313,"label":"5:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army staff was in conflict"}],["$","p",null,{"children":"Chief of Staff William Mackall opposed Johnston’s removal. He remained for one week before Francis Shoup replaced him."}]]}]]}],["$","div","Hardee wanted a transfer",{"className":"moment","children":[["$","$L15",null,{"seconds":367,"label":"6:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hardee wanted a transfer"}],["$","p",null,{"children":"William Hardee resented serving under the younger Hood. Jefferson Davis denied the request because Hardee was the army’s only experienced corps commander."}]]}]]}],["$","div","Other corps commanders lacked experience",{"className":"moment","children":[["$","$L15",null,{"seconds":416,"label":"6:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Other corps commanders lacked experience"}],["$","p",null,{"children":"Alexander Stewart had led a corps for less than three weeks. Benjamin Cheatham temporarily took Hood’s former corps until Stephen D. Lee could arrive."}]]}]]}],["$","div","Hood had limited staff support",{"className":"moment","children":[["$","$L15",null,{"seconds":574,"label":"9:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood had limited staff support"}],["$","p",null,{"children":"Hood’s wounds restricted his movement, the headquarters staff was weak, and Shoup and artillery chief Robert Beckham were new to their jobs."}]]}]]}],["$","div","The command transfer continued during active operations",{"className":"moment","children":[["$","$L15",null,{"seconds":765,"label":"12:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The command transfer continued during active operations"}],["$","p",null,{"children":"Johnston directed movements in Hood’s name for much of July 18 while Hood learned the army’s positions. Davis refused a request to delay the transfer."}]]}]]}],["$","div","Hood needed an offensive result",{"className":"moment","children":[["$","$L15",null,{"seconds":828,"label":"13:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood needed an offensive result"}],["$","p",null,{"children":"Holding the city required more than pushing Sherman behind the Chattahoochee. Hood needed to damage part of the larger U.S. force before it could be supported."}]]}]]}],["$","div","Scouts reported a gap in Sherman’s armies",{"className":"moment","children":[["$","$L15",null,{"seconds":974,"label":"16:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Scouts reported a gap in Sherman’s armies"}],["$","p",null,{"children":"McPherson and Schofield moved toward Decatur while Thomas approached from the north. The separation prevented rapid mutual support."}]]}]]}],"$L16","$L17"]}]]}]
