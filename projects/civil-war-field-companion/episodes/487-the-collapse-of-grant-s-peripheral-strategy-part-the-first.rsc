0:{"page:/episodes/487-the-collapse-of-grant-s-peripheral-strategy-part-the-first":"$L1","layout:/":"$L2","route:/episodes/487-the-collapse-of-grant-s-peripheral-strategy-part-the-first":"$L3","__route":"route:/episodes/487-the-collapse-of-grant-s-peripheral-strategy-part-the-first","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","__bfcacheSegmentIdentities":{"layout:/":"[\"layout\",\"layout:/\",\"root-boundary:/\",\"\"]","page:/episodes/487-the-collapse-of-grant-s-peripheral-strategy-part-the-first":"[\"page\",\"page:/episodes/:slug\",\"root-boundary:/\",\"[\\\"episodes\\\",\\\"slug|487-the-collapse-of-grant-s-peripheral-strategy-part-the-first|d\\\"]\"]"},"__srcPage":["episodes","[slug]","page"],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:640e88f6fbbce9f5","deploymentVersion":"cf6eb704-b080-4a37-aff2-3454850db2fd","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
