e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Attack at Cloyd’s Mountain"}],["$","span",null,{"children":"The schematic shows Jenkins’s fence-rail breastworks on Shuffle Ridge, Back Creek in front of the position, Crook’s two-brigade frontal attack, and Carr White’s wider movement against the Confederate right."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/cloyds-mountain-tactical-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va049","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
f:["$","figure","Cloyd’s Mountain, Dublin, and the New River today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-81.05%2C36.85%2C-80.45%2C37.35&layer=mapnik&marker=37.1126%2C-80.6654","title":"Cloyd’s Mountain, Dublin, and the New River today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Cloyd’s Mountain, Dublin, and the New River today"}],["$","span",null,{"children":"The battlefield lay north of Dublin along the route from Pearisburg. After the battle, Crook moved through Dublin to the Virginia and Tennessee Railroad bridge over the New River."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
10:["$","figure","The western Virginia expedition",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-82.3%2C36.3%2C-79.7%2C38.4&layer=mapnik&marker=37.1126%2C-80.6654","title":"The western Virginia expedition","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The western Virginia expedition"}],["$","span",null,{"children":"Crook marched from the Kanawha Valley across the Allegheny Mountains toward Dublin while Averell was assigned targets at Wytheville and Saltville. The combined operations covered a large part of southwestern Virginia."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Grant coordinated multiple Virginia offensives",{"className":"moment","children":[["$","$L17",null,{"seconds":67,"label":"1:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant coordinated multiple Virginia offensives"}],["$","p",null,{"children":"He intended to apply pressure to Confederate armies and resources at the same time rather than allow troops to move freely between theaters."}]]}]]}],["$","div","About 165,000 U.S. troops entered Virginia",{"className":"moment","children":[["$","$L17",null,{"seconds":125,"label":"2:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"About 165,000 U.S. troops entered Virginia"}],["$","p",null,{"children":"Grant and Meade had 122,000 men with the Army of the Potomac; Butler, Sigel, Crook, and Averell led supporting forces elsewhere in the state."}]]}]]}],["$","div","Caution weakened the supporting operations",{"className":"moment","children":[["$","$L17",null,{"seconds":241,"label":"4:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Caution weakened the supporting operations"}],["$","p",null,{"children":"Several U.S. commanders accepted alarming reports without verification and did not use their numerical advantages, allowing reinforcements to move toward Lee."}]]}]]}],["$","div","Grant originally planned one large western raid",{"className":"moment","children":[["$","$L17",null,{"seconds":270,"label":"4:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant originally planned one large western raid"}],["$","p",null,{"children":"Edward O. C. Ord was to destroy the Virginia and Tennessee Railroad, combine with Crook near Saltville, and, if practical, continue to Lynchburg and the James River."}]]}]]}],["$","div","Conflict with Franz Sigel broke up the original plan",{"className":"moment","children":[["$","$L17",null,{"seconds":362,"label":"6:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Conflict with Franz Sigel broke up the original plan"}],["$","p",null,{"children":"Sigel reduced Ord’s force and Ord asked for reassignment. The operation became three separate columns under Crook, Averell, and Sigel."}]]}]]}],["$","div","Crook received the main railroad assignment",{"className":"moment","children":[["$","$L17",null,{"seconds":482,"label":"8:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crook received the main railroad assignment"}],["$","p",null,{"children":"His 6,000 infantry were ordered toward Dublin Depot. Averell’s 2,000 cavalry targeted lead mines and salt works, while Sigel advanced in the Shenandoah Valley."}]]}]]}],["$","div","Crook left Gauley Bridge on May 2",{"className":"moment","children":[["$","$L17",null,{"seconds":602,"label":"10:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crook left Gauley Bridge on May 2"}],["$","p",null,{"children":"The column contained three infantry brigades and two artillery batteries. Rutherford B. Hayes commanded one of its regiments and strongly supported Crook."}]]}]]}],["$","div","Breckinridge’s forces covered 120 miles",{"className":"moment","children":[["$","$L17",null,{"seconds":721,"label":"12:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Breckinridge’s forces covered 120 miles"}],["$","p",null,{"children":"About 7,500 Confederates were scattered across the region. Success depended on learning the U.S. routes early and concentrating faster than the attackers."}]]}]]}],["$","div","Breckinridge moved his strongest brigades toward the Shenandoah Valley",{"className":"moment","children":[["$","$L17",null,{"seconds":803,"label":"13:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Breckinridge moved his strongest brigades toward the Shenandoah Valley"}],["$","p",null,{"children":"Lee considered Sigel the larger threat. Albert Jenkins remained responsible for the defense against Crook and Averell."}]]}]]}],["$","div","Crook turned the New River Narrows position",{"className":"moment","children":["$L18","$L19"]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","General-in-chief",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-chief"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Designed the coordinated Virginia operations and assigned the railroad and industrial targets"}]]}],["$","div","Kanawha Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Kanawha Division"}],["$","span",null,{"children":"George Crook"}],["$","small",null,{"children":"Carr B. White, Horatio G. Sickel, and Hugh Ewing’s brigades"}]]}],["$","div","1st Brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade"}],["$","span",null,{"children":"Carr B. White"}],["$","small",null,{"children":"Made the wide movement through woods against the Confederate right"}]]}],["$","div","3rd Brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Brigade"}],["$","span",null,{"children":"Horatio G. Sickel"}],["$","small",null,{"children":"Attacked frontally and later burned the New River bridge"}]]}],["$","div","23rd Ohio Infantry",{"className":"command-entry","children":[["$","strong",null,{"children":"23rd Ohio Infantry"}],["$","span",null,{"children":"Rutherford B. Hayes"}],["$","small",null,{"children":"Led troops in the frontal attack and the later assault on the 5th Kentucky"}]]}],["$","div","Separate cavalry expedition",{"className":"command-entry","children":[["$","strong",null,{"children":"Separate cavalry expedition"}],["$","span",null,{"children":"William W. Averell"}],["$","small",null,{"children":"Assigned to the Wytheville lead mines and Saltville salt works"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Department of Western Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Western Virginia"}],["$","span",null,{"children":"John C. Breckinridge"}],["$","small",null,{"children":"Shifted his strongest brigades toward the Shenandoah Valley and left Jenkins in regional command"}]]}],["$","div","Cloyd’s Mountain field force",{"className":"command-entry","children":[["$","strong",null,{"children":"Cloyd’s Mountain field force"}],["$","span",null,{"children":"Albert G. Jenkins"}],["$","small",null,{"children":"About 3,000 troops including John McCausland’s brigade and nine guns"}]]}],["$","div","Infantry brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Infantry brigade"}],["$","span",null,{"children":"John McCausland"}],["$","small",null,{"children":"Took command after Jenkins was wounded and directed the retreat through Dublin"}]]}],["$","div","5th Kentucky Infantry",{"className":"command-entry","children":[["$","strong",null,{"children":"5th Kentucky Infantry"}],["$","span",null,{"children":"Howard Smith"}],["$","small",null,{"children":"About 400 men who formed a rear guard east of Dublin"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","George Crook",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/george-crook.jpg","alt":"Portrait of George Crook","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George Crook"}],["$","p",null,{"children":"Planned the successful flank and frontal attacks but ended the wider expedition after destroying the New River bridge"}]]}]]}],["$","article","Carr B. White",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"CB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Carr B. White"}],"$L29"]}]]}],"$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Albert G. Jenkins",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Albert G. Jenkins"}],["$","p",null,{"children":[["$","strong",null,{"children":["Brigadier general commanding at Cloyd’s Mountain","."]}]," ","Shot in the arm and captured during the collapse of the Confederate line; the wound required amputation and he died later in May 1864"]}]]}]]}]]}]
