19:["$","div",null,{"children":[["$","h3",null,{"children":"Crook turned the New River Narrows position"}],["$","p",null,{"children":"The U.S. column crossed Wolf Creek Mountain at Rocky Gap on May 7, placing itself on Jenkins’s flank and forcing the small Confederate force to retreat toward Dublin."}]]}]
1a:["$","div","McCausland’s brigade reinforced Jenkins",{"className":"moment","children":[["$","$L17",null,{"seconds":1049,"label":"17:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCausland’s brigade reinforced Jenkins"}],["$","p",null,{"children":"The brigade had been waiting for transportation to the Shenandoah Valley at Dublin. Its retention raised Jenkins’s available force to about 3,000."}]]}]]}]
1b:["$","div","The armies prepared on opposite sides of Cloyd’s Mountain",{"className":"moment","children":[["$","$L17",null,{"seconds":1080,"label":"18:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies prepared on opposite sides of Cloyd’s Mountain"}],["$","p",null,{"children":"Crook had about 6,500 effective troops at Poplar Hill. Jenkins occupied a high knoll beyond the mountain gap with fence-rail breastworks and nine guns."}]]}]]}]
1c:["$","div","Crook observed the full Confederate position",{"className":"moment","children":[["$","$L17",null,{"seconds":1109,"label":"18:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crook observed the full Confederate position"}],["$","p",null,{"children":"From near the summit, Crook and Carr White saw the defensive line about two miles away and watched additional Confederate infantry arrive."}]]}]]}]
1d:["$","div","Crook planned a frontal attack and a flank movement",{"className":"moment","children":[["$","$L17",null,{"seconds":1168,"label":"19:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crook planned a frontal attack and a flank movement"}],["$","p",null,{"children":"Two brigades advanced directly across the valley while White led the third through dense woods against the Confederate right on Shuffle Ridge."}]]}]]}]
1e:["$","div","Jenkins shifted troops toward White",{"className":"moment","children":[["$","$L17",null,{"seconds":1217,"label":"20:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jenkins shifted troops toward White"}],["$","p",null,{"children":"He first sent a small battalion and then one of his largest regiments to the threatened flank, reducing the strength available against Crook’s main assault."}]]}]]}]
1f:["$","div","Sickel and Hayes crossed the meadow",{"className":"moment","children":[["$","$L17",null,{"seconds":1228,"label":"20:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sickel and Hayes crossed the meadow"}],["$","p",null,{"children":"Horatio Sickel commanded the brigade on the U.S. right and Rutherford B. Hayes the one on the left. Crook accompanied the frontal attack under musket and artillery fire."}]]}]]}]
20:["$","div","Back Creek disrupted the U.S. line",{"className":"moment","children":[["$","$L17",null,{"seconds":1272,"label":"21:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Back Creek disrupted the U.S. line"}],["$","p",null,{"children":"The four-foot-deep gully was not visible from the mountain. Troops lost formation in the water but used the banks for cover while officers reorganized them."}]]}]]}]
21:["$","div","The U.S. attack captured the breastworks",{"className":"moment","children":[["$","$L17",null,{"seconds":1295,"label":"21:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. attack captured the breastworks"}],["$","p",null,{"children":"Crook’s troops resumed the charge, reached the fence-rail defenses, and overwhelmed the defenders after brief hand-to-hand fighting."}]]}]]}]
22:["$","div","Jenkins was wounded and captured",{"className":"moment","children":[["$","$L17",null,{"seconds":1309,"label":"21:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jenkins was wounded and captured"}],["$","p",null,{"children":"He was shot in the arm while trying to rally the line. John McCausland assumed command but could not establish another position."}]]}]]}]
23:["$","div","The Confederate withdrawal became a rout",{"className":"moment","children":[["$","$L17",null,{"seconds":1325,"label":"22:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate withdrawal became a rout"}],["$","p",null,{"children":"Crook’s four hundred cavalrymen increased the pressure. The retreat remained disorganized until the 5th Kentucky arrived near Dublin."}]]}]]}]
24:["$","div","The 5th Kentucky covered the retreat",{"className":"moment","children":[["$","$L17",null,{"seconds":1374,"label":"22:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 5th Kentucky covered the retreat"}],["$","p",null,{"children":"Only about four hundred men reached the field after a train derailment. Howard Smith’s regiment held for more than an hour against cavalry and then Hayes’s brigade."}]]}]]}]
25:["$","div","Crook occupied Dublin at dusk",{"className":"moment","children":[["$","$L17",null,{"seconds":1417,"label":"23:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crook occupied Dublin at dusk"}],["$","p",null,{"children":"The episode counts more than one hundred U.S. dead, more than five hundred wounded, and seventy-two missing. Confederate losses included about two hundred missing."}]]}]]}]
26:["$","div","U.S. troops burned railroad facilities on May 10",{"className":"moment","children":[["$","$L17",null,{"seconds":1443,"label":"24:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops burned railroad facilities on May 10"}],["$","p",null,{"children":"They destroyed the Dublin telegraph office, station, and supply depot before moving east to the New River railroad bridge."}]]}]]}]
27:["$","div","Artillery fought over the New River bridge",{"className":"moment","children":[["$","$L17",null,{"seconds":1478,"label":"24:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Artillery fought over the New River bridge"}],["$","p",null,{"children":"After a two-hour exchange, Confederate ammunition ran low and soldiers from Sickel’s brigade set the four-hundred-foot wooden bridge on fire."}]]}]]}]
28:["$","div","Crook withdrew instead of continuing the raid",{"className":"moment","children":[["$","$L17",null,{"seconds":1530,"label":"25:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crook withdrew instead of continuing the raid"}],["$","p",null,{"children":"McCausland retreated twelve miles toward Christiansburg, but Crook did not pursue. The U.S. column returned through heavy rain and reached Union, West Virginia, on May 14."}]]}]]}]
29:["$","p",null,{"children":"Led the brigade that moved through woods and placed the Confederate right under heavy pressure"}]
