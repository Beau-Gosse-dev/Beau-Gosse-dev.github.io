3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"#487- THE COLLAPSE OF GRANT'S PERIPHERAL STRATEGY (Part the First) · Field Companion"}],["$","meta","1",{"name":"description","content":"In which we look at the collapse of Grant's peripheral strategy in Virginia. We talk about the Battle of Cloyd's Mountain on May 9, 1864."}],["$","meta","2",{"property":"og:title","content":"#487- THE COLLAPSE OF GRANT'S PERIPHERAL STRATEGY (Part the First) · Field Companion"}],["$","meta","3",{"property":"og:description","content":"In which we look at the collapse of Grant's peripheral strategy in Virginia. We talk about the Battle of Cloyd's Mountain on May 9, 1864."}],["$","meta","4",{"name":"twitter:card","content":"summary"}],["$","meta","5",{"name":"twitter:title","content":"#487- THE COLLAPSE OF GRANT'S PERIPHERAL STRATEGY (Part the First) · Field Companion"}],["$","meta","6",{"name":"twitter:description","content":"In which we look at the collapse of Grant's peripheral strategy in Virginia. We talk about the Battle of Cloyd's Mountain on May 9, 1864."}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["episodes","487-the-collapse-of-grant-s-peripheral-strategy-part-the-first"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"episodes","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background