2e:["$","article","John C. Breckinridge",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/john-c-breckinridge.jpg","alt":"Portrait of John C. Breckinridge","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"John C. Breckinridge"}],["$","p",null,{"children":"Oversaw the scattered western Virginia defense while moving troops toward the Shenandoah Valley"}]]}]]}]
