},"children":"About 23 percent of the force"}]]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2025/03/23/civil-war-podcast-episode-487/",{"href":"https://civilwarpodcast.org/2025/03/23/civil-war-podcast-episode-487/","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast, episode 487"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va049",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va049","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Cloyd’s Mountain battle detail"]}],"$Lf","$L10","$L11"]}]]}],"$undefined"]}],"$L12","$L13","$L14",false,"$L15","$L16","$L17","$L18","$L19","$L1a"]}]]}]
