d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",159," · ","Night of June 26–morning of June 27, 1862"," · ","Hanover County, Virginia, north of the Chickahominy River: from Beaver Dam Creek east to Boatswain’s Swamp, the Turkey Hill plateau, Gaines’s farm area, and the Cold Harbor crossroads; the wider decision also shifted the Federal base from White House Landing toward Harrison’s Landing on the James River"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: GAINES'S MILL (Part the First)"}],["$","span",null,{"className":"result-label","children":"Although Porter’s V Corps had repulsed the Confederate attacks at Beaver Dam Creek, McClellan ordered it four miles east to a new defensive position behind Boatswain’s Swamp and decided to abandon the Richmond & York River Railroad supply line in favor of a base on the James. Porter prepared to hold north of the Chickahominy while the rest of the Army of the Potomac remained south of the river. Lee pursued a plan based on the mistaken expectation that the Federals would defend Powhite Creek and the route to White House Landing; on the morning of June 27, he had to revise that plan after encountering Porter’s unanticipated position. The episode ends before the main Battle of Gaines’s Mill begins"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"Night of June 26–morning of June 27, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Hanover County, Virginia, north of the Chickahominy River: from Beaver Dam Creek east to Boatswain’s Swamp, the Turkey Hill plateau, Gaines’s farm area, and the Cold Harbor crossroads; the wider decision also shifted the Federal base from White House Landing toward Harrison’s Landing on the James River"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Although Porter’s V Corps had repulsed the Confederate attacks at Beaver Dam Creek, McClellan ordered it four miles east to a new defensive position behind Boatswain’s Swamp and decided to abandon the Richmond & York River Railroad supply line in favor of a base on the James. Porter prepared to hold north of the Chickahominy while the rest of the Army of the Potomac remained south of the river. Lee pursued a plan based on the mistaken expectation that the Federals would defend Powhite Creek and the route to White House Landing; on the morning of June 27, he had to revise that plan after encountering Porter’s unanticipated position. The episode ends before the main Battle of Gaines’s Mill begins"}]]}]]}],false,"$Lf","$undefined"]}],"$L10","$L11","$L12",false,"$L13",false,"$L14","$L15","$L16","$L17"]}]]}]
