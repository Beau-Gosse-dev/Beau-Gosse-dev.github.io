","a","https://npshistory.com/publications/civil_war_series/21/sec5.htm",{"href":"https://npshistory.com/publications/civil_war_series/21/sec5.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service Civil War Series: The Battles for Richmond, 1862"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://transportation.army.mil/History/whitehouselanding.html",{"href":"https://transportation.army.mil/History/whitehouselanding.html","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Transportation Corps: White House Landing"]}],["$","a","https://ehistory.osu.edu/books/official-records/013",{"href":"https://ehistory.osu.edu/books/official-records/013","target":"_blank","rel":"noreferrer","children":[" · ","Primary source collection: Official Records, Series I, Volume XI, Part II"]}],["$","a","https://www.battlefields.org/learn/primary-sources/robert-e-lees-report-seven-days-battles",{"href":"https://www.battlefields.org/learn/primary-sources/robert-e-lees-report-seven-days-battles","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Robert E. Lee’s official report on the Seven Days Battles"]}],["$","a","https://digital.library.cornell.edu/catalog/may927011",{"href":"https://digital.library.cornell.edu/catalog/may927011","target":"_blank","rel":"noreferrer","children":[" · ","Cornell University Library: McClellan’s official campaign report"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00217/",{"href":"https://www.loc.gov/item/gvhs01.vhs00217/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Robert Knox Sneden plan of Gaines’s Mill"]}],"$L18","$L19","$L1a","$L1b"]}]]}]
