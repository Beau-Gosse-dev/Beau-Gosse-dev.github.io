0:{"page:/episodes/145-stonewall-in-the-valley-mcdowell-part-the-first":"$L1","layout:/":"$L2","route:/episodes/145-stonewall-in-the-valley-mcdowell-part-the-first":"$L3","__route":"route:/episodes/145-stonewall-in-the-valley-mcdowell-part-the-first","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","__bfcacheSegmentIdentities":{"layout:/":"[\"layout\",\"layout:/\",\"root-boundary:/\",\"\"]","page:/episodes/145-stonewall-in-the-valley-mcdowell-part-the-first":"[\"page\",\"page:/episodes/:slug\",\"root-boundary:/\",\"[\\\"episodes\\\",\\\"slug|145-stonewall-in-the-valley-mcdowell-part-the-first|d\\\"]\"]"},"__srcPage":["episodes","[slug]","page"],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:640e88f6fbbce9f5","deploymentVersion":"1e094649-f0e4-45c5-b963-625874790bc9","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
