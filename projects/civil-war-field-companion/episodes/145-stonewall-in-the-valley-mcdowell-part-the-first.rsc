1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",145," · ","April 19–May 7, 1862"," · ","Upper Shenandoah Valley and central Virginia: Conrad’s Store and Swift Run Gap, Port Republic, Brown’s Gap, Mechum’s Station, Staunton, and the Staunton–Parkersburg Turnpike approaches to McDowell, Virginia"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: McDOWELL (Part the First)"}],["$","span",null,{"className":"result-label","children":"Operational prelude; no battle is fought in this episode. Jackson left Richard Ewell near Swift Run Gap to watch Nathaniel Banks, moved his own force by a circuitous march and rail journey to Staunton, joined Edward “Allegheny” Johnson, and advanced west against Robert Milroy. On May 7, Milroy withdrew his outposts toward McDowell and called Robert Schenck for support, setting the conditions for the Battle of McDowell on May 8"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6309264301.mp3?updated=1695307476","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Jackson’s movement from Elk Run Valley to the approaches of McDowell, April 19–May 7, 1862"}],["$","small",null,{"children":"The episode ends with the opposing forces in position on the night of May 7. The Battle of McDowell itself is covered in the next episode."}]]}],["$","div","Operational result",{"children":[["$","span",null,{"children":"Operational result"}],["$","strong",null,{"children":"Jackson concentrated against Milroy while Ewell watched Banks"}],["$","small",null,{"children":"The movement applied Jackson’s preferred concept of using separate Confederate forces against isolated United States columns in sequence."}]]}],["$","div","April 19 position",{"children":[["$","span",null,{"children":"April 19 position"}],["$","strong",null,{"children":"Elk Run Valley above Conrad’s Store, beside Swift Run Gap"}],["$","small",null,{"children":"Jackson’s men crossed the South Fork of the Shenandoah at Conrad’s Store after covering about 50 miles in three days. Conrad’s Store is now Elkton."}]]}],["$","div","Why Swift Run Gap mattered",{"children":[["$","span",null,{"children":"Why Swift Run Gap mattered"}],["$","strong",null,{"children":"Concealment, a defensible position, a route across the Blue Ridge, and a base for striking Banks’s flank"}],["$","small",null,{"children":"The location also kept Jackson in communication with Ewell east of the Blue Ridge."}]]}],["$","div","Banks’s assessment",{"children":[["$","span",null,{"children":"Banks’s assessment"}],["$","strong",null,{"children":"Jackson had left the Valley"}],["$","small",null,{"children":"Banks told Secretary of War Edwin Stanton on April 22 that Jackson had permanently abandoned the Valley and on April 30 that nothing more remained for his command to do there. Jackson was still concealed near Swift Run Gap."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}],"$L24","$L25","$L26","$L27",false,"$L28","$L29","$L2a"]}]]}]
2d:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Banks’s forward position",{"children":[["$","span",null,{"children":"Banks’s forward position"}],["$","strong",null,{"children":"Harrisonburg by April 25"}],["$","small",null,{"children":"United States troops had occupied New Market and Harrisonburg while Jackson yielded the central Valley without offering battle."}]]}]
f:["$","div","Staunton’s importance",{"children":[["$","span",null,{"children":"Staunton’s importance"}],["$","strong",null,{"children":"Rail and supply center for the southern Shenandoah Valley"}],["$","small",null,{"children":"The Virginia Central Railroad connected Staunton eastward, while the Virginia and Tennessee Railroad system and roads farther south tied the region to the Confederate interior. A Federal advance on Staunton threatened those communications."}]]}]
10:["$","div","Edward Johnson’s force",{"children":[["$","span",null,{"children":"Edward Johnson’s force"}],["$","strong",null,{"children":"About 2,800 men west of Staunton"}],["$","small",null,{"children":"Pressed by Milroy and threatened by Frémont’s Mountain Department, Johnson withdrew from Camp Allegheny to the West View area on April 20."}]]}]
11:["$","div","Ewell’s division",{"children":[["$","span",null,{"children":"Ewell’s division"}],["$","strong",null,{"children":"Roughly 8,500 men east of the Blue Ridge"}],["$","small",null,{"children":"The episode uses 8,500. A U.S. Army historical study gives 8,884. Ewell was the large mobile Confederate force available to support Jackson or the Rappahannock line."}]]}]
12:["$","div","Lee’s role",{"children":[["$","span",null,{"children":"Lee’s role"}],["$","strong",null,{"children":"Military adviser in Richmond, not yet an army field commander"}],["$","small",null,{"children":"Robert E. Lee encouraged Jackson and Ewell to seek opportunities that might keep United States forces away from Fredericksburg and Richmond, but overlapping lines of authority involving Joseph E. Johnston remained unclear."}]]}]
13:["$","div","Jackson’s April 29 options",{"children":[["$","span",null,{"children":"Jackson’s April 29 options"}],["$","strong",null,{"children":"Three possible offensives"}],["$","small",null,{"children":"His preferred option was to leave Ewell near Swift Run Gap, join Edward Johnson, defeat Milroy before Frémont could reinforce him, then return east and combine against Banks. Other options involved an attack near New Market or a move through the Luray Valley toward Front Royal."}]]}]
14:["$","div","Lee’s May 1 reply",{"children":[["$","span",null,{"children":"Lee’s May 1 reply"}],["$","strong",null,{"children":"Jackson could choose the plan"}],["$","small",null,{"children":"Lee left the selection to Jackson’s judgment and cautioned him against operations that would not improve the larger strategic situation."}]]}]
15:["$","div","Uncertain plan transmission",{"children":[["$","span",null,{"children":"Uncertain plan transmission"}],["$","strong",null,{"children":"Ewell knew his immediate assignment, but not Jackson’s full design"}],["$","small",null,{"children":"The episode, following Peter Cozzens, says it is uncertain how much Jackson disclosed in their April 29 and April 30 meetings. A later message also leaves room for doubt about when Jackson finally committed to the Milroy operation."}]]}]
16:["$","div","April 30 substitution",{"children":[["$","span",null,{"children":"April 30 substitution"}],["$","strong",null,{"children":"Ewell moved into Jackson’s vacated camps near Swift Run Gap"}],["$","small",null,{"children":"This maintained a Confederate presence opposite Banks while Jackson moved south toward Port Republic."}]]}]
17:["$","div","Jackson’s route",{"children":[["$","span",null,{"children":"Jackson’s route"}],["$","strong",null,{"children":"Conrad’s Store → Port Republic → Brown’s Gap → Mechum’s Station → Staunton"}],["$","small",null,{"children":"Most of the force returned west by the Virginia Central Railroad from Mechum’s Station; some units marched. The transcript’s “Meacham Station” is normalized here to the historical spelling “Mechum’s Station.”"}]]}]
18:["$","div","Mud delay",{"children":[["$","span",null,{"children":"Mud delay"}],["$","strong",null,{"children":"Only about five miles for much of the army on April 30"}],["$","small",null,{"children":"Jackson and his staff covered about 13 miles, but torrential rain turned the unimproved road toward Port Republic into a quagmire. Artillery and wagons lagged behind the infantry through May 2."}]]}]
19:["$","div","Intent of the circuitous march",{"children":[["$","span",null,{"children":"Intent of the circuitous march"}],["$","strong",null,{"children":"Deception was useful, but its exact timing is uncertain"}],["$","small",null,{"children":"The episode describes a deliberate attempt to make Banks think Jackson was leaving for Richmond. The U.S. Army study notes that Jackson’s May 3 message to Ewell creates doubt about whether the Milroy operation had been fixed from the beginning."}]]}]
1a:["$","div","Federal intelligence",{"children":[["$","span",null,{"children":"Federal intelligence"}],["$","strong",null,{"children":"Williams and Banks inferred Jackson’s real direction by May 2"}],["$","small",null,{"children":"According to the episode, Alpheus Williams concluded that Jackson was moving to join Edward Johnson. This undercuts the idea that the exhausting detour achieved complete operational surprise."}]]}]
1b:["$","div","Washington’s May 1 decision",{"children":[["$","span",null,{"children":"Washington’s May 1 decision"}],["$","strong",null,{"children":"Banks ordered back toward Strasburg; Shields ordered east"}],["$","small",null,{"children":"Lincoln accepted Banks’s judgment that the Valley mission was complete. The removal of Shields reduced the force Banks would later have available against Jackson and Ewell."}]]}]
1c:["$","div","Staunton concentration",{"children":[["$","span",null,{"children":"Staunton concentration"}],["$","strong",null,{"children":"Jackson’s force assembled by the evening of May 5"}],["$","small",null,{"children":"Jackson reached Staunton on May 4. Ashby’s cavalry restricted movement into and out of town in an effort to preserve secrecy."}]]}]
1d:["$","div","VMI cadets",{"children":[["$","span",null,{"children":"VMI cadets"}],["$","strong",null,{"children":"About 200 arrived at Staunton on May 5"}],["$","small",null,{"children":"The corps was attached temporarily to the Stonewall Brigade. The cadets were not expected to fight at McDowell, but they could perform support duties and gain field experience."}]]}]
1e:["$","div","Advance on May 7",{"children":[["$","span",null,{"children":"Advance on May 7"}],["$","strong",null,{"children":"Approximately 10,000–11,600 Confederates moved west"}],["$","small",null,{"children":"The episode describes about 10,000 men in the combined commands. The National Park Service gives 11,600 for Jackson after joining Johnson. Strength accounting varies by date and by whether all troops present or only effective troops are counted."}]]}]
1f:["$","div","First contact",{"children":[["$","span",null,{"children":"First contact"}],["$","strong",null,{"children":"Rogers Tollgate, 13 miles east of McDowell"}],["$","small",null,{"children":"Johnson’s advance encountered Milroy’s pickets on the Staunton–Parkersburg Turnpike during the afternoon of May 7."}]]}]
20:["$","div","Milroy’s response",{"children":[["$","span",null,{"children":"Milroy’s response"}],["$","strong",null,{"children":"Fall back to McDowell and summon Schenck"}],["$","small",null,{"children":"Milroy understood that Jackson and Johnson were combining against him. Schenck was at Franklin, about 30 miles away."}]]}]
21:["$","div","Night of May 7",{"children":[["$","span",null,{"children":"Night of May 7"}],["$","strong",null,{"children":"Johnson at Shaw’s Fork; Jackson at Buffalo Gap"}],["$","small",null,{"children":"The episode places Johnson about six miles east of McDowell and Jackson about ten miles away. These are approximate camp locations, not precise unit plots."}]]}]
22:["$","div","Leader losses",{"children":[["$","span",null,{"children":"Leader losses"}],["$","strong",null,{"children":"None within this episode’s pre-battle scope"}],["$","small",null,{"children":"The losses list is intentionally empty. Combat and command casualties from the Battle of McDowell belong to episode 146."}]]}]
23:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“Shenandoah 1862: Stonewall Jackson Outmaneuvers the Union” by Clayton and James Donnell"}],"$undefined"]}]
24:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
25:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Late April: three separated Federal forces threaten the Valley",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep145-late-april-positions.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Late April: three separated Federal forces threaten the Valley at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-late-april-positions.svg","alt":"Schematic map of late-April 1862 positions showing Banks at Harrisonburg, Jackson at Swift Run Gap, Ewell east of the Blue Ridge, Johnson west of Staunton, and Milroy near McDowell.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Late April: three separated Federal forces threaten the Valley"}],["$","span",null,{"children":"Banks held Harrisonburg in the central Valley, Milroy pressed eastward toward Edward Johnson west of Staunton, and McDowell gathered near Fredericksburg. Jackson’s concealed position near Swift Run Gap let him watch Banks, communicate with Ewell, or move across the Blue Ridge. This map is a strategic schematic: locations, distances, routes, and force footprints are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep145-late-april-positions.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/Portals/143/Images/Publications/ArmyHistoryMag/pdf/19901999/AH47newOCR.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","April 30–May 7: Jackson circles back to Staunton and McDowell",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep145-jackson-route-to-mcdowell.svg","target":"_blank","rel":"noreferrer","aria-label":"Open April 30–May 7: Jackson circles back to Staunton and McDowell at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-jackson-route-to-mcdowell.svg","alt":"Schematic map of Jackson’s route from Elk Run Valley through Port Republic, Brown’s Gap, and Mechum’s Station, then by rail to Staunton and west toward McDowell.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"April 30–May 7: Jackson circles back to Staunton and McDowell"}],["$","span",null,{"children":"Jackson marched south through Port Republic, crossed the Blue Ridge through Brown’s Gap, and reached Mechum’s Station. Most of his force then traveled west by rail through Rockfish Gap to Staunton. After joining Edward Johnson, the Confederates advanced west on the Staunton–Parkersburg Turnpike. Ewell replaced Jackson near Swift Run Gap. This route map is schematic and does not reproduce an exact march trace."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep145-jackson-route-to-mcdowell.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/articles/000/battle-of-mcdowell.htm","target":"_blank","rel":"noreferrer","children":["Map source ","$L2b"]}]]}],"$undefined"]}]]}],"$L2c"]}]]}]
26:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode resumes after Kernstown",{"className":"moment","children":[["$","$L2d",null,{"seconds":39,"label":"0:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode resumes after Kernstown"}],["$","p",null,{"children":"Banks followed Jackson cautiously after March 23. When Banks pressed harder in mid-April, Jackson abandoned Rude’s Hill and yielded New Market, Harrisonburg, and the Valley north of the North River."}]]}]]}],["$","div","Jackson turns toward Conrad’s Store",{"className":"moment","children":[["$","$L2d",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson turns toward Conrad’s Store"}],["$","p",null,{"children":"On April 19 the Valley force crossed the South Fork of the Shenandoah and camped in Elk Run Valley between the river and Swift Run Gap after marching about 50 miles in three days."}]]}]]}],["$","div","Banks loses track of Jackson",{"className":"moment","children":[["$","$L2d",null,{"seconds":204,"label":"3:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks loses track of Jackson"}],["$","p",null,{"children":"Jackson’s shift east of the main Valley corridor concealed his location and intentions from the advancing United States command."}]]}]]}],["$","div","Banks reports that Jackson has permanently left",{"className":"moment","children":[["$","$L2d",null,{"seconds":221,"label":"3:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks reports that Jackson has permanently left"}],["$","p",null,{"children":"On April 22 Banks confidently told Secretary of War Stanton that Jackson had abandoned the Shenandoah Valley."}]]}]]}],["$","div","United States troops occupy Harrisonburg",{"className":"moment","children":[["$","$L2d",null,{"seconds":228,"label":"3:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States troops occupy Harrisonburg"}],["$","p",null,{"children":"Banks’s advance reached Harrisonburg on April 25. He believed Jackson was moving east to reinforce Joseph E. Johnston against McClellan."}]]}]]}],["$","div","Banks says the Valley mission is complete",{"className":"moment","children":[["$","$L2d",null,{"seconds":244,"label":"4:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks says the Valley mission is complete"}],["$","p",null,{"children":"His April 30 message to Stanton stated that nothing more remained to be done in the Valley, an assessment that helped prompt Washington to remove troops."}]]}]]}],["$","div","The logic of Jackson’s position is explained",{"className":"moment","children":[["$","$L2d",null,{"seconds":275,"label":"4:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"The logic of Jackson’s position is explained"}],["$","p",null,{"children":"Elk Run Valley offered concealment and defense, controlled Swift Run Gap, kept open contact across the Blue Ridge, and put Jackson near Banks’s eastern flank if the Federals moved on Staunton."}]]}]]}],["$","div","Staunton is identified as the southern Valley key",{"className":"moment","children":[["$","$L2d",null,{"seconds":319,"label":"5:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Staunton is identified as the southern Valley key"}],["$","p",null,{"children":"The town’s rail and road connections made it a major Confederate supply and communications center. Its loss would expose the upper Valley and rail links farther south."}]]}]]}],["$","div","Edward Johnson guards the western approaches",{"className":"moment","children":[["$","$L2d",null,{"seconds":338,"label":"5:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Edward Johnson guards the western approaches"}],["$","p",null,{"children":"The episode reviews the approximately 2,800-man command that had fought at Allegheny Mountain and then withdrawn to West View under pressure from Milroy and Frémont."}]]}]]}],["$","div","Ewell gives Jackson another option",{"className":"moment","children":["$L2e","$L2f"]}],"$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d"]}]]}]
27:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","National strategic direction",{"className":"command-entry","children":[["$","strong",null,{"children":"National strategic direction"}],["$","span",null,{"children":"President Abraham Lincoln / Secretary Edwin M. Stanton"}],["$","small",null,{"children":"Directed Banks to withdraw toward Strasburg and Shields to move east toward McDowell’s force; these decisions reduced United States strength facing Jackson in the Valley"}]]}],["$","div","Department of the Rappahannock",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Rappahannock"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Concentrating near Fredericksburg for operations toward Richmond; designated to receive Shields’s division"}]]}],["$","div","Department of the Shenandoah",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Shenandoah"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Advanced to Harrisonburg, lost contact with Jackson, and reported the Valley mission complete before receiving orders to withdraw toward Strasburg"}]]}],["$","div","Division under Banks",{"className":"command-entry","children":[["$","strong",null,{"children":"Division under Banks"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Recognized by May 2 that Jackson was probably moving toward Edward Johnson; remained with Banks after Shields was detached"}]]}],["$","div","Division under Banks",{"className":"command-entry","children":[["$","strong",null,{"children":"Division under Banks"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"Ordered out of the Valley to reinforce McDowell near Fredericksburg"}]]}],["$","div","Mountain Department",{"className":"command-entry","children":[["$","strong",null,{"children":"Mountain Department"}],["$","span",null,{"children":"Maj. Gen. John C. Frémont"}],["$","small",null,{"children":"Directed United States forces operating through the mountains west of Staunton, including the commands of Milroy and Schenck"}]]}],["$","div","Frémont’s advance brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Frémont’s advance brigade"}],["$","span",null,{"children":"Brig. Gen. Robert H. Milroy"}],["$","small",null,{"children":"Pressed Edward Johnson eastward, then withdrew his outposts to McDowell and called Schenck for support when Jackson approached"}]]}],["$","div","Brigade in Frémont’s Mountain Department",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade in Frémont’s Mountain Department"}],["$","span",null,{"children":"Brig. Gen. Robert C. Schenck"}],["$","small",null,{"children":"Located at Franklin about 30 miles from McDowell when Milroy requested reinforcement on May 7"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Overlapping strategic direction from Virginia and Richmond",{"className":"command-entry","children":[["$","strong",null,{"children":"Overlapping strategic direction from Virginia and Richmond"}],["$","span",null,{"children":"Gen. Joseph E. Johnston / Gen. Robert E. Lee"}],["$","small",null,{"children":"Johnston remained the senior field commander while Lee, as Davis’s military adviser, corresponded directly with Jackson and Ewell. The U.S. Army study emphasizes that the arrangement lacked clean unity of command"}]]}],["$","div","Valley District and Valley force",{"className":"command-entry","children":["$L4e","$L4f","$L50"]}],"$L51","$L52","$L53","$L54"]]}]]}],"$L55","$L56"]}]
28:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep145-hotchkiss-shenandoah-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-hotchkiss-shenandoah-map.jpg","alt":"Jedediah Hotchkiss’s large 1862 manuscript map of the Shenandoah Valley.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hotchkiss’s manuscript map covers the Valley from Winchester to Staunton. Its roads, gaps, ridges, rivers, and settlements show why geography shaped every movement in this episode. It does not cover the McDowell battlefield west of Staunton."}]]}],["$","figure","/images/ep145-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-stonewall-jackson.jpg","alt":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson gave up ground in the central Valley to preserve mobility, then shifted his command through the Blue Ridge and back by rail to concentrate against Milroy."}]]}],["$","figure","/images/ep145-richard-ewell.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-richard-ewell.jpg","alt":"Wartime photographic portrait of Confederate general Richard S. Ewell in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Ewell brought his division toward Swift Run Gap and took Jackson’s place opposite Banks. Jackson told him the immediate assignment but apparently did not disclose the full operational plan."}]]}],["$","figure","/images/ep145-edward-johnson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-edward-johnson.jpg","alt":"Wartime photographic portrait of Confederate general Edward Allegheny Johnson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Edward Johnson had guarded the mountain approaches west of Staunton through the winter. His approximately 2,800 men joined Jackson and led the westward advance on May 7."}]]}],["$","figure","/images/ep145-robert-milroy.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-robert-milroy.jpg","alt":"Three exposures on one wartime glass negative showing United States general Robert H. Milroy in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Milroy led Frémont’s eastern vanguard. Once his scouts confirmed Jackson and Johnson were moving together, he pulled back to McDowell and requested Schenck’s brigade."}]]}],["$","figure","/images/ep145-late-april-positions.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-late-april-positions.svg","alt":"Schematic map of Confederate and United States positions around the Shenandoah Valley in late April 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s location near Swift Run Gap sat between Banks in the Valley and Ewell east of the Blue Ridge, while Edward Johnson and Milroy faced each other west of Staunton."}]]}],["$","figure","/images/ep145-jackson-route-to-mcdowell.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-jackson-route-to-mcdowell.svg","alt":"Schematic route map of Jackson’s movement from Elk Run Valley to Staunton and McDowell.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The route through Port Republic, Brown’s Gap, and Mechum’s Station took Jackson east of the Blue Ridge before trains carried most of the command back west to Staunton."}]]}]]}]]}]
29:["$","details",null,{"className":"reference-sources","children":[["$","summary",null,{"children":"Sources and image credits"}],["$","ul",null,{"children":[["$","li","https://civilwarpodcast.org/2016/03/06/civil-war-podcast-episode-145/",{"children":["$","a",null,{"href":"https://civilwarpodcast.org/2016/03/06/civil-war-podcast-episode-145/","target":"_blank","rel":"noreferrer","children":["Official Civil War Podcast episode 145 page"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/articles/000/battle-of-mcdowell.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/articles/000/battle-of-mcdowell.htm","target":"_blank","rel":"noreferrer","children":["National Park Service: Battle of McDowell"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm","target":"_blank","rel":"noreferrer","children":["National Park Service: Jackson’s 1862 Shenandoah Valley Campaign"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://history.army.mil/Portals/143/Images/Publications/ArmyHistoryMag/pdf/19901999/AH47newOCR.pdf",{"children":["$","a",null,{"href":"https://history.army.mil/Portals/143/Images/Publications/ArmyHistoryMag/pdf/19901999/AH47newOCR.pdf","target":"_blank","rel":"noreferrer","children":["U.S. Army Center of Military History: “Action and Reaction: The Spring 1862 Shenandoah Valley Campaign Revisited,” Robert S. Rush"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://ehistory.osu.edu/books/official-records/018",{"children":["$","a",null,{"href":"https://ehistory.osu.edu/books/official-records/018","target":"_blank","rel":"noreferrer","children":["Primary source collection: Official Records, Series I, Volume XII, Part III"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://ehistory.osu.edu/books/official-records/018/0872",{"children":["$","a",null,{"href":"https://ehistory.osu.edu/books/official-records/018/0872","target":"_blank","rel":"noreferrer","children":["Primary correspondence: Jackson’s late-April operational proposals, Official Records page 872"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://ehistory.osu.edu/books/official-records/018/0875",{"children":["$","a",null,{"href":"https://ehistory.osu.edu/books/official-records/018/0875","target":"_blank","rel":"noreferrer","children":["Primary correspondence: Lee and Jackson, May 1, 1862, Official Records page 875"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/99446754/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/99446754/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Jedediah Hotchkiss, 1862 map of the Shenandoah Valley"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/2018670324/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/2018670324/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Thomas J. “Stonewall” Jackson portrait"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/pictures/item/2018670286/",{"children":["$","a",null,{"href":"https://www.loc.gov/pictures/item/2018670286/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Richard S. Ewell portrait"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/2018670430/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/2018670430/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Edward Johnson portrait"," ","$L57"]}]}],"$L58","$L59"]}]]}]
2a:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
2b:["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]
2c:["$","figure","Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep145-hotchkiss-shenandoah-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-hotchkiss-shenandoah-map.jpg","alt":"Jedediah Hotchkiss’s large 1862 manuscript map of the Shenandoah Valley from Winchester to Staunton.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jedediah Hotchkiss’s 1862 map of the Shenandoah Valley"}],["$","span",null,{"children":"Hotchkiss’s large manuscript map covers the Valley from Winchester to Staunton and records roads, rivers, ridges, and residents in exceptional detail. It is a primary cartographic source, but it is not a phase map of the McDowell operation and does not extend far enough west to show the battlefield."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep145-hotchkiss-shenandoah-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99446754/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
2e:["$","$L2d",null,{"seconds":407,"label":"6:47"}]
2f:["$","div",null,{"children":[["$","h3",null,{"children":"Ewell gives Jackson another option"}],["$","p",null,{"children":"Richard S. Ewell’s division, about 8,500 strong and east of the Blue Ridge, could reinforce Jackson or help protect the Confederate line toward Richmond."}]]}]
30:["$","div","Lee favors mobility and concentration",{"className":"moment","children":[["$","$L2d",null,{"seconds":435,"label":"7:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee favors mobility and concentration"}],["$","p",null,{"children":"From Richmond, Robert E. Lee judged that Jackson’s location preserved freedom of maneuver and the possibility of uniting with Ewell while McClellan threatened the capital."}]]}]]}]
31:["$","div","Lee’s limited authority is noted",{"className":"moment","children":[["$","$L2d",null,{"seconds":493,"label":"8:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s limited authority is noted"}],["$","p",null,{"children":"The hosts describe Lee as Jefferson Davis’s senior military adviser rather than a field army commander. He could strongly recommend operations, but the command structure remained complicated."}]]}]]}]
32:["$","div","Lee links Valley action to Fredericksburg",{"className":"moment","children":[["$","$L2d",null,{"seconds":507,"label":"8:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee links Valley action to Fredericksburg"}],["$","p",null,{"children":"His April 21 communication emphasized that McDowell’s force at Fredericksburg threatened Richmond and that any removal of Banks’s troops from the Valley could strengthen that advance."}]]}]]}]
33:["$","div","Jackson proposes three offensive plans",{"className":"moment","children":[["$","$L2d",null,{"seconds":552,"label":"9:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson proposes three offensive plans"}],["$","p",null,{"children":"On April 29 he offered alternatives to Lee. Jackson preferred leaving Ewell to watch Banks while joining Edward Johnson to attack Milroy before Frémont could concentrate."}]]}]]}]
34:["$","div","Lee leaves the choice to Jackson",{"className":"moment","children":[["$","$L2d",null,{"seconds":646,"label":"10:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee leaves the choice to Jackson"}],["$","p",null,{"children":"The May 1 reply authorized Jackson to select among the three plans. Jackson had already begun putting his preferred general concept into motion."}]]}]]}]
35:["$","div","Ewell is summoned to Swift Run Gap",{"className":"moment","children":[["$","$L2d",null,{"seconds":673,"label":"11:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell is summoned to Swift Run Gap"}],["$","p",null,{"children":"Jackson met Ewell on April 29 and again on April 30. Ewell learned that he would replace Jackson near the gap while Jackson moved toward Staunton."}]]}]]}]
36:["$","div","How much Ewell knew remains uncertain",{"className":"moment","children":[["$","$L2d",null,{"seconds":702,"label":"11:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"How much Ewell knew remains uncertain"}],["$","p",null,{"children":"The episode states that Jackson discussed the Banks threat only in general terms. Ewell was unsure whom Jackson meant to attack and did not yet have confidence in him."}]]}]]}]
37:["$","div","The episode pauses for an Ewell profile",{"className":"moment","children":[["$","$L2d",null,{"seconds":763,"label":"12:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode pauses for an Ewell profile"}],["$","p",null,{"children":"The hosts describe the 45-year-old West Point graduate as experienced, eccentric, profane, personally modest, and respected by his men. The automated transcript repeatedly renders his surname as “Yule.”"}]]}]]}]
38:["$","div","Ewell reaches Jackson’s empty camps",{"className":"moment","children":[["$","$L2d",null,{"seconds":989,"label":"16:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell reaches Jackson’s empty camps"}],["$","p",null,{"children":"On the evening of April 30 Ewell’s men crossed the Blue Ridge expecting to meet the Valley force, but Jackson had already departed and disclosed little about his destination."}]]}]]}]
39:["$","div","Jackson starts the circuitous march",{"className":"moment","children":[["$","$L2d",null,{"seconds":1073,"label":"17:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson starts the circuitous march"}],["$","p",null,{"children":"The Valley force left Elk Run Valley for Port Republic, intending to cross Brown’s Gap and reach the Virginia Central Railroad at Mechum’s Station."}]]}]]}]
3a:["$","div","Rain destroys the timetable",{"className":"moment","children":[["$","$L2d",null,{"seconds":1109,"label":"18:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rain destroys the timetable"}],["$","p",null,{"children":"Torrential rain turned the unimproved road to Port Republic into deep mud. Jackson and his staff covered 13 miles, but much of the army managed only about five."}]]}]]}]
3b:["$","div","A 10th Virginia private records the strain",{"className":"moment","children":[["$","$L2d",null,{"seconds":1159,"label":"19:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"A 10th Virginia private records the strain"}],["$","p",null,{"children":"Joseph Coffman wrote that Jackson was a hard master, that his feet had failed, and that he wished peace would be declared. The diary entry anchors the march in a soldier’s immediate experience."}]]}]]}]
3c:["$","div","The artillery and trains fall behind",{"className":"moment","children":[["$","$L2d",null,{"seconds":1217,"label":"20:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The artillery and trains fall behind"}],["$","p",null,{"children":"Wind and rain continued on May 1. Some infantry reached Port Republic by nightfall, but the guns and wagons remained stretched out on the road."}]]}]]}]
3d:["$","div","The weather finally clears",{"className":"moment","children":[["$","$L2d",null,{"seconds":1244,"label":"20:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The weather finally clears"}],["$","p",null,{"children":"The force continued struggling on May 2; sunshine returned late that day, and May 3 opened clear."}]]}]]}]
3e:["$","div","The column crosses Brown’s Gap",{"className":"moment","children":[["$","$L2d",null,{"seconds":1253,"label":"20:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"The column crosses Brown’s Gap"}],["$","p",null,{"children":"On May 3 the exhausted force passed over the Blue Ridge and reached Mechum’s Station by evening on a dry turnpike."}]]}]]}]
3f:["$","div","Federal officers infer Jackson’s purpose",{"className":"moment","children":[["$","$L2d",null,{"seconds":1270,"label":"21:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal officers infer Jackson’s purpose"}],["$","p",null,{"children":"The episode says Alpheus Williams concluded by the afternoon of May 2 that Jackson was moving to join Edward Johnson; Banks agreed."}]]}]]}]
40:["$","div","Lincoln orders Banks back",{"className":"moment","children":[["$","$L2d",null,{"seconds":1318,"label":"21:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln orders Banks back"}],["$","p",null,{"children":"On May 1 Washington instructed Banks to withdraw down the Valley toward Strasburg, accepting his report that the forward mission was finished."}]]}]]}]
41:["$","div","Shields is detached toward Fredericksburg",{"className":"moment","children":[["$","$L2d",null,{"seconds":1330,"label":"22:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shields is detached toward Fredericksburg"}],["$","p",null,{"children":"Orders on May 2 sent Shields’s division east to join McDowell, leaving Banks with substantially less strength in the Valley."}]]}]]}]
42:["$","div","The trains turn west",{"className":"moment","children":[["$","$L2d",null,{"seconds":1373,"label":"22:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"The trains turn west"}],["$","p",null,{"children":"Soldiers who thought they were leaving the Valley for Richmond discovered that the railroad cars were carrying them back through the Blue Ridge toward Staunton."}]]}]]}]
43:["$","div","Jackson reaches Staunton",{"className":"moment","children":[["$","$L2d",null,{"seconds":1393,"label":"23:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson reaches Staunton"}],["$","p",null,{"children":"He arrived on May 4 and reassured residents who had heard rumors that his army was abandoning the Valley. The automated transcript incorrectly renders Staunton as “Danton” here."}]]}]]}]
44:["$","div","Ashby closes the town",{"className":"moment","children":[["$","$L2d",null,{"seconds":1416,"label":"23:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ashby closes the town"}],["$","p",null,{"children":"Jackson ordered Turner Ashby’s cavalry to restrict movement into and out of Staunton in an attempt to conceal the concentration."}]]}]]}]
45:["$","div","The Valley force is assembled",{"className":"moment","children":[["$","$L2d",null,{"seconds":1429,"label":"23:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Valley force is assembled"}],["$","p",null,{"children":"By the evening of May 5 most units had arrived by rail, while some had completed the trip on foot."}]]}]]}]
46:["$","div","The VMI cadets arrive",{"className":"moment","children":[["$","$L2d",null,{"seconds":1447,"label":"24:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"The VMI cadets arrive"}],["$","p",null,{"children":"About 200 cadets came to Staunton with engineer Thomas H. Williamson and were attached temporarily to the Stonewall Brigade for support service."}]]}]]}]
47:["$","div","Jackson and Johnson advance west",{"className":"moment","children":[["$","$L2d",null,{"seconds":1506,"label":"25:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson and Johnson advance west"}],["$","p",null,{"children":"At dawn on May 7 the combined force left Staunton on the Staunton–Parkersburg Turnpike, with Edward Johnson’s men leading."}]]}]]}]
48:["$","div","Johnson reaches Milroy’s pickets",{"className":"moment","children":[["$","$L2d",null,{"seconds":1518,"label":"25:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnson reaches Milroy’s pickets"}],["$","p",null,{"children":"The Confederate advance encountered Federal outposts at Rogers Tollgate, near the foot of Shenandoah Mountain and about 13 miles east of McDowell."}]]}]]}]
49:["$","div","Milroy recognizes the concentration",{"className":"moment","children":[["$","$L2d",null,{"seconds":1531,"label":"25:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Milroy recognizes the concentration"}],["$","p",null,{"children":"Scouts told him that Jackson and Johnson had united and were moving against his brigade."}]]}]]}]
4a:["$","div","Milroy asks Schenck for help",{"className":"moment","children":[["$","$L2d",null,{"seconds":1539,"label":"25:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Milroy asks Schenck for help"}],["$","p",null,{"children":"He sent word to Robert C. Schenck, whose brigade was at Franklin roughly 30 miles from McDowell."}]]}]]}]
4b:["$","div","Milroy falls back to McDowell",{"className":"moment","children":[["$","$L2d",null,{"seconds":1555,"label":"25:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Milroy falls back to McDowell"}],["$","p",null,{"children":"Expecting Schenck to reinforce him, Milroy withdrew his command from the forward positions and concentrated near the town."}]]}]]}]
4c:["$","div","The Confederates camp short of town",{"className":"moment","children":[["$","$L2d",null,{"seconds":1562,"label":"26:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederates camp short of town"}],["$","p",null,{"children":"On the night of May 7 Johnson camped at Shaw’s Fork, about six miles east of McDowell, while Jackson remained farther back near Buffalo Gap."}]]}]]}]
4d:["$","div","The stage is set for May 8",{"className":"moment","children":[["$","$L2d",null,{"seconds":1572,"label":"26:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"The stage is set for May 8"}],["$","p",null,{"children":"The episode stops before the Battle of McDowell. No leader death or mortal wound occurs within this installment’s narrative scope."}]]}]]}]
4e:["$","strong",null,{"children":"Valley District and Valley force"}]
4f:["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}]
50:["$","small",null,{"children":"Chose the movement toward Edward Johnson, shifted through Mechum’s Station and Staunton, and directed the combined advance toward Milroy"}]
51:["$","div","Army of the Northwest detachment west of Staunton",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Northwest detachment west of Staunton"}],["$","span",null,{"children":"Brig. Gen. Edward “Allegheny” Johnson"}],["$","small",null,{"children":"About 2,800 men in two brigades; joined Jackson at Staunton and led the May 7 advance along the turnpike"}]]}]
52:["$","div","Division east of the Blue Ridge",{"className":"command-entry","children":[["$","strong",null,{"children":"Division east of the Blue Ridge"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Moved to Swift Run Gap and occupied Jackson’s vacated position to watch Banks while Jackson operated west of Staunton"}]]}]
53:["$","div","7th Virginia Cavalry and attached mounted forces",{"className":"command-entry","children":[["$","strong",null,{"children":"7th Virginia Cavalry and attached mounted forces"}],["$","span",null,{"children":"Col. Turner Ashby"}],["$","small",null,{"children":"Screened Confederate movements and restricted access to Staunton during the concentration"}]]}]
54:["$","div","Virginia Military Institute cadet detachment",{"className":"command-entry","children":[["$","strong",null,{"children":"Virginia Military Institute cadet detachment"}],["$","span",null,{"children":"Col. Francis H. Smith / Col. Thomas H. Williamson"}],["$","small",null,{"children":"About 200 cadets sent from Lexington; temporarily attached to the Stonewall Brigade for noncombat field service, with Williamson valued as an engineer"}]]}]
55:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
56:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Thomas J. “Stonewall” Jackson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-stonewall-jackson.jpg","alt":"Portrait of Thomas J. “Stonewall” Jackson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Valley commander who used Swift Run Gap as a concealed base, shifted his force by road and rail to Staunton, joined Edward Johnson, and advanced on Milroy"}]]}]]}],["$","article","Richard S. Ewell",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-richard-ewell.jpg","alt":"Portrait of Richard S. Ewell","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Richard S. Ewell"}],["$","p",null,{"children":"Division commander ordered into Jackson’s former camps near Swift Run Gap to watch Banks while Jackson moved against Milroy; the transcript mistranscribes his name as “Yule”"}]]}]]}],["$","article","Edward “Allegheny” Johnson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-edward-johnson.jpg","alt":"Portrait of Edward “Allegheny” Johnson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Edward “Allegheny” Johnson"}],["$","p",null,{"children":"Commander of the Confederate force west of Staunton who joined Jackson and led the combined column toward McDowell on May 7"}]]}]]}],["$","article","Robert H. Milroy",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep145-robert-milroy.jpg","alt":"Portrait of Robert H. Milroy","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Robert H. Milroy"}],["$","p",null,{"children":"Frémont’s advance commander whose pressure had forced Johnson toward Staunton; he withdrew to McDowell and summoned Schenck when Jackson approached"}]]}]]}],["$","article","Nathaniel P. Banks",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"NP"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Nathaniel P. Banks"}],["$","p",null,{"children":"Department commander who advanced to Harrisonburg, lost Jackson’s trail, and reported that the Valley mission was complete"}]]}]]}],["$","article","Robert E. Lee",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"RE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Robert E. Lee"}],["$","p",null,{"children":"Military adviser to Jefferson Davis who encouraged offensive action and left Jackson to choose among his proposed plans"}]]}]]}],["$","article","Joseph E. Johnston",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Joseph E. Johnston"}],["$","p",null,{"children":"Senior Confederate field commander responsible for the defense of Richmond and the detached forces in the Valley and Rappahannock regions"}]]}]]}],["$","article","John C. Frémont",{"className":"p