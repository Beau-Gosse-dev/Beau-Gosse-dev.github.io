d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",475," · ","April 7–25, 1864"," · ","Red River and Cane River corridor from Loggy Bayou and Grand Ecore to Alexandria, Louisiana"]}],["$","h1",null,{"children":"RED RIVER CAMPAIGN (Part the Ninth)"}],["$","span",null,{"className":"result-label","children":"After Banks’s defeats at Mansfield and Pleasant Hill, Porter abandoned the advance toward Shreveport and brought his fleet back to Grand Ecore under repeated attack. The gunboat Eastport struck a mine and was later destroyed when it could not be freed. Banks left Grand Ecore on April 21. At Monett’s Ferry, Emory used an unguarded ford to send Birge’s brigade behind Hamilton Bee’s blocking force, which withdrew and opened the road to Alexandria. The last Union troops crossed on April 24 and the head of the column reached Alexandria on April 25, but low water trapped much of Porter’s fleet above the city"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 7–25, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Red River and Cane River corridor from Loggy Bayou and Grand Ecore to Alexandria, Louisiana"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"After Banks’s defeats at Mansfield and Pleasant Hill, Porter abandoned the advance toward Shreveport and brought his fleet back to Grand Ecore under repeated attack. The gunboat Eastport struck a mine and was later destroyed when it could not be freed. Banks left Grand Ecore on April 21. At Monett’s Ferry, Emory used an unguarded ford to send Birge’s brigade behind Hamilton Bee’s blocking force, which withdrew and opened the road to Alexandria. The last Union troops crossed on April 24 and the head of the column reached Alexandria on April 25, but low water trapped much of Porter’s fleet above the city"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":["$Lf","$L10","$L11"]}],"$L12"]}],"$undefined"]}],"$L13","$L14","$L15",false,"$L16","$L17","$L18","$L19","$L1a","$L1b"]}]]}]
