1b:["$","div","John Warner grounded",{"className":"moment","children":[["$","$L17",null,{"seconds":915,"label":"15:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"John Warner grounded"}],["$","p",null,{"children":"The supply ship could not be freed on April 13. Fort Hindman stayed behind until it pulled the vessel loose on April 15."}]]}]]}]
