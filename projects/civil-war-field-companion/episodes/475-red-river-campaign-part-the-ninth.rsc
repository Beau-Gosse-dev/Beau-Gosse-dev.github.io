1e:["$","div","Banks retained A. J. Smith’s troops",{"className":"moment","children":[["$","$L17",null,{"seconds":1118,"label":"18:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks retained A. J. Smith’s troops"}],["$","p",null,{"children":"Sherman demanded their return for the Atlanta campaign, but Banks used his seniority to keep them in Louisiana."}]]}]]}]
