12:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2024/11/24/civil-war-podcast-episode-475/",{"href":"https://civilwarpodcast.org/2024/11/24/civil-war-podcast-episode-475/","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 475"]}],["$","a","https://www.loc.gov/item/2008626486/",{"href":"https://www.loc.gov/item/2008626486/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Red River campaign map"]}],["$","a","https://www.nps.gov/civilwar/louisiana.htm",{"href":"https://www.nps.gov/civilwar/louisiana.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Louisiana Civil War operations"]}],["$","a","https://www.loc.gov/exhibits/civil-war-in-america/biographies/david-dixon-porter.html",{"href":"https://www.loc.gov/exhibits/civil-war-in-america/biographies/david-dixon-porter.html","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: David Dixon Porter"]}],["$","a","https://www.loc.gov/item/2018666550/",{"href":"https://www.loc.gov/item/2018666550/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Richard Taylor portrait"]}]]}]
