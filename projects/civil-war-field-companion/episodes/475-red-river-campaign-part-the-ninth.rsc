n":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"TK"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"T. Kilby Smith"}],["$","p",null,{"children":"Commanded the troops protecting the army transports"}]]}]]}],["$","article","Nathaniel P. Banks",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/nathaniel-p-banks.jpg","alt":"Portrait of Nathaniel P. Banks","width":420,"height":520,"loading":"lazy"}],"$L2e"]}],"$L2f","$L30","$L31","$L32"]}]]}]
