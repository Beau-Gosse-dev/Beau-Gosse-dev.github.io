20:["$","div","The army and fleet committed to Alexandria",{"className":"moment","children":[["$","$L17",null,{"seconds":1268,"label":"21:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army and fleet committed to Alexandria"}],["$","p",null,{"children":"Porter said falling water made a naval withdrawal unavoidable. Banks then said the army could not advance without naval support."}]]}]]}]
21:["$","div","Eastport struck a mine",{"className":"moment","children":[["$","$L17",null,{"seconds":1298,"label":"21:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Eastport struck a mine"}],["$","p",null,{"children":"The ironclad hit a Confederate mine on April 16, was refloated five days later, and grounded again near Montgomery."}]]}]]}]
22:["$","div","Porter destroyed Eastport",{"className":"moment","children":[["$","$L17",null,{"seconds":1381,"label":"23:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Porter destroyed Eastport"}],["$","p",null,{"children":"With water falling at Alexandria, he abandoned and blew up the immobilized ironclad on April 26 rather than delay the fleet further."}]]}]]}]
23:["$","div","Confederate artillery attacked the remaining ships",{"className":"moment","children":[["$","$L17",null,{"seconds":1400,"label":"23:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate artillery attacked the remaining ships"}],["$","p",null,{"children":"At the Cane River mouth a battery sank one support vessel, disabled another, and hit Cricket thirty-eight times, causing twenty-five casualties."}]]}]]}]
24:["$","div","Low water trapped the fleet at Alexandria",{"className":"moment","children":[["$","$L17",null,{"seconds":1463,"label":"24:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Low water trapped the fleet at Alexandria"}],["$","p",null,{"children":"The river had fallen six feet, leaving most vessels unable to pass the rapids below town."}]]}]]}]
25:["$","div","Banks left Grand Ecore on April 21",{"className":"moment","children":[["$","$L17",null,{"seconds":1505,"label":"25:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks left Grand Ecore on April 21"}],["$","p",null,{"children":"His column marched south along Cane River while Porter’s vessels used the roughly parallel Red River channel."}]]}]]}]
