e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Grand Ecore, the Red River, and Alexandria"}],["$","span",null,{"children":"Porter moved upriver from Grand Ecore toward Loggy Bayou, reversed course after learning of Banks’s defeat, and then followed the Red River back toward Alexandria."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
f:["$","figure","Monett’s Ferry flank",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/monetts-ferry-tactical-map.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Monett’s Ferry flank at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/monetts-ferry-tactical-map.svg","alt":"Schematic battle map of the Union flanking movement at Monett’s Ferry","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Monett’s Ferry flank"}],["$","span",null,{"children":"Hamilton Bee blocked the ferry from a wooded bluff. Emory demonstrated at the crossing while Henry Birge’s brigade used an unguarded ford about two miles away and approached the Confederate rear."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/monetts-ferry-tactical-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/civilwar/louisiana.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
10:["$","figure","The Red River campaign route",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/red-river-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The Red River campaign route at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/red-river-campaign-1864-map.jpg","alt":"Historical map of the Red River campaign in 1864","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Red River campaign route"}],["$","span",null,{"children":"The period map shows the campaign corridor between Alexandria and Shreveport, including Mansfield and Pleasant Hill. The Red and Cane Rivers constrained both Union withdrawal routes."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/red-river-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/2008626486/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The narrative returned to Louisiana",{"className":"moment","children":[["$","$L17",null,{"seconds":78,"label":"1:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The narrative returned to Louisiana"}],["$","p",null,{"children":"Banks and Porter were both withdrawing after the April 8 defeat at Mansfield and the April 9 fighting at Pleasant Hill."}]]}]]}],["$","div","Porter had left Grand Ecore on April 7",{"className":"moment","children":[["$","$L17",null,{"seconds":124,"label":"2:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Porter had left Grand Ecore on April 7"}],["$","p",null,{"children":"He selected shallow-draft, heavily armed vessels for the final approach toward Shreveport because the Red River was falling, narrow, and sharply curved."}]]}]]}],["$","div","The fleet escorted army transports",{"className":"moment","children":[["$","$L17",null,{"seconds":251,"label":"4:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The fleet escorted army transports"}],["$","p",null,{"children":"About twenty transports carried supplies and roughly 1,600 XVII Corps soldiers under T. Kilby Smith. The transports were armed and protected with cotton bales and sacks of oats."}]]}]]}],["$","div","Low water delayed the movement",{"className":"moment","children":[["$","$L17",null,{"seconds":292,"label":"4:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Low water delayed the movement"}],["$","p",null,{"children":"Iberville ran aground on April 8. Confederates had reduced the river’s flow by destroying the Tone’s Bayou dam on March 18."}]]}]]}],["$","div","Poor maps left Porter uncertain of his position",{"className":"moment","children":[["$","$L17",null,{"seconds":370,"label":"6:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Poor maps left Porter uncertain of his position"}],["$","p",null,{"children":"Federal charts misplaced and misnamed waterways near Loggy Bayou and Springfield Landing."}]]}]]}],["$","div","A scuttled steamer blocked the river",{"className":"moment","children":[["$","$L17",null,{"seconds":439,"label":"7:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"A scuttled steamer blocked the river"}],["$","p",null,{"children":"Confederates placed New Falls City across the channel, preventing the fleet from continuing toward Shreveport."}]]}]]}],["$","div","Kilby Smith secured the riverbank",{"className":"moment","children":[["$","$L17",null,{"seconds":494,"label":"8:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kilby Smith secured the riverbank"}],["$","p",null,{"children":"The growing Confederate presence convinced Porter that Banks had probably been defeated."}]]}]]}],["$","div","The fleet learned of Banks’s retreat",{"className":"moment","children":[["$","$L17",null,{"seconds":537,"label":"8:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The fleet learned of Banks’s retreat"}],["$","p",null,{"children":"William Andres and fifty cavalrymen reported the fighting at Mansfield and Pleasant Hill and ordered Kilby Smith back to Grand Ecore."}]]}]]}],["$","div","The vessels immediately turned back",{"className":"moment","children":[["$","$L17",null,{"seconds":579,"label":"9:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The vessels immediately turned back"}],["$","p",null,{"children":"Porter expected Confederate cavalry and artillery to attack the fleet along the confined river."}]]}]]}],["$","div","Large ships had to back downstream",{"className":"moment","children":[["$","$L17",null,{"seconds":643,"label":"10:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Large ships had to back downstream"}],["$","p",null,{"children":"The channel was too narrow for them to turn. Snags, grounding, damaged steering gear, and continuous musket fire slowed the withdrawal."}]]}]]}],["$","div","The fleet reached Blair’s Landing",{"className":"moment","children":[["$","$L17",null,{"seconds":717,"label":"11:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The fleet reached Blair’s Landing"}],["$","p",null,{"children":"On April 12, about 2,500 Texas cavalrymen under Tom Green attacked from concealed positions supported by four artillery pieces."}]]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d"]}]]}]
