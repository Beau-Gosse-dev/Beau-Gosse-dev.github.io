1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",475," · ","April 7–25, 1864"," · ","Red River and Cane River corridor from Loggy Bayou and Grand Ecore to Alexandria, Louisiana"]}],["$","h1",null,{"children":"RED RIVER CAMPAIGN (Part the Ninth)"}],["$","span",null,{"className":"result-label","children":"After Banks’s defeats at Mansfield and Pleasant Hill, Porter abandoned the advance toward Shreveport and brought his fleet back to Grand Ecore under repeated attack. The gunboat Eastport struck a mine and was later destroyed when it could not be freed. Banks left Grand Ecore on April 21. At Monett’s Ferry, Emory used an unguarded ford to send Birge’s brigade behind Hamilton Bee’s blocking force, which withdrew and opened the road to Alexandria. The last Union troops crossed on April 24 and the head of the column reached Alexandria on April 25, but low water trapped much of Porter’s fleet above the city"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffi