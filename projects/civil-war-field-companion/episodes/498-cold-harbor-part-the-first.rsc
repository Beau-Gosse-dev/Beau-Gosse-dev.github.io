","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.72%2C37.48%2C-76.95%2C37.83&layer=mapnik&marker=37.5892%2C-77.2886","title":"Cold Harbor, White House Landing, and Richmond","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Cold Harbor, White House Landing, and Richmond"}],["$","span",null,{"children":"Smith’s XVIII Corps landed on the Pamunkey River at White House Landing and marched toward Cold Harbor. The crossroads stood between the U.S. supply base and the southeastern approaches to Richmond."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}],["$","figure","The southeastern turn of the Overland campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The southeastern turn of the Overland campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of Grant’s Overland campaign route toward Richmond and Petersburg","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The southeastern turn of the Overland campaign"}],["$","span",null,{"children":"After the North Anna and Totop