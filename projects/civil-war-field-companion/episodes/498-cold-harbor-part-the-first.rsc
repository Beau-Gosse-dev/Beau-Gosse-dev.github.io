16:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
18:["$","p",null,{"children":"Four North Carolina regiments reinforced the Confederate left shortly before U.S. cavalry attacked about 4 p.m. on May 31."}]
19:["$","div","Merritt and Custer attacked dismounted",{"className":"moment","children":[["$","$L17",null,{"seconds":630,"label":"10:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Merritt and Custer attacked dismounted"}],["$","p",null,{"children":"Two of Torbert’s brigades advanced with Sharps carbines and Spencer repeaters. The first attack identified the Confederate line and the presence of infantry."}]]}]]}]
1a:["$","div","Merritt turned the Confederate flank",{"className":"moment","children":[["$","$L17",null,{"seconds":669,"label":"11:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Merritt turned the Confederate flank"}],["$","p",null,{"children":"Part of his brigade held the front while other troopers moved around Clingman’s exposed and poorly placed North Carolinians."}]]}]]}]
1b:["$","div","The 51st North Carolina was isolated",{"className":"moment","children":[["$","$L17",null,{"seconds":723,"label":"12:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 51st North Carolina was isolated"}],["$","p",null,{"children":"Placed about 500 yards ahead of the main line, the regiment was outflanked. Clingman was with it and could not direct the rest of his brigade."}]]}]]}]
1c:["$","div","The Confederate position collapsed",{"className":"moment","children":[["$","$L17",null,{"seconds":758,"label":"12:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate position collapsed"}],["$","p",null,{"children":"Clingman’s brigade broke, Fitzhugh Lee withdrew, and Custer’s mounted charge accelerated the retreat."}]]}]]}]
1d:["$","div","U.S. cavalry held the crossroads",{"className":"moment","children":[["$","$L17",null,{"seconds":797,"label":"13:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. cavalry held the crossroads"}],["$","p",null,{"children":"Merritt and Custer had driven away four Confederate brigades with two U.S. brigades; Thomas Devin’s brigade did not join the attack."}]]}]]}]
1e:["$","div","Sheridan briefly abandoned Cold Harbor",{"className":"moment","children":[["$","$L17",null,{"seconds":845,"label":"14:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sheridan briefly abandoned Cold Harbor"}],["$","p",null,{"children":"Reports of more Confederate infantry and the distance to U.S. infantry support led Sheridan to order Torbert out after dark."}]]}]]}]
1f:["$","div","Wright received orders to march",{"className":"moment","children":[["$","$L17",null,{"seconds":1011,"label":"16:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wright received orders to march"}],["$","p",null,{"children":"At 9:45 p.m. on May 31, VI Corps left the Totopotomoy line for Cold Harbor."}]]}]]}]
20:["$","div","Lee prepared an ambush",{"className":"moment","children":[["$","$L17",null,{"seconds":1055,"label":"17:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee prepared an ambush"}],["$","p",null,{"children":"Richard Anderson’s First Corps marched toward Cold Harbor to join Hoke, clear the crossroads, and strike Smith’s column while it was stretched along the roads."}]]}]]}]
21:["$","div","Meade ordered Sheridan back",{"className":"moment","children":[["$","$L17",null,{"seconds":1123,"label":"18:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade ordered Sheridan back"}],["$","p",null,{"children":"Sheridan received the order about 1 a.m. and reoccupied the crossroads two hours later before the Confederates realized it had been vacant."}]]}]]}]
22:["$","div","Kershaw’s division reached the area first",{"className":"moment","children":[["$","$L17",null,{"seconds":1205,"label":"20:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kershaw’s division reached the area first"}],["$","p",null,{"children":"Only Kershaw’s troops were ready to attack at dawn. Hoke was supposed to advance when he heard the firing."}]]}]]}]
23:["$","div","About 10,000 Confederates faced 5,000 cavalrymen",{"className":"moment","children":[["$","$L17",null,{"seconds":1249,"label":"20:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"About 10,000 Confederates faced 5,000 cavalrymen"}],["$","p",null,{"children":"Kershaw and Hoke had roughly twice Sheridan’s manpower, but the U.S. cavalry had earthworks and repeating carbines."}]]}]]}]
24:["$","div","The Confederate attack failed quickly",{"className":"moment","children":[["$","$L17",null,{"seconds":1262,"label":"21:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate attack failed quickly"}],["$","p",null,{"children":"Lawrence Keitt advanced without skirmishers. Merritt’s dismounted cavalry held fire until close range and then broke the attack with rapid carbine fire."}]]}]]}]
25:["$","div","A second advance also failed",{"className":"moment","children":[["$","$L17",null,{"seconds":1332,"label":"22:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"A second advance also failed"}],["$","p",null,{"children":"Kershaw’s men regrouped but were repulsed again. Wright’s infantry then arrived and secured Sheridan’s position."}]]}]]}]
26:["$","div","The operation had begun as a reconnaissance",{"className":"moment","children":[["$","$L17",null,{"seconds":1382,"label":"23:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The operation had begun as a reconnaissance"}],["$","p",null,{"children":"Anderson ordered a reconnaissance in force rather than the coordinated attack Lee expected. Kershaw assigned it to Keitt’s inexperienced brigade."}]]}]]}]
27:["$","div","Keitt was mortally wounded",{"className":"moment","children":[["$","$L17",null,{"seconds":1461,"label":"24:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Keitt was mortally wounded"}],["$","p",null,{"children":"He rode conspicuously ahead of the formation and was hit by the first U.S. volley. His 20th South Carolina then collapsed under its first major combat."}]]}]]}]
28:["$","div","Hoke did not advance",{"className":"moment","children":[["$","$L17",null,{"seconds":1510,"label":"25:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hoke did not advance"}],["$","p",null,{"children":"The signal and coordination arrangements failed. Hoke remained in place, Kershaw did not renew the attack, and Anderson’s later arrivals began entrenching."}]]}]]}]
29:["$","div","Lee’s counterstroke ended",{"className":"moment","children":[["$","$L17",null,{"seconds":1565,"label":"26:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s counterstroke ended"}],["$","p",null,{"children":"By late morning on June 1, the Confederate effort to recover Cold Harbor and attack the U.S. turning movement had failed."}]]}]]}]
