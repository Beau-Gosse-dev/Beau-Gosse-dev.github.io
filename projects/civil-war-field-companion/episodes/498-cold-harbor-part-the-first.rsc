f:["$","figure","Cold Harbor, White House Landing, and Richmond",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.72%2C37.48%2C-76.95%2C37.83&layer=mapnik&marker=37.5892%2C-77.2886","title":"Cold Harbor, White House Landing, and Richmond","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Cold Harbor, White House Landing, and Richmond"}],["$","span",null,{"children":"Smith’s XVIII Corps landed on the Pamunkey River at White House Landing and marched toward Cold Harbor. The crossroads stood between the U.S. supply base and the southeastern approaches to Richmond."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
10:["$","figure","The southeastern turn of the Overland campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The southeastern turn of the Overland campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of Grant’s Overland campaign route toward Richmond and Petersburg","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The southeastern turn of the Overland campaign"}],["$","span",null,{"children":"After the North Anna and Totopotomoy operations, Grant continued around Lee’s right. Cold Harbor lay on the route toward the lower Chickahominy crossings."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Grant continued southeast after each battle",{"className":"moment","children":[["$","$L17",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant continued southeast after each battle"}],["$","p",null,{"children":"The Overland campaign did not end at the Wilderness, Spotsylvania, or the North Anna. Grant repeatedly moved around Lee’s right flank."}]]}]]}],["$","div","The armies fought along Totopotomoy Creek",{"className":"moment","children":[["$","$L17",null,{"seconds":159,"label":"2:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies fought along Totopotomoy Creek"}],["$","p",null,{"children":"By May 30, Lee’s lines appeared too costly to attack directly, and Early’s attempt to strike Warren near Bethesda Church had failed."}]]}]]}],["$","div","Confederate cavalry probed near Old Cold Harbor",{"className":"moment","children":[["$","$L17",null,{"seconds":198,"label":"3:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate cavalry probed near Old Cold Harbor"}],["$","p",null,{"children":"Matthew Butler’s mounted brigade moved toward Matadequin Creek and met Alfred Torbert’s U.S. cavalry protecting the route to White House Landing."}]]}]]}],["$","div","Torbert drove Butler back",{"className":"moment","children":[["$","$L17",null,{"seconds":230,"label":"3:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Torbert drove Butler back"}],["$","p",null,{"children":"Three U.S. brigades forced Butler’s single brigade away from the creek and pursued it toward Old Cold Harbor."}]]}]]}],["$","div","Grant chose another turning movement",{"className":"moment","children":[["$","$L17",null,{"seconds":274,"label":"4:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant chose another turning movement"}],["$","p",null,{"children":"He planned to move beyond Lee’s right with William F. Smith’s XVIII Corps leading from White House Landing."}]]}]]}],["$","div","Sheridan received orders to clear the route",{"className":"moment","children":[["$","$L17",null,{"seconds":305,"label":"5:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sheridan received orders to clear the route"}],["$","p",null,{"children":"Grant directed Sheridan to move cavalry from the U.S. left toward Cold Harbor and open the way for Smith."}]]}]]}],["$","div","XVIII Corps began landing",{"className":"moment","children":[["$","$L17",null,{"seconds":334,"label":"5:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"XVIII Corps began landing"}],["$","p",null,{"children":"About 10,000 men, with more following, disembarked at White House Landing after leaving the Bermuda Hundred lines."}]]}]]}],["$","div","Lee requested reinforcements from Beauregard",{"className":"moment","children":[["$","$L17",null,{"seconds":367,"label":"6:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee requested reinforcements from Beauregard"}],["$","p",null,{"children":"Lee warned Jefferson Davis of possible disaster. Beauregard then sent Robert Hoke’s division from Bermuda Hundred."}]]}]]}],["$","div","Both commands focused on Cold Harbor",{"className":"moment","children":[["$","$L17",null,{"seconds":444,"label":"7:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Both commands focused on Cold Harbor"}],["$","p",null,{"children":"The five-road crossroads controlled routes toward the Chickahominy crossings and the next U.S. movement around Lee’s right."}]]}]]}],["$","div","Fitzhugh Lee organized the Confederate defense",{"className":"moment","children":[["$","$L17",null,{"seconds":534,"label":"8:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fitzhugh Lee organized the Confederate defense"}],["$","p",null,{"children":"Butler’s brigade and Fitzhugh Lee’s two cavalry brigades built breastworks across the eastern approaches while waiting for Hoke’s infantry."}]]}]]}],["$","div","Clingman’s brigade arrived",{"className":"moment","children":[["$","$L17",null,{"seconds":617,"label":"10:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Clingman’s brigade arrived"}],"$L18"]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
