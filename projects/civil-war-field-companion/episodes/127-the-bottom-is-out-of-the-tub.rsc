d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",127," · ","July 22, 1861–January 10, 1862"," · ","Washington, D.C.; northern Virginia from Leesburg to Centreville and Manassas Junction; and the Potomac River corridor"]}],["$","h1",null,{"children":"\"THE BOTTOM IS OUT OF THE TUB\""}],["$","span",null,{"className":"result-label","children":"George B. McClellan transformed the forces around Washington into the Army of the Potomac and, after Winfield Scott retired on November 1, also became general-in-chief. He did not begin a major offensive in 1861. Joseph E. Johnston consolidated the principal Confederate army around Centreville and Manassas Junction, while the failed United States crossing at Ball’s Bluff intensified political scrutiny. Congress created the Joint Committee on the Conduct of the War, the Lincoln administration resolved the Trent crisis without war with Britain, and McClellan’s late-December illness left Lincoln confronting both military inactivity and a widening crisis of confidence."}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"July 22, 1861–January 10, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Washington, D.C.; northern Virginia from Leesburg to Centreville and Manassas Junction; and the Potomac River corridor"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"George B. McClellan transformed the forces around Washington into the Army of the Potomac and, after Winfield Scott retired on November 1, also became general-in-chief. He did not begin a major offensive in 1861. Joseph E. Johnston consolidated the principal Confederate army around Centreville and Manassas Junction, while the failed United States crossing at Ball’s Bluff intensified political scrutiny. Congress created the Joint Committee on the Conduct of the War, the Lincoln administration resolved the Trent crisis without war with Britain, and McClellan’s late-December illness left Lincoln confronting both military inactivity and a widening crisis of confidence."}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],"$Lf","$L10","$L11"]}],"$undefined"]}],"$L12","$L13","$L14",false,"$L15","$L16","$L17","$L18","$L19","$L1a"]}]]}]
