10:["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Ball’s Bluff casualties",{"children":[["$","th",null,{"scope":"row","children":"Ball’s Bluff casualties"}],["$","td",null,{"children":["1,070 total",["$","small",null,{"style":{"display":"block"},"children":"NPS estimate: 921 United States and 149 Confederate casualties; more than 700 United States soldiers were captured."}]]}]]}]]}]]}]
11:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2015/10/04/civil-war-podcast-episode-127/",{"href":"https://civilwarpodcast.org/2015/10/04/civil-war-podcast-episode-127/","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast: Episode 127"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/30-21.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/30-21.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: American Military History, volume 1"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va006",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va006","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Ball’s Bluff battle detail"]}],["$","a","https://www.nps.gov/pohe/learn/historyculture/the-civil-war.htm",{"href":"https://www.nps.gov/pohe/learn/historyculture/the-civil-war.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Ball’s Bluff and the Potomac corridor"]}],["$","a","https://www.senate.gov/about/powers-procedures/investigations/joint-committee-conduct-of-war.htm",{"href":"https://www.senate.gov/about/powers-procedures/investigations/joint-committee-conduct-of-war.htm","target":"_blank","rel":"noreferrer","children":[" · ","United States Senate: Joint Committee on the Conduct of the War"]}],["$","a","https://www.senate.gov/about/resources/pdf/jccw-resolution.pdf",{"href":"https://www.senate.gov/about/resources/pdf/jccw-resolution.pdf","target":"_blank","rel":"noreferrer","children":[" · ","United States Senate: Resolution creating the Joint Committee"]}],["$","a","https://history.state.gov/milestones/1861-1865/trent-affair",{"href":"https://history.state.gov/milestones/1861-1865/trent-affair","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Department of State, Office of the Historian: The Trent Affair"]}],["$","a","https://www.nps.gov/people/joseph-e-johnston.htm",{"href":"https://www.nps.gov/people/joseph-e-johnston.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Joseph E. Johnston"]}],["$","a","https://qmmuseum.army.mil/research/history-heritage/history/civil-war/Lincoln-and-His-Quartermaster-General.html",{"href":"https://qmmuseum.army.mil/research/history-heritage/history/civil-war/Lincoln-and-His-Quartermaster-General.html","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Quartermaster Museum: Lincoln and His Quartermaster General"]}],["$","a","https://www.loc.gov/collections/george-brinton-mcclellan-papers/articles-and-essays/timeline/",{"href":"https://www.loc.gov/collections/george-brinton-mcclellan-papers/articles-and-essays/timeline/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: George B. McClellan timeline"]}],["$","a","https://www.loc.gov/item/mss347360179/",{"href":"https://www.loc.gov/item/mss347360179/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: John Hay diary extracts, 1861–1863"]}],["$","a","https://www.loc.gov/item/08010508/",{"href":"https://www.loc.gov/item/08010508/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: McClellan’s official report on the Army of the Potomac"]}],"$L1b","$L1c","$L1d"]}]
