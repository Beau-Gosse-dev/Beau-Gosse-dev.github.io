17:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
19:["$","p",null,{"children":"After retreating from Missionary Ridge, the soldiers entered winter camp in northwestern Georgia with low morale and inadequate supplies."}]
1a:["$","div","Previous commanders had not solved the problem",{"className":"moment","children":[["$","$L18",null,{"seconds":946,"label":"15:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Previous commanders had not solved the problem"}],["$","p",null,{"children":"Albert Sidney Johnston died at Shiloh, Davis removed P. G. T. Beauregard, and Braxton Bragg lost the confidence of many subordinates."}]]}]]}]
1b:["$","div","Hardee declined permanent army command",{"className":"moment","children":[["$","$L18",null,{"seconds":1030,"label":"17:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hardee declined permanent army command"}],["$","p",null,{"children":"William J. Hardee led temporarily after Bragg resigned but told Davis he did not want the position."}]]}]]}]
1c:["$","div","Only Johnston remained a practical choice",{"className":"moment","children":[["$","$L18",null,{"seconds":1066,"label":"17:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Only Johnston remained a practical choice"}],["$","p",null,{"children":"Robert E. Lee could not leave Virginia, and Davis would not restore Beauregard, leaving Joseph E. Johnston."}]]}]]}]
1d:["$","div","Davis and Johnston distrusted each other",{"className":"moment","children":[["$","$L18",null,{"seconds":1133,"label":"18:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis and Johnston distrusted each other"}],["$","p",null,{"children":"They disputed seniority, secrecy, strategy, responsibility for Vicksburg, and the military prospects of the Confederacy."}]]}]]}]
1e:["$","div","Davis appointed Johnston",{"className":"moment","children":[["$","$L18",null,{"seconds":1267,"label":"21:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis appointed Johnston"}],["$","p",null,{"children":"On December 16, Davis ordered him to transfer the Army of Mississippi to Leonidas Polk and take command at Dalton."}]]}]]}]
1f:["$","div","Johnston found fewer than 40,000 men present",{"className":"moment","children":[["$","$L18",null,{"seconds":1343,"label":"22:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston found fewer than 40,000 men present"}],["$","p",null,{"children":"Only about two-thirds were effective. Many lacked shoes and overcoats, rations were poor, scurvy was present, and animals were scarce."}]]}]]}]
20:["$","div","About 30 men deserted each day",{"className":"moment","children":[["$","$L18",null,{"seconds":1410,"label":"23:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"About 30 men deserted each day"}],["$","p",null,{"children":"The army’s condition made the winter offensive expected by Davis impractical."}]]}]]}]
21:["$","div","Johnston proposed a defensive opening",{"className":"moment","children":[["$","$L18",null,{"seconds":1437,"label":"23:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston proposed a defensive opening"}],["$","p",null,{"children":"He told Davis that the army first had to defeat a U.S. advance before it could move forward."}]]}]]}]
22:["$","div","Davis requested another condition report",{"className":"moment","children":[["$","$L18",null,{"seconds":1501,"label":"25:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis requested another condition report"}],["$","p",null,{"children":"James Seddon obtained details from Johnston, but the new report did not resolve the disagreement."}]]}]]}]
23:["$","div","Johnston made food supply the first priority",{"className":"moment","children":[["$","$L18",null,{"seconds":1573,"label":"26:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston made food supply the first priority"}],["$","p",null,{"children":"He warned Richmond and Georgia governor Joseph E. Brown that inadequate railroad deliveries might force the army to retreat."}]]}]]}]
24:["$","div","Railroad deliveries improved",{"className":"moment","children":[["$","$L18",null,{"seconds":1633,"label":"27:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Railroad deliveries improved"}],["$","p",null,{"children":"By January 25, additional locomotives and cars allowed the army to meet daily needs and begin stockpiling rations."}]]}]]}]
25:["$","div","Training and discipline resumed",{"className":"moment","children":[["$","$L18",null,{"seconds":1650,"label":"27:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Training and discipline resumed"}],["$","p",null,{"children":"Johnston ordered regular drill, inspections, roll calls, dress parades, and camp sanitation."}]]}]]}]
26:["$","div","Furloughs improved morale",{"className":"moment","children":[["$","$L18",null,{"seconds":1676,"label":"27:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Furloughs improved morale"}],["$","p",null,{"children":"Hardee’s furlough system allowed many soldiers to visit home, and most returned to their units."}]]}]]}]
27:["$","div","Johnston proposed moving to Mississippi",{"className":"moment","children":[["$","$L18",null,{"seconds":1761,"label":"29:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston proposed moving to Mississippi"}],["$","p",null,{"children":"He suggested reinforcing with Polk and advancing into western Tennessee while cavalry delayed any U.S. move toward Atlanta."}]]}]]}]
28:["$","div","No common strategy was adopted",{"className":"moment","children":[["$","$L18",null,{"seconds":1808,"label":"30:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"No common strategy was adopted"}],["$","p",null,{"children":"Davis neither approved Johnston’s alternative nor ordered an immediate attack, so the army prepared to react to U.S. movements."}]]}]]}]
