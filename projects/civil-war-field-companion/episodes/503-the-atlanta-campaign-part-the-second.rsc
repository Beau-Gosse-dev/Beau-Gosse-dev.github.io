15:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L1d",null,{"guide":{"date":"December 1863–January 1864","place":"Richmond, Dalton, Chattanooga, and the Confederate home front","result":"Jefferson Davis appointed Joseph E. Johnston to rebuild the Army of Tennessee, but their disagreement over the army’s condition and strategy left it without an agreed offensive plan","facts":[{"label":"Confederate military deaths by 1864","value":"At least 150,000"},{"label":"Troops absent without permission","value":"About 60,000"},{"label":"Confederate currency issued","value":"$$1.2 billion"},{"label":"Army present at Dalton","value":"Fewer than 40,000 men"},{"label":"Daily desertions at Dalton","value":"About 30 men"},{"label":"Atlanta–Dalton railroad","value":"About 95 miles"}],"maps":[{"title":"Dalton and the Chattanooga front","caption":"After Missionary Ridge, the Army of Tennessee withdrew from Chattanooga to Dalton. The Western and Atlantic Railroad connected the camp to Atlanta.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of Chattanooga, Dalton, and northwest Georgia"},{"title":"The Western and Atlantic Railroad","caption":"Johnston depended on this single-track state railroad for food, clothing, equipment, and reinforcements from Atlanta. He threatened to withdraw unless deliveries improved.","source":"https://www.loc.gov/resource/g3921p.rr006140/","image":"/images/western-atlantic-birds-eye-map.jpg","alt":"Birds-eye map of the Western and Atlantic Railroad from Chattanooga to Atlanta"},{"title":"Dalton, Atlanta, and Chattanooga today","caption":"Dalton stood south of Chattanooga on the main railroad to Atlanta. That position protected Georgia but tied the Confederate army to one supply corridor.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-85.65%2C33.55%2C-84.05%2C35.35&layer=mapnik&marker=34.769%2C-84.971"}],"moments":[{"time":"1:41","audioTime":101,"title":"The Confederate outlook had deteriorated","detail":"The losses of Gettysburg and Vicksburg and the defeat at Missionary Ridge ended the military optimism present at the start of 1863."},{"time":"3:33","audioTime":213,"title":"Confederate manpower losses were severe","detail":"By early 1864 at least 150,000 soldiers had died, with many more wounded, sick, imprisoned, or absent."},{"time":"4:05","audioTime":245,"title":"About 60,000 troops were absent","detail":"Desertion grew as soldiers became demoralized, exhausted, or concerned about families without food."},{"time":"5:08","audioTime":308,"title":"The home front lacked basic goods","detail":"Government control of blockade-running cargo emphasized military supplies while civilians faced shortages of clothing, medicine, coffee, and food."},{"time":"5:52","audioTime":352,"title":"Railroad capacity declined","detail":"Federal occupation, damage, worn track, and shortages of equipment caused slow service, breakdowns, and derailments."},{"time":"6:22","audioTime":382,"title":"Confederate currency lost value","detail":"The government had issued about $1.2 billion; the exchange rate fell from three Confederate dollars per gold dollar in January 1863 to twenty a year later."},{"time":"7:00","audioTime":420,"title":"Food prices rose sharply","detail":"The episode gives Richmond examples of bacon rising from 12.5 cents to eight dollars per pound and flour rising from about seven to two hundred dollars per barrel."},{"time":"9:12","audioTime":552,"title":"Confederate strategy depended on holding out","detail":"Southern leaders expected battlefield resistance and U.S. casualties to weaken Northern support for Lincoln before the November election."},{"time":"12:51","audioTime":771,"title":"Davis prepared for the 1864 campaigns","detail":"He pursued financial and manpower measures and selected a permanent commander for the Army of Tennessee."},{"time":"13:33","audioTime":813,"title":"The Army of Tennessee had a record of defeats","detail":"Failures at Donelson, Shiloh, the Kentucky campaign, Stones River, and Missionary Ridge left U.S. forces on Georgia’s northern border."},{"time":"15:00","audioTime":900,"title":"The army stopped at Dalton","detail":"After retreating from Missionary Ridge, the soldiers entered winter camp in northwestern Georgia with low morale and inadequate supplies."},{"time":"15:46","audioTime":946,"title":"Previous commanders had not solved the problem","detail":"Albert Sidney Johnston died at Shiloh, Davis removed P. G. T. Beauregard, and Braxton Bragg lost the confidence of many subordinates."},{"time":"17:10","audioTime":1030,"title":"Hardee declined permanent army command","detail":"William J. Hardee led temporarily after Bragg resigned but told Davis he did not want the position."},{"time":"17:46","audioTime":1066,"title":"Only Johnston remained a practical choice","detail":"Robert E. Lee could not leave Virginia, and Davis would not restore Beauregard, leaving Joseph E. Johnston."},{"time":"18:53","audioTime":1133,"title":"Davis and Johnston distrusted each other","detail":"They disputed seniority, secrecy, strategy, responsibility for Vicksburg, and the military prospects of the Confederacy."},{"time":"21:07","audioTime":1267,"title":"Davis appointed Johnston","detail":"On December 16, Davis ordered him to transfer the Army of Mississippi to Leonidas Polk and take command at Dalton."},{"time":"22:23","audioTime":1343,"title":"Johnston found fewer than 40,000 men present","detail":"Only about two-thirds were effective. Many lacked shoes and overcoats, rations were poor, scurvy was present, and animals were scarce."},{"time":"23:30","audioTime":1410,"title":"About 30 men deserted each day","detail":"The army’s condition made the winter offensive expected by Davis impractical."},{"time":"23:57","audioTime":1437,"title":"Johnston proposed a defensive opening","detail":"He told Davis that the army first had to defeat a U.S. advance before it could move forward."},{"time":"25:01","audioTime":1501,"title":"Davis requested another condition report","detail":"James Seddon obtained details from Johnston, but the new report did not resolve the disagreement."},{"time":"26:13","audioTime":1573,"title":"Johnston made food supply the first priority","detail":"He warned Richmond and Georgia governor Joseph E. Brown that inadequate railroad deliveries might force the army to retreat."},{"time":"27:13","audioTime":1633,"title":"Railroad deliveries improved","detail":"By January 25, additional locomotives and cars allowed the army to meet daily needs and begin stockpiling rations."},{"time":"27:30","audioTime":1650,"title":"Training and discipline resumed","detail":"Johnston ordered regular drill, inspections, roll calls, dress parades, and camp sanitation."},{"time":"27:56","audioTime":1676,"title":"Furloughs improved morale","detail":"Hardee’s furlough system allowed many soldiers to visit home, and most returned to their units."},{"time":"29:21","audioTime":1761,"title":"Johnston proposed moving to Mississippi","detail":"He suggested reinforcing with Polk and advancing into western Tennessee while cavalry delayed any U.S. move toward Atlanta."},{"time":"30:08","audioTime":1808,"title":"No common strategy was adopted","detail":"Davis neither approved Johnston’s alternative nor ordered an immediate attack, so the army prepared to react to U.S. movements."}],"command":[{"side":"Confederacy","color":"red","branches":[{"commander":"Jefferson Davis","command":"Confederate president and commander-in-chief","subordinates":"Set national strategy and selected the Army of Tennessee commander"},{"commander":"James A. Seddon","command":"Secretary of War","subordinates":"Collected army condition reports and acted on supply problems"},{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Assumed command December 28, 1863, and rebuilt the army at Dalton"},{"commander":"William J. Hardee","command":"Senior corps commander","subordinates":"Commanded temporarily after Bragg and designed the furlough system"},{"commander":"Leonidas Polk","command":"Army of Mississippi","subordinates":"Took Johnston’s previous command and figured in his proposed western concentration"},{"commander":"Joseph E. Brown","command":"Governor of Georgia","subordinates":"Oversaw the state-owned Western and Atlantic Railroad"}]},{"side":"United States","color":"blue","branches":[{"commander":"Ulysses S. Grant","command":"Military Division of the Mississippi","subordinates":"Held Chattanooga and prepared the opposing spring offensive"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Occupied the Chattanooga front north of Johnston’s army"}]}],"people":[{"name":"Jefferson Davis","role":"Appointed Johnston but rejected his assessment of the army and did not establish an agreed strategy","side":"Confederacy","image":"/images/jefferson-davis.jpg","source":"https://www.loc.gov/pictures/item/2004673617/"},{"name":"Joseph E. Johnston","role":"Took command at Dalton, improved supply and morale, and argued against an immediate offensive","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"William J. Hardee","role":"Held temporary command, declined the permanent post, and created the furlough plan","side":"Confederacy","image":"/images/william-j-hardee.jpg","source":"https://www.loc.gov/pictures/item/00652519/"},{"name":"Braxton Bragg","role":"Resigned after Missionary Ridge; his reports and command disputes shaped Davis’s expectations","side":"Confederacy","image":"/images/braxton-bragg.jpg","source":"https://www.loc.gov/pictures/item/2018670276/"},{"name":"P. G. T. Beauregard","role":"Former army commander whom Davis refused to restore","side":"Confederacy"},{"name":"Leonidas Polk","role":"Received Johnston’s former Mississippi command and was included in Johnston’s proposed concentration","side":"Confederacy","image":"/images/leonidas-polk.jpg","source":"https://www.loc.gov/pictures/item/2018666546/"},{"name":"Mary Chesnut","role":"South Carolina diarist whose January 1 entry recorded the worsening Confederate outlook","side":"Confederacy"}],"losses":[{"name":"Albert Sidney Johnston","side":"Confederacy","role":"First commander of the Army of Tennessee","outcome":"Mortally wounded and bled to death at Shiloh on April 6, 1862; discussed as part of the army’s command history"}],"gallery":[{"image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of Chattanooga and northwest Georgia","caption":"The Army of Tennessee withdrew from Chattanooga to Dalton after Missionary Ridge.","source":"https://www.loc.gov/item/2008628278/"},{"image":"/images/confederate-white-house.jpg","alt":"Confederate executive mansion in Richmond","caption":"Davis directed military policy from the Confederate executive mansion in Richmond.","source":"https://www.loc.gov/pictures/item/2018666801/"},{"image":"/images/jefferson-davis.jpg","alt":"Portrait of Jefferson Davis","caption":"Davis appointed Johnston but continued to question his reports and strategy.","source":"https://www.loc.gov/pictures/item/2004673617/"},{"image":"/images/joseph-e-johnston.jpg","alt":"Portrait of Joseph E. Johnston","caption":"Johnston concentrated on food, discipline, clothing, furloughs, and morale at Dalton.","source":"https://www.loc.gov/item/2018666539/"},{"image":"/images/william-j-hardee.jpg","alt":"Portrait of William J. Hardee","caption":"Hardee commanded temporarily after Bragg and then returned to corps command.","source":"https://www.loc.gov/pictures/item/00652519/"}],"sources":[{"label":"Official Episode 503 page","url":"https://civilwarpodcast.org/2025/08/31/civil-war-podcast-episode-503/"},{"label":"U.S. Army Center of Military History Atlanta campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"Library of Congress Western and Atlantic Railroad map","url":"https://www.loc.gov/resource/g3921p.rr006140/"},{"label":"Library of Congress Jefferson Davis portrait","url":"https://www.loc.gov/pictures/item/2004673617/"},{"label":"Library of Congress William J. Hardee portrait","url":"https://www.loc.gov/pictures/item/00652519/"},{"label":"Library of Congress Confederate executive mansion photograph","url":"https://www.loc.gov/pictures/item/2018666801/"}]}}]}]
