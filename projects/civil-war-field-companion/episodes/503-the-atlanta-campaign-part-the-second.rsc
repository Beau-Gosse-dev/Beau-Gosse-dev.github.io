10:["$","figure","The Western and Atlantic Railroad",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/western-atlantic-birds-eye-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The Western and Atlantic Railroad at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/western-atlantic-birds-eye-map.jpg","alt":"Birds-eye map of the Western and Atlantic Railroad from Chattanooga to Atlanta","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Western and Atlantic Railroad"}],["$","span",null,{"children":"Johnston depended on this single-track state railroad for food, clothing, equipment, and reinforcements from Atlanta. He threatened to withdraw unless deliveries improved."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/western-atlantic-birds-eye-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/resource/g3921p.rr006140/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
11:["$","figure","Dalton, Atlanta, and Chattanooga today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-85.65%2C33.55%2C-84.05%2C35.35&layer=mapnik&marker=34.769%2C-84.971","title":"Dalton, Atlanta, and Chattanooga today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Dalton, Atlanta, and Chattanooga today"}],["$","span",null,{"children":"Dalton stood south of Chattanooga on the main railroad to Atlanta. That position protected Georgia but tied the Confederate army to one supply corridor."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The Confederate outlook had deteriorated",{"className":"moment","children":[["$","$L18",null,{"seconds":101,"label":"1:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate outlook had deteriorated"}],["$","p",null,{"children":"The losses of Gettysburg and Vicksburg and the defeat at Missionary Ridge ended the military optimism present at the start of 1863."}]]}]]}],["$","div","Confederate manpower losses were severe",{"className":"moment","children":[["$","$L18",null,{"seconds":213,"label":"3:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate manpower losses were severe"}],["$","p",null,{"children":"By early 1864 at least 150,000 soldiers had died, with many more wounded, sick, imprisoned, or absent."}]]}]]}],["$","div","About 60,000 troops were absent",{"className":"moment","children":[["$","$L18",null,{"seconds":245,"label":"4:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"About 60,000 troops were absent"}],["$","p",null,{"children":"Desertion grew as soldiers became demoralized, exhausted, or concerned about families without food."}]]}]]}],["$","div","The home front lacked basic goods",{"className":"moment","children":[["$","$L18",null,{"seconds":308,"label":"5:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The home front lacked basic goods"}],["$","p",null,{"children":"Government control of blockade-running cargo emphasized military supplies while civilians faced shortages of clothing, medicine, coffee, and food."}]]}]]}],["$","div","Railroad capacity declined",{"className":"moment","children":[["$","$L18",null,{"seconds":352,"label":"5:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Railroad capacity declined"}],["$","p",null,{"children":"Federal occupation, damage, worn track, and shortages of equipment caused slow service, breakdowns, and derailments."}]]}]]}],["$","div","Confederate currency lost value",{"className":"moment","children":[["$","$L18",null,{"seconds":382,"label":"6:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate currency lost value"}],["$","p",null,{"children":"The government had issued about $1.2 billion; the exchange rate fell from three Confederate dollars per gold dollar in January 1863 to twenty a year later."}]]}]]}],["$","div","Food prices rose sharply",{"className":"moment","children":[["$","$L18",null,{"seconds":420,"label":"7:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Food prices rose sharply"}],["$","p",null,{"children":"The episode gives Richmond examples of bacon rising from 12.5 cents to eight dollars per pound and flour rising from about seven to two hundred dollars per barrel."}]]}]]}],["$","div","Confederate strategy depended on holding out",{"className":"moment","children":[["$","$L18",null,{"seconds":552,"label":"9:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate strategy depended on holding out"}],["$","p",null,{"children":"Southern leaders expected battlefield resistance and U.S. casualties to weaken Northern support for Lincoln before the November election."}]]}]]}],["$","div","Davis prepared for the 1864 campaigns",{"className":"moment","children":[["$","$L18",null,{"seconds":771,"label":"12:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis prepared for the 1864 campaigns"}],["$","p",null,{"children":"He pursued financial and manpower measures and selected a permanent commander for the Army of Tennessee."}]]}]]}],["$","div","The Army of Tennessee had a record of defeats",{"className":"moment","children":[["$","$L18",null,{"seconds":813,"label":"13:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of Tennessee had a record of defeats"}],["$","p",null,{"children":"Failures at Donelson, Shiloh, the Kentucky campaign, Stones River, and Missionary Ridge left U.S. forces on Georgia’s northern border."}]]}]]}],["$","div","The army stopped at Dalton",{"className":"moment","children":[["$","$L18",null,{"seconds":900,"label":"15:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army stopped at Dalton"}],"$L19"]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Confederate president and commander-in-chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate president and commander-in-chief"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Set national strategy and selected the Army of Tennessee commander"}]]}],["$","div","Secretary of War",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of War"}],["$","span",null,{"children":"James A. Seddon"}],["$","small",null,{"children":"Collected army condition reports and acted on supply problems"}]]}],["$","div","Army of Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Tennessee"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"Assumed command December 28, 1863, and rebuilt the army at Dalton"}]]}],["$","div","Senior corps commander",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior corps commander"}],["$","span",null,{"children":"William J. Hardee"}],["$","small",null,{"children":"Commanded temporarily after Bragg and designed the furlough system"}]]}],["$","div","Army of Mississippi",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Mississippi"}],["$","span",null,{"children":"Leonidas Polk"}],["$","small",null,{"children":"Took Johnston’s previous command and figured in his proposed western concentration"}]]}],["$","div","Governor of Georgia",{"className":"command-entry","children":[["$","strong",null,{"children":"Governor of Georgia"}],["$","span",null,{"children":"Joseph E. Brown"}],["$","small",null,{"children":"Oversaw the state-owned Western and Atlantic Railroad"}]]}]]]}],["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","Military Division of the Mississippi",{"className":"command-entry","children":[["$","strong",null,{"children":"Military Division of the Mississippi"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Held Chattanooga and prepared the opposing spring offensive"}]]}],["$","div","Army of the Cumberland",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Cumberland"}],["$","span",null,{"children":"George H. Thomas"}],["$","small",null,{"children":"Occupied the Chattanooga front north of Johnston’s army"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Jefferson Davis",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/jefferson-davis.jpg","alt":"Portrait of Jefferson Davis","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Jefferson Davis"}],["$","p",null,{"children":"Appointed Johnston but rejected his assessment of the army and did not establish an agreed strategy"}]]}]]}],["$","article","Joseph E. Johnston",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/joseph-e-johnston.jpg","alt":"Portrait of Joseph E. Johnston","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Joseph E. Johnston"}],["$","p",null,{"children":"Took command at Dalton, improved supply and morale, and argued against an immediate offensive"}]]}]]}],["$","article","William J. Hardee",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/william-j-hardee.jpg","alt":"Portrait of William J. Hardee","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],"$L29","$L2a"]}]]}],"$L2b","$L2c","$L2d","$L2e"]}]]}]
