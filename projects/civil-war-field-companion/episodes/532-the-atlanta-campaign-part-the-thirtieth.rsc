11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The Army of Tennessee withdrew from the Shoup Line",{"className":"moment","children":[["$","$L16",null,{"seconds":76,"label":"1:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of Tennessee withdrew from the Shoup Line"}],["$","p",null,{"children":"Johnston moved the army behind Peachtree Creek after U.S. forces crossed the Chattahoochee. The new line covered Atlanta from the north."}]]}]]}],["$","div","Sherman planned a general right wheel",{"className":"moment","children":[["$","$L16",null,{"seconds":126,"label":"2:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman planned a general right wheel"}],["$","p",null,{"children":"Sherman chose to move around the north and east of Atlanta rather than attack the city defenses directly."}]]}]]}],["$","div","Each U.S. army received a route",{"className":"moment","children":[["$","$L16",null,{"seconds":174,"label":"2:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Each U.S. army received a route"}],["$","p",null,{"children":"McPherson was to move toward Stone Mountain, Schofield toward Decatur, and Thomas through Buckhead toward Peachtree Creek."}]]}]]}],["$","div","U.S. forces prepared three bridgeheads",{"className":"moment","children":[["$","$L16",null,{"seconds":215,"label":"3:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. forces prepared three bridgeheads"}],["$","p",null,{"children":"For six days the armies built bridges, moved supplies to Vinings Station, and consolidated crossings at Roswell, Soap Creek, and farther downstream."}]]}]]}],["$","div","Confederate troops completed an orderly withdrawal",{"className":"moment","children":[["$","$L16",null,{"seconds":273,"label":"4:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate troops completed an orderly withdrawal"}],["$","p",null,{"children":"Arthur Manigault described muffled artillery wheels, pontoon bridges covered with corn stalks, and a withdrawal without loss of men or equipment."}]]}]]}],["$","div","Atlanta residents began leaving the city",{"className":"moment","children":[["$","$L16",null,{"seconds":479,"label":"7:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Atlanta residents began leaving the city"}],["$","p",null,{"children":"Wagons and trains carried civilians away as the U.S. armies approached."}]]}]]}],["$","div","Johnston recommended evacuating Andersonville prisoners",{"className":"moment","children":[["$","$L16",null,{"seconds":525,"label":"8:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston recommended evacuating Andersonville prisoners"}],["$","p",null,{"children":"Johnston feared a U.S. cavalry raid against the prison camp. Davis interpreted the message as evidence that Johnston might abandon Atlanta."}]]}]]}],["$","div","Davis sent Braxton Bragg to Atlanta",{"className":"moment","children":[["$","$L16",null,{"seconds":559,"label":"9:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis sent Braxton Bragg to Atlanta"}],["$","p",null,{"children":"Bragg was ordered to determine Johnston’s intentions. His meetings with Johnston were unproductive, while Hood repeated criticism of Johnston’s command."}]]}]]}],["$","div","Davis demanded a specific operational plan",{"className":"moment","children":[["$","$L16",null,{"seconds":714,"label":"11:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis demanded a specific operational plan"}],["$","p",null,{"children":"On July 16, Johnston replied that his actions had to depend on Sherman because the U.S. force was about twice his size."}]]}]]}],["$","div","Davis decided to replace Johnston",{"className":"moment","children":[["$","$L16",null,{"seconds":753,"label":"12:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis decided to replace Johnston"}],["$","p",null,{"children":"Davis rejected William J. Hardee as too cautious and selected John B. Hood."}]]}]]}],["$","div","Sherman began the advance on July 17",{"className":"moment","children":["$L17","$L18"]}],"$L19","$L1a","$L1b"]}]]}]
