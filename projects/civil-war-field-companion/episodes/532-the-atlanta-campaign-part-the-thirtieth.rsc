de-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"July 10–17, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Chattahoochee River and Atlanta, Georgia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Sherman began a movement around Atlanta, and Jefferson Davis ordered John B. Hood to replace Joseph E. Johnston"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"July 10–17, 1864","place":"Chattahoochee River and Atlanta, Georgia","result":"Sherman began a movement around Atlanta, and Jefferson Davis ordered John B. Hood to replace Joseph E. Johnston","facts":[{"label":"Confederate withdrawal","value":"Completed by July 10"},{"label":"U.S. bridgeheads","value":"Roswell, Soap Creek, and below Soap Creek"},{"label":"U.S. objective","value":"Break the Georgia Railroad east of Atlanta"},{"label":"Command change ordered","value":"10 p.m. on July 17"},{"label":"New Confederate commander","value":"John B. Hood"}],"maps":[{"title":"Sherman’s movement from the Chattahoochee to Atlanta","caption":"The map shows Roswell, the river crossings, Peachtree Creek, Decatur, Stone Mountain, and Atlanta. The U.S. armies moved south and east from separate bridgeheads.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-4.jpg","alt":"U.S. Army map of the Atlanta campaign from Kennesaw Mountain to Atlanta"},{"title":"Atlanta, Decatur, and Stone Mountain today","caption":"McPherson moved toward Stone Mountain and the Georgia Railroad, Schofield moved toward Decatur, and Thomas advanced toward Atlanta through Buckhead.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.57%2C33.61%2C-83.98%2C34.08&layer=mapnik&marker=33.755%2C-84.39"},{"title":"Atlanta campaign operations","caption":"Blue lines show U.S. works and movements; red lines show Confederate works and movements. The map records the approach to Atlanta and the city defenses.","source":"https://www.loc.gov/item/99447303/","image":"/images/peachtree-operations-map.jpg","alt":"Historical military operations map of Atlanta and the surrounding region"}],"moments":[{"time":"1:16","audioTime":76,"title":"The Army of Tennessee withdrew from the Shoup Line","detail":"Johnston moved the army behind Peachtree Creek after U.S. forces crossed the Chattahoochee. The new line covered Atlanta from the north."},{"time":"2:06","audioTime":126,"title":"Sherman planned a general right wheel","detail":"Sherman chose to move around the north and east of Atlanta rather than attack the city defenses directly."},{"time":"2:54","audioTime":174,"title":"Each U.S. army received a route","detail":"McPherson was to move toward Stone Mountain, Schofield toward Decatur, and Thomas through Buckhead toward Peachtree Creek."},{"time":"3:35","audioTime":215,"title":"U.S. forces prepared three bridgeheads","detail":"For six days the armies built bridges, moved supplies to Vinings Station, and consolidated crossings at Roswell, Soap Creek, and farther downstream."},{"time":"4:33","audioTime":273,"title":"Confederate troops completed an orderly withdrawal","detail":"Arthur Manigault described muffled artillery wheels, pontoon bridges covered with corn stalks, and a withdrawal without loss of men or equipment."},{"time":"7:59","audioTime":479,"title":"Atlanta residents began leaving the city","detail":"Wagons and trains carried civilians away as the U.S. armies approached."},{"time":"8:45","audioTime":525,"title":"Johnston recommended evacuating Andersonville prisoners","detail":"Johnston feared a U.S. cavalry raid against the prison camp. Davis interpreted the message as evidence that Johnston might abandon Atlanta."},{"time":"9:19","audioTime":559,"title":"Davis sent Braxton Bragg to Atlanta","detail":"Bragg was ordered to determine Johnston’s intentions. His meetings with Johnston were unproductive, while Hood repeated criticism of Johnston’s command."},{"time":"11:54","audioTime":714,"title":"Davis demanded a specific operational plan","detail":"On July 16, Johnston replied that his actions had to depend on Sherman because the U.S. force was about twice his size."},{"time":"12:33","audioTime":753,"title":"Davis decided to replace Johnston","detail":"Davis rejected William J. Hardee as too cautious and selected John B. Hood."},{"time":"13:16","audioTime":796,"title":"Sherman began the advance on July 17","detail":"All three U.S. armies moved from their Chattahoochee bridgeheads toward Atlanta and the Georgia Railroad."},{"time":"13:35","audioTime":815,"title":"The relief order reached Johnston","detail":"At 10 p.m., Samuel Cooper’s telegram ordered Johnston to turn the Army and Department of Tennessee over to Hood."},{"time":"14:25","audioTime":865,"title":"Many Confederate soldiers opposed the change","detail":"Accounts from Arthur Manigault, Albert Willard, and Sam Watkins described anger at Johnston’s removal and confidence that he had preserved the army."},{"time":"15:26","audioTime":926,"title":"U.S. commanders assessed Hood","detail":"Oliver O. Howard called Hood a hard fighter, and John M. Schofield expected him to attack."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed the general right wheel"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Advanced through Buckhead toward Peachtree Creek"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"Advanced toward Decatur"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Advanced toward Stone Mountain and the Georgia Railroad"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Jefferson Davis","command":"President of the Confederate States","subordinates":"Ordered the command change"},{"commander":"Braxton Bragg","command":"Military adviser to Davis","subordinates":"Investigated Johnston’s plans in Atlanta"},{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Relieved on July 17"},{"commander":"John B. Hood","command":"Army of Tennessee","subordinates":"Ordered to assume command"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Senior corps commander"}]}],"people":[{"name":"Joseph E. Johnston","role":"Withdrew the Army of Tennessee behind Peachtree Creek and was relieved on July 17","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"John B. Hood","role":"Criticized Johnston to Bragg and was selected to command the army","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"Francis A. Shoup","role":"Designed the fortified line abandoned at the Chattahoochee","side":"Confederacy"},{"name":"Arthur Manigault","role":"Brigade commander whose report described the withdrawal and the soldiers’ reaction","side":"Confederacy"},{"name":"Braxton Bragg","role":"Reported on Johnston’s intentions for Jefferson Davis","side":"Confederacy"},{"name":"Samuel Cooper","role":"Adjutant and Inspector General who transmitted the relief order","side":"Confederacy"},{"name":"Oliver O. Howard","role":"U.S. corps commander who provided Sherman an assessment of Hood","side":"United States"}],"losses":[],"gallery":[{"image":"/images/atlanta-fortifications.jpg","alt":"Confederate fortifications outside Atlanta photographed in 1864","caption":"Confederate earthworks at Atlanta. Sherman planned to bypass the defenses and cut the Georgia Railroad.","source":"https://www.loc.gov/item/2018670937/"},{"image":"/images/atlanta-railroad-depot.jpg","alt":"Atlanta railroad depot photographed in 1864","caption":"Atlanta’s railroad depot. Control of the city’s rail connections was the central operational objective.","source":"https://www.loc.gov/item/2018666982/"}],"sources":[{"label":"Official Episode 532 page","url":"https://civilwarpodcast.org/2026/07/05/civil-war-podcast-episode-532/"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"Library of Congress Atlanta operations map","url":"https://www.loc.gov/item/99447303/"},{"label":"Library of Congress Joseph E. Johnston portrait","url":"https://www.loc.gov/item/2018666539/"},{"label":"Library of Congress John B. Hood portrait","url":"https://www.loc.gov/pictures/item/2002722867/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
