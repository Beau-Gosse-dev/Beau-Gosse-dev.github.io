20:["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep131-peninsula-map-1862.jpg","alt":"Contemporary map of Richmond and the Virginia Peninsula published in 1862","width":1600,"height":1200,"loading":"lazy"}]
21:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Virginia Peninsula and Richmond in 1862"}],["$","span",null,{"children":"This contemporary map shows the York and James Rivers, Fort Monroe, Yorktown, Williamsburg, the road and rail network, and Richmond. It helps locate the army McClellan was moving away from Washington and the defensive line where his advance stopped."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep131-peninsula-map-1862.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448355/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
23:["$","p",null,{"children":"The episode argues that the headline total obscured how many trained troops were immediately available at the capital and how many were distant or only scheduled to move."}]
24:["$","div","McClellan does not resolve Lincoln’s concern",{"className":"moment","children":[["$","$L22",null,{"seconds":821,"label":"13:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan does not resolve Lincoln’s concern"}],["$","p",null,{"children":"McClellan viewed distant field forces and pressure against Richmond as parts of Washington’s defense, but his April 1 report did not produce agreement with Lincoln and Stanton on that concept."}]]}]]}]
25:["$","div","McDowell’s corps is withheld",{"className":"moment","children":[["$","$L22",null,{"seconds":878,"label":"14:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"McDowell’s corps is withheld"}],["$","p",null,{"children":"The episode connects the review of McClellan’s figures to the decision to keep I Corps in northern Virginia rather than send it immediately to the Peninsula."}]]}]]}]
26:["$","div","Wadsworth reports his immediate force",{"className":"moment","children":[["$","$L22",null,{"seconds":922,"label":"15:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wadsworth reports his immediate force"}],["$","p",null,{"children":"The Washington district commander counted 19,022 present for duty, described most as new and imperfectly disciplined, and reported no mounted light artillery under his command."}]]}]]}]
27:["$","div","I Corps is the formation still available to retain",{"className":"moment","children":[["$","$L22",null,{"seconds":962,"label":"16:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"I Corps is the formation still available to retain"}],["$","p",null,{"children":"McDowell’s corps had not completed movement to the Peninsula when the administration decided that one corps had to remain in front of Washington."}]]}]]}]
28:["$","div","McClellan condemns the decision",{"className":"moment","children":[["$","$L22",null,{"seconds":977,"label":"16:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan condemns the decision"}],["$","p",null,{"children":"In private correspondence and later in his official report, McClellan presented the loss of McDowell’s corps as a crippling blow to the campaign."}]]}]]}]
29:["$","div","The episode separates I Corps from the Yorktown decision",{"className":"moment","children":[["$","$L22",null,{"seconds":1100,"label":"18:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode separates I Corps from the Yorktown decision"}],["$","p",null,{"children":"It argues that McDowell’s absence did not require a siege because McClellan’s original embarkation schedule did not place the corps at Fort Monroe in time for the opening advance."}]]}]]}]
2a:["$","div","McClellan had an early numerical advantage",{"className":"moment","children":[["$","$L22",null,{"seconds":1184,"label":"19:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan had an early numerical advantage"}],["$","p",null,{"children":"U.S. Army history places about 58,000 troops immediately with McClellan when the advance began; the National Park Service gives Magruder roughly 11,000 before Confederate reinforcements arrived."}]]}]]}]
2b:["$","div","Book recommendation",{"className":"moment","children":[["$","$L22",null,{"seconds":1268,"label":"21:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Book recommendation"}],["$","p",null,{"children":"The hosts recommend Forward to Richmond: McClellan’s Peninsula Campaign by Ronald H. Bailey and the Editors of Time-Life Books."}]]}]]}]
2c:["$","article","George B. McClellan",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep131-george-mcclellan.jpg","alt":"Portrait of George B. McClellan","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George B. McClellan"}],["$","p",null,{"children":"Built and commanded the Army of the Potomac, issued the March 14 paternal address to its soldiers, and argued that his regional troop dispositions protected Washington"}]]}]]}]
2d:["$","article","Abraham Lincoln",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Abraham Lincoln"}],["$","p",null,{"children":"Required Washington to remain secure and directed that one corps stay in front of the capital after the April 2 review"}]]}]]}]
2e:["$","article","Edwin M. Stanton",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"EM"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Edwin M. Stanton"}],["$","p",null,{"children":"Had Thomas and Hitchcock compare McClellan’s accounting with Wadsworth’s return and communicated the administration’s orders"}]]}]]}]
2f:["$","article","Irvin McDowell",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep131-irvin-mcdowell.jpg","alt":"Portrait of Irvin McDowell","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Irvin McDowell"}],["$","p",null,{"children":"Commanded the I Corps retained in northern Virginia and was assigned the new Department of the Rappahannock"}]]}]]}]
30:["$","article","James S. Wadsworth",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep131-james-wadsworth.jpg","alt":"Portrait of James S. Wadsworth","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"James S. Wadsworth"}],["$","p",null,{"children":"Commanded the Military District of Washington and warned that the strength and quality of his immediate force were inadequate for its assigned duty"}]]}]]}]
31:["$","article","Nathaniel P. Banks",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"NP"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Nathaniel P. Banks"}],["$","p",null,{"children":"Commanded V Corps in the Shenandoah Valley, a distant force included in McClellan’s April 1 regional defense total"}]]}]]}]
32:["$","article","Lorenzo Thomas",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"LT"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Lorenzo Thomas"}],["$","p",null,{"children":"Adjutant General who, with Hitchcock, reviewed the April reports and found Lincoln’s security requirement had not been fully met"}]]}]]}]
33:["$","article","Ethan Allen Hitchcock",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"EA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Ethan Allen Hitchcock"}],["$","p",null,{"children":"Major general who joined Thomas in the April 2 review of the forces left for Washington and Manassas"}]]}]]}]
34:["$","article","Joseph E. Johnston",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Joseph E. Johnston"}],["$","p",null,{"children":"Commanded the principal Confederate field army, which moved from northern Virginia to reinforce the defense between Yorktown and Richmond"}]]}]]}]
35:["$","article","John B. Magruder",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"John B. Magruder"}],["$","p",null,{"children":"Commanded the initially outnumbered Confederate force holding the Yorktown–Warwick defensive line"}]]}]]}]
