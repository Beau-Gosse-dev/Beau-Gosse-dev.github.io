1a:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Washington and the Peninsula were one operational problem",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep131-washington-peninsula-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Washington and the Peninsula were one operational problem at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep131-washington-peninsula-context.svg","alt":"Schematic map connecting Washington, northern Virginia, the Shenandoah Valley, and the Peninsula Campaign route to Richmond","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Washington and the Peninsula were one operational problem"}],["$","span",null,{"children":"McClellan’s army traveled from Alexandria to Fort Monroe and advanced toward Yorktown and Richmond. Lincoln also had to consider Confederate access to Washington through northern Virginia and the Shenandoah Valley. The arrows show broad operational movements, not daily march routes."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep131-washington-peninsula-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","McClellan’s force accounting around Washington",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep131-washington-force-disposition.svg","target":"_blank","rel":"noreferrer","aria-label":"Open McClellan’s force accounting around Washington at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep131-washington-force-disposition.svg","alt":"Schematic map of McClellan’s April 1 troop figures at Washington, Manassas, Warrenton, the Shenandoah Valley, and the lower Potomac","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"McClellan’s force accounting around Washington"}],["$","span",null,{"children":"The map places the five parts of McClellan’s April 1 total in geographic context. The 73,456 figure described a regional defensive system, not a force concentrated inside Washington’s forts. Wadsworth’s April 2 report counted 19,022 present for duty under his immediate command before further ordered detachments."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep131-washington-force-disposition.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.latinamericanstudies.org/civil-war/OR-11-3.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1a:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The Virginia Peninsula and Richmond in 1862",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep131-peninsula-map-1862.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The Virginia Peninsula and Richmond in 1862 at full size","children":"$L20"}]}],"$L21"]}]]}]]}]
1b:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The campaign narrative pauses",{"className":"moment","children":[["$","$L22",null,{"seconds":70,"label":"1:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign narrative pauses"}],["$","p",null,{"children":"The episode turns from the advance on Yorktown to three connected subjects: McClellan’s relationship with his army, his accounting for Washington’s defense, and the retention of McDowell’s corps."}]]}]]}],["$","div","McClellan’s relationship with the army",{"className":"moment","children":[["$","$L22",null,{"seconds":134,"label":"2:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan’s relationship with the army"}],["$","p",null,{"children":"The discussion describes the personal loyalty McClellan cultivated through frequent appearances, praise, and a paternal style of command."}]]}]]}],["$","div","McClellan addresses the Army of the Potomac",{"className":"moment","children":[["$","$L22",null,{"seconds":281,"label":"4:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan addresses the Army of the Potomac"}],["$","p",null,{"children":"The address told the soldiers that their training was complete and linked McClellan’s fate to theirs. The document is dated March 14; embarkation from Alexandria began March 17."}]]}]]}],["$","div","McClellan loses the general-in-chief role",{"className":"moment","children":[["$","$L22",null,{"seconds":379,"label":"6:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan loses the general-in-chief role"}],["$","p",null,{"children":"Lincoln’s March 11 order removed McClellan’s authority over the other military departments while leaving him in command of the Army of the Potomac."}]]}]]}],["$","div","The army also becomes a political base",{"className":"moment","children":[["$","$L22",null,{"seconds":422,"label":"7:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army also becomes a political base"}],["$","p",null,{"children":"The episode distinguishes McClellan’s effective work organizing the army from his use of personal loyalty and patronage within its officer corps and headquarters."}]]}]]}],["$","div","The security of Washington",{"className":"moment","children":[["$","$L22",null,{"seconds":622,"label":"10:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The security of Washington"}],["$","p",null,{"children":"Lincoln’s approval of the Fort Monroe plan depended on leaving the capital secure after the Army of the Potomac moved south."}]]}]]}],["$","div","Corps commanders give different requirements",{"className":"moment","children":[["$","$L22",null,{"seconds":649,"label":"10:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Corps commanders give different requirements"}],["$","p",null,{"children":"Sumner proposed 40,000 men. The other three corps commanders required garrisons for the forts plus a 25,000-man covering force, a formula later interpreted as about 55,000."}]]}]]}],["$","div","McClellan reports from the steamer Commodore",{"className":"moment","children":[["$","$L22",null,{"seconds":683,"label":"11:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan reports from the steamer Commodore"}],["$","p",null,{"children":"On April 1, after embarkation was underway, McClellan sent the War Department his first detailed accounting of the troops assigned to Washington and its approaches."}]]}]]}],["$","div","The 73,456 total",{"className":"moment","children":[["$","$L22",null,{"seconds":715,"label":"11:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 73,456 total"}],["$","p",null,{"children":"McClellan combined troops assigned or intended for Washington, Manassas, Warrenton, the lower Potomac, and the Shenandoah Valley into one regional defense figure."}]]}]]}],["$","div","The location of the troops matters",{"className":"moment","children":[["$","$L22",null,{"seconds":787,"label":"13:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"The location of the troops matters"}],"$L23"]}]]}],"$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b"]}]]}]
1c:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","President and constitutional commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and constitutional commander in chief"}],["$","span",null,{"children":"Abraham Lincoln"}],["$","small",null,{"children":"Approved the Fort Monroe operation on conditions, changed the national command structure, and ordered one corps retained near Washington"}]]}],["$","div","Secretary of War",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of War"}],["$","span",null,{"children":"Edwin M. Stanton"}],["$","small",null,{"children":"Transmitted Lincoln’s directions, ordered an official review of the April 1–2 reports, and administered the decision to detach I Corps"}]]}],["$","div","Commander, Army of the Potomac and Department of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Army of the Potomac and Department of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Commanded the Peninsula expedition after March 11 and submitted the disputed April 1 force accounting"}]]}],["$","div","Commander, I Corps; then Department of the Rappahannock",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, I Corps; then Department of the Rappahannock"}],["$","span",null,{"children":"Irvin McDowell"}],["$","small",null,{"children":"His corps was detached from McClellan and retained in northern Virginia for Washington’s security"}]]}],["$","div","Military governor and commander, Military District of Washington",{"className":"command-entry","children":[["$","strong",null,{"children":"Military governor and commander, Military District of Washington"}],["$","span",null,{"children":"James S. Wadsworth"}],["$","small",null,{"children":"Reported the strength, condition, and artillery limitations of the troops immediately under his command"}]]}],["$","div","Commander, V Corps in the Shenandoah Valley",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, V Corps in the Shenandoah Valley"}],["$","span",null,{"children":"Nathaniel P. Banks"}],["$","small",null,{"children":"His field force was included in McClellan’s regional total even though Thomas and Hitchcock did not decide whether it was available for Washington’s immediate defense"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","President and commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander in chief"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Directed Confederate national policy and the defense of Richmond"}]]}],["$","div","Commander, Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Army of Northern Virginia"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"Shifted the main Confederate field army toward the Peninsula while Lincoln considered the northern approaches to Washington"}]]}],["$","div","Commander, Army of the Peninsula",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Army of the Peninsula"}],["$","span",null,{"children":"John B. Magruder"}],["$","small",null,{"children":"Held the Yorktown–Warwick line with roughly 11,000 troops before Johnston’s reinforcements arrived"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":["$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35"]}]]}]
1d:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep131-george-mcclellan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep131-george-mcclellan.jpg","alt":"George B. McClellan standing in uniform in an 1861 carte de visite","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"McClellan combined army organization, personal appearances, and paternal language to build strong loyalty among many Army of the Potomac soldiers."}]]}],["$","figure","/images/ep131-irvin-mcdowell.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep131-irvin-mcdowell.jpg","alt":"Major General Irvin McDowell seated in uniform during the Civil War","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"McDowell commanded I Corps, the formation the War Department detached from McClellan and retained in northern Virginia."}]]}],["$","figure","/images/ep131-james-wadsworth.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep131-james-wadsworth.jpg","alt":"Three exposures on one glass negative showing Brigadier General James S. Wadsworth seated in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Wadsworth’s April 2 report distinguished the troops immediately under his command from McClellan’s wider regional total and emphasized their limited preparation."}]]}],["$","figure","/images/ep131-mcclellan-yorktown-headquarters.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep131-mcclellan-yorktown-headquarters.jpg","alt":"Tents and soldiers at George B. McClellan’s headquarters near Yorktown on May 3, 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"McClellan’s headquarters at Camp Winfield Scott near Yorktown on May 3, the eve of the Confederate withdrawal from the Warwick line."}]]}],["$","figure","/images/ep131-peninsula-map-1862.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep131-peninsula-map-1862.jpg","alt":"Printed 1862 map of Richmond, the Virginia Peninsula, and the York and James Rivers","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A contemporary map records the water routes and Peninsula geography that separated McClellan’s field army from the forces retained near Washington."}]]}]]}]]}]
