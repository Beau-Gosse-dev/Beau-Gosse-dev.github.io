1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",131," · ","March 11–April 5, 1862"," · ","Washington, D.C.; Alexandria, Manassas, and Warrenton, Virginia; the Shenandoah Valley; and the Virginia Peninsula from Fort Monroe to Yorktown"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN (Part the Second)"}],["$","span",null,{"className":"result-label","children":"McClellan moved the Army of the Potomac to the Peninsula while presenting the soldiers as a force personally connected to him. His April 1 accounting treated troops at Washington, Manassas, Warrenton, the lower Potomac, and in the Shenandoah Valley as part of a 73,456-man defensive system. James Wadsworth reported that only 19,022 troops were present for duty under his immediate command at Washington and that further detachments had been ordered. After Lorenzo Thomas and Ethan Allen Hitchcock concluded that Lincoln’s security requirement had not been fully met, Lincoln and Stanton retained Irvin McDowell’s I Corps in northern Virginia instead of sending it to McClellan. The decision reduced the reinforcements then expected on the Peninsula, but it does not by itself explain McClellan’s decision to besiege Yorktown"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6193203887.mp3?updated=1695219966","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode focus",{"children":[["$","span",null,{"children":"Episode focus"}],["$","strong",null,{"children":"Army loyalty, Washington’s security, and McDowell’s I Corps"}],["$","small",null,{"children":"The episode pauses the battlefield narrative to examine command relationships and force allocation."}]]}],["$","div","McClellan’s army address",{"children":[["$","span",null,{"children":"McClellan’s army address"}],["$","strong",null,{"children":"Dated March 14, 1862, at Fairfax Court House"}],["$","small",null,{"children":"The transcript associates the address with the March 17 start of embarkation, but surviving printed texts date the address March 14."}]]}],["$","div","Command change",{"children":[["$","span",null,{"children":"Command change"}],["$","strong",null,{"children":"McClellan ceased serving as general-in-chief on March 11"}],["$","small",null,{"children":"Lincoln’s Special War Order No. 3 left him in command of the Department and Army of the Potomac."}]]}],["$","div","Lincoln’s condition",{"children":[["$","span",null,{"children":"Lincoln’s condition"}],["$","strong",null,{"children":"Washington had to be left “entirely secure”"}],["$","small",null,{"children":"The March 8 order required the general-in-chief and corps commanders to agree that the capital was secure; Stanton repeated the condition on March 13."}]]}],["$","div","Corps commanders’ estimates",{"children":[["$","span",null,{"children":"Corps commanders’ estimates"}],"$Le","$Lf"]}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18"]}],"$L19","$L1a","$L1b","$L1c",false,"$L1d","$L1e","$L1f"]}]]}]
22:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","strong",null,{"children":"40,000 at the low end; about 55,000 under the majority formula"}]
f:["$","small",null,{"children":"Sumner proposed 40,000. Keyes, Heintzelman, and McDowell called for fully garrisoning the forts, occupying the remaining forts, and adding a 25,000-man covering force. Thomas and Hitchcock interpreted that formula as about 55,000 in all."}]
10:["$","div","McClellan’s April 1 total",{"children":[["$","span",null,{"children":"McClellan’s April 1 total"}],["$","strong",null,{"children":"73,456 men"}],["$","small",null,{"children":"The total combined 18,000 for Washington, 10,859 at Manassas, 7,780 at Warrenton, 35,467 in the Shenandoah Valley, and 1,350 on the lower Potomac."}]]}]
11:["$","div","Why the total was disputed",{"children":[["$","span",null,{"children":"Why the total was disputed"}],["$","strong",null,{"children":"It mixed immediate, distant, and proposed forces"}],["$","small",null,{"children":"McClellan’s report described several concentrations as what “will” or “are to” be present. Thomas and Hitchcock declined to decide whether Banks’s force in the Shenandoah could count toward Washington’s immediate defense."}]]}]
12:["$","div","Wadsworth’s April 2 return",{"children":[["$","span",null,{"children":"Wadsworth’s April 2 return"}],["$","strong",null,{"children":"19,022 present for duty"}],["$","small",null,{"children":"Wadsworth reported that nearly all were new and imperfectly disciplined, that he had no mounted light artillery under his command, and that he had orders to send additional regiments and 4,000 men away."}]]}]
13:["$","div","Official review",{"children":[["$","span",null,{"children":"Official review"}],["$","strong",null,{"children":"Security requirement not fully complied with"}],["$","small",null,{"children":"Adjutant General Lorenzo Thomas and Major General Ethan Allen Hitchcock reached this conclusion on April 2 after reviewing McClellan’s and Wadsworth’s reports."}]]}]
14:["$","div","Decision on I Corps",{"children":[["$","span",null,{"children":"Decision on I Corps"}],["$","strong",null,{"children":"Ordered retained April 3–4; McClellan learned of it April 5"}],["$","small",null,{"children":"Lincoln first directed that either McDowell’s or Sumner’s corps remain in front of Washington. The War Department then notified McClellan that McDowell’s corps was detached because the force left near Washington was considered insufficient."}]]}]
15:["$","div","Yorktown forces",{"children":[["$","span",null,{"children":"Yorktown forces"}],["$","strong",null,{"children":"About 58,000 United States troops initially available against roughly 11,000 Confederates"}],["$","small",null,{"children":"These are approximate early-April figures from U.S. Army and National Park Service histories. Both armies received additional troops; Magruder’s command was later absorbed into Johnston’s much larger force."}]]}]
16:["$","div","Effect on the siege",{"children":[["$","span",null,{"children":"Effect on the siege"}],["$","strong",null,{"children":"Reduced expected reinforcements, but causation remains interpretive"}],["$","small",null,{"children":"McClellan later called the decision a fatal error. The episode follows Stephen W. Sears in arguing that it did not dictate the choice to besiege Yorktown. That counterfactual judgment cannot be proved from the orders alone."}]]}]
17:["$","div","Combat and leader losses in this episode",{"children":[["$","span",null,{"children":"Combat and leader losses in this episode"}],["$","strong",null,{"children":"None"}],["$","small",null,{"children":"No battle is narrated and no senior leader is killed or mortally wounded during the events covered here."}]]}]
18:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"Forward to Richmond: McClellan’s Peninsula Campaign by Ronald H. Bailey and the Editors of Time-Life Books"}],"$undefined"]}]
