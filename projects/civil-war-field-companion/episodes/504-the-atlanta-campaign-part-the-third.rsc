14:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L1b",null,{"guide":{"date":"January–February 1864","place":"Vicksburg, Meridian, Dalton, and the western theater","result":"Grant used Sherman’s Meridian expedition to reduce Confederate pressure on the Mississippi River and prepare for the spring campaign; the episode also explains how Sherman recovered from his 1861 command failure and became Grant’s trusted subordinate","facts":[{"label":"Meridian expedition departed","value":"February 3, 1864"},{"label":"Vicksburg to Meridian","value":"About 150 miles"},{"label":"Sherman’s main force","value":"About 25,000 men"},{"label":"Sherman’s age","value":"43; turned 44 on February 8"},{"label":"Army of the Tennessee command","value":"Since October 1863"}],"maps":[{"title":"Vicksburg to Meridian today","caption":"Sherman’s two infantry columns left Vicksburg, converged around Jackson, and continued east to the Confederate railroad center at Meridian.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-91.10%2C31.70%2C-88.45%2C33.10&layer=mapnik&marker=32.364%2C-88.704"},{"title":"The Vicksburg–Jackson road and rail network","caption":"This U.S. Army map records the roads, railroads, rivers, and terrain between Vicksburg and Jackson. Sherman reused this corridor when he began the Meridian expedition in February 1864.","source":"https://www.loc.gov/item/99447408/","image":"/images/vicksburg-jackson-route-map.jpg","alt":"Historical map of the country between Vicksburg and Jackson, Mississippi"},{"title":"Sherman’s western theater before Atlanta","caption":"The places that shaped Sherman’s wartime recovery stretched from Shiloh and Vicksburg to Chattanooga. Grant placed him in increasingly important commands across this theater.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-92.30%2C31.50%2C-84.20%2C36.10&layer=mapnik&marker=35.045%2C-85.309"}],"moments":[{"time":"1:39","audioTime":99,"title":"The narrative returned to early 1864","detail":"Both sides were repairing railroad supply systems and preparing for the campaign that would begin in May."},{"time":"3:29","audioTime":209,"title":"Johnston took command at Dalton","detail":"Jefferson Davis appointed Joseph E. Johnston to rebuild the Army of Tennessee despite their mutual distrust."},{"time":"4:25","audioTime":265,"title":"Johnston rebuilt the army without an agreed strategy","detail":"He improved supply, condition, and morale while Davis declined to engage with his strategic proposals."},{"time":"5:09","audioTime":309,"title":"Grant prepared the western flank","detail":"Before advancing into Georgia, Grant wanted to prevent Confederate forces in Mississippi from threatening river traffic or the railroads from Nashville."},{"time":"6:07","audioTime":367,"title":"Grant approved the Meridian expedition","detail":"The operation was intended to damage Mississippi railroads enough to prevent a large Confederate concentration in the state."},{"time":"6:30","audioTime":390,"title":"Sherman commanded the raid","detail":"William T. Sherman led the operation east from Vicksburg with the Army of the Tennessee."},{"time":"6:45","audioTime":405,"title":"Sherman warned Mississippi residents","detail":"Before departure, he ordered a public warning that U.S. forces were about to enter the interior of the state."},{"time":"7:06","audioTime":426,"title":"The columns left Vicksburg","detail":"Sherman departed on February 3, three days before the podcast narrative places his forty-fourth birthday."},{"time":"7:38","audioTime":458,"title":"Sherman commanded Grant’s former army","detail":"He had led the Army of the Tennessee since October 1863, after its victories at Donelson, Shiloh, Corinth, Champion Hill, and Vicksburg."},{"time":"8:22","audioTime":502,"title":"Sherman had failed in Kentucky","detail":"In late 1861 he overestimated Confederate strength, requested unrealistic reinforcements, and was replaced by Don Carlos Buell."},{"time":"9:18","audioTime":558,"title":"Halleck relieved Sherman in Missouri","detail":"A second command crisis led Halleck to judge him temporarily unfit for duty."},{"time":"9:46","audioTime":586,"title":"Sherman returned home to recover","detail":"Ellen Sherman took him to Ohio after newspaper reports described him as mentally ill and his confidence collapsed."},{"time":"10:18","audioTime":618,"title":"Halleck returned Sherman to limited duty","detail":"At the start of 1862, Sherman resumed service by drilling recruits in St. Louis."},{"time":"12:16","audioTime":736,"title":"His prewar career had been unstable","detail":"Sherman resigned from the Army in 1853, then failed in banking and real-estate work before finding success at a Louisiana military academy."},{"time":"13:17","audioTime":797,"title":"Sherman returned to military service in 1861","detail":"He was running a St. Louis streetcar company when the war began and received a commission with help from his brother John Sherman."},{"time":"15:12","audioTime":912,"title":"Halleck assigned Sherman to Grant","detail":"In February 1862, Sherman received a division under the general who had just captured Fort Donelson."},{"time":"16:06","audioTime":966,"title":"Sherman’s battlefield record remained mixed","detail":"He fought well after the surprise at Shiloh but later failed at Chickasaw Bluffs and in his attack at Missionary Ridge."},{"time":"16:48","audioTime":1008,"title":"Grant and Sherman developed mutual trust","detail":"During twenty-two months of service together, Grant provided steady direction and Sherman became a dependable subordinate."},{"time":"18:02","audioTime":1082,"title":"Grant gave Sherman the Army of the Tennessee","detail":"When Grant became commander of the Military Division of the Mississippi, he selected Sherman to lead his former army."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"Ulysses S. Grant","command":"Military Division of the Mississippi","subordinates":"Authorized the Meridian expedition and prepared the western armies for the 1864 campaigns"},{"commander":"William T. Sherman","command":"Army of the Tennessee","subordinates":"Directed the Meridian expedition from Vicksburg"},{"commander":"Stephen A. Hurlbut","command":"XVI Corps expeditionary column","subordinates":"Led the northern of Sherman’s two infantry columns"},{"commander":"James B. McPherson","command":"XVII Corps expeditionary column","subordinates":"Led the southern infantry column"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Jefferson Davis","command":"Confederate president","subordinates":"Appointed Johnston and set national strategy"},{"commander":"Joseph E. Johnston","command":"Army of Tennessee at Dalton","subordinates":"Rebuilt the army while awaiting the U.S. advance"},{"commander":"Leonidas Polk","command":"Department of Alabama, Mississippi, and East Louisiana","subordinates":"Commanded the Confederate forces opposing the Meridian expedition"}]}],"people":[{"name":"William T. Sherman","role":"Led the Meridian expedition and had become Grant’s trusted army commander after serious failures in 1861","side":"United States","image":"/images/william-t-sherman.jpg","source":"https://www.loc.gov/item/93500723/"},{"personId":"ulysses-s-grant","role":"Steadied Sherman, promoted him through increasingly important commands, and approved the Meridian expedition"},{"name":"Henry W. Halleck","role":"Relieved Sherman in 1861, returned him to duty, and assigned him to serve under Grant","side":"United States"},{"name":"Ellen Ewing Sherman","role":"Helped Sherman return to Ohio during his 1861 breakdown","side":"United States"},{"name":"John Sherman","role":"U.S. senator and Sherman’s younger brother; helped him obtain a wartime commission","side":"United States"},{"name":"Joseph E. Johnston","role":"Rebuilt the Army of Tennessee at Dalton without resolving his strategic dispute with Davis","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"Leonidas Polk","role":"Commanded Confederate forces in Mississippi during Sherman’s advance on Meridian","side":"Confederacy","image":"/images/leonidas-polk.jpg","source":"https://www.loc.gov/pictures/item/2018666546/"}],"losses":[],"gallery":[{"image":"/images/vicksburg-jackson-route-map.jpg","alt":"Historical map of roads and railroads between Vicksburg and Jackson","caption":"Sherman’s February 1864 expedition followed the established eastward corridor from Vicksburg through Jackson before continuing to Meridian.","source":"https://www.loc.gov/item/99447408/"},{"image":"/images/william-t-sherman.jpg","alt":"Portrait of William T. Sherman","caption":"Sherman led the Army of the Tennessee and the Meridian expedition.","source":"https://www.loc.gov/item/93500723/"},{"image":"/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","caption":"Grant’s confidence and direction were central to Sherman’s return to high command.","source":"https://www.loc.gov/item/2018666428/"},{"image":"/images/leonidas-polk.jpg","alt":"Portrait of Leonidas Polk","caption":"Polk commanded the Confederate department that included Mississippi and Meridian.","source":"https://www.loc.gov/pictures/item/2018666546/"}],"sources":[{"label":"Official Episode 504 page","url":"https://civilwarpodcast.org/2025/09/07/civil-war-podcast-episode-504/"},{"label":"U.S. Army Center of Military History, Campaigns in Mississippi and Tennessee","url":"https://history.army.mil/Publications/Publications-Catalog/Campaigns-in-Mississippi-and-Tennessee/"},{"label":"National Park Service Meridian campaign summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=MS012"},{"label":"Library of Congress William T. Sherman portrait","url":"https://www.loc.gov/item/93500723/"},{"label":"Library of Congress Vicksburg–Jackson campaign map","url":"https://www.loc.gov/item/99447408/"},{"label":"Library of Congress William T. Sherman papers","url":"https://www.loc.gov/item/mss398000137/"}]}}]}]
