19:["$","div","Halleck returned Sherman to limited duty",{"className":"moment","children":[["$","$L16",null,{"seconds":618,"label":"10:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck returned Sherman to limited duty"}],["$","p",null,{"children":"At the start of 1862, Sherman resumed service by drilling recruits in St. Louis."}]]}]]}]
1a:["$","div","His prewar career had been unstable",{"className":"moment","children":[["$","$L16",null,{"seconds":736,"label":"12:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"His prewar career had been unstable"}],["$","p",null,{"children":"Sherman resigned from the Army in 1853, then failed in banking and real-estate work before finding success at a Louisiana military academy."}]]}]]}]
1b:["$","div","Sherman returned to military service in 1861",{"className":"moment","children":[["$","$L16",null,{"seconds":797,"label":"13:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman returned to military service in 1861"}],["$","p",null,{"children":"He was running a St. Louis streetcar company when the war began and received a commission with help from his brother John Sherman."}]]}]]}]
