1e:["$","div","Grant and Sherman developed mutual trust",{"className":"moment","children":[["$","$L16",null,{"seconds":1008,"label":"16:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant and Sherman developed mutual trust"}],["$","p",null,{"children":"During twenty-two months of service together, Grant provided steady direction and Sherman became a dependable subordinate."}]]}]]}]
