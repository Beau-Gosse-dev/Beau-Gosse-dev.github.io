10:["$","figure","Sherman’s western theater before Atlanta",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-92.30%2C31.50%2C-84.20%2C36.10&layer=mapnik&marker=35.045%2C-85.309","title":"Sherman’s western theater before Atlanta","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Sherman’s western theater before Atlanta"}],["$","span",null,{"children":"The places that shaped Sherman’s wartime recovery stretched from Shiloh and Vicksburg to Chattanooga. Grant placed him in increasingly important commands across this theater."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:3:props:children:1:props:children:0:props:children:1:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The narrative returned to early 1864",{"className":"moment","children":[["$","$L16",null,{"seconds":99,"label":"1:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The narrative returned to early 1864"}],["$","p",null,{"children":"Both sides were repairing railroad supply systems and preparing for the campaign that would begin in May."}]]}]]}],["$","div","Johnston took command at Dalton",{"className":"moment","children":[["$","$L16",null,{"seconds":209,"label":"3:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston took command at Dalton"}],["$","p",null,{"children":"Jefferson Davis appointed Joseph E. Johnston to rebuild the Army of Tennessee despite their mutual distrust."}]]}]]}],["$","div","Johnston rebuilt the army without an agreed strategy",{"className":"moment","children":[["$","$L16",null,{"seconds":265,"label":"4:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston rebuilt the army without an agreed strategy"}],["$","p",null,{"children":"He improved supply, condition, and morale while Davis declined to engage with his strategic proposals."}]]}]]}],["$","div","Grant prepared the western flank",{"className":"moment","children":[["$","$L16",null,{"seconds":309,"label":"5:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant prepared the western flank"}],["$","p",null,{"children":"Before advancing into Georgia, Grant wanted to prevent Confederate forces in Mississippi from threatening river traffic or the railroads from Nashville."}]]}]]}],["$","div","Grant approved the Meridian expedition",{"className":"moment","children":[["$","$L16",null,{"seconds":367,"label":"6:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant approved the Meridian expedition"}],["$","p",null,{"children":"The operation was intended to damage Mississippi railroads enough to prevent a large Confederate concentration in the state."}]]}]]}],["$","div","Sherman commanded the raid",{"className":"moment","children":[["$","$L16",null,{"seconds":390,"label":"6:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman commanded the raid"}],["$","p",null,{"children":"William T. Sherman led the operation east from Vicksburg with the Army of the Tennessee."}]]}]]}],["$","div","Sherman warned Mississippi residents",{"className":"moment","children":[["$","$L16",null,{"seconds":405,"label":"6:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman warned Mississippi residents"}],["$","p",null,{"children":"Before departure, he ordered a public warning that U.S. forces were about to enter the interior of the state."}]]}]]}],["$","div","The columns left Vicksburg",{"className":"moment","children":[["$","$L16",null,{"seconds":426,"label":"7:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The columns left Vicksburg"}],["$","p",null,{"children":"Sherman departed on February 3, three days before the podcast narrative places his forty-fourth birthday."}]]}]]}],["$","div","Sherman commanded Grant’s former army",{"className":"moment","children":[["$","$L16",null,{"seconds":458,"label":"7:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman commanded Grant’s former army"}],["$","p",null,{"children":"He had led the Army of the Tennessee since October 1863, after its victories at Donelson, Shiloh, Corinth, Champion Hill, and Vicksburg."}]]}]]}],["$","div","Sherman had failed in Kentucky",{"className":"moment","children":[["$","$L16",null,{"seconds":502,"label":"8:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman had failed in Kentucky"}],["$","p",null,{"children":"In late 1861 he overestimated Confederate strength, requested unrealistic reinforcements, and was replaced by Don Carlos Buell."}]]}]]}],["$","div",