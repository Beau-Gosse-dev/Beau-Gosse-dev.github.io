21:["$","span",null,{"children":"Gen. Robert E. Lee"}]
22:["$","small",null,{"children":"Chose to stand west of Antietam Creek, placed Jackson on the left and Longstreet on the right, and called the remaining Harpers Ferry detachments to Sharpsburg"}]
23:["$","div","Left Wing-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Arrived from Harpers Ferry on September 16 and took position from the Dunker Church area toward Nicodemus Heights"}]]}]
24:["$","div","Right Wing-Maj. Gen. James Longstreet",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Held the roads, ridges, and approaches around Sharpsburg and extended the defense south toward the lower Antietam"}]]}]
25:["$","div","Hill’s Division, Confederate center-Maj. Gen. D. H. Hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Hill’s Division, Confederate center"}],["$","span",null,{"children":"Maj. Gen. D. H. Hill"}],["$","small",null,{"children":"Occupied ground connecting Jackson and Longstreet near the Hagerstown Turnpike, Roulette farm, and roads north of Sharpsburg"}]]}]
