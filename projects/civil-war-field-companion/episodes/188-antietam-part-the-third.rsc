18:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L2b","/images/ep188-mcclellan-looking-at-fight.jpg",{"image":"/images/ep188-mcclellan-looking-at-fight.jpg","alt":"Alfred Waud pencil drawing of McClellan and staff observing the Antietam battlefield from horseback.","caption":"Alfred R. Waud drew “McClellan looking at the fight” on September 17. The work is a participant-era record of the commander observing the field, one day after the reconnaissance and decisions covered in this episode.","name":"Alfred Waud pencil drawing of McClellan and staff observing the Antietam battlefield from horseback.","source":"$undefined","credit":"Library of Congress, Morgan collection of Civil War drawings; see sources below."}],["$","$L2b","/images/ep188-dunker-church.jpg",{"image":"/images/ep188-dunker-church.jpg","alt":"Alexander Gardner photograph of the Dunker Church and fallen Confederate artillerymen after the Battle of Antietam.","caption":"Alexander Gardner photographed the Dunker Church after the battle with dead Confederate artillerymen in the foreground. The image records the landmark whose plateau anchored the northern battlefield described in the episode.","name":"Alexander Gardner photograph of the Dunker Church and fallen Confederate artillerymen after the Battle of Antietam.","source":"$undefined","credit":"Library of Congress, Civil War Glass Negatives and Related Prints; see sources below."}]]}]]}]
