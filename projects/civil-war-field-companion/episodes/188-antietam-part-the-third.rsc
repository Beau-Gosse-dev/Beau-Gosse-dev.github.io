1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",188," · ","September 16, 1862"," · ","Sharpsburg and Keedysville, Maryland, with the Army of Northern Virginia on the ridge between Antietam Creek and the Potomac River and the Army of the Potomac concentrating east of the creek"]}],["$","h1",null,{"children":"ANTIETAM (Part the Third)"}],["$","span",null,{"className":"result-label","children":"The armies concentrated for battle without a general engagement on September 16. George B. McClellan postponed his main attack until September 17 while Robert E. Lee strengthened a four-mile defensive line west of Antietam Creek. Thomas J. “Stonewall” Jackson and John G. Walker reached Lee during the day; late in the day, elements of the United States I and XII Corps crossed the creek and made contact with the Confederate left"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6782571303.mp3?updated=1695462548","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The armies at Sharpsburg on Tuesday, September 16, 1862"}],["$","small",null,{"children":"The episode explains McClellan’s decision not to attack on September 15 or 16, Lee’s decision to stand, and the terrain and Confederate positions. McClellan’s full battle plan is reserved for the next episode."}]]}],["$","div","Morning conditions",{"children":[["$","span",null,{"children":"Morning conditions"}],["$","strong",null,{"children":"Heavy fog concealed the Confederate position"}],["$","small",null,{"children":"At 7 a.m. McClellan informed Henry W. Halleck that the fog had prevented him from determining Lee’s strength and that he would attack after the situation developed."}]]}],["$","div","McClellan’s expectation",{"children":[["$","span",null,{"children":"McClellan’s expectation"}],["$","strong",null,{"children":"Lee might have withdrawn during the night"}],["$","small",null,{"children":"When the fog cleared, the Army of Northern Virginia remained on the heights west of Antietam Creek."}]]}],["$","div","Morning force estimate in the episode",{"children":[["$","span",null,{"children":"Morning force estimate in the episode"}],["$","strong",null,{"children":"About 40,000 United States troops near roughly 15,000 Confederates"}],["$","small",null,{"children":"These are the episode’s estimates for troops immediately available early on September 16, not final battle strengths. Strength figures vary according to time and whether present, effective, or engaged personnel are counted."}]]}],["$","div","McClellan’s estimate of Lee",{"children":[["$","span",null,{"children":"McClellan’s estimate of Lee"}],["$","strong",null,{"children":"At least 30,000 at Sharpsburg and 40,000–50,000 at Harpers Ferry"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],"$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a"]}]]}]
2d:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"The estimate greatly overstated both parts of Lee’s divided army and made a Confederate reinforcement or flank attack through Pleasant Valley appear more dangerous than it was."}]
f:["$","div","Franklin’s position",{"children":[["$","span",null,{"children":"Franklin’s position"}],["$","strong",null,{"children":"VI Corps remained in Pleasant Valley for most of September 16"}],["$","small",null,{"children":"McClellan retained William B. Franklin west of South Mountain to watch for a Confederate move from Harpers Ferry. He ordered the corps toward Sharpsburg at 6 p.m."}]]}]
10:["$","div","Jackson as the perceived threat",{"children":[["$","span",null,{"children":"Jackson as the perceived threat"}],["$","strong",null,{"children":"Reinforce Lee, strike Franklin, or attempt both"}],["$","small",null,{"children":"McClellan did not know how quickly Jackson could move after the surrender of Harpers Ferry and treated the Confederate wing as a possible threat to either front."}]]}]
11:["$","div","United States concentration",{"children":[["$","span",null,{"children":"United States concentration"}],["$","strong",null,{"children":"Nearly 60,000 troops by the end of September 16 in the episode’s estimate"}],["$","small",null,{"children":"Most of the Army of the Potomac was within supporting distance by Tuesday evening, apart from Franklin’s VI Corps moving from Pleasant Valley."}]]}]
12:["$","div","Confederate concentration",{"children":[["$","span",null,{"children":"Confederate concentration"}],["$","strong",null,{"children":"No more than about 25,000 after Jackson’s arrival in the episode’s estimate"}],["$","small",null,{"children":"Jackson and Walker reached Sharpsburg during September 16. McLaws and A. P. Hill were still returning from Harpers Ferry and would arrive on September 17."}]]}]
13:["$","div","Decision by noon",{"children":[["$","span",null,{"children":"Decision by noon"}],["$","strong",null,{"children":"The general assault was scheduled for September 17"}],["$","small",null,{"children":"After reconnaissance and consideration during the morning, McClellan circulated orders shortly after noon for an attack the next day."}]]}]
14:["$","div","Operational consequence of delay",{"children":[["$","span",null,{"children":"Operational consequence of delay"}],["$","strong",null,{"children":"McClellan lost a chance to attack a smaller part of Lee’s army"}],["$","small",null,{"children":"The delay also allowed the Army of the Potomac to concentrate and placed nearly all of Lee’s army within reach on September 17. This was an unintended consequence, not McClellan’s stated reason for waiting."}]]}]
15:["$","div","Lee’s decision",{"children":[["$","span",null,{"children":"Lee’s decision"}],["$","strong",null,{"children":"Stand at Sharpsburg instead of withdrawing across the Potomac"}],["$","small",null,{"children":"Lee sought to recover the initiative after South Mountain and believed McClellan would return to cautious methods. The episode presents this as a calculated risk rather than a position forced by geography alone."}]]}]
16:["$","div","Risk to Lee",{"children":[["$","span",null,{"children":"Risk to Lee"}],["$","strong",null,{"children":"A divided, depleted army with the Potomac at its back"}],["$","small",null,{"children":"Confederate troops were exhausted and reduced by straggling and desertion. Boteler’s Ford near Shepherdstown was the principal nearby route of retreat."}]]}]
17:["$","div","Defensive line",{"children":[["$","span",null,{"children":"Defensive line"}],["$","strong",null,{"children":"An arc about four miles long from northwest of Sharpsburg to the lower Antietam"}],["$","small",null,{"children":"Lee used the ridges west of the creek. Jackson commanded the left, Longstreet the right, and the Hagerstown Turnpike corridor linked the northern battlefield to Sharpsburg."}]]}]
18:["$","div","Northern anchor",{"children":[["$","span",null,{"children":"Northern anchor"}],["$","strong",null,{"children":"Nicodemus Heights"}],["$","small",null,{"children":"J. E. B. Stuart’s cavalry and horse artillery occupied the high ground northwest of the Dunker Church. Jubal A. Early’s infantry brigade also supported this critical sector."}]]}]
19:["$","div","Dunker Church plateau",{"children":[["$","span",null,{"children":"Dunker Church plateau"}],["$","strong",null,{"children":"Key high ground at the Hagerstown Turnpike and Smoketown Road"}],["$","small",null,{"children":"United States artillery placed there could fire along the Confederate line north of Sharpsburg. The church had been built for the German Baptist Brethren in 1852–53 on land donated by Samuel Mumma."}]]}]
1a:["$","div","Northern approach",{"children":[["$","span",null,{"children":"Northern approach"}],["$","strong",null,{"children":"A 400–500-yard corridor between the East and West Woods"}],["$","small",null,{"children":"Miller’s cornfield obstructed much of the open approach north of the church. Hollows, rises, stone outcrops, crops, and woodlots limited observation across terrain that appeared open from the Federal side."}]]}]
1b:["$","div","Center of the line",{"children":[["$","span",null,{"children":"Center of the line"}],["$","strong",null,{"children":"The Roulette farm marked the bend between sectors"}],["$","small",null,{"children":"From Jackson’s left the Confederate position turned south toward D. H. Hill’s and Longstreet’s troops covering the roads and high ground around Sharpsburg."}]]}]
1c:["$","div","Southern outpost",{"children":[["$","span",null,{"children":"Southern outpost"}],["$","strong",null,{"children":"Robert Toombs’s brigade above the Rohrbach Bridge"}],["$","small",null,{"children":"The brigade was positioned forward to delay a United States crossing. Snavely’s Ford farther south offered a route around the bridge position."}]]}]
1d:["$","div","Evening contact",{"children":[["$","span",null,{"children":"Evening contact"}],["$","strong",null,{"children":"I and XII Corps crossed the upper Antietam and skirmished with Lee’s left"}],["$","small",null,{"children":"The National Park Service timeline places contact at about 6 p.m. This limited action set the northern approach for the battle but did not become a general engagement on September 16."}]]}]
1e:["$","div","McClellan’s command test",{"children":[["$","span",null,{"children":"McClellan’s command test"}],["$","strong",null,{"children":"His first major battle planned and directed from start to finish"}],["$","small",null,{"children":"Earlier major engagements under McClellan had generally placed the Confederates on the tactical offensive or left detailed battlefield direction to subordinate commanders."}]]}]
1f:["$","div","Pressure from Washington",{"children":[["$","span",null,{"children":"Pressure from Washington"}],["$","strong",null,{"children":"Lincoln urged McClellan to destroy Lee’s army if possible"}],["$","small",null,{"children":"A September 15 telegram congratulated McClellan but emphasized the unfinished task. Winfield Scott’s message the next day likewise treated South Mountain as only part of the campaign."}]]}]
20:["$","div","Senior leader casualties in scope",{"children":[["$","span",null,{"children":"Senior leader casualties in scope"}],["$","strong",null,{"children":"No senior leader was killed or mortally wounded on September 16"}],["$","small",null,{"children":"Jesse L. Reno’s mortal wound at Fox’s Gap on September 14 remained operationally important because Jacob D. Cox commanded IX Corps at Antietam."}]]}]
21:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The Battle of Antietam: The Bloodiest Day” by Ted Alexander"}],["$","small",null,{"children":"The episode recommends the Antietam National Battlefield historian’s study for its attention to the battle, Sharpsburg’s civilians, and battlefield preservation."}]]}]
22:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Halleck, Harpers Ferry, Boteler’s Ford, Nicodemus Heights, Dunker Church, Mumma, Roulette, Rohrbach Bridge, and Snavely’s Ford"}],["$","small",null,{"children":"The automated transcript produces phonetic forms including “Hallock,” “Harper’s Ferry,” “Bottler’s forward,” “Roulette,” and “Rohrbach.” This guide uses standard historical spellings and “Dunker Church,” the National Park Service form."}]]}]
23:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
24:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The armies concentrate at Sharpsburg",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep188-september-16-concentration.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The armies concentrate at Sharpsburg at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep188-september-16-concentration.svg","alt":"Schematic regional map of Confederate reinforcements moving from Harpers Ferry and Shepherdstown to Lee at Sharpsburg while the Army of the Potomac concentrates from Keedysville and Franklin’s Sixth Corps remains in Pleasant Valley.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The armies concentrate at Sharpsburg"}],["$","span",null,{"children":"On September 16, Jackson and Walker marched from Harpers Ferry and Shepherdstown to reinforce Lee west of Antietam Creek. Franklin’s VI Corps remained in Pleasant Valley until McClellan ordered it toward Sharpsburg at 6 p.m., while the rest of the Army of the Potomac concentrated from Keedysville. Routes and positions are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep188-september-16-concentration.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield timeline, U.S. Army Center of Military History, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Lee’s defensive ground west of Antietam Creek",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep188-confederate-defensive-line.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Lee’s defensive ground west of Antietam Creek at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep188-confederate-defensive-line.svg","alt":"Schematic battlefield map showing Jackson on the Confederate left near Nicodemus Heights and Dunker Church, Longstreet on the right through Sharpsburg, Antietam Creek and its bridges, Snavely’s Ford, and Boteler’s Ford across the Potomac.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Lee’s defensive ground west of Antietam Creek"}],["$","span",null,{"children":"Lee’s line curved from Nicodemus Heights and the Dunker Church plateau through the Roulette farm area and Sharpsburg to the high ground above the lower bridge. The Potomac behind the army and Boteler’s Ford to the south made the southern end of the line essential. Terrain and unit footprints are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep188-confederate-defensive-line.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$24:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield, Antietam Battlefield Board atlas, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2b"]}]]}],"$undefined"]}]]}],"$L2c"]}]]}]
25:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The September 15 situation is recapped",{"className":"moment","children":[["$","$L2d",null,{"seconds":70,"label":"1:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The September 15 situation is recapped"}],["$","p",null,{"children":"Harpers Ferry has surrendered, Lee has chosen to stand at Sharpsburg, and the Army of the Potomac has reached Antietam Creek."}]]}]]}],["$","div","Fog hides Lee’s position",{"className":"moment","children":[["$","$L2d",null,{"seconds":212,"label":"3:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fog hides Lee’s position"}],["$","p",null,{"children":"The morning of September 16 opens quietly under heavy fog, and McClellan initially considers whether Lee has withdrawn."}]]}]]}],["$","div","McClellan reports to Halleck",{"className":"moment","children":[["$","$L2d",null,{"seconds":242,"label":"4:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan reports to Halleck"}],["$","p",null,{"children":"At 7 a.m. McClellan says he cannot yet determine the Confederate strength and will attack after the situation develops."}]]}]]}],["$","div","The early numerical opportunity is stated",{"className":"moment","children":[["$","$L2d",null,{"seconds":307,"label":"5:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"The early numerical opportunity is stated"}],["$","p",null,{"children":"The episode estimates about 40,000 United States troops near the field against perhaps 15,000 Confederates early Tuesday."}]]}]]}],["$","div","Franklin remains in Pleasant Valley",{"className":"moment","children":[["$","$L2d",null,{"seconds":376,"label":"6:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Franklin remains in Pleasant Valley"}],["$","p",null,{"children":"VI Corps watches for a Confederate movement from Harpers Ferry instead of joining the main concentration at Sharpsburg."}]]}]]}],["$","div","McClellan overestimates both Confederate forces",{"className":"moment","children":[["$","$L2d",null,{"seconds":436,"label":"7:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan overestimates both Confederate forces"}],["$","p",null,{"children":"He places at least 30,000 with Lee and Longstreet and another 40,000–50,000 with Jackson at Harpers Ferry."}]]}]]}],["$","div","Actual concentration is contrasted",{"className":"moment","children":[["$","$L2d",null,{"seconds":552,"label":"9:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Actual concentration is contrasted"}],["$","p",null,{"children":"The episode estimates that McClellan has nearly 60,000 by day’s end while Lee has no more than about 25,000 after Jackson arrives."}]]}]]}],["$","div","The attack is postponed",{"className":"moment","children":[["$","$L2d",null,{"seconds":566,"label":"9:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack is postponed"}],["$","p",null,{"children":"After reconnaissance and deliberation, McClellan circulates orders shortly after noon for a general assault on September 17."}]]}]]}],["$","div","Cox expects battle",{"className":"moment","children":[["$","$L2d",null,{"seconds":588,"label":"9:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cox expects battle"}],["$","p",null,{"children":"Jacob D. Cox, commanding IX Corps after Reno’s death, later remembered September 16 as a day of tedious inaction."}]]}]]}],["$","div","The delay’s unintended effect is explained",{"className":"moment","children":[["$","$L2d",null,{"seconds":659,"label":"10:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"The delay’s unintended effect is explained"}],["$","p",null,{"children":"Waiting allows both McClellan’s own army and most of Lee’s separated army to concentrate for the battle the next day."}]]}]]}],["$","div","Lee’s decision to fight is examined",{"className":"moment","children":[["$","$L2d",null,{"seconds":768,"label":"12:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s decision to fight is examined"}],["$","p",null,{"children":"The episode presents criticism of Lee’s choice to stand with the Potomac behind him and a badly depleted army."}]]}]]}],"$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d"]}]]}]
26:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Reconnoitered Lee’s line on September 16, concentrated the army east of Antietam Creek, and ordered the general attack for the next day"}]]}],["$","div","I Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps"}],["$","span",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","small",null,{"children":"Crossed the upper Antietam late on September 16 and moved toward the Miller farm opposite Lee’s left"}]]}],["$","div","XII Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"XII Corps"}],["$","span",null,{"children":"Maj. Gen. Joseph K. F. Mansfield"}],["$","small",null,{"children":"Followed I Corps across the upper creek late in the day to support the opening attack against the Confederate left"}]]}],["$","div","II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps"}],["$","span",null,{"children":"Maj. Gen. Edwin V. Sumner"}],["$","small",null,{"children":"Concentrated east of the Antietam; the corps had camped on and around the Pry farm during the approach"}]]}],["$","div","V Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"Formed part of McClellan’s concentrated force and remained available near the army center and reserve"}]]}],["$","div","IX Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"IX Corps"}],["$","span",null,{"children":"Brig. Gen. Jacob D. Cox"}],["$","small",null,{"children":"Exercised corps command after Jesse Reno’s mortal wound at South Mountain; waited east and southeast of the creek for the next day’s orders"}]]}],["$","div","VI Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"VI Corps"}],["$","span",null,{"children":"Maj. Gen. William B. Franklin"}],["$","small",null,{"children":"Remained in Pleasant Valley to watch Harpers Ferry until McClellan ordered him toward Sharpsburg at 6 p.m."}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Chose to stand west of Antietam Creek, placed Jackson on the left and Longstreet on the right, and called the remaining Harpers Ferry detachments to Sharpsburg"}]]}],["$","div","Left Wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Arrived from Harpers Ferry on September 16 and took position from the Dunker Church area toward Nicodemus Heights"}]]}],["$","div","Right Wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Held the roads, ridges, and approaches around Sharpsburg and extended the defense south toward the lower Antietam"}]]}],["$","div","Hill’s Division, Confederate center",{"className":"command-entry","children":[["$","strong",null,{"children":"Hill’s Division, Confederate center"}],["$","span",null,{"children":"Maj. Gen. D. H. Hill"}],["$","small",null,{"children":"Occupied ground connecting Jackson and Longstreet near the Hagerstown Turnpike, Roulette farm, and roads north of Sharpsburg"}]]}],"$L3e","$L3f","$L40","$L41"]]}]]}],"$L42","$L43"]}]
27:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Maj. Gen. Jesse L. Reno",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. Jesse L. Reno"}],["$","p",null,{"children":[["$","strong",null,{"children":["IX Corps commander","."]}]," ","Mortally wounded through the chest near Fox’s Gap on September 14 and died that evening; his loss explains Jacob D. Cox’s exercise of IX Corps command on September 16"]}]]}]]}]]}]
28:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep188-september-16-concentration.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep188-september-16-concentration.svg","alt":"Schematic map of both armies concentrating around Sharpsburg on September 16, 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Lee drew Jackson and Walker from the Harpers Ferry operation while McClellan held Franklin in Pleasant Valley and concentrated the remainder of the Army of the Potomac east of Antietam Creek."}]]}],["$","figure","/images/ep188-confederate-defensive-line.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep188-confederate-defensive-line.svg","alt":"Schematic map of Lee’s four-mile defensive line west of Antietam Creek.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson held the northern sector around the Dunker Church and Nicodemus Heights. Longstreet’s right extended through Sharpsburg toward the lower creek, while the road to Boteler’s Ford remained Lee’s essential route across the Potomac."}]]}],["$","figure","/images/ep188-mcclellan-looking-at-fight.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep188-mcclellan-looking-at-fight.jpg","alt":"Alfred Waud pencil drawing of McClellan and staff observing the Antietam battlefield from horseback.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alfred R. Waud drew “McClellan looking at the fight” on September 17. The work is a participant-era record of the commander observing the field, one day after the reconnaissance and decisions covered in this episode."}]]}],["$","figure","/images/ep188-dunker-church.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep188-dunker-church.jpg","alt":"Alexander Gardner photograph of the Dunker Church and fallen Confederate artillerymen after the Battle of Antietam.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alexander Gardner photographed the Dunker Church after the battle with dead Confederate artillerymen in the foreground. The image records the landmark whose plateau anchored the northern battlefield described in the episode."}]]}]]}]]}]
