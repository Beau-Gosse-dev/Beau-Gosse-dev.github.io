2e:["$","div","Lee bets on McClellan’s caution",{"className":"moment","children":[["$","$L2d",null,{"seconds":881,"label":"14:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee bets on McClellan’s caution"}],["$","p",null,{"children":"Lee expects McClellan to return to the deliberate methods that had characterized earlier operations."}]]}]]}]
2f:["$","div","Lee commits to Sharpsburg",{"className":"moment","children":[["$","$L2d",null,{"seconds":989,"label":"16:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee commits to Sharpsburg"}],["$","p",null,{"children":"Despite the risk and his army’s condition, Lee chooses battle in an effort to preserve the campaign’s purpose and initiative."}]]}]]}]
30:["$","div","The battlefield’s ridges and streams are introduced",{"className":"moment","children":[["$","$L2d",null,{"seconds":1032,"label":"17:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battlefield’s ridges and streams are introduced"}],["$","p",null,{"children":"The terrain between the Potomac and Antietam Creek appears ordinary from a distance but contains folds, woods, roads, and fields that restrict observation."}]]}]]}]
31:["$","div","The four-mile Confederate arc takes shape",{"className":"moment","children":[["$","$L2d",null,{"seconds":1129,"label":"18:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"The four-mile Confederate arc takes shape"}],["$","p",null,{"children":"Lee’s defensive line extends from northwest of Sharpsburg south toward the lower Antietam."}]]}]]}]
32:["$","div","Jackson reaches Sharpsburg",{"className":"moment","children":[["$","$L2d",null,{"seconds":1139,"label":"18:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson reaches Sharpsburg"}],["$","p",null,{"children":"Jackson arrives around midday after the severe march from Harpers Ferry and takes command of the Confederate left."}]]}]]}]
33:["$","div","Nicodemus Heights anchors the left",{"className":"moment","children":[["$","$L2d",null,{"seconds":1155,"label":"19:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nicodemus Heights anchors the left"}],["$","p",null,{"children":"Stuart’s cavalry and horse artillery occupy the high ground, supported by Early’s infantry brigade."}]]}]]}]
34:["$","div","The Dunker Church becomes the key landmark",{"className":"moment","children":[["$","$L2d",null,{"seconds":1183,"label":"19:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Dunker Church becomes the key landmark"}],["$","p",null,{"children":"The episode locates the church at the Hagerstown Turnpike and Smoketown Road and explains the artillery value of its plateau."}]]}]]}]
35:["$","div","The northern approach is defined",{"className":"moment","children":[["$","$L2d",null,{"seconds":1237,"label":"20:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"The northern approach is defined"}],["$","p",null,{"children":"A narrow open corridor, the East and West Woods, and Miller’s standing corn shape the approach to Jackson’s position."}]]}]]}]
36:["$","div","The line turns south toward Longstreet",{"className":"moment","children":[["$","$L2d",null,{"seconds":1289,"label":"21:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The line turns south toward Longstreet"}],["$","p",null,{"children":"The Roulette farm marks the bend toward the roads and high ground covering Sharpsburg and the lower battlefield."}]]}]]}]
37:["$","div","The lower bridge outpost is described",{"className":"moment","children":[["$","$L2d",null,{"seconds":1317,"label":"21:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The lower bridge outpost is described"}],["$","p",null,{"children":"A single Confederate brigade guards the heights above Rohrbach Bridge while Snavely’s Ford presents a route around it."}]]}]]}]
38:["$","div","McClellan’s tactical problem is framed",{"className":"moment","children":[["$","$L2d",null,{"seconds":1385,"label":"23:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan’s tactical problem is framed"}],["$","p",null,{"children":"He must attack ground chosen by Lee with an army whose corps and senior commanders have limited experience operating together."}]]}]]}]
39:["$","div","Antietam becomes McClellan’s command test",{"className":"moment","children":[["$","$L2d",null,{"seconds":1460,"label":"24:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Antietam becomes McClellan’s command test"}],["$","p",null,{"children":"The episode identifies it as the first major battle that he would both plan and personally direct from beginning to end."}]]}]]}]
3a:["$","div","Lee’s stand cancels an easy vindication",{"className":"moment","children":[["$","$L2d",null,{"seconds":1506,"label":"25:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s stand cancels an easy vindication"}],["$","p",null,{"children":"McClellan can no longer treat South Mountain alone as proof that the campaign has been won; he must confront Lee again."}]]}]]}]
3b:["$","div","Lincoln presses for destruction of Lee’s army",{"className":"moment","children":[["$","$L2d",null,{"seconds":1554,"label":"25:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln presses for destruction of Lee’s army"}],["$","p",null,{"children":"The president’s telegram blesses McClellan’s success but emphasizes that the Confederate army remains the objective."}]]}]]}]
3c:["$","div","Winfield Scott echoes the unfinished task",{"className":"moment","children":[["$","$L2d",null,{"seconds":1588,"label":"26:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Winfield Scott echoes the unfinished task"}],["$","p",null,{"children":"Scott’s reply also declines to treat South Mountain as a complete victory while Lee still stands in Maryland."}]]}]]}]
3d:["$","div","The book recommendation closes the episode",{"className":"moment","children":[["$","$L2d",null,{"seconds":1639,"label":"27:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The book recommendation closes the episode"}],["$","p",null,{"children":"The hosts recommend Ted Alexander’s “The Battle of Antietam: The Bloodiest Day.”"}]]}]]}]
3e:["$","div","Cavalry Division and horse artillery",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry Division and horse artillery"}],["$","span",null,{"children":"Maj. Gen. J. E. B. Stuart"}],["$","small",null,{"children":"Held Nicodemus Heights with two cavalry brigades and horse artillery on the extreme Confederate left"}]]}]
3f:["$","div","Early’s Brigade, Ewell’s Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Early’s Brigade, Ewell’s Division"}],["$","span",null,{"children":"Brig. Gen. Jubal A. Early"}],["$","small",null,{"children":"Supported the left near Nicodemus Heights as Lee’s position filled out on September 16"}]]}]
40:["$","div","Toombs’s Brigade, D. R. Jones’s Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Toombs’s Brigade, D. R. Jones’s Division"}],["$","span",null,{"children":"Brig. Gen. Robert Toombs"}],["$","small",null,{"children":"Held the forward position above Rohrbach Bridge to delay a United States crossing of the lower Antietam"}]]}]
