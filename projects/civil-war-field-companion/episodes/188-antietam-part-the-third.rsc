12:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2017/03/26/civil-war-podcast-episode-188/",{"href":"https://civilwarpodcast.org/2017/03/26/civil-war-podcast-episode-188/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 188 page"]}],["$","a","https://www.nps.gov/anti/learn/historyculture/timeline2.htm",{"href":"https://www.nps.gov/anti/learn/historyculture/timeline2.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Antietam Campaign timeline, part 2"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=MD003",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=MD003","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Antietam battle detail"]}],["$","a","https://www.nps.gov/anti/planyourvisit/union-advance-trail-guide-background.htm",{"href":"https://www.nps.gov/anti/planyourvisit/union-advance-trail-guide-background.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Union Advance Trail background"]}],["$","a","https://www.nps.gov/anti/learn/historyculture/the-pry-farm.htm",{"href":"https://www.nps.gov/anti/learn/historyculture/the-pry-farm.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: The Pry Farm"]}],["$","a","https://www.nps.gov/places/antietam-battlefield-dunker-church.htm",{"href":"https://www.nps.gov/places/antietam-battlefield-dunker-church.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: Dunker Church"]}],["$","a","https://www.nps.gov/anti/learn/historyculture/d-r-miller-farm.htm",{"href":"https://www.nps.gov/anti/learn/historyculture/d-r-miller-farm.htm","target":"_blank","rel":"noreferrer","children":[" · ","Antietam National Battlefield: D. R. Miller Farm"]}],["$","a","https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo63555/pdf/GOVPUB-D114-PURL-gpo63555.pdf",{"href":"https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo63555/pdf/GOVPUB-D114-PURL-gpo63555.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Maryland and Fredericksburg Campaigns, 1862–1863"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/35-3-1.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/35-3-1.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Antietam order of battle"]}],["$","a","https://ehistory.osu.edu/books/official-records/027",{"href":"https://ehistory.osu.edu/books/official-records/027","target":"_blank","rel":"noreferrer","children":[" · ","Official Records, Series I, Volume XIX, Part I: Maryland Campaign reports"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=19",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=19","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: George B. McClellan’s official campaign reports"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=15",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=15","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Robert E. Lee’s official Maryland Campaign report"]}],["$","a","https://antietam.aotw.org/exhibit.php?exhibit_id=41",{"href":"https://antietam.aotw.org/exhibit.php?exhibit_id=41","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Thomas J. Jackson’s official report"]}],["$","a","https://www.loc.gov/item/map05000006/",{"href":"https://www.loc.gov/item/map05000006/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Atlas of the battlefield of Antietam"]}],"$L1c","$L1d","$L1e"]}]
