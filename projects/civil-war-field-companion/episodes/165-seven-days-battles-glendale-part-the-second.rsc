13:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/09/25/civil-war-podcast-episode-165/",{"href":"https://civilwarpodcast.org/2016/09/25/civil-war-podcast-episode-165/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 165 page"]}],["$","a","https://www.nps.gov/rich/learn/historyculture/glendalebull.htm",{"href":"https://www.nps.gov/rich/learn/historyculture/glendalebull.htm","target":"_blank","rel":"noreferrer","children":[" · ","Richmond National Battlefield Park: Battle of Glendale/Frayser’s Farm"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va020b",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va020b","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service battle summary: Glendale"]}],["$","a","https://npshistory.com/publications/civil_war_series/21/sec6.htm",{"href":"https://npshistory.com/publications/civil_war_series/21/sec6.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service Civil War Series: The Battles for Richmond, 1862"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://ehistory.osu.edu/books/official-records/013",{"href":"https://ehistory.osu.edu/books/official-records/013","target":"_blank","rel":"noreferrer","children":[" · ","Official Records of the Union and Confederate Armies, Series I, Volume XI, Part II"]}],["$","a","https://www.loc.gov/pictures/item/va2113/",{"href":"https://www.loc.gov/pictures/item/va2113/","target":"_blank","rel":"noreferrer","children":[" · ","Historic American Landscapes Survey: Battle of Glendale and White Oak Swamp"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00093/",{"href":"https://www.loc.gov/item/gvhs01.vhs00093/","target":"_blank","rel":"noreferrer","children":[" · ","Primary map: Robert Knox Sneden’s plan of Glendale, June 30, 1862"]}],["$","a","https://www.loc.gov/item/2004660207/",{"href":"https://www.loc.gov/item/2004660207/","target":"_blank","rel":"noreferrer","children":[" · ","Primary visual source: Alfred R. Waud’s Glendale drawing, June 30, 1862"]}],["$","a","https://www.loc.gov/item/2004660376/",{"href":"https://www.loc.gov/item/2004660376/","target":"_blank","rel":"noreferrer","children":[" · ","Primary visual source: Waud’s drawing of Kearny’s division at Glendale"]}],["$","a","https://www.loc.gov/item/2018666541/",{"href":"https://www.loc.gov/item/2018666541/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: James Longstreet portrait"]}],["$","a","https://www.loc.gov/item/2022631585/",{"href":"https://www.loc.gov/item/2022631585/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: George G. Meade portrait"]}],["$","a","https://archive.org/details/sevendayscontest00mcca",{"href":"https://archive.org/details/sevendayscontest00mcca","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: George A. McCall, “The Seven Days’ Contests”"]}],["$","a","https://armyofgeorgia.com/sitebuildercontent/sitebuilderfiles/army_register_1862-1865_part1.pdf",{"href":"https://armyofgeorgia.com/sitebuildercontent/sitebuilderfiles/army_register_1862-1865_part1.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. War Department Official Army Register for 1862: Seneca G. Simmons casualty record"]}],["$","a","https://andalusiapa.org/biddle-family-history-and-timeline/",{"href":"https://andalusiapa.org/biddle-family-history-and-timeline/","target":"_blank","rel":"noreferrer","children":[" · ","Andalusia Historic House: Henry J. Biddle family history"]}],"$L1d"]}]
