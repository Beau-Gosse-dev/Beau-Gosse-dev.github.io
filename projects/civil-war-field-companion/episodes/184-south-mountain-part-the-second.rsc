1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",184," · ","September 13–14, 1862"," · ","Western Maryland from Frederick and Middletown across South Mountain toward Boonsboro, with the episode’s combat centered on Fox’s Gap along the Old Sharpsburg Road"]}],["$","h1",null,{"children":"SOUTH MOUNTAIN (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Morning United States success at Fox’s Gap. By shortly after noon on September 14, Jacob D. Cox’s Kanawha Division had broken Samuel Garland’s brigade and occupied the pass. Cox then halted to consolidate and await reinforcements. The episode ends during that lull, before the later fighting at Fox’s, Turner’s, Frosttown, and Crampton’s gaps decided the Battle of South Mountain"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4008768510.mp3?updated=1695462458","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"McClellan’s September 13 plan, Lee’s emergency response, and the morning fight at Fox’s Gap on September 14"}],["$","small",null,{"children":"The episode ends early in the afternoon as both armies reinforce the mountain. The rest of the battle is reserved for the next episode."}]]}],["$","div","Battle date",{"children":[["$","span",null,{"children":"Battle date"}],["$","strong",null,{"children":"Sunday, September 14, 1862"}],["$","small",null,{"children":"South Mountain was the first major battle of the Maryland Campaign and was fought three days before Antietam."}]]}],["$","div","Operational crisis",{"children":[["$","span",null,{"children":"Operational crisis"}],["$","strong",null,{"children":"The Army of Northern Virginia remained divided while the Army of the Potomac advanced west from Frederick"}],["$","small",null,{"children":"Lee’s detachments around Harpers Ferry had not completed their assignment. McClellan’s possession of Special Orders No. 191 revealed the separation and created an opportunity to defeat the Confederate columns before they reunited."}]]}],["$","div","South Mountain barrier",{"children":[["$","span",null,{"children":"South Mountain barrier"}],["$","strong",null,{"children":"A north–south ridge crossed by a limited number of usable gaps"}],["$","small",null,{"children":"The National Road crossed at Turner’s Gap. The Old Sharpsburg Road crossed at Fox’s Gap less than a mile to the south, and the Burkittsville Road crossed at Crampton’s Gap about six miles farther south."}]]}],["$","div","McClellan’s main movement",{"children":[["$","span",null,{"children":"McClellan’s main movement"}],["$","strong",null,{"children":"Burnside’s Right Wing toward Turner’s and Fox’s gaps, supported by Sumner’s Center Wing"}],["$","small",null,{"children":"Jesse Reno’s IX Corps led the advance, with Joseph Hooker’s I Corps following. McClellan accompanied this part of the army."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}],"$L22","$undefined","$L23",false,"$L24","$L25","$L26","$L27","$L28"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","McClellan’s decisive assignment",{"children":[["$","span",null,{"children":"McClellan’s decisive assignment"}],["$","strong",null,{"children":"William B. Franklin’s VI Corps through Crampton’s Gap"}],["$","small",null,{"children":"Franklin was to enter Pleasant Valley, threaten the rear of Lafayette McLaws’s force at Maryland Heights, help relieve Harpers Ferry, and either turn north or block a Confederate withdrawal as circumstances required."}]]}]
f:["$","div","Federal estimate error",{"children":[["$","span",null,{"children":"Federal estimate error"}],["$","strong",null,{"children":"McClellan incorrectly estimated roughly 60,000 Confederates near Boonsboro"}],["$","small",null,{"children":"He expected Longstreet to be near Boonsboro, although Longstreet had gone to Hagerstown and D. H. Hill’s division formed the rear guard."}]]}]
10:["$","div","Stuart’s initial assessment",{"children":[["$","span",null,{"children":"Stuart’s initial assessment"}],["$","strong",null,{"children":"Crampton’s Gap appeared to be the greater danger"}],["$","small",null,{"children":"J. E. B. Stuart believed McClellan’s main purpose was to relieve Harpers Ferry. He told D. H. Hill that one brigade should be enough at Turner’s Gap and then rode south."}]]}]
11:["$","div","Warning from the campfires",{"children":[["$","span",null,{"children":"Warning from the campfires"}],["$","strong",null,{"children":"Alfred Colquitt recognized a major Federal concentration"}],["$","small",null,{"children":"On the night of September 13, Colquitt saw thousands of Federal campfires around Middletown and asked Hill for help at Turner’s Gap."}]]}]
12:["$","div","Lee changes course",{"children":[["$","span",null,{"children":"Lee changes course"}],["$","strong",null,{"children":"Longstreet was ordered back from Hagerstown and Hill was ordered to direct the defense"}],["$","small",null,{"children":"Lee had not intended to make a stand on South Mountain. The rapid Federal advance forced him to hold the gaps long enough to protect the separated portions of his army."}]]}]
13:["$","div","Threat to McLaws",{"children":[["$","span",null,{"children":"Threat to McLaws"}],["$","strong",null,{"children":"A Federal breakthrough at Crampton’s Gap could cut him off"}],["$","small",null,{"children":"Lafayette McLaws commanded Confederate troops on Maryland Heights as part of the Harpers Ferry operation. Lee repeatedly warned him to watch his rear."}]]}]
14:["$","div","Hill’s rear guard",{"children":[["$","span",null,{"children":"Hill’s rear guard"}],["$","strong",null,{"children":"Five veteran brigades, about 7,000–8,000 men in the episode"}],["$","small",null,{"children":"Hill’s division had been posted near Boonsboro under Special Orders No. 191. Much of it was not yet at the gaps when he reached Turner’s Gap around 5:30 a.m."}]]}]
15:["$","div","Initial defense",{"children":[["$","span",null,{"children":"Initial defense"}],["$","strong",null,{"children":"Two brigades and two batteries for a front nearly five miles wide"}],["$","small",null,{"children":"Hill initially had the brigades of Alfred Colquitt and Samuel Garland and the batteries of John Lane and Jefferson W. Bondurant while also accounting for Orr’s, Frosttown, Turner’s, and Fox’s gaps."}]]}]
16:["$","div","Fox’s Gap outpost",{"children":[["$","span",null,{"children":"Fox’s Gap outpost"}],["$","strong",null,{"children":"About 250 cavalrymen and two guns before Garland arrived"}],["$","small",null,{"children":"Thomas L. Rosser’s 5th Virginia Cavalry detachment and two guns commanded by John Pelham held the gap. The Daniel Wise farm stood at the summit amid wooded, broken terrain."}]]}]
17:["$","div","Garland’s force",{"children":[["$","span",null,{"children":"Garland’s force"}],["$","strong",null,{"children":"About 1,100 fit men in five North Carolina regiments"}],["$","small",null,{"children":"The brigade was stretched across difficult ground to cover multiple approaches. Hill ordered Garland to hold Fox’s Gap while Colquitt defended closer to Turner’s Gap."}]]}]
18:["$","div","Morning attack begins",{"children":[["$","span",null,{"children":"Morning attack begins"}],["$","strong",null,{"children":"About 9:00 a.m. at Fox’s Gap"}],["$","small",null,{"children":"The 23rd Ohio of Eliakim P. Scammon’s brigade, Cox’s Kanawha Division, encountered the 5th North Carolina on Garland’s right."}]]}]
19:["$","div","Rutherford B. Hayes wounded",{"children":[["$","span",null,{"children":"Rutherford B. Hayes wounded"}],["$","strong",null,{"children":"Shot through the left arm above the elbow"}],["$","small",null,{"children":"The lieutenant colonel of the 23rd Ohio was hit while ordering a charge. Lt. Benjamin Jackson helped move him to cover. Hayes retained a stiff arm but avoided amputation and became the nineteenth United States president in 1877."}]]}]
1a:["$","div","Samuel Garland killed",{"children":[["$","span",null,{"children":"Samuel Garland killed"}],["$","strong",null,{"children":"Mortally wounded by a bullet through the chest"}],["$","small",null,{"children":"Garland was struck while directing his brigade near the Wise farm after Col. Thomas Ruffin of the 13th North Carolina was wounded in the hip. Col. Duncan K. McRae assumed brigade command."}]]}]
1b:["$","div","Confederate line breaks",{"children":[["$","span",null,{"children":"Confederate line breaks"}],["$","strong",null,{"children":"About 11:30 a.m."}],["$","small",null,{"children":"Federal troops pressed Garland’s depleted regiments from the front and around their flanks. The brigade withdrew to avoid encirclement."}]]}]
1c:["$","div","Fox’s Gap occupied",{"children":[["$","span",null,{"children":"Fox’s Gap occupied"}],["$","strong",null,{"children":"Shortly after noon"}],["$","small",null,{"children":"Cox’s division held the summit after roughly three hours of fighting. The action wrecked Garland’s brigade but also exhausted the Federal attackers."}]]}]
1d:["$","div","Cox pauses",{"children":[["$","span",null,{"children":"Cox pauses"}],["$","strong",null,{"children":"Consolidate the captured ground and wait for reinforcements"}],["$","small",null,{"children":"Confederate prisoners reported that more of Hill’s division and Longstreet’s command were near. Cox did not immediately turn north against Turner’s Gap."}]]}]
1e:["$","div","Confederate reinforcements",{"children":[["$","span",null,{"children":"Confederate reinforcements"}],["$","strong",null,{"children":"Rodes and Ripley reached the mountain during the lull"}],["$","small",null,{"children":"Hill sent Robert E. Rodes north of the National Road and Roswell S. Ripley toward Fox’s Gap after deciding that the Federal threat required more of his division."}]]}]
1f:["$","div","Episode-end situation",{"children":[["$","span",null,{"children":"Episode-end situation"}],["$","strong",null,{"children":"The United States held Fox’s Gap, but the battle remained unresolved"}],["$","small",null,{"children":"Federal and Confederate columns were still arriving. Fighting later resumed at Fox’s Gap and expanded around Frosttown, Turner’s, and Crampton’s gaps."}]]}]
20:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Lee’s Maverick General: Daniel Harvey Hill” by Hal Bridges"}],["$","small",null,{"children":"The episode recommends the biography for D. H. Hill’s career and perspective."}]]}]
21:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Burkittsville, Kanawha Division, Lafayette McLaws, Robert E. Rodes, Orr’s Gap, and Jefferson W. Bondurant"}],["$","small",null,{"children":"The automated transcript produces “Birketsville,” “Canal Division,” “Lafayette McClellan,” “Robert Rhodesman,” “Oar’s Gap,” and “James W. Bondurant.” It also occasionally renders Turner’s Gap as “Kerner’s Gap.”"}]]}]
22:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
23:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","McClellan’s plan and Lee’s divided army",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep184-south-mountain-plan.svg","target":"_blank","rel":"noreferrer","aria-label":"Open McClellan’s plan and Lee’s divided army at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep184-south-mountain-plan.svg","alt":"Schematic regional map of McClellan’s two-pronged advance toward the South Mountain gaps and the separated Confederate commands west and south of the ridge.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"McClellan’s plan and Lee’s divided army"}],["$","span",null,{"children":"On September 13, McClellan directed Burnside’s Right Wing toward Turner’s and Fox’s gaps while Franklin’s VI Corps moved through Burkittsville toward Crampton’s Gap. Hill’s division guarded the Boonsboro approaches, Longstreet had to return from Hagerstown, and McLaws remained near Maryland Heights. Routes and positions are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep184-south-mountain-plan.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History, National Park Service, Robert Knox Sneden map, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Morning fight at Fox’s Gap",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep184-foxs-gap-morning.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Morning fight at Fox’s Gap at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep184-foxs-gap-morning.svg","alt":"Two-panel schematic tactical map of the morning fighting at Fox’s Gap, from the first Federal contact around 9 a.m. to the collapse of Garland’s brigade before noon.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Morning fight at Fox’s Gap"}],["$","span",null,{"children":"The first panel shows Scammon’s brigade of Cox’s Kanawha Division advancing from the east against Garland’s extended North Carolina line near the Wise farm. The second shows the Federal envelopment that forced the brigade back around 11:30 a.m.; shortly after noon Cox held the gap and paused. Unit footprints and terrain are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep184-foxs-gap-morning.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History, National Park Service, U.S. Army Corps of Topographical Engineers map, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],"$L29"]}]]}]
24:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Planned the September 14 advance after receiving Special Orders No. 191 and accompanied the main movement toward Turner’s Gap"}]]}],["$","div","Right Wing-Maj. Gen. Ambrose E. Burnside",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing"}],["$","span",null,{"children":"Maj. Gen. Ambrose E. Burnside"}],["$","small",null,{"children":"IX Corps under Jesse L. Reno and I Corps under Joseph Hooker; directed toward Turner’s and Fox’s gaps"}]]}],["$","div","IX Corps-Maj. Gen. Jesse L. Reno",{"className":"command-entry","children":[["$","strong",null,{"children":"IX Corps"}],["$","span",null,{"children":"Maj. Gen. Jesse L. Reno"}],["$","small",null,{"children":"Cox’s Kanawha Division led the corps advance from Middletown; later IX Corps fighting falls outside this episode"}]]}],["$","div","Kanawha Division, IX Corps-Brig. Gen. Jacob D. Cox",{"className":"command-entry","children":[["$","strong",null,{"children":"Kanawha Division, IX Corps"}],["$","span",null,{"children":"Brig. Gen. Jacob D. Cox"}],["$","small",null,{"children":"Sent Eliakim P. Scammon’s brigade toward Fox’s Gap, captured the pass by shortly after noon, and halted to consolidate"}]]}],["$","div","1st Brigade, Kanawha Division-Col. Eliakim P. Scammon",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Kanawha Division"}],["$","span",null,{"children":"Col. Eliakim P. Scammon"}],["$","small",null,{"children":"Included the 23rd Ohio under Lt. Col. Rutherford B. Hayes and the 30th Ohio engaged against Garland’s brigade"}]]}],["$","div","I Corps-Maj. Gen. Joseph Hooker",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps"}],["$","span",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","small",null,{"children":"Followed IX Corps in Burnside’s Right Wing toward the northern gaps; its principal combat comes after the episode’s noon endpoint"}]]}],["$","div","VI Corps-Maj. Gen. William B. Franklin",{"className":"command-entry","children":[["$","strong",null,{"children":"VI Corps"}],["$","span",null,{"children":"Maj. Gen. William B. Franklin"}],["$","small",null,{"children":"Assigned to force Crampton’s Gap, enter Pleasant Valley, and threaten the Confederate forces around Harpers Ferry"}]]}],["$","div","Center Wing-Maj. Gen. Edwin V. Sumner",{"className":"command-entry","children":[["$","strong",null,{"children":"Center Wing"}],["$","span",null,{"children":"Maj. Gen. Edwin V. Sumner"}],["$","small",null,{"children":"Directed to support Burnside’s main movement west from Frederick"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":["$L2a","$L2b","$L2c"]}],"$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33"]]}]]}],"$L34"]]]}]
25:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. Samuel Garland Jr.",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Samuel Garland Jr."}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of Garland’s Brigade, D. H. Hill’s Division","."]}]," ","Mortally wounded by a bullet through the chest while directing his brigade at Fox’s Gap; carried from the line and died soon afterward on September 14, 1862"]}]]}]]}]]}]
26:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep184-south-mountain-plan.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep184-south-mountain-plan.svg","alt":"Schematic regional map of the Federal plan and the divided Confederate commands around South Mountain.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"McClellan sent his main body toward Turner’s and Fox’s gaps and VI Corps toward Crampton’s Gap while Lee recalled Longstreet and tried to protect McLaws and the Harpers Ferry operation."}]]}],["$","figure","/images/ep184-foxs-gap-morning.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep184-foxs-gap-morning.svg","alt":"Two-panel schematic map of Cox’s morning attack against Garland’s brigade at Fox’s Gap.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Cox’s lead Ohio regiments attacked Garland’s extended line from the east, forced it from the summit by late morning, and occupied Fox’s Gap shortly after noon."}]]}],["$","figure","/images/ep184-sneden-south-mountain-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep184-sneden-south-mountain-map.jpg","alt":"Robert Knox Sneden’s illustrated map of the roads, terrain, and positions around Fox’s and Turner’s gaps.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Robert Knox Sneden’s map records the relationship among the mountain gaps, Boonsboro, the National Road, and the Old Sharpsburg Road. It was created during or shortly after the Civil War."}]]}],["$","figure","/images/ep184-battle-of-south-mountain.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep184-battle-of-south-mountain.jpg","alt":"Nineteenth-century print showing United States troops attacking Confederate troops at the Battle of South Mountain.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"“The Battle of South Mountain, Md., Sunday, Sept. 14, 1862,” an 1864 print depicting the attack of the 23rd and 12th Ohio against North Carolinians under Garland. The composition is commemorative artwork, not a literal battlefield photograph."}]]}],["$","figure","/images/ep184-rutherford-hayes.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep184-rutherford-hayes.jpg","alt":"Brady-Handy glass-negative portrait of Rutherford B. Hayes in civilian clothing after the Civil War.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Rutherford B. Hayes led the 23rd Ohio at Fox’s Gap and suffered a serious wound to his left arm. This portrait was made after the war, between 1870 and 1880."}]]}],["$","figure","/images/ep184-samuel-garland.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep184-samuel-garland.jpg","alt":"Full-length Civil War-era portrait of Confederate brigadier general Samuel Garland Jr. in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Samuel Garland Jr. commanded five North Carolina regiments at Fox’s Gap and was killed during the morning fighting."}]]}]]}]]}]
