11:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2017/02/26/civil-war-podcast-episode-184/",{"href":"https://civilwarpodcast.org/2017/02/26/civil-war-podcast-episode-184/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 184 page"]}],["$","a","https://www.nps.gov/articles/harpers-ferry-to-south-mountain.htm",{"href":"https://www.nps.gov/articles/harpers-ferry-to-south-mountain.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Harpers Ferry to South Mountain"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=md002",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=md002","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: South Mountain battle detail"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-6.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-6.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Maryland and Fredericksburg Campaigns, 1862–1863"]}],["$","a","https://ehistory.osu.edu/books/official-records/027/1018",{"href":"https://ehistory.osu.edu/books/official-records/027/1018","target":"_blank","rel":"noreferrer","children":[" · ","Official Records, Series I, Volume XIX, Part I: D. H. Hill’s report, pages 1018–1030"]}],["$","a","https://ehistory.osu.edu/books/official-records/027",{"href":"https://ehistory.osu.edu/books/official-records/027","target":"_blank","rel":"noreferrer","children":[" · ","Official Records, Series I, Volume XIX, Part I: Maryland Campaign reports"]}],["$","a","https://www.rbhayes.org/diary/",{"href":"https://www.rbhayes.org/diary/","target":"_blank","rel":"noreferrer","children":[" · ","Rutherford B. Hayes Presidential Library: Diary and Letters of Rutherford B. Hayes"]}],["$","a","https://www.nps.gov/people/rutherford-b-hayes.htm",{"href":"https://www.nps.gov/people/rutherford-b-hayes.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Rutherford B. Hayes"]}],["$","a","https://www.nps.gov/people/samuel-garland-jr.htm",{"href":"https://www.nps.gov/people/samuel-garland-jr.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Samuel Garland Jr."]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00298/",{"href":"https://www.loc.gov/item/gvhs01.vhs00298/","target":"_blank","rel":"noreferrer","children":[" · ","Primary map: Robert Knox Sneden, Battle of South Mountain at Fox’s and Turner’s gaps"]}],["$","a","https://www.loc.gov/item/99447402/",{"href":"https://www.loc.gov/item/99447402/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Corps of Topographical Engineers map of South Mountain positions"]}],["$","a","https://www.loc.gov/item/2003680934/",{"href":"https://www.loc.gov/item/2003680934/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: 1864 Battle of South Mountain print"]}],["$","a","https://www.loc.gov/item/2017893107/",{"href":"https://www.loc.gov/item/2017893107/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Rutherford B. Hayes portrait"]}],["$","a","https://www.loc.gov/item/98503412/",{"href":"https://www.loc.gov/item/98503412/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Samuel Garland Jr. portrait record"]}],["$","a","https://archivesweb.vmi.edu/record.php?ID=271",{"href":"https://archivesweb.vmi.edu/record.php?ID=271","target":"_blank","rel":"noreferrer","children":[" · ","Virginia Military Institute Archives: Samuel Garland roster"]}],["$","a","https://civilwarpodcast.org/book-recommendations/",{"href":"https://civilwarpodcast.org/book-recommendations/","target":"_blank","rel":"noreferrer","children":[" · ","Official podcast book-recommendations list"]}]]}]
