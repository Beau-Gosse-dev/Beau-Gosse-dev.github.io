d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",184," · ","September 13–14, 1862"," · ","Western Maryland from Frederick and Middletown across South Mountain toward Boonsboro, with the episode’s combat centered on Fox’s Gap along the Old Sharpsburg Road"]}],["$","h1",null,{"children":"SOUTH MOUNTAIN (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Morning United States success at Fox’s Gap. By shortly after noon on September 14, Jacob D. Cox’s Kanawha Division had broken Samuel Garland’s brigade and occupied the pass. Cox then halted to consolidate and await reinforcements. The episode ends during that lull, before the later fighting at Fox’s, Turner’s, Frosttown, and Crampton’s gaps decided the Battle of South Mountain"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"l