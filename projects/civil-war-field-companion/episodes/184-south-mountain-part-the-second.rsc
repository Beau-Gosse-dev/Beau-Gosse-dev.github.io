1f:["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Ordered Hill to defend the mountain, warned McLaws, and recalled Longstreet from Hagerstown after recognizing the Federal threat"}]]}],["$","div","Longstreet’s Wing-Maj. Gen. James Longstreet",{"className":"command-entry","children":[["$","strong",null,{"children":"Longstreet’s Wing"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Turned south from Hagerstown at first light to reinforce Lee’s rear guard near Boonsboro and the gaps"}]]}],["$","div","Hill’s Division and defense of Turner’s and Fox’s gaps-Maj. Gen. D. H. Hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Hill’s Division and defense of Turner’s and Fox’s gaps"}],["$","span",null,{"children":"Maj. Gen. D. H. Hill"}],["$","small",null,{"children":"Initially employed Colquitt and Garland, then called forward G. B. Anderson, Rodes, and Ripley as the scale of McClellan’s advance became clear"}]]}],["$","div","Garland’s Brigade, Hill’s Division-Brig. Gen. Samuel Garland Jr.",{"className":"command-entry","children":[["$","strong",null,{"children":"Garland’s Brigade, Hill’s Division"}],["$","span",null,{"children":"Brig. Gen. Samuel Garland Jr."}],["$","small",null,{"children":"Five North Carolina regiments defending Fox’s Gap; Col. Duncan K. McRae assumed command after Garland was mortally wounded"}]]}],["$","div","Colquitt’s Brigade, Hill’s Division-Brig. Gen. Alfred H. Colquitt",{"className":"command-entry","children":[["$","strong",null,{"children":"Colquitt’s Brigade, Hill’s Division"}],["$","span",null,{"children":"Brig. Gen. Alfred H. Colquitt"}],["$","small",null,{"children":"Initially sent alone to Turner’s Gap and warned Hill after seeing the size of the Federal encampment around Middletown"}]]}],["$","div","Reinforcing brigades of Hill’s Division-Brig. Gens. George B. Anderson, Robert E. Rodes, and Roswell S. Ripley",{"className":"command-entry","children":[["$","strong",null,{"children":"Reinforcing brigades of Hill’s Division"}],["$","span",null,{"children":"Brig. Gens. George B. Anderson, Robert E. Rodes, and Roswell S. Ripley"}],["$","small",null,{"children":"Called from Boonsboro as Hill expanded the defense; Rodes moved north of the National Road and Ripley toward Fox’s Gap"}]]}],["$","div","Cavalry Division and screen east of South Mountain-Maj. Gen. J. E. B. Stuart",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry Division and screen east of South Mountain"}],["$","span",null,{"children":"Maj. Gen. J. E. B. Stuart"}],["$","small",null,{"children":"Initially judged Crampton’s Gap the main danger; left Thomas L. Rosser’s detachment and John Pelham’s two guns at Fox’s Gap"}]]}],["$","div","Confederate force at Maryland Heights-Maj. Gen. Lafayette McLaws",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate force at Maryland Heights"}],["$","span",null,{"children":"Maj. Gen. Lafayette McLaws"}],["$","small",null,{"children":"Continued the Harpers Ferry operation while a breakthrough at Crampton’s Gap threatened his rear"}]]}]]]}]
