d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",483," · ","May 6–7, 1864"," · ","Orange Plank Road, Brock Road, Orange Turnpike, and the Wilderness of Spotsylvania, Virginia"]}],["$","h1",null,{"children":"THE WILDERNESS (Part the Fifth)"}],["$","span",null,{"className":"result-label","children":"Longstreet’s flank attack drove Hancock’s II Corps back to the Brock Road defenses, but Confederate friendly fire then disabled Longstreet and halted the attack. Lee’s later frontal assault failed. Gordon’s evening attack broke two U.S. brigades but came too late and with too few troops to change the result. Grant treated the battle as a draw and ordered the army southeast toward Spotsylvania Court House"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"May 6–7, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Orange Plank Road, Brock Road, Orange Turnpike, and the Wilderness of Spotsylvania, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Longstreet’s flank attack drove Hancock’s II Corps back to the Brock Road defenses, but Confederate friendly fire then disabled Longstreet and halted the attack. Lee’s later frontal assault failed. Gordon’s evening attack broke two U.S. brigades but came too late and with too few troops to change the result. Grant treated the battle as a draw and ordered the army southeast toward Spotsylvania Court House"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Longstreet wounded",{"children":[["$","th",null,{"scope":"row","children":"Longstreet wounded"}],["$","td",null,{"children":["About noon, May 6","$undefined"]}]]}],["$","tr","Gordon’s assault force",{"children":[["$","th",null,{"scope":"row","children":"Gordon’s assault force"}],["$","td",null,{"children":["About 4,000 men in 3 brigades","$undefined"]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":["$Lf","$L10","$L11","$L12","$L13","$L14","$L15"]}]]}],"$undefined"]}],"$L16","$L17","$L18",false,"$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}]]}]
