13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Longstreet prepared a flank attack",{"className":"moment","children":[["$","$L19",null,{"seconds":86,"label":"1:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet prepared a flank attack"}],["$","p",null,{"children":"Martin L. Smith found an unfinished railroad south of Orange Plank Road that led toward the unguarded left of Hancock’s II Corps."}]]}]]}],["$","div","Sorrel received four brigades",{"className":"moment","children":[["$","$L19",null,{"seconds":127,"label":"2:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sorrel received four brigades"}],["$","p",null,{"children":"Longstreet ordered G. Moxley Sorrel to collect four scattered brigades, move them along the railroad bed, and wait until all were ready before attacking."}]]}]]}],["$","div","The attack struck Hancock’s left",{"className":"moment","children":[["$","$L19",null,{"seconds":191,"label":"3:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack struck Hancock’s left"}],["$","p",null,{"children":"The Confederates came from the south against U.S. troops facing west. Two brigades on the exposed flank broke, uncovering the units nearer Orange Plank Road."}]]}]]}],["$","div","Longstreet attacked from the front",{"className":"moment","children":[["$","$L19",null,{"seconds":286,"label":"4:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet attacked from the front"}],["$","p",null,{"children":"Troops astride Orange Plank Road advanced as the flanking column hit, forcing Hancock’s command back toward the Brock Road intersection."}]]}]]}],["$","div","II Corps rallied behind fieldworks",{"className":"moment","children":[["$","$L19",null,{"seconds":344,"label":"5:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"II Corps rallied behind fieldworks"}],["$","p",null,{"children":"Soldiers stopped at the Brock Road defenses. Officers and color bearers reorganized the units in roughly half an hour."}]]}]]}],["$","div","Friendly fire stopped the Confederate advance",{"className":"moment","children":[["$","$L19",null,{"seconds":380,"label":"6:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Friendly fire stopped the Confederate advance"}],["$","p",null,{"children":"The pressure eased after soldiers of the 12th Virginia mistook Longstreet’s mounted party for U.S. troops and fired into it."}]]}]]}],["$","div","Micah Jenkins was killed and Longstreet wounded",{"className":"moment","children":[["$","$L19",null,{"seconds":420,"label":"7:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Micah Jenkins was killed and Longstreet wounded"}],["$","p",null,{"children":"The volley killed Jenkins, a staff officer, and a courier. A bullet passed through Longstreet’s shoulder and injured his neck."}]]}]]}],["$","div","Longstreet left the field for months",{"className":"moment","children":[["$","$L19",null,{"seconds":457,"label":"7:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet left the field for months"}],["$","p",null,{"children":"Surgeons stopped the bleeding, but he could not return to the Army of Northern Virginia until October 1864."}]]}]]}],["$","div","Lee resumed the attack after 4 p.m.",{"className":"moment","children":[["$","$L19",null,{"seconds":496,"label":"8:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee resumed the attack after 4 p.m."}],["$","p",null,{"children":"After taking control of Longstreet’s corps, Lee ordered a frontal assault on the Brock Road defenses."}]]}]]}],["$","div","The frontal assault failed",{"className":"moment","children":[["$","$L19",null,{"seconds":513,"label":"8:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The frontal assault failed"}],["$","p",null,{"children":"Confederates entered the works at a few points but were driven out by U.S. musket and artillery fire."}]]}]]}],["$","div","Hancock canceled the planned U.S. attack",{"className":"moment","children":[["$","$L19",null,{"seconds":559,"label":"9:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock canceled the planned U.S. attack"}],"$L1a"]}]]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}]]}]
