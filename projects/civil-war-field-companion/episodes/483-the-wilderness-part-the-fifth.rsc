1a:["$","p",null,{"children":"His troops were exhausted and short of ammunition after stopping Lee’s assault, so a proposed 6 p.m. advance did not occur."}]
1b:["$","div","Gordon proposed a northern flank attack",{"className":"moment","children":[["$","$L19",null,{"seconds":574,"label":"9:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gordon proposed a northern flank attack"}],["$","p",null,{"children":"John B. Gordon identified the exposed end of Sedgwick’s VI Corps above the Orange Turnpike and sought permission to attack it."}]]}]]}]
1c:["$","div","Scouts confirmed the U.S. flank was open",{"className":"moment","children":[["$","$L19",null,{"seconds":631,"label":"10:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Scouts confirmed the U.S. flank was open"}],["$","p",null,{"children":"Gordon’s scouts found no U.S. line opposite his brigade and reported that the Federal works ended farther south."}]]}]]}]
1d:["$","div","Gordon personally checked the position",{"className":"moment","children":[["$","$L19",null,{"seconds":691,"label":"11:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gordon personally checked the position"}],["$","p",null,{"children":"He approached close enough to see U.S. soldiers at the end of their breastworks and confirmed that no line protected their flank."}]]}]]}]
1e:["$","div","Early opposed the proposal",{"className":"moment","children":[["$","$L19",null,{"seconds":768,"label":"12:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early opposed the proposal"}],["$","p",null,{"children":"Jubal Early argued that Gordon lacked enough men and might be outflanked by Burnside or other U.S. forces reported nearby."}]]}]]}]
1f:["$","div","Ewell initially refused permission",{"className":"moment","children":[["$","$L19",null,{"seconds":856,"label":"14:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell initially refused permission"}],["$","p",null,{"children":"Richard Ewell accepted Early’s objections and delayed the attack until the situation became clearer."}]]}]]}]
20:["$","div","Robert Johnston’s brigade arrived",{"className":"moment","children":[["$","$L19",null,{"seconds":876,"label":"14:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Robert Johnston’s brigade arrived"}],["$","p",null,{"children":"Johnston extended the Confederate left beyond the U.S. flank. Reports also established that Burnside was not positioned behind Sedgwick."}]]}]]}]
21:["$","div","Three Confederate brigades moved at sunset",{"className":"moment","children":[["$","$L19",null,{"seconds":915,"label":"15:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Three Confederate brigades moved at sunset"}],["$","p",null,{"children":"Gordon attacked with his own brigade, Johnston’s brigade, and John Hoffman’s brigade—about 4,000 men in total."}]]}]]}]
22:["$","div","Shaler’s brigade collapsed",{"className":"moment","children":[["$","$L19",null,{"seconds":1090,"label":"18:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shaler’s brigade collapsed"}],["$","p",null,{"children":"The surprise attack struck Alexander Shaler’s brigade first, then forced Truman Seymour’s neighboring brigade to withdraw."}]]}]]}]
23:["$","div","Shaler and Seymour were captured",{"className":"moment","children":[["$","$L19",null,{"seconds":1187,"label":"19:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shaler and Seymour were captured"}],["$","p",null,{"children":"Both brigade commanders rode toward the fighting and attempted to rally their troops before Confederates took them prisoner."}]]}]]}]
24:["$","div","The attack did not change the battle",{"className":"moment","children":[["$","$L19",null,{"seconds":1200,"label":"20:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack did not change the battle"}],["$","p",null,{"children":"Only Gordon’s brigade struck the flank directly. Dense woods and darkness disrupted the other two brigades while Sedgwick formed a new defensive line."}]]}]]}]
25:["$","div","A second attack failed",{"className":"moment","children":[["$","$L19",null,{"seconds":1236,"label":"20:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"A second attack failed"}],["$","p",null,{"children":"Gordon tried again around 10 p.m., but the reinforced U.S. position stopped the advance."}]]}]]}]
26:["$","div","Grant assessed the battle as a draw",{"className":"moment","children":[["$","$L19",null,{"seconds":1368,"label":"22:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant assessed the battle as a draw"}],["$","p",null,{"children":"He concluded that neither army had won a clear advantage and rejected another attack against prepared Confederate fieldworks."}]]}]]}]
27:["$","div","Grant ordered a march to Spotsylvania",{"className":"moment","children":[["$","$L19",null,{"seconds":1444,"label":"24:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant ordered a march to Spotsylvania"}],["$","p",null,{"children":"At 6:30 a.m. on May 7, he directed Meade to prepare the Army of the Potomac for a night movement southeast around Lee’s right."}]]}]]}]
28:["$","div","U.S. soldiers saw Grant riding south",{"className":"moment","children":[["$","$L19",null,{"seconds":1544,"label":"25:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. soldiers saw Grant riding south"}],["$","p",null,{"children":"Troops along Brock Road understood that the army was continuing the campaign instead of withdrawing north and cheered as Grant passed."}]]}]]}]
