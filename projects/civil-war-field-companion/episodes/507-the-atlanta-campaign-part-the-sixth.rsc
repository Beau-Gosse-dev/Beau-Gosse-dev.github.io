19:["$","div","The organization only needed to outperform the opponent",{"className":"moment","children":[["$","$L16",null,{"seconds":738,"label":"12:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The organization only needed to outperform the opponent"}],["$","p",null,{"children":"The campaign would test whether the unequal U.S. structure could defeat the Army of Tennessee."}]]}]]}]
