12:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L19",null,{"guide":{"date":"April–May 1864","place":"Tennessee, northern Alabama, and north Georgia","result":"Sherman assembled three unequal armies totaling about 100,000 men; Johnston rebuilt a smaller Confederate army whose senior command remained divided","facts":[{"label":"Army of the Cumberland","value":"72,900 men; 130 guns"},{"label":"Army of the Tennessee at hand","value":"24,380 men; 96 guns"},{"label":"Army of the Ohio","value":"12,800 men; 23 guns"},{"label":"U.S. cavalry","value":"About 12,000 troopers"},{"label":"Army of Tennessee","value":"About 55,000 men by late April"}],"maps":[{"title":"The three U.S. army concentration","caption":"The campaign map shows the theater from Nashville and Knoxville through Chattanooga and northern Alabama to Dalton and Resaca.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of the northern part of the Atlanta campaign theater"},{"title":"U.S. winter bases and the Dalton front today","caption":"Thomas concentrated around Chattanooga, McPherson along the railroad from Nashville toward Decatur and Chattanooga, and Schofield around Knoxville.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-88.0%2C33.8%2C-82.5%2C37.0&layer=mapnik&marker=35.045%2C-85.309"},{"title":"The railroad network behind the armies","caption":"Railroads connected the U.S. armies to Nashville and the Confederate army to Atlanta. Unit locations and supply requirements followed those lines.","source":"https://www.loc.gov/item/2018670923/","image":"/images/atlanta-railroad-depot.jpg","alt":"Civil War era railroad depot and tracks in Atlanta"}],"moments":[{"time":"1:37","audioTime":97,"title":"Sherman commanded about 100,000 men","detail":"The force was spread from Nashville to Chattanooga, northern Alabama, northwest Georgia, and Knoxville before concentrating for the campaign."},{"time":"2:23","audioTime":143,"title":"The U.S. command functioned as an army group","detail":"Sherman directed the Army of the Cumberland, Army of the Tennessee, and Army of the Ohio."},{"time":"2:29","audioTime":149,"title":"Thomas commanded the largest army","detail":"The Army of the Cumberland contained IV, XIV, and XX Corps plus a cavalry corps."},{"time":"3:57","audioTime":237,"title":"The Army of the Cumberland had 72,900 men","detail":"Each infantry corps had about 21,000 men, the cavalry about 9,000, and the army fielded 130 guns."},{"time":"4:23","audioTime":263,"title":"McPherson commanded the Army of the Tennessee","detail":"Its field organization drew on XV, XVI, and XVII Corps, but several divisions were absent."},{"time":"5:38","audioTime":338,"title":"Two XVII Corps divisions had not reached the front","detail":"Francis P. Blair’s veterans remained in northern states after furloughs."},{"time":"6:01","audioTime":361,"title":"McPherson had 24,380 men at hand","detail":"Five divisions brought 96 guns but almost no mounted troops."},{"time":"6:26","audioTime":386,"title":"Schofield commanded the smallest army","detail":"The Army of the Ohio had about 12,800 men in XXIII Corps and a cavalry division, with 23 field pieces."},{"time":"7:35","audioTime":455,"title":"The three armies were badly unbalanced","detail":"Thomas’s army could be slow to move, while McPherson and Schofield often lacked enough strength for their assignments."},{"time":"8:51","audioTime":531,"title":"Temporary attachments caused command disputes","detail":"Sherman often sent parts of Thomas’s army to support the smaller armies, but seniority disputes complicated control."},{"time":"9:19","audioTime":559,"title":"Hooker and Palmer resisted subordinate roles","detail":"Both disputed orders or movement priorities when placed under officers they believed they outranked."},{"time":"10:45","audioTime":645,"title":"Sherman controlled four cavalry divisions separately","detail":"About 12,000 troopers guarded flanks, the supply line, and the reserve instead of operating as a unified striking force."},{"time":"12:18","audioTime":738,"title":"The organization only needed to outperform the opponent","detail":"The campaign would test whether the unequal U.S. structure could defeat the Army of Tennessee."},{"time":"14:18","audioTime":858,"title":"Johnston wanted three infantry corps","detail":"The Confederate War Department rejected his proposal, leaving two infantry corps and a cavalry corps at the opening."},{"time":"14:55","audioTime":895,"title":"Hood received a corps","detail":"John B. Hood replaced Thomas C. Hindman as a corps commander; Hindman returned to division command."},{"time":"15:26","audioTime":926,"title":"Johnston rebuilt the rank and file","detail":"Improved supply, furloughs, restored unit relationships, drill, inspections, and mock battles raised morale."},{"time":"16:27","audioTime":987,"title":"The Confederate army reached about 55,000 men","detail":"Recruits and soldiers returning from hospitals increased strength by late April."},{"time":"16:54","audioTime":1014,"title":"Senior command relationships remained poor","detail":"The former pro- and anti-Bragg factions continued to distrust each other after Bragg left the army."},{"time":"18:15","audioTime":1095,"title":"Bragg retained influence from Richmond","detail":"As Davis’s military adviser, Braxton Bragg received back-channel reports from former supporters in the army."},{"time":"20:26","audioTime":1226,"title":"Johnston did not trust Hardee","detail":"Earlier disputes and conflicting reports about the army’s condition led Johnston to exclude Hardee from important consultations."},{"time":"21:22","audioTime":1282,"title":"Johnston relied on Hood","detail":"Hood privately criticized Johnston to contacts in Richmond while implying the army needed more aggressive leadership."},{"time":"22:27","audioTime":1347,"title":"Wheeler also communicated against Johnston","detail":"The cavalry commander remained connected to the pro-Bragg faction and sent critical letters to Richmond."},{"time":"24:32","audioTime":1472,"title":"The U.S. high command had greater political support","detail":"Grant trusted Sherman and Lincoln increasingly trusted Grant, limiting the effect of subordinate complaints."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Three field armies and four cavalry divisions"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Oliver O. Howard, IV Corps; John M. Palmer, XIV Corps; Joseph Hooker, XX Corps; Washington L. Elliott, Cavalry Corps"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"John A. Logan, XV Corps; Grenville M. Dodge, Left Wing XVI Corps; Francis P. Blair, XVII Corps"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"XXIII Corps and one cavalry division"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Two infantry corps and one cavalry corps"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"New corps commander; Thomas C. Hindman returned to division command"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Senior infantry corps commander but rarely consulted by Johnston"},{"commander":"Joseph Wheeler","command":"Cavalry Corps","subordinates":"Maintained political ties to Bragg’s faction"}]}],"people":[{"name":"William T. Sherman","role":"Commanded the three-army U.S. force and personally controlled four cavalry divisions","side":"United States"},{"name":"George H. Thomas","role":"Commanded the 72,900-man Army of the Cumberland","side":"United States"},{"name":"James B. McPherson","role":"Commanded the Army of the Tennessee with only five divisions initially at hand","side":"United States"},{"name":"John M. Schofield","role":"Commanded the 12,800-man Army of the Ohio","side":"United States"},{"name":"Joseph E. Johnston","role":"Improved Confederate morale and strength but did not resolve high-command divisions","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"John B. Hood","role":"Received corps command and privately criticized Johnston to Richmond","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"William J. Hardee","role":"Commanded the other Confederate infantry corps and had a strained relationship with Johnston","side":"Confederacy"},{"name":"Joseph Wheeler","role":"Commanded Confederate cavalry and sent critical reports about Johnston","side":"Confederacy","image":"/images/joseph-wheeler.jpg","source":"https://www.loc.gov/item/2018671172/"}],"losses":[],"gallery":[{"image":"/images/atlanta-campaign-map-1.jpg","alt":"Historical map of the northern Atlanta campaign theater","caption":"The U.S. armies assembled along a broad railroad network before concentrating against Johnston in north Georgia.","source":"https://www.loc.gov/item/2008628278/"},{"image":"/images/joseph-e-johnston.jpg","alt":"Portrait of Joseph E. Johnston","caption":"Johnston rebuilt the Confederate rank and file but retained a divided high command.","source":"https://www.loc.gov/item/2018666539/"},{"image":"/images/john-b-hood.jpg","alt":"Portrait of John B. Hood","caption":"Hood entered the campaign as Johnston’s favored infantry corps commander.","source":"https://www.loc.gov/pictures/item/2002722867/"},{"image":"/images/joseph-wheeler.jpg","alt":"Portrait of Joseph Wheeler","caption":"Wheeler commanded the Army of Tennessee’s cavalry corps.","source":"https://www.loc.gov/item/2018671172/"}],"sources":[{"label":"Official Episode 507 page","url":"https://civilwarpodcast.org/2025/10/12/civil-war-podcast-episode-507/"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"Library of Congress Atlanta railroad photograph","url":"https://www.loc.gov/item/2018670923/"}]}}]}]
