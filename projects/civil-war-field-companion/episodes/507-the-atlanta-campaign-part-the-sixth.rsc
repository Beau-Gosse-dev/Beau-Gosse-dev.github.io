11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Sherman commanded about 100,000 men",{"className":"moment","children":[["$","$L16",null,{"seconds":97,"label":"1:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman commanded about 100,000 men"}],["$","p",null,{"children":"The force was spread from Nashville to Chattanooga, northern Alabama, northwest Georgia, and Knoxville before concentrating for the campaign."}]]}]]}],["$","div","The U.S. command functioned as an army group",{"className":"moment","children":[["$","$L16",null,{"seconds":143,"label":"2:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. command functioned as an army group"}],["$","p",null,{"children":"Sherman directed the Army of the Cumberland, Army of the Tennessee, and Army of the Ohio."}]]}]]}],["$","div","Thomas commanded the largest army",{"className":"moment","children":[["$","$L16",null,{"seconds":149,"label":"2:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas commanded the largest army"}],["$","p",null,{"children":"The Army of the Cumberland contained IV, XIV, and XX Corps plus a cavalry corps."}]]}]]}],["$","div","The Army of the Cumberland had 72,900 men",{"className":"moment","children":[["$","$L16",null,{"seconds":237,"label":"3:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Cumberland had 72,900 men"}],["$","p",null,{"children":"Each infantry corps had about 21,000 men, the cavalry about 9,000, and the army fielded 130 guns."}]]}]]}],["$","div","McPherson commanded the Army of the Tennessee",{"className":"moment","children":[["$","$L16",null,{"seconds":263,"label":"4:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson commanded the Army of the Tennessee"}],["$","p",null,{"children":"Its field organization drew on XV, XVI, and XVII Corps, but several divisions were absent."}]]}]]}],["$","div","Two XVII Corps divisions had not reached the front",{"className":"moment","children":[["$","$L16",null,{"seconds":338,"label":"5:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two XVII Corps divisions had not reached the front"}],["$","p",null,{"children":"Francis P. Blair’s veterans remained in northern states after furloughs."}]]}]]}],["$","div","McPherson had 24,380 men at hand",{"className":"moment","children":[["$","$L16",null,{"seconds":361,"label":"6:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson had 24,380 men at hand"}],["$","p",null,{"children":"Five divisions brought 96 guns but almost no mounted troops."}]]}]]}],["$","div","Schofield commanded the smallest army",{"className":"moment","children":[["$","$L16",null,{"seconds":386,"label":"6:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schofield commanded the smallest army"}],["$","p",null,{"children":"The Army of the Ohio had about 12,800 men in XXIII Corps and a cavalry division, with 23 field pieces."}]]}]]}],["$","div","The three armies were badly unbalanced",{"className":"moment","children":[["$","$L16",null,{"seconds":455,"label":"7:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"The three armies were badly unbalanced"}],["$","p",null,{"children":"Thomas’s army could be slow to move, while McPherson and Schofield often lacked enough strength for their assignments."}]]}]]}],["$","div","Temporary attachments caused command disputes",{"className":"moment","children":[["$","$L16",null,{"seconds":531,"label":"8:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Temporary attachments caused command disputes"}],["$","p",null,{"children":"Sherman often sent parts of Thomas’s army to support the smaller armies, but seniority disputes complicated control."}]]}]]}],["$","div","Hooker and Palmer resisted subordinate roles",{"className":"moment","children":[["$","$L16",null,{"seconds":559,"label":"9:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker and Palmer resisted subordinate roles"}],["$","p",null,{"children":"Both disputed orders or movement priorities when placed under officers they believed they outranked."}]]}]]}],["$","div","Sherman controlled four cavalry divisions separately",{"className":"moment","children":["$L17","$L18"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}]
