27:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
29:["$","div","Jackson has roughly 4,500 men",{"className":"moment","children":[["$","$L28",null,{"seconds":430,"label":"7:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson has roughly 4,500 men"}],["$","p",null,{"children":"A command of more than 8,000 at the start of January had been reduced sharply before Banks’s much larger advance on Winchester."}]]}]]}]
2a:["$","div","Nathaniel Banks enters the narrative",{"className":"moment","children":[["$","$L28",null,{"seconds":454,"label":"7:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nathaniel Banks enters the narrative"}],["$","p",null,{"children":"The episode introduces Banks as the political general who replaced Robert Patterson after Patterson failed to hold Johnston’s army in the Valley in 1861."}]]}]]}]
2b:["$","div","Banks’s political career is set against his inexperience",{"className":"moment","children":[["$","$L28",null,{"seconds":585,"label":"9:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks’s political career is set against his inexperience"}],["$","p",null,{"children":"The hosts trace his rise from a Massachusetts mill family to Speaker of the House and governor while emphasizing that he entered high command without military training."}]]}]]}]
2c:["$","div","Banks gathers a much larger force",{"className":"moment","children":[["$","$L28",null,{"seconds":770,"label":"12:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks gathers a much larger force"}],["$","p",null,{"children":"The episode estimates roughly 38,000 men in western Maryland by late February, although only a fraction would remain around Winchester on March 22."}]]}]]}]
2d:["$","div","McClellan’s plan links Winchester and the B&O",{"className":"moment","children":[["$","$L28",null,{"seconds":826,"label":"13:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan’s plan links Winchester and the B&O"}],["$","p",null,{"children":"Banks was to cross the Potomac, seize Winchester, protect the railroad, and then shift most of the force east while leaving a Valley garrison."}]]}]]}]
2e:["$","div","Banks begins crossing at Harpers Ferry",{"className":"moment","children":[["$","$L28",null,{"seconds":885,"label":"14:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks begins crossing at Harpers Ferry"}],["$","p",null,{"children":"A pontoon bridge carried infantry and cavalry into Virginia in late February, but artillery and supply wagons required a stronger crossing."}]]}]]}]
2f:["$","div","Canal boats fail at the outlet lock",{"className":"moment","children":[["$","$L28",null,{"seconds":910,"label":"15:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canal boats fail at the outlet lock"}],["$","p",null,{"children":"Boats intended as the foundation of the heavier bridge could not pass from the C&O Canal into the river, and McClellan suspended the immediate move on Winchester."}]]}]]}]
30:["$","div","Charles Town and Bunker Hill become interim objectives",{"className":"moment","children":[["$","$L28",null,{"seconds":941,"label":"15:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Charles Town and Bunker Hill become interim objectives"}],["$","p",null,{"children":"Banks occupied the two places while equipment accumulated and work to restore the B&O continued."}]]}]]}]
31:["$","div","Johnston’s retreat releases the United States advance",{"className":"moment","children":[["$","$L28",null,{"seconds":1005,"label":"16:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston’s retreat releases the United States advance"}],["$","p",null,{"children":"When Johnston abandoned the Centreville–Manassas line for the Rappahannock, McClellan ordered forward movements on every front, including the Valley."}]]}]]}]
32:["$","div","Banks occupies Winchester",{"className":"moment","children":[["$","$L28",null,{"seconds":1044,"label":"17:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks occupies Winchester"}],["$","p",null,{"children":"On March 12 the United States column entered the town and found that Jackson had withdrawn the previous evening."}]]}]]}]
33:["$","div","Jackson still wants to contest the advance",{"className":"moment","children":[["$","$L28",null,{"seconds":1130,"label":"18:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson still wants to contest the advance"}],["$","p",null,{"children":"After the advertisement break, the hosts return to Jackson’s request for reinforcements and his willingness to fight despite odds they describe as greater than eight to one."}]]}]]}]
34:["$","div","Johnston restates Jackson’s mission",{"className":"moment","children":[["$","$L28",null,{"seconds":1211,"label":"20:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston restates Jackson’s mission"}],["$","p",null,{"children":"The March 19 instruction was to keep the United States army in the Valley and prevent it from reinforcing McClellan, while remaining as close as prudence allowed."}]]}]]}]
35:["$","div","A proposed night attack collapses",{"className":"moment","children":[["$","$L28",null,{"seconds":1233,"label":"20:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"A proposed night attack collapses"}],["$","p",null,{"children":"The episode returns to March 11: Jackson’s subordinates opposed the plan, and much of the army and its wagons had already moved too far south to execute it."}]]}]]}]
36:["$","div","The armies pause between Mount Jackson and Strasburg",{"className":"moment","children":[["$","$L28",null,{"seconds":1281,"label":"21:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies pause between Mount Jackson and Strasburg"}],["$","p",null,{"children":"Jackson withdrew about 42 miles to Mount Jackson. Banks stopped at Strasburg and placed roughly 9,000 men there under James Shields, according to the episode."}]]}]]}]
37:["$","div","Shields’s background",{"className":"moment","children":[["$","$L28",null,{"seconds":1298,"label":"21:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shields’s background"}],["$","p",null,{"children":"The Irish-born lawyer, politician, former senator, and Mexican War brigadier had considerable military experience before taking a division in the Valley."}]]}]]}]
38:["$","div","McClellan begins emptying the Valley",{"className":"moment","children":[["$","$L28",null,{"seconds":1404,"label":"23:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan begins emptying the Valley"}],["$","p",null,{"children":"Troops moved east toward the Washington covering force. Shields’s division began falling back from Strasburg toward Winchester on March 20."}]]}]]}]
39:["$","div","Ashby reports that Banks appears to be leaving",{"className":"moment","children":[["$","$L28",null,{"seconds":1461,"label":"24:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ashby reports that Banks appears to be leaving"}],["$","p",null,{"children":"The cavalry report made clear to Jackson that the United States movement threatened his assigned mission of keeping troops in the Valley."}]]}]]}]
3a:["$","div","Jackson’s column marches north",{"className":"moment","children":[["$","$L28",null,{"seconds":1493,"label":"24:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s column marches north"}],["$","p",null,{"children":"At dawn on March 22 the infantry began a hard movement toward Winchester, using route step and shedding stragglers and wagons along the muddy road."}]]}]]}]
3b:["$","div","The forced-march distances are measured",{"className":"moment","children":[["$","$L28",null,{"seconds":1589,"label":"26:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The forced-march distances are measured"}],["$","p",null,{"children":"Most units covered about 21 miles that day; rear regiments marched as many as 27 before bivouacking near Cedar Creek. Jackson established headquarters at Strasburg."}]]}]]}]
3c:["$","div","Ashby clashes with United States troops near Kernstown",{"className":"moment","children":[["$","$L28",null,{"seconds":1639,"label":"27:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ashby clashes with United States troops near Kernstown"}],["$","p",null,{"children":"His cavalry pursued Federal horsemen north but encountered artillery and infantry as the action expanded south of Winchester."}]]}]]}]
3d:["$","div","A shell fragment wounds Shields",{"className":"moment","children":[["$","$L28",null,{"seconds":1667,"label":"27:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"A shell fragment wounds Shields"}],["$","p",null,{"children":"The projectile fractured his left arm above the elbow. Shields was evacuated to Winchester and turned field command over to Colonel Nathan Kimball."}]]}]]}]
3e:["$","div","Nathan Kimball takes command",{"className":"moment","children":[["$","$L28",null,{"seconds":1690,"label":"28:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nathan Kimball takes command"}],["$","p",null,{"children":"The episode sketches the Indiana physician’s Mexican War service and his command of the 14th Indiana before he became Shields’s senior brigade commander."}]]}]]}]
3f:["$","div","United States artillery ends the skirmish",{"className":"moment","children":[["$","$L28",null,{"seconds":1753,"label":"29:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States artillery ends the skirmish"}],["$","p",null,{"children":"Kimball used superior artillery to push Ashby’s small force south. The Confederate cavalry withdrew to Newtown."}]]}]]}]
40:["$","div","Ashby sends dangerously false intelligence",{"className":"moment","children":[["$","$L28",null,{"seconds":1767,"label":"29:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ashby sends dangerously false intelligence"}],["$","p",null,{"children":"He concluded that only four United States regiments remained at Winchester and that they would retreat toward Harpers Ferry the next day. Shields’s division was still present."}]]}]]}]
41:["$","div","Straggling cuts Jackson below 3,500",{"className":"moment","children":[["$","$L28",null,{"seconds":1831,"label":"30:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Straggling cuts Jackson below 3,500"}],["$","p",null,{"children":"Despite the exhaustion and reduced strength, Jackson accepted the reports that he faced only a small rear guard."}]]}]]}]
42:["$","div","The strategic logic of an attack",{"className":"moment","children":[["$","$L28",null,{"seconds":1861,"label":"31:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"The strategic logic of an attack"}],["$","p",null,{"children":"Jackson hoped that defeating the force near Winchester would force Banks to halt or reverse the transfer of troops out of the Valley."}]]}]]}]
43:["$","div","Orders go out for a daybreak advance",{"className":"moment","children":[["$","$L28",null,{"seconds":1910,"label":"31:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Orders go out for a daybreak advance"}],["$","p",null,{"children":"The episode closes its military narrative with Jackson preparing the tired command to resume marching north on Sunday, March 23."}]]}]]}]
44:["$","div","The hosts recommend a campaign atlas",{"className":"moment","children":[["$","$L28",null,{"seconds":1924,"label":"32:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The hosts recommend a campaign atlas"}],["$","p",null,{"children":"They explain why maps are essential for following the Valley’s roads, ridges, gaps, and repeated marches and countermarches."}]]}]]}]
45:["$","div","“Down” and “up” follow the Shenandoah",{"className":"moment","children":[["$","$L28",null,{"seconds":1991,"label":"33:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"“Down” and “up” follow the Shenandoah"}],["$","p",null,{"children":"The hosts explain that traveling north is going down the Valley and traveling south is going up it because the Shenandoah flows north toward Harpers Ferry."}]]}]]}]
