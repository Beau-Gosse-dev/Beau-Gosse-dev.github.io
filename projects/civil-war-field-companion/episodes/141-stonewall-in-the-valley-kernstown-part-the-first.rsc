4b:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Thomas J. “Stonewall” Jackson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep141-stonewall-jackson.jpg","alt":"Portrait of Thomas J. “Stonewall” Jackson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Commanded the Valley District, survived the Loring dispute, withdrew from Winchester, and ordered the March 22 countermarch that led to Kernstown"}]]}]]}],["$","article","Nathaniel P. Banks",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep141-nathaniel-banks.jpg","alt":"Portrait of Nathaniel P. Banks","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Nathaniel P. Banks"}],["$","p",null,{"children":"Political major general who led the United States advance into Winchester and began shifting troops east after Jackson retreated"}]]}]]}],["$","article","James Shields",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JS"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"James Shields"}],["$","p",null,{"children":"Experienced Mexican War officer commanding the United States division left near Winchester; wounded in the March 22 skirmish"}]]}]]}],["$","article","Nathan Kimball",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"NK"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Nathan Kimball"}],["$","p",null,{"children":"Senior brigade commander in Shields’s division who took field command after Shields was wounded"}]]}]]}],["$","article","Turner Ashby",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"TA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Turner Ashby"}],["$","p",null,{"children":"Confederate cavalry commander whose March 22 skirmish and faulty estimate of the force at Winchester shaped Jackson’s decision to attack"}]]}]]}],["$","article","Joseph E. Johnston",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Joseph E. Johnston"}],["$","p",null,{"children":"Jackson’s departmental superior, whose withdrawal exposed the Valley and whose March 19 order directed Jackson to keep Banks from reinforcing McClellan"}]]}]]}],["$","article","George B. McClellan",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George B. McClellan"}],["$","p",null,{"children":"Planned the occupation of Winchester and the subsequent transfer of Valley troops to cover Washington during the Peninsula Campaign"}]]}]]}],["$","article","William W. Loring",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WW"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"c