1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",141," · ","January 23–March 22, 1862"," · ","Romney and Winchester, Virginia; Harpers Ferry and the Potomac crossings; Charles Town, Bunker Hill, Middletown, Strasburg, Cedar Creek, Mount Jackson, Newtown, and Kernstown in the Shenandoah Valley"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: KERNSTOWN (Part the First)"}],["$","span",null,{"className":"result-label","children":"The episode ends before the First Battle of Kernstown. The Loring dispute reduced Jackson’s Valley force to an all-Virginia command of roughly 4,500 effectives in early March. Banks occupied Winchester, then began moving troops east toward McClellan. Acting on orders to keep those troops in the Valley, Jackson reversed his retreat and marched north on March 22. A skirmish near Kernstown wounded James Shields and left Nathan Kimball in field command. Turner Ashby then seriously underestimated the United States force still near Winchester, leading Jackson to order an advance for March 23 against what he believed was a small rear guard"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7871636261.mp3?updated=1695307383","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Aftermath of the Romney Expedition through the night of March 22, 1862"}],["$","small",null,{"children":"The March 23 Battle of Kernstown begins in episode 142. This installment explains the command disputes, strategic orders, troop movements, skirmish, and intelligence failure that produced the battle."}]]}],["$","div","Loring–Jackson dispute",{"children":[["$","span",null,{"children":"Loring–Jackson dispute"}],["$","strong",null,{"children":"January 23–February 7, 1862"}],["$","small",null,{"children":"Loring’s officers sought withdrawal from Romney, Secretary of War Judah P. Benjamin ordered Jackson to recall them, and Jackson responded by requesting reassignment to VMI or acceptance of his resignation. He withdrew the resignation on February 6 and preferred charges against Loring the next day."}]]}],["$","div","Chain-of-command controversy",{"children":[["$","span",null,{"children":"Chain-of-command controversy"}],["$","strong",null,{"children":"The episode and a modern reference describe the petition process differently"}],["$","small",null,{"children":"The episode says the officers’ petition was forwarded through channels while Loring separately lobbied Richmond. Encyclopedia Virginia characterizes both the petition and Loring’s representations as bypassing Jackson. What is clear is that Richmond intervened without first consulting Jackson."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}],"$L21","$L22","$L23","$L24",false,"$L25","$L26","$L27"]}]]}]
28:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Disposition of William W. Loring",{"children":[["$","span",null,{"children":"Disposition of William W. Loring"}],["$","strong",null,{"children":"Promoted to major general and transferred"}],["$","small",null,{"children":"Richmond did not convene the court-martial Jackson sought. Loring’s former division was broken up, and most of its non-Virginia regiments left the Valley District."}]]}]
f:["$","div","Jackson’s force, early March",{"children":[["$","span",null,{"children":"Jackson’s force, early March"}],["$","strong",null,{"children":"About 4,500 men; three infantry brigades, cavalry, and 26 guns"}],["$","small",null,{"children":"The episode describes ten Virginia infantry regiments, one five-company Virginia battalion, one cavalry regiment, and five artillery batteries. NPS summaries round the force immediately before Kernstown to about 3,500–4,000 after marching and straggling."}]]}]
10:["$","div","Confederate infantry organization",{"children":[["$","span",null,{"children":"Confederate infantry organization"}],["$","strong",null,{"children":"Garnett, Burks, and Fulkerson brigades"}],["$","small",null,{"children":"Richard B. Garnett led the five-regiment Stonewall Brigade; Jesse S. Burks led three regiments and the 1st Virginia Battalion; Samuel V. Fulkerson led the 23rd and 37th Virginia. The NPS order of battle records several artillery units as unengaged on March 23."}]]}]
11:["$","div","Nathaniel P. Banks",{"children":[["$","span",null,{"children":"Nathaniel P. Banks"}],["$","strong",null,{"children":"Political major general with no prior military training"}],["$","small",null,{"children":"A former mill worker, lawyer, Speaker of the U.S. House, and governor of Massachusetts, Banks was commissioned major general of volunteers in May 1861. The episode is openly critical of his military ability; that judgment is interpretation, not a neutral rank or biographical fact."}]]}]
12:["$","div","United States strength",{"children":[["$","span",null,{"children":"United States strength"}],["$","strong",null,{"children":"The episode estimates about 38,000 men in western Maryland by late February"}],["$","small",null,{"children":"That number describes the broad concentration available to Banks and nearby forces, not the force later engaged at Kernstown. Modern NPS accounts place Banks at roughly 20,000 during the advance and Shields’s remaining division near Winchester at about 8,000–10,000."}]]}]
13:["$","div","United States operational purpose",{"children":[["$","span",null,{"children":"United States operational purpose"}],["$","strong",null,{"children":"Secure the B&O, take Winchester, then shift troops east"}],["$","small",null,{"children":"McClellan intended Banks to remove the immediate threat to the railroad and leave a sufficient Valley guard while other troops joined the covering force for Washington during the Peninsula Campaign."}]]}]
14:["$","div","Harpers Ferry crossing",{"children":[["$","span",null,{"children":"Harpers Ferry crossing"}],["$","strong",null,{"children":"Infantry and cavalry crossed in late February; heavy movement was delayed"}],["$","small",null,{"children":"A pontoon bridge carried troops, but canal boats intended to support a stronger bridge for artillery and wagons could not pass through the outlet lock. The episode presents the mishap as another example of McClellan’s operational delay."}]]}]
15:["$","div","Interim occupations",{"children":[["$","span",null,{"children":"Interim occupations"}],["$","strong",null,{"children":"Charles Town and Bunker Hill"}],["$","small",null,{"children":"While the crossing problem was addressed, Banks occupied these places north and northeast of Winchester to cover work on the B&O. The transcript’s automated rendering of the Charles Town distance as “forty miles” is unreliable and is not repeated here."}]]}]
16:["$","div","Jackson evacuates Winchester",{"children":[["$","span",null,{"children":"Jackson evacuates Winchester"}],["$","strong",null,{"children":"March 11, 1862"}],["$","small",null,{"children":"Johnston’s withdrawal from the Centreville–Manassas line exposed Jackson to a much larger advance. Banks entered Winchester on March 12 and found the Confederates gone."}]]}]
17:["$","div","Jackson’s proposed night attack",{"children":[["$","span",null,{"children":"Jackson’s proposed night attack"}],["$","strong",null,{"children":"Abandoned on March 11"}],["$","small",null,{"children":"The episode says Jackson hoped to surprise Banks but found his subordinates opposed and much of the command already too far south. His reported vow to Surgeon Hunter McGuire never again to hold a council of war comes through recollection and should be treated as anecdotal wording."}]]}]
18:["$","div","Strategic mission",{"children":[["$","span",null,{"children":"Strategic mission"}],["$","strong",null,{"children":"Keep Banks in the Valley and away from McClellan"}],["$","small",null,{"children":"Johnston reiterated the mission on March 19, directing Jackson to stay as close as prudence allowed. The resulting Confederate movement was a strategic diversion in support of Richmond’s defense."}]]}]
19:["$","div","Union redistribution",{"children":[["$","span",null,{"children":"Union redistribution"}],["$","strong",null,{"children":"Shields’s division remained as the Valley covering force"}],["$","small",null,{"children":"Williams’s division moved east and Shields began returning from Strasburg to Winchester on March 20. The episode also calls Sedgwick’s formation one of Banks’s divisions; under the Army of the Potomac’s March corps organization, Sedgwick belonged to Sumner’s II Corps, not Banks’s V Corps."}]]}]
1a:["$","div","March 22 forced march",{"children":[["$","span",null,{"children":"March 22 forced march"}],["$","strong",null,{"children":"Most Confederate units covered about 21 miles; rear units as many as 27"}],["$","small",null,{"children":"Cold wind, mud, fatigue, and straggling reduced the force that reached the Strasburg area. The episode places Jackson’s headquarters at Strasburg and rear bivouacs near Cedar Creek that night."}]]}]
1b:["$","div","March 22 skirmish",{"children":[["$","span",null,{"children":"March 22 skirmish"}],["$","strong",null,{"children":"Kernstown, south of Winchester"}],["$","small",null,{"children":"Ashby’s cavalry encountered United States cavalry, artillery, and infantry. Federal artillery drove the Confederates back toward Newtown. This was a preliminary action, not the March 23 battle."}]]}]
1c:["$","div","James Shields wounded",{"children":[["$","span",null,{"children":"James Shields wounded"}],["$","strong",null,{"children":"Left arm fractured by a shell fragment"}],["$","small",null,{"children":"Shields returned to Winchester and Colonel Nathan Kimball, his senior brigade commander, assumed field command. Shields survived; this injury does not belong in a killed or mortally wounded list."}]]}]
1d:["$","div","Ashby’s intelligence error",{"children":[["$","span",null,{"children":"Ashby’s intelligence error"}],["$","strong",null,{"children":"Reported only four United States regiments remained"}],["$","small",null,{"children":"Ashby relied on his limited contact and information from local civilians. In fact, Shields’s division remained around Winchester. Modern accounts differ slightly on its strength, generally placing it near 8,000–10,000."}]]}]
1e:["$","div","Jackson’s decision",{"children":[["$","span",null,{"children":"Jackson’s decision"}],["$","strong",null,{"children":"Advance at daybreak on March 23"}],["$","small",null,{"children":"Heavy straggling left Jackson fewer than 3,500 men by the episode’s estimate. He nevertheless believed he faced a small rear guard and that an attack might compel Banks to return troops to the Valley."}]]}]
1f:["$","div","Valley directions",{"children":[["$","span",null,{"children":"Valley directions"}],["$","strong",null,{"children":"North is “down the Valley”; south is “up the Valley”"}],["$","small",null,{"children":"The terminology follows the Shenandoah River’s northward flow toward Harpers Ferry. It can appear reversed if read only as elevation-independent compass language."}]]}]
20:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"National Geographic Atlas of the Civil War"}],["$","small",null,{"children":"The episode credits editor Neil Kagan and text author Stephen G. Hyslop. The transcript misspells Hyslop and also misrenders S. C. Gwynne’s name during the Shields biography."}]]}]
21:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
22:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Banks advances while Jackson yields the lower Valley",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep141-valley-strategy.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Banks advances while Jackson yields the lower Valley at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep141-valley-strategy.svg","alt":"Schematic map of Banks’s advance from Harpers Ferry to Winchester, Jackson’s withdrawal to Mount Jackson, and Jackson’s March 22 countermarch toward Strasburg","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Banks advances while Jackson yields the lower Valley"}],["$","span",null,{"children":"Banks crossed at Harpers Ferry, occupied Charles Town and Bunker Hill, and entered Winchester on March 12 after Jackson withdrew south through Strasburg toward Mount Jackson. When Shields began moving back toward Winchester and other troops shifted east, Jackson turned north on March 22. The geography and arrows are schematic and do not claim exact daily camp boundaries."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep141-valley-strategy.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$22:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","March 22: skirmish, command change, and faulty report",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep141-march22-prelude.svg","target":"_blank","rel":"noreferrer","aria-label":"Open March 22: skirmish, command change, and faulty report at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep141-march22-prelude.svg","alt":"Schematic map of the March 22 skirmish near Kernstown, Ashby’s retreat to Newtown, and Jackson’s infantry march from the south","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"March 22: skirmish, command change, and faulty report"}],["$","span",null,{"children":"Ashby’s cavalry pressed United States outposts near Kernstown but met cavalry, artillery, and infantry. A shell fragment fractured Shields’s arm; Kimball took field command. Federal artillery pushed Ashby back toward Newtown, from where he reported that only four regiments remained near Winchester. Jackson’s infantry meanwhile marched north to the Strasburg and Cedar Creek area. This is a schematic pre-battle map, not a reconstruction of March 23 unit frontages."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep141-march22-prelude.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$22:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://home.nps.gov/articles/000/first-battle-of-kernstown.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$22:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
23:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The Valley story resumes after Romney",{"className":"moment","children":[["$","$L28",null,{"seconds":69,"label":"1:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Valley story resumes after Romney"}],["$","p",null,{"children":"The hosts recap the limited success at Dam No. 5 and the harsh Bath–Romney expedition before turning to its command consequences."}]]}]]}],["$","div","Jackson pursues charges against William Gilham",{"className":"moment","children":[["$","$L28",null,{"seconds":146,"label":"2:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson pursues charges against William Gilham"}],["$","p",null,{"children":"Jackson blamed the former VMI colleague for allowing the United States force at Bath to escape. The episode also faults Jackson’s decision to use militia in the blocking movement."}]]}]]}],["$","div","Loring’s men accuse the Stonewall Brigade of favoritism",{"className":"moment","children":[["$","$L28",null,{"seconds":236,"label":"3:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Loring’s men accuse the Stonewall Brigade of favoritism"}],["$","p",null,{"children":"Sickness and resentment from the winter expedition sharpened the division between Loring’s troops and Jackson’s original brigade."}]]}]]}],["$","div","The commands separate",{"className":"moment","children":[["$","$L28",null,{"seconds":251,"label":"4:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The commands separate"}],["$","p",null,{"children":"Jackson sent Richard Garnett and the Stonewall Brigade to Winchester while Loring’s command remained at Romney."}]]}]]}],["$","div","Loring’s officers petition Richmond",{"className":"moment","children":[["$","$L28",null,{"seconds":265,"label":"4:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Loring’s officers petition Richmond"}],["$","p",null,{"children":"The discontented officers sought removal from Romney. Sources disagree over whether the written petition itself followed the chain of command, but Loring also pressed the case directly in Richmond."}]]}]]}],["$","div","Richmond orders the withdrawal from Romney",{"className":"moment","children":[["$","$L28",null,{"seconds":294,"label":"4:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richmond orders the withdrawal from Romney"}],["$","p",null,{"children":"President Jefferson Davis and Secretary of War Judah P. Benjamin directed Jackson to recall Loring’s troops. Jackson complied promptly."}]]}]]}],["$","div","Jackson tenders his resignation",{"className":"moment","children":[["$","$L28",null,{"seconds":303,"label":"5:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson tenders his resignation"}],["$","p",null,{"children":"He treated the War Department’s intervention as destructive of his authority and asked for reassignment to VMI or acceptance of his resignation."}]]}]]}],["$","div","Governor Letcher becomes Jackson’s political channel",{"className":"moment","children":[["$","$L28",null,{"seconds":327,"label":"5:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Governor Letcher becomes Jackson’s political channel"}],["$","p",null,{"children":"Jackson wrote privately to Virginia governor John Letcher, whose intervention helped keep him in command of the Valley District."}]]}]]}],["$","div","Jackson files charges against Loring",{"className":"moment","children":[["$","$L28",null,{"seconds":348,"label":"5:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson files charges against Loring"}],["$","p",null,{"children":"The War Department did not pursue a court-martial. Loring was instead promoted and transferred, and much of his former command left the Valley."}]]}]]}],["$","div","The Valley army becomes an all-Virginia force",{"className":"moment","children":[["$","$L28",null,{"seconds":405,"label":"6:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Valley army becomes an all-Virginia force"}],["$","p",null,{"children":"By March 3 Jackson retained three infantry brigades containing ten regiments and one battalion, a cavalry regiment, and five batteries with 26 guns."}]]}]]}],"$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45"]}]]}]
24:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","National strategic direction",{"className":"command-entry","children":[["$","strong",null,{"children":"National strategic direction"}],["$","span",null,{"children":"President Abraham Lincoln and Secretary of War Edwin M. Stanton"}],["$","small",null,{"children":"Pressed for protection of the Baltimore & Ohio Railroad and an advance into the lower Shenandoah Valley before McClellan moved against Richmond"}]]}],["$","div","Army of the Potomac; General-in-Chief until March 11",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac; General-in-Chief until March 11"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Directed the Harpers Ferry crossing, the move on Winchester, and the later transfer of troops east for Washington’s covering force"}]]}],["$","div","V Corps, Army of the Potomac from March 18",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps, Army of the Potomac from March 18"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Williams’s and Shields’s divisions; occupied Winchester, then began shifting forces toward Manassas and Washington"}]]}],["$","div","First Division, V Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"First Division, V Corps"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Moved east out of the Valley as McClellan reduced the force required to hold Winchester and the mountain approaches"}]]}],["$","div","Second Division, V Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Division, V Corps"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"Three infantry brigades under Nathan Kimball, Jeremiah C. Sullivan, and Erastus B. Tyler, with cavalry and artillery; wounded March 22"}]]}],["$","div","First Brigade, Shields’s division; acting field commander",{"className":"command-entry","children":[["$","strong",null,{"children":"First Brigade, Shields’s division; acting field commander"}],["$","span",null,{"children":"Col. Nathan Kimball"}],["$","small",null,{"children":"14th Indiana, 8th Ohio, 67th Ohio, and 84th Pennsylvania; assumed command after Shields was wounded"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Department of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Northern Virginia"}],["$","span",null,{"children":"Gen. Joseph E. Johnston"}],["$","small",null,{"children":"Withdrew the main army from Centreville–Manassas and ordered Jackson to keep Banks’s troops in the Valley and away from McClellan"}]]}],["$","div","Valley District",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"An all-Virginia command of three infantry brigades, the 7th Virginia Cavalry, and five artillery batteries by early March"}]]}],["$","div","Stonewall Brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Brig. Gen. Richard B. Garnett"}],["$","small",null,{"children":"2nd, 4th, 5th, 27th, and 33rd Virginia Infantry; three associated batteries are listed in the NPS Kernstown order of battle"}]]}],["$","div","Second Brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Brigade"}],"$L46","$L47"]}],"$L48","$L49"]]}]]}],"$L4a","$L4b"]}]
25:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep141-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep141-stonewall-jackson.jpg","alt":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s Valley command had been weakened by transfers and internal conflict, but his March 19 orders required him to prevent Banks’s troops from leaving the Valley."}]]}],["$","figure","/images/ep141-nathaniel-banks.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep141-nathaniel-banks.jpg","alt":"Photographic portrait of United States major general Nathaniel P. Banks standing in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Banks entered high command from a successful political career. He occupied Winchester on March 12 and soon began transferring troops east as part of McClellan’s wider plan."}]]}],["$","figure","/images/ep141-hotchkiss-valley-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep141-hotchkiss-valley-map.jpg","alt":"Historic map of the Shenandoah Valley showing the corridor between Winchester and Staunton","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jedediah Hotchkiss’s postwar 1880 map illustrates the Valley’s long north–south corridor, mountain barriers, roads, and settlements. It is a geographic reference; the Library of Congress notes that it does not plot troop positions or movements."}]]}],["$","figure","/images/ep141-valley-strategy.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep141-valley-strategy.svg","alt":"Schematic operational map of Banks’s advance and Jackson’s withdrawal and countermarch in the lower Shenandoah Valley","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The operational problem ran along one connected corridor from Harpers Ferry through Winchester and Strasburg to Mount Jackson. Arrows and locations are schematic."}]]}],["$","figure","/images/ep141-march22-prelude.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep141-march22-prelude.svg","alt":"Schematic map of the March 22 prelude around Winchester, Kernstown, Newtown, Cedar Creek, and Strasburg","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The March 22 skirmish wounded Shields, placed Kimball in field command, and produced Ashby’s false estimate while Jackson’s infantry approached from the south."}]]}]]}]]}]
