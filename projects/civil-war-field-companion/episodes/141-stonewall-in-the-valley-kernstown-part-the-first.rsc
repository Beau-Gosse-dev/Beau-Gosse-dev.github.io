0:{"page:/episodes/141-stonewall-in-the-valley-kernstown-part-the-first":"$L1","layout:/":"$L2","route:/episodes/141-stonewall-in-the-valley-kernstown-part-the-first":"$L3","__route":"route:/episodes/141-stonewall-in-the-valley-kernstown-part-the-first","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","__bfcacheSegmentIdentities":{"layout:/":"[\"layout\",\"layout:/\",\"root-boundary:/\",\"\"]","page:/episodes/141-stonewall-in-the-valley-kernstown-part-the-first":"[\"page\",\"page:/episodes/:slug\",\"root-boundary:/\",\"[\\\"episodes\\\",\\\"slug|141-stonewall-in-the-valley-kernstown-part-the-first|d\\\"]\"]"},"__srcPage":["episodes","[slug]","page"],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:640e88f6fbbce9f5","deploymentVersion":"2bc6263e-251a-44e9-b5dd-756e657cf2c0","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
