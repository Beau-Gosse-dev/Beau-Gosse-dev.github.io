1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",133," · ","May 4-7, 1862"," · ","The Virginia Peninsula from Yorktown through Williamsburg to Eltham's Landing near West Point, Virginia"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN (Part the Fourth)"}],["$","span",null,{"className":"result-label","children":"The Battle of Williamsburg on May 5 and the fight at Eltham's Landing on May 7 were tactically inconclusive. Operationally, the Confederate rear guard achieved its purpose: it delayed and contained the United States pursuit while Joseph E. Johnston's army, artillery, and trains continued toward Richmond. Hancock repulsed Early's poorly coordinated attack at Williamsburg, but the opportunity against the Confederate flank was not exploited. Franklin established a bridgehead at Eltham's Landing but did not reach the retreat road in time to block Johnston's column"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4570306749.mp3?updated=1695220018","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Battle of Williamsburg",{"children":[["$","span",null,{"children":"Battle of Williamsburg"}],["$","strong",null,{"children":"May 5, 1862"}],["$","small",null,{"children":"Also called the Battle of Fort Magruder; the National Park Service classifies the result as indecisive."}]]}],["$","div","Rear-guard objective",{"children":[["$","span",null,{"children":"Rear-guard objective"}],["$","strong",null,{"children":"Protect Johnston's withdrawal toward Richmond"}],["$","small",null,{"children":"Longstreet held the prepared Williamsburg line while Confederate trains struggled over rain-soaked roads."}]]}],["$","div","Williamsburg defensive position",{"children":[["$","span",null,{"children":"Williamsburg defensive position"}],["$","strong",null,{"children":"Fort Magruder and a line of smaller redoubts"}],["$","small",null,{"children":"Creeks, swampy ground, felled timber, and the narrow Peninsula restricted the routes of approach. Contemporary accounts and later summaries describe 13 smaller redoubts in addition to Fort Magruder."}]]}],["$","div","Williamsburg casualties",{"children":[["$","span",null,{"children":"Williamsburg casualties"}],["$","strong",null,{"children":"About 2,300 United States and 1,600 Confederate"}],["$","small",null,{"children":"The NPS battle database gives 2,283 and 1,560. Other authoritative summaries give approximately 2,300 and 1,600, while a commonly cited Confederate total of 1,682 includes the May 4 cavalry fighting. The 5th North Carolina return was omitted from one Official Records-based tabulation."}]]}],["$","div","Hooker's division",{"children":[["$","span",null,{"children":"Hooker's division"}],["$","strong",null,{"children":"Fought unsupported for much of May 5"}],["$","small",null,{"children":"Kearny's arriving division stabilized the United States left after Confederate attacks pushed Hooker's line toward the Lee's Mill Road."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15"]}],"$L16","$undefined","$L17",false,"$L18","$L19","$L1a","$L1b","$L1c"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Hancock's flanking force",{"children":[["$","span",null,{"children":"Hancock's flanking force"}],["$","strong",null,{"children":"About 3,400 infantry and eight guns"}],["$","small",null,{"children":"Hancock crossed Cub Creek, occupied two empty redoubts on the Confederate left, and repulsed elements of Early's brigade."}]]}]
f:["$","div","Early's brigade losses",{"children":[["$","span",null,{"children":"Early's brigade losses"}],["$","strong",null,{"children":"508 reported in the episode"}],["$","small",null,{"children":"The episode says the 5th North Carolina alone lost 302 killed, wounded, or captured. Published tabulations differ because returns are incomplete and may separate that regiment from the rest of the brigade."}]]}]
10:["$","div","Senior officers killed at Williamsburg",{"children":[["$","span",null,{"children":"Senior officers killed at Williamsburg"}],["$","strong",null,{"children":"At least four regimental commanders"}],["$","small",null,{"children":"United States Lieutenant Colonel John P. Van Leer and Confederate Colonel George T. Ward, Lieutenant Colonel Thomas E. Irby, and Colonel Christopher H. Mott were killed."}]]}]
11:["$","div","Hancock becomes \"the Superb\"",{"children":[["$","span",null,{"children":"Hancock becomes \"the Superb\""}],["$","strong",null,{"children":"McClellan praised Hancock's performance"}],["$","small",null,{"children":"Newspaper use of the phrase helped establish the nickname after the battle."}]]}]
12:["$","div","Battle of Eltham's Landing",{"children":[["$","span",null,{"children":"Battle of Eltham's Landing"}],["$","strong",null,{"children":"May 7, 1862"}],["$","small",null,{"children":"Also called Barhamsville or West Point; the National Park Service classifies it as indecisive."}]]}]
13:["$","div","Eltham's Landing casualties",{"children":[["$","span",null,{"children":"Eltham's Landing casualties"}],["$","strong",null,{"children":"Approximately 186 United States and 48 Confederate"}],["$","small",null,{"children":"The NPS battle database gives a total of 234. Some secondary accounts give a slightly higher United States figure."}]]}]
14:["$","div","Operational outcome at Eltham",{"children":[["$","span",null,{"children":"Operational outcome at Eltham"}],["$","strong",null,{"children":"The bridgehead did not cut the Confederate retreat route"}],["$","small",null,{"children":"Hood's brigade pushed the United States picket line back before disengaging; Johnston's column continued toward Richmond."}]]}]
15:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"Civil War Times Illustrated, March 2001"}],["$","small",null,{"children":"George W. Contant, \"The Men Who Made Hancock Superb.\" The transcript renders the surname as \"Content.\""}]]}]
16:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
17:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Williamsburg and Eltham's Landing in the Peninsula Campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep133-williamsburg-elthams-operations.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Williamsburg and Eltham's Landing in the Peninsula Campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-williamsburg-elthams-operations.svg","alt":"Schematic operational map of the Confederate retreat through Williamsburg and the United States water movement to Eltham's Landing","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Williamsburg and Eltham's Landing in the Peninsula Campaign"}],["$","span",null,{"children":"This operational map shows Johnston's retreat from Yorktown through Williamsburg toward Richmond and Franklin's water movement to Eltham's Landing near West Point. The May 5 rear-guard action delayed the land pursuit; the May 7 landing came too late to block the retreat road."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep133-williamsburg-elthams-operations.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Battle of Williamsburg: divided attacks and an unexploited flank",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep133-williamsburg-tactical.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Battle of Williamsburg: divided attacks and an unexploited flank at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-williamsburg-tactical.svg","alt":"Schematic tactical map of Hooker's attack, Kearny's reinforcement, Hancock's flank movement, and Early's counterattack at Williamsburg","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Battle of Williamsburg: divided attacks and an unexploited flank"}],["$","span",null,{"children":"Hooker fought west of the road junction at Fort Magruder. Kearny arrived to stop Longstreet's counterattack. On the opposite flank, Hancock crossed Cub Creek and occupied empty redoubts, but Sumner withheld broader support. Early then attacked Hancock without adequate reconnaissance and was repulsed."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep133-williamsburg-tactical.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/gvhs01.vhs00006/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
18:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Commander, Army of the Potomac-George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Army of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Directed the pursuit and the West Point water movement; remained at Yorktown until late in the Battle of Williamsburg"}]]}],["$","div","Senior corps commander and field commander of the pursuit-Edwin V. Sumner",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior corps commander and field commander of the pursuit"}],["$","span",null,{"children":"Edwin V. Sumner"}],["$","small",null,{"children":"Exercised authority at Williamsburg although his II Corps troops were absent; controlled support sent toward Hooker and Hancock"}]]}],["$","div","Commander, III Corps-Samuel P. Heintzelman",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, III Corps"}],["$","span",null,{"children":"Samuel P. Heintzelman"}],["$","small",null,{"children":"Joseph Hooker's division opened the main action; Philip Kearny's division arrived to stabilize the left"}]]}],["$","div","Commander, IV Corps-Erasmus D. Keyes",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, IV Corps"}],["$","span",null,{"children":"Erasmus D. Keyes"}],["$","small",null,{"children":"William F. Smith's division approached on the right; Winfield S. Hancock led the brigade sent across Cub Creek"}]]}],["$","div","Division commander at Eltham's Landing-William B. Franklin",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander at Eltham's Landing"}],["$","span",null,{"children":"William B. Franklin"}],["$","small",null,{"children":"Moved by transport up the York River, established the bridgehead, and held his position during the May 7 fighting"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Overall commander of the Confederate field army-Joseph E. Johnston",{"className":"command-entry","children":[["$","strong",null,{"children":"Overall commander of the Confederate field army"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"Directed the withdrawal toward Richmond and assigned forces to delay the land pursuit and contain the Eltham bridgehead"}]]}],["$","div","Rear-guard commander at Williamsburg-James Longstreet",{"className":"command-entry","children":[["$","strong",null,{"children":"Rear-guard commander at Williamsburg"}],["$","span",null,{"children":"James Longstreet"}],["$","small",null,{"children":"Used his division at the fortified line and placed Richard H. Anderson in immediate charge of attacks against Hooker"}]]}],["$","div","Senior commander and reserve at Williamsburg-D. H. Hill",{"className":"command-entry","children":["$L1d","$L1e","$L1f"]}],"$L20","$L21"]]}]]}],"$L22"]]]}]
19:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","John P. Van Leer",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John P. Van Leer"}],["$","p",null,{"children":[["$","strong",null,{"children":["Lieutenant colonel commanding the 6th New Jersey Infantry","."]}]," ","Killed in action at Williamsburg on May 5, 1862"]}]]}],["$","article","George T. Ward",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"George T. Ward"}],["$","p",null,{"children":[["$","strong",null,{"children":["Colonel commanding the 2nd Florida Infantry","."]}]," ","Killed in action at Williamsburg on May 5, 1862"]}]]}],["$","article","Thomas E. Irby",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas E. Irby"}],["$","p",null,{"children":[["$","strong",null,{"children":["Lieutenant colonel commanding four companies of the 8th Alabama Infantry","."]}]," ","Killed in action at Williamsburg on May 5, 1862"]}]]}],["$","article","Christopher H. Mott",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Christopher H. Mott"}],["$","p",null,{"children":[["$","strong",null,{"children":["Colonel commanding the 19th Mississippi Infantry","."]}]," ","Killed in action at Williamsburg on May 5, 1862"]}]]}]]}]]}]
1a:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep133-hookers-division-williamsburg.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-hookers-division-williamsburg.jpg","alt":"Alfred Waud drawing of Hooker's division fighting in rain and mud at Williamsburg","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alfred R. Waud's field drawing records Hooker's division near Fort Magruder. Waud annotated the rain, mud, felled timber, rifle pits, and guns sunk in the road. The Library of Congress catalogs the sheet as May 4 although it depicts the May 5 battle."}]]}],["$","figure","/images/ep133-hancock-charge-print.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-hancock-charge-print.jpg","alt":"Color lithograph depicting Hancock's counterattack at the Battle of Williamsburg","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A later popular print depicts Hancock's counterattack on May 5. It is useful evidence of how the episode was commemorated, not a literal record of formations or terrain."}]]}],["$","figure","/images/ep133-battle-of-williamsburg-print.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-battle-of-williamsburg-print.jpg","alt":"Nineteenth-century print depicting infantry and artillery at the Battle of Williamsburg","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This nineteenth-century battle print represents the large, confused engagement around the Williamsburg earthworks. Its composition is illustrative rather than a precise tactical source."}]]}],["$","figure","/images/ep133-winfield-scott-hancock.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-winfield-scott-hancock.jpg","alt":"Major General Winfield Scott Hancock seated in uniform during the Civil War","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hancock was a brigadier general at Williamsburg. His localized victory over Early's brigade and McClellan's praise made 'Hancock the Superb' a lasting nickname."}]]}]]}]]}]
