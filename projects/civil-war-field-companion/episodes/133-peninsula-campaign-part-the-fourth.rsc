1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",133," · ","May 4-7, 1862"," · ","The Virginia Peninsula from Yorktown through Williamsburg to Eltham's Landing near West Point, Virginia"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN (Part the Fourth)"}],["$","span",null,{"className":"result-label","children":"The Battle of Williamsburg on May 5 and the fight at Eltham's Landing on May 7 were tactically inconclusive. Operationally, the Confederate rear guard achieved its purpose: it delayed and contained the United States pursuit while Joseph E. Johnston's army, artillery, and trains continued toward Richmond. Hancock repulsed Early's poorly coordinated attack at Williamsburg, but the opportunity against the Confederate flank was not exploited. Franklin established a bridgehead at Eltham's Landing but did not reach the retreat road in time to block Johnston's column"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4570306749.mp3?updated=1695220018","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Battle of Williamsburg",{"children":[["$","span",null,{"children":"Battle of Williamsburg"}],["$","strong",null,{"children":"May 5, 1862"}],["$","small",null,{"children":"Also called the Battle of Fort Magruder; the National Park Service classifies the result as indecisive."}]]}],["$","div","Rear-guard objective",{"children":[["$","span",null,{"children":"Rear-guard objective"}],["$","strong",null,{"children":"Protect Johnston's withdrawal toward Richmond"}],["$","small",null,{"children":"Longstreet held the prepared Williamsburg line while Confederate trains struggled over rain-soaked roads."}]]}],["$","div","Williamsburg defensive position",{"children":[["$","span",null,{"children":"Williamsburg defensive position"}],["$","strong",null,{"children":"Fort Magruder and a line of smaller redoubts"}],["$","small",null,{"children":"Creeks, swampy ground, felled timber, and the narrow Peninsula restricted the routes of approach. Contemporary accounts and later summaries describe 13 smaller redoubts in addition to Fort Magruder."}]]}],["$","div","Williamsburg casualties",{"children":[["$","span",null,{"children":"Williamsburg casualties"}],["$","strong",null,{"children":"About 2,300 United States and 1,600 Confederate"}],["$","small",null,{"children":"The NPS battle database gives 2,283 and 1,560. Other authoritative summaries give approximately 2,300 and 1,600, while a commonly cited Confederate total of 1,682 includes the May 4 cavalry fighting. The 5th North Carolina return was omitted from one Official Records-based tabulation."}]]}],["$","div","Hooker's division",{"children":[["$","span",null,{"children":"Hooker's division"}],["$","strong",null,{"children":"Fought unsupported for much of May 5"}],["$","small",null,{"children":"Kearny's arriving division stabilized the United States left after Confederate attacks pushed Hooker's line toward the Lee's Mill Road."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}]]}]
1e:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Hancock's flanking force",{"children":[["$","span",null,{"children":"Hancock's flanking force"}],["$","strong",null,{"children":"About 3,400 infantry and eight guns"}],["$","small",null,{"children":"Hancock crossed Cub Creek, occupied two empty redoubts on the Confederate left, and repulsed elements of Early's brigade."}]]}]
f:["$","div","Early's brigade losses",{"children":[["$","span",null,{"children":"Early's brigade losses"}],["$","strong",null,{"children":"508 reported in the episode"}],["$","small",null,{"children":"The episode says the 5th North Carolina alone lost 302 killed, wounded, or captured. Published tabulations differ because returns are incomplete and may separate that regiment from the rest of the brigade."}]]}]
10:["$","div","Senior officers killed at Williamsburg",{"children":[["$","span",null,{"children":"Senior officers killed at Williamsburg"}],["$","strong",null,{"children":"At least four regimental commanders"}],["$","small",null,{"children":"United States Lieutenant Colonel John P. Van Leer and Confederate Colonel George T. Ward, Lieutenant Colonel Thomas E. Irby, and Colonel Christopher H. Mott were killed."}]]}]
11:["$","div","Hancock becomes \"the Superb\"",{"children":[["$","span",null,{"children":"Hancock becomes \"the Superb\""}],["$","strong",null,{"children":"McClellan praised Hancock's performance"}],["$","small",null,{"children":"Newspaper use of the phrase helped establish the nickname after the battle."}]]}]
12:["$","div","Battle of Eltham's Landing",{"children":[["$","span",null,{"children":"Battle of Eltham's Landing"}],["$","strong",null,{"children":"May 7, 1862"}],["$","small",null,{"children":"Also called Barhamsville or West Point; the National Park Service classifies it as indecisive."}]]}]
13:["$","div","Eltham's Landing casualties",{"children":[["$","span",null,{"children":"Eltham's Landing casualties"}],["$","strong",null,{"children":"Approximately 186 United States and 48 Confederate"}],["$","small",null,{"children":"The NPS battle database gives a total of 234. Some secondary accounts give a slightly higher United States figure."}]]}]
14:["$","div","Operational outcome at Eltham",{"children":[["$","span",null,{"children":"Operational outcome at Eltham"}],["$","strong",null,{"children":"The bridgehead did not cut the Confederate retreat route"}],["$","small",null,{"children":"Hood's brigade pushed the United States picket line back before disengaging; Johnston's column continued toward Richmond."}]]}]
15:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"Civil War Times Illustrated, March 2001"}],["$","small",null,{"children":"George W. Contant, \"The Men Who Made Hancock Superb.\" The transcript renders the surname as \"Content.\""}]]}]
