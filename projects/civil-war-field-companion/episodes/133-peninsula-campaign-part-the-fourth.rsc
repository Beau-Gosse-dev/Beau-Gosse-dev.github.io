html",{"children":["$","a",null,{"href":"https://www.archives.gov/research/alic/reference/military/civil-war-armies-records.html","target":"_blank","rel":"noreferrer","children":["National Archives: Official Records of the Union and Confederate Armies"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://ehistory.osu.edu/books/official-records/012/0511",{"children":["$","a",null,{"href":"https://ehistory.osu.edu/books/official-records/012/0511","target":"_blank","rel":"noreferrer","children":["Official Records: Erasmus D. Keyes's report on Williamsburg"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/08010508/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/08010508/","target":"_blank","rel":"noreferrer","children":["Library of Congress: McClellan's official report on the Army of the Potomac"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],"$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c"]}]]}]
1d:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
1f:["$","div","Hancock moves across Cub Creek",{"className":"moment","children":[["$","$L1e",null,{"seconds":624,"label":"10:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock moves across Cub Creek"}],["$","p",null,{"children":"Smith sent Hancock with five regiments and two batteries. The column crossed the dam and moved beyond the empty redoubt toward Longstreet's left flank."}]]}]]}]
20:["$","div","Confederates break through Hooker’s line",{"className":"moment","children":[["$","$L1e",null,{"seconds":689,"label":"11:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates break through Hooker’s line"}],["$","p",null,{"children":"Longstreet's attack reached the Lee's Mill Road and overran ten guns. Canister fire from another United States battery checked the advance at close range."}]]}]]}]
21:["$","div","Kearny stabilizes the United States left",{"className":"moment","children":[["$","$L1e",null,{"seconds":764,"label":"12:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kearny stabilizes the United States left"}],["$","p",null,{"children":"Philip Kearny brought his division forward through the mud, halted the retreat, and drove the Confederates off the road into the woods west of it."}]]}]]}]
22:["$","div","Hancock occupies the Confederate flank",{"className":"moment","children":[["$","$L1e",null,{"seconds":801,"label":"13:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock occupies the Confederate flank"}],["$","p",null,{"children":"Hancock placed about 3,400 infantry and eight guns on high ground near two abandoned redoubts and requested reinforcements to exploit the position."}]]}]]}]
23:["$","div","Sumner orders Hancock back",{"className":"moment","children":[["$","$L1e",null,{"seconds":854,"label":"14:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sumner orders Hancock back"}],["$","p",null,{"children":"Smith sent a supporting brigade, but Sumner recalled it and repeatedly directed Hancock to withdraw toward Cub Creek."}]]}]]}]
24:["$","div","Early's brigade moves against Hancock",{"className":"moment","children":[["$","$L1e",null,{"seconds":910,"label":"15:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early's brigade moves against Hancock"}],["$","p",null,{"children":"D. H. Hill sent Early's brigade from the College of William and Mary grounds toward the unexpected United States artillery fire on the Confederate left."}]]}]]}]
25:["$","div","The Confederate attack loses alignment",{"className":"moment","children":[["$","$L1e",null,{"seconds":991,"label":"16:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate attack loses alignment"}],["$","p",null,{"children":"Early's four regiments entered dense, wet woods in line. The formation broke apart, and the 24th Virginia and 5th North Carolina emerged separately in front of Hancock's guns."}]]}]]}]
26:["$","div","Early attacks without waiting",{"className":"moment","children":[["$","$L1e",null,{"seconds":1050,"label":"17:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early attacks without waiting"}],["$","p",null,{"children":"Early led the 24th Virginia across the open field toward the guns. The attack gave Hancock grounds to halt his ordered withdrawal."}]]}]]}]
27:["$","div","Early is wounded",{"className":"moment","children":[["$","$L1e",null,{"seconds":1083,"label":"18:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early is wounded"}],["$","p",null,{"children":"A bullet struck Early through the shoulder. He was carried from the field and remained out of action for weeks."}]]}]]}]
28:["$","div","D. H. Hill stops the attack",{"className":"moment","children":[["$","$L1e",null,{"seconds":1169,"label":"19:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"D. H. Hill stops the attack"}],["$","p",null,{"children":"Hill recognized Hancock's strength and ordered the assault broken off. Hancock then counterattacked as the Confederates began to withdraw."}]]}]]}]
29:["$","div","Early's attack produces severe losses",{"className":"moment","children":[["$","$L1e",null,{"seconds":1253,"label":"20:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early's attack produces severe losses"}],["$","p",null,{"children":"The episode reports 302 casualties in the 5th North Carolina, 508 in Early's brigade as a whole, and 100 in Hancock's force. Published returns are incomplete and do not align cleanly with all three figures."}]]}]]}]
2a:["$","div","McClellan reaches Williamsburg near the end",{"className":"moment","children":[["$","$L1e",null,{"seconds":1268,"label":"21:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan reaches Williamsburg near the end"}],["$","p",null,{"children":"McClellan arrived as the fighting around Hancock ended. Darkness brought the broader battle to a close soon afterward."}]]}]]}]
2b:["$","div","The Confederate rear guard leaves Williamsburg",{"className":"moment","children":[["$","$L1e",null,{"seconds":1472,"label":"24:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate rear guard leaves Williamsburg"}],["$","p",null,{"children":"At first light on May 6, United States skirmishers found the line empty. Longstreet and D. H. Hill had rejoined the retreat toward Richmond."}]]}]]}]
2c:["$","div","The episode assesses the cost and result",{"className":"moment","children":[["$","$L1e",null,{"seconds":1511,"label":"25:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode assesses the cost and result"}],["$","p",null,{"children":"It gives roughly 2,200 United States and just over 1,600 Confederate casualties and emphasizes that the Confederate army continued its withdrawal without being blocked."}]]}]]}]
2d:["$","div","Hancock receives his enduring nickname",{"className":"moment","children":[["$","$L1e",null,{"seconds":1622,"label":"27:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock receives his enduring nickname"}],["$","p",null,{"children":"McClellan highlighted Hancock's repulse of Early, and the description of Hancock as superb spread through Northern newspapers."}]]}]]}]
2e:["$","div","Franklin begins the water movement",{"className":"moment","children":[["$","$L1e",null,{"seconds":1723,"label":"28:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Franklin begins the water movement"}],["$","p",null,{"children":"McClellan sent William B. Franklin's division up the York River in an attempt to establish a position beyond Williamsburg and cut the Confederate route."}]]}]]}]
2f:["$","div","Franklin lands at Eltham's Landing",{"className":"moment","children":[["$","$L1e",null,{"seconds":1762,"label":"29:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Franklin lands at Eltham's Landing"}],["$","p",null,{"children":"The division came ashore near West Point on May 7, after the opportunity to block the main Confederate column had largely passed."}]]}]]}]
30:["$","div","Johnston contains the bridgehead",{"className":"moment","children":[["$","$L1e",null,{"seconds":1820,"label":"30:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston contains the bridgehead"}],["$","p",null,{"children":"Johnston detached troops that included John Bell Hood's Texas brigade to hold Franklin near the landing while the Confederate army and trains continued west."}]]}]]}]
31:["$","div","A loaded musket saves Hood",{"className":"moment","children":[["$","$L1e",null,{"seconds":1890,"label":"31:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"A loaded musket saves Hood"}],["$","p",null,{"children":"Hood had ordered unloaded muskets during the advance through woods. Private John Deal of the 4th Texas had kept his musket loaded and shot a United States corporal who aimed at Hood at close range."}]]}]]}]
32:["$","div","Hood pushes back the picket line",{"className":"moment","children":[["$","$L1e",null,{"seconds":1918,"label":"31:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood pushes back the picket line"}],["$","p",null,{"children":"The Confederates drove the United States line more than a mile toward open ground near the landing, then broke off rather than attack the stronger position."}]]}]]}]
33:["$","div","Eltham's Landing losses are reported",{"className":"moment","children":[["$","$L1e",null,{"seconds":1937,"label":"32:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Eltham's Landing losses are reported"}],["$","p",null,{"children":"The episode gives 48 Confederate and about 185 United States casualties. The NPS database gives 48 and 186."}]]}]]}]
34:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
35:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","George B. McClellan",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George B. McClellan"}],["$","p",null,{"children":"Commanded the Army of the Potomac, remained at Yorktown for most of the Williamsburg battle, and ordered Franklin toward West Point"}]]}]]}],["$","article","Edwin V. Sumner",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"EV"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Edwin V. Sumner"}],["$","p",null,{"children":"Directed the pursuit at Williamsburg and repeatedly limited or recalled support for Hooker and Hancock"}]]}]]}],["$","article","Joseph Hooker",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Joseph Hooker"}],["$","p",null,{"children":"Opened the main fight at Williamsburg and held against Longstreet's attacks until reinforcements arrived"}]]}]]}],["$","article","Philip Kearny",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"PK"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Philip Kearny"}],["$","p",null,{"children":"Brought his division forward through the mud and stabilized Hooker's collapsing left"}]]}]]}],["$","article","William F. Smith",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WF"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"William F. Smith"}],["$","p",null,{"children":"Commanded the IV Corps division on the United States right and sent Hancock across Cub Creek"}]]}]]}],["$","article","Winfield S. Hancock",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-winfield-scott-hancock.jpg","alt":"Portrait of Winfield S. Hancock","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Winfield S. Hancock"}],["$","p",null,{"children":"Occupied empty redoubts on the Confederate flank and repulsed Early's attack, earning the nickname 'Hancock the Superb'"}]]}]]}],["$","article","William B. Franklin",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"William B. Franklin"}],["$","p",null,{"children":"Led the amphibious movement to Eltham's Landing and established a bridgehead that did not block Johnston's retreat"}]]}]]}],["$","article","Joseph E. Johnston",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Joseph E. Johnston"}],["$","p",null,{"children":"Directed the Confederate withdrawal and used rear guards to protect his army and trains"}]]}]]}],["$","article","James Longstreet",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"James Longstreet"}],["$","p",null,{"children":"Commanded the Williamsburg rear guard and counterattacked Hooker while the main Confederate army withdrew"}]]}]]}],["$","article","D. H. Hill",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":"$L3d"}],"$L3e"]}],"$L3f","$L40","$L41"]}]
