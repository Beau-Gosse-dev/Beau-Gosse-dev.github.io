17:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Williamsburg and Eltham's Landing in the Peninsula Campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep133-williamsburg-elthams-operations.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Williamsburg and Eltham's Landing in the Peninsula Campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-williamsburg-elthams-operations.svg","alt":"Schematic operational map of the Confederate retreat through Williamsburg and the United States water movement to Eltham's Landing","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Williamsburg and Eltham's Landing in the Peninsula Campaign"}],["$","span",null,{"children":"This operational map shows Johnston's retreat from Yorktown through Williamsburg toward Richmond and Franklin's water movement to Eltham's Landing near West Point. The May 5 rear-guard action delayed the land pursuit; the May 7 landing came too late to block the retreat road."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep133-williamsburg-elthams-operations.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Battle of Williamsburg: divided attacks and an unexploited flank",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep133-williamsburg-tactical.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Battle of Williamsburg: divided attacks and an unexploited flank at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-williamsburg-tactical.svg","alt":"Schematic tactical map of Hooker's attack, Kearny's reinforcement, Hancock's flank movement, and Early's counterattack at Williamsburg","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Battle of Williamsburg: divided attacks and an unexploited flank"}],["$","span",null,{"children":"Hooker fought west of the road junction at Fort Magruder. Kearny arrived to stop Longstreet's counterattack. On the opposite flank, Hancock crossed Cub Creek and occupied empty redoubts, but Sumner withheld broader support. Early then attacked Hancock without adequate reconnaissance and was repulsed."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep133-williamsburg-tactical.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/gvhs01.vhs00006/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
18:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The Confederate army leaves Yorktown",{"className":"moment","children":[["$","$L1e",null,{"seconds":59,"label":"0:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate army leaves Yorktown"}],["$","p",null,{"children":"The episode resumes with Johnston withdrawing on the night of May 3-4 before McClellan could open his planned bombardment."}]]}]]}],["$","div","Stoneman reaches the Confederate rear guard",{"className":"moment","children":[["$","$L1e",null,{"seconds":169,"label":"2:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stoneman reaches the Confederate rear guard"}],["$","p",null,{"children":"On May 4, Stoneman's cavalry skirmished with J. E. B. Stuart's cavalry. Confederate infantry support caused Stoneman to wait for his own infantry."}]]}]]}],["$","div","Rain further slows both armies",{"className":"moment","children":[["$","$L1e",null,{"seconds":204,"label":"3:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rain further slows both armies"}],["$","p",null,{"children":"About thirty hours of rain turned the limited roads through Williamsburg into deep mud and delayed troops, artillery, wagons, and supplies."}]]}]]}],["$","div","Longstreet receives the rear-guard mission",{"className":"moment","children":[["$","$L1e",null,{"seconds":247,"label":"4:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet receives the rear-guard mission"}],["$","p",null,{"children":"Johnston needed time to clear his trains from Williamsburg and assigned Longstreet's division to block the pursuit."}]]}]]}],["$","div","Terrain narrows the battlefield",{"className":"moment","children":[["$","$L1e",null,{"seconds":257,"label":"4:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Terrain narrows the battlefield"}],["$","p",null,{"children":"Queen's Creek, College Creek, swampy ground, and a prepared line of redoubts restricted the United States approach to the Williamsburg position."}]]}]]}],["$","div","Hooker and Smith approach on separate roads",{"className":"moment","children":[["$","$L1e",null,{"seconds":325,"label":"5:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker and Smith approach on separate roads"}],["$","p",null,{"children":"The pursuing columns used the Yorktown and Lee's Mill routes and shifted between them. Hooker ultimately fought on the Hampton or Lee's Mill approach while Smith occupied the Yorktown Road; woods and marshes prevented effective mutual support."}]]}]]}],["$","div","Sumner directs the pursuit",{"className":"moment","children":[["$","$L1e",null,{"seconds":368,"label":"6:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sumner directs the pursuit"}],["$","p",null,{"children":"Edwin V. Sumner exercised field command by seniority although his II Corps remained at Yorktown. McClellan stayed behind to organize the water movement toward West Point."}]]}]]}],["$","div","Hooker opens the battle",{"className":"moment","children":[["$","$L1e",null,{"seconds":480,"label":"8:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker opens the battle"}],["$","p",null,{"children":"Hooker's artillery and infantry engaged west of the road in rain and mud. He waited for support from Keyes's IV Corps that did not arrive."}]]}]]}],["$","div","Longstreet seizes the initiative",{"className":"moment","children":[["$","$L1e",null,{"seconds":502,"label":"8:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet seizes the initiative"}],["$","p",null,{"children":"Longstreet reinforced the Fort Magruder line and placed Richard H. Anderson in immediate charge of attacks against Hooker."}]]}]]}],["$","div","An enslaved man identifies the open flank",{"className":"moment","children":[["$","$L1e",null,{"seconds":562,"label":"9:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"An enslaved man identifies the open flank"}],["$","p",null,{"children":"A man who had escaped slavery informed United States headquarters that a road crossed Cub Creek at a dam and reached an unoccupied Confederate redoubt. An engineer confirmed the report."}]]}]]}],"$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33"]}]]}]
19:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Commander, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Army of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Directed the pursuit and the West Point water movement; remained at Yorktown until late in the Battle of Williamsburg"}]]}],["$","div","Senior corps commander and field commander of the pursuit",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior corps commander and field commander of the pursuit"}],["$","span",null,{"children":"Edwin V. Sumner"}],["$","small",null,{"children":"Exercised authority at Williamsburg although his II Corps troops were absent; controlled support sent toward Hooker and Hancock"}]]}],["$","div","Commander, III Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, III Corps"}],["$","span",null,{"children":"Samuel P. Heintzelman"}],["$","small",null,{"children":"Joseph Hooker's division opened the main action; Philip Kearny's division arrived to stabilize the left"}]]}],["$","div","Commander, IV Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, IV Corps"}],["$","span",null,{"children":"Erasmus D. Keyes"}],["$","small",null,{"children":"William F. Smith's division approached on the right; Winfield S. Hancock led the brigade sent across Cub Creek"}]]}],["$","div","Division commander at Eltham's Landing",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander at Eltham's Landing"}],["$","span",null,{"children":"William B. Franklin"}],["$","small",null,{"children":"Moved by transport up the York River, established the bridgehead, and held his position during the May 7 fighting"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Overall commander of the Confederate field army",{"className":"command-entry","children":[["$","strong",null,{"children":"Overall commander of the Confederate field army"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"Directed the withdrawal toward Richmond and assigned forces to delay the land pursuit and contain the Eltham bridgehead"}]]}],["$","div","Rear-guard commander at Williamsburg",{"className":"command-entry","children":[["$","strong",null,{"children":"Rear-guard commander at Williamsburg"}],["$","span",null,{"children":"James Longstreet"}],["$","small",null,{"children":"Used his division at the fortified line and placed Richard H. Anderson in immediate charge of attacks against Hooker"}]]}],["$","div","Senior commander and reserve at Williamsburg",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior commander and reserve at Williamsburg"}],["$","span",null,{"children":"D. H. Hill"}],["$","small",null,{"children":"Returned part of his division to support Longstreet and led elements of Early's brigade against Hancock"}]]}],["$","div","Brigade commander under D. H. Hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade commander under D. H. Hill"}],["$","span",null,{"children":"Jubal A. Early"}],["$","small",null,{"children":"Led the 24th Virginia in the unsuccessful attack on Hancock and was wounded through the shoulder"}]]}],["$","div","Commanders responsible for containing Eltham's Landing",{"className":"command-entry","children":[["$","strong",null,{"children":"Commanders responsible for containing Eltham's Landing"}],["$","span",null,{"children":"Gustavus W. Smith and W. H. C. Whiting"}],["$","small",null,{"children":"John Bell Hood's brigade and supporting Confederate troops confronted Franklin's bridgehead while the retreat continued"}]]}]]]}]]}],"$L34","$L35"]}]
1a:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","John P. Van Leer",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John P. Van Leer"}],["$","p",null,{"children":[["$","strong",null,{"children":["Lieutenant colonel commanding the 6th New Jersey Infantry","."]}]," ","Killed in action at Williamsburg on May 5, 1862"]}]]}],["$","article","George T. Ward",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"George T. Ward"}],["$","p",null,{"children":[["$","strong",null,{"children":["Colonel commanding the 2nd Florida Infantry","."]}]," ","Killed in action at Williamsburg on May 5, 1862"]}]]}],["$","article","Thomas E. Irby",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas E. Irby"}],["$","p",null,{"children":[["$","strong",null,{"children":["Lieutenant colonel commanding four companies of the 8th Alabama Infantry","."]}]," ","Killed in action at Williamsburg on May 5, 1862"]}]]}],["$","article","Christopher H. Mott",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Christopher H. Mott"}],["$","p",null,{"children":[["$","strong",null,{"children":["Colonel commanding the 19th Mississippi Infantry","."]}]," ","Killed in action at Williamsburg on May 5, 1862"]}]]}]]}]]}]
1b:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep133-hookers-division-williamsburg.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-hookers-division-williamsburg.jpg","alt":"Alfred Waud drawing of Hooker's division fighting in rain and mud at Williamsburg","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alfred R. Waud's field drawing records Hooker's division near Fort Magruder. Waud annotated the rain, mud, felled timber, rifle pits, and guns sunk in the road. The Library of Congress catalogs the sheet as May 4 although it depicts the May 5 battle."}]]}],["$","figure","/images/ep133-hancock-charge-print.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-hancock-charge-print.jpg","alt":"Color lithograph depicting Hancock's counterattack at the Battle of Williamsburg","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"A later popular print depicts Hancock's counterattack on May 5. It is useful evidence of how the episode was commemorated, not a literal record of formations or terrain."}]]}],["$","figure","/images/ep133-battle-of-williamsburg-print.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-battle-of-williamsburg-print.jpg","alt":"Nineteenth-century print depicting infantry and artillery at the Battle of Williamsburg","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This nineteenth-century battle print represents the large, confused engagement around the Williamsburg earthworks. Its composition is illustrative rather than a precise tactical source."}]]}],["$","figure","/images/ep133-winfield-scott-hancock.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep133-winfield-scott-hancock.jpg","alt":"Major General Winfield Scott Hancock seated in uniform during the Civil War","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hancock was a brigadier general at Williamsburg. His localized victory over Early's brigade and McClellan's praise made 'Hancock the Superb' a lasting nickname."}]]}]]}]]}]
