{"children":"Just over 12,000 men and 50 artillery pieces"}],"$undefined"]}],["$","div","Price at Springfield",{"children":[["$","span",null,{"children":"Price at Springfield"}],["$","strong",null,{"children":"About 7,000 men"}],"$undefined"]}],["$","div","Route of advance",{"children":[["$","span",null,{"children":"Route of advance"}],["$","strong",null,{"children":"The Telegraph Road from Rolla through Springfield into northwest Arkansas"}],"$undefined"]}],["$","div","Distance Price retreated",{"children":[["$","span",null,{"children":"Distance Price retreated"}],["$","strong",null,{"children":"About 100 miles from Springfield into the Boston Mountains"}],"$undefined"]}],["$","div","Curtis’s supply line",{"children":[["$","span",null,{"children":"Curtis’s supply line"}],["$","strong",null,{"children":"Nearly 200 miles back to the railhead at Rolla"}],"$undefined"]}],["$","div","Confederate advantage after concentrating",{"children":[["$","span",null,{"children":"Confederate advantage after concentrating"}],["$","strong",null,{"children":"About 7,000 more men than Curtis, according to the episode"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The campaign region today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-95.1%2C35.1%2C-90.4%2C38.5&layer=mapnik&marker=36.454%2C-94.034","title":"The campaign region today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The campaign region today"}],["$","span",null,{"children":"Rolla and Lebanon are in central Missouri. The Telegraph Road continued southwest through Springfield, crossed the Arkansas line, and ran through Cross Hollow and Fayetteville toward the Boston Mountains."}],"$Le","$Lf"]}]]}],"$L10","$L11","$L12"]}]]}],"$L13","$L14",false,"$L15","$L16","$L17"]}]]}]
