","Confederate president",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate president"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Created the Trans-Mississippi District"}]]}],["$","div","Trans-Mississippi District",{"className":"command-entry","children":[["$","strong",null,{"children":"Trans-Mississippi District"}],["$","span",null,{"children":"Earl Van Dorn"}],["$","small",null,{"children":"Overall command of Price and McCulloch"}]]}],["$","div","Missouri State Guard",{"className":"command-entry","children":[["$","strong",null,{"children":"Missouri State Guard"}],["$","span",null,{"children":"Sterling Price"}],["$","small",null,{"children":"Retreated from Springfield into Arkansas"}]]}],["$","div","Confederate forces in northwest Arkansas",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate forces in northwest Arkansas"}],["$","span",null,{"children":"Benjamin McCulloch"}],["$","small",null,{"children":"Wintered near Cross Hollow and Strickler Station"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Samuel R. Curtis",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/samuel-r-curtis.jpg","alt":"Portrait of Samuel R. Curtis","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Samuel R. Curtis"}],["$","p",null,{"children":"Organized and led the Army of the Southwest from Rolla into northwest Arkansas"}]]}]]}],["$","article","Earl Van Dorn",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/earl-van-dorn.jpg","alt":"Portrait of Earl Van Dorn","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Earl Van Dorn"}],["$","p",null,{"children":"Took command of the Trans-Mississippi District and concentrated Price’s and McCulloch’s forces"}]]}]]}],["$","article","Franz Sigel",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/franz-sigel.jpg","alt":"Portrait of Franz Sigel","width":420,"height":520,"loading":"lazy"}],"$L29"]}],"$L2a","$L2b","$L2c","$L2d","$L2e"]}]]}]
15:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/pea-ridge-battle-print.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/pea-ridge-battle-print.jpg","alt":"1889 chromolithograph of United States and Confederate troops fighting at Pea Ridge","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Kurz & Allison published this popular print of the Battle of Pea Ridge in 1889. It is a later artistic interpretation, not an eyewitness image."}]]}],["$","figure","/images/pea-ridge-campaign-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/pea-ridge-campaign-map.jpg","alt":"National Park Service campaign map showing the route from Rolla to Pea Ridge","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The campaign map shows the long route connecting Curtis’s railhead at Rolla to the Confederate camps in northwest Arkansas."}]]}]]}]]}]
