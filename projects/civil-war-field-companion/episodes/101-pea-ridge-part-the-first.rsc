12:["$","figure","Where the campaign was heading",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/pea-ridge-battlefield-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Where the campaign was heading at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/pea-ridge-battlefield-map.jpg","alt":"1876 map of the Pea Ridge battlefield showing roads, settlements, terrain, and troop positions","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Where the campaign was heading"}],["$","span",null,{"children":"A U.S. Army Corps of Engineers map of the Pea Ridge battlefield. The battle itself is covered in the following episodes; this map identifies the roads, settlements, and terrain toward which both armies were moving."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/pea-ridge-battlefield-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99447263/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode defines why Pea Ridge matters",{"className":"moment","children":[["$","$L18",null,{"seconds":208,"label":"3:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode defines why Pea Ridge matters"}],["$","p",null,{"children":"Pea Ridge was fought in northwest Arkansas on March 7–8, 1862. The Confederate army outnumbered the United States army, included a substantial contingent of American Indian troops, and forced Curtis to reverse the direction of his defensive line."}]]}]]}],["$","div","Price and McCulloch remained divided after Wilson’s Creek",{"className":"moment","children":[["$","$L18",null,{"seconds":312,"label":"5:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Price and McCulloch remained divided after Wilson’s Creek"}],["$","p",null,{"children":"After their August 1861 victory at Wilson’s Creek, Sterling Price took the Missouri State Guard north to Lexington while Ben McCulloch returned with Confederate troops to northwest Arkansas."}]]}]]}],["$","div","Price could not hold Lexington",{"className":"moment","children":[["$","$L18",null,{"seconds":347,"label":"5:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Price could not hold Lexington"}],["$","p",null,{"children":"A strong United States column advanced from St. Louis after Price captured Lexington. Price withdrew to Springfield in southwest Missouri."}]]}]]}],["$","div","A pro-Confederate Missouri government voted to secede",{"className":"moment","children":[["$","$L18",null,{"seconds":361,"label":"6:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"A pro-Confederate Missouri government voted to secede"}],["$","p",null,{"children":"Claiborne Fox Jackson assembled a rump legislature at Neosho. Its secession ordinance was disputed, but the Confederate government recognized Missouri and added a star for the state to its flag."}]]}]]}],["$","div","Jefferson Davis created a new command above Price and McCulloch",{"className":"moment","children":[["$","$L18",null,{"seconds":394,"label":"6:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jefferson Davis created a new command above Price and McCulloch"}],["$","p",null,{"children":"The Confederate government formed the Trans-Mississippi District and appointed Major General Earl Van Dorn to direct both commanders."}]]}]]}],["$","div","The episode introduces Earl Van Dorn",{"className":"moment","children":[["$","$L18",null,{"seconds":464,"label":"7:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode introduces Earl Van Dorn"}],["$","p",null,{"children":"Van Dorn graduated from West Point in 1842, served and was wounded in Mexico and on the Texas frontier, resigned from the U.S. Army after Mississippi seceded, and reached major general in the Confederate army in September 1861."}]]}]]}],["$","div","Van Dorn took command at Little Rock",{"className":"moment","children":[["$","$L18",null,{"seconds":591,"label":"9:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Van Dorn took command at Little Rock"}],["$","p",null,{"children":"Van Dorn arrived at Little Rock on January 29, 1862. He worked to make Price and McCulloch cooperate and planned an offensive into Missouri."}]]}]]}],["$","div","Van Dorn initially planned a March 20 offensive",{"className":"moment","children":[["$","$L18",null,{"seconds":627,"label":"10:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Van Dorn initially planned a March 20 offensive"}],["$","p",null,{"children":"He told Price that reinforcements would create a force of at least 15,000 men. Van Dorn hoped to defeat United States forces in Missouri and eventually capture St. Louis."}]]}]]}],["$","div","Price’s retreat changed the plan",{"className":"moment","children":[["$","$L18",null,{"seconds":650,"label":"10:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Price’s retreat changed the plan"}],"$L19"]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}]]}]
