lture/order-of-battle.htm","target":"_blank","rel":"noreferrer","children":["National Park Service: Pea Ridge order of battle"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/99447263/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/99447263/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Pea Ridge battlefield map"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/pictures/item/2018669095/",{"children":["$","a",null,{"href":"https://www.loc.gov/pictures/item/2018669095/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Samuel R. Curtis portrait"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/2013645343/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/2013645343/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Battle of Pea Ridge print"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}]]}]]}]
17:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
19:["$","p",null,{"children":"On February 22, Van Dorn learned that Price had abandoned Springfield ten days earlier and retreated to northwest Arkansas. Price’s camp was now close to McCulloch’s winter quarters."}]
1a:["$","div","Halleck wanted Price removed from Missouri",{"className":"moment","children":[["$","$L18",null,{"seconds":743,"label":"12:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck wanted Price removed from Missouri"}],["$","p",null,{"children":"Major General Henry Halleck took command of the Department of the Missouri in November 1861. Driving out Price would let Halleck transfer garrison troops to operations on the Mississippi, Tennessee, and Cumberland rivers."}]]}]]}]
1b:["$","div","Curtis received the southwest Missouri assignment",{"className":"moment","children":[["$","$L18",null,{"seconds":826,"label":"13:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Curtis received the southwest Missouri assignment"}],["$","p",null,{"children":"On December 25, Halleck placed Brigadier General Samuel R. Curtis in command of the new District of Southwest Missouri and ordered him to defeat, disperse, or destroy Price’s force."}]]}]]}]
1c:["$","div","The episode introduces Samuel Curtis",{"className":"moment","children":[["$","$L18",null,{"seconds":878,"label":"14:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode introduces Samuel Curtis"}],["$","p",null,{"children":"Curtis graduated from West Point in 1831, became a lawyer and engineer, served in the Mexican War, represented Iowa in Congress, organized Iowa troops in 1861, and became a brigadier general in August."}]]}]]}]
1d:["$","div","Curtis established his headquarters at Rolla",{"className":"moment","children":[["$","$L18",null,{"seconds":1112,"label":"18:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Curtis established his headquarters at Rolla"}],["$","p",null,{"children":"Rolla was the railhead and the starting point for an advance into southwest Missouri. Franz Sigel objected to serving under Curtis, briefly resigned, and then returned as second in command."}]]}]]}]
1e:["$","div","Halleck ordered Curtis forward",{"className":"moment","children":[["$","$L18",null,{"seconds":1291,"label":"21:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Halleck ordered Curtis forward"}],["$","p",null,{"children":"On January 13, 1862, Curtis began pressuring Price. He advanced from Rolla to Lebanon along the Telegraph Road and organized the Army of the Southwest there."}]]}]]}]
1f:["$","div","Curtis organized four divisions",{"className":"moment","children":[["$","$L18",null,{"seconds":1311,"label":"21:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Curtis organized four divisions"}],["$","p",null,{"children":"Peter Osterhaus commanded the 1st Division and Alexander Asboth the 2nd under Franz Sigel. Jefferson C. Davis commanded the 3rd Division and Eugene Carr the 4th under Curtis’s direct control."}]]}]]}]
20:["$","div","The Army of the Southwest concentrated at Lebanon",{"className":"moment","children":[["$","$L18",null,{"seconds":1345,"label":"22:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Southwest concentrated at Lebanon"}],["$","p",null,{"children":"Curtis had just over 12,000 men and 50 artillery pieces. Captain Philip Sheridan managed the long supply line back to Rolla."}]]}]]}]
21:["$","div","Curtis began the final advance on Springfield",{"className":"moment","children":[["$","$L18",null,{"seconds":1397,"label":"23:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Curtis began the final advance on Springfield"}],["$","p",null,{"children":"The army left Lebanon on February 10. Price had only about 7,000 men and could not expect to hold Springfield against a determined advance."}]]}]]}]
22:["$","div","Price abandoned Springfield",{"className":"moment","children":[["$","$L18",null,{"seconds":1443,"label":"24:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Price abandoned Springfield"}],["$","p",null,{"children":"Curtis reached within eight miles of Springfield by February 12. Price left that night and began a roughly 100-mile retreat toward the Boston Mountains in northwest Arkansas."}]]}]]}]
23:["$","div","The armies fought at Little Sugar Creek",{"className":"moment","children":[["$","$L18",null,{"seconds":1517,"label":"25:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies fought at Little Sugar Creek"}],["$","p",null,{"children":"On February 17, Confederate troops took a blocking position at James Dunnegan’s farm on the Telegraph Road. After the first Civil War engagement fought in Arkansas, the rear guard withdrew safely."}]]}]]}]
24:["$","div","Price and McCulloch agreed to withdraw farther south",{"className":"moment","children":[["$","$L18",null,{"seconds":1549,"label":"25:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Price and McCulloch agreed to withdraw farther south"}],["$","p",null,{"children":"Price initially wanted to make a stand. News that United States cavalry had raided Bentonville convinced him to accept McCulloch’s recommendation to continue the retreat."}]]}]]}]
25:["$","div","Fayetteville was looted and burned during the retreat",{"className":"moment","children":[["$","$L18",null,{"seconds":1583,"label":"26:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fayetteville was looted and burned during the retreat"}],["$","p",null,{"children":"Military stores were opened as the Confederates passed through. Soldiers looted military and civilian property, and fires set in buildings used by the army spread through much of the town."}]]}]]}]
26:["$","div","The Confederate forces concentrated near Strickler Station",{"className":"moment","children":[["$","$L18",null,{"seconds":1641,"label":"27:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate forces concentrated near Strickler Station"}],["$","p",null,{"children":"Price’s Missourians reached the winter camps south of Fayetteville in the Boston Mountains. The retreat placed them close to McCulloch’s troops."}]]}]]}]
27:["$","div","Curtis occupied Cross Hollow and reconnoitered Fayetteville",{"className":"moment","children":[["$","$L18",null,{"seconds":1655,"label":"27:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Curtis occupied Cross Hollow and reconnoitered Fayetteville"}],["$","p",null,{"children":"Curtis took the abandoned camps at Cross Hollow and sent 1,200 men down the Telegraph Road. They reached Fayetteville on February 23 and stayed for two days."}]]}]]}]
28:["$","div","Curtis chose to remain in Arkansas",{"className":"moment","children":[["$","$L18",null,{"seconds":1680,"label":"28:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Curtis chose to remain in Arkansas"}],["$","p",null,{"children":"Curtis had expelled Price from Missouri, but his army was eight miles inside Arkansas at the end of a supply line nearly 200 miles long. He kept the position despite facing a larger combined Confederate force."}]]}]]}]
29:["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Franz Sigel"}],["$","p",null,{"children":"Curtis’s second in command and commander of the Army of the Southwest’s 1st and 2nd Divisions"}]]}]
2a:["$","article","Henry W. Halleck",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"HW"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Henry W. Halleck"}],["$","p",null,{"children":"Department commander who ordered Curtis to drive Price out of Missouri"}]]}]]}]
2b:["$","article","Sterling Price",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"SP"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Sterling Price"}],["$","p",null,{"children":"Led the Missouri State Guard from Springfield into northwest Arkansas"}]]}]]}]
2c:["$","article","Benjamin McCulloch",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"BM"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Benjamin McCulloch"}],["$","p",null,{"children":"Commanded Confederate troops wintering in northwest Arkansas and argued for withdrawing south"}]]}]]}]
2d:["$","article","Claiborne Fox Jackson",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"CF"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Claiborne Fox Jackson"}],["$","p",null,{"children":"Pro-Confederate Missouri governor who assembled the rump legislature at Neosho"}]]}]]}]
2e:["$","article","Philip H. Sheridan",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"PH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Philip H. Sheridan"}],["$","p",null,{"children":"Served as the quartermaster responsible for Curtis’s long supply line"}]]}]]}]
