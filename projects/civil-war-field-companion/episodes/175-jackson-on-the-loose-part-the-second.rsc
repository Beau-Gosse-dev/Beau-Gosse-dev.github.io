13:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/12/18/civil-war-podcast-episode-175/",{"href":"https://civilwarpodcast.org/2016/12/18/civil-war-podcast-episode-175/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 175 page"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va024",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va024","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service battle summary: Manassas Station Operations"]}],["$","a","https://www.nps.gov/articles/august-28-1862.htm",{"href":"https://www.nps.gov/articles/august-28-1862.htm","target":"_blank","rel":"noreferrer","children":[" · ","Manassas National Battlefield Park campaign account: August 28, 1862"]}],["$","a","https://www.nps.gov/articles/the-confederates-take-august.htm",{"href":"https://www.nps.gov/articles/the-confederates-take-august.htm","target":"_blank","rel":"noreferrer","children":[" · ","Manassas National Battlefield Park: The Confederates Take August"]}],["$","a","https://www.nps.gov/civilwar/search-battles-person-detail.htm?personId=F02C1113-80D3-40A9-99D0-71F90E30D2CE",{"href":"https://www.nps.gov/civilwar/search-battles-person-detail.htm?personId=F02C1113-80D3-40A9-99D0-71F90E30D2CE","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service biography: George W. Taylor"]}],["$","a","https://history.army.mil/Publications/Publications-Catalog/The-Battle-of-Second-Manassas-Self-Guided-Tour/",{"href":"https://history.army.mil/Publications/Publications-Catalog/The-Battle-of-Second-Manassas-Self-Guided-Tour/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Battle of Second Manassas, self-guided tour"]}],["$","a","https://ehistory.osu.edu/books/official-records/016",{"href":"https://ehistory.osu.edu/books/official-records/016","target":"_blank","rel":"noreferrer","children":[" · ","Official Records, Series I, Volume XII, Part II"]}],["$","a","https://www.loc.gov/item/2005625017/",{"href":"https://www.loc.gov/item/2005625017/","target":"_blank","rel":"noreferrer","children":[" · ","Primary map: Jedediah Hotchkiss campaign map, August 26–September 2, 1862"]}],["$","a","https://www.loc.gov/item/2018666231/",{"href":"https://www.loc.gov/item/2018666231/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: O’Sullivan photograph of damaged rolling stock at Manassas Junction"]}],["$","a","https://www.loc.gov/item/2003674500/",{"href":"https://www.loc.gov/item/2003674500/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: “Stonewall” Jackson engraving from a photograph from life"]}],["$","a","https://www.loc.gov/item/2018669830/",{"href":"https://www.loc.gov/item/2018669830/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Joseph Hooker glass-negative portrait"]}],["$","a","https://civilwarpodcast.org/book-recommendations/",{"href":"https://civilwarpodcast.org/book-recommendations/","target":"_blank","rel":"noreferrer","children":[" · ","Official podcast book-recommendations list"]}]]}]
