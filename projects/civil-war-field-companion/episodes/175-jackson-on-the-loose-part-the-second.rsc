1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",175," · ","August 26–28, 1862"," · ","Bristoe Station, Manassas Junction, Bull Run Bridge, Kettle Run, and the First Manassas battlefield in Prince William County, Virginia"]}],["$","h1",null,{"children":"JACKSON ON THE LOOSE (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Confederate victory in the Manassas Station Operations. Jackson captured and destroyed the principal United States supply depot at Manassas Junction, defeated George W. Taylor near Bull Run Bridge, delayed Hooker at Kettle Run, and withdrew to Stony Ridge before Pope could concentrate against him"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4714436370.mp3?updated=1695419331","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The capture of Manassas Junction and Jackson’s move to Stony Ridge"}],["$","small",null,{"children":"The narrative resumes at Bristoe Station on the evening of August 26 and ends after Jackson’s three divisions left Manassas Junction during the night of August 27–28."}]]}],["$","div","Campaign",{"children":[["$","span",null,{"children":"Campaign"}],["$","strong",null,{"children":"Northern Virginia Campaign"}],["$","small",null,{"children":"The National Park Service groups the actions at Bristoe Station, Manassas Junction, Bull Run Bridge, Union Mills, and Kettle Run as the Manassas Station Operations."}]]}],["$","div","Lee’s objective",{"children":[["$","span",null,{"children":"Lee’s objective"}],["$","strong",null,{"children":"Force Pope off the Rappahannock line before more reinforcements arrived"}],["$","small",null,{"children":"Jackson’s movement against Pope’s railroad communications was intended to make the Army of Virginia turn back toward Washington. Lee and Longstreet followed Jackson through Thoroughfare Gap."}]]}],["$","div","Jackson’s position on August 26",{"children":[["$","span",null,{"children":"Jackson’s position on August 26"}],["$","strong",null,{"children":"In Pope’s rear at Bristoe Station"}],["$","small",null,{"children":"Jackson struck the Orange and Alexandria Railroad after marching through Thoroughfare Gap. Wrecked trains blocked the line, but other trains escaped and carried warning of the attack."}]]}],["$","div","Flank-march distance",{"children":[["$","span",null,{"children":"Flank-march distance"}],["$","strong",null,{"children":"Approximately 55 miles in two days"}],["$","small",null,{"children":"The NPS campaign account gives about 55 miles for Jackson’s August 25–26 movement. The episode describes his troops as exhausted after more than 50 miles."}]]}],["$","div","Night assault force",{"children":[["$","span",null,{"children":"Night assault force"}],["$","strong",null,{"children":"About 500 men from the 21st Georgia and 21st North Carolina"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}],"$L22","$undefined","$L23",false,"$L24","$L25","$L26","$L27","$L28"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","small",null,{"children":"Brig. Gen. Isaac R. Trimble volunteered his two regiments. Jackson sent Maj. Gen. J. E. B. Stuart and cavalry to reinforce them and take command of the expedition."}]
f:["$","div","Manassas garrison",{"children":[["$","span",null,{"children":"Manassas garrison"}],["$","strong",null,{"children":"A small mixed force under Capt. Samuel M. Craig"}],["$","small",null,{"children":"The episode identifies 115 men of the 105th Pennsylvania, eight guns of the 11th New York Battery, and inexperienced troopers of the 12th Pennsylvania Cavalry. Craig treated the first reports as a guerrilla or cavalry raid."}]]}]
10:["$","div","Capture of the junction",{"children":[["$","span",null,{"children":"Capture of the junction"}],["$","strong",null,{"children":"The garrison was routed in less than five minutes"}],["$","small",null,{"children":"The attack came after midnight on August 26–27. The episode gives more than 300 United States prisoners and six captured guns, with two Confederates killed and two wounded."}]]}]
11:["$","div","Captured stores",{"children":[["$","span",null,{"children":"Captured stores"}],["$","strong",null,{"children":"More than 100 loaded boxcars and extensive depot supplies in the episode’s account"}],["$","small",null,{"children":"The stores included food, clothing, equipment, ammunition, horses, ambulances, and sutler goods. Jackson’s hungry troops consumed or carried off what they could."}]]}]
12:["$","div","Morning deployment",{"children":[["$","span",null,{"children":"Morning deployment"}],["$","strong",null,{"children":"Hill and Taliaferro at Manassas; Ewell remained at Bristoe"}],["$","small",null,{"children":"Jackson moved A. P. Hill’s and William B. Taliaferro’s divisions to the junction at first light on August 27. Richard S. Ewell’s three remaining brigades screened Jackson’s rear along the railroad."}]]}]
13:["$","div","Waagner’s probe",{"children":[["$","span",null,{"children":"Waagner’s probe"}],["$","strong",null,{"children":"The 2nd New York Heavy Artillery approached from Centreville"}],["$","small",null,{"children":"Col. Gustavus Waagner crossed Bull Run at Mitchell’s Ford with soldiers serving as infantry and joined surviving artillerymen from the depot garrison. He withdrew when Hill deployed a much larger force."}]]}]
14:["$","div","Hill’s display of force",{"children":[["$","span",null,{"children":"Hill’s display of force"}],["$","strong",null,{"children":"About 9,000 men and 28 guns in the episode’s account"}],["$","small",null,{"children":"Jackson ordered Hill’s division east of Manassas Junction after hearing the artillery exchange. Waagner did not continue his advance against that line."}]]}]
15:["$","div","Taylor’s mission and advance",{"children":[["$","span",null,{"children":"Taylor’s mission and advance"}],["$","strong",null,{"children":"Guard Bull Run Bridge and a railroad repair train"}],["$","small",null,{"children":"Taylor instead advanced the 1st, 2nd, and 3rd New Jersey toward Manassas Junction, believing that he faced a raiding party. He left the 4th New Jersey at the bridge to await the 11th and 12th Ohio."}]]}]
16:["$","div","Bull Run Bridge action",{"children":[["$","span",null,{"children":"Bull Run Bridge action"}],["$","strong",null,{"children":"Hill held fire until Taylor was within about 300 yards"}],["$","small",null,{"children":"Artillery and infantry fire stopped the New Jersey advance. Jackson approached under a white flag to request surrender, but Taylor continued the action and then ordered a withdrawal."}]]}]
17:["$","div","Taylor brigade casualties",{"children":[["$","span",null,{"children":"Taylor brigade casualties"}],["$","strong",null,{"children":"About 200 captured and at least 150 killed or wounded in the episode’s account"}],["$","small",null,{"children":"The retreat became a rout at the railroad bridge. The 11th and 12th Ohio covered survivors. Taylor was mortally wounded; NPS describes the total loss as several hundred casualties."}]]}]
18:["$","div","Reinforcement decision at Alexandria",{"children":[["$","span",null,{"children":"Reinforcement decision at Alexandria"}],["$","strong",null,{"children":"McClellan held Franklin’s and Sumner’s corps near Washington"}],["$","small",null,{"children":"After Taylor’s unsupported defeat, McClellan stated that corps should not advance without their artillery and cavalry. He countermanded Franklin’s movement and kept Sumner at Alexandria."}]]}]
19:["$","div","Pope’s response",{"children":[["$","span",null,{"children":"Pope’s response"}],["$","strong",null,{"children":"Concentrate at Gainesville and destroy Jackson east of the Bull Run Mountains"}],["$","small",null,{"children":"By midnight on August 26, Pope understood that Jackson had turned his right. His August 27 orders sought to place his army between Jackson and Longstreet while Army of the Potomac troops approached from the east."}]]}]
1a:["$","div","Kettle Run",{"children":[["$","span",null,{"children":"Kettle Run"}],["$","strong",null,{"children":"Hooker attacked Ewell’s rear guard during the afternoon of August 27"}],["$","small",null,{"children":"Hooker advanced about ten miles in the heat with limited ammunition and little artillery. Ewell burned the Kettle Run bridge, resisted for several hours, and retired toward Manassas after receiving Jackson’s permission."}]]}]
1b:["$","div","Kettle Run losses",{"children":[["$","span",null,{"children":"Kettle Run losses"}],["$","strong",null,{"children":"About 600 total casualties according to NPS"}],["$","small",null,{"children":"The episode assigns more than 300 losses to Hooker, including roughly half of the 72nd New York, and fewer than 200 to Ewell. Historical totals vary by the boundaries used for the action."}]]}]
1c:["$","div","Disposition of the depot",{"children":[["$","span",null,{"children":"Disposition of the depot"}],["$","strong",null,{"children":"Useful stores were issued or removed; the remainder was burned"}],["$","small",null,{"children":"Jackson directed surgeons to take ambulances and medical supplies, mounted troops to take horses, and infantry to carry four days’ rations. Liquor was destroyed to prevent drunkenness."}]]}]
1d:["$","div","Decision to evacuate",{"children":[["$","span",null,{"children":"Decision to evacuate"}],["$","strong",null,{"children":"Union pressure made Manassas Junction untenable before Longstreet arrived"}],["$","small",null,{"children":"Waagner and Taylor approached from the east while Hooker pressed Ewell from the southwest. Jackson began his withdrawal late on August 27 and ordered the remaining depot property destroyed."}]]}]
1e:["$","div","Night movement and Stony Ridge",{"children":[["$","span",null,{"children":"Night movement and Stony Ridge"}],["$","strong",null,{"children":"Three divisions moved toward the old First Manassas battlefield"}],["$","small",null,{"children":"Taliaferro took the direct route. Hill and Ewell mistakenly moved toward Centreville before backtracking. Jackson selected wooded high ground north of Groveton, where an unfinished railroad grade provided cover."}]]}]
1f:["$","div","Operational result",{"children":[["$","span",null,{"children":"Operational result"}],["$","strong",null,{"children":"Jackson drew Pope away from the Rappahannock and avoided encirclement"}],["$","small",null,{"children":"The depot was destroyed, Pope’s railroad communications were disrupted, and Jackson remained intact on the old battlefield. The move set the conditions for the opening fight at Brawner Farm on August 28."}]]}]
20:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“A Self-Made Man: The Political Life of Abraham Lincoln, 1809–1849” by Sidney Blumenthal"}],["$","small",null,{"children":"The hosts identify the book as unrelated to Second Manassas but recommend its treatment of Lincoln’s early political career."}]]}]
21:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Taliaferro, Ewell, Heintzelman, Waagner, Haupt, sutlers, and Rhine wine"}],["$","small",null,{"children":"The transcript produces “Tolliver,” “Yule,” “Heinselman,” “Wagner,” “Hopped,” “settlers,” and “rind wine.” It also says “Leon Longstreet” once; the intended name is James Longstreet."}]]}]
22:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
23:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Jackson behind Pope’s army",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep175-operational-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Jackson behind Pope’s army at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep175-operational-context.svg","alt":"Schematic map of Jackson’s flank march to Bristoe Station and Manassas Junction, with Longstreet following and United States forces concentrating.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jackson behind Pope’s army"}],["$","span",null,{"children":"Jackson crossed the Bull Run Mountains through Thoroughfare Gap, struck the Orange and Alexandria Railroad at Bristoe Station, and reached Manassas Junction. Lee and Longstreet followed while United States formations moved toward the threatened railroad. Routes, terrain, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep175-operational-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Jedediah Hotchkiss campaign map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Manassas Station operations and the night withdrawal",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep175-manassas-operations.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Manassas Station operations and the night withdrawal at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep175-manassas-operations.svg","alt":"Schematic map of the August 27 fighting at Bull Run Bridge and Kettle Run and Jackson’s movement toward Stony Ridge.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Manassas Station operations and the night withdrawal"}],["$","span",null,{"children":"Hill faced Waagner and Taylor east of Manassas Junction while Ewell delayed Hooker at Kettle Run. During the night, Jackson’s divisions left the burning depot for the old battlefield. Positions, routes, and troop frontages are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep175-manassas-operations.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, Official Records, Jedediah Hotchkiss campaign map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Damaged rolling stock at Manassas Junction",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep175-manassas-rolling-stock.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Damaged rolling stock at Manassas Junction at full size","children":"$L29"}]}],"$L2a"]}]]}]]}]
24:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of Virginia-Maj. Gen. John Pope",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"Ordered his scattered commands to concentrate toward Gainesville and Manassas"}]]}],["$","div","General-in-Chief-Maj. Gen. Henry W. Halleck",{"className":"command-entry","children":[["$","strong",null,{"children":"General-in-Chief"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Coordinated from Washington but did not produce a unified advance by Pope and the arriving Army of the Potomac corps"}]]}],["$","div","Army of the Potomac at Alexandria-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac at Alexandria"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Held Franklin’s VI Corps and Sumner’s II Corps until their artillery and cavalry were available"}]]}],["$","div","III Corps, Army of the Potomac-Maj. Gen. Samuel P. Heintzelman",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. Samuel P. Heintzelman"}],["$","small",null,{"children":"Hooker’s division fought at Kettle Run; Kearny’s division moved separately toward Greenwich"}]]}],["$","div","2nd Division, III Corps-Maj. Gen. Joseph Hooker",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, III Corps"}],["$","span",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","small",null,{"children":"Advanced toward Bristoe Station and forced Ewell to retire after the Kettle Run action"}]]}],["$","div","1st New Jersey Brigade, VI Corps-Brig. Gen. George W. Taylor",{"className":"command-entry","children":[["$","strong",null,{"children":"1st New Jersey Brigade, VI Corps"}],["$","span",null,{"children":"Brig. Gen. George W. Taylor"}],["$","small",null,{"children":"Advanced three New Jersey regiments from Bull Run Bridge without artillery or cavalry support and was mortally wounded"}]]}],["$","div","2nd New York Heavy Artillery-Col. Gustavus Waagner",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd New York Heavy Artillery"}],["$","span",null,{"children":"Col. Gustavus Waagner"}],["$","small",null,{"children":"Probed west from Centreville and withdrew after Hill displayed a much larger force"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Sent Jackson against Pope’s railroad communications and accompanied Longstreet through Thoroughfare Gap"}]]}],"$L2b","$L2c","$L2d","$L2e","$L2f","$L30"]]}]]}],"$L31"]]]}]
25:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. George W. Taylor",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brig. Gen. George W. Taylor"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 1st New Jersey Brigade, VI Corps","."]}]," ","Mortally wounded during the retreat from Hill’s line near Bull Run Bridge on August 27. He was removed from the field toward Alexandria and died from the wound several days later."]}]]}]]}]]}]
26:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep175-operational-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep175-operational-context.svg","alt":"Schematic regional map of Jackson’s movement to Manassas Junction and the United States response.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s march through Thoroughfare Gap put him behind Pope’s Rappahannock line. Lee and Longstreet followed while United States forces turned toward the railroad."}]]}],["$","figure","/images/ep175-manassas-operations.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep175-manassas-operations.svg","alt":"Three-panel schematic of the junction, Kettle Run, and Jackson’s withdrawal.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hill defeated Taylor, Ewell delayed Hooker, and Jackson’s divisions left the depot during the night. The diagram is generalized and not to scale."}]]}],["$","figure","/images/ep175-manassas-rolling-stock.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep175-manassas-rolling-stock.jpg","alt":"United States soldiers beside damaged Orange and Alexandria Railroad rolling stock at Manassas Junction in August 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"O’Sullivan’s August 1862 photograph records damaged railroad property at the junction, not the assault in progress."}]]}],["$","figure","/images/ep175-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep175-stonewall-jackson.jpg","alt":"Nineteenth-century engraving of Thomas J. Stonewall Jackson based on a photograph from life.","width":1280,"height":820,"loading":"laz