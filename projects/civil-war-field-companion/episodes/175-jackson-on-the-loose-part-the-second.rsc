18:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. George W. Taylor",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brig. Gen. George W. Taylor"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 1st New Jersey Brigade, VI Corps","."]}]," ","Mortally wounded during the retreat from Hill’s line near Bull Run Bridge on August 27. He was removed from the field toward Alexandria and died from the wound several days later."]}]]}]]}]]}]
