d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",193," · ","September 17, 1862"," · ","The northern Antietam battlefield near Sharpsburg, Maryland, from the Joseph Poffenberger farm south through the East Woods and Miller’s Cornfield to the Mumma farm and Dunker Church plateau"]}],["$","h1",null,{"children":"ANTIETAM (Part the Eighth)"}],["$","span",null,{"className":"result-label","children":"Between about 7:30 and 9 a.m., the United States XII Corps relieved Hooker’s exhausted I Corps and drove D. H. Hill’s reinforcements from the East Woods, Cornfield, Mumma farm, and ground east of the Hagerstown Turnpike. Maj. Gen. Joseph K. F. Mansfield was mortally wounded as his inexperienced corps deployed. Brig. Gen. Alpheus S. Williams then directed the corps while Brig. Gen. George S. Greene exploited the collapse of Garland’s brigade, turned Colquitt’s flank, and reached the Dunker Church plateau. The advance put the Confederate left in grave danger, but the wider breakthrough continues in the next episode"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"September 17, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"The northern Antietam battlefield near Sharpsburg, Maryland, from the Joseph Poffenberger farm south through the East Woods and Miller’s Cornfield to the Mumma farm and Dunker Church plateau"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Between about 7:30 and 9 a.m., the United States XII Corps relieved Hooker’s exhausted I Corps and drove D. H. Hill’s reinforcements from the East Woods, Cornfield, Mumma farm, and ground east of the Hagerstown Turnpike. Maj. Gen. Joseph K. F. Mansfield was mortally wounded as his inexperienced corps deployed. Brig. Gen. Alpheus S. Williams then directed the corps while Brig. Gen. George S. Greene exploited the collapse of Garland’s brigade, turned Colquitt’s flank, and reached the Dunker Church plateau. The advance put the Confederate left in grave danger, but the wider breakthrough continues in the next episode"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],"$Lf","$L10","$L11"]}],"$undefined"]}],"$L12","$L13","$L14",false,"$L15","$L16","$L17","$L18","$L19","$L1a"]}]]}]
