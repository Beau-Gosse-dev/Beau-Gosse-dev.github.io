32:["$","section","Confederacy",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Shifted forces from the quiet Confederate right toward the crisis on the left"}]]}],["$","div","Confederate left wing-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate left wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Held the northern battlefield with badly damaged divisions after the attacks and counterattacks of I Corps"}]]}],["$","div","Hill’s division, Confederate center-Maj. Gen. D. H. Hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Hill’s division, Confederate center"}],["$","span",null,{"children":"Maj. Gen. D. H. Hill"}],["$","small",null,{"children":"Sent roughly 3,400 men in Ripley’s, Colquitt’s, and Garland’s brigades north to reconstruct the line"}]]}],["$","div","Ripley’s brigade-Brig. Gen. Roswell S. Ripley",{"className":"command-entry","children":[["$","strong",null,{"children":"Ripley’s brigade"}],["$","span",null,{"children":"Brig. Gen. Roswell S. Ripley"}],["$","small",null,{"children":"Occupied the pasture south of the Cornfield and met Federal troops following Hood’s retreat"}]]}],["$","div","Colquitt’s brigade-Brig. Gen. Alfred H. Colquitt",{"className":"command-entry","children":[["$","strong",null,{"children":"Colquitt’s brigade"}],["$","span",null,{"children":"Brig. Gen. Alfred H. Colquitt"}],["$","small",null,{"children":"Attacked through the Cornfield against Gordon before Tyndale struck the brigade’s flank"}]]}],["$","div","Garland’s brigade-Col. Duncan K. McRae",{"className":"command-entry","children":[["