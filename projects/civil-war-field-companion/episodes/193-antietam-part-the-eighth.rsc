1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",193," · ","September 17, 1862"," · ","The northern Antietam battlefield near Sharpsburg, Maryland, from the Joseph Poffenberger farm south through the East Woods and Miller’s Cornfield to the Mumma farm and Dunker Church plateau"]}],["$","h1",null,{"children":"ANTIETAM (Part the Eighth)"}],["$","span",null,{"className":"result-label","children":"Between about 7:30 and 9 a.m., the United States XII Corps relieved Hooker’s exhausted I Corps and drove D. H. Hill’s reinforcements from the East Woods, Cornfield, Mumma farm, and ground east of the Hagerstown Turnpike. Maj. Gen. Joseph K. F. Mansfield was mortally wounded as his inexperienced corps deployed. Brig. Gen. Alpheus S. Williams then directed the corps while Brig. Gen. George S. Greene exploited the collapse of Garland’s brigade, turned Colquitt’s flank, and reached the Dunker Church plateau. The advance put the Confederate left in grave danger, but the wider breakthrough continues in the next episode"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5044572852.mp3?updated=1695499488","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The XII Corps attack, about 7:30–9 a.m."}],["$","small",null,{"children":"The episode begins as Hooker’s and Jackson’s formations are spent, follows Mansfield’s corps through the East Woods and Cornfield, and ends with Greene near the Dunker Church."}]]}],["$","div","Opening balance",{"children":[["$","span",null,{"children":"Opening balance"}],["$","strong",null,{"children":"Hooker about 2,600 casualties; Jackson about 3,000"}],["$","small",null,{"children":"These are the episode’s estimates for the first ninety minutes of fighting. Both commands were badly damaged, with neither side holding a decisive advantage at about 7:30 a.m."}]]}],["$","div","McClellan’s next reinforcement",{"children":[["$","span",null,{"children":"McClellan’s next reinforcement"}],["$","strong",null,{"children":"Two divisions of Sumner’s II Corps"}],["$","small",null,{"children":"McClellan ordered Sumner forward at about 7:20 a.m. but kept one division east of Antietam Creek until Morell’s V Corps division could replace it in reserve."}]]}],["$","div","Uncommitted Federal wing",{"children":[["$","span",null,{"children":"Uncommitted Federal wing"}],["$","strong",null,{"children":"Burnside’s IX Corps still had no order to attack"}],["$","small",null,{"children":"The quiet on the Confederate right allowed Lee to send troops north toward the crisis on his left."}]]}],["$","div","XII Corps strength",{"children":[["$","span",null,{"children":"XII Corps strength"}],["$","strong",null,{"children":"About 7,200 men in the episode’s estimate"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}],"$L25","$undefined","$L26",false,"$L27","$L28","$L29","$L2a","$L2b"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","small",null,{"children":"Roughly half were entering battle for the first time, including five recently mustered regiments."}]
f:["$","div","Mansfield’s tenure",{"children":[["$","span",null,{"children":"Mansfield’s tenure"}],["$","strong",null,{"children":"Two days in command of XII Corps"}],["$","small",null,{"children":"The 58-year-old career engineer had taken command on September 15 and was leading his first important Civil War field command."}]]}]
10:["$","div","Approach to battle",{"children":[["$","span",null,{"children":"Approach to battle"}],["$","strong",null,{"children":"Columns of companies with repeated halts"}],["$","small",null,{"children":"The corps marched from its bivouac near the Poffenberger farms. Officers struggled to move and deploy the many new regiments while the men repeatedly tried to make breakfast."}]]}]
11:["$","div","Mansfield’s mortal wound",{"children":[["$","span",null,{"children":"Mansfield’s mortal wound"}],["$","strong",null,{"children":"Shot in the chest in the East Woods"}],["$","small",null,{"children":"Mansfield initially believed the 10th Maine was firing into retreating Federal troops. After recognizing the Confederates in front, he was hit and carried to the rear; he died on September 18."}]]}]
12:["$","div","128th Pennsylvania",{"children":[["$","span",null,{"children":"128th Pennsylvania"}],["$","strong",null,{"children":"118 casualties in the episode’s account"}],["$","small",null,{"children":"The new regiment lost Col. Samuel L. Croasdale and had Lt. Col. William W. Hammersly wounded while attempting to deploy. It then advanced into the Cornfield before breaking under Confederate fire."}]]}]
13:["$","div","Change of command",{"children":[["$","span",null,{"children":"Change of command"}],["$","strong",null,{"children":"Alpheus S. Williams took over XII Corps"}],["$","small",null,{"children":"Williams received Hooker’s instructions under fire and placed Crawford on the right, Gordon in the center, and Greene on the left."}]]}]
14:["$","div","D. H. Hill’s reinforcement",{"children":[["$","span",null,{"children":"D. H. Hill’s reinforcement"}],["$","strong",null,{"children":"About 3,400 men in three brigades"}],["$","small",null,{"children":"Ripley was already south of the Cornfield while Colquitt and McRae advanced north from the Confederate center."}]]}]
15:["$","div","Gordon’s stand",{"children":[["$","span",null,{"children":"Gordon’s stand"}],["$","strong",null,{"children":"2nd Massachusetts, 3rd Wisconsin, and 27th Indiana"}],["$","small",null,{"children":"These regiments held the higher Miller pasture north of the Cornfield and fought Colquitt’s brigade advancing through the corn."}]]}]
16:["$","div","Lost Order casualties",{"children":[["$","span",null,{"children":"Lost Order casualties"}],["$","strong",null,{"children":"Mitchell and Bloss wounded; Capt. Peter Kop mortally wounded"}],["$","small",null,{"children":"The three men of the 27th Indiana had handled the lost copy of Lee’s Special Orders No. 191 after its discovery near Frederick."}]]}]
17:["$","div","Replacement systems",{"children":[["$","span",null,{"children":"Replacement systems"}],["$","strong",null,{"children":"Confederate replacements joined veteran regiments"}],["$","small",null,{"children":"The episode contrasts this practice with the Federal tendency to organize new regiments. Experienced comrades could train Confederate conscripts, but McRae’s brigade showed that the system did not eliminate battlefield panic."}]]}]
18:["$","div","Garland’s brigade breaks",{"children":[["$","span",null,{"children":"Garland’s brigade breaks"}],["$","strong",null,{"children":"A perceived flank threat triggered a stampede"}],["$","small",null,{"children":"Still shaken by its rout and the death of Brig. Gen. Samuel Garland at South Mountain, McRae’s brigade broke in the East Woods when the large 28th Pennsylvania approached its flank."}]]}]
19:["$","div","Greene’s attacking force",{"children":[["$","span",null,{"children":"Greene’s attacking force"}],["$","strong",null,{"children":"About 1,700 men in two brigades"}],["$","small",null,{"children":"Greene’s official report gives 1,727 men remaining under his immediate command after his third brigade was detached to the right."}]]}]
1a:["$","div","Tyndale’s pivot",{"children":[["$","span",null,{"children":"Tyndale’s pivot"}],["$","strong",null,{"children":"East Woods to a west-facing line"}],["$","small",null,{"children":"Lt. Col. Hector Tyndale wheeled the 28th Pennsylvania and three Ohio regiments against Colquitt’s exposed flank at the north edge of the Cornfield."}]]}]
1b:["$","div","Close-range volley",{"children":[["$","span",null,{"children":"Close-range volley"}],["$","strong",null,{"children":"About 30 yards in the episode’s account"}],["$","small",null,{"children":"Tyndale’s line struck Colquitt while the Confederates were focused on Gordon’s troops in the Miller pasture."}]]}]
1c:["$","div","Colquitt’s loss",{"children":[["$","span",null,{"children":"Colquitt’s loss"}],["$","strong",null,{"children":"About half the brigade"}],["$","small",null,{"children":"Colquitt’s official report states that he lost one-half of the men in the ranks during the unequal fight."}]]}]
1d:["$","div","Stainrook’s turning movement",{"children":[["$","span",null,{"children":"Stainrook’s turning movement"}],["$","strong",null,{"children":"A wider sweep to Smoketown Road and the Mumma farm"}],["$","small",null,{"children":"Greene sent Col. Henry J. Stainrook’s brigade south and west, forcing the remaining Confederates from their foothold in the East Woods."}]]}]
1e:["$","div","Captured Confederate guns",{"children":[["$","span",null,{"children":"Captured Confederate guns"}],["$","strong",null,{"children":"A two-gun section sent forward by Stephen D. Lee"}],["$","small",null,{"children":"The episode says men of the 28th Pennsylvania captured the section after the Confederate withdrawal began."}]]}]
1f:["$","div","Dunker Church plateau",{"children":[["$","span",null,{"children":"Dunker Church plateau"}],["$","strong",null,{"children":"Stephen D. Lee abandoned the morning artillery position"}],["$","small",null,{"children":"Greene’s advance through the East Woods and Mumma farm threatened the plateau, forcing Lee’s batteries to pull back beyond the West Woods."}]]}]
20:["$","div","Federal high-water mark in scope",{"children":[["$","span",null,{"children":"Federal high-water mark in scope"}],["$","strong",null,{"children":"125th Pennsylvania entered the West Woods near the church"}],["$","small",null,{"children":"By close to 9 a.m., XII Corps held the Cornfield, East Woods, Mumma farm, and the ground east of the turnpike."}]]}]
21:["$","div","Northern-field toll",{"children":[["$","span",null,{"children":"Northern-field toll"}],["$","strong",null,{"children":"About 8,000 casualties by 9 a.m. in the episode’s estimate"}],["$","small",null,{"children":"The episode treats the losses as roughly evenly divided between United States and Confederate forces after three hours of combat."}]]}]
22:["$","div","Immediate opportunity",{"children":[["$","span",null,{"children":"Immediate opportunity"}],["$","strong",null,{"children":"The Confederate left appeared close to collapse"}],["$","small",null,{"children":"Hooker believed he might capture Lee’s army or drive it into the Potomac, but the XII Corps advance was unsupported and Sumner’s attack is reserved for the next episode."}]]}]
23:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Landscape Turned Red” by Stephen W. Sears"}],["$","small",null,{"children":"The hosts recommend Sears’s narrative history of the Maryland Campaign and Battle of Antietam."}]]}]
24:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Poffenberger, XII Corps, Morell, Mumma, Dunker Church, McRae, de Rosset, Greene, Tyndale, Stainrook, Croasdale, Hammersly, and Peter Kop"}],["$","small",null,{"children":"The automated transcript produces forms including “Poffenberg,” “Morrill,” “Dunkirk Church,” “McCrae,” “Green,” “Tyndall,” “Steynrick,” “Crossdale,” “Hammersley,” and “Peter Copp.” This guide uses the standard historical spellings."}]]}]
25:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
26:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","XII Corps enters the northern battlefield",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep193-xii-corps-arrives.svg","target":"_blank","rel":"noreferrer","aria-label":"Open XII Corps enters the northern battlefield at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep193-xii-corps-arrives.svg","alt":"Schematic map of the northern Antietam battlefield showing the Twelfth Corps moving south through the East Woods and toward Miller’s Cornfield while three brigades of D. H. Hill’s division move north.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"XII Corps enters the northern battlefield"}],["$","span",null,{"children":"Mansfield’s corps moved south from the Poffenberger farms along and west of Smoketown Road. Crawford deployed toward the Hagerstown Turnpike, Gordon reinforced the Miller pasture and Cornfield, and Greene moved through the East Woods. D. H. Hill sent Ripley, Colquitt, and McRae north to rebuild the Confederate line. Positions and movements are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep193-xii-corps-arrives.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Antietam National Battlefield, Alpheus S. Williams’s and D. H. Hill’s Official Reports, Antietam Battlefield Board atlas, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Greene turns the Confederate line, about 8–9 a.m.",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep193-greene-turning-movement.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Greene turns the Confederate line, about 8–9 a.m. at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep193-greene-turning-movement.svg","alt":"Schematic tactical map showing Tyndale pivoting from the East Woods into Colquitt’s flank, Stainrook advancing toward the Mumma farm, and Confederate troops retreating toward the West Woods and Dunker Church.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Greene turns the Confederate line, about 8–9 a.m."}],["$","span",null,{"children":"After McRae’s brigade broke in the East Woods, Tyndale pivoted west and struck Colquitt’s flank at the Cornfield while Gordon engaged from the north. Stainrook swept toward the Mumma farm. The Confederate brigades withdrew, Stephen D. Lee abandoned the Dunker Church plateau, and the 125th Pennsylvania crossed the turnpike near the church. Movements are generalized and compressed. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep193-greene-turning-movement.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],"$L2c"]}],"$undefined"]}]]}],"$L2d"]}]]}]
27:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Ordered two divisions of Sumner’s II Corps toward the northern fight while retaining one division east of the creek; had not yet ordered Burnside’s IX Corps to attack"}]]}],["$","div","I Corps and northern wing-Maj. Gen. Joseph Hooker",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps and northern wing"}],["$","span",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","small",null,{"children":"Held the battered northern line and directed Mansfield and then Williams to reinforce the West Woods, Cornfield, and East Woods"}]]}],["$","div","XII Corps-Maj. Gen. Joseph K. F. Mansfield",{"className":"command-entry","children":[["$","strong",null,{"children":"XII Corps"}],["$","span",null,{"children":"Maj. Gen. Joseph K. F. Mansfield"}],["$","small",null,{"children":"Led the corps south from the Poffenberger farms and was mortally wounded while posting troops in the East Woods"}]]}],["$","div","1st Division, then XII Corps-Brig. Gen. Alpheus S. Williams",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, then XII Corps"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Succeeded Mansfield and directed Crawford on the right, Gordon in the center, and Greene on the left"}]]}],["$","div","1st Brigade, Williams’s division-Brig. Gen. Samuel W. Crawford / Col. Joseph F. Knipe",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Williams’s division"}],["$","span",null,{"children":"Brig. Gen. Samuel W. Crawford / Col. Joseph F. Knipe"}],["$","small",null,{"children":"Deployed new and veteran regiments toward the East Woods, Miller pasture, and Hagerstown Turnpike"}]]}],["$","div","3rd Brigade, Williams’s division-Brig. Gen. George H. Gordon",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Brigade, Williams’s division"}],["$","span",null,{"children":"Brig. Gen. George H. Gordon"}],["$","small",null,{"children":"Held the corps center; three regiments engaged Colquitt from the Miller pasture north of the Cornfield"}]]}],["$","div","2nd Division, XII Corps-Brig. Gen. George S. Greene",{"className":"command-entry","children":[["$","strong",null,{"children":"2nd Division, XII Corps"}],["$","span",null,{"children":"Brig. Gen. George S. Greene"}],["$","small",null,{"children":"Exploited the Confederate collapse, turned Colquitt’s flank, cleared the East Woods, and advanced to the Dunker Church plateau"}]]}],["$","div","1st Brigade, Greene’s division-Lt. Col. Hector Tyndale",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Greene’s division"}],"$L2e","$L2f"]}],"$L30","$L31"]]}],"$L32"]}],"$L33"]]]}]
28:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Maj. Gen. Joseph K. F. Mansfield",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. Joseph K. F. Mansfield"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of XII Corps","."]}]," ","Mortally wounded by a rifle ball in the chest while directing troops in the East Woods; carried to a field hospital and died on September 18 after only two days in corps command."]}]]}],["$","article","Col. Samuel L. Croasdale",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. Samuel L. Croasdale"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the 128th Pennsylvania, Crawford’s brigade","."]}]," ","Killed as his inexperienced regiment attempted to deploy from column into line near the East Woods and Miller pasture."]}]]}],["$","article","Lt. Col. William W. Hammersly",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Lt. Col. William W. Hammersly"}],["$","p",null,{"children":[["$","strong",null,{"children":["Second-in-command of the 128th Pennsylvania","."]}]," ","Wounded moments after Croasdale was killed, deepening the command confusion before the regiment entered the Cornfield."]}]]}],["$","article","Capt. Peter Kop",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Capt. Peter Kop"}],["$","p",null,{"children":[["$","strong",null,{"children":["Company F, 27th Indiana, Gordon’s brigade","."]}]," ","Mortally wounded by a stray bullet later on September 17 after surviving the morning’s close-range fighting; he died at a field hospital on September 24. Earlier in the campaign, Barton Mitchell and John Bloss had brought Lee’s lost order to him."]}]]}]]}]]}]
29:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep193-xii-corps-arrives.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep193-xii-corps-arrives.svg","alt":"Schematic map of XII Corps approaching the Cornfield and East Woods.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Mansfield’s inexperienced corps entered a battlefield already crowded with broken I Corps formations while D. H. Hill sent three Confederate brigades north."}]]}],["$","figure","/images/ep193-greene-turning-movement.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep193-greene-turning-movement.svg","alt":"Schematic map of Greene’s turning movement from the East Woods to the Dunker Church plateau.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Tyndale and Stainrook exploited the collapse in the East Woods, struck Colquitt’s flank, and forced the Confederate line back beyond the church plateau."}]]}],["$","figure","/images/ep193-joseph-mansfield.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep193-joseph-mansfield.jpg","alt":"Brady studio portrait of Maj. Gen. Joseph K. F. Mansfield.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Mansfield took command of XII Corps two days before Antietam and was mortally wounded while leading its first advance."}]]}]]}]]}]
