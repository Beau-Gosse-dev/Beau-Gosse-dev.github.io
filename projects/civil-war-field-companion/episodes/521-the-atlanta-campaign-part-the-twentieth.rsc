19:["$","p",null,{"children":"Accounts place the flags of the 51st and 27th Illinois on the parapet. Too few men reached the line to hold a position there."}]
1a:["$","div","Harker was shot near the works",{"className":"moment","children":[["$","$L18",null,{"seconds":944,"label":"15:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Harker was shot near the works"}],["$","p",null,{"children":"Harker rode to within about 15 yards of the Confederate line. A bullet passed through his right arm and entered his body."}]]}]]}]
