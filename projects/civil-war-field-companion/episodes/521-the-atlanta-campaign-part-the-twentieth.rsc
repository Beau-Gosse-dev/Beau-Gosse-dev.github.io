12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Sherman assigned each army a role",{"className":"moment","children":[["$","$L18",null,{"seconds":87,"label":"1:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman assigned each army a role"}],["$","p",null,{"children":"Schofield was to press the Confederate left, McPherson was to attack near Pigeon Hill and demonstrate against the mountain, and Thomas was to make the main assault."}]]}]]}],["$","div","Newton prepared to attack Cleburne",{"className":"moment","children":[["$","$L18",null,{"seconds":160,"label":"2:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Newton prepared to attack Cleburne"}],["$","p",null,{"children":"John Newton’s IV Corps division faced Patrick Cleburne’s entrenched Confederate division south of Kennesaw Mountain."}]]}]]}],["$","div","Wagner’s brigade started around 9 a.m.",{"className":"moment","children":[["$","$L18",null,{"seconds":231,"label":"3:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wagner’s brigade started around 9 a.m."}],["$","p",null,{"children":"George D. Wagner’s five regiments advanced about an hour after the appointed time and immediately received artillery and musket fire."}]]}]]}],["$","div","The assault reached the Confederate obstacles",{"className":"moment","children":[["$","$L18",null,{"seconds":318,"label":"5:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The assault reached the Confederate obstacles"}],["$","p",null,{"children":"Some soldiers reached the stakes and abatis but could not clear them under close-range fire. Wagner’s men made two attempts."}]]}]]}],["$","div","Kimball moved up in support",{"className":"moment","children":[["$","$L18",null,{"seconds":360,"label":"6:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kimball moved up in support"}],["$","p",null,{"children":"Nathan Kimball’s brigade advanced on Wagner’s left shortly after 9 a.m. Rough ground and Confederate fire also stopped this brigade."}]]}]]}],["$","div","Newton ordered a withdrawal",{"className":"moment","children":[["$","$L18",null,{"seconds":531,"label":"8:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Newton ordered a withdrawal"}],["$","p",null,{"children":"By 10 a.m., Wagner and Kimball were pinned down and unable to enter the works. Confederate soldiers fired heavily as the U.S. troops fell back."}]]}]]}],["$","div","Wagner and Kimball lost about 400 men",{"className":"moment","children":[["$","$L18",null,{"seconds":614,"label":"10:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wagner and Kimball lost about 400 men"}],["$","p",null,{"children":"The two brigades failed to penetrate Cleburne’s line and withdrew after less than two hours of fighting."}]]}]]}],["$","div","Harker’s brigade attacked farther south",{"className":"moment","children":[["$","$L18",null,{"seconds":634,"label":"10:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Harker’s brigade attacked farther south"}],["$","p",null,{"children":"Charles G. Harker led eight regiments against the junction of Cleburne’s and Cheatham’s divisions."}]]}]]}],["$","div","Opdyke led the skirmish line",{"className":"moment","children":[["$","$L18",null,{"seconds":799,"label":"13:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Opdyke led the skirmish line"}],["$","p",null,{"children":"Emerson Opdyke and the 125th Ohio formed part of a strong skirmish screen ordered to clear the front and enter the Confederate works if possible."}]]}]]}],["$","div","Harker advanced around 9 a.m.",{"className":"moment","children":[["$","$L18",null,{"seconds":842,"label":"14:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Harker advanced around 9 a.m."}],["$","p",null,{"children":"The skirmishers drove in Confederate pickets but stopped at the abatis and stakes under heavy fire. The brigade crowded behind them."}]]}]]}],["$","div","U.S. flags briefly reached the works",{"className":"moment","children":[["$","$L18",null,{"seconds":901,"label":"15:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. flags briefly reached the works"}],"$L19"]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]]}]
