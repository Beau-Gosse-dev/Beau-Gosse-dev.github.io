2e:["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep146-hotchkiss-mcdowell-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Jedediah Hotchkiss’s 1862 battle sketch at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-hotchkiss-mcdowell-map.jpg","alt":"Jedediah Hotchkiss manuscript sketch of the Battle of McDowell, showing roads, waterways, relief, and troop positions.","width":1600,"height":1200,"loading":"lazy"}]}]}]
2f:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jedediah Hotchkiss’s 1862 battle sketch"}],["$","span",null,{"children":"Hotchkiss’s manuscript map records the turnpike, Bull Pasture River, McDowell, the surrounding ridges, and Confederate positions on the height. It is a primary cartographic source made by Jackson’s topographical engineer. It should be read as a contemporary field sketch rather than a modern georeferenced map."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep146-hotchkiss-mcdowell-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/2005625009/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
31:["$","div","The advance reaches Federal pickets",{"className":"moment","children":[["$","$L30",null,{"seconds":864,"label":"14:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The advance reaches Federal pickets"}],["$","p",null,{"children":"Near the eastern foot of Shenandoah Mountain, Johnson’s column encountered cavalry outposts that warned the 32nd Ohio near Rogers Tollgate."}]]}]]}]
32:["$","div","Artillery checks Johnson at Shaw’s Ridge",{"className":"moment","children":[["$","$L30",null,{"seconds":904,"label":"15:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Artillery checks Johnson at Shaw’s Ridge"}],["$","p",null,{"children":"The 75th Ohio and United States guns fired from the ridge, causing the Confederates to fall back. Milroy then withdrew the outpost force into McDowell before dark."}]]}]]}]
33:["$","div","The ground around McDowell is reconstructed",{"className":"moment","children":[["$","$L30",null,{"seconds":1054,"label":"17:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"The ground around McDowell is reconstructed"}],["$","p",null,{"children":"The episode traces the Bull Pasture River, the surrounding mountains, Sitlington Hill south of the turnpike, and Hall’s Hill and Cedar Knob north of it."}]]}]]}]
34:["$","div","Milroy prepares before daylight",{"className":"moment","children":[["$","$L30",null,{"seconds":1168,"label":"19:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Milroy prepares before daylight"}],["$","p",null,{"children":"Expecting attack, he sent patrols toward North River Gap and posted pickets and cavalry east of the river while waiting for Schenck."}]]}]]}]
35:["$","div","Schenck arrives after a forced march",{"className":"moment","children":[["$","$L30",null,{"seconds":1231,"label":"20:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schenck arrives after a forced march"}],["$","p",null,{"children":"At about 10 a.m. Schenck reached McDowell after covering roughly 34 miles in 23 hours. As the senior officer, he took overall command."}]]}]]}]
36:["$","div","Schenck and Milroy agree on a spoiling attack",{"className":"moment","children":[["$","$L30",null,{"seconds":1298,"label":"21:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schenck and Milroy agree on a spoiling attack"}],["$","p",null,{"children":"They rejected both passive defense and an all-out assault. A limited evening blow would disrupt the Confederates and cover a planned withdrawal after dark."}]]}]]}]
37:["$","div","Federal reconnaissance climbs Sitlington Hill",{"className":"moment","children":[["$","$L30",null,{"seconds":1376,"label":"22:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal reconnaissance climbs Sitlington Hill"}],["$","p",null,{"children":"Pickets from the 2nd West Virginia and a company of the 73rd Ohio probed east of the river while the 82nd Ohio and artillery covered the turnpike from Cedar Knob."}]]}]]}]
38:["$","div","Jackson and Johnson appear on the crest",{"className":"moment","children":[["$","$L30",null,{"seconds":1426,"label":"23:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson and Johnson appear on the crest"}],["$","p",null,{"children":"Around noon the two generals, their staffs, and a small 52nd Virginia escort reconnoitered from Sitlington Hill and drew increased United States artillery fire."}]]}]]}]
39:["$","div","Jackson does not expect a battle that day",{"className":"moment","children":[["$","$L30",null,{"seconds":1479,"label":"24:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson does not expect a battle that day"}],["$","p",null,{"children":"He asked Hotchkiss and VMI engineer Thomas H. Williamson to look for an artillery route around the Federal right, then rode back toward headquarters for supper."}]]}]]}]
3a:["$","div","Johnson deploys the first Confederate regiments",{"className":"moment","children":[["$","$L30",null,{"seconds":1624,"label":"27:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnson deploys the first Confederate regiments"}],["$","p",null,{"children":"The 12th Georgia held the exposed center, the 52nd and 58th Virginia formed toward the left, and the 44th Virginia occupied the right near a ravine."}]]}]]}]
3b:["$","div","Milroy launches five regiments",{"className":"moment","children":[["$","$L30",null,{"seconds":1714,"label":"28:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Milroy launches five regiments"}],["$","p",null,{"children":"Just under 2,400 men moved forward in the episode’s count. A false warning about Confederate guns on the hill helped trigger the attack."}]]}]]}]
3c:["$","div","The attacking columns divide",{"className":"moment","children":[["$","$L30",null,{"seconds":1753,"label":"29:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attacking columns divide"}],["$","p",null,{"children":"The 25th and 75th Ohio attacked the center; the 32nd and 82nd Ohio moved against the Confederate right and rear; the 3rd West Virginia advanced along the turnpike."}]]}]]}]
3d:["$","div","The hill helps and hurts the defenders",{"className":"moment","children":[["$","$L30",null,{"seconds":1849,"label":"30:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"The hill helps and hurts the defenders"}],["$","p",null,{"children":"The crest gave cover for reloading, but defenders were silhouetted when firing, faced the low western sun, frequently overshot, and had no artillery on the height."}]]}]]}]
3e:["$","div","The 12th Georgia is caught in a salient",{"className":"moment","children":[["$","$L30",null,{"seconds":1927,"label":"32:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 12th Georgia is caught in a salient"}],["$","p",null,{"children":"Its forward spur allowed the 75th Ohio to press around both sides and expose the Georgians to fire from three directions."}]]}]]}]
3f:["$","div","Fighting extends to the turnpike",{"className":"moment","children":[["$","$L30",null,{"seconds":1995,"label":"33:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fighting extends to the turnpike"}],["$","p",null,{"children":"The 3rd West Virginia encountered troops from the 31st and 52nd Virginia. Men recruited around Clarksburg recognized former neighbors in the opposing line."}]]}]]}]
40:["$","div","Jackson sends in reinforcements",{"className":"moment","children":[["$","$L30",null,{"seconds":2050,"label":"34:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson sends in reinforcements"}],["$","p",null,{"children":"The 10th Virginia formed in reserve, and the 23rd and 37th Virginia relieved the 25th Virginia as additional Valley Army regiments reached the hill."}]]}]]}]
41:["$","div","The 48th Virginia relieves the 12th Georgia",{"className":"moment","children":[["$","$L30",null,{"seconds":2102,"label":"35:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 48th Virginia relieves the 12th Georgia"}],["$","p",null,{"children":"Near sunset the depleted Georgians withdrew without ammunition. Campbell’s 48th Virginia took their place and met a renewed attack by the 32nd Ohio."}]]}]]}]
42:["$","div","The last United States assaults fail",{"className":"moment","children":[["$","$L30",null,{"seconds":2133,"label":"35:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The last United States assaults fail"}],["$","p",null,{"children":"The 3rd West Virginia joined the 82nd Ohio against the right, while the 32nd Ohio struck again elsewhere on the line. Both efforts broke down as Confederate strength increased."}]]}]]}]
43:["$","div","Edward Johnson is severely wounded",{"className":"moment","children":[["$","$L30",null,{"seconds":2159,"label":"35:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Edward Johnson is severely wounded"}],["$","p",null,{"children":"A bullet shattered his ankle at about 8 p.m. Taliaferro took command on the hill, and Jackson sent Hotchkiss forward with orders to hold until the Stonewall Brigade could arrive."}]]}]]}]
44:["$","div","The attackers recross the river",{"className":"moment","children":[["$","$L30",null,{"seconds":2245,"label":"37:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attackers recross the river"}],["$","p",null,{"children":"After firing ended around 9 p.m., Milroy withdrew the regiments from the east bank by about 10 p.m. A council of officers agreed that McDowell could not be held."}]]}]]}]
45:["$","div","The episode gives the casualty totals",{"className":"moment","children":[["$","$L30",null,{"seconds":2267,"label":"37:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode gives the casualty totals"}],["$","p",null,{"children":"It reports 259 United States casualties and 532 Confederate casualties, including 175 in the 12th Georgia. Published United States category totals vary among modern references."}]]}]]}]
46:["$","div","The result is separated into tactical and strategic effects",{"className":"moment","children":[["$","$L30",null,{"seconds":2320,"label":"38:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"The result is separated into tactical and strategic effects"}],["$","p",null,{"children":"The hosts judge the spoiling attack a United States tactical success but the operation a Confederate victory because the Federal brigades retreated and Frémont’s immediate threat was removed."}]]}]]}]
47:["$","div","The retreat begins after midnight",{"className":"moment","children":[["$","$L30",null,{"seconds":2422,"label":"40:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The retreat begins after midnight"}],["$","p",null,{"children":"The United States column left McDowell toward Franklin. Milroy’s rear guard burned provisions and threw excess ammunition into the Bull Pasture River."}]]}]]}]
48:["$","div","Jackson begins a delayed pursuit",{"className":"moment","children":[["$","$L30",null,{"seconds":2455,"label":"40:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson begins a delayed pursuit"}],["$","p",null,{"children":"The Confederates started on the afternoon of May 9, after the main Federal body had gained about 13 miles. Jackson declined an attack when Schenck halted on commanding ground."}]]}]]}]
49:["$","div","Schenck and Milroy reach Franklin",{"className":"moment","children":[["$","$L30",null,{"seconds":2485,"label":"41:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schenck and Milroy reach Franklin"}],["$","p",null,{"children":"The exhausted brigades arrived on May 11. Frémont was not there, and the poor condition of Blenker’s newly arrived division delayed his concentration."}]]}]]}]
4a:["$","div","Forest fires obstruct the pursuit",{"className":"moment","children":[["$","$L30",null,{"seconds":2517,"label":"41:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Forest fires obstruct the pursuit"}],["$","p",null,{"children":"Retreating troops set heavy roadside timber alight. Smoke and fire slowed the Confederate approach to Franklin more effectively than a conventional rear guard."}]]}]]}]
4b:["$","div","Jackson turns back",{"className":"moment","children":[["$","$L30",null,{"seconds":2550,"label":"42:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson turns back"}],["$","p",null,{"children":"On May 13 he ended the pursuit rather than attack the strong Franklin position and returned toward McDowell to begin the next operation against Banks."}]]}]]}]
4c:["$","div","The episode recommends Tanner’s campaign history",{"className":"moment","children":[["$","$L30",null,{"seconds":2575,"label":"42:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode recommends Tanner’s campaign history"}],["$","p",null,{"children":"The book recommendation is Robert G. Tanner’s “Stonewall in the Valley,” first published in 1976."}]]}]]}]
4d:["$","div","Johnson’s brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Johnson’s brigade"}],["$","span",null,{"children":"Col. William C. Scott"}],["$","small",null,{"children":"44th, 52nd, and 58th Virginia Infantry; elements held the right, left, and turnpike approaches as the fight developed"}]]}]
4e:["$","div","Acting commander, Second Brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Acting commander, Second Brigade"}],["$","span",null,{"children":"Col. John A. Campbell"}],["$","small",null,{"children":"48th Virginia Infantry entered late and relieved the 12th Georgia near sunset; other brigade elements were not all committed"}]]}]
4f:["$","div","Stonewall Brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Brig. Gen. Charles S. Winder"}],["$","small",null,{"children":"Brought up as Jackson’s reserve but did not enter the May 8 fighting before the United States attack ended"}]]}]
50:["$","div","Topographical and engineering staff",{"className":"command-entry","children":[["$","strong",null,{"children":"Topographical and engineering staff"}],["$","span",null,{"children":"Jedediah Hotchkiss / Col. Thomas H. Williamson"}],["$","small",null,{"children":"Reconnoitered for a route around the United States right; Hotchkiss later carried Jackson’s order to Taliaferro on the crest"}]]}]
51:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
52:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Thomas J. “Stonewall” Jackson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-stonewall-jackson.jpg","alt":"Portrait of Thomas J. “Stonewall” Jackson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Overall Confederate commander who concentrated against Milroy, reinforced Sitlington Hill, and pursued the retreat before turning back toward the Valley"}]]}]]}],["$","article","Edward “Allegheny” Johnson",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-edward-johnson.jpg","alt":"Portrait of Edward “Allegheny” Johnson","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Edward “Allegheny” Johnson"}],["$","p",null,{"children":"Confederate advance commander who selected and organized the Sitlington Hill position before a bullet shattered his ankle"}]]}]]}],["$","article","Robert H. Milroy",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-robert-milroy.jpg","alt":"Portrait of Robert H. Milroy","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Robert H. Milroy"}],["$","p",null,{"children":"Aggressive United States brigade commander who proposed the spoiling attack, directed five regiments forward, and covered the retreat from McDowell"}]]}]]}],["$","article","Robert C. Schenck",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-robert-schenck.jpg","alt":"Portrait of Robert C. Schenck","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Robert C. Schenck"}],["$","p",null,{"children":"Senior United States commander who reached McDowell after a forced march, approved the limited attack, and ordered the withdrawal to Franklin"}]]}]]}],["$","article","William B. Taliaferro",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"William B. Taliaferro"}],["$","p",null,{"children":"Confederate Third Brigade commander who assumed command on Sitlington Hill after Johnson was wounded; the transcript renders his surname as “Tolliver”"}]]}]]}],["$","article","Nathaniel C. McLean",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"NC"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Nathaniel C. McLean"}],["$","p",null,{"children":"Colonel of the 75th Ohio who directed the main United States assault and documented the steep, exposed approach to the Confederate crest"}]]}]]}],["$","article","Simeon B. Gibbons",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"SB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Simeon B. Gibbons"}],["$","p",null,{"children":"Colonel of the 10th Virginia Infantry and the senior Confederate regimental commander killed at McDowell"}]]}]]}],["$","article","Zephaniah T. Conner",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"ZT"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Zephaniah T. Conner"}],"$L5a"]}]]}],"$L5b","$L5c","$L5d","$L5e","$L5f","$L60","$L61","$L62","$L63"]}]
