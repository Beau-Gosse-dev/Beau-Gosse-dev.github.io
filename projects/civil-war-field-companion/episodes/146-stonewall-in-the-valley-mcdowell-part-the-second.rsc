5c:["$","article","John A. Campbell",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"John A. Campbell"}],["$","p",null,{"children":"Acting Confederate brigade commander whose 48th Virginia relieved the 12th Georgia near sunset"}]]}]]}]
5d:["$","article","Charles S. Winder",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"CS"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Charles S. Winder"}],["$","p",null,{"children":"Stonewall Brigade commander whose regiments came forward as a reserve but were not committed before the fighting ended"}]]}]]}]
5e:["$","article","Jedediah Hotchkiss",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Jedediah Hotchkiss"}],["$","p",null,{"children":"Jackson’s topographical engineer who reconnoitered the battlefield, carried orders during the action, and drew the surviving manuscript battle sketch"}]]}]]}]
5f:["$","article","Thomas H. Williamson",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"TH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas H. Williamson"}],["$","p",null,{"children":"VMI engineer who reconnoitered with Hotchkiss for an artillery route around the United States right"}]]}]]}]
60:["$","article","John C. Frémont",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JC"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John C. Frémont"}],["$","p",null,{"children":"Mountain Department commander whose scattered forces were trying to concentrate eastward through the mountains toward Staunton"}]]}]]}]
61:["$","article","Richard S. Ewell",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"RS"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Richard S. Ewell"}],["$","p",null,{"children":"Confederate division commander who watched Banks near Swift Run Gap while Jackson operated against Milroy and Schenck"}]]}]]}]
62:["$","article","Alfred E. Lee",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Alfred E. Lee"}],["$","p",null,{"children":"Lieutenant in the 82nd Ohio whose account of the steep assault and the dead left after dark opens the episode"}]]}]]}]
63:["$","article","George W. Spenagle",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GW"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"George W. Spenagle"}],["$","p",null,{"children":"Soldier in the 25th Virginia whose account describes overshooting, skyline exposure, smoke, and close-range fire from the crest"}]]}]]}]
