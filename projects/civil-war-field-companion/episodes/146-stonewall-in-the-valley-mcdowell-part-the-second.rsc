1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",146," · ","May 7–13, 1862"," · ","The Staunton–Parkersburg Turnpike from Shenandoah Mountain through McDowell to Franklin, with the main battle on Sitlington Hill above the Bull Pasture River in Highland County, Virginia"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: McDOWELL (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Confederate strategic victory after a tactically costly and disputed engagement. On May 8, Milroy and Schenck sent about 2,400–2,500 infantry across the Bull Pasture River in a spoiling attack against Confederate troops assembling on Sitlington Hill. The United States regiments withdrew after dark, then evacuated McDowell for Franklin. Jackson pursued but did not attack the strong Franklin position and turned back on May 13. The operation checked Frémont’s advance toward Staunton and freed Jackson to move against Banks, although Confederate casualties were roughly twice the United States total"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2944593755.mp3?updated=1695307500","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The approach, Battle of McDowell, and pursuit to Franklin, May 7–13, 1862"}],["$","small",null,{"children":"The narrative begins with the strategic reason for Jackson’s westward move, reconstructs the May 8 fighting, and ends when Jackson breaks off the pursuit and turns back toward the Valley."}]]}],["$","div","Operational purpose",{"children":[["$","span",null,{"children":"Operational purpose"}],["$","strong",null,{"children":"Defeat Frémont’s eastern vanguard before turning against Banks"}],["$","small",null,{"children":"Jackson intended to protect Staunton, prevent a Federal concentration in the upper Valley, and keep Banks from reinforcing McDowell at Fredericksburg."}]]}],["$","div","Confederate concentration",{"children":[["$","span",null,{"children":"Confederate concentration"}],["$","strong",null,{"children":"Jackson’s Valley Army joined Edward “Allegheny” Johnson west of Staunton"}],["$","small",null,{"children":"The episode estimates about 10,000 combined. The National Park Service gives approximately 11,600 on the May 7 march; strength totals differ by date and by whether present, effective, or engaged troops are counted."}]]}],["$","div","United States forces at McDowell",{"children":[["$","span",null,{"children":"United States forces at McDowell"}],["$","strong",null,{"children":"Milroy’s brigade reinforced by Schenck on the morning of May 8"}],["$","small",null,{"children":"The episode estimates about 5,000 after Schenck arrived. The National Park Service gives perhaps 4,500, while broader battle summaries count larger forces present in the area. Only about 2,400–2,500 infantry made the spoiling attack."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}],"$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d"]}]]}]
30:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","May 7 first contact",{"children":[["$","span",null,{"children":"May 7 first contact"}],["$","strong",null,{"children":"Milroy’s outposts withdrew across Shenandoah Mountain toward McDowell"}],["$","small",null,{"children":"Johnson’s vanguard drove back the 32nd Ohio near Rogers Tollgate. United States artillery on Shaw’s Ridge then checked the Confederate advance before Milroy withdrew into McDowell."}]]}]
f:["$","div","Night positions",{"children":[["$","span",null,{"children":"Night positions"}],["$","strong",null,{"children":"Johnson about six miles east of McDowell; Jackson near Buffalo Gap about ten miles behind the town"}],["$","small",null,{"children":"These episode distances are approximate camp locations, not surveyed unit positions."}]]}]
10:["$","div","Terrain",{"children":[["$","span",null,{"children":"Terrain"}],["$","strong",null,{"children":"McDowell sat immediately west of the north–south Bull Pasture River under surrounding high ground"}],["$","small",null,{"children":"Sitlington Hill, a spur of Bull Pasture Mountain south of the turnpike, rose roughly 500–600 feet above the river. Hall’s Hill and Cedar Knob dominated the north side of the road."}]]}]
11:["$","div","Place-name variants",{"children":[["$","span",null,{"children":"Place-name variants"}],["$","strong",null,{"children":"Sitlington Hill is also recorded as Sitlington’s, Sittlington’s, Setlington’s, and Bull Pasture Mountain"}],["$","small",null,{"children":"This guide uses “Sitlington Hill,” the spelling used by the National Park Service. The transcript generally says “Sittlingtons Hill,” while Hotchkiss’s manuscript map uses a historical variant."}]]}]
12:["$","div","Schenck’s reinforcement march",{"children":[["$","span",null,{"children":"Schenck’s reinforcement march"}],["$","strong",null,{"children":"Approximately 34 miles in 23 hours from the Franklin road"}],["$","small",null,{"children":"Schenck reached McDowell about 10 a.m. on May 8 with exhausted infantry, artillery, and cavalry. As senior officer, he assumed overall United States command on the field."}]]}]
13:["$","div","United States plan",{"children":[["$","span",null,{"children":"United States plan"}],["$","strong",null,{"children":"A limited spoiling attack followed by withdrawal from McDowell"}],["$","small",null,{"children":"Milroy wanted to attack; Schenck rejected an all-out battle. They agreed to strike the assembling Confederates, disrupt an expected attack, and leave under cover of darkness."}]]}]
14:["$","div","Immediate trigger",{"children":[["$","span",null,{"children":"Immediate trigger"}],["$","strong",null,{"children":"An erroneous report that Confederates were placing artillery on Sitlington Hill"}],["$","small",null,{"children":"Jackson had no guns on the crest. The slope was too difficult for artillery, and guns there could not have depressed sufficiently against troops directly below."}]]}]
15:["$","div","Assault force",{"children":[["$","span",null,{"children":"Assault force"}],["$","strong",null,{"children":"25th, 32nd, 75th, and 82nd Ohio Infantry and 3rd West Virginia Infantry"}],["$","small",null,{"children":"Colonel Nathaniel C. McLean of the 75th Ohio directed the main movement. The attack began about 4:30 p.m.; the hardest fighting developed after 5 p.m."}]]}]
16:["$","div","Confederate initial line",{"children":[["$","span",null,{"children":"Confederate initial line"}],["$","strong",null,{"children":"Johnson deployed the 12th Georgia and the 44th, 52nd, and 58th Virginia on Sitlington Hill"}],["$","small",null,{"children":"The 31st Virginia supplied skirmishers near the turnpike. Regiments from Taliaferro’s and Campbell’s brigades arrived during the battle, while the Stonewall Brigade remained in reserve and did not enter the fighting."}]]}]
17:["$","div","12th Georgia salient",{"children":[["$","span",null,{"children":"12th Georgia salient"}],["$","strong",null,{"children":"A forward spur exposed the regiment to fire from three directions"}],["$","small",null,{"children":"The regiment fought the 75th Ohio at close range until ammunition and losses forced it back. The 48th Virginia relieved it near sunset."}]]}]
18:["$","div","Terrain advantage",{"children":[["$","span",null,{"children":"Terrain advantage"}],["$","strong",null,{"children":"The crest protected Confederate soldiers while they reloaded"}],["$","small",null,{"children":"The steep open approach forced United States soldiers to climb under fire and limited their view of the defenders."}]]}]
19:["$","div","Terrain disadvantages",{"children":[["$","span",null,{"children":"Terrain disadvantages"}],["$","strong",null,{"children":"Skyline exposure, setting sun, overshooting, and no Confederate artillery on the crest"}],["$","small",null,{"children":"Confederates stepped above the crest to fire and were silhouetted against the eastern sky. They faced west into the setting sun, and many shots passed over troops below. The National Park Service also notes that many Confederate infantrymen carried smoothbores while most attackers had rifled muskets."}]]}]
1a:["$","div","Turnpike fight",{"children":[["$","span",null,{"children":"Turnpike fight"}],["$","strong",null,{"children":"3rd West Virginia met detachments of the 31st and 52nd Virginia"}],["$","small",null,{"children":"Several companies on both sides had been recruited around Clarksburg. At close range, former neighbors recognized and called to one another across the firing line."}]]}]
1b:["$","div","Confederate reinforcement",{"children":[["$","span",null,{"children":"Confederate reinforcement"}],["$","strong",null,{"children":"Taliaferro’s and Campbell’s regiments extended and relieved the line"}],["$","small",null,{"children":"The 10th Virginia formed behind the left; the 23rd and 37th Virginia relieved the 25th Virginia; and the 48th Virginia replaced the depleted 12th Georgia. Exact arrival order and unit frontage varied during the confused evening action."}]]}]
1c:["$","div","Johnson wounded",{"children":[["$","span",null,{"children":"Johnson wounded"}],["$","strong",null,{"children":"A bullet shattered Edward Johnson’s ankle at about 8 p.m."}],["$","small",null,{"children":"William B. Taliaferro then became the senior Confederate commander on Sitlington Hill. Johnson’s wound removed him from field service for about a year."}]]}]
1d:["$","div","End of fighting",{"children":[["$","span",null,{"children":"End of fighting"}],["$","strong",null,{"children":"Firing diminished around 9 p.m.; United States regiments recrossed by about 10 p.m."}],["$","small",null,{"children":"Darkness, exhaustion, ammunition limits, and the increasing number of Confederate reinforcements ended the attack."}]]}]
1e:["$","div","United States casualties",{"children":[["$","span",null,{"children":"United States casualties"}],["$","strong",null,{"children":"259 in the episode: 26 killed, 230 wounded, and 3 missing"}],["$","small",null,{"children":"Published totals conflict. The National Park Service gives 256 without the same category breakdown; Encyclopedia Virginia gives 259 as 34 killed, 220 wounded, and 5 captured. The episode’s exact breakdown is preserved here but should not be treated as uniquely settled."}]]}]
1f:["$","div","Confederate casualties",{"children":[["$","span",null,{"children":"Confederate casualties"}],["$","strong",null,{"children":"532: 146 killed or mortally wounded, 382 wounded, and 4 captured"}],["$","small",null,{"children":"The National Park Service also gives 532. Some official battlefield summaries round the Confederate total to about 500."}]]}]
20:["$","div","12th Georgia losses",{"children":[["$","span",null,{"children":"12th Georgia losses"}],["$","strong",null,{"children":"175 casualties among about 540 engaged"}],["$","small",null,{"children":"The episode gives 52 killed and 123 wounded. The regiment accounted for roughly one-third of all Confederate casualties at McDowell."}]]}]
21:["$","div","Senior leader killed",{"children":[["$","span",null,{"children":"Senior leader killed"}],["$","strong",null,{"children":"Col. Simeon B. Gibbons, 10th Virginia Infantry"}],["$","small",null,{"children":"Gibbons was the senior Confederate regimental commander killed at McDowell. Cols. George H. Smith of the 25th Virginia and Michael G. Harman of the 52nd Virginia were wounded but survived."}]]}]
22:["$","div","Battle assessment",{"children":[["$","span",null,{"children":"Battle assessment"}],["$","strong",null,{"children":"United States tactical performance; Confederate operational and strategic success"}],["$","small",null,{"children":"Milroy and Schenck achieved their limited purpose of delivering a damaging blow and withdrawing. They did not take the hill and abandoned McDowell, while Jackson checked Frémont’s advance and retained freedom to turn against Banks. Sources variously call the battlefield result a Confederate victory, a draw, or a United States tactical success."}]]}]
23:["$","div","Retreat to Franklin",{"children":[["$","span",null,{"children":"Retreat to Franklin"}],["$","strong",null,{"children":"The United States column left after midnight on May 9 and reached Franklin on May 11"}],["$","small",null,{"children":"Milroy’s rear guard destroyed provisions and discarded excess ammunition. The retreating troops later burned timber beside the road, and the fires and smoke delayed Confederate pursuit."}]]}]
24:["$","div","End of pursuit",{"children":[["$","span",null,{"children":"End of pursuit"}],["$","strong",null,{"children":"Jackson declined to attack the strong Franklin position and turned back on May 13"}],["$","small",null,{"children":"With the immediate western threat checked, he returned toward McDowell, Staunton, and his planned concentration with Ewell against Banks."}]]}]
25:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“Stonewall in the Valley” by Robert G. Tanner"}],"$undefined"]}]
26:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
27:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","May 7–13: McDowell and the pursuit to Franklin",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep146-mcdowell-operation.svg","target":"_blank","rel":"noreferrer","aria-label":"Open May 7–13: McDowell and the pursuit to Franklin at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-mcdowell-operation.svg","alt":"Schematic operational map showing Confederate movement from Staunton to McDowell, Schenck’s reinforcement march, and the retreat and pursuit to Franklin.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"May 7–13: McDowell and the pursuit to Franklin"}],["$","span",null,{"children":"Jackson and Edward Johnson moved west from Staunton while Schenck marched from the Franklin road to reinforce Milroy. After the May 8 battle, the United States brigades retreated to Franklin. Jackson’s delayed pursuit stopped before the strong ridges there, and he turned back on May 13. This operational diagram is schematic: routes, terrain bands, distances, and camp positions are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep146-mcdowell-operation.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","May 8: the fight for Sitlington Hill",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep146-sitlington-hill-tactics.svg","target":"_blank","rel":"noreferrer","aria-label":"Open May 8: the fight for Sitlington Hill at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-sitlington-hill-tactics.svg","alt":"Schematic tactical map of United States regiments crossing Bull Pasture River to attack Confederate units on Sitlington Hill at McDowell.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"May 8: the fight for Sitlington Hill"}],["$","span",null,{"children":"Five United States regiments crossed the Bull Pasture River and attacked eastward up Sitlington Hill. Johnson’s initial regiments held the crest while reinforcements from Jackson’s Valley Army arrived. The 12th Georgia occupied an exposed forward spur; the 3rd West Virginia fought along the turnpike. This is a schematic phase map, not a surveyed plot: unit fronts, arrows, slopes, and spacing are simplified."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep146-sitlington-hill-tactics.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/articles/000/battle-of-mcdowell.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Jedediah Hotchkiss’s 1862 battle sketch",{"className":"reference-map","children":["$L2e","$L2f"]}]]}]]}]
28:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","A United States soldier describes the climb",{"className":"moment","children":[["$","$L30",null,{"seconds":45,"label":"0:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"A United States soldier describes the climb"}],["$","p",null,{"children":"The opening reading follows Lt. Alfred E. Lee of the 82nd Ohio down to the turnpike and up the steep exposed slope under Confederate fire, then records the exhaustion and dead left after darkness ended the attack."}]]}]]}],["$","div","A Confederate soldier describes the crest",{"className":"moment","children":[["$","$L30",null,{"seconds":210,"label":"3:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"A Confederate soldier describes the crest"}],["$","p",null,{"children":"George W. Spenagle of the 25th Virginia explains that downhill fire tended to pass over the attackers while Confederate soldiers were exposed against the skyline whenever they rose to shoot."}]]}]]}],["$","div","The Battle of McDowell is dated",{"className":"moment","children":[["$","$L30",null,{"seconds":321,"label":"5:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Battle of McDowell is dated"}],["$","p",null,{"children":"The hosts place the engagement on Thursday, May 8, 1862, and connect it to operations around Fredericksburg and Richmond."}]]}]]}],["$","div","Lee links Valley action to Richmond",{"className":"moment","children":[["$","$L30",null,{"seconds":378,"label":"6:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee links Valley action to Richmond"}],["$","p",null,{"children":"Robert E. Lee wanted Jackson to keep United States forces occupied in the Valley so they could not reinforce Irvin McDowell’s force on the direct route toward Richmond."}]]}]]}],["$","div","Jackson identifies the two western threats",{"className":"moment","children":[["$","$L30",null,{"seconds":481,"label":"8:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson identifies the two western threats"}],["$","p",null,{"children":"Banks was advancing up the Valley while Frémont’s forces approached through the Alleghenies. Jackson feared they might unite at Staunton."}]]}]]}],["$","div","Jackson sets a two-stage plan",{"className":"moment","children":[["$","$L30",null,{"seconds":542,"label":"9:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson sets a two-stage plan"}],["$","p",null,{"children":"He intended first to strike Frémont’s advance guard under Milroy, then return east, join Ewell, and attack Banks."}]]}]]}],["$","div","Ewell replaces Jackson near Swift Run Gap",{"className":"moment","children":[["$","$L30",null,{"seconds":570,"label":"9:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell replaces Jackson near Swift Run Gap"}],["$","p",null,{"children":"Ewell’s division held the position opposite Banks while Jackson moved to Staunton and joined Edward Johnson for the western operation."}]]}]]}],["$","div","Milroy is identified as Frémont’s vanguard",{"className":"moment","children":[["$","$L30",null,{"seconds":613,"label":"10:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Milroy is identified as Frémont’s vanguard"}],["$","p",null,{"children":"The episode estimates Milroy’s advance force at about 3,000 and Jackson’s combined force with Johnson at about 10,000."}]]}]]}],["$","div","Jackson meets Johnson at West View",{"className":"moment","children":[["$","$L30",null,{"seconds":749,"label":"12:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson meets Johnson at West View"}],["$","p",null,{"children":"On May 6 Jackson went northwest from Staunton to coordinate with Johnson. Their combined column moved west at daybreak on May 7."}]]}]]}],["$","div","Johnson leads the advance",{"className":"moment","children":[["$","$L30",null,{"seconds":832,"label":"13:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnson leads the advance"}],["$","p",null,{"children":"Jackson placed Johnson in front because of his experience in the mountain region. Taliaferro and Campbell followed, with Winder and the VMI cadets at the rear."}]]}]]}],"$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c"]}]]}]
29:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Mountain Department",{"className":"command-entry","children":[["$","strong",null,{"children":"Mountain Department"}],["$","span",null,{"children":"Maj. Gen. John C. Frémont"}],["$","small",null,{"children":"Directed the dispersed western Virginia forces to which the brigades of Robert Milroy, Robert Schenck, and the newly arrived Blenker division belonged"}]]}],["$","div","Senior United States commander at McDowell",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior United States commander at McDowell"}],["$","span",null,{"children":"Brig. Gen. Robert C. Schenck"}],["$","small",null,{"children":"Reached McDowell about 10 a.m. on May 8; retained nominal command of his brigade and approved the limited spoiling attack and nighttime withdrawal"}]]}],["$","div","Advance brigade and battlefield attack direction",{"className":"command-entry","children":[["$","strong",null,{"children":"Advance brigade and battlefield attack direction"}],["$","span",null,{"children":"Brig. Gen. Robert H. Milroy"}],["$","small",null,{"children":"Proposed offensive action and directed five regiments across the Bull Pasture River: 25th, 32nd, and 75th Ohio; 82nd Ohio from Schenck’s brigade; and 3rd West Virginia"}]]}],["$","div","Main assault commander, 75th Ohio Infantry",{"className":"command-entry","children":[["$","strong",null,{"children":"Main assault commander, 75th Ohio Infantry"}],["$","span",null,{"children":"Col. Nathaniel C. McLean"}],["$","small",null,{"children":"Directed the 25th and 75th Ohio against the Confederate center and reported the difficulty of the steep exposed slope"}]]}],["$","div","Fire support west of the Bull Pasture River",{"className":"command-entry","children":[["$","strong",null,{"children":"Fire support west of the Bull Pasture River"}],["$","span",null,{"children":"United States artillery"}],["$","small",null,{"children":"Covered the approaches from Cedar Knob and other high ground; no artillery accompanied the infantry onto Sitlington Hill"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Overall Confederate commander, Valley Army",{"className":"command-entry","children":[["$","strong",null,{"children":"Overall Confederate commander, Valley Army"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Combined with Edward Johnson, directed reinforcements to Sitlington Hill, held the Stonewall Brigade in reserve, and pursued the retreat toward Franklin"}]]}],["$","div","Initial commander on Sitlington Hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Initial commander on Sitlington Hill"}],["$","span",null,{"children":"Brig. Gen. Edward “Allegheny” Johnson"}],["$","small",null,{"children":"Personally formed the first defending regiments; wounded in the ankle at about 8 p.m. and carried from the field"}]]}],["$","div","Third Brigade; succeeded Johnson on the hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Third Brigade; succeeded Johnson on the hill"}],["$","span",null,{"children":"Brig. Gen. William B. Taliaferro"}],["$","small",null,{"children":"10th, 23rd, and 37th Virginia Infantry; took tactical command after Johnson was wounded"}]]}],["$","div","Johnson’s brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Johnson’s brigade"}],["$","span",null,{"children":"Col. Zephaniah T. Conner"}],["$","small",null,{"children":"12th Georgia, 25th Virginia, and 31st Virginia Infantry; the 12th Georgia held the exposed central salient"}]]}],"$L4d","$L4e","$L4f","$L50"]]}]]}],"$L51","$L52"]}]
2a:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. Simeon B. Gibbons",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Simeon B. Gibbons"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 10th Virginia Infantry","."]}]," ","Killed during the Battle of McDowell on May 8, 1862"]}]]}],["$","article","Brig. Gen. Edward “Allegheny” Johnson",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Edward “Allegheny” Johnson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Initial Confederate commander on Sitlington Hill","."]}]," ","Severely wounded when a bullet shattered his ankle; absent from field command for about a year"]}]]}],["$","article","Capt. William Long",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Capt. William Long"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, Company B, 52nd Virginia Infantry","."]}]," ","Mortally wounded at McDowell and died after the battle, according to Col. Michael G. Harman’s official report"]}]]}]]}]]}]
2b:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep146-hotchkiss-mcdowell-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-hotchkiss-mcdowell-map.jpg","alt":"Jedediah Hotchkiss’s 1862 manuscript sketch of the Battle of McDowell.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hotchkiss drew this field sketch of the May 8 battle. It identifies McDowell, Bull Pasture River, the turnpike, surrounding relief, and Confederate positions on the height."}]]}],["$","figure","/images/ep146-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-stonewall-jackson.jpg","alt":"Wartime photographic portrait of Confederate general Thomas J. Stonewall Jackson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson did not plan to fight on May 8, but the United States attack forced him to feed arriving regiments onto Sitlington Hill. The subsequent Federal retreat gave him the operational result he needed."}]]}],["$","figure","/images/ep146-edward-johnson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-edward-johnson.jpg","alt":"Civil War-era photographic portrait of Confederate general Edward Allegheny Johnson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Johnson led the approach and organized the initial Confederate line on Sitlington Hill. A bullet shattered his ankle around 8 p.m., and Taliaferro succeeded him on the field."}]]}],["$","figure","/images/ep146-robert-milroy.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-robert-milroy.jpg","alt":"Three wartime photographic exposures of United States general Robert H. Milroy in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Milroy advocated the spoiling attack and directed five regiments across the Bull Pasture River. He remained with the rear guard during the overnight evacuation."}]]}],["$","figure","/images/ep146-robert-schenck.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-robert-schenck.jpg","alt":"Wartime photographic portrait of United States general Robert C. Schenck in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Schenck arrived after a 34-mile forced march and became the senior United States commander. He approved the limited attack and the withdrawal toward Franklin."}]]}],["$","figure","/images/ep146-mcdowell-operation.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-mcdowell-operation.svg","alt":"Schematic map of the McDowell operation and pursuit between Staunton and Franklin.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The battle checked Frémont’s approach to Staunton. Jackson followed the retreat toward Franklin, declined to attack its strong ridges, and turned back on May 13."}]]}],["$","figure","/images/ep146-sitlington-hill-tactics.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep146-sitlington-hill-tactics.svg","alt":"Schematic tactical map of the United States attack on Confederate positions at Sitlington Hill.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The attackers crossed the river and climbed eastward while Confederate regiments arrived and shifted along the crest. The diagram simplifies the confused, changing line and is not to scale."}]]}]]}]]}]
