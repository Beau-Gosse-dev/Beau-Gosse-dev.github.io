31:["$","small",null,{"children":"Personally formed the first defending regiments; wounded in the ankle at about 8 p.m. and carried from the field"}]
32:["$","div","Third Brigade; succeeded Johnson on the hill-Brig. Gen. William B. Taliaferro",{"className":"command-entry","children":[["$","strong",null,{"children":"Third Brigade; succeeded Johnson on the hill"}],["$","span",null,{"children":"Brig. Gen. William B. Taliaferro"}],["$","small",null,{"children":"10th, 23rd, and 37th Virginia Infantry; took tactical command after Johnson was wounded"}]]}]
33:["$","div","Johnson’s brigade-Col. Zephaniah T. Conner",{"className":"command-entry","children":[["$","strong",null,{"children":"Johnson’s brigade"}],["$","span",null,{"children":"Col. Zephaniah T. Conner"}],["$","small",null,{"children":"12th Georgia, 25th Virginia, and 31st Virginia Infantry; the 12th Georgia held the exposed central salient"}]]}]
34:["$","div","Johnson’s brigade-Col. William C. Scott",{"className":"command-entry","children":[["$","strong",null,{"children":"Johnson’s brigade"}],["$","span",null,{"children":"Col. William C. Scott"}],["$","small",null,{"children":"44th, 52nd, and 58th Virginia Infantry; elements held the right, left, and turnpike approaches as the fight developed"}]]}]
35:["$","div","Acting commander, Second Brigade-Col. John A. Campbell",{"className":"command-entry","children":[["$","strong",null,{"children":"Acting commander, Second Brigade"}],["$","span",null,{"children":"Col. John A. Campbell"}],["$","small",null,{"children":"48th Virginia Infantry entered late and relieved the 12th Georgia near sunset; other brigade elements were not all committed"}]]}]
36:["$","div","Stonewall Brigade-Brig. Gen. Charles S. Winder",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Brig. Gen. Charles S. Winder"}],["$","small",null,{"children":"Brought up as Jackson’s reserve but did not enter the May 8 fighting before the United States attack ended"}]]}]
