2e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Jedediah Hotchkiss’s 1862 battle sketch"}],["$","span",null,{"children":"Hotchkiss’s manuscript map records the turnpike, Bull Pasture River, McDowell, the surrounding ridges, and Confederate positions on the height. It is a primary cartographic source made by Jackson’s topographical engineer. It should be read as a contemporary field sketch rather than a modern georeferenced map."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep146-hotchkiss-mcdowell-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/2005625009/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
