d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",161," · ","June 27, 1862"," · ","Gaines’s Mill battlefield north of the Chickahominy River, near Mechanicsville and Richmond in Hanover County, Virginia"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: GAINES'S MILL (Part the Third)"}],["$","span",null,{"className":"result-label","children":"Confederate victory. A late assault by Robert E. Lee’s army broke Fitz John Porter’s reinforced V Corps line behind Boatswain’s Swamp. Porter’s survivors withdrew across the Chickahominy after dark. The victory cost Lee about 8,750 casualties and came too late in the day to destroy Porter’s command"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"June 27, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Gaines’s Mill battlefield north of the Chickahominy River, near Mechanicsville and Richmond in Hanover County, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Confederate victory. A late assault by Robert E. Lee’s army broke Fitz John Porter’s reinforced V Corps line behind Boatswain’s Swamp. Porter’s survivors withdrew across the Chickahominy after dark. The victory cost Lee about 8,750 casualties and came too late in the day to destroy Porter’s command"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Final attack strength in the episode",{"children":[["$","th",null,{"scope":"row","children":"Final attack strength in the episode"}],["$","td",null,{"children":["About 32,000 Confederates against roughly 32,000–34,000 United States troops",["$","small",null,{"style":{"display":"block"},"children":"These figures describe forces available along the late-day front, not total forces present during the whole battle. The National Park Service lists 34,214 United States and 57,018 Confederate personnel engaged by its broader accounting."}]]}]]}],"$Lf","$L10","$L11","$L12"]}]]}],"$L13"]}],"$undefined"]}],"$L14","$L15","$L16",false,"$L17","$L18","$L19","$L1a","$L1b","$L1c"]}]]}]
