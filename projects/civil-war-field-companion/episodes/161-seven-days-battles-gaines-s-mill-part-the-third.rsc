13:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.libsyn.com/161-seven-days-battles-gainess-mill-part-the-third",{"href":"https://civilwarpodcast.libsyn.com/161-seven-days-battles-gainess-mill-part-the-third","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 161 page"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va017",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va017","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service battle summary: Gaines’s Mill"]}],["$","a","https://www.nps.gov/rich/learn/historyculture/gainesmillbull.htm",{"href":"https://www.nps.gov/rich/learn/historyculture/gainesmillbull.htm","target":"_blank","rel":"noreferrer","children":[" · ","Richmond National Battlefield Park: The Battle of Gaines’s Mill"]}],["$","a","https://www.nps.gov/rich/planyourvisit/upload/RICH-Gaines-Mill-2-21-2020finalpress-quality.pdf",{"href":"https://www.nps.gov/rich/planyourvisit/upload/RICH-Gaines-Mill-2-21-2020finalpress-quality.pdf","target":"_blank","rel":"noreferrer","children":[" · ","Richmond National Battlefield Park: Gaines’s Mill Confederate Attack Trail"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00217/",{"href":"https://www.loc.gov/item/gvhs01.vhs00217/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Robert Knox Sneden’s Plan of the Battle of Gaines’ Mill"]}],["$","a","https://www.loc.gov/item/2004660316/",{"href":"https://www.loc.gov/item/2004660316/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Alfred R. Waud’s “After Gaines Mill Sunday June 29th 1862”"]}],["$","a","https://www.loc.gov/item/2022630550/",{"href":"https://www.loc.gov/item/2022630550/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: John Bell Hood portrait"]}],["$","a","https://www.loc.gov/item/2018667594/",{"href":"https://www.loc.gov/item/2018667594/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Fitz John Porter portrait"]}],["$","a","https://archive.org/details/henrywilsonsregi00park",{"href":"https://archive.org/details/henrywilsonsregi00park","target":"_blank","rel":"noreferrer","children":[" · ","John L. Parker, “Henry Wilson’s Regiment: History of the Twenty-Second Massachusetts Infantry”"]}],["$","a","https://civilwarpodcast.org/book-recommendations/",{"href":"https://civilwarpodcast.org/book-recommendations/","target":"_blank","rel":"noreferrer","children":[" · ","Official podcast book-recommendations list"]}]]}]
