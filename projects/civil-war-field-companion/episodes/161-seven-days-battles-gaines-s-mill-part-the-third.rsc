18:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. John Marshall",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. John Marshall"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 4th Texas Infantry","."]}]," ","Killed by a long-range shot during the approach to Boatswain’s Swamp. The National Park Service trail guide places the event about 550 yards north of the creek."]}]]}],["$","article","Col. Jesse A. Gove",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. Jesse A. Gove"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 22nd Massachusetts Infantry","."]}]," ","Killed while his regiment fought in Martindale’s brigade. His body was not recovered by the regiment after the Federal retreat."]}]]}]]}]]}]
19:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L27","/images/ep161-sneden-gaines-mill-map.jpg",{"image":"/images/ep161-sneden-gaines-mill-map.jpg","alt":"Robert Knox Sneden watercolor map showing the Gaines’s Mill battlefield and colored unit positions.","caption":"Sneden’s period map preserves a participant-era interpretation. The Library of Congress corrects the June 26 date written in its title to June 27.","name":"Robert Knox Sneden watercolor map showing the Gaines’s Mill battlefield and colored unit positions.","source":"$undefined","credit":"Library of Congress Geography and Map Division; see sources below."}],["$","$L27","/images/ep161-after-gaines-mill-waud.jpg",{"image":"/images/ep161-after-gaines-mill-waud.jpg","alt":"Alfred Waud drawing of United States troops, wagons, artillery, and burning stores after Gaines’s Mill.","caption":"Alfred R. Waud drew Franklin’s VI Corps falling back near Trent’s House on June 29, with wagon traffic and burning commissary stores. It records the wider withdrawal after Gaines’s Mill, not the June 27 assault itself.","name":"Alfred Waud drawing of United States troops, wagons, artillery, and burning stores after Gaines’s Mill.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L27","/images/ep161-hood.jpg",{"image":"/images/ep161-hood.jpg","alt":"Civil War-era photographic portrait of Confederate officer John Bell Hood in uniform.","caption":"John B. Hood led the 4th Texas and 18th Georgia in the best-known breakthrough attack at Gaines’s Mill.","name":"Civil War-era photographic portrait of Confederate officer John Bell Hood in uniform.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L27","/images/ep161-fitz-john-porter.jpg",{"image":"/images/ep161-fitz-john-porter.jpg","alt":"Civil War-era glass-negative portrait of United States general Fitz John Porter.","caption":"Fitz John Porter directed the reinforced V Corps defense and withdrew the survivors across the Chickahominy after dark.","name":"Civil War-era glass-negative portrait of United States general Fitz John Porter.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}]]}]]}]
