28:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. John Marshall",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. John Marshall"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 4th Texas Infantry","."]}]," ","Killed by a long-range shot during the approach to Boatswain’s Swamp. The National Park Service trail guide places the event about 550 yards north of the creek."]}]]}],["$","article","Col. Jesse A. Gove",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. Jesse A. Gove"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 22nd Massachusetts Infantry","."]}]," ","Killed while his regiment fought in Martindale’s brigade. His body was not recovered by the regiment after the Federal retreat."]}]]}]]}]]}]
29:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep161-virginia-campaign-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep161-virginia-campaign-context.svg","alt":"Schematic regional map locating Gaines’s Mill northeast of Richmond and north of the Chickahominy.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The battle occurred close to Richmond but on the north side of the Chickahominy, separated from most of McClellan’s army."}]]}],["$","figure","/images/ep161-gaines-mill-final-assault.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep161-gaines-mill-final-assault.svg","alt":"Schematic tactical map of Confederate attacks and the Federal retreat at Gaines’s Mill.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The broad assault placed pressure on Sykes’s right and Morell’s left at the same time. The diagram is schematic and not to scale."}]]}],["$","figure","/images/ep161-sneden-gaines-mill-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep161-sneden-gaines-mill-map.jpg","alt":"Robert Knox Sneden watercolor map showing the Gaines’s Mill battlefield and colored unit positions.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Sneden’s period map preserves a participant-era interpretation. The Library of Congress corrects the June 26 date written in its title to June 27."}]]}],["$","figure","/images/ep161-after-gaines-mill-waud.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep161-after-gaines-mill-waud.jpg","alt":"Alfred Waud drawing of United States troops, wagons, artillery, and burning stores after Gaines’s Mill.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alfred R. Waud drew Franklin’s VI Corps falling back near Trent’s House on June 29, with wagon traffic and burning commissary stores. It records the wider withdrawal after Gaines’s Mill, not the June 27 assault itself."}]]}],["$","figure","/images/ep161-hood.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep161-hood.jpg","alt":"Civil War-era photographic portrait of Confederate officer John Bell Hood in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"John B. Hood led the 4th Texas and 18th Georgia in the best-known breakthrough attack at Gaines’s Mill."}]]}],["$","figure","/images/ep161-fitz-john-porter.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep161-fitz-john-porter.jpg","alt":"Civil War-era glass-negative portrait of United States general Fitz John Porter.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Fitz John Porter directed the reinforced V Corps defense and withdrew the survivors across the Chickahominy after dark."}]]}]]}]]}]
