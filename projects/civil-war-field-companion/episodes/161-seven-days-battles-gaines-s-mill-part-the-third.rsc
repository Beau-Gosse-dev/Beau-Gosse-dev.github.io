1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",161," · ","June 27, 1862"," · ","Gaines’s Mill battlefield north of the Chickahominy River, near Mechanicsville and Richmond in Hanover County, Virginia"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: GAINES'S MILL (Part the Third)"}],["$","span",null,{"className":"result-label","children":"Confederate victory. A late assault by Robert E. Lee’s army broke Fitz John Porter’s reinforced V Corps line behind Boatswain’s Swamp. Porter’s survivors withdrew across the Chickahominy after dark. The victory cost Lee about 8,750 casualties and came too late in the day to destroy Porter’s command"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8938408363.mp3?updated=1695385013","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The final assault, Federal retreat, and command assessment at Gaines’s Mill"}],["$","small",null,{"children":"This episode resumes the June 27 battle after earlier Confederate attacks had failed to break Porter’s position."}]]}],["$","div","Battlefield position",{"children":[["$","span",null,{"children":"Battlefield position"}],["$","strong",null,{"children":"Porter faced west and north behind Boatswain’s Swamp with the Chickahominy at his rear"}],["$","small",null,{"children":"The National Park Service describes a defensive arc about one and one-half miles long. The episode describes the late line as part of a front extending roughly two miles."}]]}],["$","div","Late Confederate front",{"children":[["$","span",null,{"children":"Late Confederate front"}],["$","strong",null,{"children":"D. H. Hill on the left; Ewell, Winder, Lawton, and A. P. Hill in the center; Whiting and Longstreet on the right"}],["$","small",null,{"children":"The alignment was assembled after delayed marches, earlier attacks, and piecemeal deployment. Exact brigade boundaries shifted during the fighting."}]]}],["$","div","Whiting enters the line",{"children":[["$","span",null,{"children":"Whiting enters the line"}],["$","strong",null,{"children":"Lee placed Whiting to the right of A. P. Hill after 5 p.m."}],["$","small",null,{"children":"Whiting’s division, with John B. Hood’s brigade on the left and Evander M. Law’s on the right, filled much of the gap between A. P. Hill and Longstreet."}]]}],["$","div","Jackson’s role",{"children":[["$","span",null,{"children":"Jackson’s role"}],["$","strong",null,{"children":"Jackson ordered his divisions forward but did not personally place them for the final assault"}],["$","small",null,{"children":"Lee had already directed Ewell and Whiting into the battle. The episode treats Jackson’s delayed march and limited battlefield direction as a serious failure."}]]}],["$","div","Final attack strength in the episode",{"children":["$Le","$Lf","$L10"]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}],"$L25","$undefined","$L26",false,"$L27","$L28","$L29","$L2a","$L2b"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","span",null,{"children":"Final attack strength in the episode"}]
f:["$","strong",null,{"children":"About 32,000 Confederates against roughly 32,000–34,000 United States troops"}]
10:["$","small",null,{"children":"These figures describe forces available along the late-day front, not total forces present during the whole battle. The National Park Service lists 34,214 United States and 57,018 Confederate personnel engaged by its broader accounting."}]
11:["$","div","Federal command problem",{"children":[["$","span",null,{"children":"Federal command problem"}],["$","strong",null,{"children":"Porter had almost no organized reserve when the final assault developed"}],["$","small",null,{"children":"Regiments from McCall’s and Slocum’s divisions had been inserted where needed, reducing the ability of their division and brigade commanders to control intact formations during a breakthrough."}]]}]
12:["$","div","Porter’s right",{"children":[["$","span",null,{"children":"Porter’s right"}],["$","strong",null,{"children":"George Sykes’s regulars, reinforced by Joseph J. Bartlett’s brigade"}],["$","small",null,{"children":"Sykes’s brigades were commanded by Robert C. Buchanan, Charles S. Lovell, and Gouverneur K. Warren. They faced D. H. Hill and elements of Jackson’s command."}]]}]
13:["$","div","Porter’s left",{"children":[["$","span",null,{"children":"Porter’s left"}],["$","strong",null,{"children":"George W. Morell’s division on the Watt House plateau"}],["$","small",null,{"children":"The brigades of Charles Griffin, John H. Martindale, and Daniel Butterfield, with attached units from McCall and Slocum, faced Whiting and Longstreet."}]]}]
14:["$","div","D. H. Hill’s advance",{"children":[["$","span",null,{"children":"D. H. Hill’s advance"}],["$","strong",null,{"children":"A slow attack through wooded, boggy ground fixed Sykes’s division"}],["$","small",null,{"children":"Hill made limited progress for more than an hour, but the pressure helped prevent Sykes from reinforcing other sectors."}]]}]
15:["$","div","20th North Carolina losses",{"children":[["$","span",null,{"children":"20th North Carolina losses"}],["$","strong",null,{"children":"272 casualties in the episode’s account"}],["$","small",null,{"children":"The regiment, part of Samuel Garland’s brigade, was in its first battle. The episode gives the loss as about 40 percent of its strength."}]]}]
16:["$","div","Lawton’s brigade",{"children":[["$","span",null,{"children":"Lawton’s brigade"}],["$","strong",null,{"children":"About 3,600 men in its first combat"}],["$","small",null,{"children":"Lawton’s large Georgia brigade crossed the swamp after a prolonged struggle, gained the Federal side, and paused to restore alignment in smoke and fading light."}]]}]
17:["$","div","Longstreet’s attack",{"children":[["$","span",null,{"children":"Longstreet’s attack"}],["$","strong",null,{"children":"Five brigades advanced from the Powhite Creek area toward the Federal left"}],["$","small",null,{"children":"Longstreet first began a diversion, then changed to a full assault after Lee required stronger action."}]]}]
18:["$","div","Whiting’s attack order",{"children":[["$","span",null,{"children":"Whiting’s attack order"}],["$","strong",null,{"children":"Law and Hood were to advance rapidly without stopping to fire"}],["$","small",null,{"children":"The National Park Service confirms that speed and momentum were central to Hood’s instructions. Hood led the 4th Texas and 18th Georgia toward the creek."}]]}]
19:["$","div","George E. Pickett wounded",{"children":[["$","span",null,{"children":"George E. Pickett wounded"}],["$","strong",null,{"children":"Shot near the right shoulder during Longstreet’s advance"}],["$","small",null,{"children":"The National Park Service trail guide states that Pickett was hit after his brigade halted under heavy fire near the creek. He survived."}]]}]
1a:["$","div","Breakthrough",{"children":[["$","span",null,{"children":"Breakthrough"}],["$","strong",null,{"children":"The Federal line failed in several sectors at nearly the same time"}],["$","small",null,{"children":"Hood’s, Wilcox’s, Lawton’s, and D. H. Hill’s troops later advanced competing claims. The evidence does not establish a precise first breakthrough across the entire front."}]]}]
1b:["$","div","Federal captures",{"children":[["$","span",null,{"children":"Federal captures"}],["$","strong",null,{"children":"Nearly 1,000 men from two regiments of George W. Taylor’s brigade were captured"}],["$","small",null,{"children":"Other pockets of United States troops were also cut off during the retreat, especially near the breakthrough on the Federal left."}]]}]
1c:["$","div","Forward artillery losses",{"children":[["$","span",null,{"children":"Forward artillery losses"}],["$","strong",null,{"children":"Ten United States guns were abandoned along the main line in the episode’s account"}],["$","small",null,{"children":"Confederate infantry closed on the batteries as supporting Federal infantry withdrew and battery horses were shot."}]]}]
1d:["$","div","Cooke’s cavalry charge",{"children":[["$","span",null,{"children":"Cooke’s cavalry charge"}],["$","strong",null,{"children":"About 250 United States cavalrymen attacked shortly after 8 p.m."}],["$","small",null,{"children":"Philip St. George Cooke ordered the charge without Porter’s authorization. Its repulse disrupted the reserve artillery position and cost about 50 troopers in the episode’s account."}]]}]
1e:["$","div","Reserve artillery losses",{"children":[["$","span",null,{"children":"Reserve artillery losses"}],["$","strong",null,{"children":"Nine additional cannon were abandoned after the cavalry charge"}],["$","small",null,{"children":"The episode treats the charge as a costly local action, not the cause of Porter’s already developing retreat."}]]}]
1f:["$","div","Late reinforcements",{"children":[["$","span",null,{"children":"Late reinforcements"}],["$","strong",null,{"children":"Two brigades from Edwin V. Sumner’s II Corps arrived near 8 p.m."}],["$","small",null,{"children":"They arrived too late to restore the main position and instead helped cover the withdrawal toward the river."}]]}]
20:["$","div","Night withdrawal",{"children":[["$","span",null,{"children":"Night withdrawal"}],["$","strong",null,{"children":"Porter’s command crossed the Alexander and Grapevine bridges"}],["$","small",null,{"children":"Darkness prevented Lee from fully exploiting the breakthrough and allowed the remnants of V Corps to rejoin the main army south of the Chickahominy."}]]}]
21:["$","div","Battle casualties",{"children":[["$","span",null,{"children":"Battle casualties"}],["$","strong",null,{"children":"United States 6,837; Confederacy 8,750"}],["$","small",null,{"children":"These are the National Park Service battle-summary figures. The episode rounds Porter’s loss to nearly 7,000 and Richmond National Battlefield Park rounds the Confederate loss to approximately 9,000. Counts vary by source and method."}]]}]
22:["$","div","Operational consequence",{"children":[["$","span",null,{"children":"Operational consequence"}],["$","strong",null,{"children":"McClellan abandoned the Richmond and York River Railroad supply line and continued toward the James River"}],["$","small",null,{"children":"The National Park Service identifies Gaines’s Mill as the defeat that confirmed McClellan’s decision to change his base and retreat away from Richmond."}]]}]
23:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The Richmond Campaign of 1862: The Peninsula and the Seven Days,” edited by Gary W. Gallagher"}],["$","small",null,{"children":"The episode recommends this essay collection for further study of the campaign."}]]}]
24:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Boatswain’s Swamp, Ewell, Winder, Morell, McGehee House, McDowell, and Fitz John Porter"}],["$","small",null,{"children":"The automated transcript produces forms including “Bose and Swamp,” “Yule,” “Whinder,” “Morrill,” “McGaughey,” “Urban McDowell,” and “Vitch John Porter.”"}]]}]
25:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
26:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Gaines’s Mill in the Peninsula Campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep161-virginia-campaign-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Gaines’s Mill in the Peninsula Campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep161-virginia-campaign-context.svg","alt":"Schematic regional map of Virginia showing Washington, Richmond, the Virginia Peninsula, Fort Monroe, the Chickahominy River, and Gaines’s Mill.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Gaines’s Mill in the Peninsula Campaign"}],["$","span",null,{"children":"Gaines’s Mill lay north of the Chickahominy, about seven miles northeast of central Richmond. Porter’s isolated wing occupied the battlefield while most of McClellan’s army remained south of the river. Rivers, coastline, routes, locations, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep161-virginia-campaign-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The final assault at Gaines’s Mill",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep161-gaines-mill-final-assault.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The final assault at Gaines’s Mill at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep161-gaines-mill-final-assault.svg","alt":"Schematic map of the final Confederate assault across Boatswain’s Swamp and the Federal withdrawal toward the Chickahominy River.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The final assault at Gaines’s Mill"}],["$","span",null,{"children":"D. H. Hill pressed the Federal right while Winder, Lawton, Ewell, and remnants of A. P. Hill attacked the center. Whiting and Longstreet advanced against Morell’s left near the Watt House. The Federal line broke in several places before withdrawing toward the Chickahominy bridges. Unit blocks and arrows show broad relationships, not exact formations, timing, frontage, or regimental routes. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep161-gaines-mill-final-assault.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Robert Knox Sneden map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Robert Knox Sneden’s period map of Gaines’s Mill",{"className":"reference-map","children":["$L2c","$L2d"]}]]}]]}]
27:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Remained south of the Chickahominy, controlled reinforcement of Porter, and directed the broader change of base"}]]}],["$","div","Reinforced V Corps-Maj. Gen. Fitz John Porter",{"className":"command-entry","children":[["$","strong",null,{"children":"Reinforced V Corps"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"Held the line with divisions and attached units under Sykes, Morell, McCall, and Slocum"}]]}],["$","div","V Corps division on the Federal right-Brig. Gen. George Sykes",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps division on the Federal right"}],["$","span",null,{"children":"Brig. Gen. George Sykes"}],["$","small",null,{"children":"Brigades of Robert C. Buchanan, Charles S. Lovell, and Gouverneur K. Warren"}]]}],["$","div","V Corps division on the Federal center and left-Brig. Gen. George W. Morell",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps division on the Federal center and left"}],["$","span",null,{"children":"Brig. Gen. George W. Morell"}],["$","small",null,{"children":"Brigades of Charles Griffin, John H. Martindale, and Daniel Butterfield"}]]}],["$","div","Attached divisions reinforcing Porter-Brig. Gen. George A. McCall and Brig. Gen. Henry W. Slocum",{"className":"command-entry","children":[["$","strong",null,{"children":"Attached divisions reinforcing Porter"}],["$","span",null,{"children":"Brig. Gen. George A. McCall and Brig. Gen. Henry W. Slocum"}],["$","small",null,{"children":"Regiments were distributed along the line; Joseph J. Bartlett and George W. Taylor commanded prominent reinforcing brigades"}]]}],["$","div","Cavalry attached to Porter-Brig. Gen. Philip St. George Cooke",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry attached to Porter"}],["$","span",null,{"children":"Brig. Gen. Philip St. George Cooke"}],["$","small",null,{"children":"Ordered the late charge of about 250 troopers near the reserve artillery"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Directed the army’s concentration and late assault against Porter’s line"}]]}],["$","div","Left wing of Lee’s army-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Left wing of Lee’s army"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],"$L2e"]}]