2d:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Robert Knox Sneden’s period map of Gaines’s Mill"}],["$","span",null,{"children":"Sneden’s wartime map shows the Chickahominy, Powhite Creek, Boatswain’s Swamp, the Watt House plateau, roads, and colored force positions. Its title gives June 26, but the Library of Congress notes that Gaines’s Mill was fought on June 27. The map is a historical artifact rather than a modern surveyed reconstruction."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep161-sneden-gaines-mill-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Geography and Map Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
