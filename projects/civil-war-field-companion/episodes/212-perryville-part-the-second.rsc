ntgomery Wright on Perryville"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://ehistory.osu.edu/exhibitions/letters/randall/08",{"children":["$","a",null,{"href":"https://ehistory.osu.edu/exhibitions/letters/randall/08","target":"_blank","rel":"noreferrer","children":["Primary soldier account: Frank Randall on the march and Bloomfield incident"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/99447187/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/99447187/","target":"_blank","rel":"noreferrer","children":["Library of Congress: J. B. Work’s battlefield map"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.kentuckypress.com/9780813133843/perryville/",{"children":["$","a",null,{"href":"https://www.kentuckypress.com/9780813133843/perryville/","target":"_blank","rel":"noreferrer","children":["University Press of Kentucky: Perryville by Kenneth W. Noe"," ","$L4f"]}]}],"$L50","$L51","$L52"]}]]}]
2c:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
2e:["$","div","The fugitive escapes",{"className":"moment","children":[["$","$L2d",null,{"seconds":716,"label":"11:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"The fugitive escapes"}],["$","p",null,{"children":"Rousseau released the soldiers after their officers intervened; during the commotion, the man at the center of the dispute got away."}]]}]]}]
2f:["$","div","The Confederates abandon Bardstown",{"className":"moment","children":[["$","$L2d",null,{"seconds":793,"label":"13:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederates abandon Bardstown"}],["$","p",null,{"children":"Polk’s right wing and Hardee’s left wing started east on separate but mutually supporting roads early on October 4."}]]}]]}]
30:["$","div","Bragg proceeds with the inauguration",{"className":"moment","children":[["$","$L2d",null,{"seconds":818,"label":"13:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg proceeds with the inauguration"}],["$","p",null,{"children":"Despite the deteriorating military position, Bragg oversaw Richard Hawes’s installation as Confederate governor at Frankfort."}]]}]]}]
31:["$","div","United States artillery interrupts the luncheon",{"className":"moment","children":[["$","$L2d",null,{"seconds":906,"label":"15:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States artillery interrupts the luncheon"}],["$","p",null,{"children":"Sill’s arrival forced the ceremony’s participants to flee, and his troops reoccupied Frankfort that night."}]]}]]}]
32:["$","div","Buell regroups at Bardstown",{"className":"moment","children":[["$","$L2d",null,{"seconds":927,"label":"15:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell regroups at Bardstown"}],["$","p",null,{"children":"The three main corps resumed their parallel eastward pursuit on October 5 while Sill slowly moved south from Frankfort."}]]}]]}]
33:["$","div","Bragg selects Harrodsburg",{"className":"moment","children":[["$","$L2d",null,{"seconds":977,"label":"16:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg selects Harrodsburg"}],["$","p",null,{"children":"Road connections and proximity to Camp Breckinridge made Harrodsburg the intended concentration point for Bragg and Kirby Smith."}]]}]]}]
34:["$","div","Cavalry screens Hardee’s retreat",{"className":"moment","children":[["$","$L2d",null,{"seconds":1017,"label":"16:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cavalry screens Hardee’s retreat"}],["$","p",null,{"children":"Joseph Wheeler’s horsemen delayed Gilbert’s pursuing corps and fought a successful action at Pottsville on October 7."}]]}]]}]
35:["$","div","Hardee halts at Perryville",{"className":"moment","children":[["$","$L2d",null,{"seconds":1040,"label":"17:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hardee halts at Perryville"}],["$","p",null,{"children":"His two divisions stopped around the town while the leading United States troops camped about three miles west."}]]}]]}]
36:["$","div","Bragg orders Polk to fight",{"className":"moment","children":[["$","$L2d",null,{"seconds":1064,"label":"17:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg orders Polk to fight"}],["$","p",null,{"children":"Polk was to bring Cheatham’s division, attack on October 8, and then move back toward the planned concentration at Harrodsburg."}]]}]]}]
37:["$","div","Buell prepares with an injured foot",{"className":"moment","children":[["$","$L2d",null,{"seconds":1109,"label":"18:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell prepares with an injured foot"}],["$","p",null,{"children":"A horse had fallen on Buell that afternoon, but he recognized that part of the withdrawing Confederate army had been brought to ground at Perryville."}]]}]]}]
38:["$","div","Four officers meet before battle",{"className":"moment","children":[["$","$L2d",null,{"seconds":1164,"label":"19:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Four officers meet before battle"}],["$","p",null,{"children":"Sheridan, James Jackson, William Terrill, and George Webster discussed the odds of all four being killed. Sheridan alone would survive the next day."}]]}]]}]
39:["$","div","Drought and heat punish both armies",{"className":"moment","children":[["$","$L2d",null,{"seconds":1225,"label":"20:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Drought and heat punish both armies"}],["$","p",null,{"children":"Most streams were dry, and the Confederates often emptied scarce water sources before the pursuing United States troops arrived."}]]}]]}]
3a:["$","div","The armies enter Kentucky’s historic triangle",{"className":"moment","children":[["$","$L2d",null,{"seconds":1279,"label":"21:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies enter Kentucky’s historic triangle"}],["$","p",null,{"children":"Harrodsburg, Danville, and Perryville lay roughly ten miles apart and formed the terrain on which the campaign would be decided."}]]}]]}]
3b:["$","div","Perryville’s roads converge",{"className":"moment","children":[["$","$L2d",null,{"seconds":1380,"label":"23:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Perryville’s roads converge"}],["$","p",null,{"children":"The small town connected directly with Harrodsburg, Danville, Lebanon, and Springfield, making it an important crossroads."}]]}]]}]
3c:["$","div","Residents flee the coming battle",{"className":"moment","children":[["$","$L2d",null,{"seconds":1438,"label":"23:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Residents flee the coming battle"}],["$","p",null,{"children":"Most civilians left during the night of October 7–8, although some remained and sheltered in cellars."}]]}]]}]
3d:["$","div","Hardee deploys west of town",{"className":"moment","children":[["$","$L2d",null,{"seconds":1456,"label":"24:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hardee deploys west of town"}],["$","p",null,{"children":"Buckner’s division held ground west of Perryville and Anderson’s division stood to the northwest as Polk assumed local command."}]]}]]}]
3e:["$","div","Peters Hill commands the creek",{"className":"moment","children":[["$","$L2d",null,{"seconds":1496,"label":"24:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"Peters Hill commands the creek"}],["$","p",null,{"children":"Liddell pushed the 7th Arkansas onto the height because it overlooked the Springfield Pike crossing and one of the area’s few usable water sources."}]]}]]}]
3f:["$","div","Polk takes command at Perryville",{"className":"moment","children":[["$","$L2d",null,{"seconds":1529,"label":"25:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Polk takes command at Perryville"}],["$","p",null,{"children":"About 16,000 Confederate soldiers were then in and around the town, with Cheatham’s division nearby on the Harrodsburg Pike."}]]}]]}]
40:["$","div","Sheridan focuses on Doctors Creek",{"className":"moment","children":[["$","$L2d",null,{"seconds":1538,"label":"25:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sheridan focuses on Doctors Creek"}],["$","p",null,{"children":"His thirsty 11th Division held the closest United States position and expected the next day to bring a battle."}]]}]]}]
41:["$","div","Daniel McCook receives the assignment",{"className":"moment","children":[["$","$L2d",null,{"seconds":1576,"label":"26:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Daniel McCook receives the assignment"}],["$","p",null,{"children":"Sheridan entrusted the creek and hill to the untested 36th Brigade, whose discipline and leadership had impressed him."}]]}]]}]
42:["$","div","The 52nd Ohio moves before dawn",{"className":"moment","children":[["$","$L2d",null,{"seconds":1626,"label":"27:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 52nd Ohio moves before dawn"}],["$","p",null,{"children":"McCook’s troops advanced under a nearly full moon, crossed Doctors Creek, and climbed Peters Hill."}]]}]]}]
43:["$","div","The infantry battle opens",{"className":"moment","children":[["$","$L2d",null,{"seconds":1644,"label":"27:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The infantry battle opens"}],["$","p",null,{"children":"The 7th Arkansas was surprised by the night advance and withdrew toward Bottom Hill after a short exchange of fire."}]]}]]}]
44:["$","div","McCook secures water and high ground",{"className":"moment","children":[["$","$L2d",null,{"seconds":1656,"label":"27:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCook secures water and high ground"}],["$","p",null,{"children":"Within about an hour, the United States brigade controlled Doctors Creek and Peters Hill, setting the stage for the main battle."}]]}]]}]
45:["$","div","The episode recommends Kenneth Noe",{"className":"moment","children":[["$","$L2d",null,{"seconds":1686,"label":"28:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode recommends Kenneth Noe"}],["$","p",null,{"children":"Perryville: This Grand Havoc of Battle provides a detailed account of the Kentucky campaign, the battle, and its aftermath."}]]}]]}]
46:["$","strong",null,{"children":"Right Wing, Army of Mississippi; local commander at Perryville"}]
47:["$","span",null,{"children":"Maj. Gen. Leonidas Polk"}]
48:["$","small",null,{"children":"Ordered the Bardstown retreat, brought Benjamin Cheatham’s division toward Perryville, and took command of roughly 16,000 Confederates there."}]
49:["$","div","Left Wing, Army of Mississippi-Maj. Gen. William J. Hardee",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing, Army of Mississippi"}],["$","span",null,{"children":"Maj. Gen. William J. Hardee"}],["$","small",null,{"children":"Withdrew from Bardstown under cavalry cover and halted his divisions under Simon B. Buckner and Patton Anderson around Perryville."}]]}]
4a:["$","div","Division, Polk’s Right Wing-Maj. Gen. Benjamin F. Cheatham",{"className":"command-entry","children":[["$","strong",null,{"children":"Division, Polk’s Right Wing"}],["$","span",null,{"children":"Maj. Gen. Benjamin F. Cheatham"}],["$","small",null,{"children":"Moved south on the Harrodsburg Pike to reinforce Hardee under Bragg’s order for the October 8 attack."}]]}]
4b:["$","div","Arkansas brigade, Buckner’s Division-Brig. Gen. St. John R. Liddell",{"className":"command-entry","children":[["$","strong",null,{"children":"Arkansas brigade, Buckner’s Division"}],["$","span",null,{"children":"Brig. Gen. St. John R. Liddell"}],["$","small",null,{"children":"Held Bottom Hill and posted the 7th Arkansas forward on Peters Hill to watch the Springfield Pike and Doctors Creek."}]]}]
4c:["$","div","Cavalry brigade-Col. Joseph Wheeler",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry brigade"}],["$","span",null,{"children":"Col. Joseph Wheeler"}],["$","small",null,{"children":"Covered Hardee’s withdrawal, checked United States cavalry at Pottsville, and drew back toward Perryville on October 7."}]]}]
