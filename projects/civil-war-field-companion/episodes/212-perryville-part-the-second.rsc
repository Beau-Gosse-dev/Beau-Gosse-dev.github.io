2b:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
2c:["$","small",null,{"children":"Controlled the Army of Mississippi and assumed authority over Edmund Kirby Smith’s Army of Kentucky, though the armies remained operationally divided."}]
2d:["$","div","Army of Kentucky-Maj. Gen. Edmund Kirby Smith",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Kentucky"}],["$","span",null,{"children":"Maj. Gen. Edmund Kirby Smith"}],["$","small",null,{"children":"Moved toward Frankfort for Bragg’s proposed concentration and later received orders to join the armies near Harrodsburg."}]]}]
2e:["$","div","Right Wing, Army of Mississippi; local commander at Perryville-Maj. Gen. Leonidas Polk",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing, Army of Mississippi; local commander at Perryville"}],["$","span",null,{"children":"Maj. Gen. Leonidas Polk"}],["$","small",null,{"children":"Ordered the Bardstown retreat, brought Benjamin Cheatham’s division toward Perryville, and took command of roughly 16,000 Confederates there."}]]}]
2f:["$","div","Left Wing, Army of Mississippi-Maj. Gen. William J. Hardee",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing, Army of Mississippi"}],["$","span",null,{"children":"Maj. Gen. William J. Hardee"}],["$","small",null,{"children":"Withdrew from Bardstown under cavalry cover and halted his divisions under Simon B. Buckner and Patton Anderson around Perryville."}]]}]
30:["$","div","Division, Polk’s Right Wing-Maj. Gen. Benjamin F. Cheatham",{"className":"command-entry","children":[["$","strong",null,{"children":"Division, Polk’s Right Wing"}],["$","span",null,{"children":"Maj. Gen. Benjamin F. Cheatham"}],["$","small",null,{"children":"Moved south on the Harrodsburg Pike to reinforce Hardee under Bragg’s order for the October 8 attack."}]]}]
31:["$","div","Arkansas brigade, Buckner’s Division-Brig. Gen. St. John R. Liddell",{"className":"command-entry","children":[["$","strong",null,{"children":"Arkansas brigade, Buckner’s Division"}],["$","span",null,{"children":"Brig. Gen. St. John R. Liddell"}],["$","small",null,{"children":"Held Bottom Hill and posted the 7th Arkansas forward on Peters Hill to watch the Springfield Pike and Doctors Creek."}]]}]
32:["$","div","Cavalry brigade-Col. Joseph Wheeler",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry brigade"}],["$","span",null,{"children":"Col. Joseph Wheeler"}],["$","small",null,{"children":"Covered Hardee’s withdrawal, checked United States cavalry at Pottsville, and drew back toward Perryville on October 7."}]]}]
