1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",212," · ","October 1–8, 1862"," · ","Central Kentucky from Louisville, Bardstown, and Frankfort to Harrodsburg, Danville, and Perryville; the episode ends at Peters Hill and Doctors Creek west of Perryville"]}],["$","h1",null,{"children":"PERRYVILLE (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Operational United States success leading into battle. Don Carlos Buell’s rapid advance forced the Confederates to abandon Bardstown and Frankfort, while Braxton Bragg’s faulty information and divided command delayed a coherent response. Bragg ordered Leonidas Polk to fight at Perryville as a temporary check before concentrating at Harrodsburg. Before dawn on October 8, Daniel McCook’s United States brigade drove the 7th Arkansas from Peters Hill and secured Doctors Creek. The main Battle of Perryville occurs after this episode’s narrative ends"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2497865123.mp3?updated=1695607469","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The march from Louisville and the opening clash at Perryville"}],["$","small",null,{"children":"The narrative begins with Buell’s October 1 advance, follows the Confederate withdrawals from Bardstown and Frankfort, and ends after the pre-dawn fight for Peters Hill on October 8."}]]}],["$","div","United States plan",{"children":[["$","span",null,{"children":"United States plan"}],["$","strong",null,{"children":"Four columns left Louisville on October 1"}],["$","small",null,{"children":"Joshua W. Sill demonstrated toward Frankfort while the columns under Alexander McCook, Thomas Crittenden, and Charles Gilbert moved southeast toward Bardstown on parallel roads."}]]}],["$","div","Campaign stakes",{"children":[["$","span",null,{"children":"Campaign stakes"}],["$","strong",null,{"children":"Confederates controlled most of Kentucky east of the Louisville and Nashville Railroad"}],["$","small",null,{"children":"Bragg and Edmund Kirby Smith also intended to install a Confederate state government at Frankfort, making a successful United States counteroffensive politically as well as militarily urgent."}]]}],["$","div","Green regiments",{"children":[["$","span",null,{"children":"Green regiments"}],["$","strong",null,{"children":"Inexperienced soldiers discarded equipment on the first march"}],["$","small",null,{"children":"Private Timothy Pendergrass of the 2nd Minnesota recalled roadside piles of boots, blankets, clothing, books, and other possessions abandoned by overloaded recruits."}]]}],["$","div","Failed Confederate reconnaissance",{"children":[["$","span",null,{"children":"Failed Confederate reconnaissance"}],"$Le","$Lf"]}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}],"$L25","$undefined","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c"]}]]}]
2d:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","strong",null,{"children":"Polk learned of Buell’s advance only on October 2"}]
f:["$","small",null,{"children":"Confederate cavalry mounts were worn down after weeks of campaigning, while newly equipped United States cavalry screened the four advancing columns."}]
10:["$","div","Bragg’s first misreading",{"children":[["$","span",null,{"children":"Bragg’s first misreading"}],["$","strong",null,{"children":"He treated Sill’s Frankfort movement as Buell’s main effort"}],["$","small",null,{"children":"Without cavalry close at hand to verify the reports, Bragg planned to use Kirby Smith as a blocking force west of Frankfort while Polk struck the United States flank and rear from Bardstown."}]]}]
11:["$","div","Polk’s dilemma",{"children":[["$","span",null,{"children":"Polk’s dilemma"}],["$","strong",null,{"children":"Bragg’s order pointed directly across McCook’s path"}],["$","small",null,{"children":"By October 3, Polk recognized that Buell’s main columns were converging on Bardstown. A move northeast through Bloomfield risked battle against McCook before the other United States columns could be held off."}]]}]
12:["$","div","Council of war",{"children":[["$","span",null,{"children":"Council of war"}],["$","strong",null,{"children":"Polk’s officers agreed to withdraw toward Harrodsburg"}],["$","small",null,{"children":"At Bardstown on October 3, Patton Anderson first argued for literal obedience but conceded that, absent Bragg’s order, retreat was the only realistic course. Polk chose the retreat because Bragg lacked current information."}]]}]
13:["$","div","A fugitive reaches the 21st Wisconsin",{"children":[["$","span",null,{"children":"A fugitive reaches the 21st Wisconsin"}],["$","strong",null,{"children":"The escaped man got away during a confrontation at Bloomfield"}],["$","small",null,{"children":"Colonel Benjamin Sweet refused to help three pursuers. Division commander Lovell Rousseau ordered the man returned, but the dispute escalated after soldiers drove Rousseau’s aide from camp with thrown corncobs."}]]}]
14:["$","div","Rousseau’s response",{"children":[["$","span",null,{"children":"Rousseau’s response"}],["$","strong",null,{"children":"The 21st Wisconsin was placed unarmed inside a hollow square"}],["$","small",null,{"children":"Rousseau threatened the men who had attacked his aide. Several soldiers stepped forward; after Sweet and his officers intervened, Rousseau released them, and the fugitive had meanwhile escaped."}]]}]
15:["$","div","Legal setting",{"children":[["$","span",null,{"children":"Legal setting"}],["$","strong",null,{"children":"Kentucky remained a slave state in the Union"}],["$","small",null,{"children":"The preliminary Emancipation Proclamation applied to states or parts of states in rebellion, not loyal Kentucky. The Bloomfield incident exposed a sharp conflict between military authority, slaveholders’ claims, and antislavery soldiers."}]]}]
16:["$","div","Bardstown evacuated",{"children":[["$","span",null,{"children":"Bardstown evacuated"}],["$","strong",null,{"children":"Polk and Hardee marched east on October 4"}],["$","small",null,{"children":"Their wings used separate roads no more than about ten miles apart, protecting one another and the Confederate supply depot at Camp Breckinridge, formerly Camp Dick Robinson."}]]}]
17:["$","div","Frankfort ceremony",{"children":[["$","span",null,{"children":"Frankfort ceremony"}],["$","strong",null,{"children":"Richard Hawes was installed as Confederate governor on October 4"}],["$","small",null,{"children":"Bragg proceeded despite appeals to postpone. Artillery from Sill’s approaching column interrupted the luncheon, and the Confederates abandoned Frankfort the same day."}]]}]
18:["$","div","One hundred hours",{"children":[["$","span",null,{"children":"One hundred hours"}],["$","strong",null,{"children":"Buell overturned the Confederate position in roughly four days"}],["$","small",null,{"children":"By October 4 the United States advance had recovered Bardstown and Frankfort and forced Bragg to search for a place to concentrate and fight."}]]}]
19:["$","div","Bragg’s intended concentration",{"children":[["$","span",null,{"children":"Bragg’s intended concentration"}],["$","strong",null,{"children":"Harrodsburg, not Perryville"}],["$","small",null,{"children":"Harrodsburg stood near the supply depot at Camp Breckinridge and at a road junction where Bragg expected his Army of Mississippi and Kirby Smith’s Army of Kentucky to unite."}]]}]
1a:["$","div","Perryville assignment",{"children":[["$","span",null,{"children":"Perryville assignment"}],["$","strong",null,{"children":"Polk was to strike, disengage, and return to Harrodsburg"}],["$","small",null,{"children":"After Hardee’s left wing halted around Perryville, Bragg sent Polk with Benjamin Cheatham’s division and ordered him to give battle on October 8, rout the pursuers, and then rejoin the planned concentration."}]]}]
1b:["$","div","Forces near Perryville",{"children":[["$","span",null,{"children":"Forces near Perryville"}],["$","strong",null,{"children":"About 16,000 Confederates by the night of October 7"}],["$","small",null,{"children":"Polk assumed local command. Hardee’s divisions under Simon B. Buckner and Patton Anderson held positions west and northwest of town while Cheatham arrived by the Harrodsburg Pike."}]]}]
1c:["$","div","Drought battlefield",{"children":[["$","span",null,{"children":"Drought battlefield"}],["$","strong",null,{"children":"Water shaped the opening movements"}],["$","small",null,{"children":"Most streams were dry or nearly dry after prolonged heat. Doctors Creek, although low, was one of the best nearby sources and lay between Sheridan’s soldiers and the Confederate position on Peters Hill."}]]}]
1d:["$","div","Perryville crossroads",{"children":[["$","span",null,{"children":"Perryville crossroads"}],["$","strong",null,{"children":"Four major roads met at a town of about 400 people"}],["$","small",null,{"children":"Roads linked Perryville to Harrodsburg, Danville, Lebanon, and Springfield. Smaller roads reached Mitchellsburg and Mackville, giving the hamlet operational importance beyond its size."}]]}]
1e:["$","div","Civilian flight",{"children":[["$","span",null,{"children":"Civilian flight"}],["$","strong",null,{"children":"Most residents left on the night of October 7–8"}],["$","small",null,{"children":"Some families sheltered in cellars, but many fled as the approaching armies transformed farms around the Chaplin River into a battlefield."}]]}]
1f:["$","div","Peters Hill",{"children":[["$","span",null,{"children":"Peters Hill"}],["$","strong",null,{"children":"High ground controlling the Springfield Pike and Doctors Creek"}],["$","small",null,{"children":"St. John R. Liddell sent the 7th Arkansas forward from Bottom Hill because Peters Hill commanded the approach and the pike crossed the creek immediately below it."}]]}]
20:["$","div","United States night advance",{"children":[["$","span",null,{"children":"United States night advance"}],["$","strong",null,{"children":"Daniel McCook’s 36th Brigade moved at about 3 a.m."}],["$","small",null,{"children":"Sheridan wanted full canteens before the expected battle and received permission to secure Doctors Creek and the hill. The 52nd Ohio led, with Illinois regiments supporting and in reserve."}]]}]
21:["$","div","Opening infantry clash",{"children":[["$","span",null,{"children":"Opening infantry clash"}],["$","strong",null,{"children":"The 7th Arkansas withdrew from Peters Hill"}],["$","small",null,{"children":"Caught by the night movement, the Arkansans exchanged a short, sharp fire and fell back to Bottom Hill. McCook’s soldiers held the creek and hill within roughly an hour."}]]}]
22:["$","div","Leaders soon lost",{"children":[["$","span",null,{"children":"Leaders soon lost"}],["$","strong",null,{"children":"Jackson, Terrill, and Webster fell later on October 8"}],["$","small",null,{"children":"The episode foreshadows the deaths of three of the four United States officers who met on October 7: Brig. Gen. James S. Jackson was killed; Brig. Gen. William R. Terrill and Col. George P. Webster were mortally wounded. Philip Sheridan survived."}]]}]
23:["$","div","Transcript corrections",{"children":[["$","span",null,{"children":"Transcript corrections"}],["$","strong",null,{"children":"Joshua W. Sill; Richard Hawes; Frankfort; Lovell Rousseau; Peters Hill; 85th Illinois; Cheatham’s division"}],["$","small",null,{"children":"The automated transcript gives “Silves,” “Richard Haw” or “Haas,” “Frankfurt,” “level Rousseau,” and “Peter’s Hill.” It also renders the 85th Illinois as the “86th” and calls the formation north on the Harrodsburg Pike “Buckner’s division of Polk’s right wing”; context and the order of battle identify it as Cheatham’s division."}]]}]
24:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"Perryville: This Grand Havoc of Battle"}],["$","small",null,{"children":"Kenneth W. Noe’s campaign and battle history is published by the University Press of Kentucky."}]]}]
25:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
26:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The opening struggle at Perryville",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep212-perryville-opening-map.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The opening struggle at Perryville at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep212-perryville-opening-map.svg","alt":"Schematic map showing Perryville, Doctors Creek, Peters Hill, Bottom Hill, Daniel McCook’s United States advance, and nearby Confederate divisions early on October 8, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The opening struggle at Perryville"}],["$","span",null,{"children":"North-up schematic of the positions west of Perryville during the night of October 7–8. Daniel McCook’s brigade crossed Doctors Creek from Sheridan’s bivouac, drove the 7th Arkansas from Peters Hill, and secured the water and high ground. Unit positions and road traces are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep212-perryville-opening-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Custom diagram based on J. B. Work’s Library of Congress battlefield map, Daniel McCook’s official report, and U.S. Army and National Park Service histories; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
27:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Buell’s four-column plan resumes",{"className":"moment","children":[["$","$L2d",null,{"seconds":72,"label":"1:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell’s four-column plan resumes"}],["$","p",null,{"children":"One column would demonstrate toward Frankfort while the other three advanced through Bardstown to force battle or threaten the Confederate line of communications."}]]}]]}],["$","div","The Army of the Ohio leaves Louisville",{"className":"moment","children":[["$","$L2d",null,{"seconds":96,"label":"1:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Ohio leaves Louisville"}],["$","p",null,{"children":"Buell’s counteroffensive began October 1, less than a week after the army reached and reorganized at Louisville."}]]}]]}],["$","div","Four roads carry the advance",{"className":"moment","children":[["$","$L2d",null,{"seconds":202,"label":"3:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Four roads carry the advance"}],["$","p",null,{"children":"Sill moved toward Frankfort; McCook, Crittenden, and Gilbert formed the left, center, and right of the main southeastward movement."}]]}]]}],["$","div","Buell surprises the Confederate cavalry",{"className":"moment","children":[["$","$L2d",null,{"seconds":289,"label":"4:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell surprises the Confederate cavalry"}],["$","p",null,{"children":"Worn mounts and effective United States screening kept Polk from learning of the advance until October 2."}]]}]]}],["$","div","Bragg misreads Sill’s demonstration",{"className":"moment","children":[["$","$L2d",null,{"seconds":318,"label":"5:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg misreads Sill’s demonstration"}],["$","p",null,{"children":"Bragg assumed Frankfort was Buell’s principal target and planned a concentration west of the capital without personally verifying the movement."}]]}]]}],["$","div","Polk faces an impossible order",{"className":"moment","children":[["$","$L2d",null,{"seconds":401,"label":"6:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Polk faces an impossible order"}],["$","p",null,{"children":"Bragg directed him through Bloomfield against Buell’s flank, but Polk saw that the main United States columns were already closing on Bardstown."}]]}]]}],["$","div","Polk convenes a council of war",{"className":"moment","children":[["$","$L2d",null,{"seconds":475,"label":"7:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Polk convenes a council of war"}],["$","p",null,{"children":"His officers concluded that Bragg lacked current information and agreed the Army of Mississippi should withdraw east toward Harrodsburg."}]]}]]}],["$","div","The retreat order is issued",{"className":"moment","children":[["$","$L2d",null,{"seconds":547,"label":"9:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"The retreat order is issued"}],["$","p",null,{"children":"Polk chose to ignore Bragg’s operational direction and evacuate Bardstown before Buell’s converging columns could trap him."}]]}]]}],["$","div","A fugitive enters the 21st Wisconsin camp",{"className":"moment","children":[["$","$L2d",null,{"seconds":592,"label":"9:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"A fugitive enters the 21st Wisconsin camp"}],["$","p",null,{"children":"Three pursuers demanded the escaped man’s return, but Colonel Benjamin Sweet refused to assist them."}]]}]]}],["$","div","Rousseau orders the man returned",{"className":"moment","children":[["$","$L2d",null,{"seconds":631,"label":"10:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rousseau orders the man returned"}],["$","p",null,{"children":"The division commander’s order led to a confrontation in which Wisconsin soldiers drove his aide from camp with thrown corncobs."}]]}]]}],["$","div","Rousseau forms a hollow square",{"className":"moment","children":[["$","$L2d",null,{"seconds":662,"label":"11:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rousseau forms a hollow square"}],["$","p",null,{"children":"He placed the unarmed 21st Wisconsin inside the rest of Starkweather’s armed brigade and demanded that the men responsible step forward."}]]}]]}],"$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45"]}]]}]
28:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States — Army of the Ohio",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States — Army of the Ohio"}],[["$","div","Army of the Ohio-Maj. Gen. Don Carlos Buell",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Ohio"}],["$","span",null,{"children":"Maj. Gen. Don Carlos Buell"}],["$","small",null,{"children":"Directed the four-column advance from Louisville and accompanied Gilbert’s central column; Maj. Gen. George H. Thomas served as second in command."}]]}],["$","div","I Corps-Maj. Gen. Alexander McD. McCook",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps"}],["$","span",null,{"children":"Maj. Gen. Alexander McD. McCook"}],["$","small",null,{"children":"Commanded the left column from Louisville; included Lovell Rousseau’s 3rd Division and James S. Jackson’s 10th Division."}]]}],["$","div","II Corps-Maj. Gen. Thomas L. Crittenden",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps"}],["$","span",null,{"children":"Maj. Gen. Thomas L. Crittenden"}],["$","small",null,{"children":"Commanded the southern column on roads through and beyond Bardstown."}]]}],["$","div","III Corps-Maj. Gen. Charles C. Gilbert",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps"}],["$","span",null,{"children":"Maj. Gen. Charles C. Gilbert"}],["$","small",null,{"children":"Commanded the central pursuit toward Perryville, including Philip Sheridan’s 11th Division."}]]}],["$","div","11th Division, III Corps-Brig. Gen. Philip H. Sheridan",{"className":"command-entry","children":[["$","strong",null,{"children":"11th Division, III Corps"}],["$","span",null,{"children":"Brig. Gen. Philip H. Sheridan"}],["$","small",null,{"children":"Held the Springfield Pike approach west of Perryville and ordered Daniel McCook to secure Doctors Creek and Peters Hill."}]]}],["$","div","36th Brigade, 11th Division-Col. Daniel McCook Jr.",{"className":"command-entry","children":[["$","strong",null,{"children":"36th Brigade, 11th Division"}],["$","span",null,{"children":"Col. Daniel McCook Jr."}],["$","small",null,{"children":"Led the pre-dawn advance by the 52nd Ohio, 85th Illinois, and 125th Illinois that opened the infantry fighting."}]]}],["$","div","Detached 2nd Division-Brig. Gen. Joshua W. Sill",{"className":"command-entry","children":[["$","strong",null,{"children":"Detached 2nd Division"}],["$","span",null,{"children":"Brig. Gen. Joshua W. Sill"}],["$","small",null,{"children":"Demonstrated toward Frankfort, drove out the Confederate political ceremony, and then moved south to rejoin Buell."}]]}]]]}],["$","section","Confederacy — Kentucky campaign forces",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy — Kentucky campaign forces"}],[["$","div","Overall command in Kentucky-Gen. Braxton Bragg",{"className":"command-entry","children":[["$","strong",null,{"children":"Overall command in Kentucky"}],["$","span",null,{"children":"Gen. Braxton Bragg"}],["$","small",null,{"children":"Controlled the Army of Mississippi and assumed authority over Edmund Kirby Smith’s Army of Kentucky, though the armies remained operationally divided."}]]}],["$","div","Army of Kentucky-Maj. Gen. Edmund Kirby Smith",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Kentucky"}],["$","span",null,{"children":"Maj. Gen. Edmund Kirby Smith"}],["$","small",null,{"children":"Moved toward Frankfort for Bragg’s proposed concentration and later received orders to join the armies near Harrodsburg."}]]}],["$","div","Right Wing, Army of Mississippi; local commander at Perryville-Maj. Gen. Leonidas Polk",{"className":"command-entry","children":["$L46","$L47","$L48"]}],"$L49","$L4a","$L4b","$L4c"]]}]]}],"$L4d","$L4e"]}]
29:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. James S. Jackson",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brig. Gen. James S. Jackson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 10th Division, I Corps","."]}]," ","Killed in the main battle on October 8. The episode foreshadows his death after describing his meeting with Sheridan, Terrill, and Webster the night before."]}]]}],["$","article","Brig. Gen. William R. Terrill",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brig. Gen. William R. Terrill"}],["$","p",null,{"children":[["$","strong",null,{"children":["33rd Brigade commander, 10th Division, I Corps","."]}]," ","Mortally wounded by shell fragments during the main battle and died that night. He was one of the three officers from the October 7 meeting who did not survive."]}]]}],["$","article","Col. George P. Webster",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Col. George P. Webster"}],["$","p",null,{"children":[["$","strong",null,{"children":["34th Brigade commander, 10th Division, I Corps","."]}]," ","Mortally wounded during the main battle and died soon afterward. Sheridan was the sole survivor of the four officers who met on the eve of battle."]}]]}]]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep212-perryville-opening-map.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep212-perryville-opening-map.svg","alt":"Schematic map of the pre-dawn United States advance across Doctors Creek to Peters Hill west of Perryville.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Control of scarce water drew Sheridan’s 11th Division forward. Daniel McCook’s green brigade crossed Doctors Creek and displaced the 7th Arkansas from Peters Hill before daylight."}]]}],["$","figure","/images/ep212-historic-perryville-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep212-historic-perryville-map.jpg","alt":"Historic map of the Perryville battlefield showing roads, streams, farms, terrain, and troop positions on October 7 and 8, 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"J. B. Work’s map distinguishes positions on the evening of October 7, before engagement, during battle, after dark, and in reserve. It also records roads, watercourses, farm names, and relief."}]]}],["$","figure","/images/ep212-don-carlos-buell.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep212-don-carlos-buell.jpg","alt":"Nineteenth-century head-and-shoulders portrait of United States Major General Don Carlos Buell.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Buell recovered operational momentum quickly at Louisville, sending the Army of the Ohio out in four columns on October 1."}]]}],["$","figure","/images/ep212-braxton-bragg.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep212-braxton-bragg.jpg","alt":"Carte-de-visite portrait of Confederate General Braxton Bragg in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Bragg concentrated on Frankfort’s political ceremony while his field information deteriorated; he still expected the decisive concentration to occur at Harrodsburg."}]]}],["$","figure","/images/ep212-philip-sheridan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep212-philip-sheridan.jpg","alt":"Nineteenth-century lithographic portrait of United States General Philip H. Sheridan in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Sheridan ordered Daniel McCook’s 36th Brigade forward to secure Doctors Creek and Peters Hill. Of the four officers who met on October 7, Sheridan alone survived the battle."}]]}]]}]]}]
