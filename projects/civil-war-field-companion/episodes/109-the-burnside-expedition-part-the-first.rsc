d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",109," · ","August 1861–March 11, 1862; main battle February 7–8, 1862"," · ","Hatteras Inlet, Pamlico Sound, Croatan Sound, and Roanoke Island, North Carolina"]}],["$","h1",null,{"children":"THE BURNSIDE EXPEDITION (Part the First)"}],["$","span",null,{"className":"result-label","children":"United States Army and Navy forces captured Roanoke Island on February 8, 1862. Burnside landed about 7,500 soldiers south of the Confederate forts, attacked the central road redoubt, and sent brigades through the swamps around both flanks. Colonel Henry Shaw surrendered the island and about 2,675 men. The victory opened Albemarle Sound and eastern North Carolina to further United States operations"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"August 1861–March 11, 1862; main battle February 7–8, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Hatteras Inlet, Pamlico Sound, Croatan Sound, and Roanoke Island, North Carolina"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"United States Army and Navy forces captured Roanoke Island on February 8, 1862. Burnside landed about 7,500 soldiers south of the Confederate forts, attacked the central road redoubt, and sent brigades through the swamps around both flanks. Colonel Henry Shaw surrendered the island and about 2,675 men. The victory opened Albemarle Sound and eastern North Carolina to further United States operations"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Burnside expedition",{"children":[["$","th",null,{"scope":"row","children":"Burnside expedition"}],["$","td",null,{"children":["More than 15,000 soldiers and over 80 vessels assembled","$undefined"]}]]}],["$","tr","United States troops landed",{"children":["$Lf","$L10"]}],"$L11","$L12"]}]]}],"$L13"]}],"$undefined"]}],"$L14","$L15","$L16",false,"$L17",false,"$L18","$L19","$L1a","$L1b"]}]]}]
