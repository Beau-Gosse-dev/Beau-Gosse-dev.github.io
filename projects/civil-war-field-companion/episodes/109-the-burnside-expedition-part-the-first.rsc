1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",109," · ","August 1861–March 11, 1862; main battle February 7–8, 1862"," · ","Hatteras Inlet, Pamlico Sound, Croatan Sound, and Roanoke Island, North Carolina"]}],["$","h1",null,{"children":"THE BURNSIDE EXPEDITION (Part the First)"}],["$","span",null,{"className":"result-label","children":"United States Army and Navy forces captured Roanoke Island on February 8, 1862. Burnside landed about 7,500 soldiers south of the Confederate forts, attacked the central road redoubt, and sent brigades through the swamps around both flanks. Colonel Henry Shaw surrendered the island and about 2,675 men. The victory opened Albemarle Sound and eastern North Carolina to further United States operations"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2700280289.mp3?updated=1695129284","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Roanoke Island",{"children":[["$","span",null,{"children":"Roanoke Island"}],["$","strong",null,{"children":"About 12 miles long and 3 miles wide"}],"$undefined"]}],["$","div","Burnside expedition",{"children":[["$","span",null,{"children":"Burnside expedition"}],["$","strong",null,{"children":"More than 15,000 soldiers and over 80 vessels assembled"}],"$undefined"]}],["$","div","United States troops landed",{"children":[["$","span",null,{"children":"United States troops landed"}],["$","strong",null,{"children":"About 7,500 by midnight on February 7"}],"$undefined"]}],["$","div","Confederate defenders",{"children":[["$","span",null,{"children":"Confederate defenders"}],["$","strong",null,{"children":"About 2,500–3,000 on the island"}],"$undefined"]}],["$","div","Confederate fixed defenses",{"children":[["$","span",null,{"children":"Confederate fixed defenses"}],["$","strong",null,{"children":"Three coastal forts, one central road redoubt, and the floating Fort Forrest"}],"$undefined"]}],["$","div","United States losses stated in episode",{"children":[["$","span",null,{"children":"United States losses stated in episode"}],["$","strong",null,{"children":"Army: 37 killed, 214 wounded; Navy: 3 killed, 11 wounded"}],"$undefined"]}],["$","div","Confederate losses stated in episode",{"children":[["$","span",null,{"children":"Confederate losses stated in episode"}],["$","strong",null,{"children":"23 killed, 58 wounded, 2,675 captured"}],"$undefined"]}],["$","div","Result",{"children":[["$","span",null,{"children":"Result"}],["$","strong",null,{"children":"United States victory; Roanoke Island and access to Albemarle Sound secured"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Im