1d:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The expedition’s next objectives"}],["$","span",null,{"children":"After Roanoke Island, Burnside planned to move south across Pamlico Sound to New Bern, then take Fort Macon at Beaufort. These operations threatened the coast and the rail connections supporting Confederate forces in Virginia."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
