12:["$","figure","The expedition’s next objectives",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.35%2C34.55%2C-75.15%2C36.20&layer=mapnik&marker=35.108%2C-77.044","title":"The expedition’s next objectives","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The expedition’s next objectives"}],["$","span",null,{"children":"After Roanoke Island, Burnside planned to move south across Pamlico Sound to New Bern, then take Fort Macon at Beaufort. These operations threatened the coast and the rail connections supporting Confederate forces in Virginia."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
