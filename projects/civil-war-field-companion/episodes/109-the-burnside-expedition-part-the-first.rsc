13:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.libsyn.com/109-the-burnside-expedition-part-the-first",{"href":"https://civilwarpodcast.libsyn.com/109-the-burnside-expedition-part-the-first","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 109"]}],["$","a","https://home.nps.gov/fora/learn/historyculture/battleofroanokeisland.htm",{"href":"https://home.nps.gov/fora/learn/historyculture/battleofroanokeisland.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of Roanoke Island"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=nc002",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=nc002","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Roanoke Island battle summary"]}],["$","a","https://www.nps.gov/people/thomas-robinson.htm",{"href":"https://www.nps.gov/people/thomas-robinson.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Thomas Robinson"]}],["$","a","https://www.history.navy.mil/research/library/online-reading-room/title-list-alphabetically/n/navy-civil-war-chronology.html",{"href":"https://www.history.navy.mil/research/library/online-reading-room/title-list-alphabetically/n/navy-civil-war-chronology.html","target":"_blank","rel":"noreferrer","children":[" · ","Naval History and Heritage Command: Navy Civil War chronology"]}],["$","a","https://www.history.navy.mil/our-collections/photography/wars-and-events/the-american-civil-war--1861-1865/north-carolina-sounds/burnside-expedition-to-new-bern--february-1862.html",{"href":"https://www.history.navy.mil/our-collections/photography/wars-and-events/the-american-civil-war--1861-1865/north-carolina-sounds/burnside-expedition-to-new-bern--february-1862.html","target":"_blank","rel":"noreferrer","children":[" · ","Naval History and Heritage Command: Burnside expedition images"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00070/",{"href":"https://www.loc.gov/item/gvhs01.vhs00070/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Plan of the Battle of Roanoke Island"]}],["$","a","https://www.loc.gov/pictures/item/2003655799/",{"href":"https://www.loc.gov/pictures/item/2003655799/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Burnside expedition landing"]}],["$","a","https://www.loc.gov/pictures/item/90714196/",{"href":"https://www.loc.gov/pictures/item/90714196/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Capture of Roanoke Island"]}]]}]
