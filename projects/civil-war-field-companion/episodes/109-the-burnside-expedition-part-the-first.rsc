f:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The North Carolina sounds"}],["$","span",null,{"children":"Roanoke Island separates Croatan Sound from Roanoke Sound and stands between Pamlico Sound to the south and Albemarle Sound to the north. Hatteras Inlet gave Burnside an entrance from the Atlantic."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]
10:["$","figure","Roanoke Island today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-75.82%2C35.75%2C-75.49%2C36.05&layer=mapnik&marker=35.891%2C-75.661","title":"Roanoke Island today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Roanoke Island today"}],["$","span",null,{"children":"The expedition landed near Ashby’s Harbor on the west side of the island, moved north along the only main road, and encountered the Confederate earthwork at the island’s narrow center."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
