2c:["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Concentrated against Pope, attempted to turn the Federal left at the Rapidan, and approved Stuart’s Catlett Station raid"}]]}],["$","div","Right Wing-Maj. Gen. James Longstreet",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Covered the lower Rappahannock crossings and directed the artillery and infantry pressure at Rappahannock Station"}]]}],["$","div","Left Wing-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Moved from Rappahannock Station to the upper crossings and attempted to hold Ewell’s bridgehead at White Sulphur Springs"}]]}],["$","div","Division, Jackson’s wing-Maj. Gen. Richard S. Ewell",{"className":"command-entry","children":[["$","strong",null,{"children":"Division, Jackson’s wing"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Sent the 13th Georgia and Jubal Early across the river, then withdrew Early and Lawton before dawn on August 24"}]]}],["$","div","Brigade, Ewell’s division-Brig. Gen. Isaac R. Trimble",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Isaac R. Trimble"}],["$","small",null,{"children":"Served as Jackson’s rear guard near Freeman’s Ford and counterattacked Bohlen’s Federal detachment"}]]}],["$","div","Texas Brigade, Longstreet’s wing-Brig. Gen. John Bell Hood",{"className":"command-entry","children":[["$","strong",null,{"children":"Texas Brigade, Longstreet’s wing"}],["$","span",null,{"children":"Brig. Gen. John Bell Hood"}],["$","small",null,{"children":"Arrived as Longstreet relieved Jackson near Freeman’s Ford and joined the attack that drove Bohlen’s troops back across the river"}]]}],["$","div","Brigade, Ewell’s division-Brig. Gen. Jubal A. Early",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Jubal A. Early"}],["$","small",null,{"children":"Crossed near White Sulphur Springs, organized the flood-isolated bridgehead, and reported that his exhausted force faced superior numbers"}]]}],["$","div","Brigade, Ewell’s division-Brig. Gen. Alexander R. Lawton",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Ewell’s division"}],["$","span",null,{"children":"Brig. Gen. Alexander R. Lawton"}],["$","small",null,{"children":"The 13th Georgia made the first ford crossing; the rest of the brigade reinforced Early after the bridge was rebuilt"}]]}],["$","div","Cavalry Division-Maj. Gen. J. E. B. Stuart",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry Division"}],["$","span",null,{"children":"Maj. Gen. J. E. B. Stuart"}],["$","small",null,{"children":"Led about 1,500 cavalrymen around Pope’s right to Catlett Station, including elements of the 1st, 9th, and 11th Virginia Cavalry"}]]}]]]}]
