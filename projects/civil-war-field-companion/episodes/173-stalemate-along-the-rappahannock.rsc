1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",173," · ","August 18–24, 1862"," · ","The Rapidan and Rappahannock river corridors from Culpeper and Gordonsville to Freeman’s Ford, White Sulphur Springs, Rappahannock Station, Warrenton, and Catlett Station in central and northern Virginia"]}],["$","h1",null,{"children":"STALEMATE ALONG THE RAPPAHANNOCK"}],["$","span",null,{"className":"result-label","children":"Indecisive along the Rappahannock. Pope escaped Lee’s planned turning movement at the Rapidan and held the north and east bank of the Rappahannock. Confederate probes did not establish a permanent crossing, but Stuart’s raid captured intelligence that confirmed Pope’s dispositions and the approaching Federal reinforcements, helping Lee plan the next phase of the Northern Virginia Campaign"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8769699178.mp3?updated=1695419279","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Lee’s advance from the Rapidan, the August 21–23 actions along the Rappahannock, and Stuart’s Catlett Station raid"}],["$","small",null,{"children":"The episode follows the armies from the immediate aftermath of Cedar Mountain through the recovery of Ewell’s flood-isolated bridgehead before dawn on August 24."}]]}],["$","div","Strategic deadline",{"children":[["$","span",null,{"children":"Strategic deadline"}],["$","strong",null,{"children":"Defeat Pope before the Army of the Potomac could reinforce him"}],["$","small",null,{"children":"McClellan’s withdrawal from the Peninsula freed Lee to concentrate against Pope, but the same movement meant that Federal reinforcements would soon arrive in northern Virginia."}]]}],["$","div","Confederate concentration",{"children":[["$","span",null,{"children":"Confederate concentration"}],["$","strong",null,{"children":"Longstreet joined Jackson near Gordonsville; Lee arrived August 15"}],["$","small",null,{"children":"Lee left a smaller force under Gustavus W. Smith to protect Richmond and took direct command of the field army assembled south of Pope."}]]}],["$","div","Lee’s first plan",{"children":[["$","span",null,{"children":"Lee’s first plan"}],["$","strong",null,{"children":"Turn Pope’s left and get between the Army of Virginia and Washington"}],["$","small",null,{"children":"Lee selected an eastward movement across the Rapidan rather than Longstreet’s proposed movement around Pope’s right. The intended attack date slipped from August 18 to August 20."}]]}],["$","div","Captured Confederate orders",{"children":[["$","span",null,{"children":"Captured Confederate orders"}],["$","strong",null,{"children":"Federal cavalry obtained Lee’s advance orders on August 18"}],["$","small",null,{"children":"A Federal patrol surprised Stuart’s headquarters. Stuart escaped, but his adjutant, Maj. Norman R. Fitzhugh, and a copy of Lee’s orders were captured."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}],"$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
2d:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Pope’s response",{"children":[["$","span",null,{"children":"Pope’s response"}],["$","strong",null,{"children":"Withdraw behind the Rappahannock"}],["$","small",null,{"children":"Pope informed Halleck shortly after noon on August 18, kept campfires burning that night, and began a concealed movement northeast before midnight."}]]}]
f:["$","div","Withdrawal completed",{"children":[["$","span",null,{"children":"Withdrawal completed"}],["$","strong",null,{"children":"The Army of Virginia was across by noon on August 20"}],["$","small",null,{"children":"The night movement was confused and unpopular in the ranks, but Lee did not discover it until Federal columns and wagon dust were observed from Clark’s Mountain on August 19."}]]}]
10:["$","div","Rappahannock barrier",{"children":[["$","span",null,{"children":"Rappahannock barrier"}],["$","strong",null,{"children":"Kelly’s Ford, Rappahannock Station, Beverly Ford, Freeman’s Ford, and White Sulphur Springs were the principal contested crossings"}],["$","small",null,{"children":"Pope strongly guarded the accessible lower and central crossings while maintaining communications toward Manassas Junction and Fredericksburg."}]]}]
11:["$","div","Opposing movements on August 20",{"children":[["$","span",null,{"children":"Opposing movements on August 20"}],["$","strong",null,{"children":"Longstreet moved toward Kelly’s Ford; Jackson moved toward Rappahannock Station"}],["$","small",null,{"children":"Heat and dust slowed Jackson, and the full Confederate army did not reach the river line until August 21."}]]}]
12:["$","div","Freeman’s Ford probe",{"children":[["$","span",null,{"children":"Freeman’s Ford probe"}],["$","strong",null,{"children":"Bohlen’s three-regiment Federal force crossed after Confederate guns fell silent"}],["$","small",null,{"children":"Sigel sent Brig. Gen. Henry Bohlen across to investigate. Isaac R. Trimble’s concealed brigade attacked, and John Bell Hood’s arriving brigade joined the action."}]]}]
13:["$","div","Freeman’s Ford result",{"children":[["$","span",null,{"children":"Freeman’s Ford result"}],["$","strong",null,{"children":"The Federal force was routed back across the river"}],["$","small",null,{"children":"Bohlen was killed. Men were shot while retreating or drowned while trying to recross the river. Jackson had already begun shifting his main force farther upriver."}]]}]
14:["$","div","White Sulphur Springs crossing",{"children":[["$","span",null,{"children":"White Sulphur Springs crossing"}],["$","strong",null,{"children":"Ewell established a bridgehead late on August 22"}],["$","small",null,{"children":"The 13th Georgia crossed the ford under artillery cover at about 4 p.m.; Jubal Early’s brigade crossed an old dam about a mile downstream."}]]}]
15:["$","div","Flood-isolated bridgehead",{"children":[["$","span",null,{"children":"Flood-isolated bridgehead"}],["$","strong",null,{"children":"A severe rainstorm made the Rappahannock impassable"}],["$","small",null,{"children":"The sudden rise stranded Early and the 13th Georgia on Pope’s side of the river and also prevented Pope from crossing elsewhere to attack Jackson’s rear."}]]}]
16:["$","div","Pope’s countermove",{"children":[["$","span",null,{"children":"Pope’s countermove"}],["$","strong",null,{"children":"March north against the isolated Confederates"}],["$","small",null,{"children":"On August 23 Pope sent his army toward White Sulphur Springs, trusting the flood to prevent Longstreet from crossing against his rear. Rain and mud delayed Milroy’s brigade and Buford’s cavalry until late in the day."}]]}]
17:["$","div","Bridgehead recovered",{"children":[["$","span",null,{"children":"Bridgehead recovered"}],["$","strong",null,{"children":"Early and Lawton withdrew before dawn on August 24"}],["$","small",null,{"children":"Jackson’s engineers rebuilt a bridge on August 23. Jackson initially reinforced the north-bank position, but Ewell inspected it and removed the exhausted troops during the night."}]]}]
18:["$","div","Rappahannock Station bridgehead",{"children":[["$","span",null,{"children":"Rappahannock Station bridgehead"}],["$","strong",null,{"children":"Hartsuff’s brigade held the south-bank approaches to the railroad bridge"}],["$","small",null,{"children":"Pope had kept the bridge intact as a possible route back across the river. Its defense required a Federal position on the Confederate side."}]]}]
19:["$","div","Artillery duel",{"children":[["$","span",null,{"children":"Artillery duel"}],["$","strong",null,{"children":"Nearly 50 Confederate guns opened on August 23"}],["$","small",null,{"children":"Federal batteries answered from the north bank. The episode describes the exchange as one of the largest artillery duels fought to that point in the war."}]]}]
1a:["$","div","Railroad bridge destroyed",{"children":[["$","span",null,{"children":"Railroad bridge destroyed"}],["$","strong",null,{"children":"The burning span collapsed around noon on August 23"}],["$","small",null,{"children":"Hartsuff withdrew under Pope’s orders. Brig. Gen. Zealous B. Tower’s rear guard first tried artillery fire, then set the bridge ablaze as Confederate infantry approached."}]]}]
1b:["$","div","Stuart’s raiding force",{"children":[["$","span",null,{"children":"Stuart’s raiding force"}],["$","strong",null,{"children":"About 1,500 selected cavalrymen"}],["$","small",null,{"children":"Lee approved Stuart’s proposal on August 22. The 1st and 11th Virginia Cavalry moved against Catlett Station while the 9th Virginia sought Pope’s headquarters baggage."}]]}]
1c:["$","div","Catlett Station objective",{"children":[["$","span",null,{"children":"Catlett Station objective"}],["$","strong",null,{"children":"Burn the Orange and Alexandria Railroad bridge over Cedar Run"}],["$","small",null,{"children":"Destroying the bridge could have cut Pope’s principal supply line and forced him to leave the Rappahannock. Rain-soaked timbers would not burn."}]]}]
1d:["$","div","Catlett Station intelligence",{"children":[["$","span",null,{"children":"Catlett Station intelligence"}],["$","strong",null,{"children":"Pope’s dispatch book was captured"}],["$","small",null,{"children":"The papers included marching orders, formation strengths, unit locations, and information about the approach of Army of the Potomac reinforcements."}]]}]
1e:["$","div","Operational effect of the raid",{"children":[["$","span",null,{"children":"Operational effect of the raid"}],["$","strong",null,{"children":"Confirmation that Lee’s opportunity was closing"}],["$","small",null,{"children":"The captured papers largely confirmed what Confederate commanders already suspected: Pope’s right was vulnerable, but Federal reinforcements would soon alter the balance."}]]}]
1f:["$","div","Campaign result through August 24",{"children":[["$","span",null,{"children":"Campaign result through August 24"}],["$","strong",null,{"children":"Neither army forced a decisive crossing"}],["$","small",null,{"children":"Pope blocked the principal crossings, and Jackson’s temporary bridgehead was withdrawn. Lee next chose a wider turning movement around Pope’s right."}]]}]
20:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The Second Bull Run Campaign: July–August 1862” by David G. Martin"}],["$","small",null,{"children":"The hosts recommend the volume as an introduction to the campaign and note its extended sidebars on people, places, events, and units."}]]}]
21:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Gordonsville, Rapidan, Rappahannock, Franz Sigel, Henry Bohlen, Richard S. Ewell, George L. Hartsuff, Zealous B. Tower, and J. E. B. Stuart"}],["$","small",null,{"children":"The automated transcript produces forms including “Gordon’sville,” “Siegel,” “Boland,” “Yule,” “Hearts of,” “Zellis,” and “Stewart.”"}]]}]
22:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
23:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The Rapidan-to-Rappahannock campaign corridor",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep173-regional-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The Rapidan-to-Rappahannock campaign corridor at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep173-regional-context.svg","alt":"Generalized map of central and northern Virginia showing Pope’s withdrawal from the Rapidan to the Rappahannock and the railroad corridor toward Washington.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Rapidan-to-Rappahannock campaign corridor"}],["$","span",null,{"children":"Pope withdrew northeast from the Rapidan and Culpeper to the Rappahannock while Lee followed from the Gordonsville area. The Orange and Alexandria Railroad connected Rappahannock Station and Catlett Station to Manassas Junction, Alexandria, and Washington. Rivers, routes, locations, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep173-regional-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History, National Park Service, John Pope campaign map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Crossings and troop movements along the Rappahannock",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep173-river-operations.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Crossings and troop movements along the Rappahannock at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep173-river-operations.svg","alt":"Schematic operational map of Federal and Confederate positions and movements at the Rappahannock crossings from August 21 through 23, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Crossings and troop movements along the Rappahannock"}],["$","span",null,{"children":"Federal forces held the north and east bank while Confederate forces occupied the south and west bank. The diagram shows Bohlen’s failed crossing at Freeman’s Ford, Ewell’s flood-isolated bridgehead at White Sulphur Springs, the Rappahannock Station artillery duel, and Stuart’s route toward Catlett Station. Arrows and formation boxes show generalized relationships rather than exact routes, times, frontages, or unit geometry. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep173-river-operations.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2a"]}]]}],"$undefined"]}]]}],"$L2b","$L2c"]}]]}]
24:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The road to Second Manassas is reviewed",{"className":"moment","children":[["$","$L2d",null,{"seconds":29,"label":"0:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The road to Second Manassas is reviewed"}],["$","p",null,{"children":"The episode places the Rappahannock operations between Cedar Mountain and the two-day battle at Second Manassas."}]]}]]}],["$","div","The strategic setting after the Seven Days",{"className":"moment","children":[["$","$L2d",null,{"seconds":103,"label":"1:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"The strategic setting after the Seven Days"}],["$","p",null,{"children":"McClellan remains at Harrison’s Landing while Pope’s new Army of Virginia operates in northern Virginia."}]]}]]}],["$","div","Lee faces two Federal armies",{"className":"moment","children":[["$","$L2d",null,{"seconds":353,"label":"5:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee faces two Federal armies"}],["$","p",null,{"children":"Lee cannot ignore McClellan near Richmond, but Pope’s movement against Confederate rail lines requires a response."}]]}]]}],["$","div","Cedar Mountain changes the local balance",{"className":"moment","children":[["$","$L2d",null,{"seconds":403,"label":"6:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cedar Mountain changes the local balance"}],["$","p",null,{"children":"A. P. Hill’s arrival lets Jackson defeat Banks on August 9, but Jackson retires when more of Pope’s army approaches."}]]}]]}],["$","div","The Peninsula withdrawal opens Lee’s opportunity",{"className":"moment","children":[["$","$L2d",null,{"seconds":478,"label":"7:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Peninsula withdrawal opens Lee’s opportunity"}],["$","p",null,{"children":"Halleck’s order to remove the Army of the Potomac frees Lee to reinforce Jackson and move north against Pope."}]]}]]}],["$","div","Army of the Potomac units leave slowly",{"className":"moment","children":[["$","$L2d",null,{"seconds":603,"label":"10:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Army of the Potomac units leave slowly"}],["$","p",null,{"children":"McClellan receives the withdrawal order on August 3; the first units leave on August 14, and McClellan departs on August 23."}]]}]]}],["$","div","Lee identifies a window against Pope",{"className":"moment","children":[["$","$L2d",null,{"seconds":685,"label":"11:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee identifies a window against Pope"}],["$","p",null,{"children":"Reports that McClellan is withdrawing lead Lee to send Longstreet’s ten brigades toward Jackson on August 13."}]]}]]}],["$","div","Lee joins the concentration",{"className":"moment","children":[["$","$L2d",null,{"seconds":819,"label":"13:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee joins the concentration"}],["$","p",null,{"children":"Lee arrives near Gordonsville on August 15 and assumes direct control over Longstreet and Jackson."}]]}]]}],["$","div","Lee selects a movement around Pope’s left",{"className":"moment","children":[["$","$L2d",null,{"seconds":850,"label":"14:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee selects a movement around Pope’s left"}],["$","p",null,{"children":"The plan calls for an east-northeast march across the Rapidan to sever Pope’s connection with Washington."}]]}]]}],["$","div","The Confederate advance is delayed",{"className":"moment","children":[["$","$L2d",null,{"seconds":919,"label":"15:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate advance is delayed"}],["$","p",null,{"children":"Difficulties with the cavalry postpone the movement, first intended to support an August 18 attack."}]]}]]}],["$","div","Federal cavalry surprises Stuart",{"className":"moment","children":[["$","$L2d",null,{"seconds":936,"label":"15:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal cavalry surprises Stuart"}],["$","p",null,{"children":"Stuart escapes, but the patrol captures his adjutant and a copy of Lee’s orders for the movement against Pope."}]]}]]}],"$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51"]}]]}]
25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. John Pope"}],["$","small",null,{"children":"Directed the withdrawal from the Rapidan, held the Rappahannock line, and ordered the August 23 concentration against Jackson’s isolated bridgehead"}]]}],["$","div","I Corps, Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Franz Sigel"}],["$","small",null,{"children":"Guarded the upper Rappahannock crossings; sent Henry Bohlen’s brigade across Freeman’s Ford and later moved against White Sulphur Springs"}]]}],["$","div","3rd Division, I Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division, I Corps"}],["$","span",null,{"children":"Brig. Gen. Carl Schurz"}],["$","small",null,{"children":"Division included Bohlen’s brigade, whose 61st Ohio, 74th Pennsylvania, and 8th West Virginia crossed at Freeman’s Ford"}]]}],["$","div","Brigade, I Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, I Corps"}],["$","span",null,{"children":"Brig. Gen. Robert H. Milroy"}],["$","small",null,{"children":"Led the Federal vanguard toward White Sulphur Springs on August 23 with a detachment of Buford’s cavalry"}]]}],["$","div","III Corps, Army of Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps, Army of Virginia"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Controlled the Rappahannock Station sector and withdrew the south-bank bridgehead when ordered to move against Jackson"}]]}],["$","div","Division, III Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Division, III Corps"}],["$","span",null,{"children":"Brig. Gen. James B. Ricketts"}],["$","small",null,{"children":"George L. Hartsuff’s brigade held the bridgehead on the Confederate side of the railroad crossing"}]]}],["$","div","Rappahannock Station rear guard",{"className":"command-entry","children":[["$","strong",null,{"children":"Rappahannock Station rear guard"}],["$","span",null,{"children":"Brig. Gen. Zealous B. Tower"}],["$","small",null,{"children":"Supervised the destruction of the railroad bridge after Hartsuff’s brigade returned to the north bank"}]]}],["$","div","Reserve cavalry brigade",{"className":"command-entry","children":[["$","strong",null,{"children":"Reserve cavalry brigade"}],["$","span",null,{"children":"Brig. Gen. John Buford"}],["$","small",null,{"children":"Screened Pope’s movements and sent cavalry with Milroy toward the White Sulphur Springs bridgehead"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Concentrated against Pope, attempted to turn the Federal left at the Rapidan, and approved Stuart’s Catlett Station raid"}]]}],["$","div","Right Wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Covered the lower Rappahannock crossings and directed the artillery and infantry pressure at Rappahannock Station"}]]}],["$","div","Left Wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Moved from Rappahannock Station to the upper crossings and attempted to hold Ewell’s bridgehead at White Sulphur Springs"}]]}],"$L52","$L53","$L54","$L55","$L56","$L57"]]}]]}],"$L58","$L59"]}]
26:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Brig. Gen. Henry Bohlen",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brig. Gen. Henry Bohlen"}],["$","p",null,{"children":[["$","strong",null,{"children":["Brigade commander, 3rd Division, I Corps, Army of Virginia","."]}]," ","Killed by a shot through the heart on August 22, 1862, while his three-regiment force retreated from Trimble’s and Hood’s Confederates at Freeman’s Ford. His men recrossed under fire, and some drowned in the river."]}]]}]]}]]}]
27:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep173-regional-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep173-regional-context.svg","alt":"Generalized map of the Rapidan, Rappahannock, and railroad corridor through Catlett Station and Manassas.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Pope’s new river line protected his route toward Washington while Lee searched for a crossing. Rivers, routes, locations, and distances are generalized."}]]}],["$","figure","/images/ep173-river-operations.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep173-river-operations.svg","alt":"Schematic map of actions at Rappahannock Station, Freeman’s Ford, White Sulphur Springs, and Catlett Station.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The river operations occurred at separated crossings over several days. The diagram is a generalized operational and troop-position schematic, not a scale battlefield map."}]]}],["$","figure","/images/ep173-rappahannock-artillery.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep173-rappahannock-artillery.jpg","alt":"Edwin Forbes panoramic drawing of artillery firing at Rappahannock Station on August 23, 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Edwin Forbes labeled the batteries and terrain in this field drawing of the August 23 artillery fight at Rappahannock Station."}]]}],["$","figure","/images/ep173-catlett-raid.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep173-catlett-raid.jpg","alt":"Alfred Waud drawing of the Catlett Station railroad complex where Stuart raided Pope’s headquarters baggage.","widt