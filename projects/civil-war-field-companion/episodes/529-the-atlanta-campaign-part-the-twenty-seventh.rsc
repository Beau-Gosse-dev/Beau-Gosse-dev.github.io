11:["$","figure","Kennesaw Mountain and Marietta today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-84.67%2C33.86%2C-84.49%2C34.05&layer=mapnik&marker=33.9833%2C-84.5783","title":"Kennesaw Mountain and Marietta today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Kennesaw Mountain and Marietta today"}],["$","span",null,{"children":"The central assault struck south of the mountain near the area now preserved around Cheatham Hill. Other attacks took place at Pigeon Hill and north of the mountain."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:3:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode returns to Kennesaw Mountain",{"className":"moment","children":[["$","$L18",null,{"seconds":76,"label":"1:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode returns to Kennesaw Mountain"}],["$","p",null,{"children":"Johnston ordered a withdrawal after Sherman moved south around the Confederate left. The retreat began on July 2 and U.S. troops found the works empty early on July 3."}]]}]]}],["$","div","U.S. troops occupied the Confederate positions",{"className":"moment","children":[["$","$L18",null,{"seconds":122,"label":"2:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. troops occupied the Confederate positions"}],["$","p",null,{"children":"George H. Thomas reported the retreat before 3 a.m. John A. Logan’s XV Corps confirmed that Little Kennesaw was vacant."}]]}]]}],["$","div","Soldiers saw the graves left by the failed assaults",{"className":"moment","children":[["$","$L18",null,{"seconds":159,"label":"2:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Soldiers saw the graves left by the failed assaults"}],["$","p",null,{"children":"Lyman Whitney of the 34th Illinois questioned why a flanking movement had not been used before the June 27 attacks."}]]}]]}],["$","div","The episode evaluates the battle",{"className":"moment","children":[["$","$L18",null,{"seconds":237,"label":"3:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode evaluates the battle"}],["$","p",null,{"children":"Kennesaw was a Confederate tactical victory within a campaign that U.S. forces ultimately won. The Confederate position was abandoned less than a week after the assaults."}]]}]]}],["$","div","Confederate accounts emphasized the victory",{"className":"moment","children":[["$","$L18",null,{"seconds":303,"label":"5:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate accounts emphasized the victory"}],["$","p",null,{"children":"Officers described high morale, continued confidence in Johnston, and the heavy losses inflicted on the attacking U.S. troops."}]]}]]}],["$","div","U.S. soldiers described the attacks as unnecessary",{"className":"moment","children":[["$","$L18",null,{"seconds":365,"label":"6:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. soldiers described the attacks as unnecessary"}],["$","p",null,{"children":"Veterans criticized the order to attack fortified high ground and continued to question the decision decades later."}]]}]]}],["$","div","The episode asks why Sherman attacked",{"className":"moment","children":[["$","$L18",null,{"seconds":496,"label":"8:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode asks why Sherman attacked"}],["$","p",null,{"children":"Sherman usually preferred maneuver, but he believed circumstances sometimes required assaults against strong positions."}]]}]]}],["$","div","Chickasaw Bayou provides an earlier comparison",{"className":"moment","children":[["$","$L18",null,{"seconds":581,"label":"9:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Chickasaw Bayou provides an earlier comparison"}],["$","p",null,{"children":"In December 1862, Sherman attacked fortified heights north of Vicksburg while separated from Grant and lost almost 1,800 men."}]]}]]}],["$","div","Tunnel Hill provides a second comparison",{"className":"moment","children":[["$","$L18",null,{"seconds":681,"label":"11:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Tunnel Hill provides a second comparison"}],["$","p",null,{"children":"At Chattanooga in November 1863, Sherman attacked Patrick Cleburne’s division on difficult ground and lost just over 1,700 men."}]]}]]}],["$","div","The Kennesaw phase had stalled the campaign",{"className":"moment","children":[["$","$L18",null,{"seconds":875,"label":"14:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Kennesaw phase had stalled the campaign"}],["$","p",null,{"children":"Rain, woods, and expanding Confederate works slowed U.S. flanking movements and kept Sherman’s armies in place."}]]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d"]}]]}]
