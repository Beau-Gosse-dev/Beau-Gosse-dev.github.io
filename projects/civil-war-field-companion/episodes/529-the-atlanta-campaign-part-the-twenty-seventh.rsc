19:["$","div","Sherman wanted to prevent reinforcements from leaving Georgia",{"className":"moment","children":[["$","$L18",null,{"seconds":940,"label":"15:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman wanted to prevent reinforcements from leaving Georgia"}],["$","p",null,{"children":"Grant had directed Sherman to keep Johnston occupied so Confederate troops could not be sent to reinforce Robert E. Lee in Virginia."}]]}]]}]
1a:["$","div","Concern about detached Confederate troops influenced the decision",{"className":"moment","children":[["$","$L18",null,{"seconds":1063,"label":"17:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Concern about detached Confederate troops influenced the decision"}],["$","p",null,{"children":"Historian Earl J. Hess argues that Sherman feared Johnston could hold Kennesaw with fewer men and send the rest east."}]]}]]}]
1b:["$","div","The episode separates strategy from tactics",{"className":"moment","children":[["$","$L18",null,{"seconds":1184,"label":"19:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode separates strategy from tactics"}],["$","p",null,{"children":"Sherman understood large-scale strategic movement, but the planning and coordination of the June 27 attacks were poor."}]]}]]}]
1c:["$","div","The later turning movement succeeded",{"className":"moment","children":[["$","$L18",null,{"seconds":1209,"label":"20:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The later turning movement succeeded"}],["$","p",null,{"children":"The movement begun July 1 forced Johnston out without another direct attack, but it temporarily separated much of Sherman’s force from the railroad supply line."}]]}]]}]
