11:["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Franklin’s reinforcement",{"children":[["$","th",null,{"scope":"row","children":"Franklin’s reinforcement"}],["$","td",null,{"children":["About 12,000 soldiers arrived April 22",["$","small",null,{"style":{"display":"block"},"children":"The episode gives this estimate for William B. Franklin’s division, transferred from McDowell’s retained command. McClellan initially considered using it against Gloucester Point and later sent it by water toward West Point after the evacuation."}]]}]]}]]}]]}]
