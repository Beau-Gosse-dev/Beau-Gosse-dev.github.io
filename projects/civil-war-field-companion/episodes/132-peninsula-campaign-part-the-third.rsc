en":["$","a",null,{"href":"https://www.historyofwar.org/sources/acw/officialrecords/vol011chap023part1/00015_01.html","target":"_blank","rel":"noreferrer","children":["Official Records: Joseph E. Johnston’s report, April 15–May 19, 1862"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$19:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/08010508/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/08010508/","target":"_blank","rel":"noreferrer","children":["Library of Congress: McClellan’s official report on the Army of the Potomac"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$19:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/99446373/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/99446373/","target":"_blank","rel":"noreferrer","children":["Library of Congress: official plan of the Siege of Yorktown"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$19:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/gvhs01.vhs00248/",{"children":"$L36"}],"$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d"]}]]}]
