1f:["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep132-official-siege-plan.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Official plan of the Siege of Yorktown at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-official-siege-plan.jpg","alt":"United States Army Corps of Engineers official plan of the Siege of Yorktown from April 5 to May 3, 1862","width":1600,"height":1200,"loading":"lazy"}]}]}]
20:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Official plan of the Siege of Yorktown"}],["$","span",null,{"children":"Henry L. Abbot’s contemporary U.S. Army Corps of Engineers plan records the United States siege works, proposed battery armaments, Confederate fortifications, headquarters, roads, creeks, and terrain from April 5 through May 3. The map is oriented with north toward the upper right."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep132-official-siege-plan.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$19:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99446373/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$19:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
22:["$","div","United States soldiers build the siege works",{"className":"moment","children":[["$","$L21",null,{"seconds":726,"label":"12:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States soldiers build the siege works"}],["$","p",null,{"children":"Working largely at night, soldiers dug a parallel about a mile from the Confederate line and built roads, ramps, platforms, magazines, and protected battery positions."}]]}]]}]
23:["$","div","Heavy artillery moves through the mud",{"className":"moment","children":[["$","$L21",null,{"seconds":763,"label":"12:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Heavy artillery moves through the mud"}],["$","p",null,{"children":"Barges carried the largest pieces partway up creeks from the York River. Corduroy roads, large horse teams, and rigging then moved the guns to their platforms."}]]}]]}]
24:["$","div","The siege train nears readiness",{"className":"moment","children":[["$","$L21",null,{"seconds":799,"label":"13:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The siege train nears readiness"}],["$","p",null,{"children":"By May 3 the episode reports 114 siege pieces nearly in position in addition to the Army of the Potomac’s field artillery. Authoritative summaries use different totals according to weapon type and date."}]]}]]}]
25:["$","div","Franklin’s division reaches McClellan",{"className":"moment","children":[["$","$L21",null,{"seconds":825,"label":"13:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Franklin’s division reaches McClellan"}],["$","p",null,{"children":"About 12,000 troops from William B. Franklin’s division arrived on April 22. McClellan considered an amphibious move near Gloucester Point but initially kept the division aboard its transports."}]]}]]}]
26:["$","div","Porter directs the siege preparations",{"className":"moment","children":[["$","$L21",null,{"seconds":856,"label":"14:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Porter directs the siege preparations"}],["$","p",null,{"children":"Fitz John Porter supervised the work and used Thaddeus Lowe’s observation balloons. During one flight a broken mooring carried Porter over the Confederate line before a change of wind returned the balloon."}]]}]]}]
27:["$","div","Johnston prepares to leave",{"className":"moment","children":[["$","$L21",null,{"seconds":913,"label":"15:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston prepares to leave"}],["$","p",null,{"children":"As the United States batteries approached readiness, Johnston notified Richmond and ordered the army to evacuate Yorktown during the night of May 3."}]]}]]}]
28:["$","div","Confederate artillery covers the evacuation",{"className":"moment","children":[["$","$L21",null,{"seconds":931,"label":"15:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate artillery covers the evacuation"}],["$","p",null,{"children":"A heavy barrage masked the movement. After dark the Confederate columns left the Yorktown–Warwick defenses and moved toward Williamsburg."}]]}]]}]
29:["$","div","Johnston divides the withdrawal into four commands",{"className":"moment","children":[["$","$L21",null,{"seconds":1024,"label":"17:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston divides the withdrawal into four commands"}],["$","p",null,{"children":"The episode identifies commands under Longstreet, D. H. Hill, Gustavus W. Smith, and David R. Jones, who replaced the ill Magruder. J. E. B. Stuart’s cavalry covered the rear."}]]}]]}]
2a:["$","div","United States troops find Yorktown abandoned",{"className":"moment","children":[["$","$L21",null,{"seconds":1054,"label":"17:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States troops find Yorktown abandoned"}],["$","p",null,{"children":"At daybreak on May 4, McClellan’s army entered the works without the planned bombardment and found heavy artillery and military stores that the Confederates could not remove."}]]}]]}]
2b:["$","div","Buried explosive devices slow the occupation",{"className":"moment","children":[["$","$L21",null,{"seconds":1084,"label":"18:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buried explosive devices slow the occupation"}],["$","p",null,{"children":"Confederate troops left artillery shells fitted with pressure fuses or trip wires in and around the abandoned works. The devices were then called torpedoes and are now described as land mines."}]]}]]}]
2c:["$","div","The mine casualties remain approximate",{"className":"moment","children":[["$","$L21",null,{"seconds":1129,"label":"18:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"The mine casualties remain approximate"}],["$","p",null,{"children":"The episode estimates that four or five United States soldiers were killed and roughly a dozen wounded. National Park Service material confirms several deaths but does not give the same precise total."}]]}]]}]
2d:["$","div","The United States pursuit begins late",{"className":"moment","children":[["$","$L21",null,{"seconds":1193,"label":"19:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"The United States pursuit begins late"}],["$","p",null,{"children":"Surprise at the evacuation and concern about the mines delayed the cavalry until about noon. Mud also slowed the infantry, Confederate wagons, and Confederate artillery."}]]}]]}]
2e:["$","div","Stoneman reaches the rear guard",{"className":"moment","children":[["$","$L21",null,{"seconds":1228,"label":"20:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stoneman reaches the rear guard"}],["$","p",null,{"children":"George Stoneman’s cavalry and horse artillery caught Confederate cavalry several miles short of Williamsburg. Confederate artillery and infantry then checked the pursuit near the prepared works."}]]}]]}]
2f:["$","div","Fort Magruder anchors the Williamsburg line",{"className":"moment","children":[["$","$L21",null,{"seconds":1258,"label":"20:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fort Magruder anchors the Williamsburg line"}],["$","p",null,{"children":"Thirteen redoubts extended across the narrow Peninsula east of Williamsburg. Fort Magruder covered the junction of the Yorktown and Lee’s Mill roads, with marshes and creeks protecting the flanks."}]]}]]}]
30:["$","div","Neither army commander is at the initial contact",{"className":"moment","children":[["$","$L21",null,{"seconds":1322,"label":"22:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Neither army commander is at the initial contact"}],["$","p",null,{"children":"McClellan remained near Yorktown to arrange a water movement toward West Point. Johnston had moved beyond Williamsburg because he anticipated an attempt to cut his line of retreat."}]]}]]}]
31:["$","div","Senior commanders in Johnston’s retreat organization",{"className":"command-entry","children":[["$","strong",null,{"children":"Senior commanders in Johnston’s retreat organization"}],["$","span",null,{"children":"James Longstreet, D. H. Hill, Gustavus W. Smith, and David R. Jones"}],["$","small",null,{"children":"Led the four principal commands moving from the Yorktown–Warwick line; Jones temporarily replaced the ill John B. Magruder"}]]}]
32:["$","div","Cavalry commander and rear guard",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry commander and rear guard"}],["$","span",null,{"children":"J. E. B. Stuart"}],["$","small",null,{"children":"Covered the Confederate withdrawal and skirmished with Stoneman’s pursuit on May 4"}]]}]
33:["$","div","Brigade commander at Yorktown",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade commander at Yorktown"}],["$","span",null,{"children":"Gabriel J. Rains"}],["$","small",null,{"children":"Promoted the use of explosive “torpedoes”; mines were left around the evacuated position and caused United States casualties"}]]}]
34:["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}]
35:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","George B. McClellan",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George B. McClellan"}],["$","p",null,{"children":"Commanded the Army of the Potomac, chose formal siege operations, and directed the occupation and pursuit after Johnston withdrew"}]]}]]}],["$","article","Abraham Lincoln",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AL"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Abraham Lincoln"}],["$","p",null,{"children":"Pressed McClellan to break the Yorktown–Warwick line while following both the Peninsula operations and the fighting at Pittsburg Landing"}]]}]]}],["$","article","Fitz John Porter",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-fitz-john-porter.jpg","alt":"Portrait of Fitz John Porter","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Fitz John Porter"}],["$","p",null,{"children":"Directed the United States siege preparations and conducted aerial observation of the Confederate position"}]]}]]}],["$","article","William B. Franklin",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"WB"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"William B. Franklin"}],["$","p",null,{"children":"Brought a roughly 12,000-man division to the Peninsula and received orders to move by water toward West Point"}]]}]]}],["$","article","George Stoneman",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GS"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"George Stoneman"}],["$","p",null,{"children":"Led the cavalry and horse artillery pursuit toward Williamsburg on May 4"}]]}]]}],["$","article","Joseph E. Johnston",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Joseph E. Johnston"}],["$","p",null,{"children":"Concentrated the main Confederate army on the Peninsula, argued that Yorktown was untenable, and ordered the evacuation"}]]}]]}],["$","article","Jefferson Davis",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JD"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Jefferson Davis"}],["$","p",null,{"children":"Ordered Johnston to hold the Yorktown line after the April 14 strategy conference"}]]}]]}],["$","article","Robert E. Lee",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"RE"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Robert E. Lee"}],["$","p",null,{"children":"Served as Davis’s military adviser and supported continuing the defense of the lower Peninsula"}]]}]]}],["$","article","George W. Randolph",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GW"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"George W. Randolph"}],["$","p",null,{"children":"Served as Confederate secretary of war and participated in the April 14 strategy conference"}]]}]]}],["$","article","James Longstreet",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":"$L3e"}],"$L3f"]}],"$L40","$L41","$L42","$L43"]}]
