1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",132," · ","April 5–May 4, 1862"," · ","The Virginia Peninsula between the York and James Rivers: Yorktown and the Warwick River line, Gloucester Point, Lee’s Mill, the roads toward Williamsburg, and the York River route toward West Point"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN (Part the Third)"}],["$","span",null,{"className":"result-label","children":"The Army of the Potomac prepared a formal siege rather than forcing the Yorktown–Warwick line. The delay allowed Joseph E. Johnston to reinforce the position and organize his army, but the United States siege artillery made the line untenable. Johnston evacuated during the night of May 3–4. United States troops occupied Yorktown and Gloucester Point, captured dozens of heavy guns, and began a pursuit toward Williamsburg. The Confederates gave up the lower Peninsula but preserved their field army and gained nearly a month for the defense of Richmond. The National Park Service classifies the Yorktown operation as indecisive"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6356149546.mp3?updated=1695219992","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Operation",{"children":[["$","span",null,{"children":"Operation"}],["$","strong",null,{"children":"Siege of Yorktown, April 5–May 4, 1862"}],"$undefined"]}],["$","div","Confederate position",{"children":[["$","span",null,{"children":"Confederate position"}],["$","strong",null,{"children":"Yorktown–Warwick line"}],["$","small",null,{"children":"Earthworks at Yorktown and Gloucester Point were connected to defenses extending along the dammed and flooded Warwick River toward the James River."}]]}],["$","div","Confederate strength after reinforcement",{"children":[["$","span",null,{"children":"Confederate strength after reinforcement"}],["$","strong",null,{"children":"Up to about 56,000"}],["$","small",null,{"children":"The National Park Service gives 56,000 as the force ultimately concentrated under Johnston. Strength figures vary by date, organizational scope, and whether present-for-duty or aggregate totals are used."}]]}],["$","div","United States siege command",{"children":[["$","span",null,{"children":"United States siege command"}],["$","strong",null,{"children":"Brigadier General Fitz John Porter"}],["$","small",null,{"children":"Porter directed the siege preparations while continuing to command his division."}]]}],["$","div","Siege artillery",{"children":[["$","span",null,{"children":"Siege artillery"}],["$","strong",null,{"children":"101 siege guns and more than 40 siege mortars"}],["$","small",null,{"children":"These are National Park Service figures for the siege arsenal. The episode says 114 siege pieces were nearly ready by May 3 and separately mentions more than 300 field pieces. The totals use different dates or counting conventions and should not be treated as directly equivalent."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17"]}],"$L18","$undefined","$L19",false,"$L1a",false,"$L1b","$L1c","$L1d"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Largest weapons described in the episode",{"children":[["$","span",null,{"children":"Largest weapons described in the episode"}],["$","strong",null,{"children":"200-pounder Parrott rifles and 13-inch seacoast mortars"}],["$","small",null,{"children":"Moving and mounting these weapons required corduroy roads, barges, large horse teams, and block-and-tackle equipment."}]]}]
f:["$","div","Franklin’s reinforcement",{"children":[["$","span",null,{"children":"Franklin’s reinforcement"}],["$","strong",null,{"children":"About 12,000 soldiers arrived April 22"}],["$","small",null,{"children":"The episode gives this estimate for William B. Franklin’s division, transferred from McDowell’s retained command. McClellan initially considered using it against Gloucester Point and later sent it by water toward West Point after the evacuation."}]]}]
10:["$","div","Planned bombardment",{"children":[["$","span",null,{"children":"Planned bombardment"}],["$","strong",null,{"children":"Early May; never executed as planned"}],["$","small",null,{"children":"The episode, the National Park Service Yorktown history, and the U.S. Army campaign history give May 5. A separate National Park Service battle summary gives dawn on May 4. Johnston’s night evacuation preempted either timetable."}]]}]
11:["$","div","Evacuation",{"children":[["$","span",null,{"children":"Evacuation"}],["$","strong",null,{"children":"Night of May 3–4, 1862"}],["$","small",null,{"children":"Johnston’s report states that he ordered the movement toward Williamsburg after the United States batteries appeared nearly ready."}]]}]
12:["$","div","Captured Confederate artillery",{"children":[["$","span",null,{"children":"Captured Confederate artillery"}],["$","strong",null,{"children":"At least 71 heavy guns; 77 guns and mortars in McClellan’s later total"}],["$","small",null,{"children":"McClellan reported 71 heavy guns by the evening of May 4 and later listed 77 guns and mortars from Yorktown, Gloucester Point, and the other abandoned works. The episode says more than 70."}]]}]
13:["$","div","Yorktown land-mine casualties",{"children":[["$","span",null,{"children":"Yorktown land-mine casualties"}],["$","strong",null,{"children":"Several United States soldiers killed; exact total uncertain"}],["$","small",null,{"children":"The National Park Service says the mines claimed several lives. The episode estimates four or five killed and about a dozen wounded, but it presents those numbers as approximate."}]]}]
14:["$","div","May 4 pursuit",{"children":[["$","span",null,{"children":"May 4 pursuit"}],["$","strong",null,{"children":"Stoneman reached the Confederate rear guard east of Williamsburg"}],["$","small",null,{"children":"Confederate artillery and infantry checked the initial United States cavalry advance at Magruder’s earlier line of redoubts. The larger Battle of Williamsburg followed on May 5."}]]}]
15:["$","div","Senior commanders killed or mortally wounded",{"children":[["$","span",null,{"children":"Senior commanders killed or mortally wounded"}],["$","strong",null,{"children":"None in the operations covered by this episode"}],"$undefined"]}]
16:["$","div","Transcript numbering discrepancy",{"children":[["$","span",null,{"children":"Transcript numbering discrepancy"}],["$","strong",null,{"children":"The audio introduction says episode 133"}],["$","small",null,{"children":"The official podcast page and dataset identify this installment as episode 132, “Peninsula Campaign (Part the Third).” The next installment is episode 133, Part the Fourth."}]]}]
17:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"The Peninsula Campaign and the Necessity of Emancipation: African Americans and the Fight for Freedom by Glenn David Brasher"}],"$undefined"]}]
18:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
19:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Operational setting on the Virginia Peninsula",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep132-peninsula-operations.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Operational setting on the Virginia Peninsula at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-peninsula-operations.svg","alt":"Schematic map of the Virginia Peninsula showing United States and Confederate movements between Fort Monroe, Yorktown, Williamsburg, West Point, and Richmond","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Operational setting on the Virginia Peninsula"}],["$","span",null,{"children":"Johnston reinforced the Yorktown–Warwick line after McClellan advanced from Fort Monroe. On May 3–4 the Confederates withdrew through Williamsburg toward Richmond. McClellan pursued by road and ordered Franklin’s division up the York River toward West Point in an attempt to threaten the retreat. This explanatory map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep132-peninsula-operations.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo72995/pdf/GOVPUB-D114-PURL-gpo72995.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$19:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The May 3–4 evacuation and pursuit",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep132-yorktown-williamsburg-pursuit.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The May 3–4 evacuation and pursuit at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-yorktown-williamsburg-pursuit.svg","alt":"Schematic map of the Confederate withdrawal from Yorktown, United States pursuit toward Williamsburg, and planned water movement toward West Point","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The May 3–4 evacuation and pursuit"}],["$","span",null,{"children":"Two Confederate columns left the Warwick line by the Yorktown and Lee’s Mill roads. George Stoneman’s cavalry and horse artillery began the United States pursuit around noon on May 4 and met the rear guard near the fortified line east of Williamsburg. Four divisions were also ordered toward West Point by water. Roads, works, and movements are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep132-yorktown-williamsburg-pursuit.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$19:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/york/learn/historyculture/yorktown-in-the-civil-war.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$19:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Official plan of the Siege of Yorktown",{"className":"reference-map","children":["$L1e","$L1f"]}]]}]]}]
1a:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","President and constitutional commander in chief-Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"President and constitutional commander in chief"}],["$","span",null,{"children":"Abraham Lincoln"}],["$","small",null,{"children":"Required the protection of Washington and continued to press McClellan for prompt action at Yorktown"}]]}],["$","div","Secretary of War-Edwin M. Stanton",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of War"}],["$","span",null,{"children":"Edwin M. Stanton"}],["$","small",null,{"children":"Directed the War Department and received McClellan’s reports on the occupation and pursuit"}]]}],["$","div","Commander, Army of the Potomac-George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Army of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Directed the siege, the May 4 occupation, the land pursuit, and the planned water movement toward West Point"}]]}],["$","div","Division commander and director of siege operations-Fitz John Porter",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander and director of siege operations"}],["$","span",null,{"children":"Fitz John Porter"}],["$","small",null,{"children":"Supervised construction of approaches and batteries and observed the Confederate position from balloons"}]]}],["$","div","Division commander, formerly assigned to McDowell’s I Corps-William B. Franklin",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander, formerly assigned to McDowell’s I Corps"}],["$","span",null,{"children":"William B. Franklin"}],["$","small",null,{"children":"Reached the Peninsula on April 22 and was assigned to the water movement toward West Point after Yorktown fell"}]]}],["$","div","Chief of cavalry, Army of the Potomac-George Stoneman",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief of cavalry, Army of the Potomac"}],["$","span",null,{"children":"George Stoneman"}],["$","small",null,{"children":"Led the cavalry and horse artillery pursuit toward Williamsburg on May 4"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","President and commander in chief-Jefferson Davis",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander in chief"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Directed national strategy and ordered Johnston to continue defending the lower Peninsula after the April 14 conference"}]]}],["$","div","Secretary of War-George W. Randolph",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of War"}],["$","span",null,{"children":"George W. Randolph"}],["$","small",null,{"children":"Served as the civilian head of the Confederate War Department and participated in the April 14 strategy conference"}]]}],"$L20","$L21","$L22","$L23","$L24"]]}]]}],"$L25"]]]}]
1b:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep132-federal-battery-no-1.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-federal-battery-no-1.jpg","alt":"United States soldiers and heavy rifled guns in Federal Battery Number 1 at Yorktown","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Federal Battery No. 1 mounted the heavy rifled artillery prepared for the Yorktown bombardment. The Library of Congress identifies this May 1862 photograph as one view from a multi-image mount showing one 200-pounder and five 100-pounder rifles."}]]}],["$","figure","/images/ep132-mcclellan-headquarters.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-mcclellan-headquarters.jpg","alt":"Tents and personnel at George B. McClellan’s Camp Winfield Scott headquarters near Yorktown","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"James F. Gibson photographed McClellan’s headquarters near Yorktown on May 3, the day Johnston began the final evacuation of the Confederate line."}]]}],["$","figure","/images/ep132-red-redoubt.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-red-redoubt.jpg","alt":"Alfred Waud drawing of United States troops taking possession of a Confederate redoubt near Yorktown","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alfred R. Waud recorded soldiers of the 40th and 38th New York taking possession of the Red Redoubt near Yorktown at 6 a.m. after the Confederate evacuation."}]]}],["$","figure","/images/ep132-gabriel-rains.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-gabriel-rains.jpg","alt":"Wartime portrait of Confederate Brigadier General Gabriel J. Rains","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Gabriel J. Rains commanded a brigade in the Yorktown defenses and advocated the explosive devices then called torpedoes. The devices left after the evacuation killed several United States soldiers."}]]}],["$","figure","/images/ep132-fitz-john-porter.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-fitz-john-porter.jpg","alt":"Major General Fitz John Porter standing in uniform with a sword and United States flag in March 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Fitz John Porter directed the construction and preparation of McClellan’s siege works and also used Thaddeus Lowe’s balloons to observe the Confederate position."}]]}]]}]]}]
