1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",132," · ","April 5–May 4, 1862"," · ","The Virginia Peninsula between the York and James Rivers: Yorktown and the Warwick River line, Gloucester Point, Lee’s Mill, the roads toward Williamsburg, and the York River route toward West Point"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN (Part the Third)"}],["$","span",null,{"className":"result-label","children":"The Army of the Potomac prepared a formal siege rather than forcing the Yorktown–Warwick line. The delay allowed Joseph E. Johnston to reinforce the position and organize his army, but the United States siege artillery made the line untenable. Johnston evacuated during the night of May 3–4. United States troops occupied Yorktown and Gloucester Point, captured dozens of heavy guns, and began a pursuit toward Williamsburg. The Confederates gave up the lower Peninsula but preserved their field army and gained nearly a month for the defense of Richmond. The National Park Service classifies the Yorktown operation as indecisive"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6356149546.mp3?updated=1695219992","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Operation",{"children":[["$","span",null,{"children":"Operation"}],["$","strong",null,{"children":"Siege of Yorktown, April 5–May 4, 1862"}],"$undefined"]}],["$","div","Confederate position",{"children":[["$","span",null,{"children":"Confederate position"}],["$","strong",null,{"children":"Yorktown–Warwick line"}],["$","small",null,{"children":"Earthworks at Yorktown and Gloucester Point were connected to defenses extending along the dammed and flooded Warwick River toward the James River."}]]}],["$","div","Confederate strength after reinforcement",{"children":[["$","span",null,{"children":"Confederate strength after reinforcement"}],["$","strong",null,{"children":"Up to about 56,000"}],["$","small",null,{"children":"The National Park Service gives 56,000 as the force ultimately concentrated under Johnston. Strength figures vary by date, organizational scope, and whether present-for-duty or aggregate totals are used."}]]}],["$","div","United States siege command",{"children":[["$","span",null,{"children":"United States siege command"}],["$","strong",null,{"children":"Brigadier General Fitz John Porter"}],["$","small",null,{"children":"Porter directed the siege preparations while continuing to command his division."}]]}],["$","div","Siege artillery",{"children":[["$","span",null,{"children":"Siege artillery"}],["$","strong",null,{"children":"101 siege guns and more than 40 siege mortars"}],["$","small",null,{"children":"These are National Park Service figures for the siege arsenal. The episode says 114 siege pieces were nearly ready by May 3 and separately mentions more than 300 field pieces. The totals use different dates or counting conventions and should not be treated as directly equivalent."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17"]}],"$L18","$L19","$L1a","$L1b",false,"$L1c","$L1d","$L1e"]}]]}]
21:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Largest weapons described in the episode",{"children":[["$","span",null,{"children":"Largest weapons described in the episode"}],["$","strong",null,{"children":"200-pounder Parrott rifles and 13-inch seacoast mortars"}],["$","small",null,{"children":"Moving and mounting these weapons required corduroy roads, barges, large horse teams, and block-and-tackle equipment."}]]}]
f:["$","div","Franklin’s reinforcement",{"children":[["$","span",null,{"children":"Franklin’s reinforcement"}],["$","strong",null,{"children":"About 12,000 soldiers arrived April 22"}],["$","small",null,{"children":"The episode gives this estimate for William B. Franklin’s division, transferred from McDowell’s retained command. McClellan initially considered using it against Gloucester Point and later sent it by water toward West Point after the evacuation."}]]}]
10:["$","div","Planned bombardment",{"children":[["$","span",null,{"children":"Planned bombardment"}],["$","strong",null,{"children":"Early May; never executed as planned"}],["$","small",null,{"children":"The episode, the National Park Service Yorktown history, and the U.S. Army campaign history give May 5. A separate National Park Service battle summary gives dawn on May 4. Johnston’s night evacuation preempted either timetable."}]]}]
11:["$","div","Evacuation",{"children":[["$","span",null,{"children":"Evacuation"}],["$","strong",null,{"children":"Night of May 3–4, 1862"}],["$","small",null,{"children":"Johnston’s report states that he ordered the movement toward Williamsburg after the United States batteries appeared nearly ready."}]]}]
12:["$","div","Captured Confederate artillery",{"children":[["$","span",null,{"children":"Captured Confederate artillery"}],["$","strong",null,{"children":"At least 71 heavy guns; 77 guns and mortars in McClellan’s later total"}],["$","small",null,{"children":"McClellan reported 71 heavy guns by the evening of May 4 and later listed 77 guns and mortars from Yorktown, Gloucester Point, and the other abandoned works. The episode says more than 70."}]]}]
13:["$","div","Yorktown land-mine casualties",{"children":[["$","span",null,{"children":"Yorktown land-mine casualties"}],["$","strong",null,{"children":"Several United States soldiers killed; exact total uncertain"}],["$","small",null,{"children":"The National Park Service says the mines claimed several lives. The episode estimates four or five killed and about a dozen wounded, but it presents those numbers as approximate."}]]}]
14:["$","div","May 4 pursuit",{"children":[["$","span",null,{"children":"May 4 pursuit"}],["$","strong",null,{"children":"Stoneman reached the Confederate rear guard east of Williamsburg"}],["$","small",null,{"children":"Confederate artillery and infantry checked the initial United States cavalry advance at Magruder’s earlier line of redoubts. The larger Battle of Williamsburg followed on May 5."}]]}]
15:["$","div","Senior commanders killed or mortally wounded",{"children":[["$","span",null,{"children":"Senior commanders killed or mortally wounded"}],["$","strong",null,{"children":"None in the operations covered by this episode"}],"$undefined"]}]
16:["$","div","Transcript numbering discrepancy",{"children":[["$","span",null,{"children":"Transcript numbering discrepancy"}],["$","strong",null,{"children":"The audio introduction says episode 133"}],["$","small",null,{"children":"The official podcast page and dataset identify this installment as episode 132, “Peninsula Campaign (Part the Third).” The next installment is episode 133, Part the Fourth."}]]}]
17:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"The Peninsula Campaign and the Necessity of Emancipation: African Americans and the Fight for Freedom by Glenn David Brasher"}],"$undefined"]}]
