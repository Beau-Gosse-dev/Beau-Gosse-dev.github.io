· ","National Archives: Official Records of the Union and Confederate Armies"]}],["$","a","https://www.historyofwar.org/sources/acw/officialrecords/vol011chap023part1/00015_01.html",{"href":"https://www.historyofwar.org/sources/acw/officialrecords/vol011chap023part1/00015_01.html","target":"_blank","rel":"noreferrer","children":[" · ","Official Records: Joseph E. Johnston’s report, April 15–May 19, 1862"]}],["$","a","https://www.loc.gov/item/08010508/",{"href":"https://www.loc.gov/item/08010508/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: McClellan’s official report on the Army of the Potomac"]}],["$","a","https://www.loc.gov/item/99446373/",{"href":"https://www.loc.gov/item/99446373/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: official plan of the Siege of Yorktown"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00248/",{"href":"https://www.loc.gov/item/gvhs01.vhs00248/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Robert Knox Sneden map of the Yorktown lines"]}],["$","a","https://www.loc.gov/item/2023634123/",{"href":"https://www.loc.gov/item/2023634123/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Federal Battery No. 1 at Yorktown"]}],["$","a","https://www.loc.gov/item/2018666134/",{"href":"https://www.loc.gov/item/2018666134/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: McClellan’s headquarters near Yorktown"]}],["$","a","https://www.loc.gov/item/2004660046/",{"href":"https://www.loc.gov/item/2004660046/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Waud drawing of the occupied Red Redoubt"]}],"$L1b","$L1c","$L1d","$L1e"]}]
