18:["$","details",null,{"className":"reference-sources","children":[["$","summary",null,{"children":"Sources and image credits"}],["$","ul",null,{"children":[["$","li","https://www.loc.gov/item/2017652160/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/2017652160/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Fitz John Porter portrait, March 1862"," ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/item/2018670379/",{"children":["$","a",null,{"href":"https://www.loc.gov/item/2018670379/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Gabriel J. Rains portrait"," ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://civilwarpodcast.org/2015/11/08/civil-war-podcast-episode-132/",{"children":["$","a",null,{"href":"https://civilwarpodcast.org/2015/11/08/civil-war-podcast-episode-132/","target":"_blank","rel":"noreferrer","children":["The Civil War Podcast: episode 132 page"," ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/york/learn/historyculture/yorktown-in-the-civil-war.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/york/learn/historyculture/yorktown-in-the-civil-war.htm","target":"_blank","rel":"noreferrer","children":["National Park Service: Yorktown in the Civil War"," ",["$","$Le",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:children:0:props:children:1:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/civilwar/sea