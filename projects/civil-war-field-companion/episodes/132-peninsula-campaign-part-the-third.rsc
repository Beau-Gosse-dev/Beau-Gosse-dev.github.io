d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",132," · ","April 5–May 4, 1862"," · ","The Virginia Peninsula between the York and James Rivers: Yorktown and the Warwick River line, Gloucester Point, Lee’s Mill, the roads toward Williamsburg, and the York River route toward West Point"]}],["$","h1",null,{"children":"PENINSULA CAMPAIGN (Part the Third)"}],["$","span",null,{"className":"result-label","children":"The Army of the Potomac prepared a formal siege rather than forcing the Yorktown–Warwick line. The delay allowed Joseph E. Johnston to reinforce the position and organize his army, but the United States siege artillery made the line untenable. Johnston evacuated during the night of May 3–4. United States troops occupied Yorktown and Gloucester Point, captured dozens of heavy guns, and began a pursuit toward Williamsburg. The Confederates gave up the lower Peninsula but preserved their field army and gained nearly a month for the defense of Richmond. The National Park Service classifies the Yorktown operation as indecisive"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 5–May 4, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"The Virginia Peninsula between the York and James Rivers: Yorktown and the Warwick River line, Gloucester Point, Lee’s Mill, the roads toward Williamsburg, and the York River route toward West Point"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"The Army of the Potomac prepared a formal siege rather than forcing the Yorktown–Warwick line. The delay allowed Joseph E. Johnston to reinforce the position and organize his army, but the United States siege artillery made the line untenable. Johnston evacuated during the night of May 3–4. United States troops occupied Yorktown and Gloucester Point, captured dozens of heavy guns, and began a pursuit toward Williamsburg. The Confederates gave up the lower Peninsula but preserved their field army and gained nearly a month for the defense of Richmond. The National Park Service classifies the Yorktown operation as indecisive"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":["$Lf","$L10","$L11","$L12"]}],"$undefined"]}],"$L13","$L14","$L15",false,"$L16",false,"$L17","$L18","$L19","$L1a"]}]]}]
