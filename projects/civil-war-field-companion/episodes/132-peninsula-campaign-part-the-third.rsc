19:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Operational setting on the Virginia Peninsula",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep132-peninsula-operations.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Operational setting on the Virginia Peninsula at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-peninsula-operations.svg","alt":"Schematic map of the Virginia Peninsula showing United States and Confederate movements between Fort Monroe, Yorktown, Williamsburg, West Point, and Richmond","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Operational setting on the Virginia Peninsula"}],["$","span",null,{"children":"Johnston reinforced the Yorktown–Warwick line after McClellan advanced from Fort Monroe. On May 3–4 the Confederates withdrew through Williamsburg toward Richmond. McClellan pursued by road and ordered Franklin’s division up the York River toward West Point in an attempt to threaten the retreat. This explanatory map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep132-peninsula-operations.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.govinfo.gov/content/pkg/GOVPUB-D114-PURL-gpo72995/pdf/GOVPUB-D114-PURL-gpo72995.pdf","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$19:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The May 3–4 evacuation and pursuit",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep132-yorktown-williamsburg-pursuit.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The May 3–4 evacuation and pursuit at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-yorktown-williamsburg-pursuit.svg","alt":"Schematic map of the Confederate withdrawal from Yorktown, United States pursuit toward Williamsburg, and planned water movement toward West Point","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The May 3–4 evacuation and pursuit"}],["$","span",null,{"children":"Two Confederate columns left the Warwick line by the Yorktown and Lee’s Mill roads. George Stoneman’s cavalry and horse artillery began the United States pursuit around noon on May 4 and met the rear guard near the fortified line east of Williamsburg. Four divisions were also ordered toward West Point by water. Roads, works, and movements are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep132-yorktown-williamsburg-pursuit.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$19:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/york/learn/historyculture/yorktown-in-the-civil-war.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$19:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Official plan of the Siege of Yorktown",{"className":"reference-map","children":["$L1f","$L20"]}]]}]]}]
1a:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The Army of the Potomac is stopped at Yorktown",{"className":"moment","children":[["$","$L21",null,{"seconds":84,"label":"1:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Potomac is stopped at Yorktown"}],["$","p",null,{"children":"The episode resumes with McClellan’s army on the Peninsula and the president withholding McDowell’s corps after concluding that Washington had not been left adequately protected."}]]}]]}],["$","div","The Warwick line disrupts McClellan’s timetable",{"className":"moment","children":[["$","$L21",null,{"seconds":158,"label":"2:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Warwick line disrupts McClellan’s timetable"}],["$","p",null,{"children":"Resistance along the Warwick River extended the obstacle beyond Yorktown. McClellan halted the intended rapid advance and spent most of April preparing a siege."}]]}]]}],["$","div","Lincoln waits for action",{"className":"moment","children":[["$","$L21",null,{"seconds":283,"label":"4:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln waits for action"}],["$","p",null,{"children":"Lincoln followed events from the War Department telegraph office while the Army of the Potomac remained before Yorktown and fighting unfolded at Pittsburg Landing in Tennessee."}]]}]]}],["$","div","Lincoln urges an immediate break in the line",{"className":"moment","children":[["$","$L21",null,{"seconds":301,"label":"5:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln urges an immediate break in the line"}],["$","p",null,{"children":"Lincoln telegraphed McClellan that he should break the line between Yorktown and the Warwick River at once. McClellan continued siege preparations."}]]}]]}],["$","div","McClellan chooses formal siege operations",{"className":"moment","children":[["$","$L21",null,{"seconds":318,"label":"5:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan chooses formal siege operations"}],["$","p",null,{"children":"He rejected an infantry assault in favor of the slower method of constructing batteries and placing heavy artillery against the Confederate defenses."}]]}]]}],["$","div","The delay permits Confederate concentration",{"className":"moment","children":[["$","$L21",null,{"seconds":417,"label":"6:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The delay permits Confederate concentration"}],["$","p",null,{"children":"The month before Yorktown gave Johnston time to transfer forces from northern Virginia to the Peninsula, placing the main Confederate field army between McClellan and Richmond."}]]}]]}],["$","div","Johnston inspects Magruder’s defenses",{"className":"moment","children":[["$","$L21",null,{"seconds":508,"label":"8:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston inspects Magruder’s defenses"}],["$","p",null,{"children":"Johnston judged the line too weak for a sustained defense against McClellan’s army and heavy artillery and sought authority to withdraw closer to Richmond."}]]}]]}],["$","div","Confederate leaders meet in Richmond on April 14",{"className":"moment","children":[["$","$L21",null,{"seconds":600,"label":"10:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate leaders meet in Richmond on April 14"}],["$","p",null,{"children":"Jefferson Davis and his advisers Robert E. Lee and George W. Randolph met Johnston, Gustavus W. Smith, and James Longstreet to decide whether the army should hold Yorktown or retreat."}]]}]]}],["$","div","Davis orders the Yorktown line held",{"className":"moment","children":[["$","$L21",null,{"seconds":682,"label":"11:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis orders the Yorktown line held"}],["$","p",null,{"children":"After a prolonged strategy conference, Davis accepted the case for using the lower Peninsula’s defensive advantages and directed Johnston to remain. Johnston complied while expecting that withdrawal would become necessary."}]]}]]}],"$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30"]}]]}]
1b:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","President and constitutional commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and constitutional commander in chief"}],["$","span",null,{"children":"Abraham Lincoln"}],["$","small",null,{"children":"Required the protection of Washington and continued to press McClellan for prompt action at Yorktown"}]]}],["$","div","Secretary of War",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of War"}],["$","span",null,{"children":"Edwin M. Stanton"}],["$","small",null,{"children":"Directed the War Department and received McClellan’s reports on the occupation and pursuit"}]]}],["$","div","Commander, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander, Army of the Potomac"}],["$","span",null,{"children":"George B. McClellan"}],["$","small",null,{"children":"Directed the siege, the May 4 occupation, the land pursuit, and the planned water movement toward West Point"}]]}],["$","div","Division commander and director of siege operations",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander and director of siege operations"}],["$","span",null,{"children":"Fitz John Porter"}],["$","small",null,{"children":"Supervised construction of approaches and batteries and observed the Confederate position from balloons"}]]}],["$","div","Division commander, formerly assigned to McDowell’s I Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Division commander, formerly assigned to McDowell’s I Corps"}],["$","span",null,{"children":"William B. Franklin"}],["$","small",null,{"children":"Reached the Peninsula on April 22 and was assigned to the water movement toward West Point after Yorktown fell"}]]}],["$","div","Chief of cavalry, Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief of cavalry, Army of the Potomac"}],["$","span",null,{"children":"George Stoneman"}],["$","small",null,{"children":"Led the cavalry and horse artillery pursuit toward Williamsburg on May 4"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","President and commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander in chief"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Directed national strategy and ordered Johnston to continue defending the lower Peninsula after the April 14 conference"}]]}],["$","div","Secretary of War",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of War"}],["$","span",null,{"children":"George W. Randolph"}],["$","small",null,{"children":"Served as the civilian head of the Confederate War Department and participated in the April 14 strategy conference"}]]}],["$","div","Military adviser to President Davis",{"className":"command-entry","children":[["$","strong",null,{"children":"Military adviser to President Davis"}],["$","span",null,{"children":"Robert E. Lee"}],["$","small",null,{"children":"Argued that the Peninsula offered advantages to an outnumbered defender and supported holding the Yorktown line"}]]}],["$","div","Department of Northern Virginia and principal field army on the Peninsula",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Northern Virginia and principal field army on the Peninsula"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"Assumed overall field command, opposed a prolonged defense at Yorktown, and ordered the May 3–4 withdrawal"}]]}],"$L31","$L32","$L33"]]}]]}],"$L34","$L35"]}]
1c:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep132-federal-battery-no-1.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-federal-battery-no-1.jpg","alt":"United States soldiers and heavy rifled guns in Federal Battery Number 1 at Yorktown","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Federal Battery No. 1 mounted the heavy rifled artillery prepared for the Yorktown bombardment. The Library of Congress identifies this May 1862 photograph as one view from a multi-image mount showing one 200-pounder and five 100-pounder rifles."}]]}],["$","figure","/images/ep132-mcclellan-headquarters.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-mcclellan-headquarters.jpg","alt":"Tents and personnel at George B. McClellan’s Camp Winfield Scott headquarters near Yorktown","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"James F. Gibson photographed McClellan’s headquarters near Yorktown on May 3, the day Johnston began the final evacuation of the Confederate line."}]]}],["$","figure","/images/ep132-red-redoubt.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-red-redoubt.jpg","alt":"Alfred Waud drawing of United States troops taking possession of a Confederate redoubt near Yorktown","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Alfred R. Waud recorded soldiers of the 40th and 38th New York taking possession of the Red Redoubt near Yorktown at 6 a.m. after the Confederate evacuation."}]]}],["$","figure","/images/ep132-gabriel-rains.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-gabriel-rains.jpg","alt":"Wartime portrait of Confederate Brigadier General Gabriel J. Rains","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Gabriel J. Rains commanded a brigade in the Yorktown defenses and advocated the explosive devices then called torpedoes. The devices left after the evacuation killed several United States soldiers."}]]}],["$","figure","/images/ep132-fitz-john-porter.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep132-fitz-john-porter.jpg","alt":"Major General Fitz John Porter standing in uniform with a sword and United States flag in March 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Fitz John Porter directed the construction and preparation of McClellan’s siege works and also used Thaddeus Lowe’s balloons to observe the Confederate position."}]]}]]}]]}]
