d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",160," · ","June 27, 1862, approximately 10 a.m.–5 p.m."," · ","Hanover County, Virginia, north of the Chickahominy River: Walnut Church, Powhite Creek, New and Old Cold Harbor, Boatswain’s Swamp, and Porter’s line on the Turkey Hill plateau"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: GAINES'S MILL (Part the Second)"}],["$","span",null,{"className":"result-label","children":"By the endpoint of this installment, Porter’s reinforced V Corps still held behind Boatswain’s Swamp. D. H. Hill had checked his advance near Old Cold Harbor; A. P. Hill and Ewell had made costly, unsupported attacks; and Longstreet was preparing to turn a diversion into a full assault. The final Confederate breakthrough and Federal retreat occur in the next episode; the complete Battle of Gaines’s Mill was a Confederate victory"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"June 27, 1862, approximately 10 a.m.–5 p.m."}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Hanover County, Virginia, north of the Chickahominy River: Walnut Church, Powhite Creek, New and Old Cold Harbor, Boatswain’s Swamp, and Porter’s line on the Turkey Hill plateau"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"By the endpoint of this installment, Porter’s reinforced V Corps still held behind Boatswain’s Swamp. D. H. Hill had checked his advance near Old Cold Harbor; A. P. Hill and Ewell had made costly, unsupported attacks; and Longstreet was preparing to turn a diversion into a full assault. The final Confederate breakthrough and Federal retreat occur in the next episode; the complete Battle of Gaines’s Mill was a Confederate victory"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"June 27, 1862, approximately 10 a.m.–5 p.m.","place":"Hanover County, Virginia, north of the Chickahominy River: Walnut Church, Powhite Creek, New and Old Cold Harbor, Boatswain’s Swamp, and Porter’s line on the Turkey Hill plateau","result":"By the endpoint of this installment, Porter’s reinforced V Corps still held behind Boatswain’s Swamp. D. H. Hill had checked his advance near Old Cold Harbor; A. P. Hill and Ewell had made costly, unsupported attacks; and Longstreet was preparing to turn a diversion into a full assault. The final Confederate breakthrough and Federal retreat occur in the next episode; the complete Battle of Gaines’s Mill was a Confederate victory","facts":[{"label":"Episode scope","value":"The approach march and failed Confederate attacks before the final evening assault","note":"The decisive breakthrough is outside this installment."},{"label":"Battle and campaign","value":"Gaines’s Mill, the third of the Seven Days Battles","note":"The fighting occurred on Friday, June 27, 1862, and is also called First Cold Harbor. The 1864 Battle of Cold Harbor was a separate engagement."},{"label":"Lee’s mistaken premise","value":"Porter would defend Powhite Creek and the route to White House Landing","note":"McClellan had decided to abandon that supply route. Porter instead occupied stronger ground about half a mile east, behind Boatswain’s Swamp."},{"label":"Planned hammer and anvil","value":"A. P. Hill and Longstreet drive east while Jackson and D. H. Hill turn the Federal right","note":"The concept became obsolete when Confederate troops found Porter facing west and north behind Boatswain’s Swamp."},{"label":"Morning movements","value":"Lee’s army advanced east on four roads north of the Chickahominy","note":"The episode follows Jackson and D. H. Hill toward Old Cold Harbor, A. P. Hill toward Walnut Church and New Cold Harbor, and Longstreet toward River Road. Map routes are generalized."},{"label":"Lee and Jackson confer","value":"Approximately 10–11 a.m. near Walnut Church","note":"Jackson’s guns had mistakenly fired toward A. P. Hill’s troops nearby. Their staffs did not hear the later conversation; the episode’s claim that Lee restated Jackson’s role is an inference."},{"label":"D. H. Hill meets Sykes","value":"A substantial Federal line blocks the approach south of Old Cold Harbor","note":"After a sharp and unfavorable artillery exchange, Hill fell back, deployed near the crossroads, and waited for Jackson."},{"label":"Information failure","value":"Lee did not promptly learn of D. H. Hill’s contact","note":"The episode cites an acoustic shadow and notes that Hill sent no messenger. The atmospheric explanation is the podcast’s interpretation; the absence of a timely report is the direct command problem."},{"label":"Gregg finds the actual line","value":"Across Powhite Creek, through New Cold Harbor, and down toward Boatswain’s Swamp","note":"Gregg pushed aside skirmishers near Gaines’s Mill, then met heavy artillery fire farther east and reported the previously unknown defensive line."},{"label":"Porter requests Slocum","value":"About 2 p.m.","note":"McClellan had recalled Slocum because he feared an attack south of the river. After Porter’s request, Slocum was again sent north."},{"label":"Strengths in the episode","value":"About 55,000–60,000 Confederates; Porter rose from roughly 27,000 to 34,000–35,000","note":"The episode uses nearly 55,000 Confederates and about 35,000 Federals after Slocum’s 8,500 arrived. The National Park Service uses approximately 60,000 and 34,000. Totals vary by time and counting method."},{"label":"Confederate artillery","value":"Batteries entered separately and were generally overmatched","note":"The piecemeal guns could not sustain a concentration against Porter’s abundant artillery and strong fields of fire."},{"label":"A. P. Hill attacks","value":"About 2:30 p.m. across more than a mile of Boatswain’s Swamp","note":"Precise timing and individual brigade locations are disputed. The episode emphasizes that Hill attacked without the support Lee expected."},{"label":"Gregg and Branch","value":"Their brigades gained no lasting breach in the Federal center","note":"The episode gives 315 casualties for the 1st South Carolina Rifles. Branch sent the 7th and 37th North Carolina first, then his other regiments. Col. Reuben P. Campbell was killed carrying the 7th’s colors."},{"label":"Anderson and Archer","value":"Repeated frontal efforts failed at the creek and slope","note":"Anderson attacked without artillery support, aided by two of Field’s regiments. Archer crossed exposed ground and neared the Federal line before withdrawing; one Alabama regiment lost its colors."},{"label":"Pender’s brief penetration","value":"The 16th and 22nd North Carolina temporarily entered the Federal line","note":"Federal reinforcements drove them back. Pender’s men rallied in the swamp but could not renew the advance successfully."},{"label":"Field ends Hill’s first effort","value":"Repulsed north of the Watt House after nearly two hours of attacks","note":"The brigade’s retreat closed A. P. Hill’s opening assault."},{"label":"Jackson’s wrong turn","value":"A misunderstood route forced a countermarch toward Old Cold Harbor","note":"Jackson had not clearly told his guide that he intended to pass around Gaines’s Mill. The episode estimates that the error left him about ninety minutes late; exact timing is uncertain."},{"label":"Longstreet’s changing orders","value":"First a diversion, then preparation for a full assault","note":"Four brigades crossed Powhite Creek as a demonstration. Lee soon asked for more, and Longstreet brought Anderson’s and Kemper’s brigades forward."},{"label":"Ewell redirected","value":"Lee sent Ewell’s three brigades toward A. P. Hill’s fight at about 3:30 p.m.","note":"Elzey’s, Trimble’s, and Richard Taylor’s brigades entered separately. Taylor was ill, so Col. Isaac G. Seymour commanded his brigade."},{"label":"Ewell’s attack fails","value":"Seymour and Roberdeau Wheat were killed while leading the Louisianans","note":"The episode calls Wheat’s wound mortal; other accounts state that he died on the field. A bullet struck Ewell’s boot, but he was not reported wounded. The attack stalled by about 5 p.m."},{"label":"Porter’s changing reports","value":"“All was well” shortly after 4 p.m.; urgent need for reinforcements at 5 p.m.","note":"By 5 p.m. Porter saw Longstreet and more of Jackson’s command arriving while his tired troops had expended substantial ammunition."},{"label":"Historical outcome beyond the episode","value":"Confederate victory after a coordinated assault near sunset","note":"The National Park Service summarizes the complete battle as a Confederate breakthrough followed by Porter’s withdrawal that night. Episode 161 narrates that climax."},{"label":"Recommended book","value":"The Seven Days: The Emergence of Lee by Clifford Dowdey","note":"The official podcast page confirms the title and author. The automated transcript renders the surname as “Dowdy.”"},{"label":"Transcript normalizations","value":"Powhite Creek, Boatswain’s Swamp, Sykes, Ewell, Elzey, Selwyn, and Roberdeau Wheat","note":"The transcript produces forms including “Powhat,” “Bosen/Bose,” “Yule,” “Elsie,” and “Roberto Wheat.”"}],"maps":[{"title":"Lee’s morning plan meets Porter’s actual position","caption":"Lee expected A. P. Hill and Longstreet to press a Federal line behind Powhite Creek while Jackson and D. H. Hill passed through Old Cold Harbor beyond its right. Instead, D. H. Hill met Sykes south of Old Cold Harbor and Gregg found Porter’s center behind Boatswain’s Swamp. Watercourses, roads, positions, and arrows are generalized. This map is schematic and not to scale.","source":"National Park Service, U.S. Army Center of Military History, Library of Congress historical maps, and episode transcript; see sources below.","image":"/images/ep160-plan-meets-position.svg","alt":"Schematic map comparing Lee’s expected Federal defense at Powhite Creek with Porter’s actual line behind Boatswain’s Swamp and showing broad Confederate approaches."},{"title":"The piecemeal attacks before 5 p.m.","caption":"A. P. Hill’s brigades attacked the Federal center in overlapping, poorly synchronized efforts. Ewell’s brigades later entered the northern sector separately, while Longstreet demonstrated against the Federal left and Slocum reinforced Porter. This diagram shows sequence and command relationships rather than exact regimental routes, formations, frontage, or geometry. It is schematic and not to scale.","source":"National Park Service, U.S. Army Center of Military History, Official Records, and episode transcript; see sources below.","image":"/images/ep160-initial-assaults.svg","alt":"Schematic troop-movement map of A. P. Hill’s attacks, Ewell’s later attacks, Longstreet’s diversion, and Slocum’s reinforcement."},{"title":"Robert Knox Sneden’s plan of Gaines’s Mill","caption":"Sneden’s wartime or immediate-postwar watercolor map places Powhite Creek, the Chickahominy, Cold Harbor, and color-coded forces in a single view. Its title incorrectly dates the battle June 26; Gaines’s Mill was fought June 27. It is a retrospective artifact, not the map Lee used during the battle.","source":"Library of Congress Geography and Map Division and Virginia Historical Society; see sources below.","image":"/images/ep160-sneden-map.jpg","alt":"Robert Knox Sneden’s color plan of Gaines’s Mill, with an incorrect June 26 date in its historical title."}],"moments":[{"time":"0:59","audioTime":59,"title":"Episode 160 begins","detail":"The hosts resume the Seven Days after Porter’s withdrawal from Beaver Dam Creek."},{"time":"2:33","audioTime":153,"title":"Confederates begin the pursuit","detail":"Lee’s columns find the Beaver Dam Creek line empty and move east after V Corps."},{"time":"2:57","audioTime":177,"title":"Lee’s plan is already wrong","detail":"He assumes McClellan will protect the York River supply route and Porter will defend Powhite Creek."},{"time":"4:28","audioTime":268,"title":"Porter occupies Boatswain’s Swamp","detail":"The Federal line lies east of Powhite Creek on high ground screened by a watercourse outside Lee’s expected scheme."},{"time":"5:11","audioTime":311,"title":"Four Confederate columns move east","detail":"The episode lays out the broad routes for Jackson, D. H. Hill, A. P. Hill, and Longstreet."},{"time":"6:48","audioTime":408,"title":"Jackson’s guns fire on A. P. Hill","detail":"Confederate artillery near Walnut Church mistakes A. P. Hill’s advancing column for the enemy."},{"time":"7:07","audioTime":427,"title":"Lee, Jackson, and A. P. Hill meet","detail":"Hill leaves after a short exchange; Lee and Jackson confer until about 11 a.m."},{"time":"8:21","audioTime":501,"title":"D. H. Hill finds the Federal right","detail":"South of Old Cold Harbor, Hill unexpectedly meets Sykes’s division and strong artillery."},{"time":"9:29","audioTime":569,"title":"Hill waits without informing Lee","detail":"D. H. Hill falls back toward Old Cold Harbor and awaits Jackson; Lee receives no prompt report."},{"time":"10:02","audioTime":602,"title":"Gregg crosses at Gaines’s Mill","detail":"Federal skirmishers yield Powhite Creek, and Gregg continues toward New Cold Harbor."},{"time":"10:21","audioTime":621,"title":"Boatswain’s Swamp stops Gregg","detail":"Heavy artillery fire checks the brigade and reveals Porter’s actual center."},{"time":"11:12","audioTime":672,"title":"Porter asks for Slocum","detail":"At about 2 p.m., Porter requests the division McClellan had earlier ordered north and then recalled."},{"time":"12:59","audioTime":779,"title":"Lee commits to the new battlefield","detail":"Lee moves forward and decides to break Porter’s unexpected position."},{"time":"15:03","audioTime":903,"title":"The artillery remains dispersed","detail":"Confederate batteries enter separately instead of massing against Porter’s guns."},{"time":"16:19","audioTime":979,"title":"A. P. Hill’s assault begins","detail":"The episode places the start at about 2:30 p.m. while acknowledging uncertainty over timing and locations."},{"time":"16:45","audioTime":1005,"title":"Gregg gains a foothold","detail":"The South Carolinians enter the swamp but cannot advance through Federal fire."},{"time":"17:39","audioTime":1059,"title":"Branch attacks in sections","detail":"The 7th and 37th North Carolina go first; the other regiments follow after they retreat."},{"time":"18:30","audioTime":1110,"title":"Anderson attacks without artillery","detail":"Anderson and two of Field’s regiments make repeated efforts that do not cross the defended stream."},{"time":"18:44","audioTime":1124,"title":"Archer crosses open ground","detail":"Archer’s brigade advances about 500 yards, approaches the Federal position, and breaks under heavy fire."},{"time":"19:15","audioTime":1155,"title":"Pender commits the reserve","detail":"Pender attacks after Branch and briefly gets two regiments into the Federal line."},{"time":"20:00","audioTime":1200,"title":"Field makes the last effort","detail":"Field attacks north of the Watt House and is repulsed, ending A. P. Hill’s first major assault."},{"time":"21:35","audioTime":1295,"title":"Jackson’s guide takes the direct road","detail":"Because the flanking purpose was not explained, the column heads toward Gaines’s Mill rather than around it."},{"time":"22:43","audioTime":1363,"title":"Jackson orders a countermarch","detail":"The column retraces part of its route while A. P. Hill fights without expected support."},{"time":"23:06","audioTime":1386,"title":"Lee continues the pressure","detail":"Lee sends for Jackson and Longstreet and commits to taking the plateau."},{"time":"24:09","audioTime":1449,"title":"Longstreet begins a diversion","detail":"Four brigades cross Powhite Creek and engage opposite Butterfield and Morell."},{"time":"24:51","audioTime":1491,"title":"The diversion becomes an assault order","detail":"Lee asks for a stronger effort, and Longstreet brings all six brigades forward."},{"time":"26:03","audioTime":1563,"title":"Jackson reaches Old Cold Harbor","detail":"The episode places his arrival at about 3 p.m., ahead of Whiting and Winder and out of contact with Ewell."},{"time":"27:25","audioTime":1645,"title":"Lee and Jackson send messengers","detail":"Lee’s aide looks for Jackson while Jackson’s engineer heads toward Lee, illustrating the fragmented information flow."},{"time":"28:04","audioTime":1684,"title":"Lee redirects Ewell","detail":"At about 3:30 p.m., Lee orders Ewell’s brigades to assist A. P. Hill."},{"time":"29:10","audioTime":1750,"title":"Seymour’s Louisianans attack","detail":"The brigade advances into intense fire; Seymour and Roberdeau Wheat are killed."},{"time":"29:48","audioTime":1788,"title":"Ewell’s effort stalls","detail":"By about 5 p.m., his brigades fall back among A. P. Hill’s formations."},{"time":"30:21","audioTime":1821,"title":"Porter reports that all is well","detail":"Shortly after 4 p.m., Slocum’s arrival gives Porter confidence that he can keep holding."},{"time":"31:38","audioTime":1898,"title":"Porter urgently asks for help","detail":"At 5 p.m., Confederate strength is building, the Federal troops are tired, and ammunition is running low."},{"time":"33:12","audioTime":1992,"title":"The book recommendation","detail":"The hosts recommend Clifford Dowdey’s The Seven Days: The Emergence of Lee."}],"command":[{"side":"United States","color":"#315f8c","branches":[{"commander":"Maj. Gen. George B. McClellan","command":"Army of the Potomac","subordinates":"Remained south of the Chickahominy and sent Slocum after Porter’s 2 p.m. request"},{"commander":"Brig. Gen. Fitz John Porter","command":"V Corps and attached reinforcements","subordinates":"George W. Morell held the west-facing sector; George Sykes held the north-facing sector; George A. McCall remained in reserve"},{"commander":"Brig. Gen. Henry W. Slocum","command":"VI Corps division reinforcing Porter","subordinates":"Approximately 8,500 men crossed north after Porter’s request"}]},{"side":"Confederacy","color":"#9a3d32","branches":[{"commander":"Gen. Robert E. Lee","command":"Army of Northern Virginia","subordinates":"Revised a plan built around Powhite Creek and tried to bring separated divisions into a general assault"},{"commander":"Maj. Gen. A. P. Hill","command":"Light Division in the Confederate center","subordinates":"Brigades of Gregg, Branch, Anderson, Archer, Pender, and Field attacked in the central action"},{"commander":"Maj. Gen. Thomas J. “Stonewall” Jackson","command":"Left wing approaching Old Cold Harbor","subordinates":"His column lost time to an unclear route and arrived too late to coordinate the afternoon attacks described here"},{"commander":"Maj. Gen. D. H. Hill","command":"Division on the Confederate left","subordinates":"Met Sykes, withdrew after an artillery exchange, and waited for Jackson without promptly informing Lee"},{"commander":"Maj. Gen. Richard S. Ewell","command":"Division redirected into A. P. Hill’s sector","subordinates":"Brigades of Elzey, Trimble, and Taylor—commanded that day by Seymour—entered separately"},{"commander":"Maj. Gen. James Longstreet","command":"Division on the Confederate right","subordinates":"First ordered to demonstrate, then told to prepare a full assault"}]}],"people":[{"name":"A. P. Hill","role":"Light Division commander whose brigades carried the principal early-afternoon assault","side":"Confederacy","image":"/images/ep160-ap-hill.jpg","source":"https://www.loc.gov/item/2022630549/"},{"name":"Thomas J. “Stonewall” Jackson","role":"Wing commander delayed by a wrong route and fragmented march","side":"Confederacy","image":"/images/ep160-stonewall-jackson.jpg","source":"https://www.loc.gov/item/2018670326/"},{"name":"Fitz John Porter","role":"V Corps commander who held behind Boatswain’s Swamp and requested reinforcements","side":"United States"},{"name":"Robert E. Lee","role":"Army commander who revised his plan after finding Porter east of Powhite Creek","side":"Confederacy"},{"name":"George B. McClellan","role":"Army of the Potomac commander whose headquarters remained south of the Chickahominy","side":"United States"},{"name":"D. H. Hill","role":"Division commander checked by Sykes near Old Cold Harbor","side":"Confederacy"},{"name":"George Sykes","role":"Federal division commander holding the north-facing sector","side":"United States"},{"name":"Henry W. Slocum","role":"Federal division commander sent across the Chickahominy to reinforce Porter","side":"United States"},{"name":"Maxcy Gregg","role":"Brigade commander whose South Carolinians discovered and attacked the actual line","side":"Confederacy"},{"name":"Lawrence O’Bryan Branch","role":"Brigade commander whose North Carolinians attacked in separate waves","side":"Confederacy"},{"name":"Joseph R. Anderson","role":"Brigade commander whose unsupported charges failed at the stream","side":"Confederacy"},{"name":"James J. Archer","role":"Brigade commander whose men crossed exposed ground before retreating","side":"Confederacy"},{"name":"William Dorsey Pender","role":"Brigade commander whose two regiments briefly penetrated the Federal line","side":"Confederacy"},{"name":"Charles W. Field","role":"Brigade commander whose repulse ended A. P. Hill’s first effort","side":"Confederacy"},{"name":"Richard S. Ewell","role":"Division commander redirected by Lee into the failing center","side":"Confederacy"},{"name":"James Longstreet","role":"Division commander ordered first to demonstrate and then to prepare a full assault","side":"Confederacy"},{"name":"Isaac G. Seymour","role":"Colonel commanding Richard Taylor’s Louisiana brigade in Taylor’s absence","side":"Confederacy"},{"name":"Chatham Roberdeau Wheat","role":"Major of the Louisiana Tigers killed while trying to lead the brigade","side":"Confederacy"}],"losses":[{"name":"Col. Reuben P. Campbell","side":"Confederacy","role":"Commander, 7th North Carolina Infantry, Branch’s brigade","outcome":"Killed while carrying the regiment’s colors during the attack"},{"name":"Col. Isaac G. Seymour","side":"Confederacy","role":"Acting commander, Richard Taylor’s Louisiana brigade","outcome":"Killed while leading the attack at Boatswain’s Swamp"},{"name":"Maj. Chatham Roberdeau Wheat","side":"Confederacy","role":"Commander, 1st Louisiana Special Battalion","outcome":"Killed while attempting to rally or lead the Louisiana attack after Seymour fell"}],"gallery":[{"image":"/images/ep160-plan-meets-position.svg","alt":"Schematic map of Confederate approaches and Porter’s unanticipated position.","caption":"Lee expected a stand at Powhite Creek; contact revealed a line behind Boatswain’s Swamp. Routes and positions are generalized.","source":"National Park Service, U.S. Army Center of Military History, Library of Congress historical maps, and episode transcript; see sources below."},{"image":"/images/ep160-initial-assaults.svg","alt":"Schematic diagram of attacks before 5 p.m. and Slocum’s reinforcement.","caption":"A. P. Hill and Ewell attacked in poorly synchronized waves while Longstreet demonstrated. The diagram shows relationships, not exact geometry.","source":"National Park Service, U.S. Army Center of Military History, Official Records, and episode transcript; see sources below."},{"image":"/images/ep160-sneden-map.jpg","alt":"Robert Knox Sneden’s color plan of Gaines’s Mill.","caption":"Sneden’s wartime or immediate-postwar interpretation incorrectly dates the battle June 26.","source":"Library of Congress Geography and Map Division and Virginia Historical Society; see sources below."},{"image":"/images/ep160-gaines-mill-waud.jpg","alt":"Alfred R. Waud’s field sketch of fighting at Gaines’s Mill.","caption":"Waud’s participant-era drawing conveys smoke, artillery, and infantry combat; it is not a surveyed rendering of positions.","source":"National Park Service reproduction; original credited by the park to the Library of Congress; see sources below."},{"image":"/images/ep160-ap-hill.jpg","alt":"Civil War-era photographic portrait of A. P. Hill.","caption":"Hill’s division opened the main afternoon fighting without the support Lee expected.","source":"Library of Congress Prints and Photographs Division; no known restrictions on publication; see sources below."},{"image":"/images/ep160-stonewall-jackson.jpg","alt":"Civil War-era photographic portrait of Stonewall Jackson.","caption":"Jackson’s delayed approach prevented the coordinated flank movement on which Lee’s plan depended.","source":"Library of Congress Prints and Photographs Division; no known restrictions on publication; see sources below."}],"sources":[{"label":"Official Civil War Podcast episode 160 page","url":"https://civilwarpodcast.org/2016/07/31/civil-war-podcast-episode-160/"},{"label":"National Park Service: The Battle of Gaines’s Mill","url":"https://www.nps.gov/rich/learn/historyculture/gainesmillbull.htm"},{"label":"National Park Service battle detail: Gaines’s Mill (VA017)","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=va017"},{"label":"National Park Service Civil War Series: The Battles for Richmond, 1862","url":"https://npshistory.com/publications/civil_war_series/21/sec5.htm"},{"label":"National Park Service: Gaines’s Mill Confederate Attack Trail","url":"https://www.nps.gov/rich/planyourvisit/upload/RICH-Gaines-Mill-2-21-2020finalpress-quality.pdf"},{"label":"U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862","url":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf"},{"label":"Primary source collection: Official Records, Series I, Volume XI, Part II","url":"https://ehistory.osu.edu/books/official-records/013"},{"label":"Official Records Atlas index for Gaines’s Mill maps","url":"https://ehistory.osu.edu/books/official-records/atlas_5"},{"label":"Library of Congress: Jacob Wells map of the Gaines’s Mill battlefield","url":"https://www.loc.gov/item/99439166/"},{"label":"Library of Congress: Robert Knox Sneden plan of Gaines’s Mill","url":"https://www.loc.gov/item/gvhs01.vhs00217/"},{"label":"Library of Congress: A. P. Hill portrait","url":"https://www.loc.gov/item/2022630549/"},{"label":"Library of Congress: Stonewall Jackson portrait","url":"https://www.loc.gov/item/2018670326/"},{"label":"Central Virginia Battlefields Trust: Lane’s North Carolina Brigade","url":"https://cvbt.org/the-scene-was-awful-lanes-north-carolina-brigade-on-central-virginias-battlefields/"},{"label":"Official podcast book-recommendations list","url":"https://civilwarpodcast.org/book-recommendations/"}]}}]}],"$L10",false,"$L11","$L12","$L13","$L14","$L15","$L16"]}]]}]
