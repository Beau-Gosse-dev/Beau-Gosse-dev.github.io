25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Remained south of the Chickahominy and sent Slocum after Porter’s 2 p.m. request"}]]}],["$","div","V Corps and attached reinforcements",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps and attached reinforcements"}],["$","span",null,{"children":"Brig. Gen. Fitz John Porter"}],["$","small",null,{"children":"George W. Morell held the west-facing sector; George Sykes held the north-facing sector; George A. McCall remained in reserve"}]]}],["$","div","VI Corps division reinforcing Porter",{"className":"command-entry","children":[["$","strong",null,{"children":"VI Corps division reinforcing Porter"}],["$","span",null,{"children":"Brig. Gen. Henry W. Slocum"}],["$","small",null,{"children":"Approximately 8,500 men crossed north after Porter’s request"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Revised a plan built around Powhite Creek and tried to bring separated divisions into a general assault"}]]}],["$","div","Light Division in the Confederate center",{"className":"command-entry","children":[["$","strong",null,{"children":"Light Division in the Confederate center"}],["$","span",null,{"