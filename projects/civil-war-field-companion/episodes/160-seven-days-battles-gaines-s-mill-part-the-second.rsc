1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",160," · ","June 27, 1862, approximately 10 a.m.–5 p.m."," · ","Hanover County, Virginia, north of the Chickahominy River: Walnut Church, Powhite Creek, New and Old Cold Harbor, Boatswain’s Swamp, and Porter’s line on the Turkey Hill plateau"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: GAINES'S MILL (Part the Second)"}],["$","span",null,{"className":"result-label","children":"By the endpoint of this installment, Porter’s reinforced V Corps still held behind Boatswain’s Swamp. D. H. Hill had checked his advance near Old Cold Harbor; A. P. Hill and Ewell had made costly, unsupported attacks; and Longstreet was preparing to turn a diversion into a full assault. The final Confederate breakthrough and Federal retreat occur in the next episode; the complete Battle of Gaines’s Mill was a Confederate victory"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3010518000.mp3?updated=1695326028","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The approach march and failed Confederate attacks before the final evening assault"}],["$","small",null,{"children":"The decisive breakthrough is outside this installment."}]]}],["$","div","Battle and campaign",{"children":[["$","span",null,{"children":"Battle and campaign"}],["$","strong",null,{"children":"Gaines’s Mill, the third of the Seven Days Battles"}],["$","small",null,{"children":"The fighting occurred on Friday, June 27, 1862, and is also called First Cold Harbor. The 1864 Battle of Cold Harbor was a separate engagement."}]]}],["$","div","Lee’s mistaken premise",{"children":[["$","span",null,{"children":"Lee’s mistaken premise"}],["$","strong",null,{"children":"Porter would defend Powhite Creek and the route to White House Landing"}],["$","small",null,{"children":"McClellan had decided to abandon that supply route. Porter instead occupied stronger ground about half a mile east, behind Boatswain’s Swamp."}]]}],["$","div","Planned hammer and anvil",{"children":[["$","span",null,{"children":"Planned hammer and anvil"}],["$","strong",null,{"children":"A. P. Hill and Longstreet drive east while Jackson and D. H. Hill turn the Federal right"}],["$","small",null,{"children":"The concept became obsolete when Confederate troops found Porter facing west and north behind Boatswain’s Swamp."}]]}],["$","div","Morning movements",{"children":[["$","span",null,{"children":"Morning movements"}],["$","strong",null,{"children":"Lee’s army advanced east on four roads north of the Chickahominy"}],["$","small",null,{"children":"The episode follows Jackson and D. H. Hill toward Old Cold Harbor, A. P. Hill toward Walnut Church and New Cold Harbor, and Longstreet toward River Road. Map routes are generalized."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}],"$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
2b:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Lee and Jackson confer",{"children":[["$","span",null,{"children":"Lee and Jackson confer"}],["$","strong",null,{"children":"Approximately 10–11 a.m. near Walnut Church"}],["$","small",null,{"children":"Jackson’s guns had mistakenly fired toward A. P. Hill’s troops nearby. Their staffs did not hear the later conversation; the episode’s claim that Lee restated Jackson’s role is an inference."}]]}]
f:["$","div","D. H. Hill meets Sykes",{"children":[["$","span",null,{"children":"D. H. Hill meets Sykes"}],["$","strong",null,{"children":"A substantial Federal line blocks the approach south of Old Cold Harbor"}],["$","small",null,{"children":"After a sharp and unfavorable artillery exchange, Hill fell back, deployed near the crossroads, and waited for Jackson."}]]}]
10:["$","div","Information failure",{"children":[["$","span",null,{"children":"Information failure"}],["$","strong",null,{"children":"Lee did not promptly learn of D. H. Hill’s contact"}],["$","small",null,{"children":"The episode cites an acoustic shadow and notes that Hill sent no messenger. The atmospheric explanation is the podcast’s interpretation; the absence of a timely report is the direct command problem."}]]}]
11:["$","div","Gregg finds the actual line",{"children":[["$","span",null,{"children":"Gregg finds the actual line"}],["$","strong",null,{"children":"Across Powhite Creek, through New Cold Harbor, and down toward Boatswain’s Swamp"}],["$","small",null,{"children":"Gregg pushed aside skirmishers near Gaines’s Mill, then met heavy artillery fire farther east and reported the previously unknown defensive line."}]]}]
12:["$","div","Porter requests Slocum",{"children":[["$","span",null,{"children":"Porter requests Slocum"}],["$","strong",null,{"children":"About 2 p.m."}],["$","small",null,{"children":"McClellan had recalled Slocum because he feared an attack south of the river. After Porter’s request, Slocum was again sent north."}]]}]
13:["$","div","Strengths in the episode",{"children":[["$","span",null,{"children":"Strengths in the episode"}],["$","strong",null,{"children":"About 55,000–60,000 Confederates; Porter rose from roughly 27,000 to 34,000–35,000"}],["$","small",null,{"children":"The episode uses nearly 55,000 Confederates and about 35,000 Federals after Slocum’s 8,500 arrived. The National Park Service uses approximately 60,000 and 34,000. Totals vary by time and counting method."}]]}]
14:["$","div","Confederate artillery",{"children":[["$","span",null,{"children":"Confederate artillery"}],["$","strong",null,{"children":"Batteries entered separately and were generally overmatched"}],["$","small",null,{"children":"The piecemeal guns could not sustain a concentration against Porter’s abundant artillery and strong fields of fire."}]]}]
15:["$","div","A. P. Hill attacks",{"children":[["$","span",null,{"children":"A. P. Hill attacks"}],["$","strong",null,{"children":"About 2:30 p.m. across more than a mile of Boatswain’s Swamp"}],["$","small",null,{"children":"Precise timing and individual brigade locations are disputed. The episode emphasizes that Hill attacked without the support Lee expected."}]]}]
16:["$","div","Gregg and Branch",{"children":[["$","span",null,{"children":"Gregg and Branch"}],["$","strong",null,{"children":"Their brigades gained no lasting breach in the Federal center"}],["$","small",null,{"children":"The episode gives 315 casualties for the 1st South Carolina Rifles. Branch sent the 7th and 37th North Carolina first, then his other regiments. Col. Reuben P. Campbell was killed carrying the 7th’s colors."}]]}]
17:["$","div","Anderson and Archer",{"children":[["$","span",null,{"children":"Anderson and Archer"}],["$","strong",null,{"children":"Repeated frontal efforts failed at the creek and slope"}],["$","small",null,{"children":"Anderson attacked without artillery support, aided by two of Field’s regiments. Archer crossed exposed ground and neared the Federal line before withdrawing; one Alabama regiment lost its colors."}]]}]
18:["$","div","Pender’s brief penetration",{"children":[["$","span",null,{"children":"Pender’s brief penetration"}],["$","strong",null,{"children":"The 16th and 22nd North Carolina temporarily entered the Federal line"}],["$","small",null,{"children":"Federal reinforcements drove them back. Pender’s men rallied in the swamp but could not renew the advance successfully."}]]}]
19:["$","div","Field ends Hill’s first effort",{"children":[["$","span",null,{"children":"Field ends Hill’s first effort"}],["$","strong",null,{"children":"Repulsed north of the Watt House after nearly two hours of attacks"}],["$","small",null,{"children":"The brigade’s retreat closed A. P. Hill’s opening assault."}]]}]
1a:["$","div","Jackson’s wrong turn",{"children":[["$","span",null,{"children":"Jackson’s wrong turn"}],["$","strong",null,{"children":"A misunderstood route forced a countermarch toward Old Cold Harbor"}],["$","small",null,{"children":"Jackson had not clearly told his guide that he intended to pass around Gaines’s Mill. The episode estimates that the error left him about ninety minutes late; exact timing is uncertain."}]]}]
1b:["$","div","Longstreet’s changing orders",{"children":[["$","span",null,{"children":"Longstreet’s changing orders"}],["$","strong",null,{"children":"First a diversion, then preparation for a full assault"}],["$","small",null,{"children":"Four brigades crossed Powhite Creek as a demonstration. Lee soon asked for more, and Longstreet brought Anderson’s and Kemper’s brigades forward."}]]}]
1c:["$","div","Ewell redirected",{"children":[["$","span",null,{"children":"Ewell redirected"}],["$","strong",null,{"children":"Lee sent Ewell’s three brigades toward A. P. Hill’s fight at about 3:30 p.m."}],["$","small",null,{"children":"Elzey’s, Trimble’s, and Richard Taylor’s brigades entered separately. Taylor was ill, so Col. Isaac G. Seymour commanded his brigade."}]]}]
1d:["$","div","Ewell’s attack fails",{"children":[["$","span",null,{"children":"Ewell’s attack fails"}],["$","strong",null,{"children":"Seymour and Roberdeau Wheat were killed while leading the Louisianans"}],["$","small",null,{"children":"The episode calls Wheat’s wound mortal; other accounts state that he died on the field. A bullet struck Ewell’s boot, but he was not reported wounded. The attack stalled by about 5 p.m."}]]}]
1e:["$","div","Porter’s changing reports",{"children":[["$","span",null,{"children":"Porter’s changing reports"}],["$","strong",null,{"children":"“All was well” shortly after 4 p.m.; urgent need for reinforcements at 5 p.m."}],["$","small",null,{"children":"By 5 p.m. Porter saw Longstreet and more of Jackson’s command arriving while his tired troops had expended substantial ammunition."}]]}]
1f:["$","div","Historical outcome beyond the episode",{"children":[["$","span",null,{"children":"Historical outcome beyond the episode"}],["$","strong",null,{"children":"Confederate victory after a coordinated assault near sunset"}],["$","small",null,{"children":"The National Park Service summarizes the complete battle as a Confederate breakthrough followed by Porter’s withdrawal that night. Episode 161 narrates that climax."}]]}]
20:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"The Seven Days: The Emergence of Lee by Clifford Dowdey"}],["$","small",null,{"children":"The official podcast page confirms the title and author. The automated transcript renders the surname as “Dowdy.”"}]]}]
21:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Powhite Creek, Boatswain’s Swamp, Sykes, Ewell, Elzey, Selwyn, and Roberdeau Wheat"}],["$","small",null,{"children":"The transcript produces forms including “Powhat,” “Bosen/Bose,” “Yule,” “Elsie,” and “Roberto Wheat.”"}]]}]
22:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
23:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Lee’s morning plan meets Porter’s actual position",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep160-plan-meets-position.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Lee’s morning plan meets Porter’s actual position at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep160-plan-meets-position.svg","alt":"Schematic map comparing Lee’s expected Federal defense at Powhite Creek with Porter’s actual line behind Boatswain’s Swamp and showing broad Confederate approaches.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Lee’s morning plan meets Porter’s actual position"}],["$","span",null,{"children":"Lee expected A. P. Hill and Longstreet to press a Federal line behind Powhite Creek while Jackson and D. H. Hill passed through Old Cold Harbor beyond its right. Instead, D. H. Hill met Sykes south of Old Cold Harbor and Gregg found Porter’s center behind Boatswain’s Swamp. Watercourses, roads, positions, and arrows are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep160-plan-meets-position.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Library of Congress historical maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The piecemeal attacks before 5 p.m.",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep160-initial-assaults.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The piecemeal attacks before 5 p.m. at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep160-initial-assaults.svg","alt":"Schematic troop-movement map of A. P. Hill’s attacks, Ewell’s later attacks, Longstreet’s diversion, and Slocum’s reinforcement.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The piecemeal attacks before 5 p.m."}],["$","span",null,{"children":"A. P. Hill’s brigades attacked the Federal center in overlapping, poorly synchronized efforts. Ewell’s brigades later entered the northern sector separately, while Longstreet demonstrated against the Federal left and Slocum reinforced Porter. This diagram shows sequence and command relationships rather than exact regimental routes, formations, frontage, or geometry. It is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep160-initial-assaults.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],"$L2a"]}]]}]
24:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Episode 160 begins",{"className":"moment","children":[["$","$L2b",null,{"seconds":59,"label":"0:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Episode 160 begins"}],["$","p",null,{"children":"The hosts resume the Seven Days after Porter’s withdrawal from Beaver Dam Creek."}]]}]]}],["$","div","Confederates begin the pursuit",{"className":"moment","children":[["$","$L2b",null,{"seconds":153,"label":"2:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederates begin the pursuit"}],["$","p",null,{"children":"Lee’s columns find the Beaver Dam Creek line empty and move east after V Corps."}]]}]]}],["$","div","Lee’s plan is already wrong",{"className":"moment","children":[["$","$L2b",null,{"seconds":177,"label":"2:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s plan is already wrong"}],["$","p",null,{"children":"He assumes McClellan will protect the York River supply route and Porter will defend Powhite Creek."}]]}]]}],["$","div","Porter occupies Boatswain’s Swamp",{"className":"moment","children":[["$","$L2b",null,{"seconds":268,"label":"4:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Porter occupies Boatswain’s Swamp"}],["$","p",null,{"children":"The Federal line lies east of Powhite Creek on high ground screened by a watercourse outside Lee’s expected scheme."}]]}]]}],["$","div","Four Confederate columns move east",{"className":"moment","children":[["$","$L2b",null,{"seconds":311,"label":"5:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Four Confederate columns move east"}],["$","p",null,{"children":"The episode lays out the broad routes for Jackson, D. H. Hill, A. P. Hill, and Longstreet."}]]}]]}],["$","div","Jackson’s guns fire on A. P. Hill",{"className":"moment","children":[["$","$L2b",null,{"seconds":408,"label":"6:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson’s guns fire on A. P. Hill"}],["$","p",null,{"children":"Confederate artillery near Walnut Church mistakes A. P. Hill’s advancing column for the enemy."}]]}]]}],["$","div","Lee, Jackson, and A. P. Hill meet",{"className":"moment","children":[["$","$L2b",null,{"seconds":427,"label":"7:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee, Jackson, and A. P. Hill meet"}],["$","p",null,{"children":"Hill leaves after a short exchange; Lee and Jackson confer until about 11 a.m."}]]}]]}],["$","div","D. H. Hill finds the Federal right",{"className":"moment","children":[["$","$L2b",null,{"seconds":501,"label":"8:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"D. H. Hill finds the Federal right"}],["$","p",null,{"children":"South of Old Cold Harbor, Hill unexpectedly meets Sykes’s division and strong artillery."}]]}]]}],["$","div","Hill waits without informing Lee",{"className":"moment","children":[["$","$L2b",null,{"seconds":569,"label":"9:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hill waits without informing Lee"}],["$","p",null,{"children":"D. H. Hill falls back toward Old Cold Harbor and awaits Jackson; Lee receives no prompt report."}]]}]]}],["$","div","Gregg crosses at Gaines’s Mill",{"className":"moment","children":[["$","$L2b",null,{"seconds":602,"label":"10:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gregg crosses at Gaines’s Mill"}],["$","p",null,{"children":"Federal skirmishers yield Powhite Creek, and Gregg continues toward New Cold Harbor."}]]}]]}],["$","div","Boatswain’s Swamp stops Gregg",{"className":"moment","children":[["$","$L2b",null,{"seconds":621,"label":"10:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Boatswain’s Swamp stops Gregg"}],["$","p",null,{"children":"Heavy artillery fire checks the brigade and reveals Porter’s actual center."}]]}]]}],["$","div","Por