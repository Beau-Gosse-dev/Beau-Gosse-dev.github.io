f:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Atlanta had become central to the 1864 campaign",{"className":"moment","children":[["$","$L14",null,{"seconds":77,"label":"1:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Atlanta had become central to the 1864 campaign"}],["$","p",null,{"children":"The campaign in Georgia affected military planning and public opinion while the U.S. presidential election approached and fighting continued in Virginia."}]]}]]}],["$","div","George Petty warned his family about the U.S. advance",{"className":"moment","children":[["$","$L14",null,{"seconds":169,"label":"2:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"George Petty warned his family about the U.S. advance"}],["$","p",null,{"children":"The Confederate surgeon wrote from a field hospital outside Atlanta and told his wife how to prepare if U.S. troops reached their home."}]]}]]}],["$","div","Louise Wigfall described evacuation by hospital train",{"className":"moment","children":[["$","$L14",null,{"seconds":287,"label":"4:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Louise Wigfall described evacuation by hospital train"}],["$","p",null,{"children":"Wigfall and her sister left Atlanta for Macon in a crowded train carrying sick, wounded, and dying Confederate soldiers."}]]}]]}],["$","div","Richmond ordered Johnston to transfer command",{"className":"moment","children":[["$","$L14",null,{"seconds":454,"label":"7:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richmond ordered Johnston to transfer command"}],["$","p",null,{"children":"The order arrived on the night of July 17 and directed Joseph E. Johnston to turn the Army of Tennessee over to John B. Hood."}]]}]]}],["$","div","Hood asked Johnston to remain temporarily",{"className":"moment","children":[["$","$L14",null,{"seconds":497,"label":"8:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood asked Johnston to remain temporarily"}],["$","p",null,{"children":"Hood rode to Johnston’s headquarters before dawn and asked him to stay until the immediate crisis passed. Johnston refused."}]]}]]}],["$","div","Davis refused to delay the transfer",{"className":"moment","children":[["$","$L14",null,{"seconds":555,"label":"9:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis refused to delay the transfer"}],["$","p",null,{"children":"Hood, Hardee, and Stewart asked Jefferson Davis to postpone the change until Atlanta’s fate was decided. Davis kept the order in effect."}]]}]]}],["$","div","Johnston left for Macon",{"className":"moment","children":[["$","$L14",null,{"seconds":568,"label":"9:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston left for Macon"}],["$","p",null,{"children":"Johnston departed on July 18. Soldiers passing his headquarters removed their hats, and some officers left formation to shake his hand."}]]}]]}],["$","div","Hood had not commanded an army before",{"className":"moment","children":[["$","$L14",null,{"seconds":645,"label":"10:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood had not commanded an army before"}],["$","p",null,{"children":"Hood was 33 and had a strong combat record at brigade and division level. Robert E. Lee and W. H. T. Walker questioned whether he had the qualities needed for army command."}]]}]]}],["$","div","Atlanta residents learned of the change",{"className":"moment","children":[["$","$L14",null,{"seconds":834,"label":"13:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Atlanta residents learned of the change"}],["$","p",null,{"children":"Samuel Richards recorded the news in his diary and expected Hood’s appointment to bring a battle before Atlanta was abandoned."}]]}]]}],["$","div","The episode reviews Hood’s military career",{"className":"moment","children":[["$","$L14",null,{"seconds":875,"label":"14:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode reviews Hood’s military career"}],["$","p",null,{"children":"Hood graduated from West Point in 1853, served in the 2nd U.S. Cavalry, and rose from regimental to corps command in Confederate service."}]]}]]}],"$L15","$L16"]}]]}]
