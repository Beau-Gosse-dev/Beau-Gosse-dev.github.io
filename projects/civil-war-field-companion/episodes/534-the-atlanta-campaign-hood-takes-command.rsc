"children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"July 17–18, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Atlanta, Georgia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"John B. Hood replaced Joseph E. Johnston"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"July 17–18, 1864","place":"Atlanta, Georgia","result":"John B. Hood replaced Joseph E. Johnston","facts":[{"label":"Order issued","value":"Night of July 17, 1864"},{"label":"Outgoing commander","value":"Joseph E. Johnston"},{"label":"Incoming commander","value":"John B. Hood, age 33"},{"label":"Immediate military situation","value":"Sherman’s armies were moving toward Atlanta from the north and east"}],"maps":[{"title":"Atlanta and Decatur today","caption":"The Confederate command changed while Sherman’s armies advanced from Chattahoochee River crossings north and east of Atlanta.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.56%2C33.67%2C-84.16%2C33.94&layer=mapnik&marker=33.755%2C-84.39"},{"title":"Atlanta campaign operations","caption":"This U.S. Army map shows the roads, railroads, rivers, fortifications, and lines of operation around Atlanta.","source":"https://www.loc.gov/item/99447303/","image":"/images/peachtree-operations-map.jpg","alt":"1875 military operations map of Atlanta and the surrounding region"}],"moments":[{"time":"1:17","audioTime":77,"title":"Atlanta had become central to the 1864 campaign","detail":"The campaign in Georgia affected military planning and public opinion while the U.S. presidential election approached and fighting continued in Virginia."},{"time":"2:49","audioTime":169,"title":"George Petty warned his family about the U.S. advance","detail":"The Confederate surgeon wrote from a field hospital outside Atlanta and told his wife how to prepare if U.S. troops reached their home."},{"time":"4:47","audioTime":287,"title":"Louise Wigfall described evacuation by hospital train","detail":"Wigfall and her sister left Atlanta for Macon in a crowded train carrying sick, wounded, and dying Confederate soldiers."},{"time":"7:34","audioTime":454,"title":"Richmond ordered Johnston to transfer command","detail":"The order arrived on the night of July 17 and directed Joseph E. Johnston to turn the Army of Tennessee over to John B. Hood."},{"time":"8:17","audioTime":497,"title":"Hood asked Johnston to remain temporarily","detail":"Hood rode to Johnston’s headquarters before dawn and asked him to stay until the immediate crisis passed. Johnston refused."},{"time":"9:15","audioTime":555,"title":"Davis refused to delay the transfer","detail":"Hood, Hardee, and Stewart asked Jefferson Davis to postpone the change until Atlanta’s fate was decided. Davis kept the order in effect."},{"time":"9:28","audioTime":568,"title":"Johnston left for Macon","detail":"Johnston departed on July 18. Soldiers passing his headquarters removed their hats, and some officers left formation to shake his hand."},{"time":"10:45","audioTime":645,"title":"Hood had not commanded an army before","detail":"Hood was 33 and had a strong combat record at brigade and division level. Robert E. Lee and W. H. T. Walker questioned whether he had the qualities needed for army command."},{"time":"13:54","audioTime":834,"title":"Atlanta residents learned of the change","detail":"Samuel Richards recorded the news in his diary and expected Hood’s appointment to bring a battle before Atlanta was abandoned."},{"time":"14:35","audioTime":875,"title":"The episode reviews Hood’s military career","detail":"Hood graduated from West Point in 1853, served in the 2nd U.S. Cavalry, and rose from regimental to corps command in Confederate service."},{"time":"19:16","audioTime":1156,"title":"Hood returned after two severe wounds","detail":"A wound at Gettysburg disabled his left arm. A wound at Chickamauga led to the amputation of his right leg, but he returned to field command in 1864."},{"time":"20:55","audioTime":1255,"title":"Davis chose an offensive commander","detail":"Davis rejected Johnston’s continued withdrawals and selected Hood from within the army. Hardee was the only other practical internal candidate discussed in the episode."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"George H. Thomas, John M. Schofield, and James B. McPherson"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Advanced toward Atlanta from the north"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"Advanced northeast of Atlanta"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Advanced toward Decatur"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Jefferson Davis","command":"Confederate president","subordinates":"Ordered the change of army command"},{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Relieved on July 17"},{"commander":"John B. Hood","command":"Army of Tennessee","subordinates":"Assumed command on July 18"},{"commander":"William J. Hardee","command":"Hardee's Corps","subordinates":"Senior corps commander"},{"commander":"Alexander P. Stewart","command":"Stewart's Corps","subordinates":"Corps commander"}]}],"people":[{"name":"Joseph E. Johnston","role":"Outgoing commander whose troops had retreated from Dalton to Atlanta","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"John B. Hood","role":"Incoming commander of the Army of Tennessee","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"George W. Petty","role":"56th Georgia Infantry surgeon whose letter describes the threat to his family’s home","side":"Confederacy"},{"name":"Louise Wigfall","role":"Civilian whose account describes leaving Atlanta on a Confederate hospital train","side":"Confederacy"},{"name":"James Nisbet","role":"66th Georgia colonel who described soldiers’ farewell to Johnston","side":"Confederacy"},{"name":"Samuel Richards","role":"Atlanta civilian whose diary recorded local reaction to Hood’s appointment","side":"Confederacy"},{"name":"W. H. T. Walker","role":"Division commander who privately questioned Hood’s readiness for army command","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/atlanta-railroad-depot.jpg","alt":"Atlanta railroad depot photographed in 1864","caption":"Atlanta’s railroad depot, photographed after U.S. forces captured the city in 1864.","source":"https://www.loc.gov/item/2018666982/"},{"image":"/images/atlanta-fortifications.jpg","alt":"Confederate earthwork fortifications at Atlanta in 1864","caption":"Confederate fortifications at Atlanta, photographed in 1864.","source":"https://www.loc.gov/item/2018670937/"}],"sources":[{"label":"Official Episode 534 page","url":"https://civilwarpodcast.org/2026/07/19/civil-war-podcast-episode-534/"},{"label":"Episode 534 transcript index","url":"https://podcastrex.com/shows/the-civil-war-reconstruction/534-the-atlanta-campaign-hood-takes-command"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Joseph E. Johnston portrait","url":"https://www.loc.gov/item/2018666539/"},{"label":"Library of Congress Atlanta operations map","url":"https://www.loc.gov/item/99447303/"},{"label":"Library of Congress Atlanta railroad depot photograph","url":"https://www.loc.gov/item/2018666982/"},{"label":"Library of Congress Atlanta fortifications photograph","url":"https://www.loc.gov/item/2018670937/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
