15:["$","div","Hood returned after two severe wounds",{"className":"moment","children":[["$","$L14",null,{"seconds":1156,"label":"19:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood returned after two severe wounds"}],["$","p",null,{"children":"A wound at Gettysburg disabled his left arm. A wound at Chickamauga led to the amputation of his right leg, but he returned to field command in 1864."}]]}]]}]
