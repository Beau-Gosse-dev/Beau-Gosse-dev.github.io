28:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
2a:["$","p",null,{"children":"Bragg could block a southeastward move from Louisville but was too distant to threaten the city or prevent Buell’s buildup."}]
2b:["$","div","The Confederate armies remain separated",{"className":"moment","children":[["$","$L29",null,{"seconds":537,"label":"8:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate armies remain separated"}],["$","p",null,{"children":"Bragg and Kirby Smith controlled much of central and eastern Kentucky but had not coordinated their forces, leaving them open to defeat in detail."}]]}]]}]
2c:["$","div","Bragg pauses the campaign",{"className":"moment","children":[["$","$L29",null,{"seconds":570,"label":"9:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg pauses the campaign"}],["$","p",null,{"children":"Expecting a long United States refit, Bragg consolidated his gains and passed the initiative to Buell."}]]}]]}]
2d:["$","div","Buell’s veterans reach Louisville",{"className":"moment","children":[["$","$L29",null,{"seconds":686,"label":"11:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell’s veterans reach Louisville"}],["$","p",null,{"children":"The Army of the Ohio arrived September 25–28 after withdrawing about 300 miles from the Chattanooga approaches."}]]}]]}]
2e:["$","div","The army briefly loses cohesion",{"className":"moment","children":[["$","$L29",null,{"seconds":768,"label":"12:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army briefly loses cohesion"}],["$","p",null,{"children":"Exhausted soldiers refitted, visited the city, or went home without leave, but the force had recovered by September 30."}]]}]]}]
2f:["$","div","Orders arrive to replace Buell",{"className":"moment","children":[["$","$L29",null,{"seconds":796,"label":"13:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Orders arrive to replace Buell"}],["$","p",null,{"children":"General-in-Chief Henry Halleck sent orders naming George Thomas as the new commander, with an exception if Buell was preparing to fight."}]]}]]}]
30:["$","div","The relief order reaches Louisville",{"className":"moment","children":[["$","$L29",null,{"seconds":833,"label":"13:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"The relief order reaches Louisville"}],["$","p",null,{"children":"On September 29 Buell was already reorganizing and preparing an offensive, yet he immediately began transferring command."}]]}]]}]
31:["$","div","Thomas asks that Buell remain",{"className":"moment","children":[["$","$L29",null,{"seconds":853,"label":"14:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas asks that Buell remain"}],["$","p",null,{"children":"Thomas told Halleck that he lacked the information needed to assume responsibility; Halleck suspended the relief order."}]]}]]}]
32:["$","div","Reinforcements swell the army",{"className":"moment","children":[["$","$L29",null,{"seconds":919,"label":"15:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Reinforcements swell the army"}],["$","p",null,{"children":"About 75,000 men were present, but the large number of newly enlisted soldiers threatened marching and fighting efficiency."}]]}]]}]
33:["$","div","Buell loses an experienced subordinate",{"className":"moment","children":[["$","$L29",null,{"seconds":965,"label":"16:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell loses an experienced subordinate"}],["$","p",null,{"children":"On the same day he survived the attempted command change, Maj. Gen. William “Bull” Nelson was killed in Louisville."}]]}]]}]
34:["$","div","Nelson arrests Jefferson C. Davis",{"className":"moment","children":[["$","$L29",null,{"seconds":1000,"label":"16:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nelson arrests Jefferson C. Davis"}],["$","p",null,{"children":"Their dispute over Nelson’s contempt for Indiana troops led Nelson to order Davis to Cincinnati on September 25; Horatio Wright released him."}]]}]]}]
35:["$","div","The generals meet at the Galt House",{"className":"moment","children":[["$","$L29",null,{"seconds":1028,"label":"17:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The generals meet at the Galt House"}],["$","p",null,{"children":"Davis, Indiana governor Oliver P. Morton, and their party encountered Nelson in the Louisville hotel lobby on September 29."}]]}]]}]
36:["$","div","Davis shoots Nelson",{"className":"moment","children":[["$","$L29",null,{"seconds":1052,"label":"17:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis shoots Nelson"}],["$","p",null,{"children":"After Nelson slapped him and walked away, Davis obtained a pistol, followed him upstairs, and shot him in the chest. Nelson died about an hour later."}]]}]]}]
37:["$","div","Buell announces a corps organization",{"className":"moment","children":[["$","$L29",null,{"seconds":1070,"label":"17:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell announces a corps organization"}],["$","p",null,{"children":"The Army of the Ohio was divided into First, Second, and Third Corps, each containing roughly 25,000 infantry, artillery, and cavalry."}]]}]]}]
38:["$","div","McCook receives First Corps",{"className":"moment","children":[["$","$L29",null,{"seconds":1108,"label":"18:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCook receives First Corps"}],["$","p",null,{"children":"Alexander McCook commanded the divisions of Joshua Sill, Lovell Rousseau, and James Jackson."}]]}]]}]
39:["$","div","Crittenden receives Second Corps",{"className":"moment","children":[["$","$L29",null,{"seconds":1159,"label":"19:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Crittenden receives Second Corps"}],["$","p",null,{"children":"Thomas L. Crittenden commanded divisions under William Sooy Smith, Horatio Van Cleve, and Thomas J. Wood."}]]}]]}]
3a:["$","div","Nelson’s death leaves Third Corps open",{"className":"moment","children":[["$","$L29",null,{"seconds":1225,"label":"20:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nelson’s death leaves Third Corps open"}],["$","p",null,{"children":"Buell selected acting Maj. Gen. Charles C. Gilbert over division commander Albin F. Schoepf."}]]}]]}]
3b:["$","div","Third Corps contains three divisions",{"className":"moment","children":[["$","$L29",null,{"seconds":1235,"label":"20:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Third Corps contains three divisions"}],["$","p",null,{"children":"Its divisions were commanded by Schoepf, Robert B. Mitchell, and Philip H. Sheridan."}]]}]]}]
3c:["$","div","Green troops suffer during drill",{"className":"moment","children":[["$","$L29",null,{"seconds":1304,"label":"21:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Green troops suffer during drill"}],["$","p",null,{"children":"A prolonged review under James Jackson and William Terrill produced numerous heat casualties and four deaths."}]]}]]}]
3d:["$","div","Buell chooses the offensive",{"className":"moment","children":[["$","$L29",null,{"seconds":1342,"label":"22:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell chooses the offensive"}],["$","p",null,{"children":"Remaining at Louisville would allow the Confederates to consolidate; Buell instead prepared to drive into central Kentucky."}]]}]]}]
3e:["$","div","The Wilderness Road becomes the objective",{"className":"moment","children":[["$","$L29",null,{"seconds":1376,"label":"22:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Wilderness Road becomes the objective"}],["$","p",null,{"children":"A move toward Bardstown and Camp Breckinridge threatened the Confederate supply and retreat route to Tennessee."}]]}]]}]
3f:["$","div","Buell forms four columns",{"className":"moment","children":[["$","$L29",null,{"seconds":1422,"label":"23:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell forms four columns"}],["$","p",null,{"children":"Sill and Dumont took about 20,000 men toward Frankfort as a feint while roughly 55,000 marched in three columns toward Bardstown."}]]}]]}]
40:["$","div","Bragg leaves Polk at Bardstown",{"className":"moment","children":[["$","$L29",null,{"seconds":1465,"label":"24:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg leaves Polk at Bardstown"}],["$","p",null,{"children":"Bragg rode to Lexington, met Kirby Smith, and assumed formal command of all Confederate forces in Kentucky."}]]}]]}]
41:["$","div","A Confederate government ceremony is scheduled",{"className":"moment","children":[["$","$L29",null,{"seconds":1516,"label":"25:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"A Confederate government ceremony is scheduled"}],["$","p",null,{"children":"Richard Hawes agreed to be installed at Frankfort on October 4 as the Confederacy’s claimant to Kentucky’s governorship."}]]}]]}]
42:["$","div","The Army of the Ohio marches",{"className":"moment","children":[["$","$L29",null,{"seconds":1525,"label":"25:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of the Ohio marches"}],["$","p",null,{"children":"Buell began his advance on October 1, less than one week after the first veterans entered Louisville."}]]}]]}]
43:["$","div","The episode recommends Marshall",{"className":"moment","children":[["$","$L29",null,{"seconds":1557,"label":"25:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode recommends Marshall"}],["$","p",null,{"children":"Creating a Confederate Kentucky explains how postwar memory recast a state that had remained in the Union."}]]}]]}]
44:["$","div","Army of the Mississippi at Bardstown-Maj. Gen. Leonidas Polk",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Mississippi at Bardstown"}],["$","span",null,{"children":"Maj. Gen. Leonidas Polk"}],["$","small",null,{"children":"Received command at Bardstown when Bragg departed to meet Kirby Smith in Lexington."}]]}]
45:["$","div","Army of Kentucky-Maj. Gen. Edmund Kirby Smith",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Kentucky"}],["$","span",null,{"children":"Maj. Gen. Edmund Kirby Smith"}],["$","small",null,{"children":"Held roughly 18,000 men near Lexington, supplied Bragg, and resisted moving promptly into a field junction that would place him under Bragg."}]]}]
46:["$","div","Kentucky recruiting effort-Brig. Gen. Simon B. Buckner",{"className":"command-entry","children":[["$","strong",null,{"children":"Kentucky recruiting effort"}],["$","span",null,{"children":"Brig. Gen. Simon B. Buckner"}],["$","small",null,{"children":"Sent to Camp Breckinridge, formerly Camp Dick Robinson, to organize Confederate recruits."}]]}]
