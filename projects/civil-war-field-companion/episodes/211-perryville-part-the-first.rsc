1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",211," · ","September 20–October 1, 1862"," · ","Central Kentucky, principally Bardstown, Louisville, Lexington, Frankfort, Camp Breckinridge, and the roads leading toward Perryville and Danville"]}],["$","h1",null,{"children":"PERRYVILLE (Part the First)"}],["$","span",null,{"className":"result-label","children":"The initiative passed to the United States. Braxton Bragg paused at Bardstown, failed to obtain the large body of Kentucky recruits he expected, and did not promptly unite with Edmund Kirby Smith. Don Carlos Buell retained command, reorganized the Army of the Ohio into three corps, and marched from Louisville on October 1 with about 55,000 soldiers in three main columns while a fourth column feinted toward Frankfort and Lexington. No battle occurs within this episode; it ends with the armies moving toward the Perryville campaign’s decisive phase"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8497052746.mp3?updated=1695607447","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The strategic and command crisis before Perryville"}],["$","small",null,{"children":"The episode covers the eleven days between Bragg’s departure from Munfordville and Buell’s October 1 advance from Louisville. The first shots near Perryville belong to the next episode."}]]}],["$","div","Bragg’s new base",{"children":[["$","span",null,{"children":"Bragg’s new base"}],["$","strong",null,{"children":"Bardstown, roughly forty miles southeast of Louisville"}],["$","small",null,{"children":"The Army of the Mississippi marched northeast after abandoning Munfordville. Bardstown provided supplies and a friendly reception but did not let Bragg directly threaten Louisville."}]]}],["$","div","Confederate condition",{"children":[["$","span",null,{"children":"Confederate condition"}],["$","strong",null,{"children":"Heat, drought, hunger, and worn-out shoes"}],["$","small",null,{"children":"Many soldiers reportedly marched barefoot. Supplies from Kirby Smith helped restore Bragg’s army after the logistical crisis that forced it away from Munfordville."}]]}],["$","div","A missed opportunity",{"children":[["$","span",null,{"children":"A missed opportunity"}],["$","strong",null,{"children":"Bragg gave up the position between Buell and Louisville"}],["$","small",null,{"children":"Confederate soldiers remained eager to fight, but Bragg could not stay at Munfordville without risking starvation. Buell therefore regained an open road to his supply base."}]]}],["$","div","Bardstown reception",{"children":[["$","span",null,{"children":"Bardstown reception"}],["$","strong",null,{"children":"A warm welcome did not become mass enlistment"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}],"$L21","$undefined","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}]]}]
29:I["bc0a83434070",[],"AudioTimestamp",1]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","small",null,{"children":"The army paraded past Bragg, Simon Bolivar Buckner, Leonidas Polk, and Patton Anderson, but enthusiasm in town did not solve the campaign’s central political problem."}]
f:["$","div","Recruiting expectation",{"children":[["$","span",null,{"children":"Recruiting expectation"}],["$","strong",null,{"children":"15,000 rifles brought for prospective Kentucky volunteers"}],["$","small",null,{"children":"Bragg expected an uprising of Confederate supporters. The podcast reports only about 1,500 enlistments at Camp Breckinridge during this stage and about 5,000 Kentuckians joining Confederate service during the campaign, most in cavalry."}]]}]
10:["$","div","Why recruits hesitated",{"children":[["$","span",null,{"children":"Why recruits hesitated"}],["$","strong",null,{"children":"Confederate control did not appear permanent"}],["$","small",null,{"children":"A large United States force remained at Louisville, while federal confiscation policies put the property of men entering Confederate service at risk."}]]}]
11:["$","div","Bragg’s September 25 report",{"children":[["$","span",null,{"children":"Bragg’s September 25 report"}],["$","strong",null,{"children":"“Fifteen thousand stand of arms and no one to use them”"}],["$","small",null,{"children":"His dispatch to Richmond expressed sharp disappointment with Kentucky and warned that the campaign could not be sustained without major local support."}]]}]
12:["$","div","A new chief of staff",{"children":[["$","span",null,{"children":"A new chief of staff"}],["$","strong",null,{"children":"Col. George W. Brent"}],["$","small",null,{"children":"Bragg had been acting as both army commander and chief of staff. He appointed Brent in late September to reduce the burden at headquarters."}]]}]
13:["$","div","Confederate strength and separation",{"children":[["$","span",null,{"children":"Confederate strength and separation"}],["$","strong",null,{"children":"About 30,000 with Bragg; about 18,000 with Kirby Smith"}],["$","small",null,{"children":"The figures are those stated in the episode. Bragg needed Smith to approach parity with Buell, but Smith remained around Lexington and the two armies were vulnerable to defeat separately."}]]}]
14:["$","div","Strategic pause",{"children":[["$","span",null,{"children":"Strategic pause"}],["$","strong",null,{"children":"Bragg went on the defensive at Bardstown"}],["$","small",null,{"children":"He assumed Buell would need weeks to rebuild at Louisville. That pause surrendered the operational initiative when the Army of the Ohio recovered in less than one week."}]]}]
15:["$","div","Buell’s returning veterans",{"children":[["$","span",null,{"children":"Buell’s returning veterans"}],["$","strong",null,{"children":"A 300-mile withdrawal ended at Louisville"}],["$","small",null,{"children":"The Army of the Ohio arrived September 25–28 after retreating from the approaches to Chattanooga without a major battle. It briefly lost cohesion as exhausted soldiers refitted, received pay, or left without permission."}]]}]
16:["$","div","Attempted command change",{"children":[["$","span",null,{"children":"Attempted command change"}],["$","strong",null,{"children":"George H. Thomas asked that Buell remain"}],["$","small",null,{"children":"General-in-Chief Henry W. Halleck ordered Buell relieved, subject to a condition if he was preparing to fight. Thomas considered himself insufficiently informed to assume responsibility and asked that Buell be retained; Halleck suspended the change."}]]}]
17:["$","div","Army of the Ohio",{"children":[["$","span",null,{"children":"Army of the Ohio"}],["$","strong",null,{"children":"About 75,000 soldiers after reinforcement"}],["$","small",null,{"children":"Many were new recruits. Buell generally distributed green regiments among veteran brigades, although parts of the Eleventh Division and all of the Tenth Division remained inexperienced."}]]}]
18:["$","div","Death at the Galt House",{"children":[["$","span",null,{"children":"Death at the Galt House"}],["$","strong",null,{"children":"Maj. Gen. William “Bull” Nelson killed September 29"}],["$","small",null,{"children":"After Nelson slapped Brig. Gen. Jefferson C. Davis during a confrontation in the hotel, Davis obtained a pistol and shot him. Nelson died about an hour later, and Davis was arrested."}]]}]
19:["$","div","New corps structure",{"children":[["$","span",null,{"children":"New corps structure"}],["$","strong",null,{"children":"Three corps of roughly 25,000 soldiers each"}],["$","small",null,{"children":"Alexander McCook received First Corps, Thomas L. Crittenden Second Corps, and acting Maj. Gen. Charles C. Gilbert Third Corps. George Thomas became second in command of the army."}]]}]
1a:["$","div","Command inexperience",{"children":[["$","span",null,{"children":"Command inexperience"}],["$","strong",null,{"children":"Several leaders were new to their posts"}],["$","small",null,{"children":"Gilbert’s promotion from Regular Army captain was highly unusual. Philip Sheridan had not previously led a division, and James Jackson’s Tenth Division consisted entirely of green units and commanders."}]]}]
1b:["$","div","Buell’s objective",{"children":[["$","span",null,{"children":"Buell’s objective"}],["$","strong",null,{"children":"Threaten the Confederate route back to Tennessee"}],["$","small",null,{"children":"A southeastward advance toward Bardstown and central Kentucky would endanger Camp Breckinridge and the Wilderness Road, forcing Bragg and Smith to defend their communications or abandon Frankfort and Lexington."}]]}]
1c:["$","div","Four-column advance",{"children":[["$","span",null,{"children":"Four-column advance"}],["$","strong",null,{"children":"About 20,000 toward Frankfort; about 55,000 toward Bardstown"}],["$","small",null,{"children":"Joshua Sill’s division and Ebenezer Dumont’s recruits formed the eastern feint. Buell’s remaining three corps columns began the principal advance on October 1."}]]}]
1d:["$","div","Confederate political project",{"children":[["$","span",null,{"children":"Confederate political project"}],["$","strong",null,{"children":"Richard Hawes installation scheduled for October 4"}],["$","small",null,{"children":"Bragg went to Lexington, assumed formal command over the Confederate forces in Kentucky, and planned a Frankfort ceremony to install the pro-Confederate claimant as governor."}]]}]
1e:["$","div","Senior leader casualties mentioned",{"children":[["$","span",null,{"children":"Senior leader casualties mentioned"}],["$","strong",null,{"children":"William Nelson killed; Robert L. McCook mortally wounded earlier"}],["$","small",null,{"children":"Nelson’s death directly disrupted Buell’s corps organization. The episode also notes that Alexander McCook’s brother Robert had been mortally wounded by Confederate guerrillas in Tennessee in August."}]]}]
1f:["$","div","Transcript corrections",{"children":[["$","span",null,{"children":"Transcript corrections"}],["$","strong",null,{"children":"Buell; Bardstown; Patrick Cleburne; Breckinridge; General-in-Chief; Bull Nelson; Oliver P. Morton; Albin F. Schoepf; William Sooy Smith; Frankfort"}],["$","small",null,{"children":"The automated transcript gives “Beall,” “Bartstown,” “Patrick Claiborne,” “Breckenridge,” “General and Chief,” “Buell Nelson,” “Levi Morton,” “Alvin Sheth,” “William Soy Smith,” and “Frankfurt.” In Bragg’s dispatch, “As to change occurs soon” should read “If no change occurs soon.”"}]]}]
20:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"Creating a Confederate Kentucky: The Lost Cause and Civil War Memory in a Border State"}],["$","small",null,{"children":"Anne E. Marshall traces how Kentucky developed a Confederate public identity after remaining in the Union during the war. The book was published by the University of North Carolina Press."}]]}]
21:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
22:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The rival armies turn toward central Kentucky",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep211-kentucky-campaign-map.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The rival armies turn toward central Kentucky at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep211-kentucky-campaign-map.svg","alt":"Schematic map of central Kentucky showing Confederate positions at Bardstown and Lexington and four United States columns advancing from Louisville toward Frankfort and Bardstown.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The rival armies turn toward central Kentucky"}],["$","span",null,{"children":"North-up schematic of the late-September campaign. Red shows Bragg’s move from Munfordville to Bardstown, his command link with Kirby Smith at Lexington, and the Confederate supply line through Camp Breckinridge. Blue shows Sill and Dumont’s feint toward Frankfort and the three principal United States columns moving toward Bardstown and central Kentucky. Town positions and route traces are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep211-kentucky-campaign-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Custom diagram based on the Official Records and the National Park Service Perryville campaign summary; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$22:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
23:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode returns to central Kentucky",{"className":"moment","children":[["$","$L29",null,{"seconds":71,"label":"1:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode returns to central Kentucky"}],["$","p",null,{"children":"After reviewing George Morgan’s escape from Cumberland Gap, the narrative shifts about 200 miles west to Bragg and Buell."}]]}]]}],["$","div","Bragg marches for Bardstown",{"className":"moment","children":[["$","$L29",null,{"seconds":86,"label":"1:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg marches for Bardstown"}],["$","p",null,{"children":"After leaving Munfordville on September 20, the Army of the Mississippi moved northeast to resupply and seek a junction with Kirby Smith."}]]}]]}],["$","div","Confederate soldiers remain eager to fight",{"className":"moment","children":[["$","$L29",null,{"seconds":169,"label":"2:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate soldiers remain eager to fight"}],["$","p",null,{"children":"Lt. John Inglis of the Third Florida recorded frustration over failing to stop Buell but said the soldiers still wanted battle."}]]}]]}],["$","div","Bardstown welcomes Bragg’s army",{"className":"moment","children":[["$","$L29",null,{"seconds":185,"label":"3:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bardstown welcomes Bragg’s army"}],["$","p",null,{"children":"The reception resembled Kirby Smith’s welcome at Lexington, and Bragg reviewed the troops from the courthouse steps with senior generals."}]]}]]}],["$","div","Bragg restores his force",{"className":"moment","children":[["$","$L29",null,{"seconds":228,"label":"3:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg restores his force"}],["$","p",null,{"children":"The army covered the roads into Bardstown, received supplies from Kirby Smith, and reincorporated Patrick Cleburne’s division."}]]}]]}],["$","div","Kentucky recruits do not appear",{"className":"moment","children":[["$","$L29",null,{"seconds":254,"label":"4:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kentucky recruits do not appear"}],["$","p",null,{"children":"The expected rush of volunteers failed to materialize despite the 15,000 rifles Bragg had brought for them."}]]}]]}],["$","div","Buckner opens recruiting at Camp Breckinridge",{"className":"moment","children":[["$","$L29",null,{"seconds":274,"label":"4:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buckner opens recruiting at Camp Breckinridge"}],["$","p",null,{"children":"Simon Bolivar Buckner was sent to the renamed Camp Dick Robinson, but the episode reports only about 1,500 enlistments there."}]]}]]}],["$","div","Kirby Smith describes Kentucky’s reluctance",{"className":"moment","children":[["$","$L29",null,{"seconds":327,"label":"5:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kirby Smith describes Kentucky’s reluctance"}],["$","p",null,{"children":"Smith complained that Confederate sympathies did not outweigh Kentuckians’ concern for their productive land and livestock."}]]}]]}],["$","div","Bragg reports his disappointment",{"className":"moment","children":[["$","$L29",null,{"seconds":382,"label":"6:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg reports his disappointment"}],["$","p",null,{"children":"His September 25 dispatch to Richmond said the army had 15,000 weapons without men to carry them and might have to abandon Kentucky."}]]}]]}],["$","div","Bragg appoints a chief of staff",{"className":"moment","children":[["$","$L29",null,{"seconds":441,"label":"7:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bragg appoints a chief of staff"}],["$","p",null,{"children":"The strain of exercising both army command and staff supervision led him to appoint George W. Brent in late September."}]]}]]}],["$","div","Bardstown offers few strategic advantages",{"className":"moment","children":[["$","$L29",null,{"seconds":464,"label":"7:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bardstown offers few strategic advantages"}],"$L2a"]}]]}],"$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43"]}]]}]
24:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DmXPUkFg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DmXPUkFg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DmXPUkFg.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States — Army of the Ohio",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States — Army of the Ohio"}],[["$","div","Army of the Ohio-Maj. Gen. Don Carlos Buell",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Ohio"}],["$","span",null,{"children":"Maj. Gen. Don Carlos Buell"}],["$","small",null,{"children":"Retained command after Halleck suspended his relief, reorganized the army into three corps, and opened the central Kentucky offensive on October 1."}]]}],["$","div","Second in command, Army of the Ohio-Maj. Gen. George H. Thomas",{"className":"command-entry","children":[["$","strong",null,{"children":"Second in command, Army of the Ohio"}],["$","span",null,{"children":"Maj. Gen. George H. Thomas"}],["$","small",null,{"children":"Asked that Buell be retained rather than immediately assuming command; received no corps in the reorganization."}]]}],["$","div","First Corps-Maj. Gen. Alexander McD. McCook",{"className":"command-entry","children":[["$","strong",null,{"children":"First Corps"}],["$","span",null,{"children":"Maj. Gen. Alexander McD. McCook"}],["$","small",null,{"children":"Second Division—Joshua W. Sill; Third Division—Lovell H. Rousseau; Tenth Division—James S. Jackson. Sill was detached for the Frankfort feint."}]]}],["$","div","Second Corps-Maj. Gen. Thomas L. Crittenden",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Corps"}],["$","span",null,{"children":"Maj. Gen. Thomas L. Crittenden"}],["$","small",null,{"children":"Fourth Division—William Sooy Smith; Fifth Division—Horatio P. Van Cleve; Sixth Division—Thomas J. Wood."}]]}],["$","div","Third Corps-Acting Maj. Gen. Charles C. Gilbert",{"className":"command-entry","children":[["$","strong",null,{"children":"Third Corps"}],["$","span",null,{"children":"Acting Maj. Gen. Charles C. Gilbert"}],["$","small",null,{"children":"First Division—Albin F. Schoepf; Ninth Division—Robert B. Mitchell; Eleventh Division—Philip H. Sheridan."}]]}],["$","div","Frankfort–Lexington feint-Brig. Gen. Joshua W. Sill and Col. Ebenezer Dumont",{"className":"command-entry","children":[["$","strong",null,{"children":"Frankfort–Lexington feint"}],["$","span",null,{"children":"Brig. Gen. Joshua W. Sill and Col. Ebenezer Dumont"}],["$","small",null,{"children":"Sill’s detached Second Division and Dumont’s new units formed an eastern column of about 20,000 soldiers."}]]}]]]}],["$","section","Confederacy — forces in Kentucky",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy — forces in Kentucky"}],[["$","div","Army of the Mississippi; senior commander in Kentucky-Gen. Braxton Bragg",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Mississippi; senior commander in Kentucky"}],["$","span",null,{"children":"Gen. Braxton Bragg"}],["$","small",null,{"children":"Held roughly 30,000 men near Bardstown, then went to Lexington and assumed formal command over the combined Confederate forces in the state."}]]}],"$L44","$L45","$L46","$L47","$L48"]]}]]}],"$L49"]]]}]
25:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","William “Bull” Nelson",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"William “Bull” Nelson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Major general and intended commander of the Army of the Ohio’s Third Corps","."]}]," ","Shot in the chest by Brig. Gen. Jefferson C. Davis at Louisville’s Galt House on September 29, 1862; died about an hour later."]}]]}],["$","article","Robert L. McCook",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Robert L. McCook"}],["$","p",null,{"children":[["$","strong",null,{"children":["Brigadier general and older brother of First Corps commander Alexander McCook","."]}]," ","Mortally wounded during an encounter with Confederate guerrillas in Tennessee in August 1862; mentioned while introducing the “Fighting McCooks.”"]}]]}]]}]]}]
26:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep211-kentucky-campaign-map.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep211-kentucky-campaign-map.svg","alt":"Schematic map of the rival Confederate and United States movements in central Kentucky before Perryville.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Bragg’s pause at Bardstown and Kirby Smith’s position at Lexington left the Confederate forces separated. Buell’s four columns moved from Louisville toward Frankfort and the road network south of Bardstown."}]]}],["$","figure","/images/ep211-don-carlos-buell.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep211-don-carlos-buell.jpg","alt":"Civil War-era stereograph portrait of United States Major General Don Carlos Buell.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Buell escaped immediate removal, reorganized an army swollen with new recruits, and resumed the offensive less than one week after reaching Louisville."}]]}],["$","figure","/images/ep211-braxton-bragg.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep211-braxton-bragg.jpg","alt":"Civil War-era portrait of Confederate General Braxton Bragg in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Bragg halted at Bardstown to resupply and recruit, but his army remained separated from Kirby Smith while Buell recovered the initiative."}]]}],["$","figure","/images/ep211-william-bull-nelson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep211-william-bull-nelson.jpg","alt":"Civil War-era portrait of United States Major General William Bull Nelson in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Nelson’s killing by fellow United States general Jefferson C. Davis on September 29 forced Buell to find another commander for Third Corps."}]]}]]}]]}]
