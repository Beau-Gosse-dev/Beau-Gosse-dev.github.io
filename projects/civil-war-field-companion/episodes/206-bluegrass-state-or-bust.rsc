1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",206," · ","June–mid-August 1862, with Kentucky political context from May 1861–April 1862"," · ","Northern Mississippi, northern Alabama, Chattanooga and Knoxville in Tennessee, Cumberland Gap, and Kentucky"]}],["$","h1",null,{"children":"BLUEGRASS STATE OR BUST!"}],["$","span",null,{"className":"result-label","children":"Braxton Bragg shifted most of the Confederate Army of Mississippi from Tupelo to Chattanooga by a long, indirect rail-and-water route, ending the immediate threat to that city and helping the Confederacy regain the initiative in the western theater. Edmund Kirby Smith then pressed for an independent advance from East Tennessee into Kentucky rather than a preliminary reduction of Cumberland Gap and a prompt junction with Bragg. Bragg accepted a divided offensive despite warning that Don Carlos Buell could defeat the separated armies. Confederate expectations of a mass uprising in Kentucky rested on exaggerated reports and on a provisional government that never displaced the Union-aligned state government"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9645854797.mp3?updated=1695589023","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The strategic prelude to the 1862 Confederate invasion of Kentucky"}],["$","small",null,{"children":"The episode follows the western armies from the aftermath of Corinth through Bragg’s concentration at Chattanooga and the mid-August decision to make Kentucky the principal objective."}]]}],["$","div","United States position after Corinth",{"children":[["$","span",null,{"children":"United States position after Corinth"}],["$","strong",null,{"children":"A broad occupation, not a concentrated pursuit"}],["$","small",null,{"children":"Henry Halleck dispersed his large force to hold northern Mississippi, western Tennessee, and northern Alabama rather than pursue the Confederate army south from Corinth."}]]}],["$","div","Buell’s assignment",{"children":[["$","span",null,{"children":"Buell’s assignment"}],["$","strong",null,{"children":"Advance toward Chattanooga with roughly 30,000 men"}],["$","small",null,{"children":"Maj. Gen. Don Carlos Buell moved east along the Memphis and Charleston Railroad, repairing and guarding the line as his army depended on it for supply."}]]}],["$","div","Correct name: Ormsby Mitchel",{"children":[["$","span",null,{"children":"Correct name: Ormsby Mitchel"}],["$","strong",null,{"children":"Not “Ormsby Mitchell”"}],["$","small",null,{"children":"The automated transcript adds a second l. Mitchel’s division already held important portions of the railroad across northern Alabama."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c"]}],"$L2d","$undefined","$L2e",false,"$L2f","$L30","$L31","$L32","$L33"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Halleck’s new office",{"children":[["$","span",null,{"children":"Halleck’s new office"}],["$","strong",null,{"children":"General in chief from July 23, 1862"}],["$","small",null,{"children":"Lincoln summoned Halleck to Washington on July 11. The Army Center of Military History dates his tenure as commanding general from July 23."}]]}]
f:["$","div","End of unified western field command",{"children":[["$","span",null,{"children":"End of unified western field command"}],["$","strong",null,{"children":"Grant and Buell again operated independently"}],["$","small",null,{"children":"Halleck’s departure removed the commander who had exercised authority over both armies during the Corinth campaign."}]]}]
10:["$","div","Chattanooga’s importance",{"children":[["$","span",null,{"children":"Chattanooga’s importance"}],["$","strong",null,{"children":"Tennessee River port, mountain gateway, and railroad junction"}],["$","small",null,{"children":"Rail connections ran west toward Memphis, northeast through Knoxville toward Virginia, and southeast toward Atlanta. Control threatened Confederate east–west communications and opened routes into East Tennessee and Georgia."}]]}]
11:["$","div","Confederate East Tennessee command",{"children":[["$","span",null,{"children":"Confederate East Tennessee command"}],["$","strong",null,{"children":"Maj. Gen. Edmund Kirby Smith"}],["$","small",null,{"children":"Smith commanded an independent department and the Army of East Tennessee from Knoxville; he was not automatically Bragg’s subordinate merely because Bragg outranked him."}]]}]
12:["$","div","Cumberland Gap occupation",{"children":[["$","span",null,{"children":"Cumberland Gap occupation"}],["$","strong",null,{"children":"Union forces entered June 18, 1862"}],["$","small",null,{"children":"Brig. Gen. George W. Morgan occupied the pass after the Confederate garrison withdrew. The position threatened Knoxville but also required supply through difficult mountain country."}]]}]
13:["$","div","Buell’s central weakness",{"children":[["$","span",null,{"children":"Buell’s central weakness"}],["$","strong",null,{"children":"A long and repeatedly disrupted railroad supply line"}],["$","small",null,{"children":"Confederate cavalry and guerrillas damaged track behind the advance, while Buell devoted time and troops to repair and protection."}]]}]
14:["$","div","Beauregard’s leave",{"children":[["$","span",null,{"children":"Beauregard’s leave"}],["$","strong",null,{"children":"Departed Tupelo in June without prior approval from Richmond"}],["$","small",null,{"children":"P. G. T. Beauregard transferred temporary command to Bragg and went to Bladon Springs, Alabama, for his health. Jefferson Davis treated the unauthorized absence as grounds to replace him."}]]}]
15:["$","div","Bragg takes command",{"children":[["$","span",null,{"children":"Bragg takes command"}],["$","strong",null,{"children":"Army of Mississippi and Department No. 2"}],["$","small",null,{"children":"Davis made Bragg the permanent western commander in June 1862. The field army was still called the Army of Mississippi during the Kentucky campaign; it became the Army of Tennessee later that year."}]]}]
16:["$","div","Forces left in Mississippi",{"children":[["$","span",null,{"children":"Forces left in Mississippi"}],["$","strong",null,{"children":"Sterling Price near Tupelo; Earl Van Dorn responsible for Vicksburg"}],["$","small",null,{"children":"These forces protected northern Mississippi and the remaining Confederate strongpoint on the Mississippi River while Bragg shifted the main field army east."}]]}]
17:["$","div","Vicksburg’s position in summer 1862",{"children":[["$","span",null,{"children":"Vicksburg’s position in summer 1862"}],["$","strong",null,{"children":"The principal Confederate barrier remaining on the Mississippi"}],["$","small",null,{"children":"After the fall of New Orleans, Baton Rouge, Memphis, and other river positions, Union naval forces tried but failed to compel Vicksburg’s surrender."}]]}]
18:["$","div","Correct term: Pook Turtles",{"children":[["$","span",null,{"children":"Correct term: Pook Turtles"}],["$","strong",null,{"children":"City-class ironclad gunboats"}],["$","small",null,{"children":"The transcript renders the nickname as “Pukes.” The vessels designed by Samuel M. Pook were commonly called Pook Turtles."}]]}]
19:["$","div","Bragg’s long transfer",{"children":[["$","span",null,{"children":"Bragg’s long transfer"}],["$","strong",null,{"children":"About 30,000 men from Tupelo to Chattanooga by rail"}],["$","small",null,{"children":"Because Buell blocked the direct line, the infantry traveled roughly 770 miles through Mobile, Montgomery, and Atlanta, including a crossing of Mobile Bay. The whole concentration took weeks; individual contingents could complete the journey in about six days."}]]}]
1a:["$","div","Historical significance of the transfer",{"children":[["$","span",null,{"children":"Historical significance of the transfer"}],["$","strong",null,{"children":"First long-distance transfer of an entire field army during the war"}],["$","small",null,{"children":"The U.S. Army Center of Military History uses this formulation. Cavalry, artillery, wagons, and supplies did not all follow the infantry’s rail route."}]]}]
1b:["$","div","Chattanooga concentration",{"children":[["$","span",null,{"children":"Chattanooga concentration"}],["$","strong",null,{"children":"First infantry arrived July 29; Bragg arrived July 30"}],["$","small",null,{"children":"The episode dates the command conference with Kirby Smith to July 31 and the early hours of August 1."}]]}]
1c:["$","div","Bragg’s initial operational emphasis",{"children":[["$","span",null,{"children":"Bragg’s initial operational emphasis"}],["$","strong",null,{"children":"Recover Middle Tennessee and threaten Nashville"}],["$","small",null,{"children":"The developing plan also contemplated a northward movement toward Kentucky and the Ohio River. Surviving interpretations differ on how fully the Kentucky axis was settled at the July 31 conference."}]]}]
1d:["$","div","Independent command problem",{"children":[["$","span",null,{"children":"Independent command problem"}],["$","strong",null,{"children":"Cooperation depended on consent, not a single theater commander"}],["$","small",null,{"children":"Bragg commanded Department No. 2 while Smith commanded the separate Department of East Tennessee. Davis corresponded with both, and Bragg lacked normal authority to compel Smith’s compliance."}]]}]
1e:["$","div","Original Cumberland Gap sequence",{"children":[["$","span",null,{"children":"Original Cumberland Gap sequence"}],["$","strong",null,{"children":"Reinforce Smith, reduce the Gap, then join Bragg"}],["$","small",null,{"children":"Bragg sent two divisions to Smith. Smith argued on August 9 that George Morgan’s well-stocked garrison could withstand a lengthy investment even if its communications were cut."}]]}]
1f:["$","div","Smith’s alternative",{"children":[["$","span",null,{"children":"Smith’s alternative"}],["$","strong",null,{"children":"Bypass Cumberland Gap and invade Kentucky"}],["$","small",null,{"children":"Smith preferred a direct advance north from Knoxville, preserving his independent army and choosing Kentucky rather than Middle Tennessee as his theater of action."}]]}]
20:["$","div","Bragg’s warning",{"children":[["$","span",null,{"children":"Bragg’s warning"}],["$","strong",null,{"children":"Buell could defeat separated Confederate forces"}],["$","small",null,{"children":"On August 10 Bragg urged concentration against the Army of the Ohio but ultimately accepted Smith’s separate axis and promised cooperation farther north."}]]}]
21:["$","div","John Hunt Morgan’s first Kentucky raid",{"children":[["$","span",null,{"children":"John Hunt Morgan’s first Kentucky raid"}],["$","strong",null,{"children":"July 1862"}],["$","small",null,{"children":"The cavalry raid alarmed Union authorities and encouraged Confederate hopes, but Morgan greatly overstated the recruiting response he had found."}]]}]
22:["$","div","Morgan’s recruiting prediction",{"children":[["$","span",null,{"children":"Morgan’s recruiting prediction"}],["$","strong",null,{"children":"25,000 or 30,000 volunteers"}],["$","small",null,{"children":"His July 16 dispatch claimed the country could be secured and that tens of thousands would join. The prediction was not borne out during the campaign."}]]}]
23:["$","div","Kentucky’s legal status",{"children":[["$","span",null,{"children":"Kentucky’s legal status"}],["$","strong",null,{"children":"A United States state that never seceded"}],["$","small",null,{"children":"Kentucky was a slaveholding border state with divided loyalties. Its elected legislature rejected secession and eventually aligned the state government with the United States."}]]}]
24:["$","div","Correct name: Beriah Magoffin",{"children":[["$","span",null,{"children":"Correct name: Beriah Magoffin"}],["$","strong",null,{"children":"Kentucky’s elected governor"}],["$","small",null,{"children":"The transcript renders his name phonetically. Magoffin favored neutrality and had Southern sympathies, but he did not have legislative support to take Kentucky out of the Union."}]]}]
25:["$","div","Neutrality collapses",{"children":[["$","span",null,{"children":"Neutrality collapses"}],["$","strong",null,{"children":"September 1861"}],["$","small",null,{"children":"Confederate Maj. Gen. Leonidas Polk’s occupation of Columbus on September 3 was the first open entry by a belligerent field force. Union troops then occupied Paducah, and the legislature demanded that Confederate forces leave."}]]}]
26:["$","div","Russellville Convention",{"children":[["$","span",null,{"children":"Russellville Convention"}],["$","strong",null,{"children":"November 18–20, 1861"}],["$","small",null,{"children":"Pro-Confederate delegates created a provisional government, elected George W. Johnson governor, and challenged the elected government at Frankfort without displacing it."}]]}]
27:["$","div","Confederate admission of Kentucky",{"children":[["$","span",null,{"children":"Confederate admission of Kentucky"}],["$","strong",null,{"children":"December 10, 1861"}],["$","small",null,{"children":"The Confederacy recognized the provisional government and represented Kentucky with a star, although that government exercised power only where Confederate arms permitted."}]]}]
28:["$","div","George W. Johnson at Shiloh",{"children":[["$","span",null,{"children":"George W. Johnson at Shiloh"}],["$","strong",null,{"children":"Mortally wounded April 7; died April 8, 1862"}],["$","small",null,{"children":"The provisional governor served with the 4th Kentucky Infantry, was found and aided by Union Brig. Gen. Alexander McDowell McCook, and died aboard a hospital steamer."}]]}]
29:["$","div","Provisional successor",{"children":[["$","span",null,{"children":"Provisional successor"}],["$","strong",null,{"children":"Richard Hawes"}],["$","small",null,{"children":"Hawes became the second Confederate provisional governor and lobbied Richmond for an invasion that could restore the government inside Kentucky."}]]}]
2a:["$","div","Simultaneous Confederate offensives",{"children":[["$","span",null,{"children":"Simultaneous Confederate offensives"}],["$","strong",null,{"children":"Kentucky in the west and northern Virginia/Maryland in the east"}],["$","small",null,{"children":"Robert E. Lee approved the western movement, but he had to strike John Pope before George B. McClellan could reinforce him. The campaigns were strategically complementary, not synchronized operations."}]]}]
2b:["$","div","Strategic condition at episode’s end",{"children":[["$","span",null,{"children":"Strategic condition at episode’s end"}],["$","strong",null,{"children":"Confederate initiative restored, but command and supply remained divided"}],["$","small",null,{"children":"Bragg and Smith entered the campaign with energetic troops and ambitious objectives, yet separate authority, changing plans, and uncertain Kentucky recruitment threatened the undertaking from the outset."}]]}]
2c:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Braxton Bragg: The Most Hated Man of the Confederacy” by Earl J. Hess"}],["$","small",null,{"children":"The episode recommends Hess’s 2016 biography for a more balanced assessment of Bragg than the general’s hostile historical reputation usually receives."}]]}]
2d:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
2e:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","From Tupelo to the Bluegrass State",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep206-kentucky-offensive-plan.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From Tupelo to the Bluegrass State at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep206-kentucky-offensive-plan.svg","alt":"Schematic map of Bragg’s rail transfer from Tupelo through Mobile, Montgomery, and Atlanta to Chattanooga, followed by Bragg’s and Kirby Smith’s separate proposed advances toward Kentucky.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From Tupelo to the Bluegrass State"}],["$","span",null,{"children":"This schematic separates two related problems. Bragg first used a long rail-and-water route through Mobile, Montgomery, and Atlanta to concentrate infantry at Chattanooga while Price and Van Dorn remained in Mississippi. Bragg and Kirby Smith then contemplated separate northward axes despite Bragg’s concern that Buell could exploit their division."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep206-kentucky-offensive-plan.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Custom diagram based on the U.S. Army Center of Military History campaign history and the Library of Congress 1862 theater map; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2e:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","A United States Army map of Middle and East Tennessee",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep206-middle-east-tennessee-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open A United States Army map of Middle and East Tennessee at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep206-middle-east-tennessee-map.jpg","alt":"An 1862 military map of Middle and East Tennessee and parts of Alabama and Georgia, with railroads marked in red and waterways in blue.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"A United States Army map of Middle and East Tennessee"}],["$","span",null,{"children":"Contextual primary-source image: this 1862 map, prepared for the Army of the Ohio and the Army of the Cumberland, shows rivers, roads, and railroads across the region centered on Nashville and Chattanooga. It supplies period geographic context; it does not plot the episode’s campaign plan."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep206-middle-east-tennessee-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2e:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Geography and Map Division, Library of Congress; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2e:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Braxton Bragg",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":"$L34"}],"$L35"]}]]}]]}]
2f:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States national and western command",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States national and western command"}],[["$","div","Commander in chief-President Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Made East Tennessee a longstanding strategic objective and appointed Halleck general in chief"}]]}],["$","div","General in chief from July 23, 1862-Maj. Gen. Henry W. Halleck",{"className":"command-entry","children":[["$","strong",null,{"children":"General in chief from July 23, 1862"}],["$","span",null,{"children":"Maj. Gen. Henry W. Halleck"}],["$","small",null,{"children":"Left western field command for Washington; Grant and Buell then resumed independent army commands"}]]}],["$","div","Army of the Ohio-Maj. Gen. Don Carlos Buell",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Ohio"}],["$","span",null,{"children":"Maj. Gen. Don Carlos Buell"}],["$","small",null,{"children":"Advanced toward Chattanooga; Brig. Gen. George W. Morgan commanded the division at Cumberland Gap, while Ormsby Mitchel’s division held parts of northern Alabama"}]]}],["$","div","Army of the Tennessee and District of West Tennessee-Maj. Gen. Ulysses S. Grant",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Tennessee and District of West Tennessee"}],["$","span",null,{"children":"Maj. Gen. Ulysses S. Grant"}],["$","small",null,{"children":"Held the Corinth–Memphis sector independently of Buell and was the intended target of Price and Van Dorn’s diversion"}]]}]]]}],["$","section","Confederate national and main western command",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederate national and main western command"}],[["$","div","Commander in chief-President Jefferson Davis",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief"}],["$","span",null,{"children":"President Jefferson Davis"}],["$","small",null,{"children":"Replaced Beauregard with Bragg and attempted to coordinate Bragg, Kirby Smith, and Lee without creating a unified western command"}]]}],["$","div","Department No. 2 and Army of Mississippi-Gen. Braxton Bragg",{"className":"command-entry","children":[["$","strong",null,{"children":"Department No. 2 and Army of Mississippi"}],["$","span",null,{"children":"Gen. Braxton Bragg"}],["$","small",null,{"children":"Moved the main field army to Chattanooga; assigned Sterling Price near Tupelo and Earl Van Dorn to Vicksburg; lent two divisions to Kirby Smith"}]]}],["$","div","Confederate force near Tupelo-Maj. Gen. Sterling Price",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate force near Tupelo"}],["$","span",null,{"children":"Maj. Gen. Sterling Price"}],["$","small",null,{"children":"Watched the United States forces in northern Mississippi and was expected eventually to cooperate against Grant"}]]}],"$L36"]]}],"$L37","$L38"]}],"$L39"]]]}]
30:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","George W. Johnson",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"George W. Johnson"}],["$","p",null,{"children":[["$","strong",null,{"children":["Confederate provisional governor of Kentucky serving with the 4th Kentucky Infantry at Shiloh","."]}]," ","Mortally wounded on April 7, 1862, the second day of Shiloh; captured and treated by United States personnel; died April 8 aboard the hospital steamer Hannibal."]}]]}]]}]]}]
31:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep206-kentucky-offensive-plan.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep206-kentucky-offensive-plan.svg","alt":"Schematic of Bragg’s rail transfer to Chattanooga and the separate Confederate axes proposed toward Middle Tennessee and Kentucky.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The operational problem in one view: an innovative concentration shifted the initiative, but no comparable consolidation of command followed it."}]]}],["$","figure","/images/ep206-middle-east-tennessee-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep206-middle-east-tennessee-map.jpg","alt":"An 1862 military map covering Middle and East Tennessee and adjacent parts of Alabama and Georgia.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Contextual primary-source image: this Army of the Ohio and Army of the Cumberland map marks railroads in red and waterways in blue. It gives period geographic context but does not itself depict Bragg’s 1862 movement."}]]}],["$","figure","/images/ep206-braxton-bragg.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep206-braxton-bragg.jpg","alt":"Wartime photographic portrait of Confederate General Braxton Bragg in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Contextual image: a wartime portrait of Bragg, who replaced Beauregard and moved the Army of Mississippi to Chattanooga before turning toward Kentucky."}]]}],["$","figure","/images/ep206-kirby-smith.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep206-kirby-smith.jpg","alt":"Wartime glass-negative portrait of Confeder