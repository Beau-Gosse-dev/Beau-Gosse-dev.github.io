13:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.m4AAmS8w.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.B0pjVDS7.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/command-trees.KCNQiAeH.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States national and western command",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States national and western command"}],[["$","div","Commander in chief-President Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Made East Tennessee a longstanding strategic objective and appointed Halleck general in chief"}]]}],["$","div","General in chief from July 23, 1862-Maj. Gen. Henry W. Halleck",{"className":"command-entry","children":[["$","strong",null,{"children":"General in chief from July 23, 1862"}],["$","span",null,{"children":"Maj. Gen. Henry W. H