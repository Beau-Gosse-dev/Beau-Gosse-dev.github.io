28:["$","section","Confederate East Tennessee command",{"className":"command-column #a45a36","children":[["$","h3",null,{"children":"Confederate East Tennessee command"}],[["$","div","Department and Army of East Tennessee-Maj. Gen. Edmund Kirby Smith",{"className":"command-entry","children":[["$","strong",null,{"children":"Department and Army of East Tennessee"}],["$","span",null,{"children":"Maj. Gen. Edmund Kirby Smith"}],["$","small",null,{"children":"Defended Knoxville and Chattanooga, received two divisions from Bragg, and chose a separate advance into Kentucky"}]]}],["$","div","Division in East Tennessee-Brig. Gen. Carter L. Stevenson",{"className":"command-entry","children":[["$","strong",null,{"children":"Division in East Tennessee"}],["$","span",null,{"children":"Brig. Gen. Carter L. Stevenson"}],["$","small",null,{"children":"Had withdrawn from Cumberland Gap in June and remained one of Smith’s senior field commanders"}]]}],["$","div","Cavalry raiding force-Col. John Hunt Morgan",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry raiding force"}],["$","span",null,{"children":"Col. John Hunt Morgan"}],["$","small",null,{"children":"Raided Kentucky in July and sent Smith an exaggerated estimate of the recruits an invasion would produce"}]]}]]]}]
29:["$","section","Kentucky civil authority and rival claimant",{"className":"command-column #75634b","children":[["$","h3",null,{"children":"Kentucky civil authority and rival claimant"}],[["$","div","Elected governor of Kentucky-Gov. Beriah Magoffin",{"className":"command-entry","children":[["$","strong",null,{"children":"Elected governor of Kentucky"}],["$","span",null,{"children":"Gov. Beriah Magoffin"}],["$","small",null,{"children":"Favored neutrality and held Southern sympathies but governed with a Unionist legislature that rejected secession"}]]}],["$","div","Lawful state legislature-Kentucky General Assembly",{"className":"command-entry","children":[["$","strong",null,{"children":"Lawful state legislature"}],["$","span",null,{"children":"Kentucky General Assembly"}],["$","small",null,{"children":"Aligned the state with the United States after Confederate troops occupied Columbus in September 1861"}]]}],["$","div","Confederate provisional governors-George W. Johnson; then Richard Hawes",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate provisional governors"}],["$","span",null,{"children":"George W. Johnson; then Richard Hawes"}],["$","small",null,{"children":"Led the rival government created at Russellville, recognized by Richmond but unable to displace the government at Frankfort"}]]}]]]}]
