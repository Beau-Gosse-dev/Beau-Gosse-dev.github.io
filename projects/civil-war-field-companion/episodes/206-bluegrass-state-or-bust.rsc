f:["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Buell’s assignment",{"children":[["$","th",null,{"scope":"row","children":"Buell’s assignment"}],["$","td",null,{"children":["Advance toward Chattanooga with roughly 30,000 men",["$","small",null,{"style":{"display":"block"},"children":"Maj. Gen. Don Carlos Buell moved east along the Memphis and Charleston Railroad, repairing and guarding the line as his army depended on it for supply."}]]}]]}],["$","tr","Bragg’s long transfer",{"children":[["$","th",null,{"scope":"row","children":"Bragg’s long transfer"}],["$","td",null,{"children":["About 30,000 men from Tupelo to Chattanooga by rail",["$","small",null,{"style":{"display":"block"},"children":"Because Buell blocked the direct line, the infantry traveled roughly 770 miles through Mobile, Montgomery, and Atlanta, including a crossing of Mobile Bay. The whole concentration took weeks; individual contingents could complete the journey in about six days."}]]}]]}],["$","tr","George W. Johnson at Shiloh",{"children":[["$","th",null,{"scope":"row","children":"George W. Johnson at Shiloh"}],["$","td",null,{"children":["Mortally wounded April 7; died April 8, 1862",["$","small",null,{"style":{"display":"block"},"children":"The provisional governor served with the 4th Kentucky Infantry, was found and aided by Union Brig. Gen. Alexander McDowell McCook, and died aboard a hospital steamer."}]]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/category/1862/page/5/",{"href":"https://civilwarpodcast.org/category/1862/page/5/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast page containing episode 206"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-7.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-7.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Civil War in the Western Theater, 1862"]}],["$","a","https://history.army.mil/Research/Reference-Topics/-CONTINENTAL-ARMY-GENERAL-AND-COMMANDER-IN-CHIEF/",{"href":"https://history.army.mil/Research/Reference-Topics/-CONTINENTAL-ARMY-GENERAL-AND-COMMANDER-IN-CHIEF/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: commanding generals and Halleck’s tenure"]}],["$","a","https://www.armyupress.army.mil/Portals/7/educational-services/staff-rides/StaffRideHB_Perryville.pdf",{"href":"https://www.armyupress.army.mil/Portals/7/educational-services/staff-rides/StaffRideHB_Perryville.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army staff ride handbook for the Perryville Campaign"]}],["$","a","https://www.nps.gov/articles/chattanooga-tennessee-train-town-teaching-with-historic-places.htm",{"href":"https://www.nps.gov/articles/chattanooga-tennessee-train-town-teaching-with-historic-places.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Chattanooga, Tennessee—Train Town"]}],["$","a","https://www.nps.gov/cuga/civil-war-at-cumberland-gap.htm",{"href":"https://www.nps.gov/cuga/civil-war-at-cumberland-gap.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Civil War at Cumberland Gap"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}]]}]
