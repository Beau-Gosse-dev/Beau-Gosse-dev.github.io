d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",206," · ","June–mid-August 1862, with Kentucky political context from May 1861–April 1862"," · ","Northern Mississippi, northern Alabama, Chattanooga and Knoxville in Tennessee, Cumberland Gap, and Kentucky"]}],["$","h1",null,{"children":"BLUEGRASS STATE OR BUST!"}],["$","span",null,{"className":"result-label","children":"Braxton Bragg shifted most of the Confederate Army of Mississippi from Tupelo to Chattanooga by a long, indirect rail-and-water route, ending the immediate threat to that city and helping the Confederacy regain the initiative in the western theater. Edmund Kirby Smith then pressed for an independent advance from East Tennessee into Kentucky rather than a preliminary reduction of Cumberland Gap and a prompt junction with Bragg. Bragg accepted a divided offensive despite warning that Don Carlos Buell could defeat the separated armies. Confederate expectations of a mass uprising in Kentucky rested on exaggerated reports and on a provisional government that never displaced the Union-aligned state government"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"June–mid-August 1862, with Kentucky political context from May 1861–April 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Northern Mississippi, northern Alabama, Chattanooga and Knoxville in Tennessee, Cumberland Gap, and Kentucky"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Braxton Bragg shifted most of the Confederate Army of Mississippi from Tupelo to Chattanooga by a long, indirect rail-and-water route, ending the immediate threat to that city and helping the Confederacy regain the initiative in the western theater. Edmund Kirby Smith then pressed for an independent advance from East Tennessee into Kentucky rather than a preliminary reduction of Cumberland Gap and a prompt junction with Bragg. Bragg accepted a divided offensive despite warning that Don Carlos Buell could defeat the separated armies. Confederate expectations of a mass uprising in Kentucky rested on exaggerated reports and on a provisional government that never displaced the Union-aligned state government"}]]}]]}],false,"$Lf","$undefined"]}],"$L10","$L11","$L12",false,"$L13","$L14","$L15","$L16","$L17","$L18"]}]]}]
