11:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/book-recommendations/",{"href":"https://civilwarpodcast.org/book-recommendations/","target":"_blank","rel":"noreferrer","children":["Source: ","Official podcast book-recommendations list"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ky008",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ky008","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Munfordville battle detail"]}],["$","a","https://texashistory.unt.edu/ark:/67531/metapth154624/m1/967/",{"href":"https://texashistory.unt.edu/ark:/67531/metapth154624/m1/967/","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Official Records, Wilder’s report of the siege and surrender"]}],["$","a","https://texashistory.unt.edu/ark:/67531/metapth154624/m1/976/",{"href":"https://texashistory.unt.edu/ark:/67531/metapth154624/m1/976/","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Official Records, surrender correspondence and Bragg’s report"]}],["$","a","https://texashistory.unt.edu/ark:/67531/metapth154624/m1/982/",{"href":"https://texashistory.unt.edu/ark:/67531/metapth154624/m1/982/","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Official Records, Chalmers’s September 14 operations report"]}],["$","a","https://s3.amazonaws.com/NARAprodstorage/lz/electronic-records/rg-079/NPS_KY/97000866.pdf",{"href":"https://s3.amazonaws.com/NARAprodstorage/lz/electronic-records/rg-079/NPS_KY/97000866.pdf","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service/National Register: Battle of Munfordville district"]}],["$","a","https://www.battlefields.org/learn/maps/munfordville-sept-14-17-1862",{"href":"https://www.battlefields.org/learn/maps/munfordville-sept-14-17-1862","target":"_blank","rel":"noreferrer","children":[" · ","American Battlefield Trust: Munfordville phase maps"]}],["$","a","https://history.ky.gov/markers/battle-of-munfordville",{"href":"https://history.ky.gov/markers/battle-of-munfordville","target":"_blank","rel":"noreferrer","children":[" · ","Kentucky Historical Society: Battle of Munfordville marker"]}],["$","a","https://finding.mdah.ms.gov/manuscripts/z0622",{"href":"https://finding.mdah.ms.gov/manuscripts/z0622","target":"_blank","rel":"noreferrer","children":[" · ","Mississippi Department of Archives and History: Robert A. Smith papers"]}],["$","a","https://www.loc.gov/item/2023631560/",{"href":"https://www.loc.gov/item/2023631560/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: John T. Wilder portrait"]}],["$","a","https://www.loc.gov/item/2022630536/",{"href":"https://www.loc.gov/item/2022630536/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Braxton Bragg portrait"]}],["$","a","https://www.loc.gov/item/2016649609/",{"href":"https://www.loc.gov/item/2016649609/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Simon B. Buckner portrait"]}]]}]
