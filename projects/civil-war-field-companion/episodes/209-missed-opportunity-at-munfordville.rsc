10:["$","tbody",null,{"children":[["$","tr","Bragg’s army",{"children":[["$","th",null,{"scope":"row","children":"Bragg’s army"}],["$","td",null,{"children":["About 30,000 men when reorganized at Chattanooga",["$","small",null,{"style":{"display":"block"},"children":"The episode describes two wings under Leonidas Polk and William J. Hardee, each with two infantry divisions, plus roughly 6,000 cavalry divided between John C. Wharton and Joseph Wheeler."}]]}]]}],["$","tr","Initial garrison",{"children":[["$","th",null,{"scope":"row","children":"Initial garrison"}],["$","td",null,{"children":["2,122 men for duty in Wilder’s official report",["$","small",null,{"style":{"display":"block"},"children":"The command included the 67th and 89th Indiana, detachments of the 17th and 74th Indiana, one company of the 18th U.S. Infantry, Kentucky troops, cavalry, and four artillery pieces."}]]}]]}],["$","tr","Faulty reconnaissance",{"children":[["$","th",null,{"scope":"row","children":"Faulty reconnaissance"}],["$","td",null,{"children":["John S. Scott reported 1,200–1,800 raw troops in weak works",["$","small",null,{"style":{"display":"block"},"children":"Scott also claimed that reinforcements could not arrive. The railroad and telegraph still connected the garrison with the north, and the fortifications were stronger than his description suggested."}]]}]]}],["$","tr","September 14 losses",{"children":[["$","th",null,{"scope":"row","children":"September 14 losses"}],["$","td",null,{"children":["285 Confederate casualties; 37 United States casualties",["$","small",null,{"style":{"display":"block"},"children":"These are the National Park Service battle-detail totals for the failed assault. Wilder’s contemporary report also placed his killed and wounded at 37."}]]}]]}],["$","tr","Battlefield total",{"children":[["$","th",null,{"scope":"row","children":"Battlefield total"}],["$","td",null,{"children":["4,433 estimated casualties in the NPS table",["$","small",null,{"style":{"display":