15:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
17:["$","div","Banks approved the plan",{"className":"moment","children":[["$","$L16",null,{"seconds":736,"label":"12:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks approved the plan"}],["$","p",null,{"children":"After Franklin arranged a meeting with Banks and Hunter on April 29, Banks authorized construction."}]]}]]}]
18:["$","div","Soldiers built the dams",{"className":"moment","children":[["$","$L16",null,{"seconds":825,"label":"13:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Soldiers built the dams"}],["$","p",null,{"children":"Maine soldiers with logging experience built a tree dam from one bank. Black troops from the Corps d’Afrique built crib structures from barges loaded with brick, stone, and demolished building material."}]]}]]}]
19:["$","div","The first dams raised the river",{"className":"moment","children":[["$","$L16",null,{"seconds":859,"label":"14:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first dams raised the river"}],["$","p",null,{"children":"By May 8 the structures had produced a deeper pool above the rapids, allowing the shallow-draft vessels to move close to the gap."}]]}]]}]
1a:["$","div","Four gunboats passed on May 9",{"className":"moment","children":[["$","$L16",null,{"seconds":902,"label":"15:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Four gunboats passed on May 9"}],["$","p",null,{"children":"When part of the dam broke, Lexington passed through the opening, followed by Osage, Neosho, and Fort Hindman."}]]}]]}]
1b:["$","div","Bailey added wing dams",{"className":"moment","children":[["$","$L16",null,{"seconds":927,"label":"15:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bailey added wing dams"}],["$","p",null,{"children":"The first release did not free every vessel, so Bailey repaired the works and added structures that directed more water into the channel."}]]}]]}]
1c:["$","div","The remaining ironclads escaped",{"className":"moment","children":[["$","$L16",null,{"seconds":993,"label":"16:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The remaining ironclads escaped"}],["$","p",null,{"children":"Guns, armor, and cotton were removed to reduce draft. On May 13 the water was deep enough for the lightened ships to pass."}]]}]]}]
1d:["$","div","The army left Alexandria",{"className":"moment","children":[["$","$L16",null,{"seconds":1094,"label":"18:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army left Alexandria"}],["$","p",null,{"children":"The first troops marched out at 7 a.m. on May 13. Union soldiers then set fires that destroyed most of the town despite attempts by staff officers and the provost guard to stop them."}]]}]]}]
1e:["$","div","Taylor attacked the retreat",{"className":"moment","children":[["$","$L16",null,{"seconds":1144,"label":"19:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taylor attacked the retreat"}],["$","p",null,{"children":"Confederate forces harassed the column and fought an artillery action about forty miles below Alexandria on May 16."}]]}]]}]
1f:["$","div","The armies fought at Yellow Bayou",{"className":"moment","children":[["$","$L16",null,{"seconds":1168,"label":"19:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies fought at Yellow Bayou"}],["$","p",null,{"children":"A sharp engagement on May 18 failed to stop Banks’s withdrawal because Taylor did not have enough troops."}]]}]]}]
20:["$","div","The army crossed at Simmesport",{"className":"moment","children":[["$","$L16",null,{"seconds":1179,"label":"19:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army crossed at Simmesport"}],["$","p",null,{"children":"Bailey built a bridge across the Atchafalaya River. The Union army crossed on May 19–20 and dismantled the bridge, ending Taylor’s pursuit and the campaign."}]]}]]}]
21:["$","div","Canby reduced Banks’s role",{"className":"moment","children":[["$","$L16",null,{"seconds":1202,"label":"20:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canby reduced Banks’s role"}],["$","p",null,{"children":"Canby met the column at Simmesport and informed Banks of the new command structure. Banks returned to administrative duties in New Orleans."}]]}]]}]
22:["$","div","Taylor broke with Kirby Smith",{"className":"moment","children":[["$","$L16",null,{"seconds":1279,"label":"21:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Taylor broke with Kirby Smith"}],["$","p",null,{"children":"Taylor blamed Smith for weakening the Confederate force in Louisiana and requested relief. Smith ordered his arrest, but Taylor was promoted and transferred to another department."}]]}]]}]
23:["$","div","Shreveport remained beyond Union control",{"className":"moment","children":[["$","$L16",null,{"seconds":1361,"label":"22:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Shreveport remained beyond Union control"}],["$","p",null,{"children":"Federal troops did not enter the city until June 6, 1865, nearly fourteen months after Banks’s failed advance."}]]}]]}]
