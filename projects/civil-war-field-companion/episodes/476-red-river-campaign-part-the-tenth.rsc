n":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"DH"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"David Hunter"}],["$","p",null,{"children":"Delivered Grant’s instructions and observed Banks’s conduct at Alexandria"}]]}]]}],"$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/lexington-passes-baileys-dam.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/lexington-passes-baileys-dam.jpg","alt":"Period illustration of USS Lexington passing the Red River rapids at Alexandria","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"USS Lexington passed through the opening in Bailey’s Dam on May 9, followed by Osage, Neosho, and Fort Hindman."}]]}],["$","figure","/images/nathaniel-p-banks.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/nathaniel-p-banks.jpg","alt":"Portrait of Nathaniel P. Banks","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Banks returned to New Orleans after Canby assumed effective control of military operations in the region."}]]}],["$","figure","/images/david-dixon-porter.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/david-dixon-porter.jpg","alt":"Portrait of David Dixon Porter","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Porter’s gunboats were stranded above the Alexandria rapids until Bailey’s dams raised the river."}]]}],["$","figure","/images/richard-taylor.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/richard-taylor.jpg","alt":"Portrait of Richard Taylor","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Taylor attacked the retreating Union column but lacked the strength to stop it before the Atchafalaya crossing."}]]}]]}]]}]
