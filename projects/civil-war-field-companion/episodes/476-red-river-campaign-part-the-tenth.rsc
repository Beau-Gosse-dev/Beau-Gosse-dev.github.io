1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",476," · ","April 25–May 20, 1864"," · ","Alexandria, Yellow Bayou, and Simmesport, Louisiana"]}],["$","h1",null,{"children":"RED RIVER CAMPAIGN (Part the Tenth)"}],["$","span",null,{"className":"result-label","children":"Banks returned to Alexandria without capturing Shreveport. Joseph Bailey’s temporary dams raised the Red River enough for Porter’s trapped gunboats to pass the rapids, after which the army and fleet withdrew. Union troops burned much of Alexandria on May 13. Taylor attacked the retreating column but could not prevent it from crossing the Atchafalaya River at Simmesport on May 19–20. The campaign failed to achieve its principal objectives, delayed Grant’s planned operation against Mobile, and ended Banks’s effective field command"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7491273578.mp3?updated=1733708352","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Army returned to Alexandria",{"children":[["$","span",null,{"children":"Army returned to Alexandria"}],["$","strong",null,{"children":"April 25, 1864"}],"$undefined"]}],["$","div","Bailey’s first dams completed",{"children":[["$","span",null,{"children":"Bailey’s first dams completed"}],["$","strong",null,{"children":"May 8, 1864"}],"$undefined"]}],["$","div","First four gunboats escaped",{"children":[["$","span",null,{"children":"First four gunboats escaped"}],["$","strong",null,{"children":"May 9, 1864"}],"$undefined"]}],["$","div","Remaining ironclads escaped",{"children":[["$","span",null,{"children":"Remaining ironclads escaped"}],["$","strong",null,{"children":"May 13, 1864"}],"$undefined"]}],["$","div","Army left Alexandria",{"children":[["$","span",null,{"children":"Army left Alexandria"}],["$","strong",null,{"children":"May 13, 1864"}],"$undefined"]}],["$","div","Yellow Bayou engagement",{"children":[["$","span",null,{"children":"Yellow Bayou engagement"}],["$","strong",null,{"children":"May 18, 1864"}],"$undefined"]}],["$","div","Atchafalaya crossing",{"children":[["$","span",null,{"children":"Atchafalaya crossing"}],["$","strong",null,{"children":"May 19–20, 1864"}],"$undefined"]}],["$","div","Campaign objective not reached",{"children":[["$","span",null,{"children":"Campaign objective not reached"}],["$","strong",null,{"children":"Shreveport remained Confederate"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",n