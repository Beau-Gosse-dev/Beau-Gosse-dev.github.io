10:["$","figure","The full Red River campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/red-river-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open The full Red River campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/red-river-campaign-1864-map.jpg","alt":"Historical map of the Red River campaign from March 10 to May 22, 1864","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The full Red River campaign"}],["$","span",null,{"children":"This 1864 campaign map follows the Red River through Louisiana and marks the route toward Shreveport, including Mansfield and Pleasant Hill. The army ultimately returned down the same corridor to Alexandria."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/red-river-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/2008626486/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:2:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The campaign entered its final phase",{"className":"moment","children":[["$","$L16",null,{"seconds":80,"label":"1:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign entered its final phase"}],["$","p",null,{"children":"Banks had escaped Taylor’s attempted trap at Monett’s Ferry and was retreating toward Alexandria."}]]}]]}],["$","div","The army returned to Alexandria",{"className":"moment","children":[["$","$L16",null,{"seconds":103,"label":"1:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army returned to Alexandria"}],["$","p",null,{"children":"The lead elements entered Alexandria on April 25, thirty days after leaving the town for the advance toward Shreveport."}]]}]]}],["$","div","Mansfield and Pleasant Hill ended the advance",{"className":"moment","children":[["$","$L16",null,{"seconds":123,"label":"2:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mansfield and Pleasant Hill ended the advance"}],["$","p",null,{"children":"The defeat at Mansfield on April 8 and the fighting at Pleasant Hill on April 9 led Banks to retreat instead of continuing toward Shreveport."}]]}]]}],["$","div","Grant’s orders conflicted with Banks’s plans",{"className":"moment","children":[["$","$L16",null,{"seconds":215,"label":"3:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant’s orders conflicted with Banks’s plans"}],["$","p",null,{"children":"Grant had ordered A. J. Smith’s troops returned and wanted Banks prepared for an operation against Mobile. Banks had written that he intended to push the Confederates toward Texas."}]]}]]}],["$","div","Grant sent Hunter to Banks",{"className":"moment","children":[["$","$L16",null,{"seconds":304,"label":"5:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant sent Hunter to Banks"}],["$","p",null,{"children":"Major General David Hunter carried instructions that Mobile mattered more than Shreveport and reached Alexandria on April 27."}]]}]]}],["$","div","Grant sought Banks’s removal",{"className":"moment","children":[["$","$L16",null,{"seconds":395,"label":"6:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant sought Banks’s removal"}],["$","p",null,{"children":"Reports of the campaign’s failure led Grant to ask that Banks be replaced. Lincoln delayed the removal because Banks still had political value in New England."}]]}]]}],["$","div","Smith’s troops remained with the expedition",{"className":"moment","children":[["$","$L16",null,{"seconds":433,"label":"7:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith’s troops remained with the expedition"}],["$","p",null,{"children":"Grant allowed the troops to stay after learning that Porter needed them to protect the stranded fleet. The delay forced Grant to abandon the immediate Mobile operation."}]]}]]}],["$","div","Canby received authority over Banks",{"className":"moment","children":[["$","$L16",null,{"seconds":494,"label":"8:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Canby received authority over Banks"}],["$","p",null,{"children":"Edward R. S. Canby took command of the new Military Division of West Mississippi. Banks retained the Department of the Gulf in name but became Canby’s subordinate."}]]}]]}],["$","div","Porter’s fleet was trapped",{"className":"moment","children":[["$","$L16",null,{"seconds":548,"label":"9:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Porter’s fleet was trapped"}],["$","p",null,{"children":"Extremely low water left ten named gunboats above the Alexandria rapids. The vessels might have to be destroyed if the army withdrew before they escaped."}]]}]]}],["$","div","Bailey proposed temporary dams",{"className":"moment","children":[["$","$L16",null,{"seconds":671,"label":"11:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Bailey proposed temporary dams"}],["$","p",null,{"children":"Lieutenant Colonel Joseph Bailey applied logging experience from Wisconsin to a plan for raising the river above the rapids."}]]}]]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]]}]
