d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",476," · ","April 25–May 20, 1864"," · ","Alexandria, Yellow Bayou, and Simmesport, Louisiana"]}],["$","h1",null,{"children":"RED RIVER CAMPAIGN (Part the Tenth)"}],["$","span",null,{"className":"result-label","children":"Banks returned to Alexandria without capturing Shreveport. Joseph Bailey’s temporary dams raised the Red River enough for Porter’s trapped gunboats to pass the rapids, after which the army and fleet withdrew. Union troops burned much of Alexandria on May 13. Taylor attacked the retreating column but could not prevent it from crossing the Atchafalaya River at Simmesport on May 19–20. The campaign failed to achieve its principal objectives, delayed Grant’s planned operation against Mobile, and ended Banks’s effective field command"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 25–May 20, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Alexandria, Yellow Bayou, and Simmesport, Louisiana"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Banks returned to Alexandria without capturing Shreveport. Joseph Bailey’s temporary dams raised the Red River enough for Porter’s trapped gunboats to pass the rapids, after which the army and fleet withdrew. Union troops burned much of Alexandria on May 13. Taylor attacked the retreating column but could not prevent it from crossing the Atchafalaya River at Simmesport on May 19–20. The campaign failed to achieve its principal objectives, delayed Grant’s planned operation against Mobile, and ended Banks’s effective field command"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"April 25–May 20, 1864","place":"Alexandria, Yellow Bayou, and Simmesport, Louisiana","result":"Banks returned to Alexandria without capturing Shreveport. Joseph Bailey’s temporary dams raised the Red River enough for Porter’s trapped gunboats to pass the rapids, after which the army and fleet withdrew. Union troops burned much of Alexandria on May 13. Taylor attacked the retreating column but could not prevent it from crossing the Atchafalaya River at Simmesport on May 19–20. The campaign failed to achieve its principal objectives, delayed Grant’s planned operation against Mobile, and ended Banks’s effective field command","facts":[{"label":"Army returned to Alexandria","value":"April 25, 1864"},{"label":"Bailey’s first dams completed","value":"May 8, 1864"},{"label":"First four gunboats escaped","value":"May 9, 1864"},{"label":"Remaining ironclads escaped","value":"May 13, 1864"},{"label":"Army left Alexandria","value":"May 13, 1864"},{"label":"Yellow Bayou engagement","value":"May 18, 1864"},{"label":"Atchafalaya crossing","value":"May 19–20, 1864"},{"label":"Campaign objective not reached","value":"Shreveport remained Confederate"}],"maps":[{"title":"Alexandria and the lower Red River","caption":"Alexandria stood at the Red River rapids that trapped Porter’s fleet. After passing Bailey’s Dam, the vessels steamed downriver toward the Mississippi.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-93.02%2C30.80%2C-91.45%2C31.75&layer=mapnik&marker=31.3113%2C-92.4451"},{"title":"Federal withdrawal to Simmesport","caption":"Banks’s army left Alexandria on May 13, fought rear-guard actions while Taylor’s smaller force followed, and crossed the Atchafalaya River at Simmesport on May 19–20.","source":"https://www.nps.gov/civilwar/louisiana.htm","image":"/images/red-river-retreat-1864.svg","alt":"Schematic map of the Union withdrawal from Alexandria through Yellow Bayou to Simmesport"},{"title":"The full Red River campaign","caption":"This 1864 campaign map follows the Red River through Louisiana and marks the route toward Shreveport, including Mansfield and Pleasant Hill. The army ultimately returned down the same corridor to Alexandria.","source":"https://www.loc.gov/item/2008626486/","image":"/images/red-river-campaign-1864-map.jpg","alt":"Historical map of the Red River campaign from March 10 to May 22, 1864"}],"moments":[{"time":"1:20","audioTime":80,"title":"The campaign entered its final phase","detail":"Banks had escaped Taylor’s attempted trap at Monett’s Ferry and was retreating toward Alexandria."},{"time":"1:43","audioTime":103,"title":"The army returned to Alexandria","detail":"The lead elements entered Alexandria on April 25, thirty days after leaving the town for the advance toward Shreveport."},{"time":"2:03","audioTime":123,"title":"Mansfield and Pleasant Hill ended the advance","detail":"The defeat at Mansfield on April 8 and the fighting at Pleasant Hill on April 9 led Banks to retreat instead of continuing toward Shreveport."},{"time":"3:35","audioTime":215,"title":"Grant’s orders conflicted with Banks’s plans","detail":"Grant had ordered A. J. Smith’s troops returned and wanted Banks prepared for an operation against Mobile. Banks had written that he intended to push the Confederates toward Texas."},{"time":"5:04","audioTime":304,"title":"Grant sent Hunter to Banks","detail":"Major General David Hunter carried instructions that Mobile mattered more than Shreveport and reached Alexandria on April 27."},{"time":"6:35","audioTime":395,"title":"Grant sought Banks’s removal","detail":"Reports of the campaign’s failure led Grant to ask that Banks be replaced. Lincoln delayed the removal because Banks still had political value in New England."},{"time":"7:13","audioTime":433,"title":"Smith’s troops remained with the expedition","detail":"Grant allowed the troops to stay after learning that Porter needed them to protect the stranded fleet. The delay forced Grant to abandon the immediate Mobile operation."},{"time":"8:14","audioTime":494,"title":"Canby received authority over Banks","detail":"Edward R. S. Canby took command of the new Military Division of West Mississippi. Banks retained the Department of the Gulf in name but became Canby’s subordinate."},{"time":"9:08","audioTime":548,"title":"Porter’s fleet was trapped","detail":"Extremely low water left ten named gunboats above the Alexandria rapids. The vessels might have to be destroyed if the army withdrew before they escaped."},{"time":"11:11","audioTime":671,"title":"Bailey proposed temporary dams","detail":"Lieutenant Colonel Joseph Bailey applied logging experience from Wisconsin to a plan for raising the river above the rapids."},{"time":"12:16","audioTime":736,"title":"Banks approved the plan","detail":"After Franklin arranged a meeting with Banks and Hunter on April 29, Banks authorized construction."},{"time":"13:45","audioTime":825,"title":"Soldiers built the dams","detail":"Maine soldiers with logging experience built a tree dam from one bank. Black troops from the Corps d’Afrique built crib structures from barges loaded with brick, stone, and demolished building material."},{"time":"14:19","audioTime":859,"title":"The first dams raised the river","detail":"By May 8 the structures had produced a deeper pool above the rapids, allowing the shallow-draft vessels to move close to the gap."},{"time":"15:02","audioTime":902,"title":"Four gunboats passed on May 9","detail":"When part of the dam broke, Lexington passed through the opening, followed by Osage, Neosho, and Fort Hindman."},{"time":"15:27","audioTime":927,"title":"Bailey added wing dams","detail":"The first release did not free every vessel, so Bailey repaired the works and added structures that directed more water into the channel."},{"time":"16:33","audioTime":993,"title":"The remaining ironclads escaped","detail":"Guns, armor, and cotton were removed to reduce draft. On May 13 the water was deep enough for the lightened ships to pass."},{"time":"18:14","audioTime":1094,"title":"The army left Alexandria","detail":"The first troops marched out at 7 a.m. on May 13. Union soldiers then set fires that destroyed most of the town despite attempts by staff officers and the provost guard to stop them."},{"time":"19:04","audioTime":1144,"title":"Taylor attacked the retreat","detail":"Confederate forces harassed the column and fought an artillery action about forty miles below Alexandria on May 16."},{"time":"19:28","audioTime":1168,"title":"The armies fought at Yellow Bayou","detail":"A sharp engagement on May 18 failed to stop Banks’s withdrawal because Taylor did not have enough troops."},{"time":"19:39","audioTime":1179,"title":"The army crossed at Simmesport","detail":"Bailey built a bridge across the Atchafalaya River. The Union army crossed on May 19–20 and dismantled the bridge, ending Taylor’s pursuit and the campaign."},{"time":"20:02","audioTime":1202,"title":"Canby reduced Banks’s role","detail":"Canby met the column at Simmesport and informed Banks of the new command structure. Banks returned to administrative duties in New Orleans."},{"time":"21:19","audioTime":1279,"title":"Taylor broke with Kirby Smith","detail":"Taylor blamed Smith for weakening the Confederate force in Louisiana and requested relief. Smith ordered his arrest, but Taylor was promoted and transferred to another department."},{"time":"22:41","audioTime":1361,"title":"Shreveport remained beyond Union control","detail":"Federal troops did not enter the city until June 6, 1865, nearly fourteen months after Banks’s failed advance."}],"command":[{"side":"United States","color":"#315f8c","branches":[{"commander":"Abraham Lincoln","command":"President and commander-in-chief","subordinates":"Delayed Banks’s removal for political reasons"},{"commander":"Ulysses S. Grant","command":"General-in-chief","subordinates":"Sought to redirect forces toward Mobile and remove Banks from field command"},{"commander":"Henry W. Halleck","command":"Army chief of staff","subordinates":"Transmitted Grant’s recommendations and consulted Lincoln"},{"commander":"Edward R. S. Canby","command":"Military Division of West Mississippi","subordinates":"Assumed authority over the Departments of the Gulf and Arkansas"},{"commander":"Nathaniel P. Banks","command":"Department of the Gulf","subordinates":"Led the army’s withdrawal; remained in office under Canby"},{"commander":"A. J. Smith","command":"XVI and XVII Corps detachments","subordinates":"Protected Alexandria and promised to remain until Porter’s fleet escaped"},{"commander":"David Dixon Porter","command":"Mississippi Squadron","subordinates":"Directed the trapped naval force above the Alexandria rapids"},{"commander":"Joseph Bailey","command":"Engineer Brigade, XIX Corps","subordinates":"Designed the dams and the Simmesport bridge"}]},{"side":"Confederacy","color":"#9a3d32","branches":[{"commander":"E. Kirby Smith","command":"Trans-Mississippi Department","subordinates":"Senior Confederate commander west of the Mississippi"},{"commander":"Richard Taylor","command":"District of West Louisiana","subordinates":"Harassed Banks’s withdrawal and fought at Yellow Bayou"}]}],"people":[{"name":"Joseph Bailey","role":"Designed the temporary dams at Alexandria and the bridge used at Simmesport","side":"United States"},{"name":"David Hunter","role":"Delivered Grant’s instructions and observed Banks’s conduct at Alexandria","side":"United States"},{"name":"William B. Franklin","role":"Supported Bailey’s proposal before leaving on medical leave for his Mansfield injury","side":"United States"},{"name":"Edward R. S. Canby","role":"Replaced Banks as the effective senior commander in the region","side":"United States"},{"name":"Nathaniel P. Banks","role":"Led the failed expedition and the withdrawal from Alexandria","side":"United States","image":"/images/nathaniel-p-banks.jpg","source":"https://commons.wikimedia.org/wiki/File:Nathaniel_P._Banks_portrait.jpg"},{"name":"David Dixon Porter","role":"Commanded the Mississippi Squadron and moved its trapped gunboats through Bailey’s dams","side":"United States","image":"/images/david-dixon-porter.jpg","source":"https://www.loc.gov/exhibits/civil-war-in-america/biographies/david-dixon-porter.html"},{"name":"Richard Taylor","role":"Directed Confederate pressure against the retreating Union column","side":"Confederacy","image":"/images/richard-taylor.jpg","source":"https://www.loc.gov/item/2018666550/"},{"name":"E. Kirby Smith","role":"Commanded the Trans-Mississippi Department and quarreled with Taylor after the campaign","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/lexington-passes-baileys-dam.jpg","alt":"Period illustration of USS Lexington passing the Red River rapids at Alexandria","caption":"USS Lexington passed through the opening in Bailey’s Dam on May 9, followed by Osage, Neosho, and Fort Hindman.","source":"https://commons.wikimedia.org/wiki/File:Lexington_passes_the_falls.jpg"},{"image":"/images/nathaniel-p-banks.jpg","alt":"Portrait of Nathaniel P. Banks","caption":"Banks returned to New Orleans after Canby assumed effective control of military operations in the region.","source":"https://commons.wikimedia.org/wiki/File:Nathaniel_P._Banks_portrait.jpg"},{"image":"/images/david-dixon-porter.jpg","alt":"Portrait of David Dixon Porter","caption":"Porter’s gunboats were stranded above the Alexandria rapids until Bailey’s dams raised the river.","source":"https://www.loc.gov/exhibits/civil-war-in-america/biographies/david-dixon-porter.html"},{"image":"/images/richard-taylor.jpg","alt":"Portrait of Richard Taylor","caption":"Taylor attacked the retreating Union column but lacked the strength to stop it before the Atchafalaya crossing.","source":"https://www.loc.gov/item/2018666550/"}],"sources":[{"label":"Civil War Podcast episode 476","url":"https://civilwarpodcast.org/2024/12/08/civil-war-podcast-episode-476/"},{"label":"Library of Congress: Red River campaign map","url":"https://www.loc.gov/item/2008626486/"},{"label":"Library of Congress: Bailey’s Dam historic documentation","url":"https://www.loc.gov/item/la0217/"},{"label":"National Park Service: Louisiana Civil War operations","url":"https://www.nps.gov/civilwar/louisiana.htm"},{"label":"National Park Service: Bailey’s Dam history","url":"https://npgallery.nps.gov/GetAsset/49b659ab-8838-48f9-9f38-e90a86870253"},{"label":"Library of Congress: David Dixon Porter","url":"https://www.loc.gov/exhibits/civil-war-in-america/biographies/david-dixon-porter.html"},{"label":"Library of Congress: Richard Taylor portrait","url":"https://www.loc.gov/item/2018666550/"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
