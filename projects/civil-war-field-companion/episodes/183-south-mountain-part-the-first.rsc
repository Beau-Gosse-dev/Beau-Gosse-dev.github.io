d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",183," · ","September 9–14, 1862"," · ","Frederick and the roads west across the Catoctin range and South Mountain to Boonsboro, Hagerstown, Sharpsburg, and Harpers Ferry in western Maryland"]}],["$","h1",null,{"children":"SOUTH MOUNTAIN (Part the First)"}],["$","span",null,{"className":"result-label","children":"United States operational opportunity and eventual battlefield victory. The lost copy of Special Orders No. 191 revealed that Robert E. Lee’s army was divided, but George B. McClellan spent the afternoon and night of September 13 checking the dated order and preparing his advance. Fighting at the South Mountain gaps on September 14 drove the Confederate defenders back, while their delay helped Lee reunite much of his army near Sharpsburg"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"September 9–14, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Frederick and the roads west across the Catoctin range and South Mountain to Boonsboro, Hagerstown, Sharpsburg, and Harpers Ferry in western Maryland"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"United States operational opportunity and eventual battlefield victory. The lost copy of Special Orders No. 191 revealed that Robert E. Lee’s army was divided, but George B. McClellan spent the afternoon and night of September 13 checking the dated order and preparing his advance. Fighting at the South Mountain gaps on September 14 drove the Confederate defenders back, while their delay helped Lee reunite much of his army near Sharpsburg"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],false,false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"September 9–14, 1862","place":"Frederick and the roads west across the Catoctin range and South Mountain to Boonsboro, Hagerstown, Sharpsburg, and Harpers Ferry in western Maryland","result":"United States operational opportunity and eventual battlefield victory. The lost copy of Special Orders No. 191 revealed that Robert E. Lee’s army was divided, but George B. McClellan spent the afternoon and night of September 13 checking the dated order and preparing his advance. Fighting at the South Mountain gaps on September 14 drove the Confederate defenders back, while their delay helped Lee reunite much of his army near Sharpsburg","facts":[{"label":"Episode scope","value":"The lost order’s discovery, McClellan’s intelligence problem, and the opportunity before the Battle of South Mountain","note":"The episode summarizes the September 14 result but reserves the detailed fighting at Turner’s, Fox’s, and Crampton’s Gaps for later installments."},{"label":"Order issued","value":"Special Orders No. 191, Frederick, September 9, 1862","note":"Lee’s order assigned the movements intended to capture Martinsburg and Harpers Ferry while the main body and its trains moved west of South Mountain."},{"label":"Army divided","value":"Twenty-six of forty Confederate brigades sent toward the lower Shenandoah Valley","note":"This is the count used in the episode. Those columns would be outside practical supporting distance from the forces around Boonsboro and Hagerstown until the Harpers Ferry operation ended."},{"label":"Lee’s assumption","value":"Speed and McClellan’s caution would protect the separated columns","note":"Lee expected Stuart’s cavalry and the South Mountain barrier to conceal the operation long enough for the army to reunite."},{"label":"Copies prepared","value":"Lt. Col. Robert H. Chilton distributed Lee’s written order","note":"As assistant adjutant general, Chilton prepared copies at army headquarters for the commanders named in the plan."},{"label":"Hill’s second copy","value":"Jackson separately copied the order for D. H. Hill","note":"Hill received Jackson’s handwritten copy. The copy from army headquarters addressed to Hill became the lost order."},{"label":"Order found","value":"Morning of September 13 near Frederick","note":"Members of Company F, 27th Indiana Infantry found the document in ground recently occupied by Confederate troops on the Best Farm, now part of Monocacy National Battlefield."},{"label":"Finders","value":"Cpl. Barton W. Mitchell and Sgt. John M. Bloss","note":"The episode names both soldiers. National Park Service research emphasizes Bloss’s September 26 letter as the closest surviving participant account."},{"label":"The cigars","value":"The document was wrapped around cigars","note":"The transcript says three cigars; National Park Service pages commonly say two. The number does not affect the identification or military significance of the order."},{"label":"Authentication","value":"Lt. Col. Samuel E. Pittman recognized Chilton’s handwriting","note":"Pittman, an aide to Brig. Gen. Alpheus S. Williams, knew Chilton before the war and vouched for the document as it moved up the Federal chain of command."},{"label":"Delivery to McClellan","value":"Around midday to early afternoon on September 13","note":"The episode places the paper in McClellan’s hands roughly three hours after its discovery. Surviving accounts do not establish every step to the minute, and official summaries differ on whether to call the delivery noon or early evening."},{"label":"Initial reaction","value":"“Now I know what to do”","note":"The episode describes McClellan breaking off a meeting with Frederick civilians, studying the order, and immediately recognizing its value."},{"label":"Message to Lincoln","value":"McClellan reported that he had Lee’s plans and expected success","note":"The surviving telegram is dated midnight on September 13. McClellan wrote that no time would be lost, that Lee had made a gross mistake, and that the Federal army was moving as rapidly as possible."},{"label":"Federal field strength","value":"About 85,000 under arms in the episode’s account","note":"The Army of the Potomac advanced in three wings. The hosts also cite roughly 70,000 additional troops in the Washington defenses, not all immediately available for the field campaign."},{"label":"McClellan’s estimate","value":"At least 120,000 Confederates","note":"McClellan repeated this estimate to general in chief Henry W. Halleck on September 11, leaving him unable to accept his actual numerical advantage."},{"label":"Pinkerton’s estimate","value":"Two hundred thousand Confederates in Virginia in an August 10 analysis","note":"Allan Pinkerton’s intelligence reports and McClellan’s method of interpreting them contributed to persistent overestimates of Confederate strength."},{"label":"Cavalry intelligence","value":"Pleasonton reported 100,000 Confederates on September 8","note":"Stuart’s cavalry screen limited Federal observation. The transcript also cites Pleasonton’s September 7 report of 30,000 at Frederick and another 60,000 under Jackson moving northeast, a movement that did not occur."},{"label":"Geographic barrier","value":"South Mountain controlled the roads west from Frederick","note":"An army moving west crossed the Catoctin hills and then needed the South Mountain gaps to reach Boonsboro and the Cumberland Valley. Hagerstown lay north, while Sharpsburg and Harpers Ferry lay south."},{"label":"Principal passes","value":"Turner’s, Fox’s, and Crampton’s Gaps","note":"The National Road used Turner’s Gap. Fox’s Gap lay about a mile south, and Crampton’s Gap lay roughly five miles farther south on the route from Burkittsville into Pleasant Valley."},{"label":"Federal position at noon","value":"Thirteen divisions near Frederick and four divisions farther south","note":"The episode places the northern concentration about twelve miles from Turner’s Gap and the southern group about twelve miles from Crampton’s Gap on September 13."},{"label":"Immediate opportunity","value":"Cross South Mountain and attack Lee’s separated commands","note":"McClellan could direct his right and center through Turner’s and Fox’s Gaps while Franklin’s left wing moved through Crampton’s Gap toward the Harpers Ferry operation."},{"label":"Castiglione comparison","value":"McClellan compared the opening to Napoleon’s 1796 victory","note":"At Castiglione, Napoleon concentrated against separated Austrian forces. McClellan expected the lost order to offer a comparable chance to defeat Lee’s army in detail."},{"label":"Verification order","value":"Pleasonton was told at 3 p.m. to test the order against current movements","note":"The document was four days old, Longstreet was at Hagerstown rather than Boonsboro, and Harpers Ferry had not fallen on Lee’s timetable. Those discrepancies were real reasons to determine how much of the plan remained current."},{"label":"Response interval","value":"The episode describes an eighteen-hour delay before a new advance","note":"This follows Stephen W. Sears’s interpretation that only previously scheduled short movements occurred on September 13. Historians continue to debate how quickly McClellan acted and how much faster the army could have moved."},{"label":"Confederate screen","value":"D. H. Hill and Stuart guarded the South Mountain approaches","note":"Longstreet was at Hagerstown and returned toward the mountain after Lee received warning of the faster Federal advance."},{"label":"Battle outcome","value":"Federal forces drove the Confederates from all three gaps on September 14","note":"The victory opened the routes west, but the Confederate defense consumed enough time for the Harpers Ferry operation to continue and for Lee to concentrate near Sharpsburg."},{"label":"Senior battlefield deaths","value":"Jesse L. Reno and Samuel Garland Jr. were killed","note":"Both fell at Fox’s Gap on September 14. Their deaths belong to the battle summarized at the end of this episode, although the detailed combat narrative begins in the next installment."},{"label":"Recommended book","value":"“The Battle of South Mountain” by John David Hoptak","note":"The official episode page and podcast book list identify Hoptak’s campaign study as the recommendation."},{"label":"Transcript normalizations","value":"Castiglione, Chilton, Samuel E. Pittman, Alpheus S. Williams, Edwin V. Sumner, and Alfred Pleasonton","note":"The automated transcript produces forms including “Castellone,” “Pittman,” “Commoner,” and “Pleasanton.” The guide uses standard spellings and full names."}],"maps":[{"title":"The operational opening on September 13","caption":"The lost order showed McClellan that Lee’s army was spread from Hagerstown and Boonsboro to the heights around Harpers Ferry. The Army of the Potomac was concentrated near Frederick and farther south, east of the South Mountain passes. Arrows show the main Federal opportunities opened by the intelligence, not movements completed at the moment the document arrived. Routes and positions are generalized; this map is schematic and not to scale.","source":"U.S. Army Center of Military History, National Park Service, Special Orders No. 191, Ezra A. Carman campaign maps, and episode transcript; see sources below.","image":"/images/ep183-operational-situation.svg","alt":"Schematic map of western Maryland on September 13, 1862, showing McClellan near Frederick, Lee and Longstreet near Hagerstown, D. H. Hill near Boonsboro, Confederate columns around Harpers Ferry, and Federal routes through the South Mountain gaps."},{"title":"The roads through South Mountain","caption":"Turner’s Gap carried the National Road toward Boonsboro, Fox’s Gap provided a nearby southern crossing, and Crampton’s Gap connected Burkittsville with Pleasant Valley and the Harpers Ferry approaches. McClellan’s right wing moved toward Turner’s and Fox’s Gaps while Franklin’s left wing approached Crampton’s Gap. Terrain and unit footprints are generalized; this map is schematic and not to scale.","source":"U.S. Army Center of Military History Antietam staff ride guide, National Park Service battlefield accounts, Ezra A. Carman maps, and episode transcript; see sources below.","image":"/images/ep183-south-mountain-gaps.svg","alt":"Schematic map of Turner’s, Fox’s, and Crampton’s Gaps through South Mountain, with Federal approaches from Middletown and Burkittsville and Confederate covering positions west of the ridge."}],"moments":[{"time":"1:10","audioTime":70,"title":"The lost order returns to the center of the campaign","detail":"The episode resumes with Special Orders No. 191 in Federal hands and asks whether McClellan can exploit the opportunity."},{"time":"1:34","audioTime":94,"title":"Lee’s September 9 plan is restated","detail":"At Frederick, Lee issues the order that divides his invading army while he seeks a decisive campaign in Maryland or Pennsylvania."},{"time":"2:39","audioTime":159,"title":"Lee states that he entered Maryland to fight","detail":"A postwar recollection is used to emphasize his intention to bring McClellan to battle and defeat the Army of the Potomac."},{"time":"3:15","audioTime":195,"title":"Twenty-six brigades are assigned to the valley operation","detail":"Most of Lee’s brigades are sent to clear Martinsburg and Harpers Ferry, leaving the army temporarily unable to support all of its parts."},{"time":"4:05","audioTime":245,"title":"The plan depends on speed and concealment","detail":"Lee expects McClellan to continue moving cautiously while Stuart and South Mountain hide the separated Confederate columns."},{"time":"4:58","audioTime":298,"title":"Chilton prepares copies at headquarters","detail":"Lee’s assistant adjutant general reduces the plan to written copies for the commanders involved."},{"time":"5:24","audioTime":324,"title":"Jackson sends Hill a separate copy","detail":"Jackson transcribes the order in his own hand for D. H. Hill, creating the duplicate that later obscures the army-headquarters copy’s disappearance."},{"time":"5:50","audioTime":350,"title":"The Confederate army leaves Frederick","detail":"Jackson leads the westward movement on September 10 as the different assignments in the order take effect."},{"time":"6:02","audioTime":362,"title":"Mitchell and Bloss find the envelope","detail":"On September 13, soldiers of the 27th Indiana discover a paper wrapped around cigars in a meadow recently occupied by Confederates."},{"time":"7:09","audioTime":429,"title":"Williams and Pittman authenticate the discovery","detail":"Alpheus Williams recognizes the operational importance, and Samuel Pittman identifies Robert Chilton’s handwriting from prewar acquaintance."},{"time":"8:00","audioTime":480,"title":"The order reaches McClellan","detail":"The document arrives at army headquarters roughly three hours after the episode places its discovery."},{"time":"8:31","audioTime":511,"title":"McClellan declares that he knows what to do","detail":"His first response is elation: the uncertain Confederate movements now appear to form a comprehensible plan."},{"time":"8:41","audioTime":521,"title":"McClellan answers Lincoln","detail":"He reports confidence, predicts that Lee will be severely punished, and says that he has the Confederate plans."},{"time":"11:08","audioTime":668,"title":"The earlier Federal caution is explained","detail":"Before the discovery, McClellan lacked reliable knowledge of Confederate numbers and intentions and spread his advance across a broad front."},{"time":"11:33","audioTime":693,"title":"The Army of the Potomac advances in three wings","detail":"Franklin, Sumner, and Burnside command the left, center, and right across a roughly twenty-five-mile arc."},{"time":"11:57","audioTime":717,"title":"Federal numerical superiority is identified","detail":"The episode gives McClellan about 85,000 troops in the field while Lee’s ranks continue to lose stragglers."},{"time":"12:29","audioTime":749,"title":"Pinkerton’s estimates shape McClellan’s assumptions","detail":"McClellan relies on intelligence that greatly inflates Confederate strength in Virginia and in Lee’s field army."},{"time":"13:11","audioTime":791,"title":"Pleasonton reports an imaginary movement toward Baltimore","detail":"Faulty cavalry reports credit Lee with as many as 100,000 men and reinforce McClellan’s expectation that he is outnumbered."},{"time":"13:59","audioTime":839,"title":"McClellan tells Halleck that Lee has at least 120,000","detail":"The September 11 estimate shows the numerical premise that still governs Federal planning two days later."},{"time":"14:39","audioTime":879,"title":"Conflicting movements west of Frederick cause confusion","detail":"Reports place Confederates both north toward Hagerstown and south toward Harpers Ferry, movements McClellan cannot yet explain."},{"time":"15:24","audioTime":924,"title":"The order’s loss remains unresolved","detail":"The episode separates two established facts—the headquarters copy for Hill was not delivered and Mitchell found it—from a probable but unproven courier explanation."},{"time":"16:18","audioTime":978,"title":"A courier failure is reconstructed","detail":"The hosts suggest that the courier found Hill already had Jackson’s copy and concealed or failed to report the missing headquarters dispatch."},{"time":"17:25","audioTime":1045,"title":"Lee does not investigate during the campaign","detail":"The absence of an alarm in the Confederate chain of command leaves Lee unaware that his operational plan is exposed."},{"time":"17:51","audioTime":1071,"title":"The divided army faces disaster","detail":"The information gives McClellan a route through South Mountain toward Confederate commands that cannot promptly support one another."},{"time":"18:02","audioTime":1082,"title":"McClellan shows the order to John Gibbon","detail":"He says that if the paper cannot help him defeat Lee, he is willing to go home."},{"time":"18:41","audioTime":1121,"title":"The operational opening becomes clear","detail":"A rapid advance through the mountain passes could separate Lee around Boonsboro and Hagerstown from Jackson’s Harpers Ferry operation."},{"time":"18:48","audioTime":1128,"title":"Western Maryland geography is laid out","detail":"The hosts trace the Catoctins, South Mountain, Boonsboro, Hagerstown, Harpers Ferry, Antietam Creek, and Sharpsburg."},{"time":"20:50","audioTime":1250,"title":"McClellan imagines a Castiglione","detail":"He compares his opportunity to Napoleon’s 1796 defeat of separated Austrian forces in northern Italy."},{"time":"21:29","audioTime":1289,"title":"Seventeen Federal divisions stand east of the passes","detail":"The episode places thirteen divisions near Frederick and four farther south, each group about twelve miles from its assigned mountain route."},{"time":"22:32","audioTime":1352,"title":"Immediate movement is identified as the requirement","detail":"To reach the gaps at first light on September 14, McClellan would need to move his formations toward the mountain that afternoon and evening."},{"time":"23:11","audioTime":1391,"title":"The episode marks an eighteen-hour response interval","detail":"Following Stephen Sears, the hosts distinguish short previously ordered marches from movement undertaken because of the lost order."},{"time":"24:14","audioTime":1454,"title":"The dated order creates new uncertainties","detail":"Harpers Ferry remains in Federal hands and Longstreet is at Hagerstown, showing that parts of the four-day-old document are already outdated."},{"time":"25:08","audioTime":1508,"title":"McClellan verifies and plans through the rest of the day","detail":"His initial excitement gives way to caution as he checks Confederate dispositions and prepares the September 14 advance."},{"time":"25:57","audioTime":1557,"title":"The coming battle is summarized","detail":"Federal troops take the gaps after a long fight, but Hill’s rear guard and Longstreet’s returning troops buy time for Lee to reunite."},{"time":"26:28","audioTime":1588,"title":"The episode recommends John David Hoptak","detail":"“The Battle of South Mountain” is offered as a focused account of the fighting that led directly toward Antietam."}],"command":[{"side":"United States","color":"#315f8c","branches":[{"commander":"Maj. Gen. George B. McClellan","command":"Army of the Potomac","subordinates":"Received Special Orders No. 191, ordered its information checked, and directed the advance toward South Mountain and Harpers Ferry"},{"commander":"Maj. Gen. Ambrose E. Burnside","command":"Right Wing","subordinates":"I Corps under Joseph Hooker and IX Corps under Jesse L. Reno; assigned the northern advance toward Turner’s and Fox’s Gaps"},{"commander":"Maj. Gen. Edwin V. Sumner","command":"Center Wing","subordinates":"II Corps and XII Corps in the main concentration near Frederick; Alpheus Williams temporarily led XII Corps when the lost order was found"},{"commander":"Maj. Gen. William B. Franklin","command":"Left Wing","subordinates":"VI Corps and Darius N. Couch’s division; advanced from the south toward Crampton’s Gap and the route to Harpers Ferry"},{"commander":"Brig. Gen. Alfred Pleasonton","command":"Cavalry Division","subordinates":"Screened the army, reported Confederate movements, and received McClellan’s 3 p.m. instruction to test the lost order against current positions"},{"commander":"Brig. Gen. Alpheus S. Williams","command":"XII Corps, acting commander","subordinates":"Received the document from the 27th Indiana and sent it to McClellan after his aide Samuel E. Pittman authenticated Chilton’s handwriting"}]},{"side":"Confederacy","color":"#9a3d32","branches":[{"commander":"Gen. Robert E. Lee","command":"Army of Northern Virginia","subordinates":"Directed the separated operation and remained with the main body between Boonsboro and Hagerstown before ordering concentration toward South Mountain and Sharpsburg"},{"commander":"Maj. Gen. James Longstreet","command":"Main body near Hagerstown","subordinates":"Moved north of Boonsboro with much of the army’s reserve and returned toward South Mountain when the Federal threat became clear"},{"commander":"Maj. Gen. D. H. Hill","command":"Division covering Boonsboro and South Mountain","subordinates":"Guarded the rear of the main body; the lost headquarters copy of Special Orders No. 191 was addressed to him"},{"commander":"Maj. Gen. J. E. B. Stuart","command":"Cavalry Division","subordinates":"Screened the eastern approaches to the mountain and contested Federal cavalry reconnaissance"},{"commander":"Maj. Gen. Thomas J. “Stonewall” Jackson","command":"Harpers Ferry operation from the west","subordinates":"Captured Martinsburg and reached the western approaches to Harpers Ferry with three divisions"},{"commander":"Maj. Gen. Lafayette McLaws and Brig. Gen. John G. Walker","command":"Maryland Heights and Loudoun Heights columns","subordinates":"Closed on Harpers Ferry from the north and south while Lee’s main body remained west of South Mountain"},{"commander":"Lt. Col. Robert H. Chilton","command":"Assistant adjutant general, army headquarters","subordinates":"Prepared and distributed the headquarters copies of Special Orders No. 191"}]}],"people":[{"name":"George B. McClellan","role":"Army of the Potomac commander who received the lost order and planned the advance on South Mountain","side":"United States","image":"/images/ep183-george-mcclellan.jpg","source":"Library of Congress Prints and Photographs Division; see sources below."},{"name":"Robert E. Lee","role":"Army of Northern Virginia commander whose divided operational plan was exposed","side":"Confederacy"},{"name":"Barton W. Mitchell","role":"27th Indiana corporal credited with picking up the lost order near Frederick","side":"United States"},{"name":"John M. Bloss","role":"27th Indiana sergeant present at the discovery who described it in a September 26 letter","side":"United States"},{"name":"Alpheus S. Williams","role":"Acting XII Corps commander who recognized the document’s importance and forwarded it","side":"United States"},{"name":"Samuel E. Pittman","role":"Williams’s aide who authenticated Robert H. Chilton’s handwriting","side":"United States"},{"name":"Robert H. Chilton","role":"Confederate assistant adjutant general who prepared the headquarters copies of the order","side":"Confederacy"},{"name":"D. H. Hill","role":"Confederate division commander for whom the lost copy was intended and who defended the northern gaps","side":"Confederacy"},{"name":"Alfred Pleasonton","role":"Federal cavalry commander whose inflated reports reinforced McClellan’s caution and who checked the order’s current accuracy","side":"United States"},{"name":"Allan Pinkerton","role":"Head of McClellan’s intelligence service whose estimates contributed to exaggerated Confederate totals","side":"United States"},{"name":"John Gibbon","role":"Federal brigadier to whom McClellan displayed the lost order while predicting Lee’s defeat","side":"United States"},{"name":"Jesse L. Reno","role":"IX Corps commander killed at Fox’s Gap during the battle summarized at the episode’s end","side":"United States"},{"name":"Samuel Garland Jr.","role":"Confederate brigade commander killed at Fox’s Gap during the battle summarized at the episode’s end","side":"Confederacy"}],"losses":[{"name":"Jesse L. Reno","side":"United States","role":"Major general commanding IX Corps","outcome":"Killed near Fox’s Gap late on September 14 while examining the Federal line"},{"name":"Samuel Garland Jr.","side":"Confederacy","role":"Brigadier general commanding a brigade in D. H. Hill’s division","outcome":"Killed at Fox’s Gap on September 14 while attempting to steady the Confederate defense"}],"gallery":[{"image":"/images/ep183-operational-situation.svg","alt":"Schematic operational map of the divided Confederate army and the Federal routes west from Frederick on September 13, 1862.","caption":"The lost order located Lee’s main body beyond South Mountain and the Harpers Ferry columns farther south. It gave McClellan a clear chance to advance through the gaps between them.","source":"U.S. Army Center of Military History, National Park Service, Special Orders No. 191, Ezra A. Carman maps, and episode transcript; see sources below."},{"image":"/images/ep183-south-mountain-gaps.svg","alt":"Schematic map of the roads through Turner’s, Fox’s, and Crampton’s Gaps.","caption":"Turner’s and Fox’s Gaps covered the main route toward Boonsboro. Crampton’s Gap opened a route into Pleasant Valley and toward the Confederate operation against Harpers Ferry.","source":"U.S. Army Center of Military History, National Park Service, Ezra A. Carman maps, and episode transcript; see sources below."},{"image":"/images/ep183-confederate-column-frederick.jpg","alt":"Civil War-era photograph traditionally identified as Confederate soldiers moving along a street in Frederick, Maryland.","caption":"This photograph is traditionally dated to the 1862 Maryland Campaign and is the historical image selected for the official episode page. Its catalog metadata also records a competing identification as a Confederate column in Frederick in July 1864, so the exact campaign shown is not certain.","source":"Heritage Frederick / Historical Society of Frederick County, reproduced on the official episode page and Wikimedia Commons; see sources below."},{"image":"/images/ep183-george-mcclellan.jpg","alt":"Civil War-era full-length portrait of United States major general George B. McClellan in uniform.","caption":"George B. McClellan entered September 13 uncertain about Lee’s direction and numbers. The lost order resolved the first question but did not overcome his exaggerated estimate of Confederate strength.","source":"Library of Congress Prints and Photographs Division; see sources below."},{"image":"/images/ep183-mcclellan-telegram.jpg","alt":"First page of George B. McClellan’s September 13, 1862 telegram to Abraham Lincoln reporting confidence after receiving Lee’s plans.","caption":"In this midnight telegram, McClellan told Lincoln that he possessed the Confederate plans, expected Lee to be severely punished, and was moving the army as rapidly as possible.","source":"Library of Congress Manuscript Division, Abraham Lincoln Papers; see sources below."},{"image":"/images/ep183-south-mountain-battle.jpg","alt":"Postwar engraving depicting the Battle of South Mountain with infantry and artillery fighting on wooded slopes.","caption":"This 1883 engraving published in the “Pictorial War Record” offers a later popular depiction of the September 14 fighting. It is an interpretive print, not a contemporary battlefield record.","source":"Library of Congress Popular Graphic Arts Collection; see sources below."}],"sources":[{"label":"Official Civil War Podcast episode 183 page","url":"https://civilwarpodcast.org/2017/02/19/civil-war-podcast-episode-183/"},{"label":"National Park Service: McClellan Gets a Hold of the Orders","url":"https://www.nps.gov/articles/mcclellan-gets-a-hold-of-the-orders.htm"},{"label":"National Park Service: Special Orders No. 191","url":"https://www.nps.gov/mono/learn/historyculture/so191.htm"},{"label":"National Park Service: An Invitation to Battle — Special Orders 191","url":"https://www.nps.gov/mono/learn/historyculture/an-invitation-to-battle.htm"},{"label":"National Park Service: Confederate Plans and the Lost Order","url":"https://www.nps.gov/articles/confederate-plans.htm"},{"label":"National Park Service: Antietam campaign timeline","url":"https://www.nps.gov/anti/learn/historyculture/timeline.htm"},{"label":"National Park Service: Harpers Ferry to South Mountain","url":"https://www.nps.gov/articles/harpers-ferry-to-south-mountain.htm"},{"label":"National Park Service: South Mountain battle detail","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=MD002"},{"label":"U.S. Army Center of Military History: Antietam staff ride guide and maps","url":"https://history.army.mil/portals/143/Images/Publications/catalog/35-3-1.pdf"},{"label":"U.S. Army Center of Military History: The Maryland and Fredericksburg Campaigns, 1862–1863","url":"https://history.army.mil/Portals/143/Images/Publications/Publication%20By%20Title%20Images/M%20Pdf/cmhPub_75-6.pdf"},{"label":"Official Records, Series I, Volume XIX, Part I: Maryland Campaign reports","url":"https://ehistory.osu.edu/books/official-records/027"},{"label":"Official Records, Series I, Volume XIX, Part II: Maryland Campaign correspondence","url":"https://ehistory.osu.edu/books/official-records/028"},{"label":"Primary source: McClellan to Abraham Lincoln, September 13, 1862","url":"https://www.loc.gov/resource/mal.1840800/"},{"label":"Library of Congress: George Brinton McClellan Papers collection and Special Orders No. 191","url":"https://www.loc.gov/collections/george-brinton-mcclellan-papers/about-this-collection/"},{"label":"Library of Congress exhibition: Special Orders No. 191 transcription and image","url":"https://www.loc.gov/exhibits/lincoln/ext/transcribe-143.html"},{"label":"Primary map series: Ezra A. Carman’s Theatre of Operations, Maryland Campaign","url":"https://www.loc.gov/item/2009584566/"},{"label":"Library of Congress: George B. McClellan portrait","url":"https://www.loc.gov/item/2016649613/"},{"label":"Library of Congress: Battle of South Mountain lithograph","url":"https://www.loc.gov/item/2018757134/"},{"label":"Wikimedia Commons catalog record: Confederate column in Frederick photograph","url":"https://commons.wikimedia.org/wiki/File:Confederates_marching_through_Frederick,_MD_in_1862.jpg"},{"label":"Official podcast book-recommendations list","url":"https://civilwarpodcast.org/book-recommendations/"}]}}]}],false,false,"$L10","$L11","$L12","$L13","$L14","$L15"]}]]}]
