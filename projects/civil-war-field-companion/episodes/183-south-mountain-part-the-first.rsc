1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",183," · ","September 9–14, 1862"," · ","Frederick and the roads west across the Catoctin range and South Mountain to Boonsboro, Hagerstown, Sharpsburg, and Harpers Ferry in western Maryland"]}],["$","h1",null,{"children":"SOUTH MOUNTAIN (Part the First)"}],["$","span",null,{"className":"result-label","children":"United States operational opportunity and eventual battlefield victory. The lost copy of Special Orders No. 191 revealed that Robert E. Lee’s army was divided, but George B. McClellan spent the afternoon and night of September 13 checking the dated order and preparing his advance. Fighting at the South Mountain gaps on September 14 drove the Confederate defenders back, while their delay helped Lee reunite much of his army near Sharpsburg"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2006083864.mp3?updated=1695462435","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The lost order’s discovery, McClellan’s intelligence problem, and the opportunity before the Battle of South Mountain"}],["$","small",null,{"children":"The episode summarizes the September 14 result but reserves the detailed fighting at Turner’s, Fox’s, and Crampton’s Gaps for later installments."}]]}],["$","div","Order issued",{"children":[["$","span",null,{"children":"Order issued"}],["$","strong",null,{"children":"Special Orders No. 191, Frederick, September 9, 1862"}],["$","small",null,{"children":"Lee’s order assigned the movements intended to capture Martinsburg and Harpers Ferry while the main body and its trains moved west of South Mountain."}]]}],["$","div","Army divided",{"children":[["$","span",null,{"children":"Army divided"}],["$","strong",null,{"children":"Twenty-six of forty Confederate brigades sent toward the lower Shenandoah Valley"}],["$","small",null,{"children":"This is the count used in the episode. Those columns would be outside practical supporting distance from the forces around Boonsboro and Hagerstown until the Harpers Ferry operation ended."}]]}],["$","div","Lee’s assumption",{"children":[["$","span",null,{"children":"Lee’s assumption"}],["$","strong",null,{"children":"Speed and McClellan’s caution would protect the separated columns"}],["$","small",null,{"children":"Lee expected Stuart’s cavalry and the South Mountain barrier to conceal the operation long enough for the army to reunite."}]]}],["$","div","Copies prepared",{"children":[["$","span",null,{"children":"Copies prepared"}],["$","strong",null,{"children":"Lt. Col. Robert H. Chilton distributed Lee’s written order"}],["$","small",null,{"children":"As assistant adjutant general, Chilton prepared copies at army headquarters for the commanders named in the plan."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}],"$L26","$undefined","$L27",false,"$L28","$L29","$L2a","$L2b","$L2c"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Hill’s second copy",{"children":[["$","span",null,{"children":"Hill’s second copy"}],["$","strong",null,{"children":"Jackson separately copied the order for D. H. Hill"}],["$","small",null,{"children":"Hill received Jackson’s handwritten copy. The copy from army headquarters addressed to Hill became the lost order."}]]}]
f:["$","div","Order found",{"children":[["$","span",null,{"children":"Order found"}],["$","strong",null,{"children":"Morning of September 13 near Frederick"}],["$","small",null,{"children":"Members of Company F, 27th Indiana Infantry found the document in ground recently occupied by Confederate troops on the Best Farm, now part of Monocacy National Battlefield."}]]}]
10:["$","div","Finders",{"children":[["$","span",null,{"children":"Finders"}],["$","strong",null,{"children":"Cpl. Barton W. Mitchell and Sgt. John M. Bloss"}],["$","small",null,{"children":"The episode names both soldiers. National Park Service research emphasizes Bloss’s September 26 letter as the closest surviving participant account."}]]}]
11:["$","div","The cigars",{"children":[["$","span",null,{"children":"The cigars"}],["$","strong",null,{"children":"The document was wrapped around cigars"}],["$","small",null,{"children":"The transcript says three cigars; National Park Service pages commonly say two. The number does not affect the identification or military significance of the order."}]]}]
12:["$","div","Authentication",{"children":[["$","span",null,{"children":"Authentication"}],["$","strong",null,{"children":"Lt. Col. Samuel E. Pittman recognized Chilton’s handwriting"}],["$","small",null,{"children":"Pittman, an aide to Brig. Gen. Alpheus S. Williams, knew Chilton before the war and vouched for the document as it moved up the Federal chain of command."}]]}]
13:["$","div","Delivery to McClellan",{"children":[["$","span",null,{"children":"Delivery to McClellan"}],["$","strong",null,{"children":"Around midday to early afternoon on September 13"}],["$","small",null,{"children":"The episode places the paper in McClellan’s hands roughly three hours after its discovery. Surviving accounts do not establish every step to the minute, and official summaries differ on whether to call the delivery noon or early evening."}]]}]
14:["$","div","Initial reaction",{"children":[["$","span",null,{"children":"Initial reaction"}],["$","strong",null,{"children":"“Now I know what to do”"}],["$","small",null,{"children":"The episode describes McClellan breaking off a meeting with Frederick civilians, studying the order, and immediately recognizing its value."}]]}]
15:["$","div","Message to Lincoln",{"children":[["$","span",null,{"children":"Message to Lincoln"}],["$","strong",null,{"children":"McClellan reported that he had Lee’s plans and expected success"}],["$","small",null,{"children":"The surviving telegram is dated midnight on September 13. McClellan wrote that no time would be lost, that Lee had made a gross mistake, and that the Federal army was moving as rapidly as possible."}]]}]
16:["$","div","Federal field strength",{"children":[["$","span",null,{"children":"Federal field strength"}],["$","strong",null,{"children":"About 85,000 under arms in the episode’s account"}],["$","small",null,{"children":"The Army of the Potomac advanced in three wings. The hosts also cite roughly 70,000 additional troops in the Washington defenses, not all immediately available for the field campaign."}]]}]
17:["$","div","McClellan’s estimate",{"children":[["$","span",null,{"children":"McClellan’s estimate"}],["$","strong",null,{"children":"At least 120,000 Confederates"}],["$","small",null,{"children":"McClellan repeated this estimate to general in chief Henry W. Halleck on September 11, leaving him unable to accept his actual numerical advantage."}]]}]
18:["$","div","Pinkerton’s estimate",{"children":[["$","span",null,{"children":"Pinkerton’s estimate"}],["$","strong",null,{"children":"Two hundred thousand Confederates in Virginia in an August 10 analysis"}],["$","small",null,{"children":"Allan Pinkerton’s intelligence reports and McClellan’s method of interpreting them contributed to persistent overestimates of Confederate strength."}]]}]
19:["$","div","Cavalry intelligence",{"children":[["$","span",null,{"children":"Cavalry intelligence"}],["$","strong",null,{"children":"Pleasonton reported 100,000 Confederates on September 8"}],["$","small",null,{"children":"Stuart’s cavalry screen limited Federal observation. The transcript also cites Pleasonton’s September 7 report of 30,000 at Frederick and another 60,000 under Jackson moving northeast, a movement that did not occur."}]]}]
1a:["$","div","Geographic barrier",{"children":[["$","span",null,{"children":"Geographic barrier"}],["$","strong",null,{"children":"South Mountain controlled the roads west from Frederick"}],["$","small",null,{"children":"An army moving west crossed the Catoctin hills and then needed the South Mountain gaps to reach Boonsboro and the Cumberland Valley. Hagerstown lay north, while Sharpsburg and Harpers Ferry lay south."}]]}]
1b:["$","div","Principal passes",{"children":[["$","span",null,{"children":"Principal passes"}],["$","strong",null,{"children":"Turner’s, Fox’s, and Crampton’s Gaps"}],["$","small",null,{"children":"The National Road used Turner’s Gap. Fox’s Gap lay about a mile south, and Crampton’s Gap lay roughly five miles farther south on the route from Burkittsville into Pleasant Valley."}]]}]
1c:["$","div","Federal position at noon",{"children":[["$","span",null,{"children":"Federal position at noon"}],["$","strong",null,{"children":"Thirteen divisions near Frederick and four divisions farther south"}],["$","small",null,{"children":"The episode places the northern concentration about twelve miles from Turner’s Gap and the southern group about twelve miles from Crampton’s Gap on September 13."}]]}]
1d:["$","div","Immediate opportunity",{"children":[["$","span",null,{"children":"Immediate opportunity"}],["$","strong",null,{"children":"Cross South Mountain and attack Lee’s separated commands"}],["$","small",null,{"children":"McClellan could direct his right and center through Turner’s and Fox’s Gaps while Franklin’s left wing moved through Crampton’s Gap toward the Harpers Ferry operation."}]]}]
1e:["$","div","Castiglione comparison",{"children":[["$","span",null,{"children":"Castiglione comparison"}],["$","strong",null,{"children":"McClellan compared the opening to Napoleon’s 1796 victory"}],["$","small",null,{"children":"At Castiglione, Napoleon concentrated against separated Austrian forces. McClellan expected the lost order to offer a comparable chance to defeat Lee’s army in detail."}]]}]
1f:["$","div","Verification order",{"children":[["$","span",null,{"children":"Verification order"}],["$","strong",null,{"children":"Pleasonton was told at 3 p.m. to test the order against current movements"}],["$","small",null,{"children":"The document was four days old, Longstreet was at Hagerstown rather than Boonsboro, and Harpers Ferry had not fallen on Lee’s timetable. Those discrepancies were real reasons to determine how much of the plan remained current."}]]}]
20:["$","div","Response interval",{"children":[["$","span",null,{"children":"Response interval"}],["$","strong",null,{"children":"The episode describes an eighteen-hour delay before a new advance"}],["$","small",null,{"children":"This follows Stephen W. Sears’s interpretation that only previously scheduled short movements occurred on September 13. Historians continue to debate how quickly McClellan acted and how much faster the army could have moved."}]]}]
21:["$","div","Confederate screen",{"children":[["$","span",null,{"children":"Confederate screen"}],["$","strong",null,{"children":"D. H. Hill and Stuart guarded the South Mountain approaches"}],["$","small",null,{"children":"Longstreet was at Hagerstown and returned toward the mountain after Lee received warning of the faster Federal advance."}]]}]
22:["$","div","Battle outcome",{"children":[["$","span",null,{"children":"Battle outcome"}],["$","strong",null,{"children":"Federal forces drove the Confederates from all three gaps on September 14"}],["$","small",null,{"children":"The victory opened the routes west, but the Confederate defense consumed enough time for the Harpers Ferry operation to continue and for Lee to concentrate near Sharpsburg."}]]}]
23:["$","div","Senior battlefield deaths",{"children":[["$","span",null,{"children":"Senior battlefield deaths"}],["$","strong",null,{"children":"Jesse L. Reno and Samuel Garland Jr. were killed"}],["$","small",null,{"children":"Both fell at Fox’s Gap on September 14. Their deaths belong to the battle summarized at the end of this episode, although the detailed combat narrative begins in the next installment."}]]}]
24:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“The Battle of South Mountain” by John David Hoptak"}],["$","small",null,{"children":"The official episode page and podcast book list identify Hoptak’s campaign study as the recommendation."}]]}]
25:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Castiglione, Chilton, Samuel E. Pittman, Alpheus S. Williams, Edwin V. Sumner, and Alfred Pleasonton"}],["$","small",null,{"children":"The automated transcript produces forms including “Castellone,” “Pittman,” “Commoner,” and “Pleasanton.” The guide uses standard spellings and full names."}]]}]
26:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
27:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The operational opening on September 13",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep183-operational-situation.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The operational opening on September 13 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep183-operational-situation.svg","alt":"Schematic map of western Maryland on September 13, 1862, showing McClellan near Frederick, Lee and Longstreet near Hagerstown, D. H. Hill near Boonsboro, Confederate columns around Harpers Ferry, and Federal routes through the South Mountain gaps.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The operational opening on September 13"}],["$","span",null,{"children":"The lost order showed McClellan that Lee’s army was spread from Hagerstown and Boonsboro to the heights around Harpers Ferry. The Army of the Potomac was concentrated near Frederick and farther south, east of the South Mountain passes. Arrows show the main Federal opportunities opened by the intelligence, not movements completed at the moment the document arrived. Routes and positions are generalized; this map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep183-operational-situation.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History, National Park Service, Special Orders No. 191, Ezra A. Carman campaign maps, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The roads through South Mountain",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep183-south-mountain-gaps.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The roads through South Mountain at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep183-south-mountain-gaps.svg","alt":"Schematic map of Turner’s, Fox’s, and Crampton’s Gaps through South Mountain, with Federal approaches from Middletown and Burkittsville and Confederate covering positions west of the ridge.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The roads through South Mountain"}],["$","span",null,{"children":"Turner’s Gap carried the National Road toward Boonsboro, Fox’s Gap provided a nearby southern crossing, and Crampton’s Gap connected Burkittsville with Pleasant Valley and the Harpers Ferry approaches. McClellan’s right wing moved toward Turner’s and Fox’s Gaps while Franklin’s left wing approached Crampton’s Gap. Terrain and unit footprints are generalized; this map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep183-south-mountain-gaps.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],"$L2d"]}],"$undefined"]}]]}]]}]]}]
28:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Received Special Orders No. 191, ordered its information checked, and directed the advance toward South Mountain and Harpers Ferry"}]]}],["$","div","Right Wing-Maj. Gen. Ambrose E. Burnside",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing"}],["$","span",null,{"children":"Maj. Gen. Ambrose E. Burnside"}],["$","small",null,{"children":"I Corps under Joseph Hooker and IX Corps under Jesse L. Reno; assigned the northern advance toward Turner’s and Fox’s Gaps"}]]}],["$","div","Center Wing-Maj. Gen. Edwin V. Sumner",{"className":"command-entry","children":[["$","strong",null,{"children":"Center Wing"}],["$","span",null,{"children":"Maj. Gen. Edwin V. Sumner"}],["$","small",null,{"children":"II Corps and XII Corps in the main concentration near Frederick; Alpheus Williams temporarily led XII Corps when the lost order was found"}]]}],["$","div","Left Wing-Maj. Gen. William B. Franklin",{"className":"command-entry","children":[["$","strong",null,{"children":"Left Wing"}],["$","span",null,{"children":"Maj. Gen. William B. Franklin"}],["$","small",null,{"children":"VI Corps and Darius N. Couch’s division; advanced from the south toward Crampton’s Gap and the route to Harpers Ferry"}]]}],["$","div","Cavalry Division-Brig. Gen. Alfred Pleasonton",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry Division"}],["$","span",null,{"children":"Brig. Gen. Alfred Pleasonton"}],["$","small",null,{"children":"Screened the army, reported Confederate movements, and received McClellan’s 3 p.m. instruction to test the lost order against current positions"}]]}],["$","div","XII Corps, acting commander-Brig. Gen. Alpheus S. Williams",{"className":"command-entry","children":[["$","strong",null,{"children":"XII Corps, acting commander"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Received the document from the 27th Indiana and sent it to McClellan after his aide Samuel E. Pittman authenticated Chilton’s handwriting"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Directed the separated operation and remained with the main body between Boonsboro and Hagerstown before ordering concentration toward South Mountain and Sharpsburg"}]]}],["$","div","Main body near Hagerstown-Maj. Gen. James Longstreet",{"className":"command-entry","children":["$L2e","$L2f","$L30"]}],"$L31","$L32","$L33","$L34","$L35"]]}]]}],"$L36"]]]}]
29:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Jesse L. Reno",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Jesse L. Reno"}],["$","p",null,{"children":[["$","strong",null,{"children":["Major general commanding IX Corps","."]}]," ","Killed near Fox’s Gap late on September 14 while examining the Federal line"]}]]}],["$","article","Samuel Garland Jr.",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Samuel Garland Jr."}],["$","p",null,{"children":[["$","strong",null,{"children":["Brigadier general commanding a brigade in D. H. Hill’s division","."]}]," ","Killed at Fox’s Gap on September 14 while attempting to steady the Confederate defense"]}]]}]]}]]}]
2a:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep183-operational-situation.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep183-operational-situation.svg","alt":"Schematic operational map of the divided Confederate army and the Federal routes west from Frederick on September 13, 1862.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The lost order located Lee’s main body beyond South Mountain and the Harpers Ferry columns farther south. It gave McClellan a clear chance to advance through the gaps between them."}]]}],["$","figure","/images/ep183-south-mountain-gaps.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep183-south-mountain-gaps.svg","alt":"Schematic map of the roads through Turner’s, Fox’s, and Crampton’s Gaps.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Turner’s and Fox’s Gaps covered the main route toward Boonsboro. Crampton’s Gap opened a route into Pleasant Valley and toward the Confederate operation against Harpers Ferry."}]]}],["$","figure","/images/ep183-confederate-column-frederick.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep183-confederate-column-frederick.jpg","alt":"Civil War-era photograph traditionally identified as Confederate soldiers moving along a street in Frederick, Maryland.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This photograph is traditionally dated to the 1862 Maryland Campaign and is the historical image selected for the official episode page. Its catalog metadata also records a competing identification as a Confederate column in Frederick in July 1864, so the exact campaign shown is not certain."}]]}],["$","figure","/images/ep183-george-mcclellan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep183-george-mcclellan.jpg","alt":"Civil War-era full-length portrait of United States major general George B. McClellan in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"George B. McClellan entered September 13 uncertain about Lee’s direction and numbers. The lost order resolved the first question but did not overcome his exaggerated estimate of Confederate strength."}]]}],["$","figure","/images/ep183-mcclellan-telegram.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep183-mcclellan-telegram.jpg","alt":"First page of George B. McClellan’s September 13, 1862 telegram to Abraham Lincoln reporting confidence after receiving Lee’s plans.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"In this midnight telegram, McClellan told Lincoln that he possessed the Confederate plans, expected Lee to be severely punished, and was moving the army as rapidly as possible."}]]}],["$","figure","/images/ep183-south-mountain-battle.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep183-south-mountain-battle.jpg","alt":"Postwar engraving depicting the Battle of South Mountain with infantry and artillery fighting on wooded slopes.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This 1883 engraving published in the “Pictorial War Record” offers a later popular depiction of the September 14 fighting. It is an interpretive print, not a contemporary battlefield record."}]]}]]}]]}]
