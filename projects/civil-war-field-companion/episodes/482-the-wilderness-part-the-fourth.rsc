27:["$","div","The Texas Brigade went forward at Tapp Field",{"className":"moment","children":[["$","$L1a",null,{"seconds":1398,"label":"23:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Texas Brigade went forward at Tapp Field"}],["$","p",null,{"children":"Lee tried to accompany John Gregg’s brigade. The soldiers stopped him and about 800 Texans advanced without him; fewer than 250 remained standing by day’s end."}]]}]]}]
28:["$","div","Longstreet stopped Hancock’s advance",{"className":"moment","children":[["$","$L1a",null,{"seconds":1480,"label":"24:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet stopped Hancock’s advance"}],["$","p",null,{"children":"Fresh Confederate divisions attacked in separate waves and pushed the disordered U.S. troops about halfway back to their morning position."}]]}]]}]
29:["$","div","Hancock requested reinforcements",{"className":"moment","children":[["$","$L1a",null,{"seconds":1516,"label":"25:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock requested reinforcements"}],["$","p",null,{"children":"At 7:10 a.m., he reported heavy pressure, refilled cartridge boxes, and rebuilt his line."}]]}]]}]
2a:["$","div","False reports worried Hancock’s left",{"className":"moment","children":[["$","$L1a",null,{"seconds":1570,"label":"26:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"False reports worried Hancock’s left"}],["$","p",null,{"children":"Reports of Confederates near Todd’s Tavern caused Hancock to hold back much of two divisions even though Pickett was near Richmond and Anderson was still approaching."}]]}]]}]
