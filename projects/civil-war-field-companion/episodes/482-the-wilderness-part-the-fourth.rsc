1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",482," · ","May 5–6, 1864"," · ","Brock Road–Orange Plank Road intersection, Tapp Field, and the Wilderness of Spotsylvania, Virginia"]}],["$","h1",null,{"children":"THE WILDERNESS (Part the Fourth)"}],["$","span",null,{"className":"result-label","children":"A.P. Hill’s corps stopped Hancock’s attacks late on May 5 but did not reorganize or build strong works overnight. Hancock attacked at 5 a.m. on May 6 and drove Hill’s divisions west to Tapp Field. Longstreet’s arriving corps counterattacked and pushed the U.S. troops partway back. Burnside did not reach Hill’s flank in time. By 10 a.m., Confederate engineers had found the unfinished railroad that provided a route to Hancock’s exposed left"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9261576657.mp3?updated=1737917942","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Heth’s line late May 5",{"children":[["$","span",null,{"children":"Heth’s line late May 5"}],["$","strong",null,{"children":"About 6,500 men"}],"$undefined"]}],["$","div","Hancock engaged late May 5",{"children":[["$","span",null,{"children":"Hancock engaged late May 5"}],["$","strong",null,{"children":"About 17,000 men"}],"$undefined"]}],["$","div","Hancock’s May 6 attack",{"children":[["$","span",null,{"children":"Hancock’s May 6 attack"}],["$","strong",null,{"children":"5 divisions at 5 a.m."}],"$undefined"]}],["$","div","Hill brigades that briefly held",{"children":[["$","span",null,{"children":"Hill brigades that briefly held"}],["$","strong",null,{"children":"2 of 8"}],"$undefined"]}],["$","div","Confederate guns at Tapp Field",{"children":[["$","span",null,{"children":"Confederate guns at Tapp Field"}],["$","strong",null,{"children":"16"}],"$undefined"]}],["$","div","Texas Brigade entering action",{"children":[["$","span",null,{"children":"Texas Brigade entering action"}],["$","strong",null,{"children":"About 800 men"}],"$undefined"]}],["$","div","Texans still standing by day’s end",{"children":[["$","span",null,{"children":"Texans still standing by day’s end"}],["$","strong",null,{"children":"Fewer than 250"}],"$undefined"]}],["$","div","IX Corps recent march",{"children":[["$","span",null,{"children":"IX Corps recent march"}],["$","strong",null,{"children":"40 miles in 36 hours with about 4 hours’ rest"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",