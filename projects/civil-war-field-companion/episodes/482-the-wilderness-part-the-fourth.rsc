1b:["$","div","Hancock stopped attacking for the night",{"className":"moment","children":[["$","$L1a",null,{"seconds":686,"label":"11:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock stopped attacking for the night"}],["$","p",null,{"children":"II Corps began building fieldworks along Brock Road. Hill’s exhausted troops rested instead of fully reorganizing and entrenching."}]]}]]}]
1c:["$","div","Lee expected Longstreet by midnight",{"className":"moment","children":[["$","$L1a",null,{"seconds":780,"label":"13:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee expected Longstreet by midnight"}],["$","p",null,{"children":"Lee planned a major counterattack after Longstreet’s fresh corps arrived, while Grant and Meade prepared to attack Hill at dawn."}]]}]]}]
1d:["$","div","Grant and Meade planned the May 6 attack",{"className":"moment","children":[["$","$L1a",null,{"seconds":868,"label":"14:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant and Meade planned the May 6 attack"}],["$","p",null,{"children":"Hancock, Getty, and Wadsworth would attack west on Orange Plank Road while Burnside moved into the gap against Hill’s flank and rear."}]]}]]}]
1e:["$","div","Burnside’s independent status complicated control",{"className":"moment","children":[["$","$L1a",null,{"seconds":939,"label":"15:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Burnside’s independent status complicated control"}],["$","p",null,{"children":"Because IX Corps reported directly to Grant rather than Meade, Meade doubted it could reach its position on time. Grant delayed the start only to 5 a.m."}]]}]]}]
1f:["$","div","Ewell attacked at 4:45 a.m.",{"className":"moment","children":[["$","$L1a",null,{"seconds":977,"label":"16:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ewell attacked at 4:45 a.m."}],["$","p",null,{"children":"The Confederate attack made little progress but disrupted the planned U.S. advance on the Orange Turnpike."}]]}]]}]
20:["$","div","The U.S. Turnpike attack did not develop",{"className":"moment","children":[["$","$L1a",null,{"seconds":1011,"label":"16:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. Turnpike attack did not develop"}],["$","p",null,{"children":"Sedgwick made a limited two-brigade attack, and Warren refused to leave his works until the whole VI Corps advanced."}]]}]]}]
21:["$","div","Hancock attacked at 5 a.m.",{"className":"moment","children":[["$","$L1a",null,{"seconds":1064,"label":"17:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock attacked at 5 a.m."}],["$","p",null,{"children":"Five divisions advanced west against Heth and Wilcox, whose tired and disorganized brigades could not hold."}]]}]]}]
22:["$","div","Six of eight Confederate brigades withdrew",{"className":"moment","children":[["$","$L1a",null,{"seconds":1135,"label":"18:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Six of eight Confederate brigades withdrew"}],["$","p",null,{"children":"Hill’s line collapsed within minutes, sending soldiers back through Tapp Field and past Lee’s headquarters."}]]}]]}]
23:["$","div","Sixteen guns defended Tapp Field",{"className":"moment","children":[["$","$L1a",null,{"seconds":1154,"label":"19:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sixteen guns defended Tapp Field"}],["$","p",null,{"children":"Confederate artillery fired canister after the retreating infantry cleared its front, but the guns lacked infantry support."}]]}]]}]
24:["$","div","Burnside was not ready to attack",{"className":"moment","children":[["$","$L1a",null,{"seconds":1240,"label":"20:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Burnside was not ready to attack"}],["$","p",null,{"children":"Hancock learned that IX Corps had not reached Hill’s flank and concluded that timely support could have destroyed Hill’s position."}]]}]]}]
25:["$","div","IX Corps halted after a forced march",{"className":"moment","children":[["$","$L1a",null,{"seconds":1272,"label":"21:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"IX Corps halted after a forced march"}],["$","p",null,{"children":"Burnside’s men had marched 40 miles in 36 hours with about four hours of rest and stopped near Germanna Ford while the battle continued."}]]}]]}]
