14:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Getty and Hancock attacked near Brock Road",{"className":"moment","children":[["$","$L1a",null,{"seconds":82,"label":"1:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Getty and Hancock attacked near Brock Road"}],["$","p",null,{"children":"Getty’s VI Corps division opened the fighting at the intersection while Hancock brought II Corps divisions into position behind it."}]]}]]}],["$","div","Mott’s division collapsed",{"className":"moment","children":[["$","$L1a",null,{"seconds":110,"label":"1:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Mott’s division collapsed"}],["$","p",null,{"children":"Two Confederate volleys stopped Gershom Mott’s under-strength division. Expiring enlistments and heavy casualties contributed to the breakdown."}]]}]]}],["$","div","Birney’s brigades entered separately",{"className":"moment","children":[["$","$L1a",null,{"seconds":174,"label":"2:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Birney’s brigades entered separately"}],["$","p",null,{"children":"David Birney’s division supported Getty one brigade at a time and suffered heavy losses, including brigade commander Alexander Hays."}]]}]]}],["$","div","Heth faced a much larger force",{"className":"moment","children":[["$","$L1a",null,{"seconds":249,"label":"4:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Heth faced a much larger force"}],["$","p",null,{"children":"Heth had about 6,500 men in line. Hancock already had roughly 17,000 engaged and two additional divisions approaching."}]]}]]}],["$","div","Lee recalled Wilcox",{"className":"moment","children":[["$","$L1a",null,{"seconds":278,"label":"4:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee recalled Wilcox"}],["$","p",null,{"children":"At 5 p.m., Lee ordered Cadmus Wilcox’s division back from its connection with Ewell to reinforce Heth along Orange Plank Road."}]]}]]}],["$","div","Wilcox counterattacked brigade by brigade",{"className":"moment","children":[["$","$L1a",null,{"seconds":360,"label":"6:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wilcox counterattacked brigade by brigade"}],["$","p",null,{"children":"His arriving formations moved toward the heaviest firing without clear visibility or coordination in the woods."}]]}]]}],["$","div","McGowan’s brigade charged",{"className":"moment","children":[["$","$L1a",null,{"seconds":386,"label":"6:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"McGowan’s brigade charged"}],["$","p",null,{"children":"Five South Carolina regiments took heavy U.S. fire, suffered fire from Heth’s troops behind them, briefly captured a gun, and withdrew."}]]}]]}],["$","div","The counterattacks slowed Hancock",{"className":"moment","children":[["$","$L1a",null,{"seconds":456,"label":"7:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The counterattacks slowed Hancock"}],["$","p",null,{"children":"Although they failed tactically, the repeated Confederate attacks made U.S. commanders focus on holding Brock and Orange Plank roads."}]]}]]}],["$","div","Grant misidentified Wilcox’s movement",{"className":"moment","children":[["$","$L1a",null,{"seconds":520,"label":"8:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant misidentified Wilcox’s movement"}],["$","p",null,{"children":"Signalmen saw a Confederate column moving south. Grant believed it came from Ewell and ordered pressure against Ewell’s supposedly weakened line."}]]}]]}],["$","div","Wadsworth moved against Hill’s left",{"className":"moment","children":[["$","$L1a",null,{"seconds":562,"label":"9:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wadsworth moved against Hill’s left"}],["$","p",null,{"children":"Grant sent James Wadsworth’s division through a mile of thickets and swampy ground toward the Confederate flank."}]]}]]}],["$","div","Wadsworth reached the sector at 7 p.m.",{"className":"moment","children":[["$","$L1a",null,{"seconds":631,"label":"10:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wadsworth reached the sector at 7 p.m."}],["$","p",null,{"children":"His leading troops threatened Hill’s left, but a charge by a 150-man Alabama battalion guarding prisoners caused them to withdraw."}]]}]]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e"]}]]}]
