19:["$","div",null,{"children":[["$","h3",null,{"children":"Battlefield results determined political support"}],["$","p",null,{"children":"Military failure and rising casualties could reduce support for Lincoln, while successful campaigns could strengthen it before the November election."}]]}]
1a:["$","div","Lincoln needed an effective senior commander",{"className":"moment","children":[["$","$L17",null,{"seconds":1296,"label":"21:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln needed an effective senior commander"}],["$","p",null,{"children":"He sought a general who would use U.S. manpower and industry, coordinate military operations with national policy, and produce results before public support collapsed."}]]}]]}]
1b:["$","div","Grant became the leading candidate",{"className":"moment","children":[["$","$L17",null,{"seconds":1312,"label":"21:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant became the leading candidate"}],["$","p",null,{"children":"His record at Fort Donelson, Vicksburg, and Chattanooga convinced Lincoln that he might direct the armies effectively."}]]}]]}]
1c:["$","div","A winter advance was impractical",{"className":"moment","children":[["$","$L17",null,{"seconds":1382,"label":"23:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"A winter advance was impractical"}],["$","p",null,{"children":"Bad roads, exhausted troops, inadequate rations, and an incomplete transportation system prevented an immediate move into Georgia."}]]}]]}]
1d:["$","div","Supply was the central problem",{"className":"moment","children":[["$","$L17",null,{"seconds":1417,"label":"23:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Supply was the central problem"}],["$","p",null,{"children":"Warehouses at Louisville, Nashville, and Memphis held supplies, but the armies at Chattanooga and Knoxville remained on reduced rations because the railroad could not move enough freight."}]]}]]}]
1e:["$","div","Daniel McCallum rebuilt railroad capacity",{"className":"moment","children":[["$","$L17",null,{"seconds":1473,"label":"24:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Daniel McCallum rebuilt railroad capacity"}],["$","p",null,{"children":"Grant sent the military railroad director to reopen and improve the route to Chattanooga. The first train carrying crackers arrived there in mid-January."}]]}]]}]
1f:["$","div","The rail system lacked equipment",{"className":"moment","children":[["$","$L17",null,{"seconds":1523,"label":"25:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"The rail system lacked equipment"}],["$","p",null,{"children":"Only 39 locomotives and about 400 cars served 292 miles in Tennessee, compared with 40 locomotives and 800 cars serving about 70 miles for the Army of the Potomac."}]]}]]}]
20:["$","div","Grant centralized railroad control",{"className":"moment","children":[["$","$L17",null,{"seconds":1561,"label":"26:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant centralized railroad control"}],["$","p",null,{"children":"McCallum received authority over the railroads in the Military Division of the Mississippi and set a goal of 200 locomotives and 3,000 cars."}]]}]]}]
21:["$","div","Longstreet remained near Knoxville",{"className":"moment","children":[["$","$L17",null,{"seconds":1590,"label":"26:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Longstreet remained near Knoxville"}],["$","p",null,{"children":"About 20,000 Confederate troops still occupied eastern Tennessee. Grant had to determine whether they could threaten Chattanooga or reinforce Johnston."}]]}]]}]
22:["$","div","Foster’s advance ended without a battle",{"className":"moment","children":[["$","$L17",null,{"seconds":1659,"label":"27:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"Foster’s advance ended without a battle"}],["$","p",null,{"children":"Grant ordered John G. Foster to drive Longstreet away. Foster moved with about 20,000 men but turned back after finding the Confederate position too strong."}]]}]]}]
23:["$","div","Schofield replaced Foster",{"className":"moment","children":[["$","$L17",null,{"seconds":1684,"label":"28:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schofield replaced Foster"}],["$","p",null,{"children":"Grant placed John M. Schofield in command of the Army of the Ohio and expected him to secure eastern Tennessee before joining the Atlanta operation."}]]}]]}]
24:["$","div","Sherman prepared a strike into Mississippi",{"className":"moment","children":[["$","$L17",null,{"seconds":1745,"label":"29:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman prepared a strike into Mississippi"}],["$","p",null,{"children":"Grant authorized Sherman to move from Vicksburg to Meridian and destroy railroads, supplies, and other military infrastructure before the main spring campaign."}]]}]]}]
25:["$","div","The Meridian expedition began",{"className":"moment","children":[["$","$L17",null,{"seconds":1804,"label":"30:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Meridian expedition began"}],["$","p",null,{"children":"After warning Mississippi residents on January 31, Sherman marched east from Vicksburg on February 3."}]]}]]}]
