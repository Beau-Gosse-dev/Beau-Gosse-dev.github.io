11:["$","figure","Sherman’s Meridian expedition",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-91.10%2C31.70%2C-88.45%2C33.10&layer=mapnik&marker=32.3643%2C-88.7037","title":"Sherman’s Meridian expedition","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Sherman’s Meridian expedition"}],["$","span",null,{"children":"Before turning toward Atlanta, Sherman moved east from Vicksburg to Meridian to destroy railroads and reduce the threat to the Mississippi River and his western flank."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The podcast begins the Atlanta campaign",{"className":"moment","children":[["$","$L17",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The podcast begins the Atlanta campaign"}],["$","p",null,{"children":"The campaign is introduced as a military operation whose outcome also affected Northern support for the war and Lincoln’s reelection."}]]}]]}],["$","div","Grant planned simultaneous offensives",{"className":"moment","children":[["$","$L17",null,{"seconds":148,"label":"2:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant planned simultaneous offensives"}],["$","p",null,{"children":"Grant intended to pressure the principal Confederate armies at the same time so they could not send reinforcements from one theater to another."}]]}]]}],["$","div","Sherman received the Atlanta assignment",{"className":"moment","children":[["$","$L17",null,{"seconds":182,"label":"3:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman received the Atlanta assignment"}],["$","p",null,{"children":"Sherman’s armies were to move from Chattanooga against Joseph E. Johnston’s Army of Tennessee and into the Confederate interior."}]]}]]}],["$","div","The spring campaign dates are established",{"className":"moment","children":[["$","$L17",null,{"seconds":293,"label":"4:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"The spring campaign dates are established"}],["$","p",null,{"children":"Sherman entered north Georgia on May 5 and opened operations against Johnston on May 7, as Grant began the Overland Campaign in Virginia."}]]}]]}],["$","div","The account returns to January 1864",{"className":"moment","children":[["$","$L17",null,{"seconds":372,"label":"6:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"The account returns to January 1864"}],["$","p",null,{"children":"The episode explains the political, military, and logistical conditions that shaped the spring offensives."}]]}]]}],["$","div","The United States held major 1863 victories",{"className":"moment","children":[["$","$L17",null,{"seconds":401,"label":"6:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The United States held major 1863 victories"}],["$","p",null,{"children":"Gettysburg, Vicksburg, Port Hudson, and Missionary Ridge improved the military position, but the war remained unfinished."}]]}]]}],["$","div","U.S. losses were already extensive",{"className":"moment","children":[["$","$L17",null,{"seconds":472,"label":"7:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. losses were already extensive"}],["$","p",null,{"children":"Nearly two million men had been mustered and at least 250,000 had died; disease caused most noncombat deaths."}]]}]]}],["$","div","War weariness affected Northern politics",{"className":"moment","children":[["$","$L17",null,{"seconds":541,"label":"9:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"War weariness affected Northern politics"}],["$","p",null,{"children":"Casualties, taxation, conscription, restrictions on civil liberties, and opposition to emancipation increased criticism of the administration."}]]}]]}],["$","div","Democrats opposed Republican war policy",{"className":"moment","children":[["$","$L17",null,{"seconds":601,"label":"10:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Democrats opposed Republican war policy"}],["$","p",null,{"children":"The party’s platform emphasized restoring the prewar Union and Constitution and included substantial opposition to emancipation."}]]}]]}],["$","div","Recent elections still favored Republicans",{"className":"moment","children":[["$","$L17",null,{"seconds":849,"label":"14:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Recent elections still favored Republicans"}],["$","p",null,{"children":"At the start of 1864 Democrats held the governorships of New York and New Jersey, while Republicans had won the other state elections held in autumn 1863."}]]}]]}],["$","div","Battlefield results determined political support",{"className":"moment","children":["$L18","$L19"]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column blue","children":[["$","h3",null,{"children":"United States"}],[["$","div","President and commander-in-chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander-in-chief"}],["$","span",null,{"children":"Abraham Lincoln"}],["$","small",null,{"children":"Set national war policy and sought a general able to coordinate all theaters"}]]}],["$","div","Military Division of the Mississippi",{"className":"command-entry","children":[["$","strong",null,{"children":"Military Division of the Mississippi"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Directed western operations and developed the coordinated strategy; promoted to general-in-chief in March 1864"}]]}],["$","div","Army of the Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Tennessee"}],["$","span",null,{"children":"William T. Sherman"}],["$","small",null,{"children":"Led the Meridian expedition and later received command of Grant’s western military division"}]]}],["$","div","Army of the Cumberland",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Cumberland"}],["$","span",null,{"children":"George H. Thomas"}],["$","small",null,{"children":"Held Chattanooga and prepared the largest army for the advance into Georgia"}]]}],["$","div","Army of the Ohio",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Ohio"}],["$","span",null,{"children":"John G. Foster"}],["$","small",null,{"children":"Tried to move against Longstreet in eastern Tennessee"}]]}],["$","div","Army of the Ohio",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Ohio"}],["$","span",null,{"children":"John M. Schofield"}],["$","small",null,{"children":"Replaced Foster and prepared to join Sherman’s spring campaign"}]]}],["$","div","U.S. Military Railroads",{"className":"command-entry","children":[["$","strong",null,{"children":"U.S. Military Railroads"}],["$","span",null,{"children":"Daniel C. McCallum"}],["$","small",null,{"children":"Repaired, expanded, and operated the rail network supplying the western armies"}]]}]]]}],["$","section","Confederacy",{"className":"command-column red","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Confederate president and commander-in-chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate president and commander-in-chief"}],["$","span",null,{"children":"Jefferson Davis"}],["$","small",null,{"children":"Directed Confederate military policy"}]]}],["$","div","Army of Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Tennessee"}],["$","span",null,{"children":"Joseph E. Johnston"}],["$","small",null,{"children":"Defended north Georgia from his base at Dalton"}]]}],["$","div","Detached First Corps, Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Detached First Corps, Army of Northern Virginia"}],["$","span",null,{"children":"James Longstreet"}],["$","small",null,{"children":"Remained in eastern Tennessee with about 20,000 men"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Abraham Lincoln",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/abraham-lincoln-1864.jpg","alt":"Portrait of Abraham Lincoln","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",n