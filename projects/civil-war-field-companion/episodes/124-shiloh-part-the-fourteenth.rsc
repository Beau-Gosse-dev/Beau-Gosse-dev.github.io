12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Grant prepared to attack again",{"className":"moment","children":[["$","$L1a",null,{"seconds":208,"label":"3:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant prepared to attack again"}],["$","p",null,{"children":"After holding the final line on April 6, Grant remained west of the Tennessee River and prepared a counterattack for the next morning."}]]}]]}],["$","div","Lew Wallace reached the United States right",{"className":"moment","children":[["$","$L1a",null,{"seconds":264,"label":"4:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lew Wallace reached the United States right"}],["$","p",null,{"children":"Wallace’s fresh 3rd Division arrived after the first day’s fighting and deployed on the right flank."}]]}]]}],["$","div","Buell’s troops crossed through the night",{"className":"moment","children":[["$","$L1a",null,{"seconds":289,"label":"4:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Buell’s troops crossed through the night"}],["$","p",null,{"children":"Army of the Ohio units moved by steamboat from the east bank and formed beyond Pittsburg Landing."}]]}]]}],["$","div","Nelson formed on the left",{"className":"moment","children":[["$","$L1a",null,{"seconds":307,"label":"5:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nelson formed on the left"}],["$","p",null,{"children":"William Nelson’s division deployed nearest the Tennessee River. Thomas L. Crittenden and Alexander McCook formed to Nelson’s right as their troops arrived."}]]}]]}],["$","div","The United States line advanced at dawn",{"className":"moment","children":[["$","$L1a",null,{"seconds":368,"label":"6:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The United States line advanced at dawn"}],["$","p",null,{"children":"Lew Wallace led on the right, Nelson led on the left, and the divisions of Sherman, McClernand, and Hurlbut advanced in the center."}]]}]]}],["$","div","Nelson reached heavy resistance",{"className":"moment","children":[["$","$L1a",null,{"seconds":387,"label":"6:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Nelson reached heavy resistance"}],["$","p",null,{"children":"The Army of the Ohio’s left advanced toward the Peach Orchard and Hornets’ Nest area before Confederate fire checked its movement."}]]}]]}],["$","div","The counterattack caught the Confederate army unprepared",{"className":"moment","children":[["$","$L1a",null,{"seconds":442,"label":"7:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The counterattack caught the Confederate army unprepared"}],["$","p",null,{"children":"Beauregard had expected to resume the offensive and did not know the extent of Buell’s arrival."}]]}]]}],["$","div","Confederate formations fought as improvised commands",{"className":"moment","children":[["$","$L1a",null,{"seconds":523,"label":"8:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate formations fought as improvised commands"}],["$","p",null,{"children":"The first day’s terrain, combat, and intermingling had left few Confederate brigades or divisions functioning as intact formations."}]]}]]}],["$","div","United States troops recovered the battlefield",{"className":"moment","children":[["$","$L1a",null,{"seconds":571,"label":"9:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States troops recovered the battlefield"}],["$","p",null,{"children":"Local Confederate counterattacks briefly forced some units back, but the reinforced United States line rallied and resumed its advance."}]]}]]}],["$","div","The center reached the Crossroads by midday",{"className":"moment","children":[["$","$L1a",null,{"seconds":619,"label":"10:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The center reached the Crossroads by midday"}],["$","p",null,{"children":"Sherman’s and McClernand’s divisions returned to the Hamburg–Purdy and Corinth roads, ground they had defended on April 6."}]]}]]}],["$","div","Fighting intensified at Water Oaks Pond",{"className":"moment","children":["$L1b","$L1c"]}],"$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Tennessee"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Lew Wallace’s 3rd Division on the right; Stephen A. Hurlbut’s 4th, John A. McClernand’s 1st, and William T. Sherman’s 5th divisions in the center; remnants of the 2nd and 6th divisions attached where they could fight"}]]}],["$","div","Army of the Ohio",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Ohio"}],["$","span",null,{"children":"Don Carlos Buell"}],["$","small",null,{"children":"William Nelson’s 4th Division on the left, Thomas L. Crittenden’s 5th Division in the left-center, and Alexander McCook’s 2nd Division arriving and entering the line"}]]}],["$","div","3rd Division, Army of the Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"3rd Division, Army of the Tennessee"}],["$","span",null,{"children":"Lew Wallace"}],["$","small",null,{"children":"Led the advance across Tilghman Branch on the far right"}]]}],["$","div","4th Division, Army of the Ohio",{"className":"command-entry","children":[["$","strong",null,{"children":"4th Division, Army of the Ohio"}],["$","span",null,{"children":"William Nelson"}],["$","small",null,{"children":"Led Buell’s attack from Pittsburg Landing toward the Sarah Bell field on the far left"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of the Mississippi",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Mississippi"}],["$","span",null,{"children":"P.G.T. Beauregard"}],["$","small",null,{"children":"Directed the defense, ordered the withdrawal, and assigned a rear guard after Albert Sidney Johnston’s death on April 6"}]]}],["$","div","Second, First, and Third Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Second, First, and Third Corps"}],["$","span",null,{"children":"Braxton Bragg / Leonidas Polk / William J. Hardee"}],["$","small",null,{"children":"Nominal corps structure remained, but intermingled units often fought in improvised groupings on April 7"}]]}],["$","div","Reserve Corps and withdrawal covering force",{"className":"command-entry","children":[["$","strong",null,{"children":"Reserve Corps and withdrawal covering force"}],["$","span",null,{"children":"John C. Breckinridge"}],["$","small",null,{"children":"Held the Corinth Road while the main body withdrew, then left the field at about 5 p.m."}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Ulysses S. Grant",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ulysses-s-grant.jpg","alt":"Portrait of Ulysses S. Grant","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Ulysses S. Grant"}],["$","p",null,{"children":"Commanded the Army of the Tennessee and directed the April 7 counterattack"}]]}]]}],["$","article","Don Carlos Buell",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/don-carlos-buell.jpg","alt":"Portrait of Don Carlos Buell","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Don Carlos Buell"}],["$","p",null,{"children":"Commanded the Army of the Ohio, whose arriving divisions formed the United States left"}]]}]]}],"$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}]]}]
