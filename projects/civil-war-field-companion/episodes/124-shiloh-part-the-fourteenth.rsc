11:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2015/09/07/civil-war-podcast-episode-124/",{"href":"https://civilwarpodcast.org/2015/09/07/civil-war-podcast-episode-124/","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast: Episode 124, Shiloh Part the Fourteenth"]}],["$","a","https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm",{"href":"https://www.nps.gov/shil/learn/historyculture/shiloh-history.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of Shiloh"]}],["$","a","https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=tn003",{"href":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=tn003","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Shiloh battle detail"]}],["$","a","https://www.nps.gov/places/water-oaks-pond-tour-stop-14.htm",{"href":"https://www.nps.gov/places/water-oaks-pond-tour-stop-14.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Water Oaks Pond"]}],["$","a","https://history.army.mil/Portals/143/Images/Publications/Publication%20By%20Title%20Images/C%20Pdf/cmhPub_75-7.pdf",{"href":"https://history.army.mil/Portals/143/Images/Publications/Publication%20By%20Title%20Images/C%20Pdf/cmhPub_75-7.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Civil War in the Western Theater, 1862"]}],["$","a","https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/",{"href":"https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Civil War campaign summary"]}],["$","a","https://www.loc.gov/item/85690890/",{"href":"https://www.loc.gov/item/85690890/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Map of the battlefield of Shiloh"]}],["$","a","https://www.loc.gov/item/2007627473/",{"href":"https://www.loc.gov/item/2007627473/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Buell’s map of Shiloh"]}],["$","a","https://www.loc.gov/pictures/item/2003653260/",{"href":"https://www.loc.gov/pictures/item/2003653260/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: 14th Wisconsin at Shiloh lithograph"]}],["$","a","https://www.nps.gov/people/albert-sidney-johnston.htm",{"href":"https://www.nps.gov/people/albert-sidney-johnston.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Albert Sidney Johnston"]}],["$","a","https://www.nps.gov/cane/highest-praise-the-army-of-the-ohio-at-shiloh.htm",{"href":"https://www.nps.gov/cane/highest-praise-the-army-of-the-ohio-at-shiloh.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: The Army of the Ohio at Shiloh"]}],["$","a","https://www.nps.gov/shil/learn/historyculture/upload/Women-Update-2021-2.pdf",{"href":"https://www.nps.gov/shil/learn/historyculture/upload/Women-Update-2021-2.pdf","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Women at Shiloh"]}]]}]
