d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",124," · ","April 7, 1862, from dawn through the evening, with immediate aftermath on April 8"," · ","Shiloh battlefield around Pittsburg Landing, the Corinth Road, Hamburg–Purdy Road, Water Oaks Pond, Shiloh Church, and the Tennessee River in Hardin County, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Fourteenth)"}],["$","span",null,{"className":"result-label","children":"United States victory. Grant and Buell attacked at dawn with reinforced armies, recovered the ground lost on April 6, and forced Beauregard’s outnumbered army back toward Shiloh Church. Breckinridge covered the Confederate withdrawal down the Corinth Road until late afternoon. The United States armies held the battlefield, while the main Confederate force returned to Corinth and Grant mounted only a limited pursuit"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 7, 1862, from dawn through the evening, with immediate aftermath on April 8"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Shiloh battlefield around Pittsburg Landing, the Corinth Road, Hamburg–Purdy Road, Water Oaks Pond, Shiloh Church, and the Tennessee River in Hardin County, Tennessee"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"United States victory. Grant and Buell attacked at dawn with reinforced armies, recovered the ground lost on April 6, and forced Beauregard’s outnumbered army back toward Shiloh Church. Breckinridge covered the Confederate withdrawal down the Corinth Road until late afternoon. The United States armies held the battlefield, while the main Confederate force returned to Corinth and Grant mounted only a limited pursuit"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],"$Lf"]}]}],"$L10"]}],"$L11"]}],"$undefined"]}],"$L12","$L13","$L14",false,"$L15","$L16","$L17","$L18","$L19","$L1a"]}]]}]
