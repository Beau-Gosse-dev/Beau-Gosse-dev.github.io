1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",124," · ","April 7, 1862, from dawn through the evening, with immediate aftermath on April 8"," · ","Shiloh battlefield around Pittsburg Landing, the Corinth Road, Hamburg–Purdy Road, Water Oaks Pond, Shiloh Church, and the Tennessee River in Hardin County, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Fourteenth)"}],["$","span",null,{"className":"result-label","children":"United States victory. Grant and Buell attacked at dawn with reinforced armies, recovered the ground lost on April 6, and forced Beauregard’s outnumbered army back toward Shiloh Church. Breckinridge covered the Confederate withdrawal down the Corinth Road until late afternoon. The United States armies held the battlefield, while the main Confederate force returned to Corinth and Grant mounted only a limited pursuit"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9399954635.mp3?updated=1695211688","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Second-day attack",{"children":[["$","span",null,{"children":"Second-day attack"}],["$","strong",null,{"children":"United States advance began at dawn on April 7"}],"$undefined"]}],["$","div","United States strength",{"children":[["$","span",null,{"children":"United States strength"}],["$","strong",null,{"children":"More than 54,500 in the current NPS battlefield narrative"}],["$","small",null,{"children":"The force combined Grant’s Army of the Tennessee with arriving divisions of Buell’s Army of the Ohio."}]]}],["$","div","Confederate strength",{"children":[["$","span",null,{"children":"Confederate strength"}],["$","strong",null,{"children":"Barely 34,000 in the current NPS battlefield narrative"}],["$","small",null,{"children":"The army was depleted and its corps, divisions, and brigades had lost much of their cohesion during April 6."}]]}],["$","div","Fresh formations",{"children":[["$","span",null,{"children":"Fresh formations"}],["$","strong",null,{"children":"Lew Wallace’s division and Buell’s divisions under Nelson, Crittenden, and McCook"}],"$undefined"]}],["$","div","Hardest second-day sector",{"children":[["$","span",null,{"children":"Hardest second-day sector"}],["$","strong",null,{"children":"The Crossroads, Water Oaks Pond, and Woolf Field around midday"}],"$undefined"]}],["$","div","Withdrawal route",{"children":[["$","span",null,{"children":"Withdrawal route"}],["$","strong",null,{"children":"Southwest along the Corinth Road toward Corinth, Mississippi"}],"$undefined"]}],["$","div","Confederate rear guard",{"children":[["$","span",null,{"children":"Confederate rear guard"}],["$","strong",null,{"children":"John C. Breckinridge’s Reserve Corps held until about 5 p.m."}],"$undefined"]}],["$","div","Reported battle casualties",{"children":[["$","span",null,{"children":"Reported battle casualties"}],["$","strong",null,{"children":"23,746 total in the current NPS summary"}],["$","small",null,{"children":"Traditional component figures of 13,047 United States and 10,694 Confederate casualties sum to 23,741, so published totals differ slightly."}]]}],"$Le","$Lf"]}],"$L10","$undefined","$L11",false,"$L12","$L13","$L14","$L15","$L16"]}]]}]
