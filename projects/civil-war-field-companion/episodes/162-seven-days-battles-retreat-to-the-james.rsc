28:["$","div","The scale of the movement is counted",{"className":"moment","children":[["$","$L27",null,{"seconds":753,"label":"12:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"The scale of the movement is counted"}],["$","p",null,{"children":"The episode describes about 100,000 soldiers, more than 300 guns, nearly 4,000 wagons, and large herds of animals."}]]}]]}]
29:["$","div","White Oak Swamp blocks the direct route",{"className":"moment","children":[["$","$L27",null,{"seconds":801,"label":"13:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"White Oak Swamp blocks the direct route"}],["$","p",null,{"children":"Engineers have to restore crossings that Federal troops had previously destroyed."}]]}]]}]
