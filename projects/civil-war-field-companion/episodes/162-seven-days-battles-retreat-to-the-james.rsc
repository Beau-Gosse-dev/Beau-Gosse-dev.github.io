1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",162," · ","June 27–29, 1862"," · ","From the Gaines’s Mill battlefield and the Chickahominy River crossings east of Richmond through Savage’s Station and White Oak Swamp toward the James River, Virginia"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: RETREAT TO THE JAMES"}],["$","span",null,{"className":"result-label","children":"During the night after Gaines’s Mill, Fitz John Porter withdrew the V Corps south of the Chickahominy and the bridges were destroyed. George B. McClellan abandoned the Richmond front and the White House Landing supply line, shifted the Army of the Potomac toward the James River, and placed the army on the roads through White Oak Swamp. Robert E. Lee spent much of June 28 determining the Federal route, then ordered the Army of Northern Virginia to pursue"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8589662799.mp3?updated=1695385036","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The aftermath of Gaines’s Mill and the opening movement toward the James"}],["$","small",null,{"children":"The episode begins on the night of June 27 and ends as Lee orders pursuit on June 29, before the fighting at Savage’s Station."}]]}],["$","div","McClellan’s decision",{"children":[["$","span",null,{"children":"McClellan’s decision"}],["$","strong",null,{"children":"Abandon the York River supply line and move to the James River"}],["$","small",null,{"children":"The move ended the immediate operation against Richmond. McClellan called it a change of base; operationally, the army withdrew southeast while under Confederate pressure."}]]}],["$","div","Command conference",{"children":[["$","span",null,{"children":"Command conference"}],["$","strong",null,{"children":"Between about 9 and 11 p.m. on June 27 in the episode’s account"}],["$","small",null,{"children":"McClellan met his corps commanders after learning that Porter had been defeated. Erasmus D. Keyes was absent because IV Corps had already been ordered toward White Oak Swamp."}]]}],["$","div","Kearny and Hooker object",{"children":[["$","span",null,{"children":"Kearny and Hooker object"}],["$","strong",null,{"children":"They asked to attack the thin Confederate line south of the Chickahominy"}],["$","small",null,{"children":"Philip Kearny argued directly against retreat and requested permission to attack John B. Magruder. McClellan denied the request."}]]}],["$","div","McClellan’s telegram",{"children":[["$","span",null,{"children":"McClellan’s telegram"}],["$","strong",null,{"children":"Sent from Savage’s Station at 12:20 a.m. on June 28"}],["$","small",null,{"children":"The Official Records prints McClellan’s charge that Washington had not sustained the army and his final accusation that officials had done their best to sacrifice it."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}],"$L1f","$L20","$L21","$L22",false,"$L23","$L24","$L25"]}]]}]
27:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Transmission uncertainty",{"children":[["$","span",null,{"children":"Transmission uncertainty"}],["$","strong",null,{"children":"The final sentence did not reach Secretary of War Edwin M. Stanton"}],["$","small",null,{"children":"The episode follows telegrapher David Homer Bates’s later account that Edward S. Sanford withheld the sentence. The complete sentence still appeared in McClellan’s official report and the Official Records; the deletion account rests on Bates’s 1907 recollection."}]]}]
f:["$","div","Lincoln’s response",{"children":[["$","span",null,{"children":"Lincoln’s response"}],["$","strong",null,{"children":"“Save your Army at all events”"}],["$","small",null,{"children":"Lincoln promised reinforcements but explained that they could not arrive immediately. His June 28 message also defended the decision to protect Washington."}]]}]
10:["$","div","V Corps night withdrawal",{"children":[["$","span",null,{"children":"V Corps night withdrawal"}],["$","strong",null,{"children":"Porter crossed south of the Chickahominy before dawn on June 28"}],["$","small",null,{"children":"Darkness allowed the defeated force to escape. Engineers destroyed the bridges after the crossing, delaying Confederate pursuit."}]]}]
11:["$","div","John F. Reynolds captured",{"children":[["$","span",null,{"children":"John F. Reynolds captured"}],["$","strong",null,{"children":"Captured after falling asleep during the withdrawal"}],["$","small",null,{"children":"Reynolds commanded a brigade in George A. McCall’s Pennsylvania Reserves division. Exhaustion left him north of the river when Confederate troops arrived after daylight."}]]}]
12:["$","div","Artillery lost during the crossing",{"children":[["$","span",null,{"children":"Artillery lost during the crossing"}],["$","strong",null,{"children":"Three guns fell from bridges into the Chickahominy"}],["$","small",null,{"children":"The episode counts twenty-two guns lost by Porter on June 27: nineteen captured by Confederates and three lost in the river."}]]}]
13:["$","div","Distance to the James",{"children":[["$","span",null,{"children":"Distance to the James"}],["$","strong",null,{"children":"About fifteen miles in a straight line, but farther by usable roads"}],["$","small",null,{"children":"The army had to follow an indirect route through swampy terrain toward Glendale, Malvern Hill, and the James River landings."}]]}]
14:["$","div","Scale of the movement",{"children":[["$","span",null,{"children":"Scale of the movement"}],["$","strong",null,{"children":"About 100,000 soldiers and more than 300 artillery pieces"}],["$","small",null,{"children":"The episode also gives twenty-six heavy siege guns, nearly 4,000 wagons, tens of thousands of horses, and about 2,500 cattle. Totals vary according to reporting date and whether attached personnel and trains are included."}]]}]
15:["$","div","Road conditions",{"children":[["$","span",null,{"children":"Road conditions"}],["$","strong",null,{"children":"Narrow roads, swamp crossings, rain, animals, and wagon traffic slowed the column"}],["$","small",null,{"children":"Multiple corps and the supply trains crowded onto a small number of routes. The episode states that alternate roads had not been adequately scouted."}]]}]
16:["$","div","White Oak Swamp crossing",{"children":[["$","span",null,{"children":"White Oak Swamp crossing"}],["$","strong",null,{"children":"The main bridge was rebuilt by about 7 a.m. on June 28"}],["$","small",null,{"children":"Keyes’s IV Corps began crossing soon afterward. A second crossing at Brackett’s Ford, about one and one-half miles away, was completed later that morning."}]]}]
17:["$","div","White House Landing",{"children":[["$","span",null,{"children":"White House Landing"}],["$","strong",null,{"children":"The former Federal supply base was abandoned"}],["$","small",null,{"children":"McClellan no longer intended to preserve the Richmond and York River Railroad connection. Stuart’s cavalry and Ewell’s division moved east to determine the status of the base and railroad."}]]}]
18:["$","div","Lee’s information problem",{"children":[["$","span",null,{"children":"Lee’s information problem"}],["$","strong",null,{"children":"The destroyed bridges and several plausible Federal routes delayed pursuit"}],["$","small",null,{"children":"Lee considered a movement east to retain the railroad, a withdrawal down the Peninsula, or a move south to the James. The episode places Lee’s firm conclusion on June 29; the U.S. Army Center of Military History states that he learned late on June 28 that McClellan was moving south."}]]}]
19:["$","div","Gaines’s Mill aftermath",{"children":[["$","span",null,{"children":"Gaines’s Mill aftermath"}],["$","strong",null,{"children":"Thousands of dead and wounded remained on the battlefield"}],["$","small",null,{"children":"The episode estimates nearly 2,400 dead and about 9,000 wounded from both armies on or around the field. Casualty totals differ among official reports and later compilations."}]]}]
1a:["$","div","Confederate burials",{"children":[["$","span",null,{"children":"Confederate burials"}],["$","strong",null,{"children":"Many dead were placed in mass graves on June 28"}],["$","small",null,{"children":"Confederate soldiers spent much of the day caring for wounded men and burying the dead while Lee assessed McClellan’s direction."}]]}]
1b:["$","div","Operational consequence",{"children":[["$","span",null,{"children":"Operational consequence"}],["$","strong",null,{"children":"Lee secured Richmond and retained the initiative"}],["$","small",null,{"children":"McClellan’s army remained intact, but his siege approach and York River logistics were abandoned. Further rear-guard battles followed before the army reached the James."}]]}]
1c:["$","div","Leader deaths in this episode",{"children":[["$","span",null,{"children":"Leader deaths in this episode"}],["$","strong",null,{"children":"None identified"}],["$","small",null,{"children":"The narrated action includes John F. Reynolds’s capture but no important commander killed or mortally wounded during the episode’s June 27–29 scope."}]]}]
1d:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Mr. Lincoln’s Army” by Bruce Catton"}],["$","small",null,{"children":"The official episode page and podcast book-recommendations list identify this title."}]]}]
1e:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Heintzelman, Kearny, Magruder, Ewell, Chickahominy, White House Landing, and coup de grâce"}],["$","small",null,{"children":"The automated transcript produces forms including “Heinsleman,” “Carney,” “Yule,” and “coup de gras.” The place and personal names in this enrichment use standard historical spellings."}]]}]
1f:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
20:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Peninsula Campaign regional context",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep162-peninsula-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Peninsula Campaign regional context at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep162-peninsula-context.svg","alt":"Schematic regional map of the Virginia Peninsula showing Fort Monroe, Richmond, White House Landing, the Seven Days battle area, and the movement toward Harrison’s Landing.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Peninsula Campaign regional context"}],["$","span",null,{"children":"The Army of the Potomac advanced from Fort Monroe toward Richmond between the York and James rivers. After Gaines’s Mill, McClellan abandoned the York River supply connection at White House Landing and moved toward Harrison’s Landing on the James. Shorelines, rivers, routes, locations, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep162-peninsula-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History, National Park Service, Library of Congress, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$20:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Movements on June 28",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep162-june-28-movements.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Movements on June 28 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep162-june-28-movements.svg","alt":"Schematic map of Federal withdrawal across the Chickahominy and through White Oak Swamp, and Confederate reconnaissance toward White House Landing on June 28, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Movements on June 28"}],["$","span",null,{"children":"Porter’s V Corps crossed south of the Chickahominy during the night and the bridges were destroyed. The army and trains moved from the Richmond front toward Savage’s Station and White Oak Swamp, with Keyes’s IV Corps leading the southward movement. Stuart and Ewell moved east toward the railroad and White House Landing while Lee determined McClellan’s route. Arrows show generalized operational relationships. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep162-june-28-movements.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$20:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History, National Park Service, Library of Congress, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$20:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],"$L26"]}]]}]
21:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode resumes after Gaines’s Mill",{"className":"moment","children":[["$","$L27",null,{"seconds":70,"label":"1:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode resumes after Gaines’s Mill"}],["$","p",null,{"children":"The account begins with Porter defeated north of the Chickahominy on the night of June 27."}]]}]]}],["$","div","McClellan meets his corps commanders",{"className":"moment","children":[["$","$L27",null,{"seconds":146,"label":"2:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan meets his corps commanders"}],["$","p",null,{"children":"The conference occurs after Keyes has already been sent toward White Oak Swamp."}]]}]]}],["$","div","Kearny and Hooker oppose retreat",{"className":"moment","children":[["$","$L27",null,{"seconds":222,"label":"3:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kearny and Hooker oppose retreat"}],["$","p",null,{"children":"The III Corps division commanders seek permission to attack Magruder’s thin line south of the river."}]]}]]}],["$","div","McClellan prepares the 12:20 a.m. telegram",{"className":"moment","children":[["$","$L27",null,{"seconds":335,"label":"5:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan prepares the 12:20 a.m. telegram"}],["$","p",null,{"children":"He sends Stanton a report from Savage’s Station that assigns responsibility for the defeat to insufficient Federal strength."}]]}]]}],["$","div","McClellan states his case",{"className":"moment","children":[["$","$L27",null,{"seconds":381,"label":"6:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan states his case"}],["$","p",null,{"children":"The telegram says that he lost the battle because his force was too small and denies responsibility."}]]}]]}],["$","div","The telegram ends with an accusation",{"className":"moment","children":[["$","$L27",null,{"seconds":417,"label":"6:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The telegram ends with an accusation"}],["$","p",null,{"children":"McClellan charges that officials in Washington had done their best to sacrifice the army."}]]}]]}],["$","div","The final sentence is withheld",{"className":"moment","children":[["$","$L27",null,{"seconds":462,"label":"7:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"The final sentence is withheld"}],["$","p",null,{"children":"The episode follows the later account that telegraph official Edward S. Sanford removed the last sentence before delivery to Stanton."}]]}]]}],["$","div","Lincoln answers McClellan",{"className":"moment","children":[["$","$L27",null,{"seconds":499,"label":"8:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln answers McClellan"}],["$","p",null,{"children":"Lincoln directs him to save the army and explains why reinforcements cannot arrive immediately."}]]}]]}],["$","div","The night withdrawal is described",{"className":"moment","children":[["$","$L27",null,{"seconds":631,"label":"10:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"The night withdrawal is described"}],["$","p",null,{"children":"V Corps and supporting troops cross the Chickahominy under cover of darkness."}]]}]]}],["$","div","John F. Reynolds is captured",{"className":"moment","children":[["$","$L27",null,{"seconds":658,"label":"10:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"John F. Reynolds is captured"}],["$","p",null,{"children":"The exhausted brigade commander wakes after daylight to find Confederate troops around him."}]]}]]}],["$","div","Three artillery pieces fall into the river",{"className":"moment","children":[["$","$L27",null,{"seconds":689,"label":"11:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Three artillery pieces fall into the river"}],["$","p",null,{"children":"The guns are lost from the narrow bridges during the confused night crossing."}]]}]]}],["$","div","Porter completes the crossing",{"className":"moment","children":[["$","$L27",null,{"seconds":710,"label":"11:50"}],["$","div",null,{"children":[["$","h3",null,{"children":"Porter completes the crossing"}],["$","p",null,{"children":"Before sunrise on June 28, V Corps is south of the river and the bridges are destroyed."}]]}]]}],"$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34"]}]]}]
22:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Ordered the change of base from the York to the James and assigned the corps and trains to the southward movement"}]]}],["$","div","V Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps"}],["$","span",null,{"children":"Maj. Gen. Fitz John Porter"}],["$","small",null,{"children":"Withdrew the defeated force across the Chickahominy; included the divisions of George W. Morell, George Sykes, and George A. McCall"}]]}],["$","div","IV Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"IV Corps"}],["$","span",null,{"children":"Brig. Gen. Erasmus D. Keyes"}],["$","small",null,{"children":"Led the movement through White Oak Swamp ahead of the main army and wagon columns"}]]}],["$","div","III Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps"}],["$","span",null,{"children":"Maj. Gen. Samuel P. Heintzelman"}],["$","small",null,{"children":"Divisions of Brig. Gens. Joseph Hooker and Philip Kearny remained south of the Chickahominy"}]]}],["$","div","III Corps division commanders",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps division commanders"}],["$","span",null,{"children":"Brig. Gens. Philip Kearny and Joseph Hooker"}],["$","small",null,{"children":"Objected to the retreat and requested an attack on Magruder’s line near Richmond"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Held the main force north of the Chickahominy while determining McClellan’s route, then ordered pursuit"}]]}],["$","div","Army wing north of the Chickahominy",{"className":"command-entry","children":[["$","strong",null,{"children":"Army wing north of the Chickahominy"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Questioned prisoners and remained with the force positioned to follow the Federal rear"}]]}],["$","div","Cavalry",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry"}],["$","span",null,{"children":"Maj. Gen. J. E. B. Stuart"}],["$","small",null,{"children":"Reconnoitered toward White House Landing and reported that the supply base had been abandoned"}]]}],["$","div","Division in Jackson’s command",{"className":"command-entry","children":[["$","strong",null,{"children":"Division in Jackson’s command"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Moved east toward the Richmond and York River Railroad during Lee’s effort to establish the Federal route"}]]}],["$","div","Division south of the Chickahominy",{"className":"command-entry","children":[["$","strong",null,{"children":"Division south of the Chickahominy"}],["$","span",null,{"children":"Maj. Gen. John B. Magruder"}],["$","small",null,{"children":"Maintained the Richmond-facing line that Kearny and Hooker proposed attacking"}]]}],["$","div","Division south of the Chickahominy",{"className":"command-entry","children":[["$","strong",null,{"children":"Division south of the Chickahominy"}],["$","span",null,{"children":"Maj. Gen. Benjamin Huger"}],["$","small",null,{"children":"Remained between the Federal army and Richmond before joining the pursuit ordered by Lee"}]]}]]]}]]}],["$","h3",null,{"className":"subsection-title","children":"Other people heard or discussed"}],"$L35"]}]
23:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep162-peninsula-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep162-peninsula-context.svg","alt":"Schematic regional map of the Virginia Peninsula and the movement from the York River supply line to the James River.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The operational base shifted from the York River side of the Peninsula to the James River. The diagram gives regional context without claiming surveyed geography."}]]}],["$","figure","/images/ep162-june-28-movements.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep162-june-28-movements.svg","alt":"Schematic map of Federal and Confederate movements around the Chickahominy, White Oak Swamp, and White House Landing on June 28.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The Federal army and trains moved southeast while Confederate reconnaissance moved toward the abandoned York River supply line."}]]}],["$","figure","/images/ep162-humphreys-seven-days-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep162-humphreys-seven-days-map.jpg","alt":"Benjamin Grubb Humphreys’s 1862 hand-drawn map of the Seven Days battle area and Federal retreat.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This 1862 map accompanied a July 29 letter by Benjamin Grubb Humphreys. It shows the battle area and a contemporary interpretation of the Federal line of retreat."}]]}],["$","figure","/images/ep162-george-mcclellan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep162-george-mcclellan.jpg","alt":"Civil War-era photographic portrait of United States general Ge