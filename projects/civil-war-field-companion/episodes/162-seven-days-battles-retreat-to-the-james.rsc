2b:["$","div","A second crossing is completed",{"className":"moment","children":[["$","$L27",null,{"seconds":841,"label":"14:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"A second crossing is completed"}],["$","p",null,{"children":"Engineers finish a bridge at Brackett’s Ford about one and one-half miles away."}]]}]]}]
2c:["$","div","Route planning is assessed",{"className":"moment","children":[["$","$L27",null,{"seconds":874,"label":"14:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Route planning is assessed"}],["$","p",null,{"children":"The episode states that inadequate scouting concentrated the march on fewer roads than were available."}]]}]]}]
