30:["$","div","Lee considers three Federal routes",{"className":"moment","children":[["$","$L27",null,{"seconds":1150,"label":"19:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee considers three Federal routes"}],["$","p",null,{"children":"He evaluates a move east to the railroad, a withdrawal down the Peninsula, and a movement south to the James."}]]}]]}]
