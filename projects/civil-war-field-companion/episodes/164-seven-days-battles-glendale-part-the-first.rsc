26:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep164-regional-context.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep164-regional-context.svg","alt":"Schematic regional map of the Army of the Potomac’s route from the Chickahominy toward the James River.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The June 30 operations extended from White Oak Swamp through the Glendale crossroads to Malvern Hill and the James River. Locations and routes are generalized."}]]}],["$","figure","/images/ep164-glendale-deployment.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep164-glendale-deployment.svg","alt":"Schematic deployment map of the Federal line and Confederate approach routes around Glendale.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Federal divisions guarded White Oak Swamp and the Glendale bottleneck while six Confederate commands approached on separate routes. Frontages, arrows, and distances are schematic and not to scale."}]]}],["$","figure","/images/ep164-sneden-white-oak-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep164-sneden-white-oak-map.jpg","alt":"Robert Knox Sneden watercolor map of the June 30 retreat to White Oak Swamp.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Robert Knox Sneden’s participant-era map labels the withdrawal from Savage Station and the Federal position after crossing White Oak Swamp on the morning of June 30."}]]}],["$","figure","/images/ep164-white-oak-artillery-waud.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep164-white-oak-artillery-waud.jpg","alt":"Alfred R. Waud drawing of United States artillery enga