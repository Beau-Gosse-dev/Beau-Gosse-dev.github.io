1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",164," · ","June 30, 1862"," · ","White Oak Swamp, the Glendale crossroads, and the roads extending south to Malvern Hill and the James River, east and southeast of Richmond, Virginia"]}],["$","h1",null,{"children":"SEVEN DAYS' BATTLES: GLENDALE (Part the First)"}],["$","span",null,{"className":"result-label","children":"This episode covers the deployment and opening operations of June 30 rather than the main infantry fighting at Glendale. By the point where the episode ends, William B. Franklin had blocked Thomas J. “Stonewall” Jackson at White Oak Swamp, Benjamin Huger had been delayed on the Charles City Road, and four United States brigades had left the White Oak sector to reinforce the line near Glendale. The larger Battle of Glendale, completed in episode 165, was indecisive; the United States line of retreat remained open"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1223298133.mp3?updated=1695385083","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The approach to Glendale and the separate action at White Oak Swamp"}],["$","small",null,{"children":"The episode ends before Longstreet’s and A. P. Hill’s main assault west of the Glendale crossroads."}]]}],["$","div","Geographic sequence",{"children":[["$","span",null,{"children":"Geographic sequence"}],["$","strong",null,{"children":"Savage Station, White Oak Swamp, Glendale, Malvern Hill, and the James River"}],["$","small",null,{"children":"The episode describes these points from north to south to establish the Army of the Potomac’s withdrawal route."}]]}],["$","div","Savage Station withdrawal",{"children":[["$","span",null,{"children":"Savage Station withdrawal"}],["$","strong",null,{"children":"The Federal rear guard resumed its march after dark on June 29"}],["$","small",null,{"children":"McClellan’s order left approximately 2,500 sick and wounded United States soldiers at the Savage Station field hospital."}]]}],["$","div","White Oak crossing",{"children":[["$","span",null,{"children":"White Oak crossing"}],["$","strong",null,{"children":"The Army of the Potomac was south of White Oak Swamp by midmorning on June 30"}],["$","small",null,{"children":"The army still had to move its wagon trains and remaining combat formations through Glendale toward the James."}]]}],["$","div","Operational bottleneck",{"children":[["$","span",null,{"children":"Operational bottleneck"}],["$","strong",null,{"children":"The Glendale crossroads controlled the Willis Church Road toward Malvern Hill"}],["$","small",null,{"children":"Supply wagons and troops converged there, and a successful Confederate advance from the west could have cut the withdrawal route."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}],"$L22","$L23","$L24","$L25",false,"$L26","$L27","$L28"]}]]}]
2a:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","div","Federal advance elements",{"children":[["$","span",null,{"children":"Federal advance elements"}],["$","strong",null,{"children":"Keyes’s IV Corps and most of Porter’s V Corps had reached Malvern Hill"}],["$","small",null,{"children":"George A. McCall’s Pennsylvania Reserves, a V Corps division, remained near Glendale to protect the route."}]]}]
f:["$","div","White Oak defense",{"children":[["$","span",null,{"children":"White Oak defense"}],["$","strong",null,{"children":"Franklin’s VI Corps covered the swamp exits"}],["$","small",null,{"children":"William F. Smith’s and Henry W. Slocum’s divisions formed the principal force facing Jackson. Israel B. Richardson’s II Corps division was positioned nearby."}]]}]
10:["$","div","Glendale defense",{"children":[["$","span",null,{"children":"Glendale defense"}],["$","strong",null,{"children":"McCall faced west, with Kearny to the right and Hooker to the left"}],["$","small",null,{"children":"John Sedgwick’s division was posted to the left and rear of McCall. The deployment was not a continuous, centrally directed line."}]]}]
11:["$","div","Federal command arrangement",{"children":[["$","span",null,{"children":"Federal command arrangement"}],["$","strong",null,{"children":"No battlefield commander controlled all of the divisions around Glendale"}],["$","small",null,{"children":"McClellan did not designate a substitute commander. Corps and division commanders coordinated only portions of the defensive line."}]]}]
12:["$","div","McClellan at Haxall’s Landing",{"children":[["$","span",null,{"children":"McClellan at Haxall’s Landing"}],["$","strong",null,{"children":"Reached the James River landing at about 10 a.m."}],["$","small",null,{"children":"He had inspected ground around Glendale earlier that morning, then moved with his staff to the river. The U.S. Army campaign history places him aboard USS Galena at 4 p.m."}]]}]
13:["$","div","Lee’s objective",{"children":[["$","span",null,{"children":"Lee’s objective"}],["$","strong",null,{"children":"Converge on Glendale and cut the Army of the Potomac’s line to the James"}],["$","small",null,{"children":"Lee directed separated columns toward the Federal rear, flank, center, and withdrawal route. The plan depended on timing and communication between the columns."}]]}]
14:["$","div","Jackson’s assignment",{"children":[["$","span",null,{"children":"Jackson’s assignment"}],["$","strong",null,{"children":"Pursue the Federal rear guard through White Oak Swamp"}],["$","small",null,{"children":"Jackson moved south from Savage Station. Lee’s exact verbal instructions from their morning meeting were not recorded, so the expected extent of Jackson’s action remains a matter of interpretation."}]]}]
15:["$","div","Huger’s assignment",{"children":[["$","span",null,{"children":"Huger’s assignment"}],["$","strong",null,{"children":"Approach Glendale on the Charles City Road from the northwest"}],["$","small",null,{"children":"Lee expected Huger’s movement to help open the coordinated attack, but felled trees blocked the road and delayed the division."}]]}]
16:["$","div","Longstreet and A. P. Hill",{"children":[["$","span",null,{"children":"Longstreet and A. P. Hill"}],["$","strong",null,{"children":"Approach from the west by the Long Bridge Road"}],["$","small",null,{"children":"Their combined divisions formed the principal striking force against the Federal line west of the crossroads. Their assault is covered in episode 165."}]]}]
17:["$","div","Magruder and Holmes",{"children":[["$","span",null,{"children":"Magruder and Holmes"}],["$","strong",null,{"children":"Magruder served as a reserve; Holmes moved toward Malvern Hill"}],["$","small",null,{"children":"Magruder marched by the Darbytown Road in support of Longstreet and Hill. Holmes was to threaten the wagon route and limit reinforcement from the south."}]]}]
18:["$","div","Huger’s road obstruction",{"children":[["$","span",null,{"children":"Huger’s road obstruction"}],["$","strong",null,{"children":"Felled trees extended for nearly a mile in the episode’s account"}],["$","small",null,{"children":"William Mahone recommended cutting a new route through the woods. The resulting delay became known as the “Battle of the Axes.”"}]]}]
19:["$","div","Jackson reaches White Oak Swamp",{"children":[["$","span",null,{"children":"Jackson reaches White Oak Swamp"}],["$","strong",null,{"children":"The head of his column arrived shortly before noon"}],["$","small",null,{"children":"The bridge was destroyed. United States infantry and artillery occupied higher ground south of the stream."}]]}]
1a:["$","div","Confederate bombardment",{"children":[["$","span",null,{"children":"Confederate bombardment"}],["$","strong",null,{"children":"Thirty-one guns opened at about 2 p.m. in the episode’s account"}],["$","small",null,{"children":"The artillery fire prompted Franklin to request reinforcements from Sumner, but Jackson did not follow the bombardment with a general infantry crossing."}]]}]
1b:["$","div","Munford’s reconnaissance",{"children":[["$","span",null,{"children":"Munford’s reconnaissance"}],["$","strong",null,{"children":"The 2nd Virginia Cavalry found an undefended crossing downstream"}],["$","small",null,{"children":"Colonel Thomas T. Munford reported that infantry could use the cow crossing to reach the Federal right flank. Jackson did not act on the report."}]]}]
1c:["$","div","Hampton’s crossing",{"children":[["$","span",null,{"children":"Hampton’s crossing"}],["$","strong",null,{"children":"A second shallow crossing was found east of the destroyed bridge"}],["$","small",null,{"children":"Wade Hampton’s men built a crude bridge suitable for infantry. No infantry attack followed after Hampton reported that it was ready."}]]}]
1d:["$","div","Effect of Jackson’s inaction",{"children":[["$","span",null,{"children":"Effect of Jackson’s inaction"}],["$","strong",null,{"children":"Federal reinforcements could leave the White Oak sector"}],["$","small",null,{"children":"The episode states that four brigades, nearly 10,000 men, ultimately moved from Jackson’s front to the fighting near Glendale. Strength totals are approximate."}]]}]
1e:["$","div","Jackson’s performance",{"children":[["$","span",null,{"children":"Jackson’s performance"}],["$","strong",null,{"children":"The causes remain disputed"}],["$","small",null,{"children":"The episode weighs physical exhaustion against unfamiliarity with Lee’s command expectations. Neither explanation can be established conclusively from the surviving evidence."}]]}]
1f:["$","div","Important leader losses in this episode’s action",{"children":[["$","span",null,{"children":"Important leader losses in this episode’s action"}],["$","strong",null,{"children":"None identified"}],["$","small",null,{"children":"The episode does not identify a senior commander killed or mortally wounded during the White Oak Swamp action. The main Glendale assault and its casualties are outside this episode’s scope."}]]}]
20:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Extraordinary Circumstances: The Seven Days Battles” by Brian K. Burton"}],["$","small",null,{"children":"The official episode page and podcast book list identify this title as the recommendation for episode 164."}]]}]
21:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Keyes, Heintzelman, Kearny, Huger, Haxall’s Landing, Munford, and White Oak Swamp"}],["$","small",null,{"children":"The automated transcript produces forms including “Key’s,” “Heinzelman,” “Carney,” “UJ,” “Haxwell,” and “Mumford.” “UJ” refers to Benjamin Huger."}]]}]
22:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
23:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","From Richmond to the James River",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep164-regional-context.svg","target":"_blank","rel":"noreferrer","aria-label":"Open From Richmond to the James River at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep164-regional-context.svg","alt":"Schematic regional map from Richmond and the Chickahominy River south through Savage Station, White Oak Swamp, Glendale, Malvern Hill, and Haxall’s Landing on the James River.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"From Richmond to the James River"}],["$","span",null,{"children":"The Army of the Potomac moved south from Savage Station through White Oak Swamp and Glendale toward Malvern Hill and the James River. The diagram shows the broad relationship among the named places and the withdrawal route. Locations, curves, roads, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep164-regional-context.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Robert Knox Sneden map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","June 30 approach routes and Federal deployment",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep164-glendale-deployment.svg","target":"_blank","rel":"noreferrer","aria-label":"Open June 30 approach routes and Federal deployment at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep164-glendale-deployment.svg","alt":"Schematic map of Federal divisions around White Oak Swamp and Glendale and the Confederate approach routes on June 30, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"June 30 approach routes and Federal deployment"}],["$","span",null,{"children":"Franklin covered the White Oak Swamp exits while McCall, Kearny, Hooker, and Sedgwick held a discontinuous line around Glendale. Jackson approached from the north, Huger from the northwest, Longstreet and A. P. Hill from the west, Magruder from the southwest as a reserve, and Holmes from the south and east. Arrows and formation areas show generalized relationships, not exact routes, frontages, or troop geometry. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep164-glendale-deployment.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Historic American Landscapes Survey, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],"$L29"]}]]}]
24:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The battlefield geography is established",{"className":"moment","children":[["$","$L2a",null,{"seconds":98,"label":"1:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The battlefield geography is established"}],["$","p",null,{"children":"The episode begins a north-to-south description from Richmond and the Chickahominy toward the James River."}]]}]]}],["$","div","The retreat resumes after Savage Station",{"className":"moment","children":[["$","$L2a",null,{"seconds":204,"label":"3:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The retreat resumes after Savage Station"}],["$","p",null,{"children":"The Federal rear guard withdraws after the June 29 fighting, leaving sick and wounded soldiers at the field hospital."}]]}]]}],["$","div","The army clears White Oak Swamp",{"className":"moment","children":[["$","$L2a",null,{"seconds":250,"label":"4:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army clears White Oak Swamp"}],["$","p",null,{"children":"By midmorning on June 30, the Army of the Potomac has crossed south of the swamp, but its wagon trains still need time to reach the James."}]]}]]}],["$","div","The Federal dispositions are reviewed",{"className":"moment","children":[["$","$L2a",null,{"seconds":269,"label":"4:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Federal dispositions are reviewed"}],["$","p",null,{"children":"Keyes and most of Porter are near Malvern Hill while Franklin covers White Oak Swamp and five divisions remain around Glendale."}]]}]]}],["$","div","McCall occupies the western approach",{"className":"moment","children":[["$","$L2a",null,{"seconds":331,"label":"5:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCall occupies the western approach"}],["$","p",null,{"children":"The Pennsylvania Reserves face west while Kearny, Hooker, and Sedgwick occupy adjoining but imperfectly connected positions."}]]}]]}],["$","div","The absence of central battlefield command is explained",{"className":"moment","children":[["$","$L2a",null,{"seconds":440,"label":"7:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The absence of central battlefield command is explained"}],["$","p",null,{"children":"Division commanders operate largely within their own sectors without a commander directing the entire Glendale line."}]]}]]}],["$","div","McClellan leaves for Haxall’s Landing",{"className":"moment","children":[["$","$L2a",null,{"seconds":498,"label":"8:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan leaves for Haxall’s Landing"}],["$","p",null,{"children":"After examining ground near Glendale, he rides to the James River and reaches the landing at about 10 a.m."}]]}]]}],["$","div","McClellan boards USS Galena later in the day",{"className":"moment","children":[["$","$L2a",null,{"seconds":516,"label":"8:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan boards USS Galena later in the day"}],["$","p",null,{"children":"The episode describes his movement aboard the gunboat after 3 p.m.; the U.S. Army campaign history uses 4 p.m."}]]}]]}],["$","div","No substitute army commander is appointed",{"className":"moment","children":[["$","$L2a",null,{"seconds":569,"label":"9:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"No substitute army commander is appointed"}],["$","p",null,{"children":"McClellan does not give Sumner or another officer authority over the full battlefield deployment."}]]}]]}],["$","div","Lee organizes the converging attack",{"className":"moment","children":[["$","$L2a",null,{"seconds":712,"label":"11:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee organizes the converging attack"}],["$","p",null,{"children":"Confederate columns are directed toward Glendale, White Oak Swamp, and the road system leading to Malvern Hill."}]]}]]}],["$","div","Six Confederate commands move",{"className":"moment","children":[["$","$L2a",null,{"seconds":778,"label":"12:58"}],["$","div",null,{"children":[["$","h3",null,{"children":"Six Confederate commands move"}],["$","p",null,{"children":"The episode begins its account of Jackson, Huger, Longstreet, A. P. Hill, Magruder, and Holmes."}]]}]]}],"$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c"]}]]}]
25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Inspected the Glendale area, then moved to Haxall’s Landing without appointing an overall battlefield commander"}]]}],["$","div","VI Corps at White Oak Swamp",{"className":"command-entry","children":[["$","strong",null,{"children":"VI Corps at White Oak Swamp"}],["$","span",null,{"children":"Maj. Gen. William B. Franklin"}],["$","small",null,{"children":"Divisions of Brig. Gens. William F. Smith and Henry W. Slocum covered the swamp exits"}]]}],["$","div","II Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"II Corps"}],["$","span",null,{"children":"Maj. Gen. Edwin V. Sumner"}],["$","small",null,{"children":"Divisions of Brig. Gens. Israel B. Richardson and John Sedgwick occupied separated sectors from White Oak Swamp to Glendale"}]]}],["$","div","III Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"III Corps"}],["$","span",null,{"children":"Maj. Gen. Samuel P. Heintzelman"}],["$","small",null,{"children":"Divisions of Brig. Gens. Philip Kearny and Joseph Hooker held ground on McCall’s right and left, respectively"}]]}],["$","div","Pennsylvania Reserves division, V Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"Pennsylvania Reserves division, V Corps"}],["$","span",null,{"children":"Brig. Gen. George A. McCall"}],["$","small",null,{"children":"Held the central western approach to the Glendale crossroads while most of Porter’s co