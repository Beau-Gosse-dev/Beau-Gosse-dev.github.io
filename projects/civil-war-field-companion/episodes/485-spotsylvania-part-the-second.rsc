d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",485," · ","May 8–11, 1864"," · ","Laurel Hill, Po River, and Mule Shoe salient, Spotsylvania Court House, Virginia"]}],["$","h1",null,{"children":"SPOTSYLVANIA (Part the Second)"}],["$","span",null,{"className":"result-label","children":"Lee retained the Spotsylvania crossroads and repulsed four separate U.S. attacks on May 10. Upton’s 5,000-man column briefly broke the Mule Shoe defenses, captured prisoners and guns, and withdrew when the supporting attacks failed. Grant used that temporary breakthrough as the model for a larger assault"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"May 8–11, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Laurel Hill, Po River, and Mule Shoe salient, Spotsylvania Court House, Virginia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Lee retained the Spotsylvania crossroads and repulsed four separate U.S. attacks on May 10. Upton’s 5,000-man column briefly broke the Mule Shoe defenses, captured prisoners and guns, and withdrew when the supporting attacks failed. Grant used that temporary breakthrough as the model for a larger assault"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"May 8–11, 1864","place":"Laurel Hill, Po River, and Mule Shoe salient, Spotsylvania Court House, Virginia","result":"Lee retained the Spotsylvania crossroads and repulsed four separate U.S. attacks on May 10. Upton’s 5,000-man column briefly broke the Mule Shoe defenses, captured prisoners and guns, and withdrew when the supporting attacks failed. Grant used that temporary breakthrough as the model for a larger assault","facts":[{"label":"Length of the Mule Shoe salient","value":"Nearly 1 mile northward"},{"label":"Mott’s attacking force","value":"About 1,250"},{"label":"Upton’s attacking force","value":"About 5,000"},{"label":"Regiments in Upton’s column","value":"12"},{"label":"Distance from woods to works","value":"About 200 yards"},{"label":"Upton’s attack began","value":"6:35 p.m., May 10"},{"label":"Confederate guns temporarily captured","value":"4"},{"label":"Grant’s estimate of U.S. losses since the Rapidan","value":"About 20,000"}],"maps":[{"title":"Troop positions and attacks on May 10","caption":"The National Park Service map shows Hancock south of the Po River, Warren at Laurel Hill, Upton attacking the Mule Shoe’s west face, Burnside approaching from the east, and the Confederate corps around Spotsylvania Court House.","source":"https://www.nps.gov/npgallery/GetAsset/2c2aabb1-f490-46d2-b906-4cd75ba49bbd","image":"/images/spotsylvania-may10-nps-map.png","alt":"National Park Service map of troop positions and attacks at Spotsylvania Court House on May 10, 1864"},{"title":"Upton’s approach to the Mule Shoe today","caption":"Upton formed his twelve regiments in woods west of the salient and crossed open ground toward the Confederate works. The preserved attack corridor is now reached from Upton’s Road in the national battlefield.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-77.625%2C38.205%2C-77.565%2C38.245&layer=mapnik&marker=38.2240%2C-77.6060"},{"title":"Spotsylvania in the Overland Campaign","caption":"The campaign map places the battlefield southeast of the Wilderness. Holding the crossroads kept Lee between Grant and Richmond but also kept the armies in continuous contact.","source":"https://www.loc.gov/item/99448882/","image":"/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland Campaign showing Spotsylvania Court House"}],"moments":[{"time":"1:20","audioTime":80,"title":"The armies converged on Spotsylvania","detail":"Lee’s troops had stopped Warren’s V Corps at Laurel Hill on May 8. Meade brought Sedgwick’s VI Corps forward for another attack."},{"time":"3:15","audioTime":195,"title":"The evening attack on May 8 failed","detail":"Only one V Corps division and one VI Corps brigade advanced. Other units missed their orders, some troops became lost, and a Confederate counterattack ended the effort."},{"time":"5:35","audioTime":335,"title":"Both armies extended their lines","detail":"Anderson held the Confederate left, Ewell the center, and A. P. Hill’s corps the right. U.S. corps formed north and west of the Confederate semicircle around the courthouse."},{"time":"6:27","audioTime":387,"title":"Edward Johnson created the Mule Shoe","detail":"He placed his division along a low ridge that projected north from the main line. The resulting salient lengthened the defenses and could be attacked from three sides."},{"time":"7:28","audioTime":448,"title":"Lee accepted the salient after engineer review","detail":"Lee disliked the shape, but engineers advised that concentrated artillery could defend it."},{"time":"8:19","audioTime":499,"title":"John Sedgwick was killed on May 9","detail":"A Confederate sharpshooter shot the VI Corps commander while he inspected the line near Brock Road. Horatio Wright succeeded him."},{"time":"9:34","audioTime":574,"title":"Jubal Early temporarily replaced A. P. Hill","detail":"Hill was ill and asked to leave command. Lee transferred Early from Ewell’s corps to lead the Third Corps."},{"time":"10:17","audioTime":617,"title":"Lee and Grant assessed the new position","detail":"Lee intended to remain between Grant and Richmond without accepting an unnecessary general battle. Grant still sought direct contact with Lee’s army away from Richmond’s defenses."},{"time":"12:15","audioTime":735,"title":"Grant ordered reconnaissance of both Confederate flanks","detail":"Hancock was sent toward the Confederate left and Burnside toward the right. Reports from Burnside’s sector led Meade and Grant to different conclusions about Lee’s intentions."},{"time":"13:17","audioTime":797,"title":"Grant ordered Hancock across the Po River","detail":"Grant believed the Confederate left might be weak. II Corps crossed west of Laurel Hill and moved toward Blockhouse Bridge."},{"time":"15:00","audioTime":900,"title":"Hancock planned a May 10 attack toward Laurel Hill","detail":"He intended to cross at Blockhouse Bridge from the west while Warren attacked from the north, but new Confederate works blocked the crossing by morning."},{"time":"16:17","audioTime":977,"title":"Lee prepared to strike Hancock’s isolated corps","detail":"William Mahone faced Hancock near Blockhouse Bridge while Henry Heth moved around the U.S. position to attack from the south."},{"time":"18:24","audioTime":1104,"title":"Grant changed to a general attack","detail":"Grant assumed Lee had weakened Laurel Hill to attack Hancock and ordered the main Confederate line assaulted at 5 p.m."},{"time":"19:53","audioTime":1193,"title":"Heth attacked Barlow at 2:30 p.m.","detail":"Confederate infantry and artillery struck the II Corps rear guard south of the Po while Barlow’s division withdrew toward its crossings."},{"time":"21:05","audioTime":1265,"title":"Fire endangered the II Corps rear guard","detail":"Burning woods forced the remaining U.S. troops to run roughly 1,000 yards through smoke to the Po River. Hancock’s corps escaped destruction."},{"time":"21:49","audioTime":1309,"title":"Warren attacked Laurel Hill early","detail":"He argued the position was vulnerable and received permission to move before the coordinated assault. The attack was repulsed and delayed the larger plan."},{"time":"22:38","audioTime":1358,"title":"Mott attacked at the original time","detail":"His division did not receive the delay notice. Only about 1,250 men were available after maintaining the long skirmish line between VI and IX Corps."},{"time":"23:53","audioTime":1433,"title":"Confederate artillery broke Mott’s attack","detail":"The small force crossed an open glade toward the Mule Shoe and came under canister at about 400 yards. It withdrew without reaching the works."},{"time":"24:56","audioTime":1496,"title":"Wright sent a twelve-regiment task force","detail":"David Russell and engineer Ranald Mackenzie identified a wooded approach. Russell selected Emory Upton to command regiments drawn from all three VI Corps divisions."},{"time":"27:08","audioTime":1628,"title":"Upton assigned four attack lines","detail":"The first would breach and clear the works laterally, the second would hold the opening and fire toward the salient’s base, the third would wait for orders, and the fourth remained in reserve."},{"time":"28:10","audioTime":1690,"title":"Upton prohibited firing during the advance","detail":"He believed stopping to load and shoot would destroy the assault’s momentum. The column was to cross the open ground with fixed bayonets and fire only after entering the works."},{"time":"29:19","audioTime":1759,"title":"Upton attacked at 6:35 p.m.","detail":"About 5,000 soldiers moved from the woods, crossed the abatis, absorbed two Confederate volleys without stopping, and broke through the earthworks."},{"time":"30:31","audioTime":1831,"title":"Confederate artillery stopped firing","detail":"Gunners mistook Confederate prisoners moving with Upton’s troops for a counterattack. The pause helped the U.S. column deepen its penetration."},{"time":"30:52","audioTime":1852,"title":"Ewell contained the breakthrough","detail":"He sent reinforcements into the salient while Upton reorganized. Mott had already been repulsed and Wright did not send sufficient additional troops."},{"time":"32:30","audioTime":1950,"title":"Upton withdrew from the salient","detail":"His troops fell back to the exterior of the works and fought off a Confederate counterattack. Russell then authorized a full withdrawal."},{"time":"33:11","audioTime":1991,"title":"The 7 p.m. attacks at Laurel Hill failed","detail":"Warren made only a limited effort. Gibbon’s division did not advance, and J. Hobart Ward’s brigade briefly entered the Confederate line before being driven back."},{"time":"34:52","audioTime":2092,"title":"Four uncoordinated attacks produced no lasting gain","detail":"The attacks by Barlow’s rear guard, Warren, Mott, and Upton occurred separately, allowing Lee to move troops against each one."},{"time":"36:20","audioTime":2180,"title":"Grant believed Lee’s army was weakening","detail":"Grant estimated U.S. losses since crossing the Rapidan at about 20,000 but thought Confederate losses were proportionally worse."},{"time":"37:10","audioTime":2230,"title":"Grant promised to continue the campaign","detail":"In his May 11 dispatch to Henry Halleck, he wrote that he intended to fight on the current line through the summer if necessary."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"Ulysses S. Grant and George G. Meade","command":"Overall command","subordinates":"Ordered reconnaissance and the May 10 general assault"},{"commander":"Winfield Scott Hancock","command":"II Corps","subordinates":"Francis Barlow, John Gibbon, David Birney, and Gershom Mott’s divisions"},{"commander":"Gouverneur K. Warren","command":"V Corps","subordinates":"Repeatedly attacked the Confederate defenses at Laurel Hill"},{"commander":"John Sedgwick; then Horatio G. Wright","command":"VI Corps","subordinates":"David Russell’s division and Emory Upton’s twelve-regiment assault column"},{"commander":"David A. Russell","command":"1st Division, VI Corps","subordinates":"Selected Upton to lead the attack on the Mule Shoe"},{"commander":"Emory Upton","command":"Special assault column","subordinates":"Twelve regiments arranged in four lines with separate assignments"},{"commander":"Ambrose E. Burnside","command":"IX Corps","subordinates":"Reconnoitered and attacked east of the Mule Shoe"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Robert E. Lee","command":"Army of Northern Virginia","subordinates":"Held the Spotsylvania crossroads and shifted forces against separate U.S. attacks"},{"commander":"Richard H. Anderson","command":"First Corps","subordinates":"Defended Laurel Hill and the Confederate left"},{"commander":"Richard S. Ewell","command":"Second Corps","subordinates":"Edward Johnson’s division held the Mule Shoe and counterattacked Upton"},{"commander":"Jubal A. Early","command":"Temporary Third Corps commander","subordinates":"Replaced the ill A. P. Hill; William Mahone and Henry Heth operated against Hancock"},{"commander":"Edward Johnson","command":"Division in the Mule Shoe","subordinates":"Selected the ridge that formed the salient and defended its western face"},{"commander":"William Mahone and Henry Heth","command":"Third Corps divisions","subordinates":"Mahone held Blockhouse Bridge while Heth attacked Barlow south of the Po"}]}],"people":[{"name":"Emory Upton","role":"Designed and led the column attack that broke the Mule Shoe defenses on May 10","side":"United States","image":"/images/emory-upton.jpg","source":"https://www.loc.gov/item/2018666506/"},{"name":"John Sedgwick","role":"VI Corps commander killed by a Confederate sharpshooter on May 9","side":"United States","image":"/images/john-sedgwick.jpg","source":"https://www.loc.gov/item/2018666485/"},{"name":"Horatio G. Wright","role":"Succeeded Sedgwick and authorized Upton’s attack but committed almost no reinforcement to the breakthrough","side":"United States"},{"name":"Gouverneur K. Warren","role":"Commanded the repeated and unsuccessful V Corps attacks against Laurel Hill","side":"United States"},{"name":"Robert E. Lee","role":"Retained Spotsylvania, countered Hancock south of the Po, and shifted troops against the separate U.S. attacks","side":"Confederacy","image":"/images/robert-e-lee-1864.jpg","source":"https://www.loc.gov/item/2017897216/"},{"name":"Richard S. Ewell","role":"Reinforced the breach and drove Upton’s unsupported force back out of the Mule Shoe","side":"Confederacy"},{"name":"Edward Johnson","role":"Placed his division on the ridge that created the Mule Shoe salient","side":"Confederacy","image":"/images/edward-johnson.jpg","source":"https://www.loc.gov/item/2018670430/"},{"name":"Henry Heth","role":"Led the Confederate attack that forced Barlow’s division back across the Po River","side":"Confederacy"}],"losses":[{"name":"John Sedgwick","side":"United States","role":"Major general commanding VI Corps","outcome":"Killed by a Confederate sharpshooter near Brock Road on May 9; Horatio Wright immediately succeeded him"}],"gallery":[{"image":"/images/upton-at-salient-drawing.jpg","alt":"Alfred Waud drawing titled Upton at the Salient","caption":"Alfred Waud’s May 10 field drawing shows Upton directing soldiers inside the attack formation.","source":"https://www.loc.gov/item/2004660945/"},{"image":"/images/emory-upton.jpg","alt":"Portrait of Emory Upton in U.S. Army uniform","caption":"Upton divided twelve regiments into four lines, assigned each a specific job, and ordered the troops not to fire until they reached the works.","source":"https://www.loc.gov/item/2018666506/"},{"image":"/images/john-sedgwick.jpg","alt":"Portrait of Major General John Sedgwick","caption":"Sedgwick’s death on May 9 removed one of the Army of the Potomac’s most experienced corps commanders.","source":"https://www.loc.gov/item/2018666485/"},{"image":"/images/spotsylvania-may10-nps-map.png","alt":"Map of troop positions and attacks at Spotsylvania on May 10","caption":"The map shows why the attacks were difficult to coordinate: Hancock was south of the Po while Warren, Upton, and Burnside faced different parts of the Confederate line.","source":"https://www.nps.gov/npgallery/GetAsset/2c2aabb1-f490-46d2-b906-4cd75ba49bbd"}],"sources":[{"label":"Civil War Podcast, episode 485","url":"https://civilwarpodcast.org/2025/03/23/civil-war-podcast-episode-485/"},{"label":"National Park Service: history of Spotsylvania Court House","url":"https://www.nps.gov/frsp/learn/historyculture/spotsylvania.htm"},{"label":"National Park Service: Spotsylvania battlefield tour","url":"https://www.nps.gov/frsp/learn/photosmultimedia/spotsylvania-battlefield-tour.htm"},{"label":"National Park Service: May 10 troop-position map","url":"https://www.nps.gov/npgallery/GetAsset/2c2aabb1-f490-46d2-b906-4cd75ba49bbd"},{"label":"Library of Congress: Upton at the Salient","url":"https://www.loc.gov/item/2004660945/"},{"label":"Library of Congress: Emory Upton portrait","url":"https://www.loc.gov/item/2018666506/"},{"label":"Library of Congress: John Sedgwick portrait","url":"https://www.loc.gov/item/2018666485/"}]}}]}],"$L10",false,"$L11","$L12","$L13","$L14","$L15","$L16"]}]]}]
