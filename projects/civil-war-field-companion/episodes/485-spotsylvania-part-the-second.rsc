"}],["$","span",null,{"children":"Richard H. Anderson"}],["$","small",null,{"children":"Defended Laurel Hill and the Confederate left"}]]}],"$L19","$L1a","$L1b","$L1c"]]}]]}],"$L1d"]]]}]
