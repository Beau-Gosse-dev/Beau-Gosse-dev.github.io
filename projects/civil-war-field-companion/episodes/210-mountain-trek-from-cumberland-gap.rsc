2c:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
2e:["$","div","Morgan convenes a council of war",{"className":"moment","children":[["$","$L2d",null,{"seconds":542,"label":"9:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Morgan convenes a council of war"}],["$","p",null,{"children":"On September 14, his senior officers agreed with engineer William Craighill that Cumberland Gap must be evacuated."}]]}]]}]
2f:["$","div","The mountain route is chosen",{"className":"moment","children":[["$","$L2d",null,{"seconds":562,"label":"9:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The mountain route is chosen"}],["$","p",null,{"children":"A westward march risked Kirby Smith’s entire army, so Morgan chose the rugged road north toward the Ohio River."}]]}]]}]
30:["$","div","Evacuation orders go out",{"className":"moment","children":[["$","$L2d",null,{"seconds":606,"label":"10:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Evacuation orders go out"}],["$","p",null,{"children":"The garrison prepared to move on September 17 and to destroy everything that could not accompany the column."}]]}]]}]
31:["$","div","The garrison prepares in secrecy",{"className":"moment","children":[["$","$L2d",null,{"seconds":632,"label":"10:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"The garrison prepares in secrecy"}],["$","p",null,{"children":"Soldiers packed wagons, readied buildings for destruction, and spiked four heavy cannon that could not be moved."}]]}]]}]
32:["$","div","The Seventh Division marches out",{"className":"moment","children":[["$","$L2d",null,{"seconds":675,"label":"11:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Seventh Division marches out"}],["$","p",null,{"children":"At 8 p.m. on September 17 the main body started for Manchester, with Spears’s East Tennessee regiments among the last to depart."}]]}]]}]
33:["$","div","Gallup’s rear guard remains behind",{"className":"moment","children":[["$","$L2d",null,{"seconds":688,"label":"11:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Gallup’s rear guard remains behind"}],["$","p",null,{"children":"Two hundred selected soldiers stayed to burn buildings and protect the withdrawal until the rest of the column was clear."}]]}]]}]
34:["$","div","The Confederates detect the evacuation",{"className":"moment","children":[["$","$L2d",null,{"seconds":715,"label":"11:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederates detect the evacuation"}],["$","p",null,{"children":"Confederate probes moved toward the Gap, but Gallup’s pickets held them back while the fires spread through the post."}]]}]]}]
35:["$","div","Craighill fires the mines",{"className":"moment","children":[["$","$L2d",null,{"seconds":723,"label":"12:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Craighill fires the mines"}],["$","p",null,{"children":"Explosions wrecked forts and magazines and blocked the road from the south before the final detachment marched away near dawn."}]]}]]}]
36:["$","div","The division reaches Manchester",{"className":"moment","children":[["$","$L2d",null,{"seconds":816,"label":"13:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The division reaches Manchester"}],["$","p",null,{"children":"By September 19 the whole force and its 500 wagons had completed the first sixty miles, though Confederate cavalry remained close behind."}]]}]]}]
37:["$","div","Kirby Smith reacts from Lexington",{"className":"moment","children":[["$","$L2d",null,{"seconds":869,"label":"14:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kirby Smith reacts from Lexington"}],["$","p",null,{"children":"Smith sent Cleburne west, recalled Heth toward Mount Sterling, ordered John Hunt Morgan to Irvine, and told Stevenson to pursue from the Gap."}]]}]]}]
38:["$","div","Smith predicts the wrong destination",{"className":"moment","children":[["$","$L2d",null,{"seconds":948,"label":"15:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith predicts the wrong destination"}],["$","p",null,{"children":"Expecting George Morgan to move toward Richmond and Lexington, Smith concentrated forces northwest of Proctor rather than on the road to the Ohio."}]]}]]}]
39:["$","div","The bridge at Proctor is intact",{"className":"moment","children":[["$","$L2d",null,{"seconds":973,"label":"16:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"The bridge at Proctor is intact"}],["$","p",null,{"children":"On September 21 the United States column crossed the Kentucky River without opposition, escaping a position that Morgan expected to be dangerous."}]]}]]}]
3a:["$","div","A Confederate order has cleared the crossing",{"className":"moment","children":[["$","$L2d",null,{"seconds":1022,"label":"17:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"A Confederate order has cleared the crossing"}],["$","p",null,{"children":"Sending John Hunt Morgan to Irvine had moved the cavalry twenty-six miles away and cost the Confederates their first strong chance to stop the column."}]]}]]}]
3b:["$","div","The trek resumes toward Hazel Green",{"className":"moment","children":[["$","$L2d",null,{"seconds":1035,"label":"17:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The trek resumes toward Hazel Green"}],["$","p",null,{"children":"John Hunt Morgan hurried back and began harassing the flanks and rear while the soldiers struggled over dry ridges and ruined roads."}]]}]]}]
3c:["$","div","Hazel Green offers a day of rest",{"className":"moment","children":[["$","$L2d",null,{"seconds":1103,"label":"18:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hazel Green offers a day of rest"}],["$","p",null,{"children":"The division arrived September 23 and halted before the next twelve-mile leg to West Liberty."}]]}]]}]
3d:["$","div","Confederate attacks intensify",{"className":"moment","children":[["$","$L2d",null,{"seconds":1111,"label":"18:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate attacks intensify"}],["$","p",null,{"children":"Cavalry struck the rear near West Liberty, killed six men of the Sixth Tennessee, and scattered part of the cattle herd."}]]}]]}]
3e:["$","div","The hardest forty-three miles begin",{"className":"moment","children":[["$","$L2d",null,{"seconds":1146,"label":"19:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The hardest forty-three miles begin"}],["$","p",null,{"children":"Between West Liberty and Grayson, Confederate cavalry blocked narrow roads with rocks and felled trees and prepared repeated ambushes."}]]}]]}]
3f:["$","div","The two Morgans contest every defile",{"className":"moment","children":[["$","$L2d",null,{"seconds":1175,"label":"19:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"The two Morgans contest every defile"}],["$","p",null,{"children":"As George Morgan cleared one end of a gorge, John Hunt Morgan obstructed the other. A thousand soldiers labored with axes, saws, picks, spades, and tackle."}]]}]]}]
40:["$","div","The column reaches Grayson",{"className":"moment","children":[["$","$L2d",null,{"seconds":1239,"label":"20:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The column reaches Grayson"}],["$","p",null,{"children":"Five days of obstruction and skirmishing ended on October 1, when the United States division entered Grayson and the Confederate cavalry was recalled."}]]}]]}]
41:["$","div","The Ohio River means safety",{"className":"moment","children":[["$","$L2d",null,{"seconds":1255,"label":"20:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Ohio River means safety"}],["$","p",null,{"children":"On October 3 the column reached Greenupsburg and crossed into Ohio, beyond the Confederate pursuit."}]]}]]}]
42:["$","div","The march is measured",{"className":"moment","children":[["$","$L2d",null,{"seconds":1280,"label":"21:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"The march is measured"}],["$","p",null,{"children":"In sixteen days the Seventh Division covered 219 miles through eastern Kentucky’s mountains despite hunger, bad roads, and continual harassment."}]]}]]}]
43:["$","div","Morgan saves the train",{"className":"moment","children":[["$","$L2d",null,{"seconds":1307,"label":"21:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Morgan saves the train"}],["$","p",null,{"children":"The episode reports eighty men killed, wounded, or missing, but every mobile gun and all the army’s wagons and baggage reached the Ohio."}]]}]]}]
44:["$","div","The episode recommends McKnight",{"className":"moment","children":[["$","$L2d",null,{"seconds":1339,"label":"22:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode recommends McKnight"}],["$","p",null,{"children":"Contested Borderland examines both military operations and divided civilian communities in Appalachian Kentucky and Virginia."}]]}]]}]
45:["$","div","Second Division-Brig. Gen. Henry Heth",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Division"}],["$","span",null,{"children":"Brig. Gen. Henry Heth"}],["$","small",null,{"children":"Probed the Cincinnati defenses with about 6,000 men, then was recalled through Lexington toward Mount Sterling."}]]}]
46:["$","div","Fourth Division-Brig. Gen. Patrick R. Cleburne",{"className":"command-entry","children":[["$","strong",null,{"children":"Fourth Division"}],["$","span",null,{"children":"Brig. Gen. Patrick R. Cleburne"}],["$","small",null,{"children":"Recovered from his Richmond wound and was sent west toward Shelbyville and Louisville rather than against the escaping garrison."}]]}]
47:["$","div","Cavalry command-Col. John Hunt Morgan",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry command"}],["$","span",null,{"children":"Col. John Hunt Morgan"}],["$","small",null,{"children":"Moved first to Irvine under Kirby Smith’s mistaken order, then harassed the column from Proctor toward Grayson with attacks and roadblocks."}]]}]
