1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",210," · ","August 20–October 3, 1862"," · ","Cumberland Gap and the mountain roads of eastern Kentucky from Manchester through Proctor, Hazel Green, West Liberty, and Grayson to Greenupsburg on the Ohio River"]}],["$","h1",null,{"children":"MOUNTAIN TREK FROM CUMBERLAND GAP"}],["$","span",null,{"className":"result-label","children":"Successful United States evacuation. Brig. Gen. George W. Morgan surrendered the strategic Cumberland Gap and destroyed stores and fixed defenses that he could not remove, but brought roughly 7,000 soldiers, about 500 wagons, every mobile gun, and the army’s baggage to the Ohio River after a 219-mile, sixteen-day march. Confederate forces occupied the Gap and harassed the column but failed to trap or destroy the Seventh Division"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9655463987.mp3?updated=1695589109","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The siege, evacuation, and mountain retreat from Cumberland Gap"}],["$","small",null,{"children":"The episode first surveys Confederate pressure on Cincinnati and Louisville, then follows George W. Morgan’s isolated division from the September 14 evacuation decision to its October 3 arrival at the Ohio River."}]]}],["$","div","Strategic setting",{"children":[["$","span",null,{"children":"Strategic setting"}],["$","strong",null,{"children":"Two Confederate armies were operating in Kentucky"}],["$","small",null,{"children":"Braxton Bragg moved northeast from Munfordville while Edmund Kirby Smith occupied Lexington and sent detachments toward Cincinnati and Louisville. Their movements isolated the United States garrison at Cumberland Gap."}]]}],["$","div","Cincinnati alarm",{"children":[["$","span",null,{"children":"Cincinnati alarm"}],["$","strong",null,{"children":"Henry Heth remained south of the city until September 18"}],["$","small",null,{"children":"Heth probed the defenses with about 6,000 Confederates but did not assault. Thousands of civilians prepared defenses on both sides of the Ohio River."}]]}],["$","div","The Black Brigade",{"children":[["$","span",null,{"children":"The Black Brigade"}],["$","strong",null,{"children":"More than 700 Black Cincinnatians built defenses"}],["$","small",null,{"children":"After an initial forced roundup, the men were permitted to volunteer and organized as the Black Brigade of Cincinnati. They worked on fortifications in northern Kentucky without arms or uniforms."}]]}],["$","div","Emergency command at Louisville",{"children":[["$","span",null,{"children":"Emergency command at Louisville"}],["$","strong",null,{"children":"Capt. Charles C. Gilbert became an acting major general"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}],"$L26","$undefined","$L27",false,"$L28",false,"$L29","$L2a","$L2b"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","small",null,{"children":"Department commander Horatio G. Wright promoted the forty-year-old Regular Army captain without statutory authority and placed him over the city’s defenses. More than 20,000 United States troops were present by mid-September."}]
f:["$","div","Garrison",{"children":[["$","span",null,{"children":"Garrison"}],["$","strong",null,{"children":"About 7,000 soldiers in the Seventh Division"}],["$","small",null,{"children":"George W. Morgan’s division comprised four brigades under Samuel P. Carter, James G. Spears, John F. De Courcy, and Absalom Baird. Many soldiers in the Tennessee regiments were East Tennessee Unionists."}]]}]
10:["$","div","A three-state fortress",{"children":[["$","span",null,{"children":"A three-state fortress"}],["$","strong",null,{"children":"Kentucky, Tennessee, and Virginia met at the Gap"}],["$","small",null,{"children":"Fortifications crowned the heights above the Wilderness Road. Depending on his post, a soldier could be standing in any one of the three states."}]]}]
11:["$","div","Investment",{"children":[["$","span",null,{"children":"Investment"}],["$","strong",null,{"children":"Carter L. Stevenson’s division watched the Gap"}],["$","small",null,{"children":"Kirby Smith bypassed the fortress during his advance into Kentucky and left roughly 9,000 men under Stevenson. The Confederate ring was strongest south of the Gap and too weak for a direct assault."}]]}]
12:["$","div","Communications",{"children":[["$","span",null,{"children":"Communications"}],["$","strong",null,{"children":"Couriers replaced the telegraph"}],["$","small",null,{"children":"The isolated garrison communicated with Cincinnati over lightly guarded mountain roads. Delays made both relief and reliable strategic direction difficult."}]]}]
13:["$","div","Supply crisis",{"children":[["$","span",null,{"children":"Supply crisis"}],["$","strong",null,{"children":"Bread gone September 6; animal forage nearly gone September 12"}],["$","small",null,{"children":"A 150-wagon convoy had arrived on August 19, but Morgan immediately imposed half rations. Loss of the horses and mules would have immobilized the artillery and wagon train."}]]}]
14:["$","div","Decision to evacuate",{"children":[["$","span",null,{"children":"Decision to evacuate"}],["$","strong",null,{"children":"Council of war, September 14"}],["$","small",null,{"children":"Morgan met Baird, Spears, Carter, and chief engineer Lt. William P. Craighill. All accepted Craighill’s conclusion that the post should be abandoned."}]]}]
15:["$","div","The chosen route",{"children":[["$","span",null,{"children":"The chosen route"}],["$","strong",null,{"children":"North through the mountains rather than west toward Lexington"}],["$","small",null,{"children":"The Wilderness Road led toward Kirby Smith’s main army. The alternative promised about 200 miles of poor roads, scarce food and forage, and easily blocked defiles, but it led away from the largest Confederate concentrations."}]]}]
16:["$","div","Evacuation order",{"children":[["$","span",null,{"children":"Evacuation order"}],["$","strong",null,{"children":"Move on September 17; destroy what could not be carried"}],["$","small",null,{"children":"An advance wagon train left on the evening of September 16. The main body departed at 8 p.m. the next day, with Spears’s East Tennessee regiments among the last troops to leave."}]]}]
17:["$","div","Rear guard",{"children":[["$","span",null,{"children":"Rear guard"}],["$","strong",null,{"children":"About 200 selected soldiers under Col. George W. Gallup"}],["$","small",null,{"children":"Gallup’s detachment held back Confederate probes and burned post buildings. The fires illuminated the valley as the division moved north."}]]}]
18:["$","div","Demolition",{"children":[["$","span",null,{"children":"Demolition"}],["$","strong",null,{"children":"Fixed guns, forts, magazines, and the south road disabled"}],["$","small",null,{"children":"Four heavy cannon were spiked and pushed over a cliff. Craighill’s engineers exploded magazines and fortifications and blocked the road through the pass to delay pursuit."}]]}]
19:["$","div","First rendezvous",{"children":[["$","span",null,{"children":"First rendezvous"}],["$","strong",null,{"children":"Manchester, September 19"}],["$","small",null,{"children":"The entire division and approximately 500 wagons gathered after a sixty-mile first leg. The column paused briefly to reorganize before turning toward the Kentucky River."}]]}]
1a:["$","div","Kirby Smith’s wrong assumption",{"children":[["$","span",null,{"children":"Kirby Smith’s wrong assumption"}],["$","strong",null,{"children":"He expected a move toward Richmond and Lexington"}],["$","small",null,{"children":"Smith sent Heth toward Mount Sterling and John Hunt Morgan toward Irvine, concentrating northwest of the actual route. This left the critical Kentucky River crossing at Proctor unopposed."}]]}]
1b:["$","div","Proctor crossing",{"children":[["$","span",null,{"children":"Proctor crossing"}],["$","strong",null,{"children":"September 21"}],["$","small",null,{"children":"The bridge over the Kentucky River was intact even though John Hunt Morgan’s cavalry had passed through the previous night. George Morgan sent a brigade and battery across before resting the column."}]]}]
1c:["$","div","Two roads to Hazel Green",{"children":[["$","span",null,{"children":"Two roads to Hazel Green"}],["$","strong",null,{"children":"The division split between the Ridge and North Fork roads"}],["$","small",null,{"children":"George Morgan’s published account places De Courcy and Spears on the dry Ridge Road and Baird and Carter with the wagon train on the damaged but water-rich North Fork Road."}]]}]
1d:["$","div","Hazel Green",{"children":[["$","span",null,{"children":"Hazel Green"}],["$","strong",null,{"children":"Reached September 23"}],["$","small",null,{"children":"The half-famished troops and animals halted for a full day before continuing twelve miles toward West Liberty."}]]}]
1e:["$","div","Rear-guard attack",{"children":[["$","span",null,{"children":"Rear-guard attack"}],["$","strong",null,{"children":"Six United States soldiers killed before West Liberty"}],["$","small",null,{"children":"Confederate cavalry struck the Sixth Tennessee Infantry at the rear and scattered roughly eighty to one hundred cattle before being driven away."}]]}]
1f:["$","div","West Liberty to Grayson",{"children":[["$","span",null,{"children":"West Liberty to Grayson"}],["$","strong",null,{"children":"Forty-three miles through a cavalry gauntlet"}],["$","small",null,{"children":"John Hunt Morgan’s horsemen moved ahead of the column, felled trees, rolled rocks into defiles, destroyed forage, and prepared ambushes."}]]}]
20:["$","div","Road-clearing force",{"children":[["$","span",null,{"children":"Road-clearing force"}],["$","strong",null,{"children":"About 1,000 soldiers with tools and block and tackle"}],["$","small",null,{"children":"The pioneers cleared repeated obstructions. At one blockade they cut four miles of new road through forest to bypass a one-mile section."}]]}]
21:["$","div","Final stages",{"children":[["$","span",null,{"children":"Final stages"}],["$","strong",null,{"children":"Grayson October 1; Greenupsburg October 3"}],["$","small",null,{"children":"John Hunt Morgan was recalled after the column reached Grayson. Two days later the Seventh Division crossed the Ohio River to safety."}]]}]
22:["$","div","March total",{"children":[["$","span",null,{"children":"March total"}],["$","strong",null,{"children":"219 miles in sixteen days"}],["$","small",null,{"children":"The division emerged with every mobile gun and wagon and all of its baggage. The episode reports eighty men killed, wounded, or missing during the retreat."}]]}]
23:["$","div","No senior leader casualty",{"children":[["$","span",null,{"children":"No senior leader casualty"}],["$","strong",null,{"children":"No important commander was killed or mortally wounded"}],["$","small",null,{"children":"The operation’s losses fell among the marching columns and rear guards; the episode identifies no senior United States or Confederate leader killed or mortally wounded during the evacuation."}]]}]
24:["$","div","Transcript corrections",{"children":[["$","span",null,{"children":"Transcript corrections"}],["$","strong",null,{"children":"Bull Nelson; Henry Heth; Patrick Cleburne; John F. De Courcy; William P. Craighill; provost marshal"}],["$","small",null,{"children":"The automated transcript gives “Buell Nelson,” “Henry Heath,” “Patrick Clayburn,” “D’Corsese,” “Craig Hill,” and “post-provo-martial.” It also garbles the brigade split north of Proctor: Morgan’s account places De Courcy and Spears on the Ridge Road and Baird and Carter with the wagon train on the North Fork Road."}]]}]
25:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"Contested Borderland: The Civil War in Appalachian Kentucky and Virginia"}],["$","small",null,{"children":"Brian D. McKnight’s study was published by the University Press of Kentucky. The transcript substitutes “in” for “and” in the subtitle."}]]}]
26:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
27:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The mountain trek to the Ohio River",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep210-cumberland-gap-retreat-map.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The mountain trek to the Ohio River at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep210-cumberland-gap-retreat-map.svg","alt":"North-up schematic map of the United States Seventh Division retreat from Cumberland Gap to Greenupsburg on the Ohio River, with dated stops and Confederate pursuit routes.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The mountain trek to the Ohio River"}],["$","span",null,{"children":"North-up schematic of the Seventh Division’s route from Cumberland Gap through Manchester, Proctor, Hazel Green, West Liberty, and Grayson to Greenupsburg. The red movements show Stevenson’s pursuit and John Hunt Morgan’s cavalry moving from Irvine to the column’s flank and front. Town positions and the exact road trace are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep210-cumberland-gap-retreat-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Custom diagram based on George W. Morgan’s published account, the Official Records, and the Library of Congress map of Seventh Division operations; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
28:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States — Department of the Ohio",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States — Department of the Ohio"}],[["$","div","Department of the Ohio-Maj. Gen. Horatio G. Wright",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Ohio"}],["$","span",null,{"children":"Maj. Gen. Horatio G. Wright"}],["$","small",null,{"children":"Directed the regional response from Cincinnati and authorized emergency defensive arrangements at Cincinnati and Louisville."}]]}],["$","div","Seventh Division, Army of the Ohio-Brig. Gen. George W. Morgan",{"className":"command-entry","children":[["$","strong",null,{"children":"Seventh Division, Army of the Ohio"}],["$","span",null,{"children":"Brig. Gen. George W. Morgan"}],["$","small",null,{"children":"Commanded roughly 7,000 soldiers at Cumberland Gap, chose the Ohio River route, and controlled the sixteen-day evacuation."}]]}],["$","div","Twenty-fourth Brigade-Brig. Gen. Samuel P. Carter",{"className":"command-entry","children":[["$","strong",null,{"children":"Twenty-fourth Brigade"}],["$","span",null,{"children":"Brig. Gen. Samuel P. Carter"}],["$","small",null,{"children":"Included the 49th Indiana, 3rd Kentucky, and 1st and 2nd Tennessee Infantry; accompanied the wagon train on the North Fork Road."}]]}],["$","div","Twenty-fifth Brigade-Brig. Gen. James G. Spears",{"className":"command-entry","children":[["$","strong",null,{"children":"Twenty-fifth Brigade"}],["$","span",null,{"children":"Brig. Gen. James G. Spears"}],["$","small",null,{"children":"East Tennessee infantry brigade, including the 3rd, 4th, 5th, and 6th Tennessee; marched on the Ridge Road north of Proctor."}]]}],["$","div","Twenty-sixth Brigade-Col. John F. De Courcy",{"className":"command-entry","children":[["$","strong",null,{"children":"Twenty-sixth Brigade"}],["$","span",null,{"children":"Col. John F. De Courcy"}],["$","small",null,{"children":"Included the 22nd Kentucky and 16th and 42nd Ohio Infantry; marched on the Ridge Road north of Proctor."}]]}],["$","div","Twenty-seventh Brigade-Brig. Gen. Absalom Baird",{"className":"command-entry","children":[["$","strong",null,{"children":"Twenty-seventh Brigade"}],["$","span",null,{"children":"Brig. Gen. Absalom Baird"}],["$","small",null,{"children":"Included the 33rd Indiana and 14th and 19th Kentucky Infantry; helped protect and move the wagon train on the North Fork Road."}]]}],["$","div","Chief engineer-Lt. William P. Craighill",{"className":"command-entry","children":[["$","strong",null,{"children":"Chief engineer"}],["$","span",null,{"children":"Lt. William P. Craighill"}],["$","small",null,{"children":"Advised evacuation, demolished the fixed defenses and magazines, and blocked the road through the pass."}]]}]]]}],["$","section","Confederacy — Department of East Tennessee and Army of Kentucky",{"className":"command-column #963b31","children":[["$","h3",null,{"children":"Confederacy — Department of East Tennessee and Army of Kentucky"}],["$L2c","$L2d","$L2e","$L2f","$L30"]]}]]}],"$L31"]]]}]
29:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep210-cumberland-gap-retreat-map.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep210-cumberland-gap-retreat-map.svg","alt":"Schematic map of George W. Morgan’s route across eastern Kentucky from Cumberland Gap to the Ohio River.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Morgan avoided the direct road toward Lexington, crossed the Kentucky River at Proctor, and kept moving northeast while Confederate cavalry attacked the column and blocked mountain defiles."}]]}],["$","figure","/images/ep210-cumberland-gap-evacuation.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep210-cumberland-gap-evacuation.jpg","alt":"Nineteenth-century tinted lithograph showing troops and wagons leaving burning buildings at Cumberland Gap.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This contemporary print depicts an army and wagon train departing Cumberland Gap while buildings burn. The Library of Congress catalog describes it as possibly representing the sudden United States withdrawal."}]]}],["$","figure","/images/ep210-george-w-morgan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep210-george-w-morgan.jpg","alt":"Carte-de-visite portrait of United States Brigadier General George Washington Morgan in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"George W. Morgan chose the difficult northern route and preserved the Seventh Division, its mobile guns, and its wagon train during the sixteen-day retreat."}]]}],["$","figure","/images/ep210-john-hunt-morgan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep210-john-hunt-morgan.jpg","alt":"Postwar ink portrait of Confederate cavalry commander John Hunt Morgan.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"John Hunt Morgan reached Proctor too late to contest the Kentucky River crossing, then used attacks, ambushes, felled trees, and rocks to slow the United States column."}]]}]]}]]}]
