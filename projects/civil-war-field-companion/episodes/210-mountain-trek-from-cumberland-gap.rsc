2c:["$","div","Army of Kentucky-Maj. Gen. Edmund Kirby Smith",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Kentucky"}],["$","span",null,{"children":"Maj. Gen. Edmund Kirby Smith"}],["$","small",null,{"children":"Directed Confederate forces in eastern and north-central Kentucky but initially misread George Morgan’s route as a move toward Lexington."}]]}]
2d:["$","div","Division investing Cumberland Gap-Brig. Gen. Carter L. Stevenson",{"className":"command-entry","children":[["$","strong",null,{"children":"Division investing Cumberland Gap"}],["$","span",null,{"children":"Brig. Gen. Carter L. Stevenson"}],["$","small",null,{"children":"Maintained the siege with roughly 9,000 men and pursued north after the rear guard destroyed the post."}]]}]
2e:["$","div","Second Division-Brig. Gen. Henry Heth",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Division"}],["$","span",null,{"children":"Brig. Gen. Henry Heth"}],["$","small",null,{"children":"Probed the Cincinnati defenses with about 6,000 men, then was recalled through Lexington toward Mount Sterling."}]]}]
2f:["$","div","Fourth Division-Brig. Gen. Patrick R. Cleburne",{"className":"command-entry","children":[["$","strong",null,{"children":"Fourth Division"}],["$","span",null,{"children":"Brig. Gen. Patrick R. Cleburne"}],["$","small",null,{"children":"Recovered from his Richmond wound and was sent west toward Shelbyville and Louisville rather than against the escaping garrison."}]]}]
30:["$","div","Cavalry command-Col. John Hunt Morgan",{"className":"command-entry","children":[["$","strong",null,{"children":"Cavalry command"}],["$","span",null,{"children":"Col. John Hunt Morgan"}],["$","small",null,{"children":"Moved first to Irvine under Kirby Smith’s mistaken order, then harassed the column from Proctor toward Grayson with attacks and roadblocks."}]]}]
