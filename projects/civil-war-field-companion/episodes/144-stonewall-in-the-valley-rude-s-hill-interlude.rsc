1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",144," · ","March 27–May 1, 1862"," · ","The Shenandoah Valley from Winchester and Stony Creek through Mount Jackson, Rude’s Hill, New Market, Harrisonburg, and Swift Run Gap, Virginia"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: RUDE'S HILL INTERLUDE"}],["$","span",null,{"className":"result-label","children":"No set-piece battle was fought at Rude’s Hill. Jackson used Banks’s cautious pursuit after First Kernstown to rest, reorganize, recruit, and improve the Valley Army’s map intelligence. Banks crossed Stony Creek on April 16–17 and advanced through Mount Jackson, prompting Jackson to abandon Rude’s Hill and New Market rather than risk being turned. Jackson reached Harrisonburg on April 18 and moved east to Conrad’s Store near Swift Run Gap on April 19. Banks occupied New Market, then Harrisonburg, but incorrectly concluded that Jackson had permanently left the Valley. On May 1, Washington ordered Shields’s division toward McDowell while Banks remained in the Valley with Williams’s division"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4773870388.mp3?updated=1695307452","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The political consequences of First Kernstown and the operational pause between Kernstown and Jackson’s move toward the McDowell campaign"}],["$","small",null,{"children":"The narrative covers federal command changes, Jackson’s Rude’s Hill encampment, the appointment of Jedediah Hotchkiss, personnel changes, Confederate conscription, Banks’s advance, and Jackson’s withdrawal toward Swift Run Gap."}]]}],["$","div","Rude’s Hill position",{"children":[["$","span",null,{"children":"Rude’s Hill position"}],["$","strong",null,{"children":"High ground several miles south of Mount Jackson inside a bend of the North Fork of the Shenandoah River"}],["$","small",null,{"children":"The position guarded the Valley Turnpike approach from the north. Distances and unit locations in the companion diagrams are schematic."}]]}],["$","div","Operational result",{"children":[["$","span",null,{"children":"Operational result"}],["$","strong",null,{"children":"United States advance; Confederate withdrawal without battle"}],["$","small",null,{"children":"Banks occupied Mount Jackson and New Market on April 17. Jackson yielded Rude’s Hill before the threatened frontal and flanking movements could close on his smaller army."}]]}],["$","div","Kernstown consequence",{"children":[["$","span",null,{"children":"Kernstown consequence"}],["$","strong",null,{"children":"Banks stayed in the Valley and McDowell’s corps remained in northern Virginia"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}],"$L24","$L25","$L26","$L27",false,"$L28","$L29","$L2a"]}]]}]
2b:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"Lincoln’s April 9 letter explained that Banks’s diversion from the planned Manassas position left Washington inadequately covered and drove the decision to retain McDowell."}]
f:["$","div","Federal reorganization",{"children":[["$","span",null,{"children":"Federal reorganization"}],["$","strong",null,{"children":"Banks received the independent Department of the Shenandoah; McDowell received the Department of the Rappahannock; Frémont commanded the Mountain Department"}],["$","small",null,{"children":"The changes removed these forces from McClellan’s direct control while his Army of the Potomac operated on the Peninsula."}]]}]
10:["$","div","McDowell retained",{"children":[["$","span",null,{"children":"McDowell retained"}],["$","strong",null,{"children":"About 37,000 men remained in northern Virginia"}],["$","small",null,{"children":"The episode uses 37,000 for McDowell’s force. Contemporary totals vary with dates, definitions, and troops present or en route."}]]}]
11:["$","div","Jackson at Rude’s Hill",{"children":[["$","span",null,{"children":"Jackson at Rude’s Hill"}],["$","strong",null,{"children":"About two weeks of rest, drill, outpost duty, and reorganization"}],["$","small",null,{"children":"Ashby’s cavalry screened the army from Thomas Brook and then Stony Creek while poor weather and federal caution slowed pursuit."}]]}]
12:["$","div","Hotchkiss joins Jackson",{"children":[["$","span",null,{"children":"Hotchkiss joins Jackson"}],["$","strong",null,{"children":"Summoned to headquarters on March 27, four days after Kernstown"}],["$","small",null,{"children":"Jackson directed the self-taught topographer to prepare a Valley map from Harpers Ferry to Lexington showing points of offense and defense. The familiar wording comes from later recollection; the assignment and resulting map are well documented by the Library of Congress."}]]}]
13:["$","div","Hotchkiss’s value",{"children":[["$","span",null,{"children":"Hotchkiss’s value"}],["$","strong",null,{"children":"Detailed operational knowledge of roads, rivers, gaps, and terrain"}],["$","small",null,{"children":"Hotchkiss had taught and traveled extensively in the Valley before the war. His 1862 manuscript map became a major planning tool, but maps alone did not determine the campaign’s results."}]]}]
14:["$","div","Banks pauses",{"children":[["$","span",null,{"children":"Banks pauses"}],["$","strong",null,{"children":"One week at Thomas Brook and roughly two weeks north of Stony Creek"}],["$","small",null,{"children":"Banks overestimated Jackson’s strength after accepting Shields’s inflated post-Kernstown estimate. Burned bridges, flooded streams, cold rain and snow, supply trouble, and poor shoes also delayed movement."}]]}]
15:["$","div","Garnett removed",{"children":[["$","span",null,{"children":"Garnett removed"}],["$","strong",null,{"children":"Relieved from the Stonewall Brigade and arrested on April 1 for alleged neglect of duty at Kernstown"}],["$","small",null,{"children":"Jackson blamed Garnett’s unauthorized retreat for losing a chance to hold the field. The episode emphasizes that the brigade’s officers and men largely believed Garnett had acted correctly. His court-martial did not reach a verdict before the war intervened."}]]}]
16:["$","div","Stonewall Brigade reaction",{"children":[["$","span",null,{"children":"Stonewall Brigade reaction"}],["$","strong",null,{"children":"Widespread anger and resentment toward Jackson"}],["$","small",null,{"children":"The episode cites Maj. Frank Jones and Henry Kyd Douglas for the brigade’s hostile reaction. Their testimony describes morale and opinion, not a formal vote of every member."}]]}]
17:["$","div","New brigade commander",{"children":[["$","span",null,{"children":"New brigade commander"}],["$","strong",null,{"children":"Brig. Gen. Charles S. Winder replaced Garnett"}],["$","small",null,{"children":"Winder was a Maryland-born West Pointer and strict disciplinarian. The brigade initially resented both his appointment and Garnett’s removal."}]]}]
18:["$","div","Other command changes",{"children":[["$","span",null,{"children":"Other command changes"}],["$","strong",null,{"children":"William B. Taliaferro took the Third Brigade; Col. John A. Campbell temporarily led the Second Brigade"}],["$","small",null,{"children":"The automated transcript renders Taliaferro as “Tolliver” and Fulkerson as “Folkerson.” Taliaferro replaced Samuel V. Fulkerson; Campbell acted while Jesse S. Burks was on extended sick leave."}]]}]
19:["$","div","Confederate congressional thanks",{"children":[["$","span",null,{"children":"Confederate congressional thanks"}],["$","strong",null,{"children":"Congress formally thanked Jackson and his command for Kernstown"}],["$","small",null,{"children":"The resolution passed despite the tactical defeat, describing the action as gallant and meritorious service against a greatly superior force."}]]}]
1a:["$","div","First Confederate Conscription Act",{"children":[["$","span",null,{"children":"First Confederate Conscription Act"}],["$","strong",null,{"children":"Approved April 16, 1862"}],["$","small",null,{"children":"It subjected white male citizens ages 18–35 to three years of service, extended many existing one-year enlistments, and initially permitted substitution. The law was the first national conscription statute in United States history."}]]}]
1b:["$","div","Rockingham resistance",{"children":[["$","span",null,{"children":"Rockingham resistance"}],["$","strong",null,{"children":"About 200 militia members deserted near Swift Run Gap"}],["$","small",null,{"children":"The episode says Jackson sent infantry, cavalry, and artillery against the holdouts and that nearly all were rounded up. Motives varied; some resistance was pro-Union, while pacifist Mennonites, Dunkers, and Quakers also resisted military service on religious grounds."}]]}]
1c:["$","div","Valley Army strength",{"children":[["$","span",null,{"children":"Valley Army strength"}],["$","strong",null,{"children":"Just over 6,000 by late April"}],["$","small",null,{"children":"The episode attributes the increase to conscription, enlistment before the law took effect, and the return of veterans from furlough."}]]}]
1d:["$","div","Blenker’s ordeal",{"children":[["$","span",null,{"children":"Blenker’s ordeal"}],["$","strong",null,{"children":"Louis Blenker’s division was delayed near Paris, Virginia, and then sent directly to Frémont"}],["$","small",null,{"children":"The episode reports that forty men drowned during an attempted river crossing and describes severe shortages of food, shoes, tents, ammunition, and wagons. That drowning figure is retained as the episode’s report and has not been independently reconciled here."}]]}]
1e:["$","div","April 16 cavalry action",{"children":[["$","span",null,{"children":"April 16 cavalry action"}],["$","strong",null,{"children":"United States troops captured more than sixty of Ashby’s cavalrymen"}],["$","small",null,{"children":"Banks reported the capture near Columbia Furnace. His April 16 dispatch called it an entire company of more than sixty men and horses."}]]}]
1f:["$","div","April 17 advance",{"children":[["$","span",null,{"children":"April 17 advance"}],["$","strong",null,{"children":"Kimball advanced on the Valley Turnpike while Carroll used the Back Road"}],["$","small",null,{"children":"Banks reported Mount Jackson occupied at 7 a.m. Federal cavalry saved the North Fork bridge, locomotives, and rail cars that Confederate troops had prepared to burn."}]]}]
20:["$","div","Tom Telegraph",{"children":[["$","span",null,{"children":"Tom Telegraph"}],["$","strong",null,{"children":"Turner Ashby’s white war horse was mortally wounded on April 17"}],["$","small",null,{"children":"Henry Kyd Douglas later described the animal collapsing after carrying Ashby from the North Fork bridge to the protection of Confederate artillery. This is an animal loss and is not included in the people-losses field."}]]}]
21:["$","div","Jackson’s withdrawal",{"children":[["$","span",null,{"children":"Jackson’s withdrawal"}],["$","strong",null,{"children":"Rude’s Hill and New Market abandoned April 17; Harrisonburg reached April 18; Conrad’s Store reached April 19"}],["$","small",null,{"children":"Jackson moved south along the main Valley corridor, then about twenty miles east toward Swift Run Gap, preserving options to unite with Richard Ewell or move toward Staunton."}]]}]
22:["$","div","Banks loses contact",{"children":[["$","span",null,{"children":"Banks loses contact"}],["$","strong",null,{"children":"Incorrectly reported that Jackson had permanently left the Valley"}],["$","small",null,{"children":"Banks occupied New Market and moved cautiously to Harrisonburg. He asked to transfer both divisions east, but the May 1 order detached Shields while Banks and Williams remained in the Valley."}]]}]
23:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“Shenandoah 1862: Stonewall Jackson’s Valley Campaign” by Peter Cozzens"}],"$undefined"]}]
24:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
25:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","April 2–16: the Rude’s Hill and Stony Creek standoff",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep144-rudes-hill-standoff.svg","target":"_blank","rel":"noreferrer","aria-label":"Open April 2–16: the Rude’s Hill and Stony Creek standoff at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-rudes-hill-standoff.svg","alt":"Schematic map of Banks north of Stony Creek, Ashby screening the crossings, and Jackson at Rude’s Hill in early April 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"April 2–16: the Rude’s Hill and Stony Creek standoff"}],["$","span",null,{"children":"Jackson rested and reorganized south of Mount Jackson while Ashby screened Stony Creek. Banks’s much larger command waited north of the flooded stream amid poor weather, supply problems, inadequate shoes, and uncertainty about Confederate strength. The diagram is schematic: roads, waterways, distances, and troop positions are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep144-rudes-hill-standoff.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","April 17–19: Banks advances and Jackson withdraws",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep144-april17-withdrawal.svg","target":"_blank","rel":"noreferrer","aria-label":"Open April 17–19: Banks advances and Jackson withdraws at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-april17-withdrawal.svg","alt":"Schematic map of United States columns advancing through Mount Jackson while Jackson withdraws from Rude’s Hill to Harrisonburg and Swift Run Gap.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"April 17–19: Banks advances and Jackson withdraws"}],["$","span",null,{"children":"Banks sent Kimball along the Valley Turnpike and Carroll on the Back Road while other troops threatened to turn Rude’s Hill. Jackson gave up the position and New Market, reached Harrisonburg on April 18, and marched east to Conrad’s Store near Swift Run Gap on April 19. Routes and column locations are simplified and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep144-april17-withdrawal.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://ehistory.osu.edu/books/official-records/015/0426","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
26:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode resumes after First Kernstown",{"className":"moment","children":[["$","$L2b",null,{"seconds":68,"label":"1:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode resumes after First Kernstown"}],["$","p",null,{"children":"The hosts recap the March 23 tactical defeat and its strategic effect: Jackson’s attack caused federal leaders to keep or redirect troops away from McClellan’s Peninsula operation."}]]}]]}],["$","div","McClellan changes Banks’s assignment",{"className":"moment","children":[["$","$L2b",null,{"seconds":173,"label":"2:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan changes Banks’s assignment"}],["$","p",null,{"children":"The episode reads from McClellan’s April 1 instructions directing Banks to drive Jackson back and consider a move toward Staunton instead of leaving the Valley as previously planned."}]]}]]}],["$","div","Lincoln retains McDowell’s corps",{"className":"moment","children":[["$","$L2b",null,{"seconds":288,"label":"4:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln retains McDowell’s corps"}],["$","p",null,{"children":"McDowell’s roughly 37,000 men were held in northern Virginia to cover the direct route between Washington and Richmond rather than immediately joining McClellan on the Peninsula."}]]}]]}],["$","div","Lincoln answers McClellan",{"className":"moment","children":[["$","$L2b",null,{"seconds":326,"label":"5:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln answers McClellan"}],["$","p",null,{"children":"The April 9 letter explained that Banks’s continued presence in the Valley had broken the planned Washington-defense arrangement and that Lincoln therefore supplied a substitute by retaining McDowell."}]]}]]}],["$","div","Federal commands are reorganized",{"className":"moment","children":[["$","$L2b",null,{"seconds":365,"label":"6:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal commands are reorganized"}],["$","p",null,{"children":"Blenker’s division was assigned toward Frémont; McDowell’s force became the Department of the Rappahannock; and Banks’s force became the Department of the Shenandoah."}]]}]]}],["$","div","The hosts summarize Kernstown’s strategic effects",{"className":"moment","children":[["$","$L2b",null,{"seconds":465,"label":"7:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The hosts summarize Kernstown’s strategic effects"}],["$","p",null,{"children":"Banks stayed in the Valley, Blenker could be detained or redirected, and McDowell remained near Washington. The episode then distinguishes these real command effects from the hosts’ counterfactual judgment about McClellan’s ultimate prospects."}]]}]]}],["$","div","Jackson returns toward Mount Jackson",{"className":"moment","children":[["$","$L2b",null,{"seconds":711,"label":"11:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson returns toward Mount Jackson"}],["$","p",null,{"children":"After Kernstown, the Valley Army withdrew to Rude’s Hill, a defensible position south of Mount Jackson protected in part by a bend of the North Fork Shenandoah."}]]}]]}],["$","div","Jedediah Hotchkiss is summoned",{"className":"moment","children":[["$","$L2b",null,{"seconds":751,"label":"12:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jedediah Hotchkiss is summoned"}],["$","p",null,{"children":"Jackson called the 33-year-old teacher and self-taught topographer to headquarters on March 27."}]]}]]}],["$","div","The episode explains Hotchkiss’s mapmaking skill",{"className":"moment","children":[["$","$L2b",null,{"seconds":878,"label":"14:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode explains Hotchkiss’s mapmaking skill"}],["$","p",null,{"children":"His ability to estimate distance and elevation and to produce clear field maps had already earned notice despite his lack of formal engineering training."}]]}]]}],"$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46"]}]]}]
27:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Retained McDowell near Washington, approved the new independent departments, and decided with Stanton how much of Banks’s command could leave the Valley"}]]}],["$","div","War Department",{"className":"command-entry","children":[["$","strong",null,{"children":"War Department"}],["$","span",null,{"children":"Secretary of War Edwin M. Stanton"}],["$","small",null,{"children":"Supervised the independent departments, sent Rosecrans to locate Blenker, and transmitted the May 1 division of Banks’s force"}]]}],["$","div","Department of the Shenandoah",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Shenandoah"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Alpheus Williams’s and James Shields’s divisions; directed the advance from Stony Creek through Mount Jackson and New Market"}]]}],["$","div","First Division",{"className":"command-entry","children":[["$","strong",null,{"children":"First Division"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Brought up the reserve column on April 17; remained in the Valley with Banks under the May 1 order"}]]}],["$","div","Second Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Division"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"Returned to field command during the April advance; his division was ordered toward McDowell and Fredericksburg on May 1"}]]}],["$","div","Turnpike advance",{"className":"command-entry","children":[["$","strong",null,{"children":"Turnpike advance"}],["$","span",null,{"children":"Col. Nathan Kimball"}],["$","small",null,{"children":"Led the main April 17 column through Mount Jackson while another force used the Back Road"}]]}],["$","div","Brigade, Shields’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Shields’s division"}],["$","span",null,{"children":"Col. Samuel S. Carroll"}],["$","small",null,{"children":"Led the April 17 advance on the Back Road toward the rear of Mount Jackson"}]]}],["$","div","Department of the Rappahannock",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Rappahannock"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Held northern Virginia and advanced toward Fredericksburg instead of immediately joining McClellan on the Peninsula"}]]}],["$","div","Mountain Department",{"className":"command-entry","children":[["$","strong",null,{"children":"Mountain Department"}],["$","span",null,{"children":"Maj. Gen. John C. Frémont"}],["$","small",null,{"children":"Expected Louis Blenker’s transferred division in western Virginia"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Department of Northern Virginia",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Northern Virginia"}],["$","span",null,{"children":"Gen. Joseph E. Johnston"}],["$","small",null,{"children":"Jackson’s strategic superior; received Jackson’s request for a replacement commander for the Stonewall Brigade"}]]}],["$","div","Valley District",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Controlled the Valley Army, reorganized it at Rude’s Hill, and withdrew toward Swift Run Gap when Banks advanced"}]]}],"$L47","$L48","$L49","$L4a","$L4b"]]}]]}],"$L4c","$L4d"]}]
28:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep144-jedediah-hotchkiss.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-jedediah-hotchkiss.jpg","alt":"Nineteenth-century photographic portrait of Confederate topographer Jedediah Hotchkiss with a full beard","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson summoned Jedediah Hotchkiss on March 27 and directed him to map the Shenandoah Valley from Harpers Ferry to Lexington, including its important offensive and defensive points."}]]}],["$","figure","/images/ep144-nathaniel-banks.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-nathaniel-banks.jpg","alt":"Civil War-era full-length portrait of United States major general Nathaniel P. Banks in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Banks commanded the new Department of the Shenandoah. He forced Jackson away from Rude’s Hill but then lost contact and wrongly reported that Jackson had left the Valley permanently."}]]}],["$","figure","/images/ep144-charles-winder.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-charles-winder.jpg","alt":"Engraved head-and-shoulders portrait of Confederate brigadier general Charles S. Winder in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Charles S. Winder replaced Richard Garnett in command of the Stonewall Brigade. The Library of Congress identifies this as an engraving with no recorded date; its older catalog data is unverified."}]]}],["$","figure","/images/ep144-hotchkiss-valley-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-hotchkiss-valley-map.jpg","alt":"Jedediah Hotchkiss’s historic map of the Shenandoah Valley and the 1862 Valley Campaign","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This postwar 1880 Hotchkiss map shows the Valley corridor, parallel mountain chains, roads, rivers, gaps, and settlements. It is a geographic reference rather than a contemporaneous plot of the March–April troop positions."}]]}],["$","figure","/images/ep144-rudes-hill-standoff.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-rudes-hill-standoff.svg","alt":"Schematic map of the early April standoff between Banks at Stony Creek and Jackson at Rude’s Hill","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Ashby’s cavalry, flooded waterways, bad roads, supply failures, and Banks’s exaggerated estimate of Jackson’s strength created the pause Jackson used to rebuild his army."}]]}],["$","figure","/images/ep144-april17-withdrawal.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-april17-withdrawal.svg","alt":"Schematic map of Banks’s April 17 advance and Jackson’s withdrawal toward Swift Run Gap","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The United States approach combined a turnpike column, a Back Road movement, and threatened flanking columns. Jackson preserved his smaller force by yielding Rude’s Hill and moving south, then east."}]]}]]}]]}]
29:["$","details",null,{"className":"reference-sources","children":[["$","summary",null,{"children":"Sources and image credits"}],["$","ul",null,{"children":[["$","li","https://civilwarpodcast.org/2016/02/28/civil-war-podcast-episode-144/",{"children":["$","a",null,{"href":"https://civilwarpodcast.org/2016/02/28/civil-war-podcast-episode-144/","target":"_blank","rel":"noreferrer","children":["Official Civil War Podcast episode 144 page"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm","target":"_blank","rel":"noreferrer","children":["National Park Service: Jackson’s 1862 Campaign in the Shenandoah Valley"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.nps.gov/articles/000/battle-of-mcdowell.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/articles/000/battle-of-mcdowell.htm","target":"_blank","rel":"noreferrer","children":["National Park Service: Battle of McDowell campaign context"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"children":["$","a",null,{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":["U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://ehistory.osu.edu/books/official-records/015",{"children":["$","a",null,{"href":"https://ehistory.osu.edu/books/official-records/015","target":"_blank","rel":"noreferrer","children":["Primary source collection: Official Records, Series I, Volume XII, Part I"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://ehistory.osu.edu/books/official-records/015/0426",{"children":["$","a",null,{"href":"https://ehistory.osu.edu/books/official-records/015/0426","target":"_blank","rel":"noreferrer","children":["Primary source: Banks’s April 16–17 reports from Columbia Furnace, Mount Jackson, and Rude’s Hill, Official Records page 426"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://tile.loc.gov/storage-services/service/mss/mal/154/1543100/1543100.pdf",{"children":["$","a",null,{"href":"https://tile.loc.gov/storage-services/service/mss/mal/154/1543100/1543100.pdf","target":"_blank","rel":"noreferrer","children":["Primary source: Abraham Lincoln to George B. McClellan, April 9, 1862, Abraham Lincoln Papers"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://tile.loc.gov/storage-services/service/ll/llscd/llcc002/llcc002.pdf",{"children":["$","a",null,{"href":"https://tile.loc.gov/storage-services/service/ll/llscd/llcc002/llcc002.pdf","target":"_blank","rel":"noreferrer","children":["Primary source: Journal of the Confederate Congress, April 5 resolution thanking Jackson for Kernstown"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://blogs.loc.gov/law/2012/11/civil-war-conscription-laws/",{"children":["$","a",null,{"href":"https://blogs.loc.gov/law/2012/11/civil-war-conscription-laws/","target":"_blank","rel":"noreferrer","children":["Library of Congress: Civil War conscription laws"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":12}]]}]}],["$","li","https://www.loc.gov/collections/hotchkiss-maps/articles-and-essays/the-hotchkiss-collection-of-confederate-maps/",{"children":["$","a",null,{"href":"https://www.loc.gov/collections/hotchkiss-maps/articles-and-essays/the-hotchkiss-collection-of-confederate-maps/","target":"_blank","rel":"noreferrer","children":["Library of Congress: The Hotchkiss Collection of Confederate Maps"," ","$L4e"]}]}],"$L4f","$L50","$L51","$L52","$L53"]}]]}]
2a:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
2c:["$","div","Jackson assigns the Valley map",{"className":"moment","children":[["$","$L2b",null,{"seconds":934,"label":"15:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson assigns the Valley map"}],["$","p",null,{"children":"Hotchkiss was told to map the Valley from Harpers Ferry to Lexington and identify points of offense and defense, beginning a close operational partnership."}]]}]]}]
2d:["$","div","The Valley Army rebuilds at Rude’s Hill",{"className":"moment","children":[["$","$L2b",null,{"seconds":982,"label":"16:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Valley Army rebuilds at Rude’s Hill"}],["$","p",null,{"children":"Jackson used the pause for rest, drill, outpost duty, administrative work, and reorganization while Ashby covered the northern approaches."}]]}]]}]
2e:["$","div","Banks accepts an inflated strength estimate",{"className":"moment","children":[["$","$L2b",null,{"seconds":1032,"label":"17:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks accepts an inflated strength estimate"}],["$","p",null,{"children":"Shields claimed Jackson had at least 11,000 men at Kernstown. Banks accepted the estimate and pursued cautiously, although Jackson’s actual force there had been far smaller."}]]}]]}]
2f:["$","div","Banks crosses Thomas Brook",{"className":"moment","children":[["$","$L2b",null,{"seconds":1072,"label":"17:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks crosses Thomas Brook"}],["$","p",null,{"children":"On April 2 the United States advance moved south about ten miles, only to meet Ashby’s screen again at Stony Creek."}]]}]]}]
30:["$","div","The advance stops at Stony Creek",{"className":"moment","children":[["$","$L2b",null,{"seconds":1079,"label":"17:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"The advance stops at Stony Creek"}],["$","p",null,{"children":"A swollen stream, burned bridge, aggressive cavalry, bad weather, and uncertainty helped hold Banks north of the crossing for about two weeks."}]]}]]}]
31:["$","div","Jackson handles staff appointments",{"className":"moment","children":[["$","$L2b",null,{"seconds":1216,"label":"20:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson handles staff appointments"}],["$","p",null,{"children":"While Banks waited, Jackson offered Robert L. Dabney the headquarters chaplaincy and a possible wider staff role."}]]}]]}]
32:["$","div","Richard Garnett is arrested",{"className":"moment","children":[["$","$L2b",null,{"seconds":1265,"label":"21:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richard Garnett is arrested"}],["$","p",null,{"children":"Jackson removed Garnett from the Stonewall Brigade on April 1 and charged him with neglect of duty for retreating at Kernstown without orders."}]]}]]}]
33:["$","div","The brigade rejects Jackson’s judgment",{"className":"moment","children":[["$","$L2b",null,{"seconds":1339,"label":"22:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The brigade rejects Jackson’s judgment"}],["$","p",null,{"children":"The episode uses Frank Jones’s diary and letters and Henry Kyd Douglas’s recollection to document strong support for Garnett and resentment toward Jackson."}]]}]]}]
34:["$","div","Charles Winder takes the Stonewall Brigade",{"className":"moment","children":[["$","$L2b",null,{"seconds":1440,"label":"24:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Charles Winder takes the Stonewall Brigade"}],["$","p",null,{"children":"The 32-year-old West Pointer replaced Garnett. His strict discipline and status as a Marylander initially deepened the brigade’s hostility."}]]}]]}]
35:["$","div","Other brigade commands change",{"className":"moment","children":[["$","$L2b",null,{"seconds":1592,"label":"26:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Other brigade commands change"}],["$","p",null,{"children":"William B. Taliaferro returned to lead the Third Brigade over Jackson’s objection, while John A. Campbell temporarily led the Second Brigade during Jesse Burks’s illness."}]]}]]}]
36:["$","div","Congress thanks Jackson for Kernstown",{"className":"moment","children":[["$","$L2b",null,{"seconds":1661,"label":"27:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Congress thanks Jackson for Kernstown"}],["$","p",null,{"children":"The Confederate Congress formally praised Jackson and his men even though the army had lost the battlefield."}]]}]]}]
37:["$","div","The first Confederate conscription law",{"className":"moment","children":[["$","$L2b",null,{"seconds":1690,"label":"28:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first Confederate conscription law"}],["$","p",null,{"children":"The April 16 act made white male citizens ages 18–35 liable for three years of service and extended many existing one-year enlistments."}]]}]]}]
38:["$","div","Rockingham militia members resist",{"className":"moment","children":[["$","$L2b",null,{"seconds":1748,"label":"29:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rockingham militia members resist"}],["$","p",null,{"children":"About 200 men deserted toward the mountains near Swift Run Gap. Jackson sent infantry, cavalry, and artillery to break up the armed resistance and return the men to service."}]]}]]}]
39:["$","div","The Valley Army grows",{"className":"moment","children":[["$","$L2b",null,{"seconds":1828,"label":"30:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Valley Army grows"}],["$","p",null,{"children":"Conscription, pre-conscription enlistment, and furlough returns raised Jackson’s strength to just over 6,000, roughly double the post-Kernstown total described by the episode."}]]}]]}]
3a:["$","div","Weather and supply trouble impede Banks",{"className":"moment","children":[["$","$L2b",null,{"seconds":1883,"label":"31:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Weather and supply trouble impede Banks"}],["$","p",null,{"children":"Heavy rain and snow damaged roads and rations, while several regiments reported large numbers of men without serviceable shoes."}]]}]]}]
3b:["$","div","Blenker’s division is missing from Banks’s plan",{"className":"moment","children":[["$","$L2b",null,{"seconds":1944,"label":"32:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Blenker’s division is missing from Banks’s plan"}],["$","p",null,{"children":"William Rosecrans found the division near Paris, Virginia, blocked by the rain-swollen Shenandoah and severely short of equipment and supplies; Stanton then sent it directly to Frémont."}]]}]]}]
3c:["$","div","Banks finally moves",{"className":"moment","children":[["$","$L2b",null,{"seconds":2031,"label":"33:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks finally moves"}],["$","p",null,{"children":"After about fifteen days at Stony Creek, Banks prepared to seize New Market and force Jackson away from Rude’s Hill."}]]}]]}]
3d:["$","div","Cavalry crosses Stony Creek",{"className":"moment","children":[["$","$L2b",null,{"seconds":2059,"label":"34:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cavalry crosses Stony Creek"}],["$","p",null,{"children":"On April 16 United States cavalry used an unguarded ford and captured more than sixty of Ashby’s men near Columbia Furnace."}]]}]]}]
3e:["$","div","Banks takes Mount Jackson’s approaches",{"className":"moment","children":[["$","$L2b",null,{"seconds":2076,"label":"34:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks takes Mount Jackson’s approaches"}],["$","p",null,{"children":"Before dawn on April 17 infantry crossed Stony Creek and cavalry saved the North Fork bridge south of Mount Jackson before Ashby’s men could burn it."}]]}]]}]
3f:["$","div","Tom Telegraph collapses",{"className":"moment","children":[["$","$L2b",null,{"seconds":2102,"label":"35:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Tom Telegraph collapses"}],["$","p",null,{"children":"Ashby’s mortally wounded white horse carried him back to the Confederate artillery at Rude’s Hill before collapsing, according to Henry Kyd Douglas."}]]}]]}]
40:["$","div","Banks threatens the Rude’s Hill position",{"className":"moment","children":[["$","$L2b",null,{"seconds":2166,"label":"36:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks threatens the Rude’s Hill position"}],["$","p",null,{"children":"Jackson watched four United States brigades deploy toward his front while two more brigades moved to threaten his route toward New Market."}]]}]]}]
41:["$","div","Jackson withdraws without fighting",{"className":"moment","children":[["$","$L2b",null,{"seconds":2191,"label":"36:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson withdraws without fighting"}],["$","p",null,{"children":"Rather than risk envelopment, Jackson abandoned Rude’s Hill and New Market and continued south."}]]}]]}]
42:["$","div","The Valley Army reaches Harrisonburg",{"className":"moment","children":[["$","$L2b",null,{"seconds":2199,"label":"36:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Valley Army reaches Harrisonburg"}],["$","p",null,{"children":"Jackson arrived April 18, then marched about twenty miles east on April 19 to Conrad’s Store near Swift Run Gap."}]]}]]}]
43:["$","div","Banks reaches across Massanutten",{"className":"moment","children":[["$","$L2b",null,{"seconds":2228,"label":"37:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks reaches across Massanutten"}],["$","p",null,{"children":"From New Market he sent a detachment toward the Luray Valley bridges over the South Fork, but Ashby’s cavalry failed to destroy them."}]]}]]}]
44:["$","div","Banks loses track of Jackson",{"className":"moment","children":[["$","$L2b",null,{"seconds":2267,"label":"37:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Banks loses track of Jackson"}],["$","p",null,{"children":"Banks moved only about 35 miles in ten days and reported that Jackson had permanently abandoned the Valley, although Jackson was near Swift Run Gap."}]]}]]}]
45:["$","div","Washington divides Banks’s force",{"className":"moment","children":[["$","$L2b",null,{"seconds":2312,"label":"38:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Washington divides Banks’s force"}],["$","p",null,{"children":"On May 1 Stanton ordered Shields’s division toward McDowell at Fredericksburg but left Banks and Williams’s division in the Shenandoah Valley."}]]}]]}]
46:["$","div","The hosts recommend Peter Cozzens",{"className":"moment","children":[["$","$L2b",null,{"seconds":2355,"label":"39:15"}],["$","div",null,{"children":[["$","h3",null,{"children":"The hosts recommend Peter Cozzens"}],["$","p",null,{"children":"The episode closes its historical narrative with “Shenandoah 1862,” emphasizing the book’s coverage of both the United States and Confederate sides of the campaign."}]]}]]}]
