2b:["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Department of Northern Virginia-Gen. Joseph E. Johnston",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of Northern Virginia"}],["$","span",null,{"children":"Gen. Joseph E. Johnston"}],["$","small",null,{"children":"Jackson’s strategic superior; received Jackson’s request for a replacement commander for the Stonewall Brigade"}]]}],["$","div","Valley District-Maj. Gen. Thomas J. “Stonewall” Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Controlled the Valley Army, reorganized it at Rude’s Hill, and withdrew toward Swift Run Gap when Banks advanced"}]]}],["$","div","Stonewall Brigade-Brig. Gen. Charles S. Winder",{"className":"command-entry","children":[["$","strong",null,{"children":"Stonewall Brigade"}],["$","span",null,{"children":"Brig. Gen. Charles S. Winder"}],["$","small",null,{"children":"2nd, 4th, 5th, 27th, and 33rd Virginia Infantry; replaced the arrested Richard Garnett"}]]}],["$","div","Acting commander, Second Brigade-Col. John A. Campbell",{"className":"command-entry","children":[["$","strong",null,{"children":"Acting commander, Second Brigade"}],["$","span",null,{"children":"Col. John A. Campbell"}],["$","small",null,{"children":"Senior colonel of the 48th Virginia; temporarily led the brigade while Jesse S. Burks was on sick leave"}]]}],["$","div","Third Brigade-Brig. Gen. William B. Taliaferro",{"className":"command-entry","children":[["$","strong",null,{"children":"Third Brigade"}],["$","span",null,{"children":"Brig. Gen. William B. Taliaferro"}],["$","small",null,{"children":"Returned by War Department order to replace Samuel V. Fulkerson"}]]}],["$","div","7th Virginia Cavalry and attached forces-Col. Turner Ashby",{"className":"command-entry","children":[["$","strong",null,{"children":"7th Virginia Cavalry and attached forces"}],["$","span",null,{"children":"Col. Turner Ashby"}],["$","small",null,{"children":"Screened Thomas Brook and Stony Creek, delayed Banks, and covered the North Fork bridge and Rude’s Hill withdrawal"}]]}],["$","div","Topographical engineer on Jackson’s staff-Jedediah Hotchkiss",{"className":"command-entry","children":[["$","strong",null,{"children":"Topographical engineer on Jackson’s staff"}],["$","span",null,{"children":"Jedediah Hotchkiss"}],["$","small",null,{"children":"Surveyed routes and positions and began the comprehensive Valley map ordered on March 27"}]]}]]]}]
2c:["$","section",null,{"className":"other-people","aria-label":"Other people","children":[["$","h3",null,{"className":"subsection-title","children":"Other people"}],"$undefined",["$","ul",null,{"className":"other-people-list","children":[["$","li","Thomas J. “Stonewall” Jackson",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","div",null,{"className":"portrait-placeholder","aria-label":"No portrait available for Thomas J. “Stonewall” Jackson","children":["$","span",null,{"children":"TJ"}]}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h4",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Valley District commander who rebuilt at Rude’s Hill, removed Garnett, appointed Hotchkiss, and withdrew toward Swift Run Gap when Banks advanced"}]]}]]}]}],["$","li","Nathaniel P. Banks",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-nathaniel-banks.jpg","alt":"Portrait of Nathaniel P. Banks","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h4",null,{"children":"Nathaniel P. Banks"}],["$","p",null,{"children":"Commander of the Department of the Shenandoah whose cautious pursuit ended the Rude’s Hill encampment but failed to determine where Jackson went"}]]}]]}]}],["$","li","Jedediah Hotchkiss",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-jedediah-hotchkiss.jpg","alt":"Portrait of Jedediah Hotchkiss","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h4",null,{"children":"Jedediah Hotchkiss"}],["$","p",null,{"children":"Teacher and self-taught topographer appointed to Jackson’s staff and ordered to make a detailed military map of the Shenandoah Valley"}]]}]]}]}],["$","li","Richard B. Garnett",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","div",null,{"className":"portrait-placeholder","aria-label":"No portrait available for Richard B. Garnett","children":["$","span",null,{"children":"RB"}]}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h4",null,{"children":"Richard B. Garnett"}],["$","p",null,{"children":"Former Stonewall Brigade commander arrested for ordering the retreat at Kernstown; the episode presents the brigade’s strong defense of his decision"}]]}]]}]}],["$","li","Charles S. Winder",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-charles-winder.jpg","alt":"Portrait of Charles S. Winder","width":80,"height":100,"loading":"lazy"}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h4",null,{"children":"Charles S. Winder"}],["$","p",null,{"children":"Maryland-born West Pointer who replaced Garnett as commander of the hostile and resentful Stonewall Brigade"}]]}]]}]}],["$","li","Turner Ashby",{"children":["$","article",null,{"className":"person-card people-person","data-person-id":"$undefined","children":[["$","div",null,{"className":"portrait-placeholder","aria-label":"No portrait available for Turner Ashby","children":["$","span",null,{"children":"TA"}]}],["$","div",null,{"className":"people-person-copy","children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h4",null,{"children":"Turner Ashby"}],["$","p",null,{"children":"Cavalry commander whose aggressive screen delayed Banks at Thomas Brook and Stony Creek and covered Jackson’s April 17 withdrawal"}]]}]]}]}],["$","li","Alpheus S. Williams",{"children":"$L32"}],"$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41"]}]]}]
