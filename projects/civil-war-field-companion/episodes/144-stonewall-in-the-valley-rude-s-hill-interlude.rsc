1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",144," · ","March 27–May 1, 1862"," · ","The Shenandoah Valley from Winchester and Stony Creek through Mount Jackson, Rude’s Hill, New Market, Harrisonburg, and Swift Run Gap, Virginia"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: RUDE'S HILL INTERLUDE"}],["$","span",null,{"className":"result-label","children":"No set-piece battle was fought at Rude’s Hill. Jackson used Banks’s cautious pursuit after First Kernstown to rest, reorganize, recruit, and improve the Valley Army’s map intelligence. Banks crossed Stony Creek on April 16–17 and advanced through Mount Jackson, prompting Jackson to abandon Rude’s Hill and New Market rather than risk being turned. Jackson reached Harrisonburg on April 18 and moved east to Conrad’s Store near Swift Run Gap on April 19. Banks occupied New Market, then Harrisonburg, but incorrectly concluded that Jackson had permanently left the Valley. On May 1, Washington ordered Shields’s division toward McDowell while Banks remained in the Valley with Williams’s division"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4773870388.mp3?updated=1695307452","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The political consequences of First Kernstown and the operational pause between Kernstown and Jackson’s move toward the McDowell campaign"}],["$","small",null,{"children":"The narrative covers federal command changes, Jackson’s Rude’s Hill encampment, the appointment of Jedediah Hotchkiss, personnel changes, Confederate conscription, Banks’s advance, and Jackson’s withdrawal toward Swift Run Gap."}]]}],["$","div","Rude’s Hill position",{"children":[["$","span",null,{"children":"Rude’s Hill position"}],["$","strong",null,{"children":"High ground several miles south of Mount Jackson inside a bend of the North Fork of the Shenandoah River"}],["$","small",null,{"children":"The position guarded the Valley Turnpike approach from the north. Distances and unit locations in the companion diagrams are schematic."}]]}],["$","div","Operational result",{"children":[["$","span",null,{"children":"Operational result"}],["$","strong",null,{"children":"United States advance; Confederate withdrawal without battle"}],["$","small",null,{"children":"Banks occupied Mount Jackson and New Market on April 17. Jackson yielded Rude’s Hill before the threatened frontal and flanking movements could close on his smaller army."}]]}],["$","div","Kernstown consequence",{"children":[["$","span",null,{"children":"Kernstown consequence"}],["$","strong",null,{"children":"Banks stayed in the Valley and McDowell’s corps remained in northern Virginia"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}],"$L24","$undefined","$L25",false,"$L26",false,"$L27","$L28","$L29"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","small",null,{"children":"Lincoln’s April 9 letter explained that Banks’s diversion from the planned Manassas position left Washington inadequately covered and drove the decision to retain McDowell."}]
f:["$","div","Federal reorganization",{"children":[["$","span",null,{"children":"Federal reorganization"}],["$","strong",null,{"children":"Banks received the independent Department of the Shenandoah; McDowell received the Department of the Rappahannock; Frémont commanded the Mountain Department"}],["$","small",null,{"children":"The changes removed these forces from McClellan’s direct control while his Army of the Potomac operated on the Peninsula."}]]}]
10:["$","div","McDowell retained",{"children":[["$","span",null,{"children":"McDowell retained"}],["$","strong",null,{"children":"About 37,000 men remained in northern Virginia"}],["$","small",null,{"children":"The episode uses 37,000 for McDowell’s force. Contemporary totals vary with dates, definitions, and troops present or en route."}]]}]
11:["$","div","Jackson at Rude’s Hill",{"children":[["$","span",null,{"children":"Jackson at Rude’s Hill"}],["$","strong",null,{"children":"About two weeks of rest, drill, outpost duty, and reorganization"}],["$","small",null,{"children":"Ashby’s cavalry screened the army from Thomas Brook and then Stony Creek while poor weather and federal caution slowed pursuit."}]]}]
12:["$","div","Hotchkiss joins Jackson",{"children":[["$","span",null,{"children":"Hotchkiss joins Jackson"}],["$","strong",null,{"children":"Summoned to headquarters on March 27, four days after Kernstown"}],["$","small",null,{"children":"Jackson directed the self-taught topographer to prepare a Valley map from Harpers Ferry to Lexington showing points of offense and defense. The familiar wording comes from later recollection; the assignment and resulting map are well documented by the Library of Congress."}]]}]
13:["$","div","Hotchkiss’s value",{"children":[["$","span",null,{"children":"Hotchkiss’s value"}],["$","strong",null,{"children":"Detailed operational knowledge of roads, rivers, gaps, and terrain"}],["$","small",null,{"children":"Hotchkiss had taught and traveled extensively in the Valley before the war. His 1862 manuscript map became a major planning tool, but maps alone did not determine the campaign’s results."}]]}]
14:["$","div","Banks pauses",{"children":[["$","span",null,{"children":"Banks pauses"}],["$","strong",null,{"children":"One week at Thomas Brook and roughly two weeks north of Stony Creek"}],["$","small",null,{"children":"Banks overestimated Jackson’s strength after accepting Shields’s inflated post-Kernstown estimate. Burned bridges, flooded streams, cold rain and snow, supply trouble, and poor shoes also delayed movement."}]]}]
15:["$","div","Garnett removed",{"children":[["$","span",null,{"children":"Garnett removed"}],["$","strong",null,{"children":"Relieved from the Stonewall Brigade and arrested on April 1 for alleged neglect of duty at Kernstown"}],["$","small",null,{"children":"Jackson blamed Garnett’s unauthorized retreat for losing a chance to hold the field. The episode emphasizes that the brigade’s officers and men largely believed Garnett had acted correctly. His court-martial did not reach a verdict before the war intervened."}]]}]
16:["$","div","Stonewall Brigade reaction",{"children":[["$","span",null,{"children":"Stonewall Brigade reaction"}],["$","strong",null,{"children":"Widespread anger and resentment toward Jackson"}],["$","small",null,{"children":"The episode cites Maj. Frank Jones and Henry Kyd Douglas for the brigade’s hostile reaction. Their testimony describes morale and opinion, not a formal vote of every member."}]]}]
17:["$","div","New brigade commander",{"children":[["$","span",null,{"children":"New brigade commander"}],["$","strong",null,{"children":"Brig. Gen. Charles S. Winder replaced Garnett"}],["$","small",null,{"children":"Winder was a Maryland-born West Pointer and strict disciplinarian. The brigade initially resented both his appointment and Garnett’s removal."}]]}]
18:["$","div","Other command changes",{"children":[["$","span",null,{"children":"Other command changes"}],["$","strong",null,{"children":"William B. Taliaferro took the Third Brigade; Col. John A. Campbell temporarily led the Second Brigade"}],["$","small",null,{"children":"The automated transcript renders Taliaferro as “Tolliver” and Fulkerson as “Folkerson.” Taliaferro replaced Samuel V. Fulkerson; Campbell acted while Jesse S. Burks was on extended sick leave."}]]}]
19:["$","div","Confederate congressional thanks",{"children":[["$","span",null,{"children":"Confederate congressional thanks"}],["$","strong",null,{"children":"Congress formally thanked Jackson and his command for Kernstown"}],["$","small",null,{"children":"The resolution passed despite the tactical defeat, describing the action as gallant and meritorious service against a greatly superior force."}]]}]
1a:["$","div","First Confederate Conscription Act",{"children":[["$","span",null,{"children":"First Confederate Conscription Act"}],["$","strong",null,{"children":"Approved April 16, 1862"}],["$","small",null,{"children":"It subjected white male citizens ages 18–35 to three years of service, extended many existing one-year enlistments, and initially permitted substitution. The law was the first national conscription statute in United States history."}]]}]
1b:["$","div","Rockingham resistance",{"children":[["$","span",null,{"children":"Rockingham resistance"}],["$","strong",null,{"children":"About 200 militia members deserted near Swift Run Gap"}],["$","small",null,{"children":"The episode says Jackson sent infantry, cavalry, and artillery against the holdouts and that nearly all were rounded up. Motives varied; some resistance was pro-Union, while pacifist Mennonites, Dunkers, and Quakers also resisted military service on religious grounds."}]]}]
1c:["$","div","Valley Army strength",{"children":[["$","span",null,{"children":"Valley Army strength"}],["$","strong",null,{"children":"Just over 6,000 by late April"}],["$","small",null,{"children":"The episode attributes the increase to conscription, enlistment before the law took effect, and the return of veterans from furlough."}]]}]
1d:["$","div","Blenker’s ordeal",{"children":[["$","span",null,{"children":"Blenker’s ordeal"}],["$","strong",null,{"children":"Louis Blenker’s division was delayed near Paris, Virginia, and then sent directly to Frémont"}],["$","small",null,{"children":"The episode reports that forty men drowned during an attempted river crossing and describes severe shortages of food, shoes, tents, ammunition, and wagons. That drowning figure is retained as the episode’s report and has not been independently reconciled here."}]]}]
1e:["$","div","April 16 cavalry action",{"children":[["$","span",null,{"children":"April 16 cavalry action"}],["$","strong",null,{"children":"United States troops captured more than sixty of Ashby’s cavalrymen"}],["$","small",null,{"children":"Banks reported the capture near Columbia Furnace. His April 16 dispatch called it an entire company of more than sixty men and horses."}]]}]
1f:["$","div","April 17 advance",{"children":[["$","span",null,{"children":"April 17 advance"}],["$","strong",null,{"children":"Kimball advanced on the Valley Turnpike while Carroll used the Back Road"}],["$","small",null,{"children":"Banks reported Mount Jackson occupied at 7 a.m. Federal cavalry saved the North Fork bridge, locomotives, and rail cars that Confederate troops had prepared to burn."}]]}]
20:["$","div","Tom Telegraph",{"children":[["$","span",null,{"children":"Tom Telegraph"}],["$","strong",null,{"children":"Turner Ashby’s white war horse was mortally wounded on April 17"}],["$","small",null,{"children":"Henry Kyd Douglas later described the animal collapsing after carrying Ashby from the North Fork bridge to the protection of Confederate artillery. This is an animal loss and is not included in the people-losses field."}]]}]
21:["$","div","Jackson’s withdrawal",{"children":[["$","span",null,{"children":"Jackson’s withdrawal"}],["$","strong",null,{"children":"Rude’s Hill and New Market abandoned April 17; Harrisonburg reached April 18; Conrad’s Store reached April 19"}],["$","small",null,{"children":"Jackson moved south along the main Valley corridor, then about twenty miles east toward Swift Run Gap, preserving options to unite with Richard Ewell or move toward Staunton."}]]}]
22:["$","div","Banks loses contact",{"children":[["$","span",null,{"children":"Banks loses contact"}],["$","strong",null,{"children":"Incorrectly reported that Jackson had permanently left the Valley"}],["$","small",null,{"children":"Banks occupied New Market and moved cautiously to Harrisonburg. He asked to transfer both divisions east, but the May 1 order detached Shields while Banks and Williams remained in the Valley."}]]}]
23:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“Shenandoah 1862: Stonewall Jackson’s Valley Campaign” by Peter Cozzens"}],"$undefined"]}]
24:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
25:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","April 2–16: the Rude’s Hill and Stony Creek standoff",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep144-rudes-hill-standoff.svg","target":"_blank","rel":"noreferrer","aria-label":"Open April 2–16: the Rude’s Hill and Stony Creek standoff at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-rudes-hill-standoff.svg","alt":"Schematic map of Banks north of Stony Creek, Ashby screening the crossings, and Jackson at Rude’s Hill in early April 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"April 2–16: the Rude’s Hill and Stony Creek standoff"}],["$","span",null,{"children":"Jackson rested and reorganized south of Mount Jackson while Ashby screened Stony Creek. Banks’s much larger command waited north of the flooded stream amid poor weather, supply problems, inadequate shoes, and uncertainty about Confederate strength. The diagram is schematic: roads, waterways, distances, and troop positions are approximate."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep144-rudes-hill-standoff.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","April 17–19: Banks advances and Jackson withdraws",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep144-april17-withdrawal.svg","target":"_blank","rel":"noreferrer","aria-label":"Open April 17–19: Banks advances and Jackson withdraws at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-april17-withdrawal.svg","alt":"Schematic map of United States columns advancing through Mount Jackson while Jackson withdraws from Rude’s Hill to Harrisonburg and Swift Run Gap.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"April 17–19: Banks advances and Jackson withdraws"}],["$","span",null,{"children":"Banks sent Kimball along the Valley Turnpike and Carroll on the Back Road while other troops threatened to turn Rude’s Hill. Jackson gave up the position and New Market, reached Harrisonburg on April 18, and marched east to Conrad’s Store near Swift Run Gap on April 19. Routes and column locations are simplified and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep144-april17-withdrawal.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://ehistory.osu.edu/books/official-records/015/0426","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$25:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]]}]]}]
26:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Commander in chief-President Abraham Lincoln",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Retained McDowell near Washington, approved the new independent departments, and decided with Stanton how much of Banks’s command could leave the Valley"}]]}],["$","div","War Department-Secretary of War Edwin M. Stanton",{"className":"command-entry","children":[["$","strong",null,{"children":"War Department"}],["$","span",null,{"children":"Secretary of War Edwin M. Stanton"}],["$","small",null,{"children":"Supervised the independent departments, sent Rosecrans to locate Blenker, and transmitted the May 1 division of Banks’s force"}]]}],["$","div","Department of the Shenandoah-Maj. Gen. Nathaniel P. Banks",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Shenandoah"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Alpheus Williams’s and James Shields’s divisions; directed the advance from Stony Creek through Mount Jackson and New Market"}]]}],["$","div","First Division-Brig. Gen. Alpheus S. Williams",{"className":"command-entry","children":[["$","strong",null,{"children":"First Division"}],["$","span",null,{"children":"Brig. Gen. Alpheus S. Williams"}],["$","small",null,{"children":"Brought up the reserve column on April 17; remained in the Valley with Banks under the May 1 order"}]]}],["$","div","Second Division-Brig. Gen. James Shields",{"className":"command-entry","children":[["$","strong",null,{"children":"Second Division"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"Returned to field command during the April advance; his division was ordered toward McDowell and Fredericksburg on May 1"}]]}],["$","div","Turnpike advance-Col. Nathan Kimball",{"className":"command-entry","children":[["$","strong",null,{"children":"Turnpike advance"}],["$","span",null,{"children":"Col. Nathan Kimball"}],["$","small",null,{"children":"Led the main April 17 column through Mount Jackson while another force used the Back Road"}]]}],["$","div","Brigade, Shields’s division-Col. Samuel S. Carroll",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade, Shields’s division"}],["$","span",null,{"children":"Col. Samuel S. Carroll"}],["$","small",null,{"children":"Led the April 17 advance on the Back Road toward the rear of Mount Jackson"}]]}],["$","div","Department of the Rappahannock-Maj. Gen. Irvin McDowell",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Rappahannock"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Held northern Virginia and advanced toward Fredericksburg instead of immediately joining McClellan on the Peninsula"}]]}],"$L2a"]]}],"$L2b"]}],"$L2c"]]]}]
27:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep144-jedediah-hotchkiss.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-jedediah-hotchkiss.jpg","alt":"Nineteenth-century photographic portrait of Confederate topographer Jedediah Hotchkiss with a full beard","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson summoned Jedediah Hotchkiss on March 27 and directed him to map the Shenandoah Valley from Harpers Ferry to Lexington, including its important offensive and defensive points."}]]}],["$","figure","/images/ep144-nathaniel-banks.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-nathaniel-banks.jpg","alt":"Civil War-era full-length portrait of United States major general Nathaniel P. Banks in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Banks commanded the new Department of the Shenandoah. He forced Jackson away from Rude’s Hill but then lost contact and wrongly reported that Jackson had left the Valley permanently."}]]}],["$","figure","/images/ep144-charles-winder.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-charles-winder.jpg","alt":"Engraved head-and-shoulders portrait of Confederate brigadier general Charles S. Winder in uniform","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Charles S. Winder replaced Richard Garnett in command of the Stonewall Brigade. The Library of Congress identifies this as an engraving with no recorded date; its older catalog data is unverified."}]]}],["$","figure","/images/ep144-hotchkiss-valley-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-hotchkiss-valley-map.jpg","alt":"Jedediah Hotchkiss’s historic map of the Shenandoah Valley and the 1862 Valley Campaign","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This postwar 1880 Hotchkiss map shows the Valley corridor, parallel mountain chains, roads, rivers, gaps, and settlements. It is a geographic reference rather than a contemporaneous plot of the March–April troop positions."}]]}],["$","figure","/images/ep144-rudes-hill-standoff.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-rudes-hill-standoff.svg","alt":"Schematic map of the early April standoff between Banks at Stony Creek and Jackson at Rude’s Hill","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Ashby’s cavalry, flooded waterways, bad roads, supply failures, and Banks’s exaggerated estimate of Jackson’s strength created the pause Jackson used to rebuild his army."}]]}],["$","figure","/images/ep144-april17-withdrawal.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-april17-withdrawal.svg","alt":"Schematic map of Banks’s April 17 advance and Jackson’s withdrawal toward Swift Run Gap","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The United States approach combined a turnpike column, a Back Road movement, and threatened flanking columns. Jackson preserved his smaller force by yielding Rude’s Hill and moving south, then east."}]]}]]}]]}]
