4d:["$","div",null,{"className":"people-grid compact-people","children":[["$","article","Thomas J. “Stonewall” Jackson",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"TJ"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Thomas J. “Stonewall” Jackson"}],["$","p",null,{"children":"Valley District commander who rebuilt at Rude’s Hill, removed Garnett, appointed Hotchkiss, and withdrew toward Swift Run Gap when Banks advanced"}]]}]]}],["$","article","Nathaniel P. Banks",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-nathaniel-banks.jpg","alt":"Portrait of Nathaniel P. Banks","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Nathaniel P. Banks"}],["$","p",null,{"children":"Commander of the Department of the Shenandoah whose cautious pursuit ended the Rude’s Hill encampment but failed to determine where Jackson went"}]]}]]}],["$","article","Jedediah Hotchkiss",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep144-jedediah-hotchkiss.jpg","alt":"Portrait of Jedediah Hotchkiss","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Jedediah Hotchkiss"}],["$","p",null,{"children":"Teacher and self-taught topographer appointed to Jackson’s staff and ordered to make a detailed military map of the Shenandoah Valley"}]]}]]}],["$","article","Richard B. Garnett",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"RB"}]}],["$","div",null,{"children":[["$","span",null,{"clas