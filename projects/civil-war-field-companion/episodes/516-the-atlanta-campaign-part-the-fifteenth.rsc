13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode compares the two 1864 campaigns",{"className":"moment","children":[["$","$L19",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode compares the two 1864 campaigns"}],["$","p",null,{"children":"Grant’s Overland Campaign had produced more than 50,000 casualties in May. Sherman had generally used maneuver to limit similar losses in Georgia."}]]}]]}],["$","div","Sherman had advanced nearly 70 miles",{"className":"moment","children":[["$","$L19",null,{"seconds":173,"label":"2:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman had advanced nearly 70 miles"}],["$","p",null,{"children":"By early June, the U.S. armies remained supplied by rail and were moving closer to Atlanta while preventing Johnston from reinforcing Lee."}]]}]]}],["$","div","Richmond pressured Johnston",{"className":"moment","children":[["$","$L19",null,{"seconds":243,"label":"4:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richmond pressured Johnston"}],["$","p",null,{"children":"Jefferson Davis and Braxton Bragg were concerned about the loss of ground in Georgia and wanted Johnston to produce a victory."}]]}]]}],["$","div","The U.S. armies returned to the railroad",{"className":"moment","children":[["$","$L19",null,{"seconds":306,"label":"5:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. armies returned to the railroad"}],["$","p",null,{"children":"After the Dallas operations, Sherman concentrated near Acworth and reconnected with the Western and Atlantic Railroad."}]]}]]}],["$","div","Sherman chose a closer movement toward Marietta",{"className":"moment","children":[["$","$L19",null,{"seconds":359,"label":"5:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman chose a closer movement toward Marietta"}],["$","p",null,{"children":"He repaired the railroad and planned to use nearby roads rather than repeat the wide movement away from his supply line."}]]}]]}],["$","div","Johnston occupied high ground west of Marietta",{"className":"moment","children":[["$","$L19",null,{"seconds":420,"label":"7:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston occupied high ground west of Marietta"}],["$","p",null,{"children":"The Confederate army withdrew into the ridges and heights around Pine, Lost, and Kennesaw mountains."}]]}]]}],["$","div","Daily skirmishing defined the June fighting",{"className":"moment","children":[["$","$L19",null,{"seconds":496,"label":"8:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Daily skirmishing defined the June fighting"}],["$","p",null,{"children":"Both armies used skirmish lines, sharpshooters, and rapidly built earthworks as they advanced short distances and maintained close contact."}]]}]]}],["$","div","U.S. forces advanced on June 10",{"className":"moment","children":[["$","$L19",null,{"seconds":683,"label":"11:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"U.S. forces advanced on June 10"}],["$","p",null,{"children":"Sherman moved from Acworth along Sandtown Road, staying near the railroad while pressing Johnston’s main line."}]]}]]}],["$","div","Thomas reached Pine Mountain",{"className":"moment","children":[["$","$L19",null,{"seconds":711,"label":"11:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Thomas reached Pine Mountain"}],["$","p",null,{"children":"By June 12, the Army of the Cumberland pressured the Confederate center at the forward salient."}]]}]]}],["$","div","Johnston, Hardee, and Polk inspected Pine Mountain",{"className":"moment","children":[["$","$L19",null,{"seconds":720,"label":"12:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston, Hardee, and Polk inspected Pine Mountain"}],["$","p",null,{