1b:["$","div","Leonidas Polk was killed",{"className":"moment","children":[["$","$L19",null,{"seconds":754,"label":"12:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Leonidas Polk was killed"}],["$","p",null,{"children":"An artillery shell struck Polk in the left side and killed him instantly. Johnston and Hardee survived."}]]}]]}]
1c:["$","div","The Confederates abandoned Pine Mountain",{"className":"moment","children":[["$","$L19",null,{"seconds":803,"label":"13:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederates abandoned Pine Mountain"}],["$","p",null,{"children":"Johnston withdrew from the vulnerable salient, and William W. Loring assumed temporary command of Polk’s corps."}]]}]]}]
1d:["$","div","Short U.S. advances forced additional withdrawals",{"className":"moment","children":[["$","$L19",null,{"seconds":849,"label":"14:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Short U.S. advances forced additional withdrawals"}],["$","p",null,{"children":"Sherman ordered pressure along the line after Pine Mountain was evacuated. The armies fought at Noonday Creek and Gilgal Church on June 15."}]]}]]}]
