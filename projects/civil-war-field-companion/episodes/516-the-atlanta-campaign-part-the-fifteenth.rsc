1f:["$","div","The Kennesaw position covered Marietta and the railroad",{"className":"moment","children":[["$","$L19",null,{"seconds":1062,"label":"17:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Kennesaw position covered Marietta and the railroad"}],["$","p",null,{"children":"Loring held the mountain heights, Hood held the Confederate right near the railroad, and Hardee extended south."}]]}]]}]
20:["$","div","Big Kennesaw dominated the surrounding ground",{"className":"moment","children":[["$","$L19",null,{"seconds":1139,"label":"18:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Big Kennesaw dominated the surrounding ground"}],["$","p",null,{"children":"The peak rose about 700 feet above the plain. Little Kennesaw and Pigeon Hill extended the high ground to the south."}]]}]]}]
21:["$","div","The mountain protected the approach to Atlanta",{"className":"moment","children":[["$","$L19",null,{"seconds":1218,"label":"20:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"The mountain protected the approach to Atlanta"}],["$","p",null,{"children":"The position covered the Western and Atlantic Railroad and Marietta, with the Chattahoochee River and Atlanta farther south."}]]}]]}]
22:["$","div","Confederate artillery used the heights",{"className":"moment","children":[["$","$L19",null,{"seconds":1339,"label":"22:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate artillery used the heights"}],["$","p",null,{"children":"Guns on the mountain fired into U.S. camps and lines below. U.S. batteries responded with counterbattery fire."}]]}]]}]
23:["$","div","Persistent rain slowed operations",{"className":"moment","children":[["$","$L19",null,{"seconds":1523,"label":"25:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Persistent rain slowed operations"}],["$","p",null,{"children":"Heavy rain turned roads into mud, complicated supply and movement, and left soldiers on both sides without dry shelter."}]]}]]}]
24:["$","div","Sherman looked toward the Confederate left",{"className":"moment","children":[["$","$L19",null,{"seconds":1699,"label":"28:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman looked toward the Confederate left"}],["$","p",null,{"children":"He ruled out a northern movement near his railroad and preferred to extend Schofield and Thomas south of the mountain."}]]}]]}]
25:["$","div","IV Corps fought for Bald Knob",{"className":"moment","children":[["$","$L19",null,{"seconds":1824,"label":"30:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"IV Corps fought for Bald Knob"}],["$","p",null,{"children":"On June 20 and 21, Howard’s troops seized high ground near the Confederate center, helping divert attention from Schofield’s movement farther south."}]]}]]}]
