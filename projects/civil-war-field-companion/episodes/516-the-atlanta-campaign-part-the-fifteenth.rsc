13:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L1b",null,{"guide":{"date":"June 2–22, 1864","place":"Acworth, Pine Mountain, and Kennesaw Mountain, Georgia","result":"The armies concentrated on the Kennesaw line; Leonidas Polk was killed and Hood shifted to the Confederate left","facts":[{"label":"U.S. advance by early June","value":"Nearly 70 miles into Georgia"},{"label":"Confederate line occupied","value":"June 19"},{"label":"Big Kennesaw height","value":"About 700 feet above the surrounding ground"},{"label":"Rain","value":"Reported on nearly every day from May 31 into late June"},{"label":"Senior Confederate loss","value":"Lieutenant General Leonidas Polk killed June 14"},{"label":"Hood shifted left","value":"Night of June 21–22"}],"maps":[{"title":"The Kennesaw line","caption":"The National Park Service map shows Big and Little Kennesaw, Pigeon Hill, Pine Mountain, the Dallas and Powder Springs roads, and the opposing army positions.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm","image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map of the armies around Kennesaw Mountain"},{"title":"Confederate artillery on Kennesaw Mountain","caption":"A wartime drawing of the artillery positions on Pigeon Hill, Little Kennesaw, and Big Kennesaw above the U.S. lines.","source":"https://www.loc.gov/item/2004660525/","image":"/images/kennesaw-battlefield-drawing.jpg","alt":"1864 drawing of Confederate artillery positions across Kennesaw Mountain"},{"title":"The Atlanta campaign route","caption":"The wider map shows the Western and Atlantic Railroad, Acworth, Marietta, Kennesaw Mountain, and the route toward Atlanta.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of the Atlanta campaign across northwestern Georgia"},{"title":"Kennesaw Mountain today","caption":"The heights stand northwest of Marietta and west of the Western and Atlantic Railroad route used to supply Sherman’s armies.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.72%2C33.90%2C-84.48%2C34.14&layer=mapnik&marker=33.983%2C-84.579"}],"moments":[{"time":"1:19","audioTime":79,"title":"The episode compares the two 1864 campaigns","detail":"Grant’s Overland Campaign had produced more than 50,000 casualties in May. Sherman had generally used maneuver to limit similar losses in Georgia."},{"time":"2:53","audioTime":173,"title":"Sherman had advanced nearly 70 miles","detail":"By early June, the U.S. armies remained supplied by rail and were moving closer to Atlanta while preventing Johnston from reinforcing Lee."},{"time":"4:03","audioTime":243,"title":"Richmond pressured Johnston","detail":"Jefferson Davis and Braxton Bragg were concerned about the loss of ground in Georgia and wanted Johnston to produce a victory."},{"time":"5:06","audioTime":306,"title":"The U.S. armies returned to the railroad","detail":"After the Dallas operations, Sherman concentrated near Acworth and reconnected with the Western and Atlantic Railroad."},{"time":"5:59","audioTime":359,"title":"Sherman chose a closer movement toward Marietta","detail":"He repaired the railroad and planned to use nearby roads rather than repeat the wide movement away from his supply line."},{"time":"7:00","audioTime":420,"title":"Johnston occupied high ground west of Marietta","detail":"The Confederate army withdrew into the ridges and heights around Pine, Lost, and Kennesaw mountains."},{"time":"8:16","audioTime":496,"title":"Daily skirmishing defined the June fighting","detail":"Both armies used skirmish lines, sharpshooters, and rapidly built earthworks as they advanced short distances and maintained close contact."},{"time":"11:23","audioTime":683,"title":"U.S. forces advanced on June 10","detail":"Sherman moved from Acworth along Sandtown Road, staying near the railroad while pressing Johnston’s main line."},{"time":"11:51","audioTime":711,"title":"Thomas reached Pine Mountain","detail":"By June 12, the Army of the Cumberland pressured the Confederate center at the forward salient."},{"time":"12:00","audioTime":720,"title":"Johnston, Hardee, and Polk inspected Pine Mountain","detail":"On June 14, the three generals went to the summit to examine their own line and the U.S. positions."},{"time":"12:15","audioTime":735,"title":"Sherman ordered artillery to fire on the group","detail":"U.S. gunners fired after Sherman saw Confederate officers exposed on the summit."},{"time":"12:34","audioTime":754,"title":"Leonidas Polk was killed","detail":"An artillery shell struck Polk in the left side and killed him instantly. Johnston and Hardee survived."},{"time":"13:23","audioTime":803,"title":"The Confederates abandoned Pine Mountain","detail":"Johnston withdrew from the vulnerable salient, and William W. Loring assumed temporary command of Polk’s corps."},{"time":"14:09","audioTime":849,"title":"Short U.S. advances forced additional withdrawals","detail":"Sherman ordered pressure along the line after Pine Mountain was evacuated. The armies fought at Noonday Creek and Gilgal Church on June 15."},{"time":"15:38","audioTime":938,"title":"Johnston moved into the final Kennesaw line","detail":"On June 19, the Army of Tennessee occupied Big and Little Kennesaw and the surrounding ridges."},{"time":"17:42","audioTime":1062,"title":"The Kennesaw position covered Marietta and the railroad","detail":"Loring held the mountain heights, Hood held the Confederate right near the railroad, and Hardee extended south."},{"time":"18:59","audioTime":1139,"title":"Big Kennesaw dominated the surrounding ground","detail":"The peak rose about 700 feet above the plain. Little Kennesaw and Pigeon Hill extended the high ground to the south."},{"time":"20:18","audioTime":1218,"title":"The mountain protected the approach to Atlanta","detail":"The position covered the Western and Atlantic Railroad and Marietta, with the Chattahoochee River and Atlanta farther south."},{"time":"22:19","audioTime":1339,"title":"Confederate artillery used the heights","detail":"Guns on the mountain fired into U.S. camps and lines below. U.S. batteries responded with counterbattery fire."},{"time":"25:23","audioTime":1523,"title":"Persistent rain slowed operations","detail":"Heavy rain turned roads into mud, complicated supply and movement, and left soldiers on both sides without dry shelter."},{"time":"28:19","audioTime":1699,"title":"Sherman looked toward the Confederate left","detail":"He ruled out a northern movement near his railroad and preferred to extend Schofield and Thomas south of the mountain."},{"time":"30:24","audioTime":1824,"title":"IV Corps fought for Bald Knob","detail":"On June 20 and 21, Howard’s troops seized high ground near the Confederate center, helping divert attention from Schofield’s movement farther south."},{"time":"31:12","audioTime":1872,"title":"Johnston shifted Hood’s corps","detail":"To counter the U.S. extension, Hood moved from the Confederate right to the far left on the night of June 21."},{"time":"32:16","audioTime":1936,"title":"Hood’s new assignment was defensive","detail":"Johnston wanted Hood to protect the southern flank. Hood’s aggressive response on June 22 led to the Battle of Kolb’s Farm."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed the movement toward Marietta"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"U.S. left near Big Kennesaw"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"U.S. center"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"U.S. right extending south"},{"commander":"Oliver O. Howard","command":"IV Corps","subordinates":"Seized ground near Bald Knob"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Directed the withdrawals and Kennesaw defense"},{"commander":"Leonidas Polk, then William W. Loring","command":"Polk’s Corps","subordinates":"Held Big and Little Kennesaw"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Moved from the right to the far left on June 21–22"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Held south of the Kennesaw heights"},{"commander":"Joseph Wheeler","command":"Cavalry Corps","subordinates":"Guarded the Confederate right"}]}],"people":[{"name":"Leonidas Polk","role":"Confederate corps commander killed by U.S. artillery on Pine Mountain","side":"Confederacy"},{"name":"William W. Loring","role":"Assumed temporary command of Polk’s corps and held the Kennesaw heights","side":"Confederacy"},{"name":"William T. Sherman","role":"Directed the advance from Acworth and ordered the artillery fire at Pine Mountain","side":"United States"},{"name":"Joseph E. Johnston","role":"Withdrew into the Kennesaw line and shifted Hood to meet the U.S. movement south","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"John B. Hood","role":"Moved his corps to the Confederate left before Kolb’s Farm","side":"Confederacy","image":"/images/john-b-hood.jpg","source":"https://www.loc.gov/pictures/item/2002722867/"},{"name":"Patrick R. Cleburne","role":"Commanded a division south of Dallas Road in Hardee’s corps","side":"Confederacy"},{"name":"Benjamin F. Cheatham","role":"Commanded the division holding the ground later called Cheatham Hill","side":"Confederacy"},{"name":"Benjamin Harrison","role":"Commanded the 70th Indiana during the fighting near Gilgal Church","side":"United States","image":"/images/benjamin-harrison.jpg","source":"https://www.loc.gov/pictures/item/96524264/"}],"losses":[{"name":"Leonidas Polk","side":"Confederacy","role":"Lieutenant general commanding a corps in the Army of Tennessee","outcome":"Killed instantly by a U.S. artillery shell on Pine Mountain on June 14, 1864"}],"gallery":[{"image":"/images/kennesaw-battlefield-drawing.jpg","alt":"Theodore R. Davis drawing of Confederate artillery positions at Kennesaw Mountain","caption":"A wartime drawing of Confederate artillery positions on the Kennesaw heights.","source":"https://www.loc.gov/item/2004660525/"},{"image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map of the opposing armies around Kennesaw Mountain","caption":"The final Kennesaw line extended from the heights south toward Kolb’s Farm.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"}],"sources":[{"label":"Official Episode 516 page","url":"https://civilwarpodcast.org/2026/01/11/civil-war-podcast-episode-516/"},{"label":"National Park Service battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ga015"},{"label":"National Park Service troop movements map","url":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm"},{"label":"National Park Service Confederate order of battle","url":"https://www.nps.gov/kemo/learn/historyculture/confederate-order-of-battle.htm"},{"label":"Library of Congress Kennesaw battlefield drawing","url":"https://www.loc.gov/item/2004660525/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"}]}}]}]
