15:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Gen. Joseph E. Johnston",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Gen. Joseph E. Johnston"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the army defending Richmond","."]}]," ","Seriously wounded at Seven Pines on May 31 by a rifle bullet and shell fragment. He survived, but the wounds removed him from command and directly led to Lee’s appointment on June 1."]}]]}]]}]]}]
16:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","$L24","/images/ep157-humphreys-seven-days-map.jpg",{"image":"/images/ep157-humphreys-seven-days-map.jpg","alt":"Benjamin Grubb Humphreys’s 1862 manuscript map of the Seven Days battlefield.","caption":"Humphreys’s map accompanied a July 29, 1862 letter and records Federal works and the retreat toward the James. It is a contemporary retrospective map, not the map used at Dabbs House.","name":"Benjamin Grubb Humphreys’s 1862 manuscript map of the Seven Days battlefield.","source":"$undefined","credit":"Library of Congress Geography and Map Division; see sources below."}],["$","$L24","/images/ep157-robert-e-lee.jpg",{"image":"/images/ep157-robert-e-lee.jpg","alt":"Civil War-era photographic portrait of Confederate general Robert E. Lee.","caption":"Lee took command on June 1. His initial preparations combined field fortification, reconnaissance, concentration, and an attempt to seize the initiative.","name":"Civil War-era photographic portrait of Confederate general Robert E. Lee.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L24","/images/ep157-jeb-stuart.jpg",{"image":"/images/ep157-jeb-stuart.jpg","alt":"Civil War-era photographic portrait of Confederate cavalry commander J. E. B. Stuart.","caption":"Stuart’s June reconnaissance reported that McClellan’s right north of the Chickahominy was not anchored on a natural obstacle.","name":"Civil War-era photographic portrait of Confederate cavalry commander J. E. B. Stuart.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L24","/images/ep157-stonewall-jackson.jpg",{"image":"/images/ep157-stonewall-jackson.jpg","alt":"Civil War-era photographic portrait of Confederate general Thomas J. Stonewall Jackson.","caption":"Jackson’s transferred Valley force was the outside column and the trigger for Lee’s planned sequence. Its late approach placed the entire design at risk.","name":"Civil War-era photographic portrait of Confederate general Thomas J. Stonewall Jackson.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}],["$","$L24","/images/ep157-james-longstreet.jpg",{"image":"/images/ep157-james-longstreet.jpg","alt":"Civil War-era photographic portrait of Confederate general James Longstreet.","caption":"Longstreet attended the Dabbs House conference and was assigned to cross after A. P. Hill, then support Hill nearest the Chickahominy.","name":"Civil War-era photographic portrait of Confederate general James Longstreet.","source":"$undefined","credit":"Library of Congress Prints and Photographs Division; see sources below."}]]}]]}]
