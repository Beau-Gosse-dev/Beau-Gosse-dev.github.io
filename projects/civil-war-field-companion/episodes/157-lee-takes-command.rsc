f:["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","Jackson’s reinforcement",{"children":[["$","th",null,{"scope":"row","children":"Jackson’s reinforcement"}],["$","td",null,{"children":["About 18,000–20,000 men",["$","small",null,{"style":{"display":"block"},"children":"The episode uses about 18,000; the National Park Service summarizes the reinforcement as 20,000. Strength varied with the date, attachments, straggling, and method of counting."}]]}]]}]]}]]}]
10:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/07/10/civil-war-podcast-episode-157/",{"href":"https://civilwarpodcast.org/2016/07/10/civil-war-podcast-episode-157/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 157 page"]}],["$","a","https://www.nps.gov/rich/learn/historyculture/sevendays.htm",{"href":"https://www.nps.gov/rich/learn/historyculture/sevendays.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: 1862 Seven Days Battles"]}],["$","a","https://www.nps.gov/rich/learn/historyculture/bdcbulletin.htm",{"href":"https://www.nps.gov/rich/learn/historyculture/bdcbulletin.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Battle of Beaver Dam Creek"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://www.battlefields.org/learn/primary-sources/robert-e-lees-report-seven-days-battles",{"href":"https://www.battlefields.org/learn/primary-sources/robert-e-lees-report-seven-days-battles","target":"_blank","rel":"noreferrer","children":[" · ","Primary source: Robert E. Lee’s official report on the Seven Days Battles"]}],["$","a","https://encyclopediavirginia.org/entries/lee-robert-e-1807-1870/",{"href":"https://encyclopediavirginia.org/entries/lee-robert-e-1807-1870/","target":"_blank","rel":"noreferrer","children":[" · ","Encyclopedia Virginia: Robert E. Lee biography and chronology"]}],["$","a","https://www.nps.gov/fopu/learn/historyculture/robert-e-lee.htm",{"href":"https://www.nps.gov/fopu/learn/historyculture/robert-e-lee.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Lee and the South Atlantic coastal defenses"]}],["$","a","https://www.loc.gov/item/gvhs01.vhs00384/",{"href":"https://www.loc.gov/item/gvhs01.vhs00384/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Humphreys map of the Seven Days battlefield"]}],["$","a","https://www.loc.gov/item/2018666540/",{"href":"https://www.loc.gov/item/2018666540/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Robert E. Lee portrait"]}],["$","a","https://www.loc.gov/item/2018670326/",{"href":"https://www.loc.gov/item/2018670326/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Thomas J. “Stonewall” Jackson portrait"]}],["$","a","https://www.loc.gov/item/2018666541/",{"href":"https://www.loc.gov/item/2018666541/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: James Longstreet portrait"]}],["$","a","https://www.loc.gov/item/2018671039/",{"href":"https://www.loc.gov/item/2018671039/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: J. E. B. Stuart portrait"]}],["$","a","https://civilwarpodcast.org/book-recommendations/",{"href":"https://civilwarpodcast.org/book-recommendations/","target":"_blank","rel":"noreferrer","children":[" · ","Official podcast book-recommendations list"]}]]}]
