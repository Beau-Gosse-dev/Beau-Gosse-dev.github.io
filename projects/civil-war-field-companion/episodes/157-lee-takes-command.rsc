d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",157," · ","June 1–26, 1862"," · ","Richmond and the Chickahominy River approaches in Virginia, with Jackson moving from the Shenandoah Valley through the Virginia Central Railroad corridor toward Ashland and Mechanicsville"]}],["$","h1",null,{"children":"LEE TAKES COMMAND"}],["$","span",null,{"className":"result-label","children":"Robert E. Lee replaced the wounded Joseph E. Johnston on June 1 and prepared an offensive against George B. McClellan. Lee strengthened the Richmond defenses, used J. E. B. Stuart’s reconnaissance to confirm that the Federal right north of the Chickahominy was exposed, transferred Stonewall Jackson’s command from the Valley, and issued a plan for June 26. The offensive had not begun by the episode’s endpoint. Its success depended on Jackson’s timely arrival, a relay through Lawrence O. Branch, multiple river crossings, and coordination among commanders who had not operated together as one army"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"June 1–26, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Richmond and the Chickahominy River approaches in Virginia, with Jackson moving from the Shenandoah Valley through the Virginia Central Railroad corridor toward Ashland and Mechanicsville"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Robert E. Lee replaced the wounded Joseph E. Johnston on June 1 and prepared an offensive against George B. McClellan. Lee strengthened the Richmond defenses, used J. E. B. Stuart’s reconnaissance to confirm that the Federal right north of the Chickahominy was exposed, transferred Stonewall Jackson’s command from the Valley, and issued a plan for June 26. The offensive had not begun by the episode’s endpoint. Its success depended on Jackson’s timely arrival, a relay through Lawrence O. Branch, multiple river crossings, and coordination among commanders who had not operated together as one army"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],"$Lf","$L10"]}],"$undefined"]}],"$L11","$L12","$L13",false,"$L14","$L15","$L16","$L17","$L18","$L19"]}]]}]
