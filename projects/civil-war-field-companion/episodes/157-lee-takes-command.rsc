1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",157," · ","June 1–26, 1862"," · ","Richmond and the Chickahominy River approaches in Virginia, with Jackson moving from the Shenandoah Valley through the Virginia Central Railroad corridor toward Ashland and Mechanicsville"]}],["$","h1",null,{"children":"LEE TAKES COMMAND"}],["$","span",null,{"className":"result-label","children":"Robert E. Lee replaced the wounded Joseph E. Johnston on June 1 and prepared an offensive against George B. McClellan. Lee strengthened the Richmond defenses, used J. E. B. Stuart’s reconnaissance to confirm that the Federal right north of the Chickahominy was exposed, transferred Stonewall Jackson’s command from the Valley, and issued a plan for June 26. The offensive had not begun by the episode’s endpoint. Its success depended on Jackson’s timely arrival, a relay through Lawrence O. Branch, multiple river crossings, and coordination among commanders who had not operated together as one army"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8084259043.mp3?updated=1695325960","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Lee’s appointment and preparations for the opening of the Seven Days Battles"}],["$","small",null,{"children":"The episode ends before the June 26 attack begins and evaluates the plan with knowledge of the coordination failures that followed."}]]}],["$","div","Change of command",{"children":[["$","span",null,{"children":"Change of command"}],["$","strong",null,{"children":"Lee assumed command on the afternoon of June 1, 1862"}],["$","small",null,{"children":"Jefferson Davis selected Lee after Joseph E. Johnston was seriously wounded at Seven Pines on May 31 and after Davis rejected Gustavus W. Smith as a permanent replacement."}]]}],["$","div","Immediate military setting",{"children":[["$","span",null,{"children":"Immediate military setting"}],["$","strong",null,{"children":"McClellan’s Army of the Potomac stood outside Richmond"}],["$","small",null,{"children":"The Chickahominy divided the Federal army, while rain, flooded bottomlands, damaged bridges, and mud slowed movement and siege preparations."}]]}],["$","div","Lee’s prewar preparation",{"children":[["$","span",null,{"children":"Lee’s prewar preparation"}],["$","strong",null,{"children":"Engineer, Mexican War staff officer, West Point superintendent, and cavalry colonel"}],["$","small",null,{"children":"Lee had extensive professional service but limited experience directing troops in battle as an independent commander."}]]}],["$","div","Earlier Confederate service",{"children":[["$","span",null,{"children":"Earlier Confederate service"}],["$","strong",null,{"children":"Virginia forces, western Virginia, the South Atlantic coast, then Davis’s military adviser"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}],"$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
2c:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"His 1861 western Virginia campaign failed. His coastal assignment emphasized withdrawing from exposed islands and strengthening defensible interior positions."}]
f:["$","div","Public expectations",{"children":[["$","span",null,{"children":"Public expectations"}],["$","strong",null,{"children":"Many Confederates doubted Lee’s field-command ability"}],["$","small",null,{"children":"The episode records the derisive names “Granny Lee” and “King of Spades.” These were contemporary judgments, not neutral descriptions of his conduct."}]]}]
10:["$","div","McClellan’s assessment",{"children":[["$","span",null,{"children":"McClellan’s assessment"}],["$","strong",null,{"children":"McClellan expected Lee to be cautious and unlikely to attempt a large bold movement"}],["$","small",null,{"children":"The episode quotes McClellan’s private evaluation. It proved a serious misreading of Lee’s willingness to accept operational risk."}]]}]
11:["$","div","Defensive construction",{"children":[["$","span",null,{"children":"Defensive construction"}],["$","strong",null,{"children":"Lee strengthened a line from south of the Chickahominy toward the James River"}],["$","small",null,{"children":"The works were intended to let a smaller force hold the direct approaches to Richmond while the rest of the army moved against McClellan’s right and supply line."}]]}]
12:["$","div","Command relationship",{"children":[["$","span",null,{"children":"Command relationship"}],["$","strong",null,{"children":"Lee kept Jefferson Davis informed and obtained broad freedom of action"}],["$","small",null,{"children":"The episode contrasts their working relationship with the distrust and poor communication between Davis and Johnston."}]]}]
13:["$","div","Stuart’s reconnaissance",{"children":[["$","span",null,{"children":"Stuart’s reconnaissance"}],["$","strong",null,{"children":"About 1,200 cavalrymen left on June 12 and returned on June 15"}],["$","small",null,{"children":"Stuart rode around the Army of the Potomac. The episode uses the reconnaissance primarily for its report that the Federal right north of the Chickahominy was not anchored on a natural obstacle."}]]}]
14:["$","div","Operational objective",{"children":[["$","span",null,{"children":"Operational objective"}],["$","strong",null,{"children":"Threaten the York River supply line and force McClellan out of prepared positions"}],["$","small",null,{"children":"Lee’s later official report states that a direct assault appeared impracticable and that a move down the north bank could compel retreat or battle outside the entrenchments."}]]}]
15:["$","div","Jackson’s transfer",{"children":[["$","span",null,{"children":"Jackson’s transfer"}],["$","strong",null,{"children":"Lee ordered the Valley force to move rapidly and secretly toward Richmond"}],["$","small",null,{"children":"Lee wrote Jackson on June 16. The episode places the rail movement from the Valley on June 20 and Jackson at Frederick’s Hall on June 22."}]]}]
16:["$","div","Jackson’s reinforcement",{"children":[["$","span",null,{"children":"Jackson’s reinforcement"}],["$","strong",null,{"children":"About 18,000–20,000 men"}],["$","small",null,{"children":"The episode uses about 18,000; the National Park Service summarizes the reinforcement as 20,000. Strength varied with the date, attachments, straggling, and method of counting."}]]}]
17:["$","div","June 22 halt",{"children":[["$","span",null,{"children":"June 22 halt"}],["$","strong",null,{"children":"Jackson rested while his column remained extended along the route"}],["$","small",null,{"children":"The episode criticizes the halt because the army was still about fifty miles from Richmond. Its statement that even a short advance would have changed the later campaign is explicitly counterfactual."}]]}]
18:["$","div","Dabbs House conference",{"children":[["$","span",null,{"children":"Dabbs House conference"}],["$","strong",null,{"children":"Lee met Jackson, Longstreet, A. P. Hill, and D. H. Hill on June 23"}],["$","small",null,{"children":"Lee explained the plan over a map and later sent written instructions. Magruder and Huger were not at the conference because their assigned role was to hold south of the river."}]]}]
19:["$","div","Planned opening sequence",{"children":[["$","span",null,{"children":"Planned opening sequence"}],["$","strong",null,{"children":"Jackson turn the Federal right; Branch relay his approach; A. P. Hill cross; Longstreet and D. H. Hill follow"}],["$","small",null,{"children":"Magruder and Huger were to hold the Richmond front. The diagram shows assignments, not exact positions or the movements actually achieved on June 26."}]]}]
1a:["$","div","Episode army-strength estimate",{"children":[["$","span",null,{"children":"Episode army-strength estimate"}],["$","strong",null,{"children":"About 85,000–90,000 Confederates after Jackson arrived"}],["$","small",null,{"children":"The episode calls this the largest Confederate army fielded during the war. Period returns and historical studies produce different totals because they count present, effective, and attached personnel differently."}]]}]
1b:["$","div","Episode force allocation",{"children":[["$","span",null,{"children":"Episode force allocation"}],["$","strong",null,{"children":"About 55,000–60,000 for the northern movement and roughly 27,000 to hold south of the river"}],["$","small",null,{"children":"These are approximate planning figures, not precise battlefield returns. Magruder’s and Huger’s smaller force faced most of McClellan’s army south of the Chickahominy."}]]}]
1c:["$","div","Intelligence error",{"children":[["$","span",null,{"children":"Intelligence error"}],["$","strong",null,{"children":"Lee overestimated the Federal share north of the Chickahominy"}],["$","small",null,{"children":"The episode states that nearly four-fifths of the Federal army was south of the river by late June, leaving Fitz John Porter’s V Corps and George McCall’s division north of it. Exact proportions depend on strength definitions."}]]}]
1d:["$","div","Coordination risk",{"children":[["$","span",null,{"children":"Coordination risk"}],["$","strong",null,{"children":"Five moving elements depended on sequence, distance, road conditions, and message relays"}],["$","small",null,{"children":"The army had not previously fought together under Lee. Jackson’s movement had to trigger the others, yet Lee’s written orders did not state an exact arrival time."}]]}]
1e:["$","div","Attack date",{"children":[["$","span",null,{"children":"Attack date"}],["$","strong",null,{"children":"June 26, selected after Jackson first proposed June 25"}],["$","small",null,{"children":"The episode attributes the one-day extension to Longstreet’s concern about Jackson’s march. Its criticism that June 27 would have been more rational is a retrospective judgment."}]]}]
1f:["$","div","Jackson’s condition",{"children":[["$","span",null,{"children":"Jackson’s condition"}],["$","strong",null,{"children":"The episode documents sustained sleep loss before the planned attack"}],["$","small",null,{"children":"Fatigue is presented as a factor in Jackson’s decisions, not a complete explanation. The episode also assigns responsibility for the stalled column and unrealistic schedule."}]]}]
20:["$","div","Recommended resource",{"children":[["$","span",null,{"children":"Recommended resource"}],["$","strong",null,{"children":"“Robert E. Lee and His High Command,” twelve lectures by Gary W. Gallagher"}],["$","small",null,{"children":"The recommendation is an audio lecture course rather than a book."}]]}]
21:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Fair Oaks, Chickahominy, Dabbs House, Magruder, Huger, Ewell, and Dabney"}],["$","small",null,{"children":"The automated transcript renders several of these as “Pharaohs,” “Chica-Hominy,” “Dabs,” “Duje,” “Yule,” and “Daphne.”"}]]}]
22:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
23:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Richmond and the divided Federal army",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep157-richmond-strategic-situation.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Richmond and the divided Federal army at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep157-richmond-strategic-situation.svg","alt":"Schematic map of Richmond, the Chickahominy, the divided Federal army, White House Landing, and Jackson’s approach.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Richmond and the divided Federal army"}],["$","span",null,{"children":"The Chickahominy separated Porter’s right wing from the Federal majority south of the river. Lee strengthened Richmond’s defenses, planned to shift troops north, and used Jackson’s approach from the northwest to threaten the York River railroad and White House Landing. Rivers, roads, positions, distances, and force areas are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep157-richmond-strategic-situation.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, Lee’s official report, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Lee’s assigned opening sequence for June 26",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep157-june26-plan.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Lee’s assigned opening sequence for June 26 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep157-june26-plan.svg","alt":"Schematic diagram of Lee’s planned June 26 movement north of the Chickahominy.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Lee’s assigned opening sequence for June 26"}],["$","span",null,{"children":"Jackson was to turn the Federal right. Branch would report his approach, A. P. Hill would cross at Meadow Bridge, and Longstreet and D. H. Hill would follow after the Mechanicsville crossing opened. Magruder and Huger would hold south of the river. Arrows represent assigned relationships, not exact troop geometry or actual execution. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep157-june26-plan.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Lee’s official report, National Park Service, U.S. Army Center of Military History, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Contemporary map of the Seven Days battlefield",{"className":"reference-map","children":["$L2a","$L2b"]}]]}]]}]
24:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The episode resumes after Seven Pines",{"className":"moment","children":[["$","$L2c",null,{"seconds":69,"label":"1:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode resumes after Seven Pines"}],["$","p",null,{"children":"The hosts review the indecisive battle and the failures of command on both sides."}]]}]]}],["$","div","Seven Pines losses are summarized",{"className":"moment","children":[["$","$L2c",null,{"seconds":124,"label":"2:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Seven Pines losses are summarized"}],["$","p",null,{"children":"The episode gives approximately 5,000 United States and 6,100 Confederate casualties."}]]}]]}],["$","div","Johnston’s wound changes the campaign",{"className":"moment","children":[["$","$L2c",null,{"seconds":136,"label":"2:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston’s wound changes the campaign"}],["$","p",null,{"children":"Joseph E. Johnston’s serious wounding on May 31 created the command vacancy Davis filled the next day."}]]}]]}],["$","div","Lee assumes command",{"className":"moment","children":[["$","$L2c",null,{"seconds":158,"label":"2:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee assumes command"}],["$","p",null,{"children":"Lee arrives at Gustavus W. Smith’s headquarters on the afternoon of June 1 to command the army defending Richmond."}]]}]]}],["$","div","June becomes a strategic turning point",{"className":"moment","children":[["$","$L2c",null,{"seconds":218,"label":"3:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"June becomes a strategic turning point"}],["$","p",null,{"children":"The episode frames Lee’s first month in army command and the Seven Days as a reversal of the military situation in Virginia."}]]}]]}],["$","div","Reputation exceeded command experience",{"className":"moment","children":[["$","$L2c",null,{"seconds":265,"label":"4:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Reputation exceeded command experience"}],["$","p",null,{"children":"Lee’s family name, engineering career, Mexican War service, and Winfield Scott’s praise are separated from his limited independent combat command."}]]}]]}],["$","div","Virginia command ends without an army",{"className":"moment","children":[["$","$L2c",null,{"seconds":347,"label":"5:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Virginia command ends without an army"}],["$","p",null,{"children":"Lee organized Virginia’s volunteers, then lost direct command when the regiments entered Confederate service."}]]}]]}],["$","div","Lee becomes Davis’s adviser",{"className":"moment","children":[["$","$L2c",null,{"seconds":364,"label":"6:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee becomes Davis’s adviser"}],["$","p",null,{"children":"The episode traces his service as an unofficial aide and military adviser before field command."}]]}]]}],["$","div","Western Virginia damages Lee’s standing",{"className":"moment","children":[["$","$L2c",null,{"seconds":379,"label":"6:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Western Virginia damages Lee’s standing"}],["$","p",null,{"children":"The failed campaign contributed to public doubts and the later “Granny Lee” label."}]]}]]}],["$","div","Coastal defense emphasizes depth",{"className":"moment","children":[["$","$L2c",null,{"seconds":384,"label":"6:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Coastal defense emphasizes depth"}],["$","p",null,{"children":"In South Carolina, Georgia, and Florida, Lee withdrew from vulnerable coast positions and strengthened interior defenses."}]]}]]}],["$","div","McClellan learns late of the command change",{"className":"moment","children":[["$","$L2c",null,{"seconds":436,"label":"7:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan learns late of the command change"}],["$","p",null,{"children":"The episode says McClellan did not learn until about June 10 that Lee had replaced Johnston."}]]}]]}],["$","div","McClellan misjudges Lee",{"className":"moment","children":[["$","$L2c",null,{"seconds":454,"label":"7:34"}],["$","div",null,{"children":["$L2d","$L2e"]}]]}],"$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49"]}]]}]
25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Directed the campaign against Richmond; his army depended on the Richmond & York River Railroad and was divided by the Chickahominy"}]]}],["$","div","V Corps on the Federal right",{"className":"command-entry","children":[["$","strong",null,{"children":"V Corps on the Federal right"}],["$","span",null,{"children":"Brig. Gen. Fitz John Porter"}],["$","small",null,{"children":"Held north of the Chickahominy with George McCall’s Pennsylvania Reserves attached and became the immediate target of Lee’s turning movement"}]]}],["$","div","II and VI Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"II and VI Corps"}],["$","span",null,{"children":"Brig. Gens. Edwin V. Sumner and William B. Franklin"}],["$","small",null,{"children":"Positioned south of the Chickahominy by late June as part of the Federal majority confronting Richmond"}]]}],["$","div","III and IV Corps",{"className":"command-entry","children":[["$","strong",null,{"children":"III and IV Corps"}],["$","span",null,{"children":"Brig. Gens. Samuel P. Heintzelman and Erasmus D. Keyes"}],["$","small",null,{"children":"Held sectors south of the Chickahominy opposite Magruder and Huger"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Confederate commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate commander in chief"}],["$","span",null,{"children":"President Jefferson Davis"}],["$","small",null,{"children":"Selected Lee on June 1 and maintained close communication with him during the preparations"}]]}],["$","div","Army defending Richmond",{"className":"command-entry","children":[["$","strong",null,{"children":"Army defending Richmond"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Strengthened the defensive line, directed Stuart’s reconnaissance, ordered Jackson east, and issued the June 26 plan"}]]}],["$","div","Valley force and far-left turning column",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley force and far-left turning column"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Expected to approach from the northwest, turn the Federal right, and move toward Cold Harbor"}]]}],["$","div","Light Division at Meadow Bridge",{"className":"command-entry","children":[["$","strong",null,{"children":"Light Division at Meadow Bridge"}],["$","span",null,{"children":"Maj. Gen. A. P. Hill"}],["$","small",null,{"children":"Expected to cross after Jackson’s approach became known and drive through Mechanicsville"}]]}],["$","div","Supporting divisions north of the Chickahominy",{"className":"command-entry","children":[["$","strong",null,{"children":"Supporting divisions north of the Chickahominy"}],["$","span",null,{"children":"Maj. Gens. James Longstreet and D. H. Hill"}],["$","small",null,{"children":"Longstreet was to support A. P. Hill; D. H. Hill was to move toward Jackson’s right after the crossings opened"}]]}],["$","div","Richmond defensive line south of the river",{"className":"command-entry","children":[["$","strong",null,{"children":"Richmond defensive line south of the river"}],["$","span",null,{"children":"Maj. Gens. John B. Magruder and Benjamin Huger"}],["$","small",null,{"children":"Ordered to hold, demonstrate, watch Federal movements, and pursue if McClellan withdrew"}]]}],["$","div","Brigade north of Mechanicsville",{"className":"command-entry","children":["$L4a","$L4b","$L4c"]}],"$L4d"]]}]]}],"$L4e","$L4f"]}]
26:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Gen. Joseph E. Johnston",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Gen. Joseph E. Johnston"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the army defending Richmond","."]}]," ","Seriously wounded at Seven Pines on May 31 by a rifle bullet and shell fragment. He survived, but the wounds removed him from command and directly led to Lee’s appointment on June 1."]}]]}]]}]]}]
27:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep157-richmond-strategic-situation.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep157-richmond-strategic-situation.svg","alt":"Schematic strategic map of Richmond and the armies divided by the Chickahominy.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Lee used fortifications to reduce the force required on the Richmond front and planned to attack the Federal right and supply line north of the river. All positions and routes are generalized."}]]}],["$","figure","/images/ep157-june26-plan.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep157-june26-plan.svg","alt":"Schematic of the assigned Confederate movements for June 26.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The sequence depended on Jackson, Branch, A. P. Hill, Longstreet, and D. H. Hill acting across separated roads and crossings. It shows the plan, not exact troop geometry or actual execution."}]]}],["$","figure","/images/ep157-humphreys-seven-days-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep157-humphreys-seven-days-map.jpg","alt":"Benjamin Grubb Humphreys’s 1862 manuscript map of the Seven Days battlefield.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Humphreys’s map accompanied a July 29, 1862 letter and records Federal works and the retreat toward the James. It is a contemporary retrospective map, not the map used at Dabbs House."}]]}],["$","figure","/images/ep157-robert-e-lee.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep157-robert-e-lee.jpg","alt":"Civil War-era photographic portrait of Confederate general Robert E. Lee.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Lee took command on June 1. His initial preparations combined field fortification, reconnaissance, concentration, and an attempt to seize the initiative."}]]}],["$","figure","/images/ep157-jeb-stuart.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep157-jeb-stuart.jpg","alt":"Civil War-era photographic portrait of Confederate cavalry commander J. E. B. Stuart.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Stuart’s June reconnaissance reported that McClellan’s right north of the Chickahominy was not anchored on a natural obstacle."}]]}],["$","figure","/images/ep157-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep157-stonewall-jackson.jpg","alt":"Civil War-era photographic portrait of Confederate general Thomas J. Stonewall Jackson.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s transferred Valley force was the outside column and the trigger for Lee’s planned sequence. Its late approach placed the entire design at risk."}]]}],["$","figure","/images/ep157-james-longstreet.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep157-james-longstreet.jpg","alt":"Civil War-era photographic portrait of Confederate general James Longstreet.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Longstreet attended the Dabbs House conference and was assigned to cross after A. P. Hill, then support Hill nearest the Chickahominy."}]]}]]}]]}]
