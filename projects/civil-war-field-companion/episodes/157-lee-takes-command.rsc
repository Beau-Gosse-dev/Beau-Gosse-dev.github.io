2b:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Contemporary map of the Seven Days battlefield"}],["$","span",null,{"children":"Benjamin Grubb Humphreys drew this map in 1862 and sent it with a July 29 letter. It records Richmond-area roads, waterways, Federal works, and the retreat toward the James. It reflects one participant’s later representation and should not be treated as a precise map of Lee’s June 23 conference plan."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep157-humphreys-seven-days-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Geography and Map Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
2d:["$","h3",null,{"children":"McClellan misjudges Lee"}]
2e:["$","p",null,{"children":"McClellan describes Lee as too cautious for grave responsibility and unlikely to attempt a bold large-scale movement."}]
2f:["$","div","Confederate doubts are widespread",{"className":"moment","children":[["$","$L2c",null,{"seconds":514,"label":"8:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate doubts are widespread"}],["$","p",null,{"children":"Newspapers, politicians, officers, civilians, and soldiers questioned whether Lee could handle the crisis."}]]}]]}]
30:["$","div","Lee inherits the Richmond crisis",{"className":"moment","children":[["$","$L2c",null,{"seconds":645,"label":"10:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee inherits the Richmond crisis"}],["$","p",null,{"children":"McClellan stands outside the capital while many in the North expect a decisive United States victory."}]]}]]}]
31:["$","div","Rain delays Federal preparations",{"className":"moment","children":[["$","$L2c",null,{"seconds":663,"label":"11:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rain delays Federal preparations"}],["$","p",null,{"children":"Flooded Chickahominy bottomlands, damaged bridges, and mud obstruct movement and heavy-gun emplacement."}]]}]]}]
32:["$","div","Lee targets the supply system",{"className":"moment","children":[["$","$L2c",null,{"seconds":679,"label":"11:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee targets the supply system"}],["$","p",null,{"children":"Rather than repeat a direct assault, Lee plans to threaten communications and force McClellan to move."}]]}]]}]
33:["$","div","Fortifications support the offensive",{"className":"moment","children":[["$","$L2c",null,{"seconds":732,"label":"12:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fortifications support the offensive"}],["$","p",null,{"children":"The Richmond line is intended to let a smaller force hold south of the river while other divisions attack north of it."}]]}]]}]
34:["$","div","Lee and Davis establish a working relationship",{"className":"moment","children":[["$","$L2c",null,{"seconds":809,"label":"13:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee and Davis establish a working relationship"}],["$","p",null,{"children":"Frequent reports and prior service together reduce presidential interference in Lee’s command."}]]}]]}]
35:["$","div","Stuart receives the reconnaissance mission",{"className":"moment","children":[["$","$L2c",null,{"seconds":846,"label":"14:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart receives the reconnaissance mission"}],["$","p",null,{"children":"Lee asks Stuart to determine how strongly the Federal right north of the Chickahominy is anchored."}]]}]]}]
36:["$","div","Stuart rides with about 1,200",{"className":"moment","children":[["$","$L2c",null,{"seconds":904,"label":"15:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart rides with about 1,200"}],["$","p",null,{"children":"The cavalry departs on June 12 with Rooney Lee among its officers."}]]}]]}]
37:["$","div","Stuart reports an exposed flank",{"className":"moment","children":[["$","$L2c",null,{"seconds":923,"label":"15:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stuart reports an exposed flank"}],["$","p",null,{"children":"Returning June 15, Stuart reports that the Federal right is not secured on a natural feature."}]]}]]}]
38:["$","div","Lee commits to Jackson’s transfer",{"className":"moment","children":[["$","$L2c",null,{"seconds":952,"label":"15:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee commits to Jackson’s transfer"}],["$","p",null,{"children":"Jackson is to approach from the northwest while Longstreet, A. P. Hill, and D. H. Hill shift north of the river."}]]}]]}]
39:["$","div","The June 16 order stresses secrecy",{"className":"moment","children":[["$","$L2c",null,{"seconds":1031,"label":"17:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The June 16 order stresses secrecy"}],["$","p",null,{"children":"Lee directs Jackson toward Richmond and warns that the movement must remain secret."}]]}]]}]
3a:["$","div","The Valley Army uses the railroad",{"className":"moment","children":[["$","$L2c",null,{"seconds":1059,"label":"17:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Valley Army uses the railroad"}],["$","p",null,{"children":"The limited car supply requires repeated loading and unloading as Jackson’s force moves east on June 20."}]]}]]}]
3b:["$","div","Jackson halts at Frederick’s Hall",{"className":"moment","children":[["$","$L2c",null,{"seconds":1084,"label":"18:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson halts at Frederick’s Hall"}],["$","p",null,{"children":"On June 22 he rests the command while it remains about fifty miles from Richmond and extended along the route."}]]}]]}]
3c:["$","div","Jackson rides to Dabbs House",{"className":"moment","children":[["$","$L2c",null,{"seconds":1143,"label":"19:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson rides to Dabbs House"}],["$","p",null,{"children":"Leaving at 1 a.m. with an aide and guides, Jackson covers about fifty miles to Lee’s headquarters."}]]}]]}]
3d:["$","div","Division commanders assemble",{"className":"moment","children":[["$","$L2c",null,{"seconds":1192,"label":"19:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Division commanders assemble"}],["$","p",null,{"children":"Longstreet and A. P. Hill join Jackson and D. H. Hill for Lee’s June 23 conference."}]]}]]}]
3e:["$","div","Lee explains the plan over a map",{"className":"moment","children":[["$","$L2c",null,{"seconds":1303,"label":"21:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee explains the plan over a map"}],["$","p",null,{"children":"Jackson is to pass behind the Federal flank and push east while the other northern columns cross in sequence."}]]}]]}]
3f:["$","div","Movement is meant to force battle",{"className":"moment","children":[["$","$L2c",null,{"seconds":1425,"label":"23:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"Movement is meant to force battle"}],["$","p",null,{"children":"Threatening the Federal right and railroad is intended to draw McClellan from prepared defenses and give Lee the initiative."}]]}]]}]
40:["$","div","Strength estimates are qualified",{"className":"moment","children":[["$","$L2c",null,{"seconds":1503,"label":"25:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Strength estimates are qualified"}],["$","p",null,{"children":"The hosts note that sources disagree, then use roughly 85,000–90,000 Confederates after Jackson’s arrival."}]]}]]}]
41:["$","div","The plan’s flaws are identified",{"className":"moment","children":[["$","$L2c",null,{"seconds":1551,"label":"25:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The plan’s flaws are identified"}],["$","p",null,{"children":"The episode turns from the intended movement to Lee’s intelligence, coordination, timing, and command risks."}]]}]]}]
42:["$","div","Lee misreads Federal distribution",{"className":"moment","children":[["$","$L2c",null,{"seconds":1578,"label":"26:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee misreads Federal distribution"}],["$","p",null,{"children":"Only Porter and McCall remain north of the river; most of McClellan’s army faces the thinner Richmond line to the south."}]]}]]}]
43:["$","div","Everything depends on Jackson",{"className":"moment","children":[["$","$L2c",null,{"seconds":1630,"label":"27:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Everything depends on Jackson"}],["$","p",null,{"children":"Jackson’s approach must reach Branch and trigger the other columns, but timing and communication remain fragile."}]]}]]}]
44:["$","div","June 26 becomes the attack date",{"className":"moment","children":[["$","$L2c",null,{"seconds":1706,"label":"28:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"June 26 becomes the attack date"}],["$","p",null,{"children":"Jackson has about forty-eight hours after returning to his army to move the remaining distance into position."}]]}]]}]
45:["$","div","Written orders leave room for interpretation",{"className":"moment","children":[["$","$L2c",null,{"seconds":1748,"label":"29:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Written orders leave room for interpretation"}],["$","p",null,{"children":"Lee circulates instructions, but the episode judges them ambiguous on critical timing and relationships."}]]}]]}]
46:["$","div","Jackson begins another sleepless ride",{"className":"moment","children":[["$","$L2c",null,{"seconds":1767,"label":"29:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson begins another sleepless ride"}],["$","p",null,{"children":"The episode introduces fatigue as one factor in his subsequent conduct while rejecting it as a complete excuse."}]]}]]}]
47:["$","div","The marching column remains disorganized",{"className":"moment","children":[["$","$L2c",null,{"seconds":1884,"label":"31:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The marching column remains disorganized"}],["$","p",null,{"children":"Jackson returns to find progress slow after entrusting movement control to his chief of staff, Robert L. Dabney."}]]}]]}]
48:["$","div","Jackson is behind schedule",{"className":"moment","children":[["$","$L2c",null,{"seconds":1988,"label":"33:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson is behind schedule"}],["$","p",null,{"children":"Lee expects a 3 a.m. advance on June 26, but Jackson is still short of the required starting area near midnight."}]]}]]}]
