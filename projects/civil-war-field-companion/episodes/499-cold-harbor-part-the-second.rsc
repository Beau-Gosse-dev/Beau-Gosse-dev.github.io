10:["$","figure","The two battlefields today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-77.38%2C37.56%2C-77.20%2C37.70&layer=mapnik&marker=37.5892%2C-77.2886","title":"The two battlefields today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The two battlefields today"}],["$","span",null,{"children":"Cold Harbor and Bethesda Church were separated by roughly three miles. The Chickahominy River restricted movement south of the U.S. position."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],["$","small",null,{"children":"Interactive map: drag to pan and use the +/− controls to zoom."}]]}]]}]
11:["$","figure","Cold Harbor in the Overland campaign",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Cold Harbor in the Overland campaign at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland campaign route in eastern Virginia","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Cold Harbor in the Overland campaign"}],["$","span",null,{"children":"The fighting occurred east of the earlier Wilderness, Spotsylvania, and North Anna battlefields and close to Richmond. White House Landing on the Pamunkey River supplied Smith’s XVIII Corps."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/images/overland-campaign-1864-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99448882/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$f:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The June 1 Confederate counterattack had failed",{"className":"moment","children":[["$","$L18",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The June 1 Confederate counterattack had failed"}],["$","p",null,{"children":"Lee’s attempt to retake the Cold Harbor crossroads ended without dislodging Sheridan’s cavalry."}]]}]]}],["$","div","Wright’s VI Corps replaced Sheridan",{"className":"moment","children":[["$","$L18",null,{"seconds":112,"label":"1:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wright’s VI Corps replaced Sheridan"}],["$","p",null,{"children":"VI Corps reached Cold Harbor during the morning and occupied the cavalry breastworks north and west of the crossroads."}]]}]]}],["$","div","Smith’s XVIII Corps marched toward the wrong destination",{"className":"moment","children":[["$","$L18",null,{"seconds":128,"label":"2:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith’s XVIII Corps marched toward the wrong destination"}],["$","p",null,{"children":"Two mistaken orders sent Smith first toward New Castle and then New Castle Ferry instead of Cold Harbor."}]]}]]}],["$","div","Smith asked Grant for corrected orders",{"className":"moment","children":[["$","$L18",null,{"seconds":206,"label":"3:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith asked Grant for corrected orders"}],["$","p",null,{"children":"Finding no V or VI Corps at the ferry, Smith sent an aide to Grant and briefly began bridging the Pamunkey River."}]]}]]}],["$","div","Babcock redirected XVIII Corps",{"className":"moment","children":[["$","$L18",null,{"seconds":242,"label":"4:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Babcock redirected XVIII Corps"}],["$","p",null,{"children":"Orville Babcock told Smith that Cold Harbor was the intended destination. The corps reversed course in heat and heavy dust."}]]}]]}],["$","div","Meade gave Smith two incompatible tasks",{"className":"moment","children":[["$","$L18",null,{"seconds":294,"label":"4:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Meade gave Smith two incompatible tasks"}],["$","p",null,{"children":"Smith was ordered to hold the three-mile road to Bethesda Church and cooperate in an attack, though only about 10,000 of his men were present."}]]}]]}],["$","div","Wright waited for Smith",{"className":"moment","children":[["$","$L18",null,{"seconds":371,"label":"6:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wright waited for Smith"}],["$","p",null,{"children":"Although Meade ordered an immediate attack, Wright limited his action to strong skirmishing until XVIII Corps arrived."}]]}]]}],["$","div","VI and XVIII Corps formed an arched line",{"className":"moment","children":[["$","$L18",null,{"seconds":424,"label":"7:04"}],["$","div",null,{"children":[["$","h3",null,{"children":"VI and XVIII Corps formed an arched line"}],["$","p",null,{"children":"Wright deployed three divisions south and west of Cold Harbor. Smith extended the line north but had to use a full division to protect the exposed flank."}]]}]]}],["$","div","The U.S. attack began about 6 p.m.",{"className":"moment","children":[["$","$L18",null,{"seconds":507,"label":"8:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The U.S. attack began about 6 p.m."}],["$","p",null,{"children":"Four divisions from VI and XVIII Corps advanced across as much as 1,200 yards toward a partly entrenched Confederate line."}]]}]]}],["$","div","A ravine provided a covered approach",{"className":"moment","children":[["$","$L18",null,{"seconds":576,"label":"9:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"A ravine provided a covered approach"}],["$","p",null,{"children":"Where the two U.S. corps met, a ravine allowed troops to approach a gap near Thomas Clingman’s Confederate brigade."}]]}]]}],["$","div","Upton reached within 70 yards",{"className":"moment","children":[["$","$L18",null,{"seconds":632,"label":"10:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Upton reached within 70 yards"}],"$L19"]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}]]}]
