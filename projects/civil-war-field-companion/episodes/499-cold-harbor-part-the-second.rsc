19:["$","p",null,{"children":"Emory Upton’s brigade, led by about 1,500 men of the 2nd Connecticut Heavy Artillery, used the ravine to approach Clingman’s line."}]
1a:["$","div","Truex entered the Confederate flank",{"className":"moment","children":[["$","$L18",null,{"seconds":670,"label":"11:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Truex entered the Confederate flank"}],["$","p",null,{"children":"William Truex’s brigade moved around the position, captured several hundred men, and briefly opened a breach."}]]}]]}]
1b:["$","div","The breach received no reinforcements",{"className":"moment","children":[["$","$L18",null,{"seconds":689,"label":"11:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"The breach received no reinforcements"}],["$","p",null,{"children":"Kershaw brought parts of four Confederate brigades against the opening. Truex was wounded, and Upton withdrew after dark."}]]}]]}]
1c:["$","div","The June 1 attack ended with heavy losses",{"className":"moment","children":[["$","$L18",null,{"seconds":725,"label":"12:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"The June 1 attack ended with heavy losses"}],["$","p",null,{"children":"U.S. losses reached several thousand against about 600 Confederate casualties, and the main Confederate line remained intact."}]]}]]}]
1d:["$","div","Grant ordered Hancock to Cold Harbor",{"className":"moment","children":[["$","$L18",null,{"seconds":756,"label":"12:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant ordered Hancock to Cold Harbor"}],["$","p",null,{"children":"Grant directed II Corps to march south, join Wright and Smith, and participate in a larger attack."}]]}]]}]
1e:["$","div","Army headquarters blamed staff and corps failures",{"className":"moment","children":[["$","$L18",null,{"seconds":850,"label":"14:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Army headquarters blamed staff and corps failures"}],["$","p",null,{"children":"Grant and Meade were angry about Smith’s misdirection, Warren’s failure to attack an exposed Confederate column, and Wright’s delayed assault."}]]}]]}]
1f:["$","div","Smith rejected an immediate renewed attack",{"className":"moment","children":[["$","$L18",null,{"seconds":980,"label":"16:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Smith rejected an immediate renewed attack"}],["$","p",null,{"children":"He told Meade that ammunition shortages, an extended line, and troop exhaustion made an attack the next morning impractical."}]]}]]}]
20:["$","div","Hancock began a night march",{"className":"moment","children":[["$","$L18",null,{"seconds":1042,"label":"17:22"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hancock began a night march"}],["$","p",null,{"children":"A proposed shortcut narrowed until artillery and wagons could not pass, forcing the lead division to turn back and costing the corps several hours."}]]}]]}]
21:["$","div","II Corps arrived exhausted on June 2",{"className":"moment","children":[["$","$L18",null,{"seconds":1139,"label":"18:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"II Corps arrived exhausted on June 2"}],["$","p",null,{"children":"The leading division reached Cold Harbor about 6:30 a.m.; the remaining troops were still spread along the road."}]]}]]}]
22:["$","div","The assault was postponed",{"className":"moment","children":[["$","$L18",null,{"seconds":1166,"label":"19:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"The assault was postponed"}],["$","p",null,{"children":"Meade first set 5 p.m. on June 2, but Grant delayed the attack until 4:30 a.m. on June 3 so the corps could reconnoiter and coordinate."}]]}]]}]
23:["$","div","Lee attacked the U.S. right instead",{"className":"moment","children":[["$","$L18",null,{"seconds":1268,"label":"21:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee attacked the U.S. right instead"}],["$","p",null,{"children":"Seeing troops shift toward Cold Harbor, Lee ordered Jubal Early to turn the weakened U.S. flank near Bethesda Church."}]]}]]}]
24:["$","div","Heth reinforced Early",{"className":"moment","children":[["$","$L18",null,{"seconds":1338,"label":"22:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Heth reinforced Early"}],["$","p",null,{"children":"Henry Heth committed his full division, giving Early four divisions for the attack."}]]}]]}]
25:["$","div","The attack surprised Burnside",{"className":"moment","children":[["$","$L18",null,{"seconds":1394,"label":"23:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack surprised Burnside"}],["$","p",null,{"children":"Confederates captured most of a 600-man picket line, flanked two IX Corps brigades, and struck a V Corps division sent by Warren."}]]}]]}]
26:["$","div","Early lacked enough troops to turn the flank",{"className":"moment","children":[["$","$L18",null,{"seconds":1429,"label":"23:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Early lacked enough troops to turn the flank"}],["$","p",null,{"children":"The U.S. line bent but held. Early ended the attack after taking several hundred prisoners."}]]}]]}]
27:["$","div","Grant retained the initiative",{"className":"moment","children":[["$","$L18",null,{"seconds":1472,"label":"24:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant retained the initiative"}],["$","p",null,{"children":"With Lee’s third counterattack in four days unsuccessful, the planned U.S. assault at Cold Harbor remained scheduled for the next morning."}]]}]]}]
28:["$","h3",null,{"children":"William F. Smith"}]
29:["$","p",null,{"children":"Commanded XVIII Corps through two mistaken marches, the June 1 assault, and a severe ammunition shortage"}]
