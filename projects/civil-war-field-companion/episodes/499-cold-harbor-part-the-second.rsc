14:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L1c",null,{"guide":{"date":"June 1–2, 1864","place":"Cold Harbor and Bethesda Church, Hanover County, Virginia","result":"The U.S. attack on June 1 gained a temporary breach but did not break the Confederate line; Early’s June 2 counterattack also failed, and Grant scheduled a larger assault for June 3","facts":[{"label":"Smith’s troops initially present","value":"About 10,000"},{"label":"Cold Harbor–Bethesda Church road","value":"About 3 miles"},{"label":"Open ground before Confederate line","value":"About 1,200 yards"},{"label":"2nd Connecticut Heavy Artillery","value":"About 1,500 men"},{"label":"U.S. losses in June 1 attack","value":"Several thousand"},{"label":"Confederate losses in June 1 attack","value":"About 600"},{"label":"Early’s force on June 2","value":"4 divisions"},{"label":"U.S. pickets captured June 2","value":"Most of 600 men"}],"maps":[{"title":"Cold Harbor and Bethesda Church","caption":"The historical battle map shows the two areas covered in this episode. Wright and Smith attacked west from Cold Harbor on June 1; Early attacked east toward Bethesda Church on June 2.","source":"https://www.loc.gov/item/gvhs01.vhs00233/","image":"/images/cold-harbor-june-1-3-map.jpg","alt":"Historical map of the Cold Harbor and Bethesda Church battle lines"},{"title":"The two battlefields today","caption":"Cold Harbor and Bethesda Church were separated by roughly three miles. The Chickahominy River restricted movement south of the U.S. position.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-77.38%2C37.56%2C-77.20%2C37.70&layer=mapnik&marker=37.5892%2C-77.2886"},{"title":"Cold Harbor in the Overland campaign","caption":"The fighting occurred east of the earlier Wilderness, Spotsylvania, and North Anna battlefields and close to Richmond. White House Landing on the Pamunkey River supplied Smith’s XVIII Corps.","source":"https://www.loc.gov/item/99448882/","image":"/images/overland-campaign-1864-map.jpg","alt":"Historical map of the Overland campaign route in eastern Virginia"}],"moments":[{"time":"1:19","audioTime":79,"title":"The June 1 Confederate counterattack had failed","detail":"Lee’s attempt to retake the Cold Harbor crossroads ended without dislodging Sheridan’s cavalry."},{"time":"1:52","audioTime":112,"title":"Wright’s VI Corps replaced Sheridan","detail":"VI Corps reached Cold Harbor during the morning and occupied the cavalry breastworks north and west of the crossroads."},{"time":"2:08","audioTime":128,"title":"Smith’s XVIII Corps marched toward the wrong destination","detail":"Two mistaken orders sent Smith first toward New Castle and then New Castle Ferry instead of Cold Harbor."},{"time":"3:26","audioTime":206,"title":"Smith asked Grant for corrected orders","detail":"Finding no V or VI Corps at the ferry, Smith sent an aide to Grant and briefly began bridging the Pamunkey River."},{"time":"4:02","audioTime":242,"title":"Babcock redirected XVIII Corps","detail":"Orville Babcock told Smith that Cold Harbor was the intended destination. The corps reversed course in heat and heavy dust."},{"time":"4:54","audioTime":294,"title":"Meade gave Smith two incompatible tasks","detail":"Smith was ordered to hold the three-mile road to Bethesda Church and cooperate in an attack, though only about 10,000 of his men were present."},{"time":"6:11","audioTime":371,"title":"Wright waited for Smith","detail":"Although Meade ordered an immediate attack, Wright limited his action to strong skirmishing until XVIII Corps arrived."},{"time":"7:04","audioTime":424,"title":"VI and XVIII Corps formed an arched line","detail":"Wright deployed three divisions south and west of Cold Harbor. Smith extended the line north but had to use a full division to protect the exposed flank."},{"time":"8:27","audioTime":507,"title":"The U.S. attack began about 6 p.m.","detail":"Four divisions from VI and XVIII Corps advanced across as much as 1,200 yards toward a partly entrenched Confederate line."},{"time":"9:36","audioTime":576,"title":"A ravine provided a covered approach","detail":"Where the two U.S. corps met, a ravine allowed troops to approach a gap near Thomas Clingman’s Confederate brigade."},{"time":"10:32","audioTime":632,"title":"Upton reached within 70 yards","detail":"Emory Upton’s brigade, led by about 1,500 men of the 2nd Connecticut Heavy Artillery, used the ravine to approach Clingman’s line."},{"time":"11:10","audioTime":670,"title":"Truex entered the Confederate flank","detail":"William Truex’s brigade moved around the position, captured several hundred men, and briefly opened a breach."},{"time":"11:29","audioTime":689,"title":"The breach received no reinforcements","detail":"Kershaw brought parts of four Confederate brigades against the opening. Truex was wounded, and Upton withdrew after dark."},{"time":"12:05","audioTime":725,"title":"The June 1 attack ended with heavy losses","detail":"U.S. losses reached several thousand against about 600 Confederate casualties, and the main Confederate line remained intact."},{"time":"12:36","audioTime":756,"title":"Grant ordered Hancock to Cold Harbor","detail":"Grant directed II Corps to march south, join Wright and Smith, and participate in a larger attack."},{"time":"14:10","audioTime":850,"title":"Army headquarters blamed staff and corps failures","detail":"Grant and Meade were angry about Smith’s misdirection, Warren’s failure to attack an exposed Confederate column, and Wright’s delayed assault."},{"time":"16:20","audioTime":980,"title":"Smith rejected an immediate renewed attack","detail":"He told Meade that ammunition shortages, an extended line, and troop exhaustion made an attack the next morning impractical."},{"time":"17:22","audioTime":1042,"title":"Hancock began a night march","detail":"A proposed shortcut narrowed until artillery and wagons could not pass, forcing the lead division to turn back and costing the corps several hours."},{"time":"18:59","audioTime":1139,"title":"II Corps arrived exhausted on June 2","detail":"The leading division reached Cold Harbor about 6:30 a.m.; the remaining troops were still spread along the road."},{"time":"19:26","audioTime":1166,"title":"The assault was postponed","detail":"Meade first set 5 p.m. on June 2, but Grant delayed the attack until 4:30 a.m. on June 3 so the corps could reconnoiter and coordinate."},{"time":"21:08","audioTime":1268,"title":"Lee attacked the U.S. right instead","detail":"Seeing troops shift toward Cold Harbor, Lee ordered Jubal Early to turn the weakened U.S. flank near Bethesda Church."},{"time":"22:18","audioTime":1338,"title":"Heth reinforced Early","detail":"Henry Heth committed his full division, giving Early four divisions for the attack."},{"time":"23:14","audioTime":1394,"title":"The attack surprised Burnside","detail":"Confederates captured most of a 600-man picket line, flanked two IX Corps brigades, and struck a V Corps division sent by Warren."},{"time":"23:49","audioTime":1429,"title":"Early lacked enough troops to turn the flank","detail":"The U.S. line bent but held. Early ended the attack after taking several hundred prisoners."},{"time":"24:32","audioTime":1472,"title":"Grant retained the initiative","detail":"With Lee’s third counterattack in four days unsuccessful, the planned U.S. assault at Cold Harbor remained scheduled for the next morning."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"Ulysses S. Grant","command":"General-in-chief, U.S. armies","subordinates":"Ordered Hancock to Cold Harbor and set the June 3 assault"},{"commander":"George G. Meade","command":"Army of the Potomac","subordinates":"Placed Smith under operational control and issued field orders"},{"commander":"Horatio G. Wright","command":"VI Corps","subordinates":"Thomas Neill, David Russell, and James Ricketts divisions"},{"commander":"William F. “Baldy” Smith","command":"XVIII Corps, Army of the James","subordinates":"Charles Devens, William Brooks, and John Martindale divisions"},{"commander":"Winfield S. Hancock","command":"II Corps","subordinates":"Made the forced march to Cold Harbor during the night of June 1–2"},{"commander":"Ambrose E. Burnside","command":"IX Corps","subordinates":"Held the U.S. right near Bethesda Church"},{"commander":"Gouverneur K. Warren","command":"V Corps","subordinates":"Connected Burnside’s sector with the troops at Cold Harbor"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Robert E. Lee","command":"Army of Northern Virginia","subordinates":"Strengthened Cold Harbor and ordered the attack on the U.S. right"},{"commander":"Richard H. Anderson","command":"First Corps","subordinates":"Held the Confederate position west of Cold Harbor"},{"commander":"Robert F. Hoke","command":"Division","subordinates":"Defended the Cold Harbor line with Anderson’s corps"},{"commander":"Joseph B. Kershaw","command":"Division, First Corps","subordinates":"Organized the counterattack that closed the June 1 breach"},{"commander":"Jubal A. Early","command":"Second Corps","subordinates":"Led four divisions against Bethesda Church on June 2"},{"commander":"Henry Heth","command":"Division, Third Corps","subordinates":"Joined Early’s attack with his full division"}]}],"people":[{"name":"William F. Smith","role":"Commanded XVIII Corps through two mistaken marches, the June 1 assault, and a severe ammunition shortage","side":"United States","image":"/images/baldy-smith-cold-harbor.jpg","source":"https://www.loc.gov/item/2018670739/"},{"name":"Horatio G. Wright","role":"Commanded VI Corps and delayed his attack until Smith arrived","side":"United States"},{"name":"Emory Upton","role":"Used the ravine to bring his brigade close to the Confederate line","side":"United States"},{"name":"William S. Truex","role":"Led the brigade that entered Clingman’s flank and captured several hundred Confederates","side":"United States"},{"name":"Winfield S. Hancock","role":"Commanded II Corps during its difficult night march to Cold Harbor","side":"United States"},{"name":"Robert E. Lee","role":"Ordered the June 2 attack on the U.S. right after troop movements indicated that sector had weakened","side":"Confederacy","image":"/images/robert-e-lee-1864.jpg","source":"https://www.loc.gov/item/2018666540/"},{"name":"Jubal A. Early","role":"Surprised Burnside near Bethesda Church but could not turn the U.S. flank","side":"Confederacy"},{"name":"Joseph B. Kershaw","role":"Committed parts of four brigades to close the breach on June 1","side":"Confederacy"}],"losses":[{"name":"William S. Truex","side":"United States","role":"VI Corps brigade commander","outcome":"Wounded while his brigade held the temporary breach in the Confederate line; survived"}],"gallery":[{"image":"/images/cold-harbor-june-1-3-map.jpg","alt":"Historical map of the June 1 and June 3 Cold Harbor battle lines","caption":"The map includes the Cold Harbor line, Bethesda Church, the Chickahominy River, and the main roads.","source":"https://www.loc.gov/item/gvhs01.vhs00233/"},{"image":"/images/baldy-smith-cold-harbor.jpg","alt":"William F. Smith seated with his staff at Cold Harbor","caption":"Smith and his XVIII Corps staff in June 1864.","source":"https://www.loc.gov/item/2018670739/"},{"image":"/images/cold-harbor-battlefield.jpg","alt":"Stereographic photograph of the Cold Harbor battlefield","caption":"A wartime photograph shows the open ground and earthworks at Cold Harbor.","source":"https://www.loc.gov/item/2018666598/"}],"sources":[{"label":"Official Episode 499 page","url":"https://civilwarpodcast.org/2025/08/03/civil-war-podcast-episode-499/"},{"label":"National Park Service: Cold Harbor, Grant’s Greatest Regret","url":"https://www.nps.gov/articles/cold-harbor-grant-s-greatest-regret.htm"},{"label":"National Park Service Cold Harbor battlefield overview","url":"https://www.nps.gov/rich/learn/historyculture/cold-harbor.htm"},{"label":"Library of Congress Cold Harbor battle plan","url":"https://www.loc.gov/item/gvhs01.vhs00233/"},{"label":"Library of Congress William F. Smith and staff photograph","url":"https://www.loc.gov/item/2018670739/"},{"label":"Library of Congress Cold Harbor battlefield photograph","url":"https://www.loc.gov/item/2018666598/"}]}}]}]
