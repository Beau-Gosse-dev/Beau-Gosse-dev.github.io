36:["$","div","Reno speaks to Sturgis",{"className":"moment","children":[["$","$L30",null,{"seconds":932,"label":"15:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Reno speaks to Sturgis"}],["$","p",null,{"children":"The wounded corps commander recognizes his West Point classmate and friend, tells him he is dying, and dies soon afterward."}]]}]]}]
37:["$","div","IX Corps holds Fox’s Gap",{"className":"moment","children":[["$","$L30",null,{"seconds":963,"label":"16:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"IX Corps holds Fox’s Gap"}],["$","p",null,{"children":"The Confederate counterattack has failed; Garland’s and Drayton’s brigades have suffered especially severe losses."}]]}]]}]
38:["$","div","I Corps advances through Middletown",{"className":"moment","children":[["$","$L30",null,{"seconds":1082,"label":"18:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"I Corps advances through Middletown"}],["$","p",null,{"children":"Hooker’s command follows the National Road toward the northern part of the South Mountain position."}]]}]]}]
39:["$","div","Two division commands change",{"className":"moment","children":[["$","$L30",null,{"seconds":1124,"label":"18:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two division commands change"}],["$","p",null,{"children":"Meade replaces the detached Reynolds, and Hatch replaces the ailing King as the corps prepares to attack."}]]}]]}]
3a:["$","div","Burnside sets the double envelopment",{"className":"moment","children":[["$","$L30",null,{"seconds":1177,"label":"19:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Burnside sets the double envelopment"}],["$","p",null,{"children":"With IX Corps at Fox’s Gap, Hooker’s I Corps is directed around the opposite flank north of the National Road."}]]}]]}]
3b:["$","div","Hooker assigns the divisions",{"className":"moment","children":[["$","$L30",null,{"seconds":1220,"label":"20:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hooker assigns the divisions"}],["$","p",null,{"children":"Meade will attack the north ridge and ravine, Hatch the spur nearer Turner’s Gap, with Ricketts in reserve."}]]}]]}]
3c:["$","div","The attack steps off",{"className":"moment","children":[["$","$L30",null,{"seconds":1251,"label":"20:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"The attack steps off"}],["$","p",null,{"children":"Just before 5 p.m., the Federal formations begin climbing the steep, wooded ground."}]]}]]}]
3d:["$","div","Otis D. Smith remembers the ridge",{"className":"moment","children":[["$","$L30",null,{"seconds":1323,"label":"22:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Otis D. Smith remembers the ridge"}],["$","p",null,{"children":"The 6th Alabama private describes Rodes’s exposed position and a civilian who refuses to leave her mountain home."}]]}]]}]
3e:["$","div","Rodes’s regiments are spread thin",{"className":"moment","children":[["$","$L30",null,{"seconds":1439,"label":"23:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rodes’s regiments are spread thin"}],["$","p",null,{"children":"The difficult ground separates the Alabama units while Meade’s line extends well beyond the Confederate left."}]]}]]}]
3f:["$","div","Stevens brings a small reinforcement",{"className":"moment","children":[["$","$L30",null,{"seconds":1475,"label":"24:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Stevens brings a small reinforcement"}],["$","p",null,{"children":"About 550 South Carolinians join Rodes against roughly 4,000 Pennsylvania Reserves."}]]}]]}]
40:["$","div","Seymour takes the north ridge",{"className":"moment","children":[["$","$L30",null,{"seconds":1516,"label":"25:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Seymour takes the north ridge"}],["$","p",null,{"children":"His brigade drives back the 6th Alabama and turns Rodes’s left, opening the way for Meade’s other brigades."}]]}]]}]
41:["$","div","Ashbel F. Hill describes the pursuit",{"className":"moment","children":[["$","$L30",null,{"seconds":1574,"label":"26:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"Ashbel F. Hill describes the pursuit"}],["$","p",null,{"children":"The 8th Pennsylvania Reserves sergeant recalls flanking South Carolinians and the close-range violence on the rocky slope."}]]}]]}]
42:["$","div","Rodes’s first line breaks",{"className":"moment","children":[["$","$L30",null,{"seconds":1722,"label":"28:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rodes’s first line breaks"}],["$","p",null,{"children":"Federal soldiers press the retreating Alabamians from tree to tree and boulder to boulder."}]]}]]}]
