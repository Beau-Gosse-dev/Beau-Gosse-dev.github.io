48:["$","div","Darkness ends the fight",{"className":"moment","children":[["$","$L30",null,{"seconds":2083,"label":"34:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Darkness ends the fight"}],["$","p",null,{"children":"Confederates still occupy Turner’s Gap, but the Federal attacks have gained the heights and turned both flanks."}]]}]]}]
49:["$","div","McClellan reports victory",{"className":"moment","children":[["$","$L30",null,{"seconds":2114,"label":"35:14"}],["$","div",null,{"children":[["$","h3",null,{"children":"McClellan reports victory"}],["$","p",null,{"children":"At about 9:40 p.m. he tells Halleck that Hooker and Reno have carried the heights, while acknowledging uncertainty about the night."}]]}]]}]
4a:["$","div","The episode’s book is recommended",{"className":"moment","children":[["$","$L30",null,{"seconds":2171,"label":"36:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode’s book is recommended"}],["$","p",null,{"children":"The hosts recommend Brian Matthew Jordan’s “Unholy Sabbath: The Battle of South Mountain in History and Memory.”"}]]}]]}]
4b:["$","span",null,{"children":"Brig. Gen. Robert E. Rodes"}]
4c:["$","small",null,{"children":"About 1,200 men from five Alabama regiments defended the long, broken front north of Turner’s Gap; Col. John B. Gordon commanded the 6th Alabama"}]
4d:["$","div","Drayton’s Brigade, David R. Jones’s Division",{"className":"command-entry","children":[["$","strong",null,{"children":"Drayton’s Brigade, David R. Jones’s Division"}],["$","span",null,{"children":"Brig. Gen. Thomas F. Drayton"}],["$","small",null,{"children":"Held an exposed position at Fox’s Gap after the larger counterattack failed to form; the brigade lost about half its strength"}]]}]
4e:["$","div","Hood’s Division, Longstreet’s Wing",{"className":"command-entry","children":[["$","strong",null,{"children":"Hood’s Division, Longstreet’s Wing"}],["$","span",null,{"children":"Brig. Gen. John Bell Hood"}],["$","small",null,{"children":"Returned to command when Lee suspended his arrest and led two veteran brigades toward the final fighting at Fox’s Gap"}]]}]
