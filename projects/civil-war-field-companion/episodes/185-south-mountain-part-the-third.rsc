2e:["$","figure","An 1864 popular print of the battle",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep185-south-mountain-battle.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open An 1864 popular print of the battle at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep185-south-mountain-battle.jpg","alt":"Nineteenth-century lithograph of United States infantry advancing across fields during the Battle of South Mountain as artillery fires in the foreground.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"An 1864 popular print of the battle"}],["$","span",null,{"children":"This lithograph, deposited in 1864, depicts the 23rd and 12th Ohio attacking North Carolinians identified with Samuel Garland. It is a post-battle popular composition, not a precise field sketch of the afternoon actions covered in this episode."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep185-south-mountain-battle.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Prints and Photographs Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
2f:["$","div","Right Wing, Army of Northern Virginia-Maj. Gen. James Longstreet",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing, Army of Northern Virginia"}],["$","span",null,{"children":"Maj. Gen. James Longstreet"}],["$","small",null,{"children":"Marched reinforcements from Hagerstown; took battlefield command by seniority near 5 p.m. and warned Lee to prepare for retreat"}]]}]
30:["$","div","Hill’s Division and initial command at Fox’s and Turner’s Gaps-Maj. Gen. D. H. Hill",{"className":"command-entry","children":[["$","strong",null,{"children":"Hill’s Division and initial command at Fox’s and Turner’s Gaps"}],["$","span",null,{"children":"Maj. Gen. D. H. Hill"}],["$","small",null,{"children":"Placed Robert Rodes north of the National Road and assigned Roswell Ripley to coordinate the intended four-brigade counterattack at Fox’s Gap"}]]}]
31:["$","div","Rodes’s Brigade, Hill’s Division-Brig. Gen. Robert E. Rodes",{"className":"command-entry","children":[["$","strong",null,{"children":"Rodes’s Brigade, Hill’s Division"}],["$","span",null,{"children":"Brig. Gen. Robert E. Rodes"}],["$","small",null,{"children":"About 1,200 men from five Alabama regiments defended the long, broken front north of Turner’s Gap; Col. John B. Gordon commanded the 6th Alabama"}]]}]
32:["$","div","Drayton’s Brigade, David R. Jones’s Division-Brig. Gen. Thomas F. Drayton",{"className":"command-entry","children":[["$","strong",null,{"children":"Drayton’s Brigade, David R. Jones’s Division"}],["$","span",null,{"children":"Brig. Gen. Thomas F. Drayton"}],["$","small",null,{"children":"Held an exposed position at Fox’s Gap after the larger counterattack failed to form; the brigade lost about half its strength"}]]}]
33:["$","div","Hood’s Division, Longstreet’s Wing-Brig. Gen. John Bell Hood",{"className":"command-entry","children":[["$","strong",null,{"children":"Hood’s Division, Longstreet’s Wing"}],["$","span",null,{"children":"Brig. Gen. John Bell Hood"}],["$","small",null,{"children":"Returned to command when Lee suspended his arrest and led two veteran brigades toward the final fighting at Fox’s Gap"}]]}]
