2f:["$","figure","An 1864 popular print of the battle",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep185-south-mountain-battle.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open An 1864 popular print of the battle at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep185-south-mountain-battle.jpg","alt":"Nineteenth-century lithograph of United States infantry advancing across fields during the Battle of South Mountain as artillery fires in the foreground.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"An 1864 popular print of the battle"}],["$","span",null,{"children":"This lithograph, deposited in 1864, depicts the 23rd and 12th Ohio attacking North Carolinians identified with Samuel Garland. It is a post-battle popular composition, not a precise field sketch of the afternoon actions covered in this episode."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep185-south-mountain-battle.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Prints and Photographs Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
31:["$","div",null,{"children":[["$","h3",null,{"children":"Drayton’s brigade is shattered"}],["$","p",null,{"children":"The failure of the planned Confederate deployment leaves Drayton to absorb the main attack; about half the brigade is lost."}]]}]
32:["$","div","Hood’s veterans approach",{"className":"moment","children":[["$","$L30",null,{"seconds":737,"label":"12:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hood’s veterans approach"}],["$","p",null,{"children":"Hood’s two brigades reach the western base of the mountain after following D. R. Jones’s division from Hagerstown."}]]}]]}]
