1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",185," · ","September 14, 1862"," · ","Fox’s Gap, Turner’s Gap, and the high ground toward Frosttown Gap on South Mountain between Middletown and Boonsboro, Maryland"]}],["$","h1",null,{"children":"SOUTH MOUNTAIN (Part the Third)"}],["$","span",null,{"className":"result-label","children":"United States tactical victory on the northern South Mountain front. IX Corps held Fox’s Gap, and I Corps drove back the Confederate left north of Turner’s Gap. Confederate troops still occupied Turner’s Gap at dark, but both flanks had been turned and Robert E. Lee ordered the mountain line abandoned during the night"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1338378134.mp3?updated=1695462478","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"The afternoon fight at Fox’s Gap and the late attack north of Turner’s Gap"}],["$","small",null,{"children":"The episode resumes after Jacob Cox’s morning victory at Fox’s Gap. It follows the failed Confederate counterattack, Jesse Reno’s death, and Joseph Hooker’s I Corps assault toward Frosttown Gap. The next episode covers Crampton’s Gap and the Confederate withdrawal."}]]}],["$","div","Battle date",{"children":[["$","span",null,{"children":"Battle date"}],["$","strong",null,{"children":"Sunday, September 14, 1862"}],["$","small",null,{"children":"The engagements at Fox’s, Turner’s, Frosttown, and Crampton’s Gaps formed the Battle of South Mountain during the Maryland Campaign."}]]}],["$","div","Confederate purpose",{"children":[["$","span",null,{"children":"Confederate purpose"}],["$","strong",null,{"children":"Delay McClellan while Jackson completed the capture of Harpers Ferry"}],["$","small",null,{"children":"Lee rejected Longstreet’s proposal to concentrate immediately behind Antietam Creek. Holding the mountain passes protected the rear of the Confederate columns operating against Harpers Ferry and bought time for Lee’s divided army to reunite."}]]}],["$","div","Longstreet’s march",{"children":[["$","span",null,{"children":"Longstreet’s march"}],["$","strong",null,{"children":"From Hagerstown toward Boonsboro and South Mountain"}],["$","small",null,{"children":"Longstreet started about 8 a.m. The head of his column covered the roughly ten miles to Boonsboro in about four hours, then continued toward the summit in heat and choking dust. Later countermarching added distance for several brigades."}]]}],["$","div","Lee’s position",{"children":[["$","span",null,{"children":"Lee’s position"}],["$","strong",null,{"children":"Near the western foot of South Mountain with both hands splinted"}],["$","small",null,{"children":"Unable to ride or direct the fight closely, Lee left immediate battlefield control to D. H. Hill and then Longstreet. He encouraged the passing troops as Confederate reinforcements climbed toward the gaps."}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}],"$L25","$undefined","$L26",false,"$L27","$L28","$L29","$L2a","$L2b"]}]]}]
:HL["/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","style"     ]
e:["$","div","Hill’s intended counterattack",{"children":[["$","span",null,{"children":"Hill’s intended counterattack"}],["$","strong",null,{"children":"Four brigades were to retake Fox’s Gap"}],["$","small",null,{"children":"Roswell Ripley had tactical responsibility for coordinating the brigades of Ripley, George B. Anderson, George T. Anderson, and Thomas Drayton. Broken ground, dense vegetation, separation between units, and the renewed Federal advance prevented the concerted attack Hill intended."}]]}]
f:["$","div","Federal renewal at Fox’s Gap",{"children":[["$","span",null,{"children":"Federal renewal at Fox’s Gap"}],["$","strong",null,{"children":"Willcox advanced at about 4 p.m.; Sturgis supported him"}],["$","small",null,{"children":"Orlando B. Willcox’s division moved against the Confederate guns after a long midday lull. Samuel D. Sturgis’s division, with the brigades of James Nagle and Edward Ferrero, increased the pressure."}]]}]
10:["$","div","Drayton’s isolation",{"children":[["$","span",null,{"children":"Drayton’s isolation"}],["$","strong",null,{"children":"One Confederate brigade received the main Federal blow"}],["$","small",null,{"children":"The intended Confederate line never formed coherently. Drayton’s brigade, about 1,300 strong in the National Park Service account, was struck from more than one direction and lost about half its strength killed, wounded, or captured."}]]}]
11:["$","div","3rd South Carolina Battalion",{"children":[["$","span",null,{"children":"3rd South Carolina Battalion"}],["$","strong",null,{"children":"Only 24 of 160 men emerged unhurt"}],["$","small",null,{"children":"The battalion held until the last moment during Drayton’s collapse. Its commander, Lt. Col. George S. James, was killed."}]]}]
12:["$","div","Hood restored for battle",{"children":[["$","span",null,{"children":"Hood restored for battle"}],["$","strong",null,{"children":"Lee suspended John Bell Hood’s arrest without securing an apology"}],["$","small",null,{"children":"Hood had been under arrest after a dispute with Nathan G. “Shanks” Evans over captured ambulances. When Hood’s soldiers called for him, Lee returned him to command for the emergency, and Hood led his two brigades toward Fox’s Gap."}]]}]
13:["$","div","Reno’s death",{"children":[["$","span",null,{"children":"Reno’s death"}],["$","strong",null,{"children":"The IX Corps commander was mortally wounded near Fox’s Gap at dusk"}],["$","small",null,{"children":"Reno rode too near a Confederate position in the gathering darkness and was shot in the chest. He died while being carried down the mountain, near the ground where Confederate brigadier Samuel Garland had been mortally wounded earlier that day."}]]}]
14:["$","div","IX Corps losses",{"children":[["$","span",null,{"children":"IX Corps losses"}],["$","strong",null,{"children":"157 killed, 691 wounded, and 41 missing"}],["$","small",null,{"children":"The episode gives 889 IX Corps casualties at Fox’s Gap. The U.S. Army campaign study likewise describes Union losses there as approaching 900; it places Confederate losses above 1,100."}]]}]
15:["$","div","Double envelopment",{"children":[["$","span",null,{"children":"Double envelopment"}],["$","strong",null,{"children":"IX Corps attacked the Confederate right; I Corps attacked the left"}],["$","small",null,{"children":"Burnside’s right wing operated across a front approaching three miles. Reno’s corps fought at Fox’s Gap while Hooker’s corps moved north of the National Road toward the high ground around Frosttown Gap."}]]}]
16:["$","div","I Corps command changes",{"children":[["$","span",null,{"children":"I Corps command changes"}],["$","strong",null,{"children":"George Meade replaced John Reynolds; John Hatch replaced Rufus King"}],["$","small",null,{"children":"Pennsylvania’s governor had obtained Reynolds for state militia duty during the invasion emergency. King’s continuing health problems led to Hatch assuming his division on September 14. When Hatch was wounded, Abner Doubleday took command."}]]}]
17:["$","div","Hooker’s plan",{"children":[["$","span",null,{"children":"Hooker’s plan"}],["$","strong",null,{"children":"Meade on the right, Hatch on the left, Ricketts in reserve"}],["$","small",null,{"children":"Meade’s Pennsylvania Reserves were to seize the northern ridge and push through the ravine to turn the Confederate left. Hatch attacked the parallel spur closer to the National Road. James B. Ricketts’s division was available to support either attack."}]]}]
18:["$","div","Attack begins",{"children":[["$","span",null,{"children":"Attack begins"}],["$","strong",null,{"children":"Just before 5 p.m."}],["$","small",null,{"children":"The late start left little daylight. Steep, wooded, rocky ground disrupted alignment and coordination, but also concealed parts of the Federal advance."}]]}]
19:["$","div","Rodes’s force",{"children":[["$","span",null,{"children":"Rodes’s force"}],["$","strong",null,{"children":"About 1,200 Alabamians on a long, exposed front"}],["$","small",null,{"children":"Robert E. Rodes reported that the Federal line overlapped both ends of his brigade. His regiments were separated by difficult ground, and no substantial reinforcement reached the exposed far left during the initial attack."}]]}]
1a:["$","div","Stevens’s reinforcement",{"children":[["$","span",null,{"children":"Stevens’s reinforcement"}],["$","strong",null,{"children":"About 550 South Carolinians"}],["$","small",null,{"children":"Col. Peter F. Stevens led the small contingent from Nathan G. Evans’s brigade toward Rodes. Together the two Confederate forces numbered about 1,800 against roughly 4,000 men in Meade’s division."}]]}]
1b:["$","div","Seymour turns the flank",{"children":[["$","span",null,{"children":"Seymour turns the flank"}],["$","strong",null,{"children":"The Federal right gained the northern ridge"}],["$","small",null,{"children":"Truman Seymour’s brigade drove back the 6th Alabama and gained the commanding high ground. All three brigades of Meade’s division then pressed the Confederate retreat despite losing contact with one another in the rough terrain."}]]}]
1c:["$","div","Meade’s losses",{"children":[["$","span",null,{"children":"Meade’s losses"}],["$","strong",null,{"children":"Nearly 400 casualties at South Mountain"}],["$","small",null,{"children":"The Pennsylvania Reserves carried the difficult northern ground. Darkness finally ended their pursuit after Rodes formed another line about 200 yards north of the National Road."}]]}]
1d:["$","div","Hatch and Gibbon",{"children":[["$","span",null,{"children":"Hatch and Gibbon"}],["$","strong",null,{"children":"Hatch attacked the southern spur; Gibbon advanced on the National Road"}],["$","small",null,{"children":"Hatch’s division moved alongside Meade while John Gibbon’s “Black Hat” brigade fought directly up the road. The combined pressure turned the Confederate left and threatened Turner’s Gap."}]]}]
1e:["$","div","Hatch wounded",{"children":[["$","span",null,{"children":"Hatch wounded"}],["$","strong",null,{"children":"Shot through the right calf"}],["$","small",null,{"children":"Hatch was hit as his troops carried a stone-wall position. He left the field and transferred division command to Abner Doubleday."}]]}]
1f:["$","div","Longstreet takes field command",{"children":[["$","span",null,{"children":"Longstreet takes field command"}],["$","strong",null,{"children":"Near 5 p.m. at the Mountain House"}],["$","small",null,{"children":"By seniority Longstreet superseded D. H. Hill. He warned Lee to prepare for disappointment and a retreat while committing exhausted brigades that had marched as much as 18 to 20 miles before entering the fight."}]]}]
20:["$","div","Position at nightfall",{"children":[["$","span",null,{"children":"Position at nightfall"}],["$","strong",null,{"children":"The United States held Fox’s Gap and the high ground north of Turner’s Gap"}],["$","small",null,{"children":"Confederates still occupied Turner’s Gap itself, but their right had been displaced at Fox’s Gap and their left driven back. The position could not be held safely the next morning, and Lee withdrew after dark."}]]}]
21:["$","div","McClellan’s dispatch",{"children":[["$","span",null,{"children":"McClellan’s dispatch"}],["$","strong",null,{"children":"“The corps of Hooker and Reno have carried the heights”"}],["$","small",null,{"children":"At about 9:40 p.m. McClellan reported a “glorious victory” to Henry W. Halleck. He did not yet know the outcome of William B. Franklin’s separate fight at Crampton’s Gap six miles south."}]]}]
22:["$","div","Operational consequence",{"children":[["$","span",null,{"children":"Operational consequence"}],["$","strong",null,{"children":"A Confederate retreat, but enough delay to help the Harpers Ferry operation"}],["$","small",null,{"children":"The mountain defense did not stop McClellan. It did consume September 14, while Jackson’s forces completed the investment of Harpers Ferry, whose garrison surrendered the next morning."}]]}]
23:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Unholy Sabbath: The Battle of South Mountain in History and Memory”"}],["$","small",null,{"children":"The episode and the official podcast book list identify Brian Matthew Jordan’s study as the recommendation."}]]}]
24:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Rodes, Willcox, Nagle, Ferrero, Meade, Ricketts, Peter F. Stevens, Ashbel F. Hill, and Boonsboro"}],["$","small",null,{"children":"The automated transcript produces phonetic or simplified forms including “Rhodes,” “Wilcox,” “Nagel,” “Ferraro,” “Mead,” “Rickett,” and “Ashbilla.” Sources use both Frosttown and Frostown for the northern gap; this guide follows the Frosttown spelling on Sneden’s map and in the transcript. The earlier Second Manassas action mentioned in passing was Brawner’s Farm, not “Bronner’s Farm.”"}]]}]
25:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":["$undefined",["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
26:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The afternoon fight at Fox’s and Turner’s Gaps",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep185-fox-turner-overview.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The afternoon fight at Fox’s and Turner’s Gaps at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep185-fox-turner-overview.svg","alt":"Schematic map of IX Corps attacking Fox’s Gap and I Corps attacking Turner’s and Frosttown Gaps while Confederate reinforcements approach from Boonsboro.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The afternoon fight at Fox’s and Turner’s Gaps"}],["$","span",null,{"children":"South Mountain separated the Federal approach from Middletown and Bolivar on the east from Confederate reinforcements arriving through Boonsboro on the west. IX Corps attacked at Fox’s Gap while I Corps moved against the Confederate left north of the National Road. Hill’s planned four-brigade counterattack at Fox’s Gap never came together. Roads, formations, routes, and distances are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep185-fox-turner-overview.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History, National Park Service, Robert Knox Sneden map, Official Records, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Hooker’s attack north of Turner’s Gap",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep185-turner-frosttown-evening.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Hooker’s attack north of Turner’s Gap at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep185-turner-frosttown-evening.svg","alt":"Schematic tactical map of Meade and Hatch advancing west against Rodes and Stevens north of Turner’s Gap late on September 14, 1862.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Hooker’s attack north of Turner’s Gap"}],["$","span",null,{"children":"Meade’s division advanced on the Federal right to take the northern ridge and turn Rodes’s exposed left. Hatch’s division attacked the parallel spur closer to the National Road, with Ricketts initially in reserve. P. F. Stevens brought a small reinforcement to Rodes, while Longstreet sent additional brigades forward from Turner’s Gap. Terrain and unit geometry are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep185-turner-frosttown-evening.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$26:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History, Robert Rodes and Abner Doubleday official reports, Robert Knox Sneden map, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ","$L2c"]}]]}],"$undefined"]}]]}],"$L2d","$L2e"]}]]}]
27:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],[[["$","link","css:/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/page.CaPb9pvg.css"}],["$","link","css:/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css","data-rsc-css-href":"/projects/civil-war-field-companion/_next/static/css/index.DEVWAYsO.css"}],"$undefined"],[["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Army of the Potomac-Maj. Gen. George B. McClellan",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Directed the army’s advance across South Mountain; observed the northern battle from high ground near Bolivar and reported the victory to Henry W. Halleck that night"}]]}],["$","div","Right Wing, Army of the Potomac-Maj. Gen. Ambrose E. Burnside",{"className":"command-entry","children":[["$","strong",null,{"children":"Right Wing, Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. Ambrose E. Burnside"}],["$","small",null,{"children":"Coordinated Joseph Hooker’s I Corps and Jesse Reno’s IX Corps in the double envelopment of the Turner’s Gap position"}]]}],["$","div","IX Corps-Maj. Gen. Jesse L. Reno",{"className":"command-entry","children":[["$","strong",null,{"children":"IX Corps"}],["$","span",null,{"children":"Maj. Gen. Jesse L. Reno"}],["$","small",null,{"children":"Jacob D. Cox’s division held the morning gains; Orlando B. Willcox’s and Samuel D. Sturgis’s divisions renewed the attack at Fox’s Gap. Reno was mortally wounded at dusk"}]]}],["$","div","I Corps-Maj. Gen. Joseph Hooker",{"className":"command-entry","children":[["$","strong",null,{"children":"I Corps"}],["$","span",null,{"children":"Maj. Gen. Joseph Hooker"}],["$","small",null,{"children":"George G. Meade’s division attacked on the right, John P. Hatch’s on the left, and James B. Ricketts’s began in reserve north of the National Road"}]]}],["$","div","Pennsylvania Reserves Division, I Corps-Brig. Gen. George G. Meade",{"className":"command-entry","children":[["$","strong",null,{"children":"Pennsylvania Reserves Division, I Corps"}],["$","span",null,{"children":"Brig. Gen. George G. Meade"}],["$","small",null,{"children":"Truman Seymour, Albert L. Magilton, and Thomas F. Gallagher led its three brigades in the successful attack on Rodes’s exposed line"}]]}],["$","div","1st Division, I Corps-Brig. Gen. John P. Hatch",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Division, I Corps"}],["$","span",null,{"children":"Brig. Gen. John P. Hatch"}],["$","small",null,{"children":"Advanced on the spur nearer the National Road; after Hatch was wounded, Brig. Gen. Abner Doubleday assumed command"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Army of Northern Virginia-Gen. Robert E. Lee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of Northern Virginia"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Chose to contest South Mountain to protect the Harpers Ferry operation; remained near the western foot of the mountain and ordered withdrawal after dark"}]]}],"$L2f","$L30","$L31","$L32","$L33"]]}]]}],"$L34"]]]}]
28:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Maj. Gen. Jesse L. Reno",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Maj. Gen. Jesse L. Reno"}],["$","p",null,{"children":[["$","strong",null,{"children":["IX Corps commander","."]}]," ","Mortally wounded by a shot through the chest near Fox’s Gap at dusk on September 14; died while being carried from the field"]}]]}],["$","article","Brig. Gen. Samuel Garland Jr.",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Brig. Gen. Samuel Garland Jr."}],["$","p",null,{"children":[["$","strong",null,{"children":["Garland’s Brigade, D. H. Hill’s Division","."]}]," ","Mortally wounded during the morning fight at Fox’s Gap and died on September 14; his death is recapped at the start of this episode"]}]]}],["$","article","Lt. Col. George S. James",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Lt. Col. George S. James"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander, 3rd South Carolina Infantry Battalion","."]}]," ","Killed during the destruction of Drayton’s brigade at Fox’s Gap"]}]]}],["$","article","Brig. Gen. John P. Hatch",{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Brig. Gen. John P. Hatch"}],["$","p",null,{"children":[["$","strong",null,{"children":["1st Division, I Corps","."]}]," ","Wounded by a bullet through the right calf and carried from the field; Abner Doubleday assumed command"]}]]}]]}]]}]
29:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep185-fox-turner-overview.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep185-fox-turner-overview.svg","alt":"Schematic map of the afternoon battle at Fox’s, Turner’s, and Frosttown Gaps.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"IX Corps renewed the attack at Fox’s Gap while I Corps moved against the high ground north of Turner’s Gap. Confederate reinforcements arrived from the west, but Hill’s planned counterattack at Fox’s Gap never formed coherently."}]]}],["$","figure","/images/ep185-turner-frosttown-evening.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep185-turner-frosttown-evening.svg","alt":"Schematic tactical map of Hooker’s late attack north of Turner’s Gap.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Meade’s division gained the north ridge and turned Rodes’s exposed left while Hatch advanced on the spur nearer the National Road. Darkness stopped the pursuit after the Confederate line had been forced back toward the gap."}]]}],["$","figure","/images/ep185-sneden-south-mountain-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep185-sneden-south-mountain-map.jpg","alt":"Robert Knox Sneden’s hand-drawn color map of Fox’s and Turner’s Gaps and the surrounding roads and terrain.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Robert Knox Sneden’s participant-era map places the two gaps, the National and Old Sharpsburg Roads, Boonsboro, Frosttown, and colored troop positions in one field of view."}]]}],["$","figure","/images/ep185-south-mountain-battle.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep185-south-mountain-battle.jpg","alt":"Nineteenth-century lithograph of infantry and artillery fighting at South Mountain.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"“The battle of South Mountain, MD. Sunday, Sept. 14, 1862,” a popular print deposited in 1864. It memorializes the Ohio attack associated with Garland’s North Carolinians rather than recording the field with topographic precision."}]]}],["$","figure","/images/ep185-jesse-reno.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep185-jesse-reno.jpg","alt":"Carte-de-visite portrait of United States major general Jesse L. Reno in uniform.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jesse L. Reno commanded IX Corps after Burnside moved up to wing command. Reno was mortally wounded near Fox’s Gap at dusk on September 14, 1862."}]]}]]}]]}]
