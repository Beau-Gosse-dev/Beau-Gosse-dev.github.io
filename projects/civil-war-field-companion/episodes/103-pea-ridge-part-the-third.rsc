18:["$","aside",null,{"className":"automation-note","children":[["$","strong",null,{"children":"Best-effort automated guide"}],["$","p",null,{"children":"This guide was drafted from machine transcription and automated research, then checked before publication. Errors may remain. A public correction and suggestion workflow is planned."}]]}]
1a:["$","div",null,{"children":[["$","h3",null,{"children":"Curtis sent Osterhaus toward Leetown"}],["$","p",null,{"children":"Curtis first treated the movement on Ford Road as the main threat. He ordered Peter Osterhaus to take a division-sized force through Leetown toward Twelve Corner Church."}]]}]
1b:["$","div","Curtis learned that Elkhorn Tavern was also threatened",{"className":"moment","children":[["$","$L19",null,{"seconds":714,"label":"11:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Curtis learned that Elkhorn Tavern was also threatened"}],["$","p",null,{"children":"Weston reported that Confederate strength was growing north of the tavern and requested immediate reinforcement. Curtis now faced two attacks about two miles apart."}]]}]]}]
1c:["$","div","Dodge’s unauthorized move put his brigade in the right place",{"className":"moment","children":[["$","$L19",null,{"seconds":834,"label":"13:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Dodge’s unauthorized move put his brigade in the right place"}],["$","p",null,{"children":"After building the roadblocks, Dodge pulled his brigade from Little Sugar Creek toward the rear without orders. Curtis found it nearby and sent Eugene Carr with it to Elkhorn Tavern."}]]}]]}]
1d:["$","div","Carr reinforced Elkhorn Tavern",{"className":"moment","children":[["$","$L19",null,{"seconds":891,"label":"14:51"}],["$","div",null,{"children":[["$","h3",null,{"children":"Carr reinforced Elkhorn Tavern"}],["$","p",null,{"children":"Carr and Dodge brought about 1,250 men and a six-gun battery. Carr placed artillery above Cross Timber Hollow and soon reported that the Confederate force was larger than a diversion."}]]}]]}]
1e:["$","div","Carr fell back to the tavern",{"className":"moment","children":[["$","$L19",null,{"seconds":989,"label":"16:29"}],["$","div",null,{"children":[["$","h3",null,{"children":"Carr fell back to the tavern"}],["$","p",null,{"children":"By about 12:30 p.m., Confederate fire had disabled all but one of Carr’s first guns. Carr withdrew from Cross Timber Hollow as William Vandever’s brigade and an Iowa battery arrived."}]]}]]}]
1f:["$","div","The episode shifts to Leetown",{"className":"moment","children":[["$","$L19",null,{"seconds":1124,"label":"18:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode shifts to Leetown"}],["$","p",null,{"children":"The Elkhorn Tavern fight paused while Van Dorn and Price moved troops through difficult wooded terrain. Two miles west, Osterhaus advanced to locate McCulloch’s column."}]]}]]}]
20:["$","div","Osterhaus placed infantry at Oberson’s Field",{"className":"moment","children":[["$","$L19",null,{"seconds":1164,"label":"19:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Osterhaus placed infantry at Oberson’s Field"}],["$","p",null,{"children":"Osterhaus left his infantry and artillery along the south edge of the field. He took about 600 cavalrymen and three guns north to scout beyond the trees."}]]}]]}]
21:["$","div","Osterhaus found McCulloch’s division",{"className":"moment","children":[["$","$L19",null,{"seconds":1257,"label":"20:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Osterhaus found McCulloch’s division"}],["$","p",null,{"children":"Beyond the trees, the United States cavalry saw about 7,000 Confederates marching east on Ford Road. The head of the column was close to Curtis’s headquarters and wagon park."}]]}]]}]
22:["$","div","Elbert’s battery opened fire",{"className":"moment","children":[["$","$L19",null,{"seconds":1321,"label":"22:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Elbert’s battery opened fire"}],["$","p",null,{"children":"Osterhaus ordered three James rifles to fire on the marching column. The attack delayed McCulloch and protected the United States right flank until reinforcements could arrive."}]]}]]}]
23:["$","div","Confederate cavalry overran the guns",{"className":"moment","children":[["$","$L19",null,{"seconds":1344,"label":"22:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate cavalry overran the guns"}],["$","p",null,{"children":"James McIntosh sent about 3,000 Texas and Arkansas horsemen against roughly 600 United States cavalrymen. The charge captured the three guns and scattered their supports."}]]}]]}]
24:["$","div","Pike’s troops struck two Iowa cavalry companies",{"className":"moment","children":[["$","$L19",null,{"seconds":1456,"label":"24:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Pike’s troops struck two Iowa cavalry companies"}],["$","p",null,{"children":"Companies A and B of the 3rd Iowa Cavalry encountered Creek and Cherokee troops near Foster Lane. Private Albert Power returned under fire to rescue a dismounted comrade and later received the Medal of Honor."}]]}]]}]
25:["$","div","The United States cavalry retreated to Oberson’s Field",{"className":"moment","children":[["$","$L19",null,{"seconds":1517,"label":"25:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"The United States cavalry retreated to Oberson’s Field"}],["$","p",null,{"children":"Nicholas Greusel kept his infantry steady along the south edge of the field while cavalrymen and loose horses passed through the line."}]]}]]}]
26:["$","div","McCulloch stopped his march and formed for attack",{"className":"moment","children":[["$","$L19",null,{"seconds":1622,"label":"27:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCulloch stopped his march and formed for attack"}],["$","p",null,{"children":"Saul Ross reported a substantial United States line at Oberson’s Field. McCulloch deployed infantry on both sides of Leetown Road, with McIntosh’s cavalry and Pike’s troops behind it."}]]}]]}]
27:["$","div","McCulloch rode forward to reconnoiter",{"className":"moment","children":[["$","$L19",null,{"seconds":1768,"label":"29:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCulloch rode forward to reconnoiter"}],["$","p",null,{"children":"At about 1:30 p.m., McCulloch approached the north edge of Oberson’s Field alone. Skirmishers from the 36th Illinois were hidden along the fence line roughly 70 yards away."}]]}]]}]
28:["$","div","United States skirmishers killed McCulloch",{"className":"moment","children":[["$","$L19",null,{"seconds":1836,"label":"30:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States skirmishers killed McCulloch"}],["$","p",null,{"children":"A volley struck McCulloch, including a fatal shot through the chest. His staff did not see him fall, and the loss was not immediately communicated across the division."}]]}]]}]
29:["$","div","McIntosh took command and was also killed",{"className":"moment","children":[["$","$L19",null,{"seconds":1872,"label":"31:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"McIntosh took command and was also killed"}],["$","p",null,{"children":"McIntosh advanced with the 2nd Arkansas Mounted Rifles instead of launching the planned general attack. United States fire killed him within minutes of McCulloch."}]]}]]}]
2a:["$","div","Command failed west of Leetown Road",{"className":"moment","children":[["$","$L19",null,{"seconds":1906,"label":"31:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Command failed west of Leetown Road"}],["$","p",null,{"children":"Regimental commanders halted and waited for orders. Senior surviving officer Louis Hébert was in Morgan’s Woods and did not know that command had passed to him."}]]}]]}]
2b:["$","div","Hébert attacked through Morgan’s Woods",{"className":"moment","children":[["$","$L19",null,{"seconds":1955,"label":"32:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hébert attacked through Morgan’s Woods"}],["$","p",null,{"children":"Hébert’s four regiments moved against Osterhaus’s right. Thick woods disrupted the Confederate line and gave Jefferson C. Davis enough time to arrive with reinforcements."}]]}]]}]
2c:["$","div","Davis and Hébert fought at close range",{"className":"moment","children":[["$","$L19",null,{"seconds":2005,"label":"33:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"Davis and Hébert fought at close range"}],["$","p",null,{"children":"The two forces fought in dense brush for almost an hour. Davis withdrew to Oberson’s Field around 3 p.m., and Hébert’s men followed into United States artillery fire."}]]}]]}]
2d:["$","div","The supporting Confederate attack never came",{"className":"moment","children":[["$","$L19",null,{"seconds":2045,"label":"34:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"The supporting Confederate attack never came"}],["$","p",null,{"children":"Five Arkansas, six Texas, and two Indian regiments west of Leetown Road remained idle after losing their commanders. Hébert’s unsupported troops withdrew into Morgan’s Woods."}]]}]]}]
2e:["$","div","McCulloch’s division broke apart",{"className":"moment","children":[["$","$L19",null,{"seconds":2078,"label":"34:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"McCulloch’s division broke apart"}],["$","p",null,{"children":"The Leetown fighting ended with the Confederate division fragmented and moving away in several directions. Most of half of Van Dorn’s army was no longer available to support the continuing attack at Elkhorn Tavern."}]]}]]}]
2f:["$","article","Louis Hébert",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/louis-hebert.jpg","alt":"Portrait of Louis Hébert","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Louis Hébert"}],["$","p",null,{"children":"Led four Confederate regiments through Morgan’s Woods and became the division’s senior surviving officer"}]]}]]}]
30:["$","article","Samuel R. Curtis",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/samuel-r-curtis.jpg","alt":"Portrait of Samuel R. Curtis","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Samuel R. Curtis"}],["$","p",null,{"children":"Responded to attacks in the army’s rear by sending forces to both Elkhorn Tavern and Leetown"}]]}]]}]
31:["$","article","Earl Van Dorn",{"className":"person-card","children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/earl-van-dorn.jpg","alt":"Portrait of Earl Van Dorn","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Earl Van Dorn"}],["$","p",null,{"children":"Divided the Army of the West and remained with Price at Elkhorn Tavern"}]]}]]}]
32:["$","article","Eugene A. Carr",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"EA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Eugene A. Carr"}],["$","p",null,{"children":"Commanded the United States defense around Elkhorn Tavern"}]]}]]}]
33:["$","article","Peter J. Osterhaus",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"PJ"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Peter J. Osterhaus"}],["$","p",null,{"children":"Found and delayed McCulloch’s division near Leetown"}]]}]]}]
34:["$","article","James McIntosh",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JM"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"James McIntosh"}],["$","p",null,{"children":"Led the cavalry charge that captured Elbert’s guns and briefly succeeded McCulloch"}]]}]]}]
35:["$","article","Grenville M. Dodge",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"GM"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Grenville M. Dodge"}],["$","p",null,{"children":"Blocked the Bentonville Detour and moved his brigade toward the army’s rear before receiving orders"}]]}]]}]
36:["$","article","Albert Power",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"AP"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"Albert Power"}],["$","p",null,{"children":"3rd Iowa cavalryman who rescued a dismounted comrade and later received the Medal of Honor"}]]}]]}]
