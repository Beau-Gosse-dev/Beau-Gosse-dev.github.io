ojects/civil-war-field-companion/images/ben-mcculloch.jpg","alt":"Portrait of Benjamin McCulloch","width":420,"height":520,"loading":"lazy"}],["$","div",null,{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Benjamin McCulloch"}],["$","p",null,{"children":"Commanded the Confederate division at Leetown and was killed while reconnoitering the United States line"}]]}]]}],"$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36"]}]]}]
