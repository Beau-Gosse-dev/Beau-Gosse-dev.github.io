d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",103," · ","March 6–7, 1862"," · ","Bentonville Detour, Elkhorn Tavern, Leetown, Oberson’s Field, and Morgan’s Woods at Pea Ridge, Arkansas"]}],["$","h1",null,{"children":"PEA RIDGE (Part the Third)"}],["$","span",null,{"className":"result-label","children":"On the first day at Pea Ridge, the battle split into separate fights at Elkhorn Tavern and Leetown. The Leetown attack failed after Ben McCulloch and James McIntosh were killed and Louis Hébert’s isolated brigade was repulsed. Most of McCulloch’s division left the field without reaching Van Dorn and Price at Elkhorn Tavern"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"March 6–7, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Bentonville Detour, Elkhorn Tavern, Leetown, Oberson’s Field, and Morgan’s Woods at Pea Ridge, Arkansas"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"On the first day at Pea Ridge, the battle split into separate fights at Elkhorn Tavern and Leetown. The Leetown attack failed after Ben McCulloch and James McIntosh were killed and Louis Hébert’s isolated brigade was repulsed. Most of McCulloch’s division left the field without reaching Van Dorn and Price at Elkhorn Tavern"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],["$","table",null,{"children":[["$","caption",null,{"children":"Figures reported in this guide"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Scope"}],["$","th",null,{"scope":"col","children":"Reported figure"}]]}]}],["$","tbody",null,{"children":[["$","tr","McCulloch’s division",{"children":[["$","th",null,{"scope":"row","children":"McCulloch’s division"}],["$","td",null,{"children":["About 7,000 men","$undefined"]}]]}],["$","tr","Carr’s first reinforcement at Elkhorn",{"children":[["$","th",null,{"scope":"row","children":"Carr’s first reinforcement at Elkhorn"}],["$","td",null,{"children":["About 1,250 men and six guns","$undefined"]}]]}]]}]]}],["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.libsyn.com/103-pea-ridge-part-the-third",{"href":"https://civilwarpodcast.libsyn.com/103-pea-ridge-part-the-third","target":"_blank","rel":"noreferrer","children":["Source: ","Civil War Podcast episode 103"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16"]}]]}],"$undefined"]}],"$L17","$L18","$L19",false,"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}]]}]
