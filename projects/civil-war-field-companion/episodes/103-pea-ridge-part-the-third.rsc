1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",103," · ","March 6–7, 1862"," · ","Bentonville Detour, Elkhorn Tavern, Leetown, Oberson’s Field, and Morgan’s Woods at Pea Ridge, Arkansas"]}],["$","h1",null,{"children":"PEA RIDGE (Part the Third)"}],["$","span",null,{"className":"result-label","children":"On the first day at Pea Ridge, the battle split into separate fights at Elkhorn Tavern and Leetown. The Leetown attack failed after Ben McCulloch and James McIntosh were killed and Louis Hébert’s isolated brigade was repulsed. Most of McCulloch’s division left the field without reaching Van Dorn and Price at Elkhorn Tavern"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6153908003.mp3?updated=1695129154","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Battle began",{"children":[["$","span",null,{"children":"Battle began"}],["$","strong",null,{"children":"March 7, 1862"}],"$undefined"]}],["$","div","Separate actions",{"children":[["$","span",null,{"children":"Separate actions"}],["$","strong",null,{"children":"Elkhorn Tavern and Leetown, about two miles apart"}],"$undefined"]}],["$","div","McCulloch’s division",{"children":[["$","span",null,{"children":"McCulloch’s division"}],["$","strong",null,{"children":"About 7,000 men"}],"$undefined"]}],["$","div","Osterhaus’s first contact",{"children":[["$","span",null,{"children":"Osterhaus’s first contact"}],["$","strong",null,{"children":"About 600 cavalry and three guns"}],"$undefined"]}],["$","div","Osterhaus before reinforcement",{"children":[["$","span",null,{"children":"Osterhaus before reinforcement"}],["$","strong",null,{"children":"About 1,600 infantry, nine guns, and surviving cavalry"}],"$undefined"]}],["$","div","Carr’s first reinforcement at Elkhorn",{"children":[["$","span",null,{"children":"Carr’s first reinforcement at Elkhorn"}],["$","strong",null,{"children":"About 1,250 men and six guns"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","Pea Ridge today",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame interactive-map-frame","children":["$","iframe",null,{"src":"https://www.openstreetmap.org/export/embed.html?bbox=-94.09%2C36.41%2C-93.89%2C36.52&layer=mapnik&marker=36.454%2C-94.034","title":"Pea Ridge today","loading":"lazy"}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Pea Ridge today"}],["$","span",null,{"children":"The preserved battlefield lies northeast of Bentonville. Elkhorn Tavern is on the east side of the park; Leetown and Oberson’s Field are roughly two miles to the west."}],["$","span",null,{"className":"map-actions","children":["$undefined",["$","a",null,{"href":"https://www.openstreetmap.org/copyright","target":"_blank","rel":"noreferrer","children":["Map source ","$Le"]}]]}],"$Lf"]}]]}],"$L10","$L11","$L12"]}]]}],"$L13","$L14","$L15","$L16","$L17","$L18"]}]]}]
