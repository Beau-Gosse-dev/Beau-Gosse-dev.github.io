16:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/pea-ridge-oberson-field.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/pea-ridge-oberson-field.jpg","alt":"Oberson’s Field at the Leetown battlefield with woods beyond the open ground","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Osterhaus placed United States infantry along the south edge of Oberson’s Field. McCulloch’s planned attack would have emerged from the far tree line."}]]}],["$","figure","/images/pea-ridge-leetown-field.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/pea-ridge-leetown-field.jpg","alt":"Leetown battlefield and Oberson’s Field at Pea Ridge National Military Park","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The open ground at Leetown. McCulloch and McIntosh were killed near the field’s north boundary."}]]}],["$","figure","/images/pea-ridge-battle-print.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/pea-ridge-battle-print.jpg","alt":"1889 chromolithograph of fighting at Pea Ridge","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Kurz & Allison’s 1889 print is a later artistic interpretation of the battle and includes American Indian troops."}]]}]]}]]}]
