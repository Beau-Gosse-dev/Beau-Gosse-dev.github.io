10:["$","figure","Two fights on March 7",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/pea-ridge-march-7-map.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Two fights on March 7 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/pea-ridge-march-7-map.svg","alt":"Schematic map of the March 7 fighting at Elkhorn Tavern and Leetown with United States forces in blue and Confederate forces in red","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Two fights on March 7"}],["$","span",null,{"children":"Van Dorn and Price moved south on the Telegraph Road toward Elkhorn Tavern. McCulloch’s division moved east on Ford Road and encountered Osterhaus near Leetown. Blue marks United States positions and movements; red marks Confederate positions and attacks."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/pea-ridge-march-7-map.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/peri/planyourvisit/stop-3-leetown-battlefield.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
11:["$","figure","How Van Dorn reached the United States rear",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/pea-ridge-bentonville-detour.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open How Van Dorn reached the United States rear at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/pea-ridge-bentonville-detour.jpg","alt":"National Park Service map of the Bentonville Detour and the armies near Little Sugar Creek and Pea Ridge","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"How Van Dorn reached the United States rear"}],["$","span",null,{"children":"The National Park Service map shows the Bentonville Detour around Curtis’s prepared line at Little Sugar Creek. Federal roadblocks delayed the Confederate column and contributed to Van Dorn’s decision to divide it."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/pea-ridge-bentonville-detour.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.nps.gov/peri/planyourvisit/bentonville-detour.htm","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
12:["$","figure","Battlefield roads and terrain",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/pea-ridge-battlefield-map.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Battlefield roads and terrain at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/pea-ridge-battlefield-map.jpg","alt":"1876 map of the Pea Ridge battlefield showing roads, settlements, terrain, and troop positions","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Battlefield roads and terrain"}],["$","span",null,{"children":"This 1876 U.S. Army map identifies the Telegraph Road, Elkhorn Tavern, Leetown, Cross Timber Hollow, the ridge, fields, and wooded ground. Its troop positions depict March 8, but the terrain and road network also explain the divided fighting on March 7."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/pea-ridge-battlefield-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"https://www.loc.gov/item/99447263/","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$e:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}]
13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Curtis waited at Little Sugar Creek",{"className":"moment","children":[["$","$L19",null,{"seconds":66,"label":"1:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Curtis waited at Little Sugar Creek"}],["$","p",null,{"children":"After Sigel escaped Bentonville, Curtis concentrated the Army of the Southwest behind a prepared position along the Telegraph Road. Van Dorn decided to move around it and sever the road to Missouri."}]]}]]}],["$","div","The Confederate night march began",{"className":"moment","children":[["$","$L19",null,{"seconds":211,"label":"3:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate night march began"}],["$","p",null,{"children":"At 8 p.m. on March 6, Van Dorn sent his exhausted army onto the Bentonville Detour. Many soldiers had marched more than 50 miles in cold weather during the previous 60 hours."}]]}]]}],["$","div","Van Dorn had left logistics behind",{"className":"moment","children":[["$","$L19",null,{"seconds":228,"label":"3:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Van Dorn had left logistics behind"}],["$","p",null,{"children":"The supply train carrying tents, food, baggage, and extra ammunition had been ordered to follow the fast-moving army. Van Dorn also continued to assume that Curtis intended to retreat."}]]}]]}],["$","div","Cold and exhaustion broke down the column",{"className":"moment","children":[["$","$L19",null,{"seconds":377,"label":"6:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cold and exhaustion broke down the column"}],["$","p",null,{"children":"Men and whole companies fell out along the detour. The army had little food and sleep after several days of forced marching."}]]}]]}],["$","div","The 4th Iowa blocked the detour",{"className":"moment","children":[["$","$L19",null,{"seconds":443,"label":"7:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"The 4th Iowa blocked the detour"}],["$","p",null,{"children":"Grenville Dodge proposed obstructing the road as a precaution. His men felled trees at two places and delayed the Confederate advance for several hours."}]]}]]}],["$","div","Van Dorn reached the Telegraph Road after dawn",{"className":"moment","children":[["$","$L19",null,{"seconds":507,"label":"8:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Van Dorn reached the Telegraph Road after dawn"}],["$","p",null,{"children":"The head of the Confederate column entered Curtis’s rear on March 7, but much of the army remained on the clogged detour. Van Dorn decided not to wait for it to close up."}]]}]]}],["$","div","Van Dorn divided the army",{"className":"moment","children":[["$","$L19",null,{"seconds":546,"label":"9:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Van Dorn divided the army"}],["$","p",null,{"children":"McCulloch’s division, including Albert Pike’s Indian troops, turned east on Ford Road. Van Dorn and Price continued toward the Telegraph Road and Elkhorn Tavern."}]]}]]}],["$","div","Eli Weston guarded the army’s rear",{"className":"moment","children":[["$","$L19",null,{"seconds":574,"label":"9:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"Eli Weston guarded the army’s rear"}],["$","p",null,{"children":"Weston had six companies of the 24th Missouri and two cavalry companies around Elkhorn Tavern. His pickets reported Confederates on the Telegraph and Ford roads after sunrise."}]]}]]}],["$","div","The first firing began north of Elkhorn Tavern",{"className":"moment","children":[["$","$L19",null,{"seconds":634,"label":"10:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"The first firing began north of Elkhorn Tavern"}],["$","p",null,{"children":"United States infantry from Weston’s command met Confederate cavalry about three-quarters of a mile north of the tavern."}]]}]]}],["$","div","Curtis sent Osterhaus toward Leetown",{"className":"moment","children":[["$","$L19",null,{"seconds":651,"label":"10:51"}],"$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e"]}]]}]
