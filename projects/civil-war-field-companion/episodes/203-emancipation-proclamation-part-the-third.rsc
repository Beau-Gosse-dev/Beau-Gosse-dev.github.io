55:["$","div","The proposal exceeds earlier federal policy",{"className":"moment","children":[["$","$L37",null,{"seconds":816,"label":"13:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The proposal exceeds earlier federal policy"}],["$","p",null,{"children":"It no longer depends on proving that each individual enslaver is disloyal before the freedom policy applies."}]]}]]}]
