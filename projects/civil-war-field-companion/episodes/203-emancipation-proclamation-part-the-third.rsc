1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",203," · ","April 16–September 22, 1862"," · ","Washington, D.C.; Harrison’s Landing on the James River, Virginia; northern Virginia; and the Antietam battlefield near Sharpsburg, Maryland"]}],["$","h1",null,{"children":"EMANCIPATION PROCLAMATION (Part the Third)"}],["$","span",null,{"className":"result-label","children":"Congress abolished slavery in the District of Columbia and enacted the Second Confiscation Act, which freed specified people enslaved by persons supporting the rebellion and strengthened federal non-return policy. Lincoln concluded that broader emancipation was a military necessity, read a three-sentence draft to his cabinet on July 22, and accepted William H. Seward’s advice to wait for military success before issuing it. After Lee’s Maryland campaign ended in retreat following Antietam, Lincoln issued the preliminary Emancipation Proclamation on September 22. It gave notice that people held as slaves in any state or designated part of a state still in rebellion on January 1, 1863, would then be free"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7149041051.mp3?updated=1695588958","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"Lincoln’s decision from the summer cabinet draft to the September preliminary proclamation"}],["$","small",null,{"children":"The episode begins with congressional emancipation measures and follows the private decision, public positioning, battlefield delay, and September 22 announcement. The final proclamation of January 1, 1863, is reserved for the next episode."}]]}],["$","div","D.C. Emancipation Act",{"children":[["$","span",null,{"children":"D.C. Emancipation Act"}],["$","strong",null,{"children":"Signed April 16, 1862"}],["$","small",null,{"children":"Congress ended slavery in the District of Columbia, where it exercised direct legislative authority. The act immediately freed people held there and allowed loyal claimants up to $300 for each person emancipated."}]]}],["$","div","People freed in the District",{"children":[["$","span",null,{"children":"People freed in the District"}],["$","strong",null,{"children":"2,989 people were covered by compensated claims"}],["$","small",null,{"children":"The Library of Congress reports that the claims commission awarded compensation for 2,989 enslaved people. The law was the only wartime emancipation program in which the federal government compensated former enslavers."}]]}],["$","div","Second Confiscation Act",{"children":[["$","span",null,{"children":"Second Confiscation Act"}],["$","strong",null,{"children":"Signed July 17, 1862"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b"]}],"$L2c","$L2d","$L2e","$L2f",false,"$L30","$L31","$L32"]}]]}]
37:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","small",null,{"children":"Its formal title was “An Act to suppress Insurrection, to punish Treason and Rebellion, to seize and confiscate the Property of Rebels, and for other Purposes.” Lincoln signed an explanatory joint resolution with the act after raising constitutional objections."}]
f:["$","div","Who the act made free",{"children":[["$","span",null,{"children":"Who the act made free"}],["$","strong",null,{"children":"Specified people enslaved by rebels or persons giving the rebellion aid and comfort"}],["$","small",null,{"children":"Sections 1–4 tied liberation to convictions or defined classes of disloyal owners. Section 9 declared forever free people escaping from such owners into United States lines, captured or deserted and brought under federal control, or found in places later occupied by United States forces."}]]}]
10:["$","div","Non-return rule",{"children":[["$","span",null,{"children":"Non-return rule"}],["$","strong",null,{"children":"Military and naval personnel could not decide or surrender a claimed fugitive"}],["$","small",null,{"children":"Section 10 permitted a claimant to proceed only after swearing that the claimant had neither borne arms against the United States nor aided the rebellion. It separately forbade federal military or naval personnel from adjudicating the claim or surrendering the person."}]]}]
11:["$","div","Why the act was not territorial emancipation",{"children":[["$","span",null,{"children":"Why the act was not territorial emancipation"}],["$","strong",null,{"children":"Its operation turned on owner conduct and contact with federal power"}],["$","small",null,{"children":"The episode criticizes the act’s enforcement problems. More precisely, several provisions required proof of treason or support for rebellion, while Section 9 depended on escape, capture, federal control, or occupation. It did not declare every enslaved person in Confederate territory free at once."}]]}]
12:["$","div","Companion Militia Act",{"children":[["$","span",null,{"children":"Companion Militia Act"}],["$","strong",null,{"children":"Also signed July 17, 1862"}],["$","small",null,{"children":"The Militia Act authorized the president to receive people of African descent for military or naval service. It freed an enslaved man who served, together with his mother, wife, and children when they were enslaved by a person who had supported the rebellion."}]]}]
13:["$","div","Confederate use of enslaved labor",{"children":[["$","span",null,{"children":"Confederate use of enslaved labor"}],["$","strong",null,{"children":"Fortifications, transport, cooking, hospitals, farms, and plantations"}],["$","small",null,{"children":"The episode’s military-necessity argument rests on slavery’s material support for the Confederate war effort: coerced labor released white men for combat and sustained armies and the home front."}]]}]
14:["$","div","Lincoln’s war-power rationale",{"children":[["$","span",null,{"children":"Lincoln’s war-power rationale"}],["$","strong",null,{"children":"Emancipation framed as a fit and necessary military measure"}],["$","small",null,{"children":"Lincoln’s July draft invoked his authority as commander in chief and connected emancipation to suppressing rebellion and restoring national authority. It did not claim a general peacetime presidential power to abolish slavery in the states."}]]}]
15:["$","div","Harrison’s Landing meeting",{"children":[["$","span",null,{"children":"Harrison’s Landing meeting"}],["$","strong",null,{"children":"July 7, 1862"}],["$","small",null,{"children":"Lincoln met Maj. Gen. George B. McClellan after the Seven Days Battles. McClellan’s Harrison’s Bar letter advised that neither confiscation nor the forcible abolition of slavery should be contemplated and urged protection of private property and unarmed civilians subject to military necessity."}]]}]
16:["$","div","What the Harrison’s Landing visit proves",{"children":[["$","span",null,{"children":"What the Harrison’s Landing visit proves"}],["$","strong",null,{"children":"The timing is known; its precise effect on Lincoln’s decision is not"}],["$","small",null,{"children":"The episode argues that the visit helped convince Lincoln to abandon a conciliatory war. Historians can securely place the meeting and McClellan’s letter, but the exact moment Lincoln resolved to issue a proclamation is not documented."}]]}]
17:["$","div","First cabinet disclosure",{"children":[["$","span",null,{"children":"First cabinet disclosure"}],["$","strong",null,{"children":"July 13, 1862, to William H. Seward and Gideon Welles"}],["$","small",null,{"children":"During a carriage ride from the funeral of Secretary of War Edwin M. Stanton’s infant son James, Lincoln said he was considering emancipation by proclamation and had concluded it was a military necessity."}]]}]
18:["$","div","Evidence for the carriage conversation",{"children":[["$","span",null,{"children":"Evidence for the carriage conversation"}],["$","strong",null,{"children":"Gideon Welles’s later recollection"}],["$","small",null,{"children":"The substance survives through Welles’s diary and retrospective account, not a verbatim transcript made during the ride. His evidence is essential but should be read as recollection."}]]}]
19:["$","div","Special cabinet meeting",{"children":[["$","span",null,{"children":"Special cabinet meeting"}],["$","strong",null,{"children":"July 21, 1862"}],["$","small",null,{"children":"Lincoln presented measures on military seizure and use of property, employment of Black laborers, recordkeeping for possible compensation, and proposed colonization. The first three went forward; the proposed colonization order did not."}]]}]
1a:["$","div","Military-property order",{"children":[["$","span",null,{"children":"Military-property order"}],["$","strong",null,{"children":"Issued July 22, 1862"}],["$","small",null,{"children":"It directed commanders in nine Confederate states to seize and use property needed for military purposes, employ people of African descent as paid laborers, and keep records. Destruction for proper military objects was permitted, but not “in wantonness or malice.”"}]]}]
1b:["$","div","Earliest proclamation draft",{"children":[["$","span",null,{"children":"Earliest proclamation draft"}],["$","strong",null,{"children":"Read to the full cabinet July 22, 1862"}],["$","small",null,{"children":"The surviving manuscript is three sentences. It warned persons covered by Section 6 of the Second Confiscation Act, renewed compensated-emancipation policy for loyal states, and announced a future commander-in-chief emancipation order."}]]}]
1c:["$","div","July draft deadline",{"children":[["$","span",null,{"children":"July draft deadline"}],["$","strong",null,{"children":"January 1, 1863"}],["$","small",null,{"children":"The draft declared that people held as slaves in any state where United States constitutional authority was not then practically recognized, submitted to, and maintained would be free from that date forward."}]]}]
1d:["$","div","How the draft exceeded confiscation",{"children":[["$","span",null,{"children":"How the draft exceeded confiscation"}],["$","strong",null,{"children":"Geography replaced proof of each enslaver’s disloyalty"}],["$","small",null,{"children":"The Second Confiscation Act distinguished people by an owner’s conduct and by contact with federal forces. Lincoln proposed a war measure applying to all people held as slaves within an area still resisting federal authority, whether an individual enslaver claimed loyalty or not."}]]}]
1e:["$","div","Cabinet reaction",{"children":[["$","span",null,{"children":"Cabinet reaction"}],["$","strong",null,{"children":"Support, silence, objection, and advice rather than a vote that controlled Lincoln"}],["$","small",null,{"children":"Stanton and Attorney General Edward Bates favored immediate release. Montgomery Blair feared electoral damage. Welles and Interior Secretary Caleb B. Smith were silent. Salmon P. Chase supported the policy but preferred a different method. Seward supplied the decisive timing argument."}]]}]
1f:["$","div","Seward’s advice",{"children":[["$","span",null,{"children":"Seward’s advice"}],["$","strong",null,{"children":"Wait for a military success"}],["$","small",null,{"children":"Seward warned that immediate publication amid military reverses could look like a last measure of an exhausted government. Lincoln accepted the timing advice and put the draft aside; he did not abandon the policy."}]]}]
20:["$","div","July 25 warning",{"children":[["$","span",null,{"children":"July 25 warning"}],["$","strong",null,{"children":"A separate statutory proclamation, not the emancipation proclamation"}],["$","small",null,{"children":"Lincoln publicly warned people covered by Section 6 of the Second Confiscation Act to cease supporting rebellion and return to allegiance within the statutory sixty-day period or face seizure and forfeiture."}]]}]
21:["$","div","The military delay",{"children":[["$","span",null,{"children":"The military delay"}],["$","strong",null,{"children":"No suitable success until Antietam"}],["$","small",null,{"children":"The United States war effort stalled and suffered defeat at Second Bull Run in late August. Lee then invaded Maryland, where the Army of the Potomac stopped his campaign at Antietam on September 17."}]]}]
22:["$","div","Greeley exchange",{"children":[["$","span",null,{"children":"Greeley exchange"}],["$","strong",null,{"children":"August 19 editorial; Lincoln’s reply dated August 22"}],["$","small",null,{"children":"Horace Greeley’s “The Prayer of Twenty Millions” demanded enforcement of emancipation laws. Lincoln answered that his official paramount object was saving the Union while preserving his personal wish that all people everywhere could be free."}]]}]
23:["$","div","What Lincoln did not reveal to Greeley",{"children":[["$","span",null,{"children":"What Lincoln did not reveal to Greeley"}],["$","strong",null,{"children":"The July emancipation draft was already awaiting military success"}],["$","small",null,{"children":"The published letter described Lincoln’s official purpose without disclosing his secret cabinet decision. The episode interprets the letter as preparation of white northern opinion; that motive is a historical interpretation rather than something Lincoln stated in the letter."}]]}]
24:["$","div","White House colonization address",{"children":[["$","span",null,{"children":"White House colonization address"}],["$","strong",null,{"children":"August 14, 1862"}],["$","small",null,{"children":"Lincoln told a delegation of free Black men that racial separation would benefit both races and urged voluntary emigration to Central America. The address expressed racist assumptions and blamed racial presence, rather than enslavers and secessionists, for the war’s existence."}]]}]
25:["$","div","Black response to colonization",{"children":[["$","span",null,{"children":"Black response to colonization"}],["$","strong",null,{"children":"Most Black Americans rejected expatriation"}],["$","small",null,{"children":"The Library of Congress notes that most formerly enslaved people had no interest in leaving their homeland. Lincoln’s wartime colonization initiatives proved impractical and failed; colonization language remained in the September preliminary proclamation but disappeared from the final proclamation."}]]}]
26:["$","div","Antietam’s political use",{"children":[["$","span",null,{"children":"Antietam’s political use"}],["$","strong",null,{"children":"A strategic check sufficient for Lincoln’s announcement"}],["$","small",null,{"children":"Antietam was not a decisive destruction of Lee’s army. Lee nevertheless ended the Maryland invasion and recrossed the Potomac, allowing Lincoln to announce emancipation from a stronger position five days later."}]]}]
27:["$","div","Preliminary proclamation",{"children":[["$","span",null,{"children":"Preliminary proclamation"}],["$","strong",null,{"children":"Issued September 22, 1862"}],["$","small",null,{"children":"It announced that on January 1, 1863, people held as slaves in any state or designated part of a state whose people remained in rebellion would be “then, thenceforward, and forever free,” and that the federal executive, Army, and Navy would recognize and maintain that freedom."}]]}]
28:["$","div","One hundred days’ notice",{"children":[["$","span",null,{"children":"One hundred days’ notice"}],["$","strong",null,{"children":"September 22, 1862–January 1, 1863"}],["$","small",null,{"children":"The preliminary document carried immediate authority as a presidential proclamation and directed enforcement of existing statutes, but its new territorial freedom declaration was notice of the order Lincoln intended to put into effect on January 1."}]]}]
29:["$","div","Places not targeted",{"children":[["$","span",null,{"children":"Places not targeted"}],["$","strong",null,{"children":"Loyal slave states and areas not then in rebellion"}],["$","small",null,{"children":"The preliminary proclamation did not abolish slavery in Delaware, Maryland, Kentucky, or Missouri. The final January 1 proclamation would identify the states and parts of states treated as still in rebellion."}]]}]
2a:["$","div","War aims transformed",{"children":[["$","span",null,{"children":"War aims transformed"}],["$","strong",null,{"children":"Restoration of the Union now carried an announced emancipation policy"}],["$","small",null,{"children":"The proclamation did not replace restoration as the federal objective. It made emancipation in rebellious territory an official instrument of the war for restoration and committed the military and naval arms of the government to maintain the declared freedom."}]]}]
2b:["$","div","Recommended book",{"children":[["$","span",null,{"children":"Recommended book"}],["$","strong",null,{"children":"“Lincoln’s Emancipation Proclamation” by Allen C. Guelzo"}],["$","small",null,{"children":"The full title is “Lincoln’s Emancipation Proclamation: The End of Slavery in America.” The transcript’s automated spelling “Alan Gelzo” is incorrect; the author is Allen C. Guelzo."}]]}]
2c:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}]
2d:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The decision takes shape, April–September 1862",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep203-decision-timeline.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The decision takes shape, April–September 1862 at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep203-decision-timeline.svg","alt":"Timeline from the April 16 District of Columbia Emancipation Act through Lincoln’s July cabinet draft and the September 22 preliminary Emancipation Proclamation.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The decision takes shape, April–September 1862"}],["$","span",null,{"children":"Congressional emancipation, military reverses, cabinet deliberation, public argument, and battlefield events moved on intersecting tracks. The diagram shows verified chronology; it does not claim that any one event alone caused Lincoln’s decision."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep203-decision-timeline.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Abraham Lincoln Papers and Civil War exhibitions, National Archives, National Park Service, and the episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Three measures, three legal paths",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep203-authority-scope.svg","target":"_blank","rel":"noreferrer","aria-label":"Open Three measures, three legal paths at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep203-authority-scope.svg","alt":"Comparison diagram showing authority, reach, trigger, and limits of the District of Columbia Emancipation Act, Second Confiscation Act, and preliminary Emancipation Proclamation.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Three measures, three legal paths"}],["$","span",null,{"children":"The District act rested on congressional authority over Washington, the Second Confiscation Act linked freedom to an enslaver’s conduct and federal control, and Lincoln’s proclamation announced a geographic commander-in-chief measure for places still in rebellion on January 1."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep203-authority-scope.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"United States Statutes at Large, Abraham Lincoln’s July draft, and the September 22 preliminary proclamation; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$2d:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Lincoln’s handwritten July draft",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep203-july-draft-manuscript.jpg","target":"_blank","rel":"noreferrer","aria-label":"Open Lincoln’s handwritten July draft at full size","children":"$L33"}]}],"$L34"]}],"$L35","$L36"]}]]}]
2e:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The summer decision is introduced",{"className":"moment","children":[["$","$L37",null,{"seconds":70,"label":"1:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The summer decision is introduced"}],["$","p",null,{"children":"The episode opens with Lincoln’s decision to make emancipation part of the United States war effort during the summer of 1862."}]]}]]}],["$","div","Compensated emancipation is recapped",{"className":"moment","children":[["$","$L37",null,{"seconds":91,"label":"1:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"Compensated emancipation is recapped"}],["$","p",null,{"children":"Lincoln’s March proposal offered federal aid to any state voluntarily adopting gradual abolition, but loyal slave-state representatives declined to endorse it."}]]}]]}],["$","div","Congress follows its own path",{"className":"moment","children":[["$","$L37",null,{"seconds":114,"label":"1:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Congress follows its own path"}],["$","p",null,{"children":"The Republican majority moves from urging voluntary state action toward direct federal legislation against slavery."}]]}]]}],["$","div","Slavery ends in the District of Columbia",{"className":"moment","children":[["$","$L37",null,{"seconds":120,"label":"2:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Slavery ends in the District of Columbia"}],["$","p",null,{"children":"Congress’s compensated-emancipation act applies where Congress exercises direct authority, and Lincoln signs it on April 16."}]]}]]}],["$","div","Action in the seceded states poses a different legal question",{"className":"moment","children":[["$","$L37",null,{"seconds":143,"label":"2:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Action in the seceded states poses a different legal question"}],["$","p",null,{"children":"The episode contrasts Congress’s authority over Washington with proposals affecting slavery inside states in active rebellion."}]]}]]}],["$","div","The Second Confiscation Act enters the story",{"className":"moment","children":[["$","$L37",null,{"seconds":158,"label":"2:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Second Confiscation Act enters the story"}],["$","p",null,{"children":"Congress passes a broader act that links freedom and property seizure to treason, rebellion, and support for the Confederacy."}]]}]]}],["$","div","The episode emphasizes enforcement problems",{"className":"moment","children":[["$","$L37",null,{"seconds":192,"label":"3:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"The episode emphasizes enforcement problems"}],["$","p",null,{"children":"Application could require proof of an enslaver’s disloyalty and depended on escape, capture, federal control, or occupation rather than a simple territorial declaration."}]]}]]}],["$","div","Lincoln secures an explanatory revision",{"className":"moment","children":[["$","$L37",null,{"seconds":210,"label":"3:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lincoln secures an explanatory revision"}],["$","p",null,{"children":"He signs the act together with a joint resolution limiting real-estate forfeiture to an offender’s natural life and addressing other constitutional concerns."}]]}]]}],["$","div","Cabinet relations have deteriorated",{"className":"moment","children":[["$","$L37",null,{"seconds":216,"label":"3:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"Cabinet relations have deteriorated"}],["$","p",null,{"children":"The slavery debate has become bitter enough that regular cabinet consultation has nearly stopped."}]]}]]}],["$","div","Seward recalls Lincoln listening",{"className":"moment","children":[["$","$L37",null,{"seconds":249,"label":"4:09"}],["$","div",null,{"children":[["$","h3",null,{"children":"Seward recalls Lincoln listening"}],["$","p",null,{"children":"In Seward’s account of the earlier meetings, Lincoln listened closely without yet announcing the course he would take."}]]}]]}],"$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51","$L52","$L53","$L54","$L55","$L56","$L57","$L58","$L59","$L5a","$L5b","$L5c","$L5d","$L5e","$L5f","$L60","$L61","$L62","$L63","$L64","$L65","$L66","$L67","$L68","$L69","$L6a","$L6b","$L6c","$L6d","$L6e","$L6f","$L70","$L71","$L72"]}]]}]
2f:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States civilian authority",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States civilian authority"}],[["$","div","President and commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"President and commander in chief"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Made the emancipation decision, issued executive and military orders, and received advice from the heads of the executive departments"}]]}],["$","div","Secretary of State",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of State"}],["$","span",null,{"children":"William H. Seward"}],["$","small",null,{"children":"Advised delaying publication until a military success and countersigned the September 22 proclamation"}]]}],["$","div","Secretary of the Treasury",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of the Treasury"}],["$","span",null,{"children":"Salmon P. Chase"}],["$","small",null,{"children":"Supported emancipation while preferring a more incremental military method; recorded the September 22 cabinet meeting in his diary"}]]}],["$","div","Secretary of War",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of War"}],["$","span",null,{"children":"Edwin M. Stanton"}],["$","small",null,{"children":"Supported immediate publication and transmitted Lincoln’s July military order to Army commanders"}]]}],["$","div","Secretary of the Navy",{"className":"command-entry","children":[["$","strong",null,{"children":"Secretary of the Navy"}],["$","span",null,{"children":"Gideon Welles"}],["$","small",null,{"children":"Heard Lincoln’s first disclosure on July 13, remain