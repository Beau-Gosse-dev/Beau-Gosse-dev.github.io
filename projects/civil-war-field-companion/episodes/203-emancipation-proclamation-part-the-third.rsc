58:["$","div","The cabinet absorbs the announcement",{"className":"moment","children":[["$","$L37",null,{"seconds":859,"label":"14:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The cabinet absorbs the announcement"}],["$","p",null,{"children":"Most secretaries have not heard the proposal before, and their recorded reactions range from support to silence and objection."}]]}]]}]
