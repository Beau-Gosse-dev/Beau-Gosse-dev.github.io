10:["$","p",null,{"className":"glance-sources","children":[["$","a","https://civilwarpodcast.org/2016/06/12/civil-war-podcast-episode-155/",{"href":"https://civilwarpodcast.org/2016/06/12/civil-war-podcast-episode-155/","target":"_blank","rel":"noreferrer","children":["Source: ","Official Civil War Podcast episode 155 page"]}],["$","a","https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm",{"href":"https://www.nps.gov/articles/000/jackson1862-valley-campaign.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Jackson’s 1862 Campaign in the Shenandoah Valley"]}],["$","a","https://www.nps.gov/articles/shenandoah-civil-war-connection.htm",{"href":"https://www.nps.gov/articles/shenandoah-civil-war-connection.htm","target":"_blank","rel":"noreferrer","children":[" · ","National Park Service: Shenandoah’s Civil War Connection"]}],["$","a","https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf",{"href":"https://history.army.mil/portals/143/Images/Publications/catalog/75-5.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: The Virginia Campaigns, March–August 1862"]}],["$","a","https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/",{"href":"https://history.army.mil/Research/Reference-Topics/Army-Campaigns/Brief-Summaries/Civil-War/","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: Civil War campaign summary"]}],["$","a","https://history.army.mil/Portals/143/Images/Publications/Publication%20By%20Title%20Images/A%20Titles%20PDF/CMH_Pub_30-21.pdf",{"href":"https://history.army.mil/Portals/143/Images/Publications/Publication%20By%20Title%20Images/A%20Titles%20PDF/CMH_Pub_30-21.pdf","target":"_blank","rel":"noreferrer","children":[" · ","U.S. Army Center of Military History: American Military History, Volume 1"]}],["$","a","https://texashistory.unt.edu/ark:/67531/metapth154620/",{"href":"https://texashistory.unt.edu/ark:/67531/metapth154620/","target":"_blank","rel":"noreferrer","children":[" · ","Official Records, Series I, Volume XII, Part III—correspondence and orders"]}],["$","a","https://www.loc.gov/item/99448346/",{"href":"https://www.loc.gov/item/99448346/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Hotchkiss maps of Jackson’s campaign"]}],["$","a","https://www.loc.gov/item/2018670326/",{"href":"https://www.loc.gov/item/2018670326/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Stonewall Jackson photograph"]}],["$","a","https://www.loc.gov/item/2018666540/",{"href":"https://www.loc.gov/item/2018666540/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: Robert E. Lee portrait"]}],["$","a","https://www.loc.gov/item/2005683068/",{"href":"https://www.loc.gov/item/2005683068/","target":"_blank","rel":"noreferrer","children":[" · ","Library of Congress: George B. McClellan portrait"]}],["$","a","https://arvasarchive.org/catalog/vilxv_vilxv00012",{"href":"https://arvasarchive.org/catalog/vilxv_vilxv00012","target":"_blank","rel":"noreferrer","children":[" · ","VMI Archives: Fulkerson Family Papers"]}],["$","a","https://civilwarpodcast.org/book-recommendations/",{"href":"https://civilwarpodcast.org/book-recommendations/","target":"_blank","rel":"noreferrer","children":[" · ","Official podcast book-recommendations list"]}]]}]
