1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",155," · ","March 23–June 17, 1862"," · ","The Shenandoah Valley and adjacent Blue Ridge approaches in Virginia, with strategic consequences at Fredericksburg, Washington, and McClellan’s position outside Richmond"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: CONCLUSION"}],["$","span",null,{"className":"result-label","children":"Confederate campaign success. Jackson lost tactically at Kernstown, then defeated separated United States forces at McDowell, Front Royal, First Winchester, Cross Keys, and Port Republic. The campaign alarmed the Lincoln administration, kept Federal forces oriented toward the Valley, diverted part of McDowell’s command from the planned concentration with McClellan, and left Jackson free to march toward Richmond after Lee’s June 16 summons. The episode also stresses that Jackson’s tactical handling and relentless marches imposed heavy costs on his army"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7703423051.mp3?updated=1695325915","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Episode scope",{"children":[["$","span",null,{"children":"Episode scope"}],["$","strong",null,{"children":"A retrospective assessment of the Valley Campaign and its transition to the Seven Days"}],["$","small",null,{"children":"The episode opens with two post-battle letters, reviews the campaign’s effects and costs, and ends with the decision to move Jackson’s army toward Richmond."}]]}],["$","div","Campaign span",{"children":[["$","span",null,{"children":"Campaign span"}],["$","strong",null,{"children":"Six principal battles from Kernstown on March 23 to Port Republic on June 9"}],["$","small",null,{"children":"The sequence was Kernstown, McDowell, Front Royal, First Winchester, Cross Keys, and Port Republic. Smaller actions and sustained marches connected them."}]]}],["$","div","Battle results",{"children":[["$","span",null,{"children":"Battle results"}],["$","strong",null,{"children":"One United States victory followed by five Confederate victories"}],["$","small",null,{"children":"Kernstown was Jackson’s tactical defeat. Its effect on Federal dispositions nevertheless served the Confederate objective of keeping troops away from Richmond."}]]}],["$","div","Strategic purpose",{"children":[["$","span",null,{"children":"Strategic purpose"}],["$","strong",null,{"children":"Prevent United States forces from reinforcing McClellan outside Richmond"}],["$","small",null,{"children":"Robert E. Lee, then Jefferson Davis’s military adviser, supported operations intended to occupy Banks and Frémont and complicate the planned McDowell–McClellan junction."}]]}],["$","div","Federal concentration disrupted",{"children":[["$","span",null,{"children":"Federal concentration disrupted"}],"$Le","$Lf"]}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}],"$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]]}]
2c:I["bc0a83434070",[],"AudioTimestamp",1]
e:["$","strong",null,{"children":"Part of McDowell’s command was redirected toward the Valley"}]
f:["$","small",null,{"children":"Army historical accounts say Jackson’s campaign drew away about half of McDowell’s force and that McClellan received only two divisions from it. The effect of a full junction is necessarily counterfactual."}]
10:["$","div","Peak Valley strength",{"children":[["$","span",null,{"children":"Peak Valley strength"}],["$","strong",null,{"children":"About 17,000 after Ewell’s division reinforced Jackson"}],["$","small",null,{"children":"This is an approximate campaign-level figure. Effective strength changed with detachments, casualties, straggling, and the date counted."}]]}]
11:["$","div","Operational method",{"children":[["$","span",null,{"children":"Operational method"}],["$","strong",null,{"children":"Rapid marches, deception, terrain knowledge, and attacks against separated commands"}],["$","small",null,{"children":"The road network and Blue Ridge gaps helped Jackson shift direction and conceal movement. These advantages did not remove tactical errors at individual battles."}]]}]
12:["$","div","Campaign movement",{"children":[["$","span",null,{"children":"Campaign movement"}],["$","strong",null,{"children":"More than 500 miles marched between late March and mid-June"}],["$","small",null,{"children":"This National Park Service estimate is campaign-wide; it is not the distance marched by every soldier who joined or left the command at different dates."}]]}]
13:["$","div","Psychological effect",{"children":[["$","span",null,{"children":"Psychological effect"}],["$","strong",null,{"children":"The campaign made Jackson a major Confederate public figure"}],["$","small",null,{"children":"The episode distinguishes its large morale and publicity effect from the greater battlefield scale and immediate stakes of the fighting outside Richmond."}]]}]
14:["$","div","Recurring tactical criticism",{"children":[["$","span",null,{"children":"Recurring tactical criticism"}],["$","strong",null,{"children":"Jackson often committed units piecemeal at the opening of battles"}],["$","small",null,{"children":"The episode applies this criticism to Kernstown, McDowell, Front Royal, and especially Port Republic. It does not claim that every reverse had the same cause."}]]}]
15:["$","div","Kernstown risk",{"children":[["$","span",null,{"children":"Kernstown risk"}],["$","strong",null,{"children":"Jackson massed most of his engaged infantry on his left and left a thin center"}],["$","small",null,{"children":"The episode argues that Nathan Kimball might have exploited the center. The result of a different advance remains hypothetical."}]]}]
16:["$","div","McDowell cost",{"children":[["$","span",null,{"children":"McDowell cost"}],["$","strong",null,{"children":"Milroy and Schenck attacked first on Sitlington’s Hill"}],["$","small",null,{"children":"The spoiling attack disrupted Jackson’s plan. The episode emphasizes that the Confederates suffered more heavily while defending high ground."}]]}]
17:["$","div","Port Republic criticism",{"children":[["$","span",null,{"children":"Port Republic criticism"}],["$","strong",null,{"children":"Winder’s brigade bore the early burden as reinforcements arrived in succession"}],["$","small",null,{"children":"The episode presents Port Republic as the clearest and costliest example of piecemeal commitment."}]]}]
18:["$","div","Army strain",{"children":[["$","span",null,{"children":"Army strain"}],["$","strong",null,{"children":"The episode estimates that about 4,000 men left the ranks"}],["$","small",null,{"children":"It attributes this to exhaustion and desertion and says it exceeded battle losses. Definitions and counting periods differ among historical studies."}]]}]
19:["$","div","Internal warning",{"children":[["$","span",null,{"children":"Internal warning"}],["$","strong",null,{"children":"Senior subordinates believed continued risk-taking could end in disaster"}],["$","small",null,{"children":"The episode cites McHenry Howard’s recollection of a discussion involving Winder, Trimble, Taliaferro, and Taylor. This records their judgment, not a measurable forecast."}]]}]
1a:["$","div","Contemporary criticism",{"children":[["$","span",null,{"children":"Contemporary criticism"}],["$","strong",null,{"children":"Dabney and Winder recorded severe fatigue and criticized Jackson’s demands"}],["$","small",null,{"children":"Their private writings balance later celebratory accounts of Jackson’s leadership."}]]}]
1b:["$","div","After Port Republic",{"children":[["$","span",null,{"children":"After Port Republic"}],["$","strong",null,{"children":"Jackson withdrew to Brown’s Gap, then returned near Weyer’s Cave"}],["$","small",null,{"children":"Frémont and Shields also withdrew. Jackson used the Blue Ridge as cover while the next operation was decided."}]]}]
1c:["$","div","Jackson’s proposal",{"children":[["$","span",null,{"children":"Jackson’s proposal"}],["$","strong",null,{"children":"Increase his force to about 40,000 and carry the threat across the Potomac"}],["$","small",null,{"children":"He proposed another offensive into Maryland and Pennsylvania to intensify pressure on Washington. It was proposed, not executed."}]]}]
1d:["$","div","Lee’s decision",{"children":[["$","span",null,{"children":"Lee’s decision"}],["$","strong",null,{"children":"Concentrate against McClellan rather than renew the Valley offensive"}],["$","small",null,{"children":"On June 16 Lee directed Jackson toward a junction near Richmond. The army began moving June 17 and crossed Brown’s Gap during the night of June 17–18."}]]}]
1e:["$","div","Important leader losses",{"children":[["$","span",null,{"children":"Important leader losses"}],["$","strong",null,{"children":"Turner Ashby was killed during the campaign; Samuel V. Fulkerson died after a later battle"}],["$","small",null,{"children":"Ashby was killed near Harrisonburg on June 6. Fulkerson survived the Valley fighting but was mortally wounded at Gaines’s Mill later in June."}]]}]
1f:["$","div","Primary voices",{"children":[["$","span",null,{"children":"Primary voices"}],["$","strong",null,{"children":"Pvt. Sidney J. Richardson and Col. Samuel V. Fulkerson"}],["$","small",null,{"children":"Richardson described Cross Keys in a letter home. Fulkerson described Jackson’s prayer during the June 8 fight at the Port Republic bridge. Both are personal perspectives."}]]}]
20:["$","div","Book recommendation",{"children":[["$","span",null,{"children":"Book recommendation"}],["$","strong",null,{"children":"“The Untold Civil War: Exploring the Human Side of War” by James I. Robertson Jr., edited by Neil Kagan"}],"$undefined"]}]
21:["$","div","Transcript normalizations",{"children":[["$","span",null,{"children":"Transcript normalizations"}],["$","strong",null,{"children":"Frémont, Milroy, Staunton, Sitlington’s Hill, Taliaferro, Fulkerson, Weyer’s Cave, and Luray"}],["$","small",null,{"children":"The automated transcript renders several names as “Fremont,” “Millroyd,” “Stanton,” “Sittlingtons,” “Tolliver,” “Folkerson,” “Weyers,” and “LeRae.”"}]]}]
22:["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],["$","a",null,{"href":"#losses","children":"Leader losses"}],["$","a",null,{"href":"#images","children":"Images"}]]}]
23:["$","section",null,{"className":"reference-section maps-section","id":"maps","children":[["$","h2",null,{"children":"Maps"}],["$","div",null,{"className":"maps-grid","children":[["$","figure","The Valley Campaign in one movement sequence",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep155-valley-campaign-overview.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The Valley Campaign in one movement sequence at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep155-valley-campaign-overview.svg","alt":"Schematic map of Jackson’s movement through the six principal Valley Campaign battles and toward Richmond.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Valley Campaign in one movement sequence"}],["$","span",null,{"children":"Jackson moved from the Kernstown defeat south, turned west against Milroy at McDowell, shifted north against Banks, escaped a three-column convergence, and defeated Frémont and Shields near Cross Keys and Port Republic. After pausing at Brown’s Gap and Weyer’s Cave, the army moved east. Routes, river courses, positions, distances, and arrow timing are approximate. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep155-valley-campaign-overview.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"National Park Service, U.S. Army Center of Military History, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","The diversion and the turn toward Richmond",{"className":"reference-map","children":[["$","div",null,{"className":"map-frame static-map-frame","children":["$","a",null,{"className":"map-image-link","href":"/projects/civil-war-field-companion/images/ep155-strategic-diversion.svg","target":"_blank","rel":"noreferrer","aria-label":"Open The diversion and the turn toward Richmond at full size","children":["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep155-strategic-diversion.svg","alt":"Schematic strategic map of Federal diversions toward the Valley and Jackson’s move to Lee near Richmond.","width":1600,"height":1200,"loading":"lazy"}]}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The diversion and the turn toward Richmond"}],["$","span",null,{"children":"Federal responses kept Banks and Frémont focused on the Valley and redirected part of McDowell’s command away from the planned concentration with McClellan. Lee then summoned Jackson east. The diagram shows broad relationships, not tactical deployments. Positions, routes, distances, strengths, and timing are generalized. This map is schematic and not to scale."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep155-strategic-diversion.svg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"U.S. Army Center of Military History, National Park Service, and episode transcript; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]]}],["$","figure","Hotchkiss campaign maps of the Shenandoah Valley",{"className":"reference-map","children":["$L2a","$L2b"]}]]}]]}]
24:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Richardson writes after Cross Keys",{"className":"moment","children":[["$","$L2c",null,{"seconds":43,"label":"0:43"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richardson writes after Cross Keys"}],["$","p",null,{"children":"Pvt. Sidney J. Richardson of the 21st Virginia tells his family that June 8 brought two hard fights and heavy losses."}]]}]]}],["$","div","Richardson’s later fate is identified",{"className":"moment","children":[["$","$L2c",null,{"seconds":152,"label":"2:32"}],["$","div",null,{"children":[["$","h3",null,{"children":"Richardson’s later fate is identified"}],["$","p",null,{"children":"The hosts note that Richardson was wounded at Chancellorsville and killed at Plymouth, North Carolina, in April 1864."}]]}]]}],["$","div","Fulkerson assesses Jackson",{"className":"moment","children":[["$","$L2c",null,{"seconds":183,"label":"3:03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Fulkerson assesses Jackson"}],["$","p",null,{"children":"Writing two days after Port Republic, Fulkerson describes Jackson as fearless, energetic, demanding, and trusted despite the hard marches."}]]}]]}],["$","div","A prayer at the bridge",{"className":"moment","children":[["$","$L2c",null,{"seconds":266,"label":"4:26"}],["$","div",null,{"children":[["$","h3",null,{"children":"A prayer at the bridge"}],["$","p",null,{"children":"Fulkerson recalls Jackson praying while the 37th Virginia charged through the Port Republic bridge on June 8."}]]}]]}],["$","div","The retrospective scope is set",{"className":"moment","children":[["$","$L2c",null,{"seconds":356,"label":"5:56"}],["$","div",null,{"children":[["$","h3",null,{"children":"The retrospective scope is set"}],["$","p",null,{"children":"The hosts close the Valley series and connect it to Lee’s command outside Richmond and the approaching Seven Days."}]]}]]}],["$","div","The campaign transforms Jackson’s reputation",{"className":"moment","children":[["$","$L2c",null,{"seconds":383,"label":"6:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign transforms Jackson’s reputation"}],["$","p",null,{"children":"Jackson entered known mainly for First Manassas and emerged as a prominent military figure in both sections."}]]}]]}],["$","div","Federal commanders become foils",{"className":"moment","children":[["$","$L2c",null,{"seconds":439,"label":"7:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Federal commanders become foils"}],["$","p",null,{"children":"The episode warns that Banks, Frémont, Shields, Milroy, and McDowell are often reduced to caricatures in Jackson-centered accounts."}]]}]]}],["$","div","The Valley was a secondary theater",{"className":"moment","children":[["$","$L2c",null,{"seconds":482,"label":"8:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Valley was a secondary theater"}],["$","p",null,{"children":"McClellan’s offensive against Richmond involved larger armies and higher immediate stakes than the Valley battles."}]]}]]}],["$","div","Two forms of strategic importance",{"className":"moment","children":[["$","$L2c",null,{"seconds":552,"label":"9:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two forms of strategic importance"}],["$","p",null,{"children":"The hosts identify the campaign’s effect on Confederate morale and its disruption of Federal reinforcement plans."}]]}]]}],["$","div","The wider Confederate position is reviewed",{"className":"moment","children":[["$","$L2c",null,{"seconds":645,"label":"10:45"}],["$","div",null,{"children":[["$","h3",null,{"children":"The wider Confederate position is reviewed"}],["$","p",null,{"children":"United States gains elsewhere and McClellan’s approach made Jackson’s victories unusually welcome news in the Confederacy."}]]}]]}],["$","div","Victory changes Confederate morale",{"className":"moment","children":[["$","$L2c",null,{"seconds":727,"label":"12:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Victory changes Confederate morale"}],["$","p",null,{"children":"Southern newspapers celebrated Jackson’s activity while other major Confederate commanders appeared inactive, unsuccessful, or unavailable."}]]}]]}],"$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f"]}]]}]
25:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Commander in chief"}],["$","span",null,{"children":"President Abraham Lincoln"}],["$","small",null,{"children":"Redirected forces against Jackson and delayed the intended concentration of McDowell with McClellan"}]]}],["$","div","Army of the Potomac",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Potomac"}],["$","span",null,{"children":"Maj. Gen. George B. McClellan"}],["$","small",null,{"children":"Advanced toward Richmond and expected reinforcement from McDowell but did not receive the planned full junction"}]]}],["$","div","Department of the Rappahannock",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Rappahannock"}],["$","span",null,{"children":"Maj. Gen. Irvin McDowell"}],["$","small",null,{"children":"Held near Fredericksburg; part of his command, including Shields’s division, was redirected toward the Valley"}]]}],["$","div","Department of the Shenandoah",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Shenandoah"}],["$","span",null,{"children":"Maj. Gen. Nathaniel P. Banks"}],["$","small",null,{"children":"Opposed Jackson in the central and lower Valley and retreated after Front Royal and First Winchester"}]]}],["$","div","Mountain Department",{"className":"command-entry","children":[["$","strong",null,{"children":"Mountain Department"}],["$","span",null,{"children":"Maj. Gen. John C. Frémont"}],["$","small",null,{"children":"Milroy and Schenck fought at McDowell; Frémont later faced Ewell at Cross Keys"}]]}],["$","div","Division in McDowell’s department",{"className":"command-entry","children":[["$","strong",null,{"children":"Division in McDowell’s department"}],["$","span",null,{"children":"Brig. Gen. James Shields"}],["$","small",null,{"children":"His division fought at Kernstown under Nathan Kimball while Shields was wounded and later at Port Republic"}]]}]]]}],["$","section","Confederacy",{"className":"command-column #9a3d32","children":[["$","h3",null,{"children":"Confederacy"}],[["$","div","Confederate commander in chief",{"className":"command-entry","children":[["$","strong",null,{"children":"Confederate commander in chief"}],["$","span",null,{"children":"President Jefferson Davis"}],["$","small",null,{"children":"Used Lee as principal military adviser before placing him in field command near Richmond"}]]}],["$","div","Military adviser, then commander outside Richmond",{"className":"command-entry","children":[["$","strong",null,{"children":"Military adviser, then commander outside Richmond"}],["$","span",null,{"children":"Gen. Robert E. Lee"}],["$","small",null,{"children":"Supported the Valley diversion and summoned Jackson east on June 16 for the offensive against McClellan"}]]}],["$","div","Valley District and combined Valley Army",{"className":"command-entry","children":[["$","strong",null,{"children":"Valley District and combined Valley Army"}],["$","span",null,{"children":"Maj. Gen. Thomas J. “Stonewall” Jackson"}],["$","small",null,{"children":"Directed the campaign and controlled Ewell’s division and the brigades assessed in the episode"}]]}],["$","div","Division reinforcing Jackson",{"className":"command-entry","children":[["$","strong",null,{"children":"Division reinforcing Jackson"}],["$","span",null,{"children":"Maj. Gen. Richard S. Ewell"}],["$","small",null,{"children":"Joined the operations against Banks and commanded the Confederate field at Cross Keys"}]]}],["$","div","Brigade commanders",{"className":"command-entry","children":[["$","strong",null,{"children":"Brigade commanders"}],["$","span",null,{"children":"Brig. Gens. Charles S. Winder and Isaac R. Trimble"}],"$L40"]}],"$L41"]]}]]}],"$L42","$L43"]}]
26:["$","section",null,{"className":"reference-section","id":"losses","children":[["$","h2",null,{"children":"Important leaders killed or wounded"}],["$","div",null,{"className":"loss-list","children":[["$","article","Col. Turner Ashby",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Turner Ashby"}],["$","p",null,{"children":[["$","strong",null,{"children":["Valley Army cavalry commander","."]}]," ","Killed near Harrisonburg on June 6, 1862, during the retreat toward Cross Keys and Port Republic."]}]]}],["$","article","Col. Samuel V. Fulkerson",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Col. Samuel V. Fulkerson"}],["$","p",null,{"children":[["$","strong",null,{"children":["37th Virginia Infantry commander","."]}]," ","Survived the Valley Campaign, was mortally wounded at Gaines’s Mill later in June, and died from the wound. This was not a Valley Campaign casualty."]}]]}],["$","article","Gen. Joseph E. Johnston",{"children":[["$","span",null,{"className":"side confederate","children":"Confederacy"}],["$","h3",null,{"children":"Gen. Joseph E. Johnston"}],["$","p",null,{"children":[["$","strong",null,{"children":["Commander of the Confederate army defending Richmond","."]}]," ","Seriously wounded at Seven Pines on May 31 and survived. His incapacity led to Lee assuming command on June 1."]}]]}]]}]]}]
27:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/ep155-valley-campaign-overview.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep155-valley-campaign-overview.svg","alt":"Schematic operational map of Jackson’s 1862 Valley Campaign.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The sequence required repeated reversals of direction and ended with the turn east toward Richmond. All routes and positions are approximate."}]]}],["$","figure","/images/ep155-strategic-diversion.svg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep155-strategic-diversion.svg","alt":"Schematic diagram of Federal diversions and Jackson’s transfer to Richmond.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"The schematic separates documented diversions from the uncertain counterfactual effect of a full McDowell–McClellan junction."}]]}],["$","figure","/images/ep155-hotchkiss-valley-campaign-map.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep155-hotchkiss-valley-campaign-map.jpg","alt":"Nine-map proof sheet illustrating Jackson’s 1862 Valley Campaign.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Hotchkiss, D. C. Humphreys, and J. B. Lippincott prepared this proof sheet for William Allan’s 1880 history. It is a later compilation."}]]}],["$","figure","/images/ep155-stonewall-jackson.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep155-stonewall-jackson.jpg","alt":"Civil War-era photographic portrait of Confederate general Thomas J. Stonewall Jackson.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Jackson’s operational success made him a public hero. The episode balances that reputation with contemporary criticism from his army."}]]}],["$","figure","/images/ep155-robert-e-lee.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep155-robert-e-lee.jpg","alt":"Photographic portrait of Confederate general Robert E. Lee seated in uniform in 1864.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"This later wartime portrait shows Lee, who supported the Valley diversion and summoned Jackson toward Richmond."}]]}],["$","figure","/images/ep155-george-mcclellan.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/ep155-george-mcclellan.jpg","alt":"George B. McClellan standing in United States Army uniform in 1861.","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"McClellan’s advance against Richmond was the principal eastern operation. Federal reactions to Jackson reduced the reinforcement expected from McDowell."}]]}]]}]]}]
