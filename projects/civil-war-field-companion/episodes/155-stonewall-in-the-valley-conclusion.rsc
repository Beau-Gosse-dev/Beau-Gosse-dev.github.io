d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",155," · ","March 23–June 17, 1862"," · ","The Shenandoah Valley and adjacent Blue Ridge approaches in Virginia, with strategic consequences at Fredericksburg, Washington, and McClellan’s position outside Richmond"]}],["$","h1",null,{"children":"STONEWALL IN THE VALLEY: CONCLUSION"}],["$","span",null,{"className":"result-label","children":"Confederate campaign success. Jackson lost tactically at Kernstown, then defeated separated United States forces at McDowell, Front Royal, First Winchester, Cross Keys, and Port Republic. The campaign alarmed the Lincoln administration, kept Federal forces oriented toward the Valley, diverted part of McDowell’s command from the planned concentration with McClellan, and left Jackson free to march toward Richmond after Lee’s June 16 summons. The episode also stresses that Jackson’s tactical handling and relentless marches imposed heavy costs on his army"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"March 23–June 17, 1862"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"The Shenandoah Valley and adjacent Blue Ridge approaches in Virginia, with strategic consequences at Fredericksburg, Washington, and McClellan’s position outside Richmond"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Confederate campaign success. Jackson lost tactically at Kernstown, then defeated separated United States forces at McDowell, Front Royal, First Winchester, Cross Keys, and Port Republic. The campaign alarmed the Lincoln administration, kept Federal forces oriented toward the Valley, diverted part of McDowell’s command from the planned concentration with McClellan, and left Jackson free to march toward Richmond after Lee’s June 16 summons. The episode also stresses that Jackson’s tactical handling and relentless marches imposed heavy costs on his army"}]]}]]}],false,["$","div",null,{"className":"glance-forces","children":[["$","h3",null,{"children":"Forces and losses"}],["$","p",null,{"className":"glance-scope","children":"Reported figures retain the scope and estimates of the existing guide. They may cover different units or periods; missing breakdowns are not inferred."}],"$Lf","$L10"]}],"$undefined"]}],"$L11","$L12","$L13",false,"$L14","$L15","$L16","$L17","$L18","$L19"]}]]}]
