2b:["$","figcaption",null,{"children":[["$","strong",null,{"children":"Hotchkiss campaign maps of the Shenandoah Valley"}],["$","span",null,{"children":"This 1880 proof sheet contains nine maps prepared for William Allan’s campaign history, including a Valley overview and individual battle maps. It is a later historical compilation based partly on wartime surveying, not a single contemporaneous situation map."}],["$","span",null,{"className":"map-actions","children":[["$","a",null,{"href":"/projects/civil-war-field-companion/images/ep155-hotchkiss-valley-campaign-map.jpg","target":"_blank","rel":"noreferrer","children":["Open full-size map ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}],["$","a",null,{"href":"Library of Congress Geography and Map Division; see sources below.","target":"_blank","rel":"noreferrer","children":["Map source ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$23:props:children:1:props:children:0:props:children:1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":13}]]}]]}],"$undefined"]}]
2d:["$","div","Lee’s objective is connected to the campaign",{"className":"moment","children":[["$","$L2c",null,{"seconds":803,"label":"13:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee’s objective is connected to the campaign"}],["$","p",null,{"children":"Before taking field command, Lee supported operations intended to limit the Federal concentration against Richmond."}]]}]]}]
2e:["$","div","The Federal threat is measured",{"className":"moment","children":[["$","$L2c",null,{"seconds":837,"label":"13:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Federal threat is measured"}],["$","p",null,{"children":"The episode locates McClellan on the Peninsula, McDowell at Fredericksburg, Banks in the lower Valley, and Frémont west of it."}]]}]]}]
2f:["$","div","Kernstown becomes a strategic gain",{"className":"moment","children":[["$","$L2c",null,{"seconds":894,"label":"14:54"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kernstown becomes a strategic gain"}],["$","p",null,{"children":"Jackson’s tactical defeat helped convince Washington to retain or redirect troops against the perceived Valley threat."}]]}]]}]
30:["$","div","The campaign becomes a case study",{"className":"moment","children":[["$","$L2c",null,{"seconds":931,"label":"15:31"}],["$","div",null,{"children":[["$","h3",null,{"children":"The campaign becomes a case study"}],["$","p",null,{"children":"The hosts summarize Jackson’s rapid movement, deception, and willingness to accept risk against separated opponents."}]]}]]}]
31:["$","div","Success did not remove tactical flaws",{"className":"moment","children":[["$","$L2c",null,{"seconds":977,"label":"16:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Success did not remove tactical flaws"}],["$","p",null,{"children":"The episode identifies piecemeal commitment at the start of several battles as its main criticism of Jackson’s handling."}]]}]]}]
32:["$","div","Kernstown’s thin center is criticized",{"className":"moment","children":[["$","$L2c",null,{"seconds":1020,"label":"17:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"Kernstown’s thin center is criticized"}],["$","p",null,{"children":"Jackson concentrated on his left. The proposed alternative Federal advance through his center remains a counterfactual judgment."}]]}]]}]
33:["$","div","Milroy seizes the initiative at McDowell",{"className":"moment","children":[["$","$L2c",null,{"seconds":1062,"label":"17:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Milroy seizes the initiative at McDowell"}],["$","p",null,{"children":"The Federal spoiling attack on Sitlington’s Hill disrupted Jackson’s plan before Milroy and Schenck withdrew."}]]}]]}]
34:["$","div","Port Republic shows the cost",{"className":"moment","children":[["$","$L2c",null,{"seconds":1100,"label":"18:20"}],["$","div",null,{"children":[["$","h3",null,{"children":"Port Republic shows the cost"}],["$","p",null,{"children":"The episode says Winder resented the pounding his regiments endured while Jackson fed in additional units."}]]}]]}]
35:["$","div","The Valley Army’s view was mixed",{"className":"moment","children":[["$","$L2c",null,{"seconds":1116,"label":"18:36"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Valley Army’s view was mixed"}],["$","p",null,{"children":"Soldiers and officers credited Jackson with extraordinary results while recording the physical cost and danger of his methods."}]]}]]}]
36:["$","div","Attrition outside battle is emphasized",{"className":"moment","children":[["$","$L2c",null,{"seconds":1152,"label":"19:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Attrition outside battle is emphasized"}],["$","p",null,{"children":"The episode estimates that about 4,000 men left the ranks through exhaustion or desertion."}]]}]]}]
37:["$","div","Four generals warn about continued risk",{"className":"moment","children":[["$","$L2c",null,{"seconds":1163,"label":"19:23"}],["$","div",null,{"children":[["$","h3",null,{"children":"Four generals warn about continued risk"}],["$","p",null,{"children":"Howard recalled Winder, Trimble, Taliaferro, and Taylor agreeing that repeated risks could eventually produce disaster."}]]}]]}]
38:["$","div","Dabney criticizes the physical demands",{"className":"moment","children":[["$","$L2c",null,{"seconds":1189,"label":"19:49"}],["$","div",null,{"children":[["$","h3",null,{"children":"Dabney criticizes the physical demands"}],["$","p",null,{"children":"Three days after Port Republic, the exhausted staff officer privately criticized Jackson’s disregard for endurance."}]]}]]}]
39:["$","div","Winder records the same fatigue",{"className":"moment","children":[["$","$L2c",null,{"seconds":1237,"label":"20:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Winder records the same fatigue"}],["$","p",null,{"children":"Winder’s private notes condemn the rapid marches and describe him as worn out after Port Republic."}]]}]]}]
3a:["$","div","Jackson writes to his wife",{"className":"moment","children":[["$","$L2c",null,{"seconds":1268,"label":"21:08"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson writes to his wife"}],["$","p",null,{"children":"On June 14 Jackson described a thanksgiving service and expressed his longing to return home."}]]}]]}]
3b:["$","div","The army pauses at Brown’s Gap and Weyer’s Cave",{"className":"moment","children":[["$","$L2c",null,{"seconds":1320,"label":"22:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"The army pauses at Brown’s Gap and Weyer’s Cave"}],["$","p",null,{"children":"Jackson used the Blue Ridge position while Frémont and Shields withdrew, then returned to camp near Weyer’s Cave."}]]}]]}]
3c:["$","div","Jackson proposes another northern offensive",{"className":"moment","children":[["$","$L2c",null,{"seconds":1347,"label":"22:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jackson proposes another northern offensive"}],["$","p",null,{"children":"He requested enough reinforcements to field about 40,000 and proposed crossing the Potomac to threaten the North."}]]}]]}]
3d:["$","div","Lee chooses Richmond as the priority",{"className":"moment","children":[["$","$L2c",null,{"seconds":1393,"label":"23:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee chooses Richmond as the priority"}],["$","p",null,{"children":"With McClellan near the capital, Lee chose concentration for his counterattack over a renewed Valley offensive."}]]}]]}]
3e:["$","div","Lee summons Jackson on June 16",{"className":"moment","children":[["$","$L2c",null,{"seconds":1437,"label":"23:57"}],["$","div",null,{"children":[["$","h3",null,{"children":"Lee summons Jackson on June 16"}],["$","p",null,{"children":"Lee said the moment favored a junction. Jackson’s army began leaving the Valley on June 17."}]]}]]}]
3f:["$","div","The book recommendation",{"className":"moment","children":[["$","$L2c",null,{"seconds":1467,"label":"24:27"}],["$","div",null,{"children":[["$","h3",null,{"children":"The book recommendation"}],["$","p",null,{"children":"The hosts recommend “The Untold Civil War” by James I. Robertson Jr., edited by Neil Kagan."}]]}]]}]
40:["$","small",null,{"children":"Winder led the Stonewall Brigade at Port Republic; Trimble led a brigade at Cross Keys"}]
