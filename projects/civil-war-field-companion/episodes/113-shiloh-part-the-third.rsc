13:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The armies were twenty-three miles apart",{"className":"moment","children":[["$","$L18",null,{"seconds":221,"label":"3:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies were twenty-three miles apart"}],["$","p",null,{"children":"Grant’s army camped around Pittsburg Landing while Johnston and Beauregard assembled the Confederate army at Corinth."}]]}]]}],["$","div","Johnston’s intended attack emphasized the river flank",{"className":"moment","children":[["$","$L18",null,{"seconds":284,"label":"4:44"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston’s intended attack emphasized the river flank"}],["$","p",null,{"children":"The strongest push was to drive the United States left away from Pittsburg Landing and trap the army against Owl and Snake creeks."}]]}]]}],["$","div","The written order stacked the corps",{"className":"moment","children":[["$","$L18",null,{"seconds":325,"label":"5:25"}],["$","div",null,{"children":[["$","h3",null,{"children":"The written order stacked the corps"}],["$","p",null,{"children":"Hardee formed the first line, with Bragg, Polk, and Breckinridge following across the same frontage."}]]}]]}],["$","div","The Confederate approach began",{"className":"moment","children":[["$","$L18",null,{"seconds":444,"label":"7:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate approach began"}],["$","p",null,{"children":"The army had to move twenty-three miles from Corinth to its deployment area near the United States camps."}]]}]]}],["$","div","Rain and poor staff work disrupted the march",{"className":"moment","children":[["$","$L18",null,{"seconds":481,"label":"8:01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rain and poor staff work disrupted the march"}],["$","p",null,{"children":"Units used the wrong roads, blocked one another, and struggled to move artillery and wagons through deep mud."}]]}]]}],["$","div","More than 7,600 sick troops remained behind",{"className":"moment","children":[["$","$L18",null,{"seconds":540,"label":"9:00"}],["$","div",null,{"children":[["$","h3",null,{"children":"More than 7,600 sick troops remained behind"}],["$","p",null,{"children":"Disease in the camps near Corinth reduced the force before the march began."}]]}]]}],["$","div","Two roads carried the army north",{"className":"moment","children":[["$","$L18",null,{"seconds":635,"label":"10:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Two roads carried the army north"}],["$","p",null,{"children":"The Ridge and Monterey roads connected through smaller lanes and converged about five miles from Pittsburg Landing."}]]}]]}],["$","div","Most of the army reached position",{"className":"moment","children":[["$","$L18",null,{"seconds":706,"label":"11:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Most of the army reached position"}],["$","p",null,{"children":"By the evening of April 5, about 40,000 Confederates were prepared to attack the next morning."}]]}]]}],["$","div","Beauregard proposed canceling the attack",{"className":"moment","children":[["$","$L18",null,{"seconds":719,"label":"11:59"}],["$","div",null,{"children":[["$","h3",null,{"children":"Beauregard proposed canceling the attack"}],["$","p",null,{"children":"He believed the army lacked food and that two days of skirmishing had warned Grant."}]]}]]}],["$","div","The commanders debated withdrawal",{"className":"moment","children":[["$","$L18",null,{"seconds":759,"label":"12:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The commanders debated withdrawal"}],["$","p",null,{"children":"Beauregard, Bragg, Polk, Breckinridge, and Johnston met on Saturday evening. Bragg supported cancellation; Polk and Johnston supported attack."}]]}]]}],["$","div","Johnston ordered the attack to proceed",{"className":"moment","children":[["$","$L18",null,{"seconds":818,"label":"13:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston ordered the attack to proceed"}],["$","p",null,{"children":"Reports indicated that the United States camps had not prepared for a general attack, so Johnston directed the assault to begin at daylight."}]]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}]]}]
14:["$","section",null,{"className":"reference-section","id":"people","children":[["$","h2",null,{"children":"People and command"}],["$","div",null,{"className":"command-grid reference-command","children":[["$","section","United States",{"className":"command-column #315f8c","children":[["$","h3",null,{"children":"United States"}],[["$","div","Department of the Mississippi",{"className":"command-entry","children":[["$","strong",null,{"children":"Department of the Mississippi"}],["$","span",null,{"children":"Henry W. Halleck"}],["$","small",null,{"children":"Ordered Grant not to bring on a general engagement before Buell arrived"}]]}],["$","div","Army of the Tennessee",{"className":"command-entry","children":[["$","strong",null,{"children":"Army of the Tennessee"}],["$","span",null,{"children":"Ulysses S. Grant"}],["$","small",null,{"children":"Headquarters at Savannah; did not expect a major Confederate attack"}]]}],["$","div","5th Division / senior officer in the camps",{"className":"command-entry","children":[["$","strong",null,{"children":"5th Division / senior officer in the camps"}],["$","span",null,{"children":"William T. Sherman"}],["$","small",null,{"children":"Forward camps around Shiloh Church; dismissed multiple warnings"}]]}],["$","div","6th Division",{"className":"command-entry","children":[["$","strong",null,{"children":"6th Division"}],["$","span",null,{"children":"Benjamin M. Prentiss"}],["$","small",null,{"children":"Reinforced the picket line after seeing Confederate cavalry"}]]}],["$","div","1st Brigade, Prentiss’s division",{"className":"command-entry","children":[["$","strong",null,{"children":"1st Brigade, Prentiss’s division"}],["$","span",null,{"children":"Everett Peabody"}],["$","small",null,{"children":"Ordered Powell’s five-company reconnaissance without informing Prentiss"}]]}],["$","div","Reconnaissance detachment",{"className":"command-entry","children":[["$","strong",null,{"children":"Reconnaissance detachment"}],["$","span",null,{"chil