1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",113," · ","April 3–6, 1862; ending with the opening shots at about 5 a.m. on April 6"," · ","The roads from Corinth, Mississippi, to the United States camps around Shiloh Church and Pittsburg Landing, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Third)"}],["$","span",null,{"className":"result-label","children":"Rain, mud, poor staff work, and inexperienced troops delayed the Confederate approach for two days. Beauregard and Bragg argued for canceling the attack, but Johnston ordered it to proceed. Grant and Sherman received repeated reports of nearby Confederates but did not expect a general attack or fortify the camps. Everett Peabody sent a 400-man patrol before dawn on April 6; it met Aaron Hardcastle’s Mississippi battalion in Fraley Field and opened the Battle of Shiloh"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2076484636.mp3?updated=1695140542","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","Approach distance",{"children":[["$","span",null,{"children":"Approach distance"}],["$","strong",null,{"children":"About 23 road miles from Corinth to the United States camps"}],"$undefined"]}],["$","div","Confederates too sick to march",{"children":[["$","span",null,{"children":"Confederates too sick to march"}],["$","strong",null,{"children":"More than 7,600 remained near Corinth"}],"$undefined"]}],["$","div","Confederates reaching attack positions",{"children":[["$","span",null,{"children":"Confederates reaching attack positions"}],["$","strong",null,{"children":"About 40,000 by the evening of April 5"}],"$undefined"]}],["$","div","Combat experience",{"children":[["$","span",null,{"children":"Combat experience"}],["$","strong",null,{"children":"About 85 percent of Johnston’s soldiers had never been under fire"}],"$undefined"]}],["$","div","United States main camps",{"children":[["$","span",null,{"children":"United States main camps"}],["$","strong",null,{"children":"Five divisions near Pittsburg Landing; no field fortifications"}],"$undefined"]}],["$","div","Confederate distance on April 5",{"children":[["$","span",null,{"children":"Confederate distance on April 5"}],["$","strong",null,{"children":"The first line deployed within about one mile of the camps"}],"$undefined"]}],["$","div","Peabody patrol",{"children":[["$","span",null,{"children":"Peabody patrol"}],["$","strong",null,{"children":"About 400 men from the 25th Missouri and 12th Michigan"}],"$undefined"]}],["$","div","Battle opened",{"children":[["$","span",null,{"children":"Battle opened"}],["$","strong",null,{"children":"About 5 a.m. Sunday, April 6, in Fraley Field"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":