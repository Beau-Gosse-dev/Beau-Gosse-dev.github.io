d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",113," · ","April 3–6, 1862; ending with the opening shots at about 5 a.m. on April 6"," · ","The roads from Corinth, Mississippi, to the United States camps around Shiloh Church and Pittsburg Landing, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Third)"}],["$","span",null,{"className":"result-label","children":"Rain, mud, poor staff work, and inexperienced troops delayed the Confederate approach for two days. Beauregard and Bragg argued for canceling the attack, but Johnston ordered it to proceed. Grant and Sherman received repeated reports of nearby Confederates but did not expect a general attack or fortify the camps. Everett Peabody sent a 400-man patrol before dawn on April 6; it met Aaron Hardcastle’s Mississippi battalion in Fraley Field and opened the Battle of Shiloh"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 1