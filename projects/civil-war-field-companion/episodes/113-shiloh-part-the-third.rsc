19:["$","div","The Confederates bivouacked without fires",{"className":"moment","children":[["$","$L18",null,{"seconds":864,"label":"14:24"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederates bivouacked without fires"}],["$","p",null,{"children":"The troops slept close to the enemy in cold conditions, and many had little food or rest."}]]}]]}]
1a:["$","div","Grant did not expect an attack",{"className":"moment","children":[["$","$L18",null,{"seconds":993,"label":"16:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant did not expect an attack"}],["$","p",null,{"children":"He believed the Confederate concentration at Corinth was defensive and remained at Savannah, nine miles downriver."}]]}]]}]
1b:["$","div","United States reconnaissance remained limited",{"className":"moment","children":[["$","$L18",null,{"seconds":1053,"label":"17:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"United States reconnaissance remained limited"}],["$","p",null,{"children":"Halleck’s order to avoid a general engagement contributed to shallow patrols and the dismissal of skirmishing as routine activity."}]]}]]}]
1c:["$","div","The camps had no field fortifications",{"className":"moment","children":[["$","$L18",null,{"seconds":1090,"label":"18:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"The camps had no field fortifications"}],["$","p",null,{"children":"Grant, Sherman, and C.F. Smith treated Pittsburg Landing as a base for an offensive rather than a position likely to be attacked."}]]}]]}]
1d:["$","div","The camp area could become a trap",{"className":"moment","children":[["$","$L18",null,{"seconds":1238,"label":"20:38"}],["$","div",null,{"children":[["$","h3",null,{"children":"The camp area could become a trap"}],["$","p",null,{"children":"A successful Confederate drive away from the river could pin Grant’s army against the creeks and cut it off from Pittsburg Landing."}]]}]]}]
1e:["$","div","Sherman and Grant discounted the danger",{"className":"moment","children":[["$","$L18",null,{"seconds":1288,"label":"21:28"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman and Grant discounted the danger"}],["$","p",null,{"children":"Both sent messages on April 5 saying that they did not expect a major attack."}]]}]]}]
1f:["$","div","The Confederate lines moved close to the camps",{"className":"moment","children":[["$","$L18",null,{"seconds":1362,"label":"22:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Confederate lines moved close to the camps"}],["$","p",null,{"children":"Hardee deployed first, Bragg formed about 1,000 yards behind him, Polk followed, and Breckinridge came into reserve."}]]}]]}]
20:["$","div","Reports increased along the picket line",{"className":"moment","children":[["$","$L18",null,{"seconds":1459,"label":"24:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Reports increased along the picket line"}],["$","p",null,{"children":"United States soldiers in the forward camps saw Confederate cavalry, skirmishers, and other signs of a large force nearby."}]]}]]}]
21:["$","div","Jesse Appler alerted Sherman",{"className":"moment","children":[["$","$L18",null,{"seconds":1493,"label":"24:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jesse Appler alerted Sherman"}],["$","p",null,{"children":"The 53rd Ohio formed in Ray Field after reports of a strong skirmish line. Sherman rejected the warning and ordered the regiment back to camp."}]]}]]}]
22:["$","div","Prentiss reinforced his pickets",{"className":"moment","children":[["$","$L18",null,{"seconds":1542,"label":"25:42"}],["$","div",null,{"children":[["$","h3",null,{"children":"Prentiss reinforced his pickets"}],["$","p",null,{"children":"After seeing Confederate cavalry, he sent four companies of the 16th Wisconsin forward for the night."}]]}]]}]
23:["$","div","Peabody ordered a reconnaissance",{"className":"moment","children":[["$","$L18",null,{"seconds":1601,"label":"26:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Peabody ordered a reconnaissance"}],["$","p",null,{"children":"At about midnight, Major James Powell reported hearing many troops. Peabody sent five companies, about 400 men, forward at 3 a.m."}]]}]]}]
24:["$","div","Powell entered Fraley Field",{"className":"moment","children":[["$","$L18",null,{"seconds":1728,"label":"28:48"}],["$","div",null,{"children":[["$","h3",null,{"children":"Powell entered Fraley Field"}],["$","p",null,{"children":"The patrol passed the 57th Ohio pickets, crossed the Corinth Road, and exchanged shots with Confederate cavalry before reaching the far fence line."}]]}]]}]
25:["$","div","Hardcastle’s battalion fired a volley",{"className":"moment","children":[["$","$L18",null,{"seconds":1786,"label":"29:46"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hardcastle’s battalion fired a volley"}],["$","p",null,{"children":"Mississippi infantry opened fire from the edge of Fraley Field. Powell’s men returned fire at about 5 a.m."}]]}]]}]
26:["$","div","Johnston ended the debate",{"className":"moment","children":[["$","$L18",null,{"seconds":1837,"label":"30:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston ended the debate"}],["$","p",null,{"children":"Hearing the firing, Johnston stated that the battle had opened and ordered the army forward."}]]}]]}]
