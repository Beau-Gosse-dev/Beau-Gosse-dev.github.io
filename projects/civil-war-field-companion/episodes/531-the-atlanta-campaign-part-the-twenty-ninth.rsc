11:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","The armies reached the Chattahoochee",{"className":"moment","children":[["$","$L16",null,{"seconds":79,"label":"1:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"The armies reached the Chattahoochee"}],["$","p",null,{"children":"Johnston held the Shoup Line on the north bank. Sherman’s original order had been to destroy Johnston’s army, but Atlanta had become the practical objective."}]]}]]}],["$","div","Atlanta developed around its railroads",{"className":"moment","children":[["$","$L16",null,{"seconds":220,"label":"3:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Atlanta developed around its railroads"}],["$","p",null,{"children":"The city grew after the Western and Atlantic Railroad reached the settlement in 1845. By 1860, four major rail lines met there."}]]}]]}],["$","div","Four routes made Atlanta a transportation center",{"className":"moment","children":[["$","$L16",null,{"seconds":305,"label":"5:05"}],["$","div",null,{"children":[["$","h3",null,{"children":"Four routes made Atlanta a transportation center"}],["$","p",null,{"children":"Railroads linked Atlanta with Chattanooga, Augusta, Montgomery, Mobile, Macon, the Georgia coast, Wilmington, and Charleston."}]]}]]}],["$","div","Atlanta’s military importance had increased",{"className":"moment","children":[["$","$L16",null,{"seconds":362,"label":"6:02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Atlanta’s military importance had increased"}],["$","p",null,{"children":"Earlier Confederate transportation and industrial centers had been captured, leaving Atlanta as a major railroad hub, arsenal, industrial center, and supply depot."}]]}]]}],["$","div","Confederate leaders called for Atlanta to be held",{"className":"moment","children":[["$","$L16",null,{"seconds":493,"label":"8:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate leaders called for Atlanta to be held"}],["$","p",null,{"children":"Georgia governor Joseph E. Brown and newspaper editors argued that losing the city would disrupt transportation and supplies across the remaining Confederacy."}]]}]]}],["$","div","Sherman treated the city as a visible military objective",{"className":"moment","children":[["$","$L16",null,{"seconds":527,"label":"8:47"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman treated the city as a visible military objective"}],["$","p",null,{"children":"Atlanta’s capture would be clear evidence of U.S. progress while Grant remained outside Petersburg and the presidential election approached."}]]}]]}],["$","div","Sherman chose an upstream crossing",{"className":"moment","children":[["$","$L16",null,{"seconds":593,"label":"9:53"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman chose an upstream crossing"}],["$","p",null,{"children":"Thomas held the Confederates in place while Schofield moved toward Soap Creek and McPherson demonstrated downstream."}]]}]]}],["$","div","Johnston concentrated against a downstream crossing",{"className":"moment","children":[["$","$L16",null,{"seconds":753,"label":"12:33"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston concentrated against a downstream crossing"}],["$","p",null,{"children":"Johnston expected Sherman to repeat earlier movements against the Confederate left. Only small Georgia militia detachments guarded the river upstream."}]]}]]}],["$","div","Schofield crossed at Soap Creek",{"className":"moment","children":[["$","$L16",null,{"seconds":910,"label":"15:10"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schofield crossed at Soap Creek"}],["$","p",null,{"children":"At 3 p.m. on July 8, 50 soldiers crossed on a submerged fish weir. Engineers completed two pontoon bridges after dark, and an entire division followed."}]]}]]}],["$","div","Garrard crossed at Roswell",{"className":"moment","children":[["$","$L16",null,{"seconds":979,"label":"16:19"}],["$","div",null,{"children":[["$","h3",null,{"children":"Garrard crossed at Roswell"}],"$L17"]}]]}],"$L18","$L19"]}]]}]
