d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",531," · ","July 8–10, 1864"," · ","Chattahoochee River north of Atlanta, Georgia"]}],["$","h1",null,{"children":"THE ATLANTA CAMPAIGN (Part the Twenty-ninth)"}],["$","span",null,{"className":"result-label","children":"U.S. forces established bridgeheads above the Confederate right, forcing Johnston to abandon the Shoup Line"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"July 8–10, 1864"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Chattahoochee River north of Atlanta, Georgia"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"U.S. forces established bridgeheads above the Confederate right, forcing Johnston to abandon the Shoup Line"}]]}]]}],false,false,"$undefined"]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#battle-flow","children":"Episode flow"}],["$","a",null,{"href":"#maps","children":"Maps"}],false,["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}],["$","a",null,{"href":"#feedback","children":"Suggest a change"}]]}],["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$Lf",null,{"guide":{"date":"July 8–10, 1864","place":"Chattahoochee River north of Atlanta, Georgia","result":"U.S. forces established bridgeheads above the Confederate right, forcing Johnston to abandon the Shoup Line","facts":[{"label":"Atlanta population in 1860","value":"Fewer than 10,000 people, including enslaved residents"},{"label":"Major railroads","value":"Four lines connected Atlanta to other parts of the Confederacy"},{"label":"First bridgehead","value":"Soap Creek, July 8"},{"label":"Second bridgehead","value":"Roswell, July 9"},{"label":"Confederate withdrawal","value":"Night of July 9–10"}],"maps":[{"title":"Chattahoochee crossings and the approach to Atlanta","caption":"The campaign map shows the Shoup Line near the railroad crossing, Soap Creek, Roswell, the roads toward Atlanta, and the fortified lines south of the river.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-4.jpg","alt":"U.S. Army map showing the Chattahoochee River, Roswell, Marietta, and Atlanta"},{"title":"Soap Creek, Roswell, and Atlanta today","caption":"Schofield crossed near Soap Creek and Kenner Garrard crossed at Roswell, both upstream from Johnston’s fortified position.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.64%2C33.72%2C-84.19%2C34.12&layer=mapnik&marker=33.9528%2C-84.3866"},{"title":"The wider Atlanta campaign","caption":"Blue lines trace U.S. operations south from Chattanooga. Red lines trace Confederate positions and withdrawals toward Atlanta.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-3.jpg","alt":"Historical map of the Atlanta campaign across northwestern Georgia"}],"moments":[{"time":"1:19","audioTime":79,"title":"The armies reached the Chattahoochee","detail":"Johnston held the Shoup Line on the north bank. Sherman’s original order had been to destroy Johnston’s army, but Atlanta had become the practical objective."},{"time":"3:40","audioTime":220,"title":"Atlanta developed around its railroads","detail":"The city grew after the Western and Atlantic Railroad reached the settlement in 1845. By 1860, four major rail lines met there."},{"time":"5:05","audioTime":305,"title":"Four routes made Atlanta a transportation center","detail":"Railroads linked Atlanta with Chattanooga, Augusta, Montgomery, Mobile, Macon, the Georgia coast, Wilmington, and Charleston."},{"time":"6:02","audioTime":362,"title":"Atlanta’s military importance had increased","detail":"Earlier Confederate transportation and industrial centers had been captured, leaving Atlanta as a major railroad hub, arsenal, industrial center, and supply depot."},{"time":"8:13","audioTime":493,"title":"Confederate leaders called for Atlanta to be held","detail":"Georgia governor Joseph E. Brown and newspaper editors argued that losing the city would disrupt transportation and supplies across the remaining Confederacy."},{"time":"8:47","audioTime":527,"title":"Sherman treated the city as a visible military objective","detail":"Atlanta’s capture would be clear evidence of U.S. progress while Grant remained outside Petersburg and the presidential election approached."},{"time":"9:53","audioTime":593,"title":"Sherman chose an upstream crossing","detail":"Thomas held the Confederates in place while Schofield moved toward Soap Creek and McPherson demonstrated downstream."},{"time":"12:33","audioTime":753,"title":"Johnston concentrated against a downstream crossing","detail":"Johnston expected Sherman to repeat earlier movements against the Confederate left. Only small Georgia militia detachments guarded the river upstream."},{"time":"15:10","audioTime":910,"title":"Schofield crossed at Soap Creek","detail":"At 3 p.m. on July 8, 50 soldiers crossed on a submerged fish weir. Engineers completed two pontoon bridges after dark, and an entire division followed."},{"time":"16:19","audioTime":979,"title":"Garrard crossed at Roswell","detail":"On July 9, cavalrymen with repeating carbines waded across the river. By 7 a.m. they held a second bridgehead."},{"time":"17:25","audioTime":1045,"title":"The 1st Tennessee Cavalry made another crossing","detail":"James P. Brownlow and eight men swam the river with their weapons on a small raft, moved behind Confederate pickets, and captured 12 men."},{"time":"23:02","audioTime":1382,"title":"Johnston abandoned the Shoup Line","detail":"During the night of July 9–10, the Army of Tennessee crossed the river, burned the railroad bridge, removed its pontoon bridges, and withdrew toward Atlanta."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed the crossing plan"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Demonstrated in front of the Shoup Line"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"XXIII Corps crossed at Soap Creek"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"Demonstrated downstream near Nickajack Creek"},{"commander":"Kenner Garrard","command":"Cavalry division","subordinates":"Crossed at Roswell"},{"commander":"James P. Brownlow","command":"1st Tennessee Cavalry","subordinates":"Led a nine-man river crossing"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Ordered the withdrawal to Atlanta"},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Part of the Chattahoochee defense"},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Part of the Chattahoochee defense"},{"commander":"Alexander P. Stewart","command":"Stewart’s Corps","subordinates":"Part of the Chattahoochee defense"},{"commander":"Gustavus W. Smith","command":"Georgia militia","subordinates":"Small detachments guarded upstream crossings"}]}],"people":[{"name":"James P. Brownlow","role":"Led eight other cavalrymen across the Chattahoochee and captured Confederate pickets","side":"United States"},{"name":"Kenner Garrard","role":"Led the U.S. cavalry crossing at Roswell","side":"United States"},{"name":"John M. Schofield","role":"Selected and secured the Soap Creek crossing","side":"United States"},{"name":"Joseph E. Johnston","role":"Concentrated against a downstream crossing and then withdrew toward Atlanta","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"Joseph E. Brown","role":"Governor of Georgia who emphasized Atlanta’s importance to the Confederacy","side":"Confederacy"},{"name":"William R. Carter","role":"1st Tennessee Cavalry sergeant whose account describes Brownlow’s crossing","side":"United States"}],"losses":[],"gallery":[{"image":"/images/brownlow-picket-hunt.jpg","alt":"Harper’s Weekly illustration of James Brownlow and U.S. cavalrymen crossing the Chattahoochee River","caption":"Theodore R. Davis’s illustration of Brownlow’s crossing, published in Harper’s Weekly on August 13, 1864.","source":"https://commons.wikimedia.org/wiki/File:Colonel_Brownlow_on_a_Picket_Hunt_%E2%80%94_Sketched_by_Theodore_R._Davis_(Harper%27s_Weekly,_August_13,_1864).jpg"},{"image":"/images/atlanta-railroad-depot.jpg","alt":"Atlanta railroad depot photographed in 1864","caption":"Atlanta’s railroad depot. Four major rail lines made the city an important Confederate transportation and supply center.","source":"https://www.loc.gov/item/2018666982/"}],"sources":[{"label":"Official Episode 531 page","url":"https://civilwarpodcast.org/2026/06/22/civil-war-podcast-episode-531/"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"Library of Congress Atlanta railroad depot photograph","url":"https://www.loc.gov/item/2018666982/"},{"label":"Harper’s Weekly Brownlow illustration","url":"https://commons.wikimedia.org/wiki/File:Colonel_Brownlow_on_a_Picket_Hunt_%E2%80%94_Sketched_by_Theodore_R._Davis_(Harper%27s_Weekly,_August_13,_1864).jpg"}]}}]}],"$L10",false,"$L11",false,"$L12","$L13","$L14","$L15"]}]]}]
