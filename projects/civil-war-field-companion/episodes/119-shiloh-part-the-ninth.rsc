d:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",119," · ","April 6, 1862, about noon through nightfall"," · ","Jones Field and the western Shiloh battlefield; Crump’s Landing, Stoney Lonesome, the Shunpike, River Road, and Pittsburg Landing, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Ninth)"}],["$","span",null,{"className":"result-label","children":"Sherman and McClernand counterattacked from Jones Field around noon or 12:30 p.m. Fourteen regiments advanced, surprised the Confederate left, and drove part of it back nearly half a mile before ammunition shortages forced a return to Jones Field. The attack delayed and further disorganized Hardee’s forces. North of the battlefield, Lew Wallace received Grant’s written order at about 11:30 a.m., allowed a meal break, and marched on the Shunpike toward Sherman’s former position. After learning after 2 p.m. that the United States line had moved, he countermarched, crossed to the River Road, and reached Grant’s army after dark following a march of at least sixteen miles"}]]}],["$","a",null,{"className":"primary-button","href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3","key":"1xhozi"}]],"className":"lucide-headphones","size":16}]," Visit the official podcast website ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16}]]}]]}],["$","section",null,{"className":"episode-glance","aria-labelledby":"episode-glance-title","children":[["$","h2",null,{"id":"episode-glance-title","children":"Episode at a glance"}],["$","div",null,{"className":"battle-facts","children":[["$","div",null,{"children":[["$","span",null,{"children":"Period covered"}],["$","strong",null,{"children":"April 6, 1862, about noon through nightfall"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Location"}],["$","strong",null,{"children":"Jones Field and the western Shiloh battlefield; Crump’s Landing, Stoney Lonesome, the Shunpike, River Road, and Pittsburg Landing, Tennessee"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Historical context"}],["$","strong",null,{"children":"Sherman and McClernand counterattacked from Jones Field around noon or 12:30 p.m. Fourteen regiments advanced, surprised the Confederate left, and drove part of it back nearly half a mile before ammunition shortages forced a return to Jones Field. The attack delayed and further disorganized Hardee’s forces. North of the battlefield, Lew Wallace received Grant’s written order at about 11:30 a.m., allowed a meal break, and marched on the Shunpike toward Sherman’s former position. After learning after 2 p.m. that the United States line had moved, he countermarched, crossed to the River Road, and reached Grant’s army after dark following a march of at least sixteen miles"}]]}]]}],false,false,"$undefined"]}],"$Lf","$L10","$L11",false,"$L12",false,"$L13","$L14","$L15","$L16"]}]]}]
