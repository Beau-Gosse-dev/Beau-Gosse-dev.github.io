1:["$","main",null,{"className":"episode-page","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/#archive","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All episodes"]}]]}],["$","article",null,{"className":"battle-reference","children":[["$","header",null,{"className":"reference-header","children":[["$","div",null,{"children":[["$","p",null,{"children":["Episode ",119," · ","April 6, 1862, about noon through nightfall"," · ","Jones Field and the western Shiloh battlefield; Crump’s Landing, Stoney Lonesome, the Shunpike, River Road, and Pittsburg Landing, Tennessee"]}],["$","h1",null,{"children":"SHILOH (Part the Ninth)"}],["$","span",null,{"className":"result-label","children":"Sherman and McClernand counterattacked from Jones Field around noon or 12:30 p.m. Fourteen regiments advanced, surprised the Confederate left, and drove part of it back nearly half a mile before ammunition shortages forced a return to Jones Field. The attack delayed and further disorganized Hardee’s forces. North of the battlefield, Lew Wallace received Grant’s written order at about 11:30 a.m., allowed a meal break, and marched on the Shunpike toward Sherman’s former position. After learning after 2 p.m. that the United States line had moved, he countermarched, crossed to the River Road, and reached Grant’s army after dark following a march of at least sixteen miles"}]]}],["$","audio",null,{"id":"episode-audio","controls":true,"preload":"none","src":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3475285953.mp3?updated=1695140665","children":"Your browser does not support audio playback."}]]}],["$","section",null,{"className":"battle-facts","aria-label":"Battle facts","children":[["$","div","United States counterattack",{"children":[["$","span",null,{"children":"United States counterattack"}],["$","strong",null,{"children":"About noon or 12:30 p.m. from Jones Field"}],"$undefined"]}],["$","div","Regiments documented in attack",{"children":[["$","span",null,{"children":"Regiments documented in attack"}],["$","strong",null,{"children":"14 of 22 in Sherman’s and McClernand’s sector"}],"$undefined"]}],["$","div","Ground regained",{"children":[["$","span",null,{"children":"Ground regained"}],["$","strong",null,{"children":"Nearly half a mile on McDowell’s front"}],"$undefined"]}],["$","div","Reason for withdrawal",{"children":[["$","span",null,{"children":"Reason for withdrawal"}],["$","strong",null,{"children":"Regiments ran out of ammunition"}],"$undefined"]}],["$","div","Wallace’s division assembled",{"children":[["$","span",null,{"children":"Wallace’s division assembled"}],["$","strong",null,{"children":"About 6 a.m. at Stoney Lonesome"}],"$undefined"]}],["$","div","Written order received",{"children":[["$","span",null,{"children":"Written order received"}],["$","strong",null,{"children":"About 11:30 a.m."}],"$undefined"]}],["$","div","Route corrected",{"children":[["$","span",null,{"children":"Route corrected"}],["$","strong",null,{"children":"After 2 p.m., following Rowley’s arrival"}],"$undefined"]}],["$","div","Wallace’s total march",{"children":[["$","span",null,{"children":"Wallace’s total march"}],["$","strong",null,{"children":"At least 16 miles in 7–8 hours; arrival after dark"}],"$undefined"]}]]}],["$","nav",null,{"className":"reference-nav","aria-label":"Episode guide sections","children":[["$","a",null,{"href":"#maps","children":"Maps"}],["$","a",null,{"href":"#events","children":"What happened"}],["$","a",null,{"href":"#people","children":"People and command"}],false,["$","a",null,{"href":"#images","children":"Images"}]]}],["$","section",null,{"className":"reference-section maps-section","id":"maps","children":["$Le","$Lf"]}],"$L10","$L11",false,"$L12","$L13","$L14"]}]]}]
