12:["$","section",null,{"className":"reference-section","id":"images","children":[["$","h2",null,{"children":"Historical images"}],["$","div",null,{"className":"history-gallery","children":[["$","figure","/images/pittsburg-landing-1862.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/pittsburg-landing-1862.jpg","alt":"Pittsburg Landing on the Tennessee River in 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Grant expected Wallace’s fresh division to reach this area by midday; it arrived after dark."}]]}],["$","figure","/images/shiloh-battlefield-april-9.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-battlefield-april-9.jpg","alt":"The Shiloh battlefield photographed April 9, 1862","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Mud, wooded roads, and flooded bottomland slowed both reinforcement columns approaching the battlefield."}]]}],["$","figure","/images/shiloh-battle-print.jpg",{"children":[["$","img",null,{"src":"/projects/civil-war-field-companion/images/shiloh-battle-print.jpg","alt":"Historical print of the Battle of Shiloh","width":1280,"height":820,"loading":"lazy"}],["$","figcaption",null,{"children":"Sherman and McClernand’s counterattack kept much of the Confederate army occupied on the western battlefield."}]]}]]}]]}]
