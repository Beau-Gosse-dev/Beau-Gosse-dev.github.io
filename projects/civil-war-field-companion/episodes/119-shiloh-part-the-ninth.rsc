1a:["$","div",null,{"children":[["$","h3",null,{"children":"Wallace assembled at Stoney Lonesome"}],["$","p",null,{"children":"Around 6 a.m., he concentrated his division where roads led both to Pittsburg Landing and to Sherman’s original right."}]]}]
1b:["$","div","Grant met Wallace at Crump’s Landing",{"className":"moment","children":[["$","$L18",null,{"seconds":995,"label":"16:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant met Wallace at Crump’s Landing"}],["$","p",null,{"children":"At about 8:30 a.m., Grant told Wallace to remain ready to march when further orders arrived."}]]}]]}]
1c:["$","div","Grant sent the written order",{"className":"moment","children":[["$","$L18",null,{"seconds":1075,"label":"17:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Grant sent the written order"}],["$","p",null,{"children":"After reaching Pittsburg Landing around 9 or 9:30, Grant dispatched A. S. Baxter by steamer to order Wallace forward."}]]}]]}]
1d:["$","div","Baxter could not find the division",{"className":"moment","children":[["$","$L18",null,{"seconds":1115,"label":"18:35"}],["$","div",null,{"children":[["$","h3",null,{"children":"Baxter could not find the division"}],["$","p",null,{"children":"Crump’s Landing was deserted. Wallace had left a horse but no staff officer to direct the messenger to Stoney Lonesome, costing about an hour."}]]}]]}]
1e:["$","div","Wallace received the order at about 11:30",{"className":"moment","children":[["$","$L18",null,{"seconds":1213,"label":"20:13"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wallace received the order at about 11:30"}],["$","p",null,{"children":"The written order was later lost, and witnesses disagreed over whether it specified Sherman’s right or the River Road toward Pittsburg Landing."}]]}]]}]
1f:["$","div","Wallace selected the Shunpike",{"className":"moment","children":[["$","$L18",null,{"seconds":1252,"label":"20:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wallace selected the Shunpike"}],["$","p",null,{"children":"He chose the road leading to Sherman’s original right rather than the River Road leading behind the army’s changing line."}]]}]]}]
20:["$","div","The division paused for a meal",{"className":"moment","children":[["$","$L18",null,{"seconds":1312,"label":"21:52"}],["$","div",null,{"children":[["$","h3",null,{"children":"The division paused for a meal"}],["$","p",null,{"children":"Wallace allowed a half-hour dinner break after receiving the order, despite knowing that a battle was underway."}]]}]]}]
21:["$","div","Rowley reached Wallace after 2 p.m.",{"className":"moment","children":[["$","$L18",null,{"seconds":1461,"label":"24:21"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rowley reached Wallace after 2 p.m."}],["$","p",null,{"children":"He explained that Sherman no longer held the Shunpike destination and that Grant wanted the division at Pittsburg Landing."}]]}]]}]
22:["$","div","Wallace countermarched",{"className":"moment","children":[["$","$L18",null,{"seconds":1540,"label":"25:40"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wallace countermarched"}],["$","p",null,{"children":"He preserved the order of his column, adding about half an hour before taking a rough crossroad toward the River Road."}]]}]]}]
23:["$","div","Rawlins and McPherson overtook the column",{"className":"moment","children":[["$","$L18",null,{"seconds":1627,"label":"27:07"}],["$","div",null,{"children":[["$","h3",null,{"children":"Rawlins and McPherson overtook the column"}],["$","p",null,{"children":"They found Wallace’s division halted on the crossroad and urged faster movement; McPherson suggested moving artillery to speed the march."}]]}]]}]
24:["$","div","The column reached the River Road",{"className":"moment","children":[["$","$L18",null,{"seconds":1717,"label":"28:37"}],["$","div",null,{"children":[["$","h3",null,{"children":"The column reached the River Road"}],["$","p",null,{"children":"It moved south through deep mud and standing water in the Snake Creek bottomland."}]]}]]}]
25:["$","div","The final defensive guns were audible",{"className":"moment","children":[["$","$L18",null,{"seconds":1774,"label":"29:34"}],["$","div",null,{"children":[["$","h3",null,{"children":"The final defensive guns were audible"}],["$","p",null,{"children":"Grant’s siege guns signaled that the army was making its last stand near Pittsburg Landing."}]]}]]}]
26:["$","div","Wallace arrived after dark",{"className":"moment","children":[["$","$L18",null,{"seconds":1816,"label":"30:16"}],["$","div",null,{"children":[["$","h3",null,{"children":"Wallace arrived after dark"}],["$","p",null,{"children":"The 3rd Division completed at least sixteen miles in seven or eight hours despite beginning the day roughly five miles from the battlefield."}]]}]]}]
27:["$","h3",null,{"children":"Lew Wallace"}]
28:["$","p",null,{"children":"Led the 3rd Division along the wrong approach for the army’s changed position and arrived after dark"}]
29:["$","article","John A. Rawlins",{"className":"person-card","children":[["$","div",null,{"className":"portrait-placeholder","children":["$","span",null,{"children":"JA"}]}],["$","div",null,{"children":[["$","span",null,{"className":"side union","children":"United States"}],["$","h3",null,{"children":"John A. Rawlins"}],["$","p",null,{"children":"Grant’s senior staff officer who dictated the first written order and later overtook Wallace’s column"}]]}]]}]
