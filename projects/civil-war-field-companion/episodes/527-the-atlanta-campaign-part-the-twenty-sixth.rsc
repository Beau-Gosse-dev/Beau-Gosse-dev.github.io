18:["$","div",null,{"children":[["$","h3",null,{"children":"McPherson began leaving the U.S. left"}],["$","p",null,{"children":"Thomas shifted troops into the vacated positions and Benjamin Scribner’s brigade built a refused flank to protect the north end of the line."}]]}]
19:["$","div","Johnston detected the movement",{"className":"moment","children":[["$","$L17",null,{"seconds":906,"label":"15:06"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston detected the movement"}],["$","p",null,{"children":"Confederate observers saw large wagon movements. Johnston knew the U.S. armies were moving south and decided the Kennesaw position could not be held."}]]}]]}]
1a:["$","div","Johnston ordered a withdrawal",{"className":"moment","children":[["$","$L17",null,{"seconds":972,"label":"16:12"}],["$","div",null,{"children":[["$","h3",null,{"children":"Johnston ordered a withdrawal"}],["$","p",null,{"children":"At 1:30 p.m. on July 2, army headquarters issued detailed orders. Artillery would leave at dusk, Loring at 10 p.m., Hardee and Hood at 11, and rear guards at 1 a.m."}]]}]]}]
1b:["$","div","Confederate artillery left Little Kennesaw",{"className":"moment","children":[["$","$L17",null,{"seconds":1061,"label":"17:41"}],["$","div",null,{"children":[["$","h3",null,{"children":"Confederate artillery left Little Kennesaw"}],["$","p",null,{"children":"George Storrs cleared the mountain roads and removed every gun while brush screens concealed the empty embrasures."}]]}]]}]
1c:["$","div","Infantry rear guards concealed the retreat",{"className":"moment","children":[["$","$L17",null,{"seconds":1110,"label":"18:30"}],["$","div",null,{"children":[["$","h3",null,{"children":"Infantry rear guards concealed the retreat"}],["$","p",null,{"children":"Patrick Cleburne’s division withdrew quietly. Covered trenches, scattered skirmishers, and burning turpentine balls hid movements around Cheatham Hill."}]]}]]}]
1d:["$","div","The Army of Tennessee reached Smyrna",{"className":"moment","children":[["$","$L17",null,{"seconds":1299,"label":"21:39"}],["$","div",null,{"children":[["$","h3",null,{"children":"The Army of Tennessee reached Smyrna"}],["$","p",null,{"children":"The dark, dry night and familiar roads allowed most units to arrive on schedule and begin new earthworks before U.S. troops appeared."}]]}]]}]
1e:["$","div","McPherson briefly misread the Confederate activity",{"className":"moment","children":[["$","$L17",null,{"seconds":1331,"label":"22:11"}],["$","div",null,{"children":[["$","h3",null,{"children":"McPherson briefly misread the Confederate activity"}],["$","p",null,{"children":"He paused his own withdrawal because he thought the movement and reduced campfires might precede a night attack."}]]}]]}]
