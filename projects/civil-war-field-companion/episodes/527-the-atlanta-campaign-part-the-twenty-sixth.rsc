12:["$","section",null,{"className":"reference-section","id":"events","children":[["$","h2",null,{"children":"What happened"}],["$","div",null,{"className":"timeline factual-timeline","children":[["$","div","Sherman ruled out another attack at Kennesaw",{"className":"moment","children":[["$","$L17",null,{"seconds":78,"label":"1:18"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sherman ruled out another attack at Kennesaw"}],["$","p",null,{"children":"After the June 27 assaults, Sherman decided to move south around the Confederate left even though the maneuver temporarily separated much of his army from the railroad."}]]}]]}],["$","div","Final orders were issued on July 1",{"className":"moment","children":[["$","$L17",null,{"seconds":137,"label":"2:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Final orders were issued on July 1"}],["$","p",null,{"children":"Schofield was to secure the ground toward Nickajack Creek, McPherson was to move south and join him, and Thomas was to continue holding the existing U.S. line."}]]}]]}],["$","div","Schofield opened the movement",{"className":"moment","children":[["$","$L17",null,{"seconds":235,"label":"3:55"}],["$","div",null,{"children":[["$","h3",null,{"children":"Schofield opened the movement"}],["$","p",null,{"children":"At 6 a.m., Milo Hascall’s division advanced along the Sandtown Road, pushed back Confederate cavalry, and occupied a road junction near the Moss House."}]]}]]}],["$","div","Jacob Cox reinforced the road junction",{"className":"moment","children":[["$","$L17",null,{"seconds":317,"label":"5:17"}],["$","div",null,{"children":[["$","h3",null,{"children":"Jacob Cox reinforced the road junction"}],["$","p",null,{"children":"XXIII Corps troops built earthworks. Hascall reported that heat and dust caused many men to collapse."}]]}]]}],["$","div","Thomas and McPherson concealed the movement",{"className":"moment","children":[["$","$L17",null,{"seconds":367,"label":"6:07"}],["$","div",null,