10:["$","section",null,{"className":"reference-section battle-flow-section","id":"battle-flow","children":["$","$L17",null,{"guide":{"date":"July 1–3, 1864","place":"Kennesaw Mountain to Smyrna, Georgia","result":"Sherman moved around the Confederate left, and Johnston withdrew six miles to Smyrna","facts":[{"label":"Movement began","value":"6 a.m., July 1"},{"label":"Schofield’s force near the Moss House","value":"About 13,000 men by July 2"},{"label":"Distance marched by Morgan L. Smith’s division","value":"About 11 miles on July 2"},{"label":"Confederate withdrawal ordered","value":"1:30 p.m., July 2"},{"label":"New Confederate position","value":"Smyrna Station, six miles south of Marietta"}],"maps":[{"title":"The flanking movement south of Kennesaw","caption":"The map shows Kennesaw Mountain, the lines around Marietta, roads toward Nickajack Creek and Smyrna, and the opposing works abandoned on July 2–3.","source":"https://www.loc.gov/item/2008628278/","image":"/images/atlanta-campaign-map-4.jpg","alt":"U.S. Army map of operations from Kennesaw Mountain toward Smyrna and the Chattahoochee"},{"title":"June 27 attacks and the Confederate line","caption":"The National Park Service map shows the line Sherman chose not to attack again and the southern ground Schofield and McPherson used for the flanking movement.","source":"https://www.nps.gov/orgs/1539/the-southeast-chronicles-kennesaw-mountain-national-battlefield-park.htm","image":"/images/kennesaw-troop-movements.jpg","alt":"National Park Service map of troop movements at Kennesaw Mountain on June 27, 1864"},{"title":"Kennesaw Mountain battlefield positions","caption":"The 1864 drawing shows Pigeon Hill, Little Kennesaw, Big Kennesaw, Confederate artillery, and the U.S. position north of the heights.","source":"https://www.loc.gov/item/2004660525/","image":"/images/kennesaw-battlefield-drawing.jpg","alt":"1864 battlefield drawing showing Confederate positions across Kennesaw Mountain"},{"title":"Kennesaw, Nickajack Creek, and Smyrna today","caption":"Schofield advanced south along the Sandtown Road, McPherson shifted from the U.S. left to join him, and Johnston withdrew to Smyrna Station.","source":"https://www.openstreetmap.org/copyright","embed":"https://www.openstreetmap.org/export/embed.html?bbox=-84.78%2C33.75%2C-84.42%2C34.08&layer=mapnik&marker=33.8839%2C-84.5144"}],"moments":[{"time":"1:18","audioTime":78,"title":"Sherman ruled out another attack at Kennesaw","detail":"After the June 27 assaults, Sherman decided to move south around the Confederate left even though the maneuver temporarily separated much of his army from the railroad."},{"time":"2:17","audioTime":137,"title":"Final orders were issued on July 1","detail":"Schofield was to secure the ground toward Nickajack Creek, McPherson was to move south and join him, and Thomas was to continue holding the existing U.S. line."},{"time":"3:55","audioTime":235,"title":"Schofield opened the movement","detail":"At 6 a.m., Milo Hascall’s division advanced along the Sandtown Road, pushed back Confederate cavalry, and occupied a road junction near the Moss House."},{"time":"5:17","audioTime":317,"title":"Jacob Cox reinforced the road junction","detail":"XXIII Corps troops built earthworks. Hascall reported that heat and dust caused many men to collapse."},{"time":"6:07","audioTime":367,"title":"Thomas and McPherson concealed the movement","detail":"Skirmishers and artillery demonstrated against the Kennesaw lines while Schofield extended south."},{"time":"6:48","audioTime":408,"title":"Morgan L. Smith marched to Schofield","detail":"Smith’s XV Corps division left at 4 a.m. on July 2, completed an 11-mile march, and joined Schofield near the Moss House by 11 a.m."},{"time":"8:11","audioTime":491,"title":"Schofield secured the advanced position","detail":"About 13,000 men held ground four miles beyond the Confederate left and six miles from the Chattahoochee."},{"time":"8:42","audioTime":522,"title":"U.S. troops increased pressure along the original line","detail":"John Newton’s division bombarded and skirmished while 40 to 50 U.S. guns fired on Little Kennesaw."},{"time":"9:45","audioTime":585,"title":"U.S. cavalry crossed Sweetwater Creek","detail":"George Stoneman and Edward McCook pushed to the Chattahoochee southwest of Schofield’s position."},{"time":"10:33","audioTime":633,"title":"McPherson prepared a night march","detail":"Supply trains moved first. XVII Corps was to lead, followed by XVI Corps and XV Corps, with only one baggage wagon per regiment and battery."},{"time":"13:58","audioTime":838,"title":"McPherson began leaving the U.S. left","detail":"Thomas shifted troops into the vacated positions and Benjamin Scribner’s brigade built a refused flank to protect the north end of the line."},{"time":"15:06","audioTime":906,"title":"Johnston detected the movement","detail":"Confederate observers saw large wagon movements. Johnston knew the U.S. armies were moving south and decided the Kennesaw position could not be held."},{"time":"16:12","audioTime":972,"title":"Johnston ordered a withdrawal","detail":"At 1:30 p.m. on July 2, army headquarters issued detailed orders. Artillery would leave at dusk, Loring at 10 p.m., Hardee and Hood at 11, and rear guards at 1 a.m."},{"time":"17:41","audioTime":1061,"title":"Confederate artillery left Little Kennesaw","detail":"George Storrs cleared the mountain roads and removed every gun while brush screens concealed the empty embrasures."},{"time":"18:30","audioTime":1110,"title":"Infantry rear guards concealed the retreat","detail":"Patrick Cleburne’s division withdrew quietly. Covered trenches, scattered skirmishers, and burning turpentine balls hid movements around Cheatham Hill."},{"time":"21:39","audioTime":1299,"title":"The Army of Tennessee reached Smyrna","detail":"The dark, dry night and familiar roads allowed most units to arrive on schedule and begin new earthworks before U.S. troops appeared."},{"time":"22:11","audioTime":1331,"title":"McPherson briefly misread the Confederate activity","detail":"He paused his own withdrawal because he thought the movement and reduced campfires might precede a night attack."},{"time":"23:01","audioTime":1381,"title":"U.S. troops confirmed the works were empty","detail":"A Confederate deserter crossed the lines. George Thomas informed Sherman at 2:45 a.m. on July 3 that Johnston had withdrawn."}],"command":[{"side":"United States","color":"blue","branches":[{"commander":"William T. Sherman","command":"Military Division of the Mississippi","subordinates":"Directed the flanking operation"},{"commander":"George H. Thomas","command":"Army of the Cumberland","subordinates":"Held the existing line and replaced McPherson’s departing units"},{"commander":"John M. Schofield","command":"Army of the Ohio","subordinates":"Milo Hascall and Jacob Cox advanced to the Moss House"},{"commander":"James B. McPherson","command":"Army of the Tennessee","subordinates":"XV, XVI, and XVII Corps shifted south"},{"commander":"Morgan L. Smith","command":"2nd Division, XV Corps","subordinates":"Reinforced Schofield on July 2"},{"commander":"George Stoneman and Edward McCook","command":"U.S. cavalry divisions","subordinates":"Crossed Sweetwater Creek and reached the Chattahoochee"}]},{"side":"Confederacy","color":"red","branches":[{"commander":"Joseph E. Johnston","command":"Army of Tennessee","subordinates":"Ordered the withdrawal to Smyrna"},{"commander":"William W. Loring","command":"Loring’s Corps","subordinates":"Began leaving at 10 p.m."},{"commander":"William J. Hardee","command":"Hardee’s Corps","subordinates":"Followed at 11 p.m."},{"commander":"John B. Hood","command":"Hood’s Corps","subordinates":"Followed at 11 p.m."},{"commander":"George Storrs","command":"Artillery battalion","subordinates":"Removed the guns from Little Kennesaw"},{"commander":"Samuel T. Foster","command":"Granbury’s Brigade skirmishers","subordinates":"Covered Cleburne’s withdrawal"}]}],"people":[{"name":"Milo S. Hascall","role":"XXIII Corps division commander who seized the road junction near the Moss House","side":"United States"},{"name":"Jacob D. Cox","role":"XXIII Corps division commander who reinforced Hascall","side":"United States"},{"name":"Morgan L. Smith","role":"XV Corps division commander sent to strengthen Schofield","side":"United States"},{"name":"Benjamin H. Scribner","role":"XIV Corps brigade commander who built a new northern flank","side":"United States"},{"name":"Joseph E. Johnston","role":"Recognized the U.S. flanking movement and withdrew the army to Smyrna","side":"Confederacy","image":"/images/joseph-e-johnston.jpg","source":"https://www.loc.gov/item/2018666539/"},{"name":"W. L. Truman","role":"Confederate artilleryman whose diary describes the bombardment and withdrawal from Little Kennesaw","side":"Confederacy"},{"name":"Thomas Maney","role":"1st Tennessee lieutenant who commanded an outpost covering the retreat","side":"Confederacy"}],"losses":[],"gallery":[{"image":"/images/kennesaw-battlefield-drawing.jpg","alt":"Theodore R. Davis drawing of Confederate artillery positions at Kennesaw Mountain","caption":"Confederate gun positions on the Kennesaw heights. George Storrs removed the artillery down the mountain on the evening of July 2.","source":"https://www.loc.gov/item/2004660525/"},{"image":"/images/atlanta-fortifications.jpg","alt":"Confederate earthwork fortifications photographed near Atlanta","caption":"Confederate earthworks near Atlanta. Both armies built new fieldworks as they moved south from Kennesaw.","source":"https://www.loc.gov/item/2018670937/"}],"sources":[{"label":"Official Episode 527 page","url":"https://civilwarpodcast.org/2026/05/10/civil-war-podcast-episode-527/"},{"label":"National Park Service battle summary","url":"https://www.nps.gov/civilwar/search-battles-detail.htm?battleCode=ga015"},{"label":"Library of Congress Kennesaw battlefield drawing","url":"https://www.loc.gov/item/2004660525/"},{"label":"Library of Congress Atlanta campaign map series","url":"https://www.loc.gov/item/2008628278/"},{"label":"U.S. Army Center of Military History campaign study","url":"https://history.army.mil/Publications/Publications-Catalog/The-Atlanta-and-Savannah-Campaigns/"}]}}]}]
