1:["$","main",null,{"children":[["$","header",null,{"className":"site-header","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"for The Civil War & Reconstruction"}]]}]]}],["$","nav",null,{"aria-label":"Primary navigation","children":[["$","a",null,{"href":"#archive","children":"Episodes"}],["$","a",null,{"href":"https://civilwarpodcast.org/","target":"_blank","rel":"noreferrer","children":"Podcast ↗"}]]}]]}],["$","$Ld",null,{"episodes":[{"slug":"538-the-atlanta-campaign-peach-tree-creek","number":538,"title":"#538- THE ATLANTA CAMPAIGN: Peach Tree Creek","description":"In which we wrap-up our look at the Battle of Peach Tree Creek, which took place outside Atlanta on July 20, 1864.","publishedAt":"Sun, 16 Aug 2026 23:50:00 -0000","durationSeconds":1748,"guid":"d107d9be-7e4a-11f1-85e9-5794c0be8832","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6889301814.mp3","episodeUrl":"","artworkUrl":""},{"slug":"537-the-atlanta-campaign-peach-tree-creek","number":537,"title":"#537- THE ATLANTA CAMPAIGN: Peach Tree Creek","description":"In which we look at the action at the start of the Battle of Peach Tree Creek, which took place outside Atlanta on July 20, 1864.","publishedAt":"Sun, 09 Aug 2026 23:26:00 -0000","durationSeconds":1561,"guid":"d0dc5fbe-7e4a-11f1-85e9-1f549e665730","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6333367717.mp3","episodeUrl":"","artworkUrl":""},{"slug":"536-the-atlanta-campaign-peach-tree-creek","number":536,"title":"#536- THE ATLANTA CAMPAIGN: Peach Tree Creek","description":"in which we start to look at the Battle of Peach Tree Creek, which took place outside Atlanta on July 20, 1864.","publishedAt":"Mon, 03 Aug 2026 00:26:00 -0000","durationSeconds":1482,"guid":"d0859558-7e4a-11f1-85e9-43a1b234056b","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1312834918.mp3","episodeUrl":"","artworkUrl":""},{"slug":"532-the-atlanta-campaign-part-the-thirtieth","number":532,"title":"#532- THE ATLANTA CAMPAIGN (Part the Thirtieth)","description":"In which Sherman comes up with a plan for \"a general right wheel\" now that the Federal armies are across the Chattahoochee, and there's a shake-up in the Confederate Army of Tennessee's high command.","publishedAt":"Mon, 27 Jul 2026 21:07:00 -0000","durationSeconds":1441,"guid":"88d31456-5d52-11f1-a8e8-df71508354c3","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3462485600.mp3","episodeUrl":"","artworkUrl":""},{"slug":"535-the-atlanta-campaign-hood-s-daunting-task","number":535,"title":"#535- THE ATLANTA CAMPAIGN: Hood's Daunting Task","description":"In which we look at the daunting task facing John B Hood when he assumed command of the Army of Tennessee, and we set the stage for the Battle of Peachtree Creek.","publishedAt":"Sun, 26 Jul 2026 22:29:00 -0000","durationSeconds":1273,"guid":"894adf22-5d52-11f1-a8e8-67a6db03f42a","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7539224962.mp3","episodeUrl":"","artworkUrl":""},{"slug":"534-the-atlanta-campaign-hood-takes-command","number":534,"title":"#534- THE ATLANTA CAMPAIGN: Hood Takes Command","description":"In which we look at the change in command at the top of the Army of Tennessee between Joseph E Johnston and John B Hood.","publishedAt":"Sun, 19 Jul 2026 22:06:00 -0000","durationSeconds":1526,"guid":"892325d6-5d52-11f1-a8e8-eb0a1e593323","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3438580124.mp3","episodeUrl":"","artworkUrl":""},{"slug":"533-the-atlanta-campaign-part-the-thirty-first","number":533,"title":"#533- THE ATLANTA CAMPAIGN (Part the Thirty-first)","description":"In which we set the Atlanta Campaign within the larger context of what was happening in the war during the summer of 1864.","publishedAt":"Sun, 12 Jul 2026 23:43:00 -0000","durationSeconds":1787,"guid":"88fc92e0-5d52-11f1-a8e8-8f93575199be","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4522613401.mp3","episodeUrl":"","artworkUrl":""},{"slug":"531-the-atlanta-campaign-part-the-twenty-ninth","number":531,"title":"#531- THE ATLANTA CAMPAIGN (Part the Twenty-ninth)","description":"In which the Federals get across the Chattahoochee, and Joe Johnston abandons the Shoup Line.","publishedAt":"Mon, 22 Jun 2026 22:28:00 -0000","durationSeconds":1499,"guid":"dd241974-3c46-11f1-8c58-6b4071ffa7f8","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4220828472.mp3","episodeUrl":"","artworkUrl":""},{"slug":"530-the-atlanta-campaign-part-the-twenty-eighth","number":530,"title":"#530- THE ATLANTA CAMPAIGN (Part the Twenty-eighth)","description":"The Federals reach the Chattahoochee River, the last natural obstacle between them and Atlanta.","publishedAt":"Mon, 08 Jun 2026 00:40:00 -0000","durationSeconds":1165,"guid":"dcd530fc-3c46-11f1-8c58-f71528d6a44a","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4177291603.mp3","episodeUrl":"","artworkUrl":""},{"slug":"529-the-atlanta-campaign-part-the-twenty-seventh","number":529,"title":"#529- THE ATLANTA CAMPAIGN (Part the Twenty-seventh)","description":"In which we perform a postmortem on the Battle of Kennesaw Mountain to analyze Sherman's decision to order an attack on the Confederates' works on June 27, 1864.","publishedAt":"Mon, 01 Jun 2026 00:44:00 -0000","durationSeconds":1551,"guid":"f28a7568-2bcc-11f1-a42f-138330cba8e8","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1115630099.mp3","episodeUrl":"","artworkUrl":""},{"slug":"528-joe-wheeler-in-blue-and-gray","number":528,"title":"#528- JOE WHEELER IN BLUE & GRAY","description":"In which we look at the life of Joseph Wheeler, who was a Confederate cavalry general during the Civil War and a US Army general during the Spanish-American War.","publishedAt":"Sun, 24 May 2026 23:19:00 -0000","durationSeconds":2091,"guid":"5e518c58-57c6-11f1-bd70-27d0eef5a4f4","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3296852416.mp3","episodeUrl":"","artworkUrl":""},{"slug":"527-the-atlanta-campaign-part-the-twenty-sixth","number":527,"title":"#527- THE ATLANTA CAMPAIGN (Part the Twenty-sixth)","description":"In which the two-week long standoff at Kennesaw Mountain comes to an end as Sherman moves to flank the Confederates and, in response, Joe Johnston pulls the Army of Tennessee out of its lines and withdraws to a new position.","publishedAt":"Sun, 10 May 2026 22:48:00 -0000","durationSeconds":1599,"guid":"f249ff60-2bcc-11f1-a42f-0342c011a294","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9362939790.mp3","episodeUrl":"","artworkUrl":""},{"slug":"526-the-atlanta-campaign-part-the-twenty-fifth","number":526,"title":"#526- THE ATLANTA CAMPAIGN (Part the Twenty-fifth)","description":"In which it's a race to see if we can finish recording the episode before Tracy's voice gives out (she's been sick).","publishedAt":"Mon, 27 Apr 2026 00:14:00 -0000","durationSeconds":1286,"guid":"f1e536de-2bcc-11f1-a42f-978d1a15e2be","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8010674913.mp3?updated=1777249165","episodeUrl":"","artworkUrl":""},{"slug":"525-the-atlanta-campaign-part-the-twenty-fourth","number":525,"title":"#525- THE ATLANTA CAMPAIGN (Part the Twenty-fourth)","description":"In which Sherman takes stock of the lessons learned from the failed Federal frontal attacks on the Confederate lines at Kennesaw Mountain and decides to switch strategies.","publishedAt":"Sun, 19 Apr 2026 23:28:00 -0000","durationSeconds":1332,"guid":"d52101ea-110f-11f1-9914-6b2fc8ae63e4","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6552829483.mp3?updated=1776641607","episodeUrl":"","artworkUrl":""},{"slug":"524-the-atlanta-campaign-part-the-twenty-third","number":524,"title":"#524- THE ATLANTA CAMPAIGN (Part the Twenty-third)","description":"In which we wrap-up our look at the Federal assault on the Dead Angle at the Battle of Kennesaw Mountain on June 27, 1864.","publishedAt":"Sun, 12 Apr 2026 21:45:00 -0000","durationSeconds":1913,"guid":"d504b288-110f-11f1-9914-b3694062d1b5","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9355240458.mp3?updated=1776030605","episodeUrl":"","artworkUrl":""},{"slug":"523-the-atlanta-campaign-part-the-twenty-second","number":523,"title":"#523- THE ATLANTA CAMPAIGN (Part the Twenty-second)","description":"In which we start to look at the fierce fighting for the Dead Angle at the Battle of Kennesaw Mountain in Georgia on June 27, 1864.","publishedAt":"Mon, 30 Mar 2026 00:15:00 -0000","durationSeconds":1997,"guid":"8da621ec-110f-11f1-acf8-c75c5d3ffa4d","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7501730549.mp3?updated=1774830032","episodeUrl":"","artworkUrl":""},{"slug":"522-the-atlanta-campaign-part-the-twenty-first","number":522,"title":"#522- THE ATLANTA CAMPAIGN (Part the Twenty-first)","description":"In which we continue our discussion of the Battle of Kennesaw Mountain in Georgia on June 27, 1864, by setting the stage for the fierce fighting at the Dead Angle.","publishedAt":"Sun, 08 Mar 2026 22:45:00 -0000","durationSeconds":1484,"guid":"35748a6a-ef4d-11f0-991c-ef19741b8ae2","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8761435540.mp3?updated=1773010206","episodeUrl":"","artworkUrl":""},{"slug":"521-the-atlanta-campaign-part-the-twentieth","number":521,"title":"#521- THE ATLANTA CAMPAIGN (Part the Twentieth)","description":"In which we continue covering the action at the Battle of Kennesaw Mountain on June 27, 1864.","publishedAt":"Mon, 23 Feb 2026 23:32:00 -0000","durationSeconds":1667,"guid":"23f20428-e9cd-11f0-ad30-5fe83aa0626f","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8388504917.mp3?updated=1771889906","episodeUrl":"","artworkUrl":""},{"slug":"520-the-atlanta-campaign-part-the-nineteenth","number":520,"title":"#520- THE ATLANTA CAMPAIGN (Part the Nineteenth)","description":"In which we look at more of the action at the Battle of Kennesaw Mountain on June 27, 1864.","publishedAt":"Sun, 08 Feb 2026 22:05:00 -0000","durationSeconds":1208,"guid":"23b528aa-e9cd-11f0-ad30-6b53b6f99dca","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4854852244.mp3?updated=1770588612","episodeUrl":"","artworkUrl":""},{"slug":"519-the-atlanta-campaign-part-the-eighteenth","number":519,"title":"#519- THE ATLANTA CAMPAIGN (Part the Eighteenth)","description":"In which the action starts at the Battle of Kennesaw Mountain on June 27, 1864.","publishedAt":"Sun, 01 Feb 2026 23:44:00 -0000","durationSeconds":1870,"guid":"23996610-e9cd-11f0-ad30-930354d55279","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8636023206.mp3?updated=1769989803","episodeUrl":"","artworkUrl":""},{"slug":"518-the-atlanta-campaign-part-the-seventeenth","number":518,"title":"#518- THE ATLANTA CAMPAIGN (Part the Seventeenth)","description":"In which Sherman decides to launch an attack on the Confederate lines at Kennesaw Mountain.","publishedAt":"Mon, 26 Jan 2026 00:51:00 -0000","durationSeconds":1653,"guid":"a7bb887a-c352-11f0-b9d8-17f1e5f4c601","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9305946631.mp3?updated=1769389026","episodeUrl":"","artworkUrl":""},{"slug":"517-the-atlanta-campaign-part-the-sixteenth","number":517,"title":"#517- THE ATLANTA CAMPAIGN (Part the Sixteenth)","description":"In which we discuss the fight at Kolb's Farm on June 22, 1864.","publishedAt":"Mon, 19 Jan 2026 01:13:00 -0000","durationSeconds":1588,"guid":"a79dcf74-c352-11f0-b9d8-a7d5c6d7f7f0","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9047611282.mp3?updated=1768785529","episodeUrl":"","artworkUrl":""},{"slug":"516-the-atlanta-campaign-part-the-fifteenth","number":516,"title":"#516- THE ATLANTA CAMPAIGN (Part the Fifteenth)","description":"In which the armies take up their positions along the Kennesaw line, near Marietta, Georgia, in June 1864.","publishedAt":"Mon, 12 Jan 2026 00:28:00 -0000","durationSeconds":2102,"guid":"a77ff224-c352-11f0-b9d8-8fd35cfea25a","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7826879225.mp3?updated=1768178048","episodeUrl":"","artworkUrl":""},{"slug":"515-the-atlanta-campaign-part-the-fourteenth","number":515,"title":"#515- THE ATLANTA CAMPAIGN (Part the Fourteenth)","description":"In which Kennesaw Mountain enters the discussion, Polk is killed, and there's a fight at Kolb's Farm.","publishedAt":"Mon, 05 Jan 2026 00:30:00 -0000","durationSeconds":1493,"guid":"a764b96e-c352-11f0-b9d8-d37105f81766","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5820218940.mp3?updated=1767573335","episodeUrl":"","artworkUrl":""},{"slug":"514-the-atlanta-campaign-part-the-thirteenth","number":514,"title":"#514- THE ATLANTA CAMPAIGN (Part the Thirteenth)","description":"In which we discuss three changes that took place in the campaign over late May/early June.","publishedAt":"Sun, 21 Dec 2025 23:33:00 -0000","durationSeconds":2041,"guid":"a8e776ee-ad4c-11f0-a371-5fdba9c525a1","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3882503505.mp3?updated=1766360324","episodeUrl":"","artworkUrl":""},{"slug":"513-the-atlanta-campaign-part-the-twelfth","number":513,"title":"#513- THE ATLANTA CAMPAIGN (Part the Twelfth)","description":"In which the Federals swing away from the railroad, out into the north Georgia countryside, and there are sharp fights at New Hope Church and Pickett's Mill.","publishedAt":"Mon, 08 Dec 2025 01:06:00 -0000","durationSeconds":1976,"guid":"a8851350-ad4c-11f0-a371-9fd6082fc5cd","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7432764647.mp3?updated=1765156302","episodeUrl":"","artworkUrl":""},{"slug":"512-the-atlanta-campaign-part-the-eleventh","number":512,"title":"#512- THE ATLANTA CAMPAIGN (Part the Eleventh)","description":"In which the Confederates fall back, fall back again, have a very bad day at Cassville, then fall back again.","publishedAt":"Mon, 24 Nov 2025 01:54:00 -0000","durationSeconds":1660,"guid":"c2701cba-a243-11f0-be4c-c7440008fa88","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2981097334.mp3?updated=1763949582","episodeUrl":"","artworkUrl":""},{"slug":"511-the-atlanta-campaign-part-the-tenth","number":511,"title":"#511- THE ATLANTA CAMPAIGN (Part the Tenth)","description":"In which the armies face off at Resaca, and the pattern of operations for the next couple of months is set.","publishedAt":"Mon, 17 Nov 2025 01:20:00 -0000","durationSeconds":1484,"guid":"c25193bc-a243-11f0-be4c-fb058a1212e6","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1979482340.mp3?updated=1772652172","episodeUrl":"","artworkUrl":""},{"slug":"510-the-atlanta-campaign-part-the-ninth","number":510,"title":"#510- THE ATLANTA CAMPAIGN (Part the Ninth)","description":"In which the Federals seize Snake Creek Gap and score a major success at the start of the campaign.","publishedAt":"Mon, 03 Nov 2025 00:51:00 -0000","durationSeconds":1707,"guid":"c212990a-a243-11f0-be4c-8b793a445c60","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6005360171.mp3?updated=1762131391","episodeUrl":"","artworkUrl":""},{"slug":"509-the-atlanta-campaign-part-the-eighth","number":509,"title":"#509- THE ATLANTA CAMPAIGN (Part the Eighth)","description":"In which Sherman & Johnston get the opposing armies into position for the start of the campaign.","publishedAt":"Mon, 27 Oct 2025 00:25:00 -0000","durationSeconds":1766,"guid":"d3a10b96-7bc6-11f0-bc39-339dbf981075","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1798267103.mp3?updated=1761525032","episodeUrl":"","artworkUrl":""},{"slug":"508-the-atlanta-campaign-part-the-seventh","number":508,"title":"#508- THE ATLANTA CAMPAIGN (Part the Seventh)","description":"In which we look at the geography of the region where the Atlanta Campaign would open, and how it influenced Sherman's strategy.","publishedAt":"Mon, 20 Oct 2025 00:38:00 -0000","durationSeconds":1747,"guid":"d38376bc-7bc6-11f0-bc39-8f4f47a63f0b","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9552374331.mp3?updated=1760921039","episodeUrl":"","artworkUrl":""},{"slug":"507-the-atlanta-campaign-part-the-sixth","number":507,"title":"#507- THE ATLANTA CAMPAIGN (Part the Sixth)","description":"In which we take a closer look at the opposing armies, and discuss their strengths & weaknesses.","publishedAt":"Mon, 13 Oct 2025 00:26:00 -0000","durationSeconds":1657,"guid":"d363018e-7bc6-11f0-bc39-f3e6830ebfe2","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5116354644.mp3?updated=1760315516","episodeUrl":"","artworkUrl":""},{"slug":"506-the-atlanta-campaign-part-the-fifth","number":506,"title":"#506- THE ATLANTA CAMPAIGN (Part the Fifth)","description":"In which we look at the importance of logistics, and the Western & Atlantic Railroad in particular, to the spring campaign in north Georgia.","publishedAt":"Sun, 05 Oct 2025 23:39:00 -0000","durationSeconds":1511,"guid":"d32064fa-7bc6-11f0-bc39-af6fac883763","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8085348163.mp3?updated=1759707809","episodeUrl":"","artworkUrl":""},{"slug":"505-the-atlanta-campaign-part-the-fourth","number":505,"title":"#505- THE ATLANTA CAMPAIGN (Part the Fourth)","description":"In which the Federals discover an important piece of in formation, and the command woes continue in the Confederates' Army of Tennessee.","publishedAt":"Mon, 15 Sep 2025 00:58:00 -0000","durationSeconds":1576,"guid":"a967d3e6-6b40-11f0-922b-f7dbc85a6a05","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3683669614.mp3?updated=1757898226","episodeUrl":"","artworkUrl":""},{"slug":"504-the-atlanta-campaign-part-the-third","number":504,"title":"#504- THE ATLANTA CAMPAIGN (Part the Third)","description":"In which we continue setting the stage for the Atlanta Campaign.","publishedAt":"Mon, 08 Sep 2025 00:16:00 -0000","durationSeconds":1181,"guid":"a91bb22c-6b40-11f0-922b-d77b97abdea3","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5487270099.mp3?updated=1757290917","episodeUrl":"","artworkUrl":""},{"slug":"503-the-atlanta-campaign-part-the-second","number":503,"title":"#503- THE ATLANTA CAMPAIGN (Part the Second)","description":"In which we continue to set the stage for the Atlanta Campaign.","publishedAt":"Mon, 01 Sep 2025 00:02:00 -0000","durationSeconds":1985,"guid":"b0a167b4-4faf-11f0-b8be-4b2f61645cf1","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3371019385.mp3?updated=1756685241","episodeUrl":"","artworkUrl":""},{"slug":"502-the-atlanta-campaign-part-the-first","number":502,"title":"#502- THE ATLANTA CAMPAIGN (Part the First)","description":"In which we begin to set the stage for the Atlanta Campaign.","publishedAt":"Sun, 24 Aug 2025 23:49:00 -0000","durationSeconds":1944,"guid":"b08065b4-4faf-11f0-b8be-979195a3b41e","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML4394992751.mp3?updated=1756079842","episodeUrl":"","artworkUrl":""},{"slug":"501-the-overland-campaign-a-conclusion","number":501,"title":"#501- THE OVERLAND CAMPAIGN: A Conclusion","description":"In which we wrap-up our look at the Overland Campaign.","publishedAt":"Mon, 18 Aug 2025 00:05:00 -0000","durationSeconds":2870,"guid":"b05ea7da-4faf-11f0-b8be-43d78930502c","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6837957191.mp3?updated=1755475882","episodeUrl":"","artworkUrl":""},{"slug":"500-cold-harbor-part-the-third","number":500,"title":"#500- COLD HARBOR (Part the Third)","description":"In which we look at the bloody & futile Federal assaults on June 3, 1864, at Cold Harbor.","publishedAt":"Mon, 11 Aug 2025 01:17:00 -0000","durationSeconds":2682,"guid":"b03d7e16-4faf-11f0-b8be-db0869e518a6","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5875800509.mp3?updated=1754875409","episodeUrl":"","artworkUrl":""},{"slug":"499-cold-harbor-part-the-second","number":499,"title":"#499- COLD HARBOR (Part the Second)","description":"In which we continue to look at the maneuvering & fighting that preceded the (in)famous Federal attack at Cold Harbor on June 3, 1864.","publishedAt":"Sun, 03 Aug 2025 23:35:00 -0000","durationSeconds":1604,"guid":"b01920a2-4faf-11f0-b8be-e3f2b59aa0f0","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9809915595.mp3?updated=1754264471","episodeUrl":"","artworkUrl":""},{"slug":"498-cold-harbor-part-the-first","number":498,"title":"#498- COLD HARBOR (Part the First)","description":"In which we set the stage for the famous fight at Cold Harbor between the two armies.","publishedAt":"Sun, 27 Jul 2025 23:27:00 -0000","durationSeconds":1705,"guid":"d08f86ce-3f4b-11f0-a40d-e3b0f1c90b17","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8537051289.mp3?updated=1753659164","episodeUrl":"","artworkUrl":""},{"slug":"497-the-president-thinks-very-highly-of-what-grant-has-done","number":497,"title":"#497- THE PRESIDENT THINKS VERY HIGHLY OF WHAT GRANT HAS DONE","description":"In which we look at what was being purchased by all the death & suffering during the Overland Campaign in Virginia in the spring of 1864.","publishedAt":"Mon, 14 Jul 2025 00:52:00 -0000","durationSeconds":1842,"guid":"d04d395e-3f4b-11f0-a40d-fb622409278a","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3110057408.mp3?updated=1752454665","episodeUrl":"","artworkUrl":""},{"slug":"496-stepping-into-hell-the-soldier-s-ordeal-during-the-overland-campaign","number":496,"title":"#496- STEPPING INTO HELL: The Soldier's Ordeal During the Overland Campaign","description":"In which we look at the physical misery & psychological strain endured by the soldiers during the Overland Campaign.","publishedAt":"Sun, 06 Jul 2025 23:42:00 -0000","durationSeconds":1821,"guid":"d02f6ae6-3f4b-11f0-a40d-9383b696c615","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7251971292.mp3?updated=1751845665","episodeUrl":"","artworkUrl":""},{"slug":"495-the-overland-campaign-s-wounded-prisoners-and-dead","number":495,"title":"#495- THE OVERLAND CAMPAIGN'S WOUNDED, PRISONERS, & DEAD","description":"In which we look at the care of the large numbers of wounded during the Overland Campaign, how both sides dealt with the many enemy soldiers taken captive, and what happened with the dead.","publishedAt":"Sun, 22 Jun 2025 21:31:00 -0000","durationSeconds":2461,"guid":"84d2d194-2a03-11f0-8cd0-97eb1d5e7cd8","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7095307765.mp3?updated=1750628185","episodeUrl":"","artworkUrl":""},{"slug":"494-totopotomoy-creek","number":494,"title":"#494- TOTOPOTOMOY CREEK","description":"In which Lee sees an opportunity to strike Warren's Fifth Corps, and Grant tries to (once again) maneuver around Lee's right and draw him into battle in the open.","publishedAt":"Mon, 09 Jun 2025 00:16:00 -0000","durationSeconds":2118,"guid":"848a136e-2a03-11f0-8cd0-43299666309a","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6187461751.mp3?updated=1749428533","episodeUrl":"","artworkUrl":""},{"slug":"493-i-feel-that-our-success-over-lee-s-army-is-already-assured","number":493,"title":"#493- \"I FEEL THAT OUR SUCCESS OVER LEE'S ARMY IS ALREADY ASSURED\"","description":"In which the two armies leave the North Anna behind, and there is a clash at Haw's Shop on May 28, 1864.","publishedAt":"Mon, 02 Jun 2025 00:56:00 -0000","durationSeconds":1767,"guid":"84640c3c-2a03-11f0-8cd0-d39c51a012c1","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML2544136257.mp3?updated=1748826127","episodeUrl":"","artworkUrl":""},{"slug":"492-to-the-north-anna-part-the-second","number":492,"title":"#492- TO THE NORTH ANNA (Part the Second)","description":"In which the two armies reach the North Anna and Robert E Lee presents Ulysses S Grant with a problem to solve.","publishedAt":"Mon, 12 May 2025 00:22:00 -0000","durationSeconds":1571,"guid":"f8e04ecc-0843-11f0-b104-53d79f2d15d6","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML1428913195.mp3?updated=1747009681","episodeUrl":"","artworkUrl":""},{"slug":"491-to-the-north-anna-part-the-first","number":491,"title":"#491- TO THE NORTH ANNA (Part the First)","description":"In which both armies leave Spotsylvania behind, and head for the North Anna River.","publishedAt":"Mon, 05 May 2025 22:52:00 -0000","durationSeconds":2015,"guid":"f8c34c0a-0843-11f0-b104-f3c75c140afa","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7278023805.mp3?updated=1746485882","episodeUrl":"","artworkUrl":""},{"slug":"490-the-collapse-of-grant-s-peripheral-strategy-part-the-third","number":490,"title":"#490- THE COLLAPSE OF GRANT'S PERIPHERAL STRATEGY (Part the Third)","description":"In which we finish up our look at the collapse of Grant's peripheral strategy in the spring of 1864 in Virginia, with a discussion of Butler's Bermuda Hundred Campaign, including the battle at Drewry's Bluff on May 16, 1864.","publishedAt":"Mon, 28 Apr 2025 00:06:00 -0000","durationSeconds":2379,"guid":"0be0ab62-ecd2-11ef-ab3a-ff4cbd6ace78","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML6659510729.mp3?updated=1745799112","episodeUrl":"","artworkUrl":""},{"slug":"489-battle-of-yellow-tavern","number":489,"title":"#489- BATTLE OF YELLOW TAVERN","description":"In which we discuss the Battle of Yellow Tavern- which took place in Virginia on May 11, 1864- and the mortal wounding of Jeb Stuart.","publishedAt":"Mon, 14 Apr 2025 16:59:00 -0000","durationSeconds":1840,"guid":"0b98e87c-ecd2-11ef-ab3a-775858cc8912","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9322039582.mp3?updated=1744650255","episodeUrl":"","artworkUrl":""},{"slug":"488-the-collapse-of-grant-s-peripheral-strategy-part-the-second","number":488,"title":"#488- THE COLLAPSE OF GRANT'S PERIPHERAL STRATEGY (Part the Second)","description":"In which we discuss the Battle of New Market (May 15, 1864), as we continue our look at the collapse of Ulysses S Grant's peripheral strategy in Virginia in the spring of 1864.","publishedAt":"Mon, 31 Mar 2025 21:25:00 -0000","durationSeconds":1991,"guid":"424500aa-d6c9-11ef-be98-9769329fb746","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML7761950599.mp3?updated=1743456665","episodeUrl":"","artworkUrl":""},{"slug":"487-the-collapse-of-grant-s-peripheral-strategy-part-the-first","number":487,"title":"#487- THE COLLAPSE OF GRANT'S PERIPHERAL STRATEGY (Part the First)","description":"In which we look at the collapse of Grant's peripheral strategy in Virginia. We talk about the Battle of Cloyd's Mountain on May 9, 1864.","publishedAt":"Mon, 24 Mar 2025 00:12:00 -0000","durationSeconds":1674,"guid":"4220663c-d6c9-11ef-be98-7b0e5f81654a","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9817521784.mp3?updated=1742775454","episodeUrl":"","artworkUrl":""},{"slug":"486-spotsylvania-part-the-third","number":486,"title":"#486- SPOTSYLVANIA (Part the Third)","description":"In which we look at the fierce fighting at the Mule Shoe on May 12, 1864.","publishedAt":"Mon, 17 Mar 2025 00:57:00 -0000","durationSeconds":2536,"guid":"41fc1d0e-d6c9-11ef-be98-d34fbafe4e48","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3216890179.mp3?updated=1742173396","episodeUrl":"","artworkUrl":""},{"slug":"485-spotsylvania-part-the-second","number":485,"title":"#485- SPOTSYLVANIA (Part the Second)","description":"In which the two armies clash near Spotsylvania on May 10, 1864, and Grant vows \"I propose to fight it out on this line if it takes all summer.\"","publishedAt":"Mon, 17 Feb 2025 01:59:00 -0000","durationSeconds":2362,"guid":"c19fc2ac-bb41-11ef-b37a-a76a0d173136","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9999576586.mp3?updated=1739757895","episodeUrl":"","artworkUrl":""},{"slug":"484-spotsylvania-part-the-first","number":484,"title":"#484- SPOTSYLVANIA (Part the First)","description":"In which the two armies break off the fight in the Wilderness and set off for Spotsylvania Court House.","publishedAt":"Sun, 09 Feb 2025 23:42:00 -0000","durationSeconds":2016,"guid":"c1832eda-bb41-11ef-b37a-c734e67c02a0","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML3372685392.mp3?updated=1739144845","episodeUrl":"","artworkUrl":""},{"slug":"483-the-wilderness-part-the-fifth","number":483,"title":"#483- THE WILDERNESS (Part the Fifth)","description":"In which the fierce fighting in the Wilderness comes to end on May 6, with the two armies locked in something of a stalemate- but, as it turns out, Grant is not ready to quit.","publishedAt":"Mon, 03 Feb 2025 00:35:00 -0000","durationSeconds":1701,"guid":"c163106e-bb41-11ef-b37a-73861b202824","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML8536110588.mp3?updated=1738543249","episodeUrl":"","artworkUrl":"https://megaphone.imgix.net/podcasts/c163106e-bb41-11ef-b37a-73861b202824/image/c51edd30171ddec2fb65d5939d5f6686.jpg?ixlib=rails-4.3.1&max-w=3000&max-h=3000&fit=crop&auto=format,compress"},{"slug":"482-the-wilderness-part-the-fourth","number":482,"title":"#482- THE WILDERNESS (Part the Fourth)","description":"In which the fighting heats up on May 6 in the Brock Road/Orange Plank Road sector of the battlefield.","publishedAt":"Sun, 26 Jan 2025 18:53:00 -0000","durationSeconds":1962,"guid":"b54270f0-aac9-11ef-bbc3-eba808ff3370","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9261576657.mp3?updated=1737917942","episodeUrl":"","artworkUrl":""},{"slug":"481-the-wilderness-part-the-third","number":481,"title":"#481- THE WILDERNESS (Part the Third)","description":"In which there is fighting on May 5 at Saunders' Field on the Orange Turnpike and at the Brock Road intersection on the Orange Plank Road.","publishedAt":"Mon, 20 Jan 2025 01:01:00 -0000","durationSeconds":2006,"guid":"b5299486-aac9-11ef-bbc3-bfbe7ea3a7e3","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML5533040796.mp3?updated=1737335152","episodeUrl":"","artworkUrl":""},{"slug":"480-the-wilderness-part-the-second","number":480,"title":"#480- THE WILDERNESS (Part the Second)","description":"In which the Army of the Potomac advances across the Rapidan, into the Wilderness, and Robert E Lee responds by setting the Army of Northern Virginia into motion.","publishedAt":"Mon, 13 Jan 2025 01:22:00 -0000","durationSeconds":2007,"guid":"b510a70a-aac9-11ef-bbc3-eb30816d3fbf","audioUrl":"https://www.podtrac.com/pts/redirect.mp3/pdst.fm/e/tracking.swap.fm/track/YfZO4tERxneauNcW9Fgn/mgln.ai/e/211/traffic.megaphone.fm/ARML9587771604.mp3?updated=1736731651","episodeUrl":"","artworkUrl":"https://megaphone.imgix.net/podcasts/b510a70a-aac9-11ef-bbc3-eb30816d3fbf/image/c51edd30171ddec2fb65d5939d5f6686.jpg?ixlib=rails-4.3.1&max-w=3000&max-h=3000&fit=crop&auto=format,compress"}]}],"$Le"]}]
