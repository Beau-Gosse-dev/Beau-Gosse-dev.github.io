d:["$","main",null,{"className":"person-profile","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/people","children":"← All people"}]]}],["$","article",null,{"className":"profile-content","children":[["$","header",null,{"className":"profile-heading","children":[["$","p",null,{"children":["People of the Civil War · ","Confederacy"]}],["$","h1",null,{"children":"Gideon J. Pillow"}],["$","p",null,{"className":"profile-lifespan","children":"1806–1878"}]]}],["$","div",null,{"className":"profile-grid","children":[["$","div",null,{"children":["$","$Le",null,{"image":"/images/gideon-j-pillow.jpg","alt":"Portrait of Gideon J. Pillow in civilian clothing","name":"Gideon J. Pillow","source":"https://catalog.archives.gov/id/528290"}]}],["$","div",null,{"className":"profile-details","children":[["$","section",null,{"aria-labelledby":"background-title","children":[["$","h2",null,{"id":"background-title","children":"Background"}],["$","p",null,{"children":"Tennessee lawyer, politician, Mexican–American War general, and Confederate brigadier general who directed the Fort Donelson breakout attack."}]]}],[["$","section","Law and politics",{"children":[["$","h2",null,{"children":"Law and politics"}],["$","p",null,{"children":"Pillow grew up in Tennessee and graduated from the University of Nashville in 1827. He became a successful lawyer, a wealthy planter, and a close political ally of James K. Polk. He also held a senior position in the Tennessee militia."}]]}],["$","section","Military career",{"children":[["$","h2",null,{"children":"Military career"}],["$","p",null,{"children":"Pillow served as a general in the Mexican–American War and later helped organize Tennessee’s Confederate forces. His Confederate career combined field commands with recruiting duties, and his conduct repeatedly brought him into conflict with other officers."}]]}],["$","section","After the war",{"children":[["$","h2",null,{"children":"After the war"}],["$","p",null,{"children":"Much of Pillow’s wealth was lost during the war. He resumed practicing law in Memphis with Isham G. Harris and died during the city’s yellow-fever epidemic in 1878."}]]}]],["$","section",null,{"className":"profile-sources","children":[["$","h2",null,{"children":"Biography sources"}],["$","ul",null,{"children":[["$","li","https://tennesseeencyclopedia.net/entries/gideon-johnson-pillow/",{"children":["$","a",null,{"href":"https://tennesseeencyclopedia.net/entries/gideon-johnson-pillow/","target":"_blank","rel":"noreferrer","children":"Tennessee Historical Society: Gideon Johnson Pillow"}]}]]}]]}]]}]]}],false]}]]}]
