d:["$","main",null,{"className":"person-profile","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/people","children":"← All people"}]]}],["$","article",null,{"className":"profile-content","children":[["$","header",null,{"className":"profile-heading","children":[["$","p",null,{"children":["People of the Civil War · ","United States"]}],["$","h1",null,{"children":"Lew Wallace"}],["$","p",null,{"className":"profile-lifespan","children":"1827–1905"}]]}],["$","div",null,{"className":"profile-grid","children":[["$","div",null,{"children":["$","$Le",null,{"image":"/images/lew-wallace.jpg","alt":"Portrait of Lew Wallace in United States Army uniform","name":"Lew Wallace","source":"https://www.loc.gov/pictures/item/2017895498/"}]}],["$","div",null,{"className":"profile-details","children":[["$","section",null,{"aria-labelledby":"background-title","children":[["$","h2",null,{"id":"background-title","children":"Background"}],["$","p",null,{"children":"Indiana lawyer, United States Army general, and author who commanded troops at Fort Donelson, Shiloh, and Monocacy."}]]}],[["$","section","Soldier and public servant",{"children":[["$","h2",null,{"children":"Soldier and public servant"}],["$","p",null,{"children":"Born in Brookville, Indiana, Lewis “Lew” Wallace became a lawyer, army officer, and public official. He entered the Civil War as colonel of the 11th Indiana Infantry and rose to major general in 1862."}]]}],["$","section","Wartime career",{"children":[["$","h2",null,{"children":"Wartime career"}],["$","p",null,{"children":"Wallace served at Fort Donelson and Shiloh. In July 1864 his outnumbered force fought Jubal Early’s army at Monocacy, delaying the Confederate advance toward Washington. In 1865 he served on the Lincoln assassination tribunal and presided over the trial of Andersonville commandant Henry Wirz."}]]}],["$","section","Writer and diplomat",{"children":[["$","h2",null,{"children":"Writer and diplomat"}],["$","p",null,{"children":"Wallace later governed New Mexico Territory from 1878 to 1881 and served as United States minister to the Ottoman Empire from 1881 to 1885. His novel Ben-Hur became an enduring publishing success and was adapted for stage and screen."}]]}]],["$","section",null,{"className":"profile-sources","children":[["$","h2",null,{"children":"Biography sources"}],["$","ul",null,{"children":[["$","li","https://www.nps.gov/people/lew-wallace.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/people/lew-wallace.htm","target":"_blank","rel":"noreferrer","children":"National Park Service: Lew Wallace"}]}]]}]]}]]}]]}],["$","section",null,{"className":"profile-gallery","aria-labelledby":"profile-gallery-title","children":[["$","h2",null,{"id":"profile-gallery-title","children":"More images"}],["$","div",null,{"className":"profile-gallery-grid","children":[["$","$Le","/images/lew-wallace-loc-2011661088.jpg",{"image":"/images/lew-wallace-loc-2011661088.jpg","alt":"Wartime stereograph of Lew Wallace.","caption":"Wartime stereograph of Lew Wallace.","credit":"Library of Congress, Prints and Photographs Division. No known restrictions on publication.","name":"Lew Wallace","source":"https://www.loc.gov/pictures/item/2011661088/"}]]}]]}],["$","aside",null,{"className":"feedback-panel","id":"feedback","aria-labelledby":"feedback-title","children":[["$","div",null,{"children":[["$","p",null,{"className":"kicker","children":"Help improve the companion"}],["$","h2",null,{"id":"feedback-title","children":"Spotted something? Share an idea."}],["$","p",null,{"children":"Suggest a correction, report a problem, or recommend an image. This page’s details are included automatically."}],["$","div",null,{"className":"feedback-actions feedback-secondary","children":["$Lf","$L10"]}]]}],"$L11"]}]]}]]}]
