d:["$","main",null,{"className":"person-profile","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/people","children":"← All people"}]]}],["$","article",null,{"className":"profile-content","children":[["$","header",null,{"className":"profile-heading","children":[["$","p",null,{"children":["People of the Civil War · ","Confederacy"]}],["$","h1",null,{"children":"Nathan Bedford Forrest"}],["$","p",null,{"className":"profile-lifespan","children":"1821–1877"}]]}],["$","div",null,{"className":"profile-grid","children":[["$","div",null,{"children":["$","$Le",null,{"image":"/images/nathan-bedford-forrest.jpg","alt":"Wartime portrait of Nathan Bedford Forrest in Confederate uniform","name":"Nathan Bedford Forrest","source":"https://www.loc.gov/item/2010647758/"}]}],["$","div",null,{"className":"profile-details","children":[["$","section",null,{"aria-labelledby":"background-title","children":[["$","h2",null,{"id":"background-title","children":"Background"}],["$","p",null,{"children":"Tennessee and Mississippi businessman, slave trader, plantation owner, and Confederate cavalry officer who rose from private to lieutenant general."}]]}],[["$","section","Before the war",{"children":[["$","h2",null,{"children":"Before the war"}],["$","p",null,{"children":"Forrest built his prewar wealth through business, plantations, and the buying and selling of enslaved people in Tennessee and Mississippi. He entered Confederate service in 1861 without the professional military education shared by many senior officers."}]]}],["$","section","Cavalry command",{"children":[["$","h2",null,{"children":"Cavalry command"}],["$","p",null,{"children":"Forrest became known for rapid movements and aggressive cavalry operations, eventually reaching lieutenant general. His campaigns included Brice’s Cross Roads and the retreat from Nashville. In April 1864, troops under his command massacred United States soldiers, many of them Black, at Fort Pillow."}]]}],["$","section","After the war",{"children":[["$","h2",null,{"children":"After the war"}],["$","p",null,{"children":"Forrest pursued business ventures after Confederate defeat and became the first Grand Wizard of the Ku Klux Klan, which used white-supremacist intimidation and violence during Reconstruction. He died in Memphis in 1877."}]]}]],["$","section",null,{"className":"profile-sources","children":[["$","h2",null,{"children":"Biography sources"}],["$","ul",null,{"children":[["$","li","https://tennesseeencyclopedia.net/entries/nathan-bedford-forrest/",{"children":["$","a",null,{"href":"https://tennesseeencyclopedia.net/entries/nathan-bedford-forrest/","target":"_blank","rel":"noreferrer","children":"Tennessee Historical Society: Nathan Bedford Forrest"}]}],["$","li","https://www.nps.gov/articles/000/hard-reality-of-fort-pillow.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/articles/000/hard-reality-of-fort-pillow.htm","target":"_blank","rel":"noreferrer","children":"National Park Service: The Hard Reality of Fort Pillow"}]}]]}]]}]]}]]}],["$","section",null,{"className":"profile-gallery","aria-labelledby":"profile-gallery-title","children":[["$","h2",null,{"id":"profile-gallery-title","children":"More images"}],["$","div",null,{"className":"profile-gallery-grid","children":[["$","$Le","/images/nathan-bedford-forrest-loc-2022631004.jpg",{"image":"/images/nathan-bedford-forrest-loc-2022631004.jpg","alt":"Nathan Bedford Forrest in uniform, photographed during the Civil War.","caption":"Nathan Bedford Forrest in uniform, photographed during the Civil War.","credit":"Library of Congress, Prints and Photographs Division. No known restrictions on publication.","name":"Nathan Bedford Forrest","source":"https://www.loc.gov/pictures/item/2022631004/"}]]}]]}],"$Lf"]}]]}]
