Civil War"}],["$","p",null,{"children":"He taught at the Western Military Institute and the University of Nashville before joining Confederate service. His wartime career included Fort Donelson, Shiloh, Chickamauga, and Petersburg. He became a major general in 1864 and was paroled at Appomattox in 1865."}]]}],["$","section","Later life",{"children":[["$","h2",null,{"children":"Later life"}],["$","p",null,{"children":"Johnson returned to education after the war, serving as a professor and co-chancellor at the University of Nashville. He retired to Illinois in 1875 and died there in 1880."}]]}]],["$","section",null,{"className":"profile-sources","children":[["$","h2",null,{"children":"Biography sources"}],["$","ul",null,{"children":[["$","li","https://home.nps.gov/people/bushrod-johnson.htm",{"children":["$","a",null,{"href":"https://home.nps.gov/people/bushrod-johnson.htm","target":"_blank","rel":"noreferrer","children":"National Park Service: Bushrod Johnson"}]}]]}]]}]]}]]}],["$","section",null,{"className":"profile-gallery","aria-labelledby":"profile-gallery-title","children":[["$","h2",null,{"id":"profile-gallery-title","children":"More images"}],["$","div",null,{"className":"profile-gallery-grid","children":[["$","$Le","/images/bushrod-r-johnson-loc-2003662200.jpg",{"image":"/images/bushrod-r-johnson-loc-2003662200.jpg","alt":"Portrait of Bushrod Rust Johnson; date not recorded in the Library of Congress catalog.","caption":"Portrait of Bushrod Rust Johnson; date not recorded in the Library of Congress catalog.","credit":"Library of Congress, Prints and Photographs Division. No known restrictions on publication.","name":"Bushrod R. Johnson","source":"https://www.loc.gov/pictures/item/2003662200/"}]]}]]}],["$","aside",null,{"className":"feedback-panel","id":"feedback","aria-labelledby":"feedback-title","children":[["$","div",null,{"children":[["$","p",null,{"className":"kicker","children":"Help improve the companion"}],["$","h2",null,{"id":"feedback-title","childr