d:["$","main",null,{"className":"person-profile","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/people","children":"← All people"}]]}],["$","article",null,{"className":"profile-content","children":[["$","header",null,{"className":"profile-heading","children":[["$","p",null,{"children":["People of the Civil War · ","United States"]}],["$","h1",null,{"children":"John A. McClernand"}],["$","p",null,{"className":"profile-lifespan","children":"1812–1900"}]]}],["$","div",null,{"className":"profile-grid","children":[["$","div",null,{"children":["$","$Le",null,{"image":"/images/john-a-mcclernand.jpg","alt":"Portrait of Major General John A. McClernand in United States Army uniform","name":"John A. McClernand","source":"https://www.loc.gov/item/2018666452/"}]}],["$","div",null,{"className":"profile-details","children":[["$","section",null,{"aria-labelledby":"background-title","children":[["$","h2",null,{"id":"background-title","children":"Background"}],["$","p",null,{"children":"Illinois politician and volunteer United States Army general who commanded a division at Fort Donelson and Shiloh and later led XIII Corps."}]]}],[["$","section","Law and elected office",{"children":[["$","h2",null,{"children":"Law and elected office"}],["$","p",null,{"children":"Born in Kentucky and raised in Illinois, McClernand became a lawyer, newspaper founder, and Democratic politician. He served in the Illinois legislature and represented the state in Congress during the 1840s and again from 1859."}]]}],["$","section","Military service",{"children":[["$","h2",null,{"children":"Military service"}],["$","p",null,{"children":"McClernand resigned from Congress in October 1861 to accept a commission as a brigadier general of volunteers. He recruited soldiers for the United States Army and was promoted to major general in 1862."}]]}],["$","section","Later public career",{"children":[["$","h2",null,{"children":"Later public career"}],["$","p",null,{"children":"After the war he served as an Illinois circuit judge from 1870 to 1873, resumed legal practice, and presided over the Democratic National Convention in 1876. He died in Springfield in 1900 and was buried in Oak Ridge Cemetery."}]]}]],["$","section",null,{"className":"profile-sources","children":[["$","h2",null,{"children":"Biography sources"}],["$","ul",null,{"children":[["$","li","https://history.house.gov/People/Listing/M/MCCLERNAND,-John-Alexander-(M000337)/",{"children":["$","a",null,{"href":"https://history.house.gov/People/Listing/M/MCCLERNAND,-John-Alexander-(M000337)/","target":"_blank","rel":"noreferrer","children":"U.S. House of Representatives: John Alexander McClernand"}]}]]}]]}]]}]]}],["$","section",null,{"className":"profile-gallery","aria-labelledby":"profile-gallery-title","children":[["$","h2",null,{"id":"profile-gallery-title","children":"More images"}],["$","div",null,{"className":"profile-gallery-grid","children":[["$","$Le","/images/john-a-mcclernand-loc-2018666254.jpg",{"image":"/images/john-a-mcclernand-loc-2018666254.jpg","alt":"Allan Pinkerton, Abraham Lincoln, and John A. McClernand at Antietam, October 3, 1862.","caption":"Allan Pinkerton, Abraham Lincoln, and John A. McClernand at Antietam, October 3, 1862.","credit":"Library of Congress, Prints and Photographs Division. No known restrictions on publication.","name":"John A. McClernand","source":"https://www.loc.gov/pictures/item/2018666254/"}]]}]]}],["$","aside",null,{"className":"feedback-panel","id":"feedback","aria-labelledby":"feedback-title","children":[["$","div",null,{"children":[["$","p",null,{"className":"kicker","children":"Help improve the companion"}],["$","h2",null,{"id":"feedback-title","children":"Spotted something? Share an idea."}],"$Lf"]}],"$L10"]}]]}]]}]
