d:["$","main",null,{"className":"person-profile","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/people","children":"← All people"}]]}],["$","article",null,{"className":"profile-content","children":[["$","header",null,{"className":"profile-heading","children":[["$","p",null,{"children":["People of the Civil War · ","United States"]}],["$","h1",null,{"children":"Charles F. Smith"}],["$","p",null,{"className":"profile-lifespan","children":"1807–1862"}]]}],["$","div",null,{"className":"profile-grid","children":[["$","div",null,{"children":["$","$Le",null,{"image":"/images/charles-f-smith.jpg","alt":"Portrait of Major General Charles F. Smith in United States Army uniform","name":"Charles F. Smith","source":"https://catalog.archives.gov/id/528469"}]}],["$","div",null,{"className":"profile-details","children":[["$","section",null,{"aria-labelledby":"background-title","children":[["$","h2",null,{"id":"background-title","children":"Background"}],["$","p",null,{"children":"Career United States Army officer and former West Point commandant whose division captured part of the outer works at Fort Donelson."}]]}],[["$","section","Career officer and teacher",{"children":[["$","h2",null,{"children":"Career officer and teacher"}],["$","p",null,{"children":"Charles Ferguson Smith was a professional United States Army officer and West Point graduate. As an instructor and commandant of cadets, he helped train officers who later held important commands during the Civil War."}]]}],["$","section","Military service",{"children":[["$","h2",null,{"children":"Military service"}],["$","p",null,{"children":"Smith served in the Mexican–American War and the Utah expedition before becoming a senior United States commander in the Civil War. His assault on the Confederate defenses at Fort Donelson contributed to the Union victory."}]]}],["$","section","Final months",{"children":[["$","h2",null,{"children":"Final months"}],["$","p",null,{"children":"A leg injury suffered during the advance up the Tennessee River kept Smith out of the fighting at Shiloh. He died at Savannah, Tennessee, on April 25, 1862, and was buried in Laurel Hill Cemetery in Philadelphia."}]]}]],["$","section",null,{"className":"profile-sources","children":[["$","h2",null,{"children":"Biography sources"}],["$","ul",null,{"children":[["$","li","https://en.wikipedia.org/wiki/Charles_Ferguson_Smith",{"children":["$","a",null,{"href":"https://en.wikipedia.org/wiki/Charles_Ferguson_Smith","target":"_blank","rel":"noreferrer","children":"Charles Ferguson Smith: biography and bibliography"}]}],["$","li","https://www.loc.gov/pictures/item/2018668625/",{"children":["$","a",null,{"href":"https://www.loc.gov/pictures/item/2018668625/","target":"_blank","rel":"noreferrer","children":"Library of Congress: Charles F. Smith portrait record"}]}]]}]]}]]}]]}],["$","section",null,{"className":"profile-gallery","aria-labelledby":"profile-gallery-title","children":[["$","h2",null,{"id":"profile-gallery-title","children":"More images"}],["$","div",null,{"className":"profile-gallery-grid","children":[["$","$Le","/images/charles-f-smith-loc-2018668625.jpg",{"image":"/images/charles-f-smith-loc-2018668625.jpg","alt":"Charles F. Smith in uniform, photographed between 1860 and 1862.","caption":"Charles F. Smith in uniform, photographed between 1860 and 1862.","credit":"Library of Congress, Prints and Photographs Division. No known restrictions on publication.","name":"Charles F. Smith","source":"https://www.loc.gov/pictures/item/2018668625/"}]]}]]}]]}]]}]
