d:["$","main",null,{"className":"person-profile","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/people","children":"← All people"}]]}],["$","article",null,{"className":"profile-content","children":[["$","header",null,{"className":"profile-heading","children":[["$","p",null,{"children":["People of the Civil War · ","Confederacy"]}],["$","h1",null,{"children":"Simon B. Buckner"}],["$","p",null,{"className":"profile-lifespan","children":"1823–1914"}]]}],["$","div",null,{"className":"profile-grid","children":[["$","div",null,{"children":["$","$Le",null,{"image":"/images/simon-b-buckner.jpg","alt":"Portrait of Brigadier General Simon B. Buckner in Confederate uniform","name":"Simon B. Buckner","source":"https://www.loc.gov/item/2016649609/"}]}],["$","div",null,{"className":"profile-details","children":[["$","section",null,{"aria-labelledby":"background-title","children":[["$","h2",null,{"id":"background-title","children":"Background"}],["$","p",null,{"children":"Kentucky-born career officer who became a Confederate general, surrendered Fort Donelson, and later served as governor of Kentucky."}]]}],[["$","section","Professional soldier",{"children":[["$","h2",null,{"children":"Professional soldier"}],["$","p",null,{"children":"Buckner was born in Hart County, Kentucky, and graduated from West Point in 1844. He taught at the academy and served in the Mexican–American War before taking on militia responsibilities in Kentucky."}]]}],["$","section","Confederate service",{"children":[["$","h2",null,{"children":"Confederate service"}],["$","p",null,{"children":"He entered Confederate service and surrendered Fort Donelson in 1862. After his release in a prisoner exchange, he continued serving in the Confederate army, including commands in Kentucky and Tennessee."}]]}],["$","section","Governor of Kentucky",{"children":[["$","h2",null,{"children":"Governor of Kentucky"}],["$","p",null,{"children":"Buckner served as Kentucky’s governor from 1887 to 1891. His administration addressed state finances, schools, and prisons. In 1896 he was the vice-presidential candidate of the Gold Democrats. He died in 1914."}]]}]],["$","section",null,{"className":"profile-sources","children":[["$","h2",null,{"children":"Biography sources"}],["$","ul",null,{"children":[["$","li","https://www.nga.org/governor/simon-bolivar-buckner/",{"children":["$","a",null,{"href":"https://www.nga.org/governor/simon-bolivar-buckner/","target":"_blank","rel":"noreferrer","children":"National Governors Association: Simon Bolivar Buckner"}]}]]}]]}]]}]]}],false,["$","aside",null,{"className":"feedback-panel","id":"feedback","aria-labelledby":"feedback-title","children":[["$","div",null,{"children":[["$","p",null,{"className":"kicker","children":"Help improve the companion"}],["$","h2",null,{"id":"feedback-title","children":"Spotted something? Share an idea."}],["$","p",null,{"children":"Suggest a correction, report a problem, or recommend an image. The form includes this page’s details automatically."}]]}],["$","div",null,{"className":"feedback-actions","children":[["$","a",null,{"className":"primary-button","href":"https://github.com/Beau-Gosse-dev/Beau-Gosse-dev.github.io/issues/new?template=field-companion.yml&title=%5BField+Companion%5D+Simon+B.+Buckner+%E2%80%94+suggestion&page-context=Simon+B.+Buckner&page-url=https%3A%2F%2Fbeau-gosse-dev.github.io%2Fprojects%2Fcivil-war-field-companion%2Fpeople%2Fsimon-b-buckner","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.41