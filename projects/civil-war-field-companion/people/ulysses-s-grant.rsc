d:["$","main",null,{"className":"person-profile","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/people","children":"← All people"}]]}],["$","article",null,{"className":"profile-content","children":[["$","header",null,{"className":"profile-heading","children":[["$","p",null,{"children":["People of the Civil War · ","United States"]}],["$","h1",null,{"children":"Ulysses S. Grant"}],["$","p",null,{"className":"profile-lifespan","children":"1822–1885"}]]}],["$","div",null,{"className":"profile-grid","children":[["$","div",null,{"children":["$","$Le",null,{"image":"/images/ulysses-s-grant.jpg","alt":"Portrait of Major General Ulysses S. Grant in United States Army uniform","name":"Ulysses S. Grant","source":"https://www.loc.gov/item/2018666428/"}]}],["$","div",null,{"className":"profile-details","children":[["$","section",null,{"aria-labelledby":"background-title","children":[["$","h2",null,{"id":"background-title","children":"Background"}],["$","p",null,{"children":"United States Army officer who rose from western theater command to general-in-chief of all U.S. armies in 1864."}]]}],[["$","section","Early life",{"children":[["$","h2",null,{"children":"Early life"}],["$","p",null,{"children":"Born in Point Pleasant, Ohio, Grant graduated from West Point in 1843. He served in the Mexican–American War and married Julia Dent in 1848. After leaving the army in 1854, he tried farming and later worked in his family’s business in Galena, Illinois."}]]}],["$","section","Military leadership",{"children":[["$","h2",null,{"children":"Military leadership"}],["$","p",null,{"children":"Grant returned to military service in 1861. His western victories brought him to national attention, and in March 1864 he became commanding general of all United States armies. He accepted Robert E. Lee’s surrender at Appomattox in April 1865."}]]}],["$","section","Presidency and final years",{"children":[["$","h2",null,{"children":"Presidency and final years"}],["$","p",null,{"children":"As the eighteenth president, Grant supported Reconstruction and Black voting rights. After leaving office he traveled abroad, then lost his savings in a financial fraud. He completed his memoirs shortly before his death in 1885; their publication helped support his family."}]]}]],["$","section",null,{"className":"profile-sources","children":[["$","h2",null,{"children":"Biography sources"}],["$","ul",null,{"children":[["$","li","https://www.nps.gov/people/ulysses-s-grant.htm",{"children":["$","a",null,{"href":"https://www.nps.gov/people/ulysses-s-grant.htm","target":"_blank","rel":"noreferrer","children":"National Park Service: Ulysses S. Grant"}]}]]}]]}]]}]]}],["$","section",null,{"className":"profile-gallery","aria-labelledby":"profile-gallery-title","children":[["$","h2",null,{"id":"profile-gallery-title","children":"More images"}],["$","div",null,{"className":"profile-gallery-grid","children":[["$","$Le","/images/ulysses-s-grant-loc-2018667429.jpg",{"image":"/images/ulysses-s-grant-loc-2018667429.jpg","alt":"Grant at his headquarters at Cold Harbor, Virginia, June 1864.","caption":"Grant at his headquarters at Cold Harbor, Virginia, June 1864.","credit":"Library of Congress, Prints and Photographs Division. No known restrictions on publication.","name":"Ulysses S. Grant","source":"https://www.loc.gov/pictures/item/2018667429/"}]]}]]}]]}]]}]
