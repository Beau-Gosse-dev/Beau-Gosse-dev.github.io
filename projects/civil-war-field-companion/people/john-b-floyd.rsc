d:["$","main",null,{"className":"person-profile","children":[["$","header",null,{"className":"site-header compact","children":[["$","a",null,{"className":"brand","href":"/projects/civil-war-field-companion/","children":[["$","span",null,{"className":"brand-mark","children":"CW"}],["$","span",null,{"children":[["$","strong",null,{"children":"Field Companion"}],["$","small",null,{"children":"The Civil War & Reconstruction"}]]}]]}],["$","a",null,{"className":"back-link","href":"/projects/civil-war-field-companion/people","children":"← All people"}]]}],["$","article",null,{"className":"profile-content","children":[["$","header",null,{"className":"profile-heading","children":[["$","p",null,{"children":["People of the Civil War · ","Confederacy"]}],["$","h1",null,{"children":"John B. Floyd"}],["$","p",null,{"className":"profile-lifespan","children":"1806–1863"}]]}],["$","div",null,{"className":"profile-grid","children":[["$","div",null,{"children":["$","$Le",null,{"image":"/images/john-b-floyd.jpg","alt":"Portrait of John B. Floyd in civilian clothing","name":"John B. Floyd","source":"https://www.loc.gov/item/2017895939/"}]}],["$","div",null,{"className":"profile-details","children":[["$","section",null,{"aria-labelledby":"background-title","children":[["$","h2",null,{"id":"background-title","children":"Background"}],["$","p",null,{"children":"Former Virginia governor and United States secretary of war who became a Confederate brigadier general and senior commander at Fort Donelson."}]]}],[["$","section","Lawyer and governor",{"children":[["$","h2",null,{"children":"Lawyer and governor"}],["$","p",null,{"children":"Floyd was born in Virginia in 1806. He practiced law in Virginia and Arkansas and also pursued cotton planting using enslaved labor. He served in Virginia’s legislature and was governor from 1849 to 1852."}]]}],["$","section","Secretary of war",{"children":[["$","h2",null,{"children":"Secretary of war"}],["$","p",null,{"children":"President James Buchanan appointed Floyd secretary of war in 1857. His administration ended in December 1860 amid disputes over federal forts and financial irregularities involving government contractors."}]]}],["$","section","Confederate service",{"children":[["$","h2",null,{"children":"Confederate service"}],["$","p",null,{"children":"Floyd became a Confederate brigadier general and served in western Virginia and Tennessee. Jefferson Davis removed him from command after Fort Donelson. He later held a Virginia state military commission and died in Abingdon in 1863."}]]}]],["$","section",null,{"className":"profile-sources","children":[["$","h2",null,{"children":"Biography sources"}],["$","ul",null,{"children":[["$","li","https://history.army.mil/Portals/143/Images/Publications/Publication%20By%20Title%20Images/S%20PDF/CMH_Pub_70-12.pdf",{"children":["$","a",null,{"href":"https://history.army.mil/Portals/143/Images/Publications/Publication%20By%20Title%20Images/S%20PDF/CMH_Pub_70-12.pdf","target":"_blank","rel":"noreferrer","children":"U.S. Army Center of Military History: Secretaries of War and Secretaries of the Army"}]}]]}]]}]]}]]}],["$","section",null,{"className":"profile-gallery","aria-labelledby":"profile-gallery-title","children":[["$","h2",null,{"id":"profile-gallery-title","children":"More images"}],["$","div",null,{"className":"profile-gallery-grid","children":[["$","$Le","/images/john-b-floyd-loc-2013648324.jpg",{"image":"/images/john-b-floyd-loc-2013648324.jpg","alt":"John B. Floyd, portrait made between 1861 and 1863.","caption":"John B. Floyd, portrait made between 1861 and 1863.","credit":"Library of Congress, Prints and Photographs Division. No known restrictions on publication.","name":"John B. Floyd","source":"https://www.loc.gov/pictures/item/2013648324/"}]]}]]}],["$","aside",null,{"className":"feedback-panel","id":"feedback","aria-labelledby":"feedback-title","children":[["$","div",null,{"children":[["$","p",null,{"className":"kicker","children":"Help improve the companion"}]